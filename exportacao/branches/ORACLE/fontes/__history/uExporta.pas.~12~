procedure TfExportar.CarregaExpoDados;
var
   oItem: TExpoLayoutItem;
   oEspec: TExpoLayoutEspec;
   i: Integer;
   oCampo: TExpoCampo;
begin
   //verifica objeto layout
   if not (oExpoLayout = nil) then begin
      FreeAndNil(oExpoLayout);
   end;
   oExpoLayout := TExpoLayout.Create();

   //carrega itens e especificacoes
   qyRExpoItens.Close();
   qyRExpoItens.Open();
   qyRExpoItens.First();
   oProg.SetMin(0);

   oProg.SetMax(qyRExpoItens.RecordCount);

   // Para cada item do layout
   while not qyRExpoItens.Eof do
   begin
      //grava o item
      oProg.SetText('Exportando Item: '+ qyRExpoItensds_item.AsString);

      oItem := TExpoLayoutItem.Create();
      oItem.Ordem := qyRExpoItensnr_ordem.AsInteger;
      oItem.LayoutItem := qyRExpoItenscd_layout_item.AsInteger;
      oItem.Consulta := qyRExpoItensnm_consulta.AsString;
      oItem.Layout := qyRExpoItenscd_layout.AsInteger;
      oItem.LayoutItemPai := qyRExpoItenscd_layout_item_pai.AsInteger;
      oItem.Separador := qyRExpoItenschr_separador.AsString;
      oItem.SQLAntes := qyRExpoItensme_sqls_antes.AsString;
      oItem.SQLDepois := qyRExpoItensme_sqls_depois.AsString;

      qyRExpoEspec.First();

      // Neste momento percorremos todos os itens do processo e salvamos o log na base
      LogExportacao.LogaItem( qyRExpoItensnr_ordem.AsInteger, qyRExpoItensds_item.AsString );

      while not qyRExpoEspec.Eof do
      begin
         // Neste momento percorremos todos os itens do processo e salvamos o log na base
         LogExportacao.LogaEspecificacao( qyRExpoItensnr_ordem.AsInteger,
            qyRExpoEspecnr_ordem.AsInteger, qyRExpoEspecds_descricao.AsString );

         //grava as especificacoes
         oEspec := TExpoLayoutEspec.Create();
         oEspec.Ordem := qyRExpoEspecnr_ordem.AsInteger;
         oEspec.Desc := qyRExpoEspecds_valor.AsString;
         oEspec.Tamanho := qyRExpoEspecnr_tamanho.AsInteger;
         oEspec.Tipo := qyRExpoEspeccd_tipo.AsInteger;
         oEspec.Preenchimento := qyRExpoEspecchr_preenche.AsString;
         oEspec.Posicao := qyRExpoEspecchr_posicao.AsInteger;
         oEspec.parseValor(oExpoLayout.Comp);
         oItem.addEspec(oEspec);
         //percorre os campos e carrega-os
         for i := 0 to (oEspec.Campos.Count-1) do begin
            if (oItem.CampoByName[oEspec.Campos.Strings[i]] = nil) then begin
               oCampo := getExpoCampo(oEspec.Campos.Strings[i], oItem.Consulta);
               oItem.CampoByName[oEspec.Campos.Strings[i]] := oCampo;
            end;
         end;
         //proximo registro
         qyRExpoEspec.Next();
      end;
      oExpoLayout.addItem(oItem);
      oProg.SetAtual(oProg.getAtual()+1);
      qyRExpoItens.Next();
   end;
   meInfo.Lines.AddStrings(oExpoLayout.Comp.Output);
   qyRExpoItens.Close();
   qyRExpoEspec.Close();
end;

procedure TfExportar.Exportar(sFileName: string = ''; is_processo: Boolean = False; cd_processo: Integer = 0);
var
   sArquivo: string;
   n, i: Integer;
   sValor : String;
   sCaracteresValidos : String;
   sChave : String;

begin
   {OLIVER - Inicia Objeto de Logs}
   LogExportacao := TLoggerExportacao.Create();

   LogExportacao.SetIsProcesso(is_processo);
   LogExportacao.SetProcesso(cd_processo);
   LogExportacao.SetUsuario(DM.usuario_logado);

   LogExportacao.LogaExportacao();   

   sArquivo := sFileName;

   sCaracteresValidos := 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890';

   if sArquivo = '' then begin

      // Pegar o nome do arquivo padrão
      sArquivo := qyRLayoutsnm_arquivo_padrao.AsString;

      // trocar as chaves pelos valores
      for i := 0 to slValorFiltro.Count - 1 do begin

        // Retirar os caracteres especiais do valor do filtro

        sChave := slValorFiltro.Names[i];
        sValor := '';

        for n := 1 to Length(slValorFiltro.ValueFromIndex[i]) do begin

            if Pos(slValorFiltro.ValueFromIndex[i][n], sCaracteresValidos) > 0 then begin

               sValor := sValor + slValorFiltro.ValueFromIndex[i][n];

            end;

        end;

        if aTipoFiltro[i] = 'DAT' then begin

          sValor := Copy(sValor, 7, 2) + Copy(sValor, 5,2) + Copy(sValor, 1, 4);

        end;

        sArquivo := ReplaceStr(sArquivo, sChave, sValor);

      end;

   end;

   // Pegar o nome do arquivo para salvar
   if (sFileName = '') then begin

     if sArquivo = '' then
        sdSalvar.InitialDir := ExtractFileDir(Application.ExeName)
     else begin
        sdSalvar.InitialDir := ExtractFileDir(sArquivo);
        sdSalvar.FileName := ExtractFileName(sArquivo);
     end;

     if not (sdSalvar.Execute(Self.Handle)) then begin
        Exit;
     end;
     sArquivo := sdSalvar.FileName;
   end;

   // Limpar a linha de "debug"
   meInfo.Lines.Clear();
   try
      AssignFile(aFile, sArquivo);
      Rewrite(aFile);
      AFirstLine := True;
   except
      meInfo.Lines.Add('Impossível Criar o Arquivo. Verifique as permissões das pastas ou tente salvar o arquivo em outro local.' + #13 + 'Processo Abortado!');
      Exit;
   end;
   oProg.NovaBarra('Carregando Informações do Layout...');

   {OLIVER}
   CarregaExpoDados();

   oExpoLayout.SetListaFiltros(slValorFiltro);
   
   //percorre os itens e retorna os valores
   for i := 0 to oExpoLayout.getItemCount()-1 do begin
      oProg.SetMin(0);
      oprog.SetMax(oExpoLayout.getItemCount());
      oProg.SetStatus(i, 'Exportando os Layout: '+ IntToStr(i+1) + ' de ' + IntToStr(oExpoLayout.getItemCount()));
      Application.ProcessMessages();
      //se for um item filho, pula
      if (oExpoLayout.Items[i].LayoutItemPai <> -1) then begin
         Continue;
      end;
      //executa o sql Antes
      ExportaExecutaSQL(i, True);
      // Exporta item
      ExportaItem(i, nil, is_processo, cd_processo);
      //executa o sql Depois
      ExportaExecutaSQL(i, False);

   end;
   oProg.FechaBarra();

   CloseFile(aFile);

   // Salva os logs no banco
   LogExportacao.SalvaArquivo(sArquivo);
end;

