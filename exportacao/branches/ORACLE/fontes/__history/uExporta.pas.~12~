begin
   FiltraDados();
end;

procedure TfExportar.FiltraDados;
var
   z,i: Integer;
begin
   with qyRLayouts do begin
      Close();
      SQL.Clear();
      Params.Clear();
      SQL.Add('SELECT * FROM expo_layouts WHERE sn_ativo = 1');
      SQL.Add(' ORDER BY ');

      z := slOrdem.Count-1;
      for i := 0 to z do begin
         if not (slOrdem.ValueFromIndex[i] = 'NONE') then begin
            SQL.Add(slOrdem.Names[i] + ' ' + slOrdem.ValueFromIndex[i]);
            SQL.Add(', ');
         end;
      end;
      SQL.Add(slOrdem.Names[iOrdemDefault]);
      Open();
   end;
end;

