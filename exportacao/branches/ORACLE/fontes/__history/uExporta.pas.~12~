procedure TfExportar.ExportaExecutaSQL(iItem: Integer; bAntes: Boolean);
var
   qryExec: TUMZQuery;
   sSQL: string;
//   sSQLFiltrado: string;
   slConsultas: TStringList;
  i: Integer;
begin
   qryExec := TUMZQuery.Create(nil);
   qryExec.Connection := DM.ZConn;
   qryExec.ParamCheck := False;
   qryExec.DataSource := nil;
   qryExec.Close();
   qryExec.Params.Clear();

   //pega os sqls.
   if not (oExpoLayout.Items[iItem] = nil) then begin
      if (bAntes) then begin
        sSQL := oExpoLayout.Items[iItem].SQLAntes;
      end
      else begin
        sSQL := oExpoLayout.Items[iItem].SQLDepois;
      end;
      if (Trim(sSQL) <> '') then begin
        //divide em varios SQLs
        slConsultas := SplitString(sSQL, ';');
        for i := 0 to slConsultas.Count - 1 do
        begin
            if slConsultas.Strings[i] <> '' then
            begin
               qryExec.Close();
               qryExec.SQL.Clear();
               qryExec.SQL.Text := slConsultas.Strings[i];
               try
                  qryExec.ExecSQL();
               except
                  on E:Exception do
                  begin
                     if(pos('Duplicate',e.Message) > 0) then begin
                        continue;
                     end;
                  end;

               end;
            end;
        end;
      end;
   end;
end;

procedure TfExportar.ExportaItem(iItem: Integer; qryPai: TUMZQuery = nil; is_processo: Boolean = False; cd_processo: Integer = 0);
var
   qryDados: TUMZQuery;
   oItem: TExpoLayoutItem;
   dsDados: TDataSource;
   slCampos: TStringList;
   i, z, x, y: Integer;
   sAux: string;
begin
   if ((oExpoLayout = nil)) then begin
      Exit;
   end;
   qryDados := TUMZQuery.Create(nil);
   dsDados := TDataSource.Create(nil);
   slCampos := TStringList.Create();
   oItem := oExpoLayout.Items[iItem];
   try
      //aqui vai a programacao
      qryDados.Connection := DM.ZConn;
      dsDados.AutoEdit := False;
      if (qryPai = nil) then begin
         oProg.SetText('Exportando o Item de Layout: '+ oItem.Consulta);
         qryDados.ParamCheck := False;
         qryDados.DataSource := nil;
      end
      else begin
         oProg.SetText('Exportando o SubItem de Layout: '+ oItem.Consulta);
         dsDados.DataSet := qryPai;
         qryDados.ParamCheck := True;
         qryDados.DataSource := dsDados;
      end;
      qryDados.Close();
      qryDados.Params.Clear();
      qryDados.SQL.Clear();
      qryDados.SQL.Text := getSQL(oItem, is_processo, cd_processo);

      if (qryDados.SQL.Text = '') then begin
         meInfo.Lines.Add('----------------------------------------------');
         meInfo.Lines.Add('ERRO: SQL do Item inválido: ' +oItem.Consulta);
         Exit;
      end;

      try
         qryDados.Open();
      except
         meInfo.Lines.Add('----------------------------------------------');
         meInfo.Lines.Add('ERRO: SQL do Item inválido: ' +oItem.Consulta);
         Exit;
      end;
      while not qryDados.Eof do begin
         oProg.SetMin(0);
         oProg.SetMax(qryDados.RecordCount+1);
         slCampos.Clear();
         z := qryDados.FieldCount-1;
         //carrega os valores
         for i := 0 to z do begin
            slCampos.Add(qryDados.Fields[i].FieldName+'='+qryDados.Fields[i].AsString);
         end;
         //carrega os campos calculados (SQL)
         geraCamposSQL(slCampos, oExpoLayout.Items[iItem], qryDados);

         //pega a string e grava no arquivo
         sAux := oExpoLayout.ExportaItem(iItem, slCampos, LogExportacao);

         if not (Trim(sAux) = '')  then begin
            if (aFirstLine) then begin
               aFirstLine := False;
            end
            else begin
               WriteLn(aFile);
            end;
            Write(aFile, sAux);
         end
         else begin
            sAux := '';
         end;

         y := (oExpoLayout.getItemCount()-1);

         //verifica os subitens
         for x := iItem to y do begin
            if (oExpoLayout.Items[x].LayoutItemPai = oItem.LayoutItem) then begin
               Self.ExportaItem(x, qryDados);
            end;
         end;
         qryDados.Next();
         oProg.SetAtual(qryDados.RecNo);
         meInfo.Lines.Text := oExpoLayout.Comp.Output.Text;
         Application.ProcessMessages();
      end;
      
   finally
      FreeAndNil(qryDados);
      FreeAndNil(dsDados);
      FreeAndNil(slCampos);
   end;
end;

function TfExportar.getExpoCampo(sNome: string; sConsulta: string): TExpoCampo;
begin
   Result := nil;
   with qyRCamposAux do begin
      Close();
      Params.Clear();
      SQL.Clear();
      SQL.Text := ''+
      'SELECT                                                   '+
      '	ect.nm_tabela, ec.nm_campo, ec.ds_consulta              '+
      'FROM                                                     '+
      '  expo_campos ec                                         '+
      '  INNER JOIN expo_consulta_tabelas ect ON (ec.nm_tabela = ect.nm_tabela_real) '+
      'WHERE                                                    '+
      '  (CONCAT(ect.nm_tabela, ".", ec.nm_campo) = :nomecampo)  '+
      '	AND (ec.sn_ativo = 1 AND ec.sn_apagado = 0)            '+
      '  AND (ect.nm_consulta = :consulta)                       ';
         ParamByName('nomecampo').AsString := sNome;
         ParamByName('consulta').AsString := sConsulta;
      Open();
      if not IsEmpty then begin
         Result := TExpoCampo.Create();
         Result.setNome(FieldByName('nm_campo').AsString);
         Result.setTabela(FieldByName('nm_tabela').AsString);
         Result.setConsulta(FieldByName('ds_consulta').AsString);
      end;
      Close();
      if (Result = nil) then begin
         Close();
         Params.Clear();
         SQL.Clear();
         SQL.Text := ''+
         'SELECT                                                               '+
         '	ec.nm_tabela, ec.nm_campo, ec.ds_valor, ec.sn_sql, ec.me_sql       '+
         'FROM                                                                 '+
         '  expo_consulta_campos ec                                            '+
         '  INNER JOIN expo_consulta_tabelas ect ON (ect.nm_consulta = ec.nm_consulta AND ect.nm_tabela = ec.nm_tabela) '+
         'WHERE                                                    '+
         '  (CONCAT(ec.nm_tabela, ".", ec.nm_campo) = :nomecampo)  '+
         '  AND (ec.nm_consulta = :consulta)                       ';
         ParamByName('nomecampo').AsString := sNome;
         ParamByName('consulta').AsString := sConsulta;
         Open();
         if not IsEmpty then begin
            Result := TExpoCampo.Create();
            Result.setNome(FieldByName('nm_campo').AsString);
            Result.setTabela(FieldByName('nm_tabela').AsString);
            Result.setConsulta(FieldByName('ds_valor').AsString);
            Result.setUsaSQL((FieldByName('sn_sql').AsInteger = 1));
            Result.setSQL(FieldByName('me_sql').AsString);
            Result.setCarregado(True);
         end;
         Close();
      end;
   end;
   //campo inexistente
   if (Result = nil) then begin
      Result := TExpoCampo.Create();
      Result.setTabela(Copy(sNome, 1, Pos('.', sNome)-1));
      Result.setNome(Copy(sNome,Pos('.', sNome)+1));
      Result.setConsulta('""');
      Result.setUsaSQL(False);
      Result.setCarregado(True);
   end;

end;

procedure TfExportar.geraCamposSQL(var slCampos: TStringList; oItem: TExpoLayoutItem;
   qryPai: TUMZQuery);
var
   qryCampo: TUMZQuery;
   dsDados: TDataSource;
   i: Integer;
   oCampo: TExpoCampo;
begin
   qryCampo := nil;
   dsDAdos := nil;
   for i := 0 to oItem.CampoCount-1 do begin
      oCampo := oItem.Campo[i];
      //if oCampo = nil then Continue;
      if (oCampo.usaSQL()) then begin
         if (qryCampo = nil) then begin
            qryCampo := TUMZQuery.Create(nil);
            qryCampo.Connection := DM.ZConn;
            dsDados := TDataSource.Create(nil);
            dsDados.DataSet := qryPai;
            qryCampo.ParamCheck := True;
            qryCampo.DataSource := dsDados;
         end;
         qryCampo.Close();
         qryCampo.Params.Clear();
         qryCampo.SQL.Clear();
         qryCampo.SQL.Text := oItem.Campo[i].getSQL();
         try
           qryCampo.Open();
           if not (qryCampo.IsEmpty) then begin
               slCampos.Add(oItem.Campo[i].getApelido()+'='+qryCampo.Fields[0].AsString);
           end;
           qryCampo.Close();
         except
            slCampos.Add(oItem.Campo[i].getApelido()+'=');
         end;
      end;
   end;
   if not (qryCampo = nil) then begin
      FreeAndNil(qryCampo);
      FreeAndNil(dsDados);
   end;
end;

end.
