procedure TfExportar.qyRLayoutsCalcFields(DataSet: TDataSet);
begin
   if qyRLayoutssn_ativo.ASInteger = 1 then begin
      qyRLayoutsativo.AsString := 'Sim';
   end
   else begin
      qyRLayoutsativo.AsString := 'Não';
   end;
end;

function TfExportar.SolicitarFiltros: Boolean;
Var
   sAux, sAuxLista, sMensagemDeptoSemPermissao,
   sConsultaPermissaoDepartamentos: String;
   sListaDepartamentos: TStringList;
   i: integer;
begin
  // Verificar se tem algum filtro com [] e soliciar ao usuário.
  sMensagemDeptoSemPermissao := '';
  sListaDepartamentos := TStringList.Create;
  slValorFiltro.Clear();

  qyAux.Close();
  qyAux.SQL.Clear;
  qyAux.SQL.Text := '' +
   ' SELECT li.cd_layout, lf.ds_chave, lf.ds_dialogo, lf.ds_valor, lf.ds_tipo, lf.sn_checa_permissao_coligadas, lf.cd_layout_filtro  ' +
   '   FROM expo_layout_filtros as lf  ' +
   '  INNER JOIN expo_layout_itens as li ON (lf.cd_item = li.cd_layout_item) ' +
   '  WHERE li.cd_layout = :layout  ' +
   '  ORDER BY lf.nr_ordem ';
  qyAux.ParamByName('layout').AsInteger := qyRLayoutscd_layout.AsInteger;
  qyAux.Open();

  qyAux2.Close();
  qyAux2.SQL.Clear();
  qyAux2.SQL.Text := '' +
   '  UPDATE expo_layout_filtros as lf  ' +
   '   INNER JOIN expo_layout_itens as li ON (lf.cd_item = li.cd_layout_item) ' +
   '     SET lf.ds_valor = :valor ' +
   '   WHERE li.cd_layout = :layout  '+
   '     AND lf.ds_chave = :chave ';

  qyAux2.ParamByName('layout').AsInteger := qyRLayoutscd_layout.AsInteger;

  while not qyAux.EOF do begin

     if Trim(qyAux.FieldByName('ds_chave').AsString) <> '' then begin

       // não solicitar duas vezes a mesma chave de filtro

       if slValorFiltro.IndexOfName('['+qyAux.FieldByName('ds_chave').AsString+ ']') < 0 then begin

           sAux := qyAux.FieldByName('ds_valor').AsString;

           // O campo ds_valor da tabela expo_layout_filtros não pode ser vazio
           if (Trim(sAux) = '') then
           begin
                Mensagem(
                   'O campo [ds_valor] da tabela  [expo_layout_filtros] não pode ser vazio. Revise o registro cd_layout_filtro: '
                   + qyAux.FieldByName('cd_layout_filtro').AsString
                   + '.'
                   , 'Atenção'
                   , MB_OK + MB_ICONEXCLAMATION, Handle
                );

                // Sai do loop sem exportar para o arquivo
                exit;
           end;

           sAux := TraduzirFiltros( sAux, qyAux.FieldByName('ds_tipo').AsString, qyAux.FieldByName('ds_dialogo').AsString );

           sAuxLista := sAux;
           sAuxLista := StringReplace(sAuxLista, '(', '', []);
           sAuxLista := StringReplace(sAuxLista, ')', '', []);

           sListaDepartamentos.DelimitedText := sAuxLista;
           sListaDepartamentos.StrictDelimiter := True;
           sListaDepartamentos.Delimiter := ',';

           if qyAux.FieldByName('sn_checa_permissao_coligadas').AsInteger = 1 then
           begin
              // Grava a consulta original
              sConsultaPermissaoDepartamentos := qyVerificaPermissaoColigada.SQL.Text;

              qyVerificaPermissaoColigada.Close;
              qyVerificaPermissaoColigada.ParamByName('cd_pessoa').AsInteger := DM.GetUsuarioLogado.Pessoa.Codigo;
              qyVerificaPermissaoColigada.SQL.Text := StringReplace(qyVerificaPermissaoColigada.SQL.Text, ':cd_departamento_in', sAux, []);
              qyVerificaPermissaoColigada.Open;

              // Verifica quais departamentos não possui permissão
              while not qyVerificaPermissaoColigada.Eof do
              begin

                if (qyVerificaPermissaoColigada.FieldByName('sn_permissao').AsInteger = 0) then
                begin
                   sMensagemDeptoSemPermissao := sMensagemDeptoSemPermissao +
                      qyVerificaPermissaoColigada.FieldByName('cd_departamento').AsString + ' - ' +
                      qyVerificaPermissaoColigada.FieldByName('ds_departamento').AsString + #13;
                end;

                qyVerificaPermissaoColigada.Next;
              end;

              // Restaura a consulta original
              qyVerificaPermissaoColigada.SQL.Text := sConsultaPermissaoDepartamentos;

              if Length(sMensagemDeptoSemPermissao) > 0 then
              begin
                Mensagem(
                  'Você não está vinculado as coligadas dos seguintes departamentos: ' + #13 + #13 +
                  sMensagemDeptoSemPermissao + #13 +
                  'Portanto não é possível exportar as informações desses departamentos.' + #13 +
                  'Vincule seu usuário nas coligadas dos departamentos informados ou remova os departamentos ' +
                  'do filtro para realizar a exportação.',
                  'Atenção',
                  MB_ICONERROR + MB_OK
                );

                slValorFiltro.Clear();
                Result := False;
                
                Exit;
              end;

           end;

           qyAux2.ParamByName('chave').AsString := qyAux.FieldByName('ds_chave').AsString;
           qyAux2.ParamByName('valor').AsString := sAux;
           qyAux2.ExecSQL();

           slValorFiltro.Add('['+ qyAux.FieldByName('ds_chave').AsString + ']=' + sAux);

           SetLength(aTipoFiltro, slValorFiltro.Count);

           aTipoFiltro[slValorFiltro.Count-1] := qyAux.FieldByName('ds_tipo').AsString;

       end;


     end;

     qyAux.Next();

  end;

  Result := True;


end;

