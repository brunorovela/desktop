function TfExportar.getSQL(oItem: TExpoLayoutItem; is_processo: Boolean = False; cd_processo: Integer = 0): string;
var
   sSQL: string;
   sCampos, sFiltro: string;
   i: Integer;
   sValorCampo : String;
begin
   qyRItensSQL.Close();
   qyRItensSQL.ParamByName('cd_layout_item').AsInteger := oItem.LayoutItem;
   qyRItensSQL.Open();

   //carrega o sql
   if not qyRItensSQL.IsEmpty then begin
      sSQL := qyRItensSQL.FieldByName('me_sql').AsString;
   end
   else begin
      Result := '';
      Exit;
   end;
   qyRItensSQL.Close();
   
   //define os campos
   sCampos := '"" as vze';
   for i := 0 to oItem.CampoCount-1 do begin
      if not (oItem.Campo[i].usaSQL()) then begin
         sCampos := sCampos + ', ' +  oItem.Campo[i].getConsulta() + ' as ' + oItem.Campo[i].getApelido();
      end;
   end;
   sSQL := StringReplace(sSQL, '[$campos$]', sCampos, [rfIgnoreCase]);

   //define os filtros
   qyRItensFiltro.Close();
   qyRItensFiltro.ParamByName('cd_layout_item').AsInteger := oItem.LayoutItem;
   qyRItensFiltro.Open();

   sFiltro := '1 = 1';
   while not qyRItensFiltro.Eof do begin
      for i := 0 to qyRItensFiltro.FieldCount-1 do begin

         // Processar o Valor         
         sValorCampo := qyRItensFiltro.Fields[i].AsString;

         if oItem.LayoutItemPai <> -1 then
         begin
            if (LeftStr(Trim(qyRItensFiltro.Fields[i].AsString), 1) = ':') then
            begin
               sFiltro := sFiltro + ' ' + StringReplace(sValorCampo, '.', '_', []);
            end
            else
            begin
               sFiltro := sFiltro + ' ' + sValorCampo;
            end;
         end
         else
         begin
            if (is_processo) AND (cd_processo > 0) AND (trim(sValorCampo) = ':cd_processo') then
            begin
               sValorCampo := IntToStr(cd_processo) + ' AND expo_processo_pessoas.sn_selecionado = 1';
            end;
            
            sFiltro := sFiltro + ' ' + sValorCampo;
         end;
      end;
      
      sFiltro := sFiltro + #13;
      qyRItensFiltro.Next();
   end;
   qyRItensFiltro.Close();
   sSQL := StringReplace(sSQL, '[$condicao$]', sFiltro, [rfIgnoreCase, rfReplaceAll]);

   Result := sSQL;
end;

procedure TfExportar.ToolButton1Click(Sender: TObject);
var
  bFiltrosOK: Boolean;
begin
   if qyRLayoutssn_exportacao.AsInteger = 1 then
   begin
      Mensagem('Este é um layout de processo do CENSO/ENADE e sua execução deve ser feita pelo Módulo Acadêmico (Matrículas -> Exportação de Dados -> Exportar Dados).', 'Atenção', MB_OK + MB_ICONEXCLAMATION, Handle);
      Exit;
   end;

   if (qyRLayouts.RecordCount = 0) then begin
      Mensagem('Selecione um layout para exportar!!!!');
      Exit;
   end;
   bFiltrosOK := SolicitarFiltros();

   if bFiltrosOK then
   begin
     Exportar();
   end;
end;

function TfExportar.TraduzirFiltros(ValorCampo : String; tipo : String; msg : String) : String;
Var
   ValInteiro : Integer;
   ValString : String;
   ValData : TDateTime;
begin
   // essa tela vai converter o valor do filtro atual na base de dados
   // vai chamar a tela de filtro, solicitando os dados
   // e depois vai retornar o filtro no formado necessário.

   // retirar " e ' do valor do campo

   ValorCampo := Trim(ValorCampo);

   if ValorCampo[1] in ['"', ''''] then begin

      ValorCampo := Copy(ValorCampo, 2, 1000);

   end;

   if ValorCampo[Length(ValorCampo)] in ['"', ''''] then begin

      ValorCampo := Copy(ValorCampo, 1, Length(ValorCampo) - 1);
      
   end;

   fFiltroExporta.lbFiltro.Caption := msg;

   if tipo = 'DAT' then begin

      ValorCampo := Copy(ValorCampo, 9, 2) + '/' +
                    Copy(ValorCampo, 6, 2) + '/' +
                    Copy(ValorCampo, 1, 4);

      ValData := StrToDate(ValorCampo);

      fFiltroExporta.edString.Visible := false;
      fFiltroExporta.edInteger.Visible := false;
      fFiltroExporta.dtpData.Visible := true;

