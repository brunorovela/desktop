  object qrySalas: TUMZQuery
    Connection = DM.db
    AfterOpen = qrySalasAfterOpen
    Params = <>
    SQLList.Strings = (
      
        'mysql-5=SELECT'#13#10'   s.id as cd_sala,'#13#10'   s.ds_sala,'#13#10'   s.nr_qtd_vagas as qtd_vagas,'#13#10' ' +
        '  e.cd_prova,'#13#10'   s.sn_ativo,'#13#10'   COUNT(e.cd_ensalamento) lotaca' +
        'o'#13#10'FROM'#13#10'   unim_sala s'#13#10'      JOIN pint_ensalamento e ON'#13#10'     ' +
        '    (s.id = e.cd_sala)'#13#10'WHERE'#13#10'   s.sn_ativo = 1 AND'#13#10'   s.' +
        'ds_sala LIKE :ds_sala AND'#13#10'   e.cd_regra_ensalamento = :cd_regra' +
        '_ensalamento'#13#10'GROUP BY'#13#10'   s.id,'#13#10'   e.cd_prova'
      
        'oracle=SELECT'#13#10'   s.id as cd_sala,'#13#10'   FIRST_OCCURRENCE(s.ds_sala) ds_' +
        'sala,'#13#10'   CAST(FIRST_OCCURRENCE(s.nr_qtd_vagas) AS NUMBER(19)) qtd_' +
        'vagas,'#13#10'   e.cd_prova,'#13#10'   CAST(FIRST_OCCURRENCE(s.sn_ativo)AS N' +
        'UMBER(5)) sn_ativo,'#13#10'   CAST(COUNT(e.cd_ensalamento) AS NUMBER(1' +
        '9)) lotacao'#13#10'FROM'#13#10'   unim_sala s '#13#10#9' INNER JOIN pint_ensalament' +
        'o e ON (s.id = e.cd_sala)'#13#10'WHERE'#13#10'   s.sn_ativo = 1 AND'#13#10'  ' +
        ' s.ds_sala LIKE :ds_sala AND'#13#10'   e.cd_regra_ensalamento = :cd_re' +
        'gra_ensalamento'#13#10'GROUP BY'#13#10'   s.id,'#13#10'   e.cd_prova')
    Left = 208
    Top = 176
    object qrySalascd_sala: TLargeintField
      FieldName = 'cd_sala'
      Required = True
    end
    object qrySalasds_sala: TStringField
      FieldName = 'ds_sala'
      Size = 255
    end
    object qrySalasqtd_vagas: TLargeintField
      FieldName = 'qtd_vagas'
    end
    object qrySalascd_prova: TLargeintField
      FieldName = 'cd_prova'
      Required = True
    end
    object qrySalassn_ativo: TSmallintField
      FieldName = 'sn_ativo'
    end
    object qrySalaslotacao: TLargeintField
      FieldName = 'lotacao'
      ReadOnly = True
    end
  end
  object dsSalas: TDataSource
    AutoEdit = False
    DataSet = qrySalas
    Left = 176
    Top = 176
  end
end
