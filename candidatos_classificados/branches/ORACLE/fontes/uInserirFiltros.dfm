  object qryFiltros: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'c.cd_coligada cd_coligada,'
      #9'c.nm_COLIGADA coligada,'
      #9'd.codigo cd_departamento,'
      #9'd.razaosocial departamento,'
      #9'cm.CD_CURSO cd_curso,'
      #9'cm.DS_CURSO curso,'
      '  m.situacao cd_situacao,'
      
        '  CONCAT(st.ds_situacao,'#39' - '#39', st.ds_sigla_situacao ) ds_situaca' +
        'o,'
      #9'm.turma turma,'
      #9'm.anosemestre anosemestre,'
      #9'COUNT(m.codigoaluno) qtd_alunos'
      'FROM'
      #9'matriculas m'
      'INNER JOIN turmas t ON ('
      #9't.anosemestre = m.anosemestre'
      #9'AND t.codigo = m.turma'
      #9'AND t.curso = m.curso'
      ')'
      'INNER JOIN cursos_coligadas cc ON ('
      #9'cc.CD_CURSO = m.curso'
      #9'AND cc.CD_COLIGADA = t.cd_coligada'
      ')'
      'INNER JOIN coligadas c ON ('
      #9'c.CD_COLIGADA = CC.cd_coligada'
      ')'
      'INNER JOIN situacao st ON ( m.situacao = st.cd_situacao )'
      'INNER JOIN departamentos d ON (d.codigo = cc.CD_DEPTO)'
      'INNER JOIN cursos_mestre cm ON (cm.CD_CURSO = m.curso)'
      ''
      'GROUP BY'
      #9'm.turma,'
      #9'm.situacao,'
      '  m.anosemestre')
    Params = <>
    Left = 40
    Top = 408
    object qryFiltroscoligada: TStringField
      DisplayWidth = 270
      FieldName = 'coligada'
      Size = 255
    end
    object qryFiltrosDEPARTAMENTO: TStringField
      DisplayWidth = 255
      FieldName = 'DEPARTAMENTO'
      Size = 255
    end
