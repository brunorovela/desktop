  object qryNumQuestoes: TUMZReadOnlyQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'mysql-5=SELECT'#13#10'   P.NR_QUESTOES_DISCIPLINAS,'#13#10'   PT.CD_TURMA,'#13#10 +
        '   PT.CD_DISCIPLINA,'#13#10'   D.DESCRICAO,'#13#10'   IF(P.SN_CREDITO = 1, G' +
        '.NR_CREDITOS_ACADEMICOS, 1) NR_CREDITOS,'#13#10'   COUNT(PQD.CD_QUESTA' +
        'O) NR_QUESTOES'#13#10'FROM'#13#10'   PINT_PROVAS P'#13#10#9#9'  JOIN PINT_PROVAS_TUR' +
        'MAS PT USING (CD_PROVA)'#13#10#9#9'  '#9#9'JOIN TURMAS T ON'#13#10#9#9'  '#9#9#9'(PT.CD_T' +
        'URMA = T.CODIGO) AND'#13#10#9#9'  '#9#9#9'(PT.CD_CURSO = T.CURSO) AND'#13#10#9#9'  '#9#9 +
        #9'(PT.NR_ANOSEMESTRE = T.ANOSEMESTRE)'#13#10#9#9'  '#9#9#9'JOIN GRADECURRICULA' +
        'R G ON'#13#10#9#9'  '#9#9#9#9'(PT.NR_ANOSEMESTRE = G.ANOSEMESTRE) AND'#13#10#9#9'  '#9#9#9 +
        #9'(PT.CD_CURSO = G.CURSO) AND'#13#10#9#9'  '#9#9#9#9'(PT.CD_DISCIPLINA = G.DISC' +
        'IPLINA) AND'#13#10#9#9'  '#9#9#9#9'(T.SERIE = G.SERIE) AND'#13#10#9#9'  '#9#9#9#9'(T.TURNO =' +
        ' G.TURNO) AND'#13#10#9#9'  '#9#9#9#9'(T.CD_GRADE = G.CD_GRADE)'#13#10#9#9#9'   LEFT JOI' +
        'N PINT_PROVAS_QUESTOES_DIS PQD ON'#13#10#9#9#9#9'    (PT.CD_PROVA = PQD.CD' +
        '_PROVA) AND'#13#10#9#9#9#9'    (PT.CD_TURMA = PQD.CD_TURMA) AND'#13#10#9#9#9#9'    (' +
        'PT.CD_CURSO = PQD.CD_CURSO) AND'#13#10#9#9#9#9'    (PT.CD_DISCIPLINA = PQD' +
        '.CD_DISCIPLINA) AND'#13#10#9#9#9#9'    (PT.NR_ANOSEMESTRE = PQD.NR_ANOSEME' +
        'STRE)'#13#10'         JOIN DISCIPLINAS D ON'#13#10'            (PT.CD_DISCIP' +
        'LINA = D.CODIGO) AND'#13#10'            (PT.CD_CURSO = D.CURSO)'#13#10'WHERE' +
        #13#10'   P.CD_PROVA = :CD_PROVA'#13#10'GROUP BY'#13#10#9' PT.CD_TURMA,'#13#10#9' PT.CD_C' +
        'URSO,'#13#10#9' PT.CD_DISCIPLINA,'#13#10#9' PT.NR_ANOSEMESTRE'#13#10'HAVING'#13#10#9' NR_QU' +
        'ESTOES < (P.NR_QUESTOES_DISCIPLINAS * NR_CREDITOS)'#13#10'ORDER BY'#13#10#9' ' +
        'PT.CD_TURMA,'#13#10#9' D.DESCRICAO'
      
        'oracle=SELECT'#13#10'   CAST(FIRST_OCCURRENCE(P.NR_QUESTOES_DISCIPLINA' +
        'S) AS NUMBER(9)) NR_QUESTOES_DISCIPLINAS,'#13#10'   PT.CD_TURMA,'#13#10'   P' +
        'T.CD_DISCIPLINA,'#13#10'   FIRST_OCCURRENCE(D.DESCRICAO) DESCRICAO,'#13#10' ' +
        '  CASE WHEN FIRST_OCCURRENCE(P.SN_CREDITO) = '#39'1'#39' THEN CAST(FIRST' +
        '_OCCURRENCE(G.NR_CREDITOS_ACADEMICOS) AS NUMBER(19)) ELSE CAST('#39 +
        '1'#39' AS NUMBER(19)) END NR_CREDITOS,'#13#10'   CAST(COUNT(PQD.CD_QUESTAO' +
        ') AS NUMBER(19)) NR_QUESTOES'#13#10'FROM'#13#10'   PINT_PROVAS P'#13#10#9' INNER JO' +
        'IN PINT_PROVAS_TURMAS PT ON (P.CD_PROVA = PT.CD_PROVA)'#13#10#9' INNER ' +
        'JOIN TURMAS T ON ('#13#10#9#9#9#9'PT.CD_TURMA = T.CODIGO AND'#13#10#9#9'  '#9'PT.CD_C' +
        'URSO = T.CURSO AND'#13#10#9#9'  '#9'PT.NR_ANOSEMESTRE = T.ANOSEMESTRE'#13#10#9' )'#13 +
        #10#9' INNER JOIN GRADECURRICULAR G ON ('#13#10#9#9#9#9'PT.NR_ANOSEMESTRE = G.' +
        'ANOSEMESTRE AND'#13#10#9#9#9#9'PT.CD_CURSO = G.CURSO AND'#13#10#9#9#9#9'PT.CD_DISCIP' +
        'LINA = G.DISCIPLINA AND'#13#10#9#9#9#9'T.SERIE = G.SERIE AND'#13#10#9#9#9#9'T.TURNO ' +
        '= G.TURNO AND'#13#10#9#9#9#9'T.CD_GRADE = G.CD_GRADE'#13#10#9#9')'#13#10#9#9'LEFT JOIN PIN' +
        'T_PROVAS_QUESTOES_DIS PQD ON ('#13#10#9#9#9#9'PT.CD_PROVA = PQD.CD_PROVA A' +
        'ND'#13#10#9#9#9#9'PT.CD_TURMA = PQD.CD_TURMA AND'#13#10#9#9#9#9'PT.CD_CURSO = PQD.CD' +
        '_CURSO AND'#13#10#9#9#9#9'PT.CD_DISCIPLINA = PQD.CD_DISCIPLINA AND'#13#10#9#9#9#9'PT' +
        '.NR_ANOSEMESTRE = PQD.NR_ANOSEMESTRE'#13#10#9#9')'#13#10'    INNER JOIN DISCIP' +
        'LINAS D ON ('#13#10#9#9#9#9'PT.CD_DISCIPLINA = D.CODIGO AND'#13#10'        PT.CD' +
        '_CURSO = D.CURSO'#13#10#9#9')'#13#10'WHERE'#13#10'   P.CD_PROVA = :CD_PROVA'#13#10'GROUP B' +
        'Y'#13#10#9' PT.CD_TURMA,'#13#10#9' PT.CD_CURSO,'#13#10#9' PT.CD_DISCIPLINA,'#13#10#9' PT.NR_' +
        'ANOSEMESTRE'#13#10'HAVING'#13#10#9' COUNT(PQD.CD_QUESTAO) < (FIRST_OCCURRENCE' +
        '(P.NR_QUESTOES_DISCIPLINAS) * CASE WHEN FIRST_OCCURRENCE(P.SN_CR' +
        'EDITO) = '#39'1'#39' THEN FIRST_OCCURRENCE(G.NR_CREDITOS_ACADEMICOS) ELS' +
        'E '#39'1'#39' END)'#13#10'ORDER BY'#13#10#9' PT.CD_TURMA,'#13#10#9' DESCRICAO')
    Left = 272
    Top = 144
    object qryNumQuestoesNR_QUESTOES_DISCIPLINAS: TIntegerField
      FieldName = 'NR_QUESTOES_DISCIPLINAS'
    end
    object qryNumQuestoesCD_TURMA: TStringField
      FieldName = 'CD_TURMA'
      Required = True
      Size = 15
    end
