  object qryProvas: TUMZQuery
    Connection = DM.db
    OnCalcFields = qryProvasCalcFields
    SQL.Strings = (
      'SELECT'
      '   P.CD_PROVA,'
      '   P.DS_PROVA,'
      '   P.NR_ANOSEMESTRE,'
      '   P.DT_PROVA,'
      '   P.SN_CREDITO,'
      '   P.DT_ULTIMA_GERACAO_PRIMEIRA,'
      '   P.DT_ULTIMA_GERACAO_SEGUNDA,'
      '   P.CD_USUARIO_GERACAO_PRIMEIRA,'
      '   P.CD_USUARIO_GERACAO_SEGUNDA,'
      '   U.DS_LOGIN AS NOME,'
      '   U2.DS_LOGIN AS NOME_SEGUNDA,'
      '   P.NR_MINIMO_COORDENADOR,'
      '   P.NR_MAXIMO_COORDENADOR'
      'FROM'
      '   PINT_PROVAS P'
      '      LEFT JOIN PESSOAS U ON'
      '         (P.CD_USUARIO_GERACAO_PRIMEIRA = U.CD_PESSOA)'
      '      LEFT JOIN PESSOAS U2 ON'
      '         ( U2.CD_PESSOA = P.CD_USUARIO_GERACAO_SEGUNDA )')
    Params = <>
    Left = 272
    Top = 80
    object qryProvasCD_PROVA: TLargeintField
      FieldName = 'CD_PROVA'
      Required = True
    end
    object qryProvasDS_PROVA: TStringField
      FieldName = 'DS_PROVA'
      Size = 250
    end
    object qryProvasNR_ANOSEMESTRE: TIntegerField
      FieldName = 'NR_ANOSEMESTRE'
      EditFormat = '9999/9;0;_'
    end
    object qryProvasDT_PROVA: TDateTimeField
      FieldName = 'DT_PROVA'
    end
    object qryProvasSN_CREDITO: TSmallintField
      FieldName = 'SN_CREDITO'
    end
    object qryProvasNOME: TStringField
      FieldName = 'NOME'
      Size = 30
    end
    object qryProvasULTIMA_GERACAO_PRIMEIRA: TStringField
