      FieldName = 'ULTIMA_GERACAO_PRIMEIRA'
      Size = 255
      Calculated = True
    end
    object qryProvasDT_ULTIMA_GERACAO_PRIMEIRA: TDateTimeField
      FieldName = 'DT_ULTIMA_GERACAO_PRIMEIRA'
    end
    object qryProvasDT_ULTIMA_GERACAO_SEGUNDA: TDateTimeField
      FieldName = 'DT_ULTIMA_GERACAO_SEGUNDA'
    end
    object qryProvasULTIMA_GERACAO_SEGUNDA: TStringField
      FieldKind = fkCalculated
      FieldName = 'ULTIMA_GERACAO_SEGUNDA'
      Size = 255
      Calculated = True
    end
    object qryProvasNR_MINIMO_COORDENADOR: TSmallintField
      FieldName = 'NR_MINIMO_COORDENADOR'
    end
    object qryProvasNR_MAXIMO_COORDENADOR: TSmallintField
      FieldName = 'NR_MAXIMO_COORDENADOR'
    end
