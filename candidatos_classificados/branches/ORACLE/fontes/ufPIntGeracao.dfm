  object qryNumQuestoesSemCredito: TUMZReadOnlyQuery
    Connection = DM.db
    Params = <>
    DataSource = dsProvas
    SQLList.Strings = (
      
        'mysql-5=SELECT'#13#10#9'uni_tp.turma AS cd_turma,'#13#10#9'uni_tp.disciplina A' +
        'S cd_disciplina,'#13#10#9'uni_d.descricao AS ds_disciplina,'#13#10#9'sum('#13#10#13#10#9 +
        'IF('#13#10#9#9'ifnull('#13#10#9#9#9'pint_q_teste.cd_prova_origem,'#13#10#9#9#9'pint_q_prov' +
        'a.cd_prova_origem'#13#10#9#9')= pint_q_prova.cd_prova_origem,'#13#10#9#9'1,'#13#10#9#9'0' +
        #13#10#9')'#13#10#9')AS total_prova,'#13#10#9'sum('#13#10#13#10#9'IF('#13#10#9#9'ifnull('#13#10#9#9#9'pint_q_tes' +
        'te.cd_prova_origem,'#13#10#9#9#9'pint_q_prova.cd_prova_origem'#13#10#9#9')<> pint' +
        '_q_prova.cd_prova_origem,'#13#10#9#9'1,'#13#10#9#9'0'#13#10#9')'#13#10#9')AS total_not_prova,'#13 +
        #10#9'sum('#13#10#13#10#9'IF('#13#10#9#9'ifnull('#13#10#9#9#9'pint_q_teste.cd_prova_origem,'#13#10#9#9#9 +
        'pint_q_prova.cd_prova_origem'#13#10#9#9')= pint_q_prova.cd_prova_origem,' +
        #13#10#9#9'1,'#13#10#9#9'0'#13#10#9')'#13#10#9')+ sum('#13#10#13#10#9'IF('#13#10#9#9'ifnull('#13#10#9#9#9'pint_q_teste.cd' +
        '_prova_origem,'#13#10#9#9#9'pint_q_prova.cd_prova_origem'#13#10#9#9')<> pint_q_pr' +
        'ova.cd_prova_origem,'#13#10#9#9'1,'#13#10#9#9'0'#13#10#9')'#13#10#9')AS total,'#13#10#9'sum(pint_pqd.' +
        'sn_aprovado)AS aprovadas_coordenador,'#13#10#9'sum('#13#10#13#10#9'IF('#13#10#9#9'pint_q_p' +
        'rova.cd_questao_copia = 0,'#13#10#9#9'1,'#13#10#9#9'0'#13#10#9')'#13#10#9')+ sum('#13#10#13#10#9'IF('#13#10#9#9'p' +
        'int_q_prova.cd_questao_copia <> 0,'#13#10#9#9'1,'#13#10#9#9'0'#13#10#9')'#13#10#9')- sum(pint_' +
        'pqd.sn_aprovado)AS nao_aprovadas_coordenador,'#13#10#9'uni_p.cd_pessoa ' +
        'AS cd_pessoa,'#13#10#9'uni_p.nm_pessoa AS nm_pessoa,'#13#10#9'uni_g.nr_credito' +
        's_academicos AS nr_creditos_academicos'#13#10'FROM'#13#10#9'turmasprofessores' +
        ' AS uni_tp'#13#10'INNER JOIN pessoas AS uni_p ON('#13#10#9'uni_p.cd_pessoa = ' +
        'uni_tp.professor'#13#10')'#13#10'INNER JOIN disciplinas AS uni_d ON('#13#10#9'uni_d' +
        '.codigo = uni_tp.disciplina'#13#10'AND uni_d.curso = uni_tp.curso'#13#10')'#13#10 +
        'INNER JOIN cursos AS uni_c ON('#13#10#9'uni_c.codigo = uni_tp.curso'#13#10'AN' +
        'D uni_c.anosemestre = uni_tp.anosemestre'#13#10')'#13#10'INNER JOIN turmas A' +
        'S uni_t ON('#13#10#9'uni_t.anosemestre = uni_tp.anosemestre'#13#10'AND uni_t.' +
        'curso = uni_tp.curso'#13#10'AND uni_t.codigo = uni_tp.turma'#13#10')'#13#10'INNER ' +
        'JOIN gradecurricular AS uni_g ON('#13#10#9'uni_g.anosemestre = uni_tp.a' +
        'nosemestre'#13#10'AND uni_g.curso = uni_tp.curso'#13#10'AND uni_g.disciplina' +
        ' = uni_tp.disciplina'#13#10'AND uni_g.serie = uni_t.serie'#13#10'AND uni_g.c' +
        'd_grade = uni_t.cd_grade'#13#10'AND uni_g.turno = uni_t.turno'#13#10')'#13#10'INNE' +
        'R JOIN pint_provas_turmas AS pint_pt ON('#13#10#9'pint_pt.cd_prova = :p' +
        'aram_cd_prova'#13#10'AND pint_pt.cd_turma = uni_tp.turma'#13#10'AND pint_pt.' +
        'cd_curso = uni_tp.curso'#13#10'AND pint_pt.cd_disciplina = uni_tp.disc' +
        'iplina'#13#10'AND pint_pt.nr_anosemestre = uni_tp.anosemestre'#13#10')'#13#10'LEFT' +
        ' JOIN pint_provas_questoes_dis AS pint_pqd ON('#13#10#9'pint_pqd.nr_ano' +
        'semestre = uni_tp.anosemestre'#13#10'AND pint_pqd.cd_disciplina = uni_' +
        'tp.disciplina'#13#10'AND pint_pqd.cd_curso = uni_tp.curso'#13#10'AND pint_pq' +
        'd.cd_turma = uni_tp.turma'#13#10'AND pint_pqd.cd_prova = :param_cd_pro' +
        'va'#13#10')'#13#10'LEFT JOIN pint_questoes AS pint_q_prova ON('#13#10#9'pint_q_prov' +
        'a.cd_questao = pint_pqd.cd_questao'#13#10'AND pint_q_prova.cd_prova_or' +
        'igem = :param_cd_prova'#13#10'AND pint_q_prova.cd_responsavel = uni_p.' +
        'cd_pessoa'#13#10'AND pint_q_prova.sn_ativa = 1'#13#10'AND pint_q_prova.sn_ex' +
        'cluido = 0'#13#10')'#13#10'LEFT JOIN pint_questoes AS pint_q_teste ON('#13#10#9'pin' +
        't_q_teste.cd_questao = pint_q_prova.cd_questao_copia'#13#10'AND pint_q' +
        '_teste.cd_prova_origem <> :param_cd_prova'#13#10')'#13#10'GROUP BY'#13#10#9'uni_tp.' +
        'professor,'#13#10#9'pint_pt.cd_turma,'#13#10#9'uni_d.codigo'#13#10'ORDER BY'#13#10#9'uni_p.' +
        'nm_pessoa'
      
        'oracle=SELECT'#13#10#9'pint_pt.cd_turma AS cd_turma,'#13#10#9'uni_d.codigo AS ' +
        'cd_disciplina,'#13#10#9'FIRST_OCCURRENCE(uni_d.descricao) AS ds_discipl' +
        'ina,'#13#10#9'CAST(SUM('#13#10#13#10#9#9'CASE WHEN '#13#10#9#9#9'COALESCE(pint_q_teste.cd_pr' +
        'ova_origem, pint_q_prova.cd_prova_origem) = pint_q_prova.cd_prov' +
        'a_origem'#13#10#9#9'THEN'#13#10#9#9#9'1'#13#10#9#9'ELSE'#13#10#9#9#9'0'#13#10#9#9'END'#13#10#9') AS NUMBER(19)) A' +
        'S total_prova,'#13#10#9'CAST(SUM('#13#10#13#10#9#9'CASE WHEN'#13#10#9#9#9'COALESCE(pint_q_te' +
        'ste.cd_prova_origem, pint_q_prova.cd_prova_origem) <> pint_q_pro' +
        'va.cd_prova_origem'#13#10#9#9'THEN'#13#10#9#9#9'1'#13#10#9#9'ELSE'#13#10#9#9#9'0'#13#10#9#9'END'#13#10#9') AS NUM' +
        'BER(19)) AS total_not_prova,'#13#10#9'CAST(SUM('#13#10#13#10#9#9'CASE WHEN'#13#10#9#9#9'COAL' +
        'ESCE(pint_q_teste.cd_prova_origem, pint_q_prova.cd_prova_origem)' +
        ' = pint_q_prova.cd_prova_origem'#13#10#9#9'THEN'#13#10#9#9#9'1'#13#10#9#9'ELSE'#13#10#9#9#9'0'#13#10#9#9'E' +
        'ND'#13#10#9') + SUM('#13#10#9#9'CASE WHEN'#13#10#9#9#9'COALESCE (pint_q_teste.cd_prova_o' +
        'rigem, pint_q_prova.cd_prova_origem) <> pint_q_prova.cd_prova_or' +
        'igem'#13#10#9#9'THEN'#13#10#9#9#9'1'#13#10#9#9'ELSE'#13#10#9#9#9'0'#13#10#9#9'END'#13#10#9') AS NUMBER(19)) AS to' +
        'tal,'#13#10#9'CAST(SUM(pint_pqd.sn_aprovado) AS NUMBER(19)) AS aprovada' +
        's_coordenador,'#13#10#9'CAST(SUM('#13#10#9#9'CASE WHEN'#13#10#9#9#9'pint_q_prova.cd_ques' +
        'tao_copia = 0'#13#10#9#9'THEN'#13#10#9#9#9'1'#13#10#9#9'ELSE'#13#10#9#9#9'0'#13#10#9#9'END'#13#10#9')+ SUM('#13#10#13#10#9#9 +
        'CASE WHEN'#13#10#9#9#9'pint_q_prova.cd_questao_copia <> 0'#13#10#9#9'THEN'#13#10#9#9#9'1'#13#10 +
        #9#9'ELSE'#13#10#9#9#9'0'#13#10#9#9'END'#13#10#9') - SUM(pint_pqd.sn_aprovado) AS NUMBER(19' +
        ')) AS nao_aprovadas_coordenador,'#13#10#9'uni_tp.professor AS cd_pessoa' +
        ','#13#10#9'FIRST_OCCURRENCE(uni_p.nm_pessoa) AS nm_pessoa,'#13#10#9'CAST(FIRST' +
        '_OCCURRENCE(uni_g.nr_creditos_academicos) AS NUMBER(19)) AS nr_c' +
        'reditos_academicos'#13#10'FROM'#13#10#9'turmasprofessores uni_tp'#13#10#9'INNER JOIN' +
        ' pessoas uni_p ON('#13#10#9#9'uni_p.cd_pessoa = uni_tp.professor'#13#10#9')'#13#10#9'I' +
        'NNER JOIN disciplinas uni_d ON('#13#10#9#9'uni_d.codigo = uni_tp.discipl' +
        'ina'#13#10#9#9'AND uni_d.curso = uni_tp.curso'#13#10#9')'#13#10#9'INNER JOIN cursos un' +
        'i_c ON('#13#10#9#9'uni_c.codigo = uni_tp.curso'#13#10#9#9'AND uni_c.anosemestre ' +
        '= uni_tp.anosemestre'#13#10#9')'#13#10#9'INNER JOIN turmas uni_t ON('#13#10#9#9'uni_t.' +
        'anosemestre = uni_tp.anosemestre'#13#10#9#9'AND uni_t.curso = uni_tp.cur' +
        'so'#13#10#9#9'AND uni_t.codigo = uni_tp.turma'#13#10#9')'#13#10#9'INNER JOIN gradecurr' +
        'icular uni_g ON('#13#10#9#9'uni_g.anosemestre = uni_tp.anosemestre'#13#10#9#9'AN' +
        'D uni_g.curso = uni_tp.curso'#13#10#9#9'AND uni_g.disciplina = uni_tp.di' +
        'sciplina'#13#10#9#9'AND uni_g.serie = uni_t.serie'#13#10#9#9'AND uni_g.cd_grade ' +
        '= uni_t.cd_grade'#13#10#9#9'AND uni_g.turno = uni_t.turno'#13#10#9')'#13#10#9'INNER JO' +
        'IN pint_provas_turmas pint_pt ON('#13#10#9#9'pint_pt.cd_prova = :param_c' +
        'd_prova'#13#10#9#9'AND pint_pt.cd_turma = uni_tp.turma'#13#10#9#9'AND pint_pt.cd' +
        '_curso = uni_tp.curso'#13#10#9#9'AND pint_pt.cd_disciplina = uni_tp.disc' +
        'iplina'#13#10#9#9'AND pint_pt.nr_anosemestre = uni_tp.anosemestre'#13#10#9')'#13#10#9 +
        'LEFT JOIN pint_provas_questoes_dis pint_pqd ON('#13#10#9#9'pint_pqd.nr_a' +
        'nosemestre = uni_tp.anosemestre'#13#10#9#9'AND pint_pqd.cd_disciplina = ' +
        'uni_tp.disciplina'#13#10#9#9'AND pint_pqd.cd_curso = uni_tp.curso'#13#10#9#9'AND' +
        ' pint_pqd.cd_turma = uni_tp.turma'#13#10#9#9'AND pint_pqd.cd_prova = :pa' +
        'ram_cd_prova'#13#10#9')'#13#10#9'LEFT JOIN pint_questoes pint_q_prova ON('#13#10#9#9'p' +
        'int_q_prova.cd_questao = pint_pqd.cd_questao'#13#10#9#9'AND pint_q_prova' +
        '.cd_prova_origem = :param_cd_prova'#13#10#9#9'AND pint_q_prova.cd_respon' +
        'savel = uni_p.cd_pessoa'#13#10#9#9'AND pint_q_prova.sn_ativa = 1'#13#10#9#9'AND ' +
