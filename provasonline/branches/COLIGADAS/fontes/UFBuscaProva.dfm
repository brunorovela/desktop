  object qryDisciplinas: TUMZReadOnlyQuery
    Connection = DM.conn
    SortedFields = 'DS_DISCIPLINA'
    SQL.Strings = (
      'SELECT DISTINCT'
      '   M.CD_DISCIPLINA_PAI,'
      '   D.CODIGO CD_DISCIPLINA,'
      '   M.DS_DISCIPLINA,'
      '   T.PROFESSOR CD_RESPONSAVEL'
      'FROM'
      '   DISCIPLINAS_MESTRE M'
      '      JOIN POL_PROVAS P ON'
      '         (M.CD_DISCIPLINA_PAI = P.CD_DISCIPLINA_PAI)'
      '      JOIN DISCIPLINAS D ON'
      '         (M.CD_DISCIPLINA_PAI = D.CD_DISCIPLINA_PAI)'
      '         JOIN TURMASPROFESSORES T ON'
      '            (P.NR_ANOSEMESTRE = T.ANOSEMESTRE) AND'
      '            (D.CURSO = T.CURSO) AND'
      '            (D.CODIGO = T.DISCIPLINA) AND'
      '            (P.CD_RESPONSAVEL = T.PROFESSOR)'
      'WHERE'
      '   M.SN_ATIVA = 1 AND'
      '   P.NR_ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    IndexFieldNames = 'DS_DISCIPLINA Asc'
    Left = 560
    Top = 288
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    object qryDisciplinasCD_DISCIPLINA_PAI: TStringField
      FieldName = 'CD_DISCIPLINA_PAI'
      Required = True
      Size = 50
    end
    object qryDisciplinasCD_DISCIPLINA: TIntegerField
      FieldName = 'CD_DISCIPLINA'
    end
    object qryDisciplinasDS_DISCIPLINA: TStringField
      FieldName = 'DS_DISCIPLINA'
      Size = 255
    end
    object qryDisciplinasCD_RESPONSAVEL: TIntegerField
      FieldName = 'CD_RESPONSAVEL'
      Required = True
    end
  end
