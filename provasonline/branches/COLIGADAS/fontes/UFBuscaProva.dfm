    object qryProvasDS_SN_AVALIACAO: TStringField
      FieldKind = fkCalculated
      FieldName = 'DS_SN_AVALIACAO'
      Calculated = True
    end
    object qryProvasNM_RESPONSAVEL: TStringField
      DisplayWidth = 255
      FieldKind = fkLookup
      FieldName = 'NM_RESPONSAVEL'
      LookupDataSet = qryProfessores
      LookupKeyFields = 'CD_PESSOA'
      LookupResultField = 'NM_PESSOA'
