  object qryProvas: TUMZReadOnlyQuery
    Connection = DM.conn
    OnCalcFields = qryProvasCalcFields
    SQL.Strings = (
      'SELECT'
      '   R.CD_PROVA,'
      '   R.CD_RESPONSAVEL,'
      '   R.CD_DISCIPLINA_PAI,'
      '   R.DS_PROVA,'
      '   R.DT_INICIO,'
      '   R.DT_FIM,'
      '   R.SN_AVALIACAO,'
      '   A.DS_AVALIACAO,'
      '   R.CD_AVALIACAO_TIPO'
      'FROM'
      '   POL_PROVAS R'
      '      JOIN AVALIACOES_TIPOS A ON'
      '         (R.CD_AVALIACAO_TIPO = A.CD_AVALIACAO_TIPO)'
      'WHERE'
      '   R.SN_ATIVO = 1')
    Params = <>
    Left = 240
    Top = 296
    object qryProvasCD_PROVA: TIntegerField
      FieldName = 'CD_PROVA'
      Required = True
    end
    object qryProvasCD_RESPONSAVEL: TIntegerField
      FieldName = 'CD_RESPONSAVEL'
      Required = True
    end
    object qryProvasCD_DISCIPLINA_PAI: TStringField
      FieldName = 'CD_DISCIPLINA_PAI'
      Size = 255
    end
    object qryProvasDS_PROVA: TStringField
      FieldName = 'DS_PROVA'
      Size = 255
    end
    object qryProvasDT_INICIO: TDateTimeField
      FieldName = 'DT_INICIO'
    end
    object qryProvasDT_FIM: TDateTimeField
      FieldName = 'DT_FIM'
    end
    object qryProvasSN_AVALIACAO: TSmallintField
      FieldName = 'SN_AVALIACAO'
