  object qryPessoas: TUMZReadOnlyQuery
    Connection = DM.conn
    Filtered = True
    SQL.Strings = (
      'SELECT DISTINCT'
      '    PP.CD_PROVA_PESSOA,'
      '    PP.CD_PESSOA,'
      '    PP.SN_FINALIZADA,'
      '    P.NM_PESSOA,'
      '    T.CD_TURMA,'
      '    T.CD_CURSO'
      ' FROM'
      '    POL_PROVAS_PESSOAS PP'
      '       JOIN PESSOAS P ON'
      '          (PP.CD_PESSOA = P.CD_PESSOA)'
      '          JOIN FICHAINDIVIDUAL F ON'
      '             (P.CD_PESSOA = F.CODIGOALUNO)'
      '             JOIN POL_PROVAS_TURMAS T ON'
      '                (F.CURSO = T.CD_CURSO) AND'
      '                (F.DISCIPLINA = T.CD_DISCIPLINA) AND'
      '                (F.TURMA = T.CD_TURMA) AND'
      '                (F.ANOSEMESTRE = T.NR_ANOSEMESTRE) AND'
      '                (PP.CD_PROVA = T.CD_PROVA)'
      ' WHERE'
      '    PP.CD_PROVA = :CD_PROVA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_PROVA'
        ParamType = ptUnknown
      end>
    Left = 72
    Top = 152
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_PROVA'
        ParamType = ptUnknown
      end>
    object qryPessoasCD_PROVA_PESSOA: TIntegerField
      FieldName = 'CD_PROVA_PESSOA'
      Required = True
    end
    object qryPessoasCD_PESSOA: TIntegerField
      FieldName = 'CD_PESSOA'
    end
    object qryPessoasSN_FINALIZADA: TSmallintField
      FieldName = 'SN_FINALIZADA'
    end
    object qryPessoasNM_PESSOA: TStringField
      FieldName = 'NM_PESSOA'
      Size = 60
    end
    object qryPessoasCD_TURMA: TStringField
      FieldName = 'CD_TURMA'
      Required = True
      Size = 50
    end
    object qryPessoasCD_CURSO: TStringField
      FieldName = 'CD_CURSO'
      Size = 15
    end
  end
  object dsPessoas: TDataSource
    AutoEdit = False
    DataSet = qryPessoas
    Left = 56
    Top = 112
  end
end
