  object qryTurmas: TUMZReadOnlyQuery
    Connection = DM.conn
    SortedFields = 'CD_TURMA'
    SQL.Strings = (
      'SELECT'
      '   CD_TURMA'
      'FROM'
      '   POL_PROVAS_TURMAS'
      'WHERE'
      '   CD_PROVA = :CD_PROVA')
