  object qrySortAlunos: TUMZReadOnlyQuery
    Connection = DM.conn
    SQL.Strings = (
      'SELECT'
      '   PP.CD_PROVA_PESSOA,'
      '   CD_TURMA'
      'FROM'
      '   POL_PROVAS_PESSOAS PP'
      '      JOIN PESSOAS P ON'
      '         (PP.CD_PESSOA = P.CD_PESSOA)'
      '         JOIN FICHAINDIVIDUAL F ON'
      '            (P.CD_PESSOA = F.CODIGOALUNO)'
      '            JOIN POL_PROVAS_TURMAS T ON'
      '               (F.CURSO = T.CD_CURSO) AND'
      '               (F.DISCIPLINA = T.CD_DISCIPLINA) AND'
      '               (F.TURMA = T.CD_TURMA) AND'
      '               (F.ANOSEMESTRE = T.NR_ANOSEMESTRE) AND'
      '               (PP.CD_PROVA = T.CD_PROVA)'
      '            JOIN SITUACAO S ON'
      '               (F.SITUACAO = S.CD_SITUACAO)'
      'WHERE'
      '   PP.CD_PROVA = :CD_PROVA AND'
      '   S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 11)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_PROVA'
        ParamType = ptUnknown
      end>
    Left = 160
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_PROVA'
        ParamType = ptUnknown
      end>
    object qrySortAlunosCD_PROVA_PESSOA: TIntegerField
      FieldName = 'CD_PROVA_PESSOA'
      Required = True
    end
    object qrySortAlunosCD_TURMA: TStringField
      FieldName = 'CD_TURMA'
      Required = True
      Size = 50
    end
  end
