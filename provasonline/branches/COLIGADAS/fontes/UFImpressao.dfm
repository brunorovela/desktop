  object qryRelatorios: TUMZReadOnlyQuery
    Connection = DM.conn
    SortedFields = 'DS_GRUPO;NM_RELATORIO'
    SQL.Strings = (
      'SELECT'
      '   R.NM_RELATORIO,'
      '   R.CD_MODULO,'
      '   R.CD_CABECALHO,'
      '   R.DS_GRUPO,'
      '   R.NM_ARQUIVO,'
      '   R.DS_PARAMETROS,'
      '   R.DS_FORMULA,'
      '   R.DS_SQL_EXP,'
      '   R.DS_ESPECIAL,'
      '   R.DS_ORDEM,'
      '   R.SN_DISPONIVEL,'
      '   R.DS_FORMULA_GRUPO,'
      '   R.DS_SQL,'
      '   R.DS_SQL_ORDEM,'
      '   R.CD_RELATORIO,'
      '   R.SN_IMPRESSAO_NUMERO,'
      '   R.DS_VARIAVEIS'
      'FROM'
      '   RELATORIOS R,'
      '   NU_PARAMETROS P,'
      '   NU_MODULOS M'
      'WHERE'
      '   R.NM_ARQUIVO = P.DS_VALOR AND'
      '   P.CD_MODULO = M.CD_MODULO AND'
      '   M.DS_CHAVE = '#39'ProvaOnline'#39' AND'
      '   P.DS_PARAMETRO LIKE '#39'relatorio.%'#39)
    Params = <>
    IndexFieldNames = 'DS_GRUPO Asc;NM_RELATORIO Asc'
