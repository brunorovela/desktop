  object qyDadosAluno: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'pa.*,'
      #9'p.nm_pessoa'
      'FROM'
      #9'leitora_provas_alunos pa'
      
        #9#9'LEFT JOIN matriculas m ON (m.codigoaluno = pa.cd_pessoa AND m.' +
        'anosemestre = pa.nr_anosemestre AND m.turma = pa.cd_turma)'
      #9#9'INNER JOIN pessoas p ON (p.cd_pessoa = pa.cd_pessoa)'
      
        #9#9'INNER JOIN leitora_provas_gabaritos pg ON (pg.cd_prova_gabarit' +
        'o = pa.cd_prova_gabarito)'
      'WHERE'
      #9'pg.cd_prova = :cd_prova AND'
      #9'p.cd_pessoa = :cd_pessoa')
    Params = <
      item
        DataType = ftString
        Name = 'cd_prova'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 472
    Top = 96
    ParamData = <
      item
        DataType = ftString
        Name = 'cd_prova'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qyDadosAlunocd_prova_aluno: TIntegerField
      FieldName = 'cd_prova_aluno'
    end
    object qyDadosAlunocd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
    end
    object qyDadosAlunocd_prova_gabarito: TIntegerField
      FieldName = 'cd_prova_gabarito'
    end
    object qyDadosAlunonr_acertos: TFloatField
      FieldName = 'nr_acertos'
    end
    object qyDadosAlunocd_turma: TStringField
      FieldName = 'cd_turma'
      Size = 15
    end
    object qyDadosAlunonr_anosemestre: TSmallintField
      FieldName = 'nr_anosemestre'
    end
