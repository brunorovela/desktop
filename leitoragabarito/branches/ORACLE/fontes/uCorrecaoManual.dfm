  object qyInconsistencias: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   p.cd_pessoa,'
      '   p.nm_pessoa,'
      '   pa.cd_turma'
      'FROM'
      '   leitora_provas_alunos_resp par'
      
        'INNER JOIN leitora_provas_alunos_resp par2 ON (par2.cd_prova_alu' +
        'no = par.cd_prova_aluno AND par2.nr_questao = par.nr_questao)'
      
        'INNER JOIN leitora_provas_alunos pa ON (pa.cd_prova_aluno = par.' +
        'cd_prova_aluno) '
      
        'INNER JOIN leitora_provas_gabaritos pg ON (pg.cd_prova_gabarito ' +
        '= pa.cd_prova_gabarito)'
      'INNER JOIN pessoas p ON (p.cd_pessoa = pa.cd_pessoa) '
      'WHERE'
      
        '   par.ds_resposta != par2.ds_resposta OR par.db_pontuacao != pa' +
        'r2.db_pontuacao'
      'AND'
      '   pg.cd_prova = :cd_prova'
      'GROUP BY'
      '  p.cd_pessoa')
    Params = <
      item
        DataType = ftString
        Name = 'cd_prova'
        ParamType = ptUnknown
      end>
    Left = 600
    Top = 72
    ParamData = <
      item
        DataType = ftString
        Name = 'cd_prova'
        ParamType = ptUnknown
      end>
    object qyInconsistenciascd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
    end
    object qyInconsistenciasnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyInconsistenciascd_turma: TStringField
      FieldName = 'cd_turma'
      Size = 15
    end
  end
  object srcInconsistencias: TDataSource
    DataSet = qyInconsistencias
    Left = 632
    Top = 72
  end
