  object qyProva: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   *'
      'FROM'
      '   leitora_provas'
      'WHERE'
      '   cd_prova = :cd_prova')
    Params = <
      item
        DataType = ftString
        Name = 'cd_prova'
        ParamType = ptUnknown
      end>
    Left = 96
    Top = 32
