  object qyDisciplina: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   pd.cd_prova_disciplina,'
      '   d.descricao'
      'FROM'
      '   leitora_provas_disciplinas pd'
      
        '      INNER JOIN disciplinas d ON (d.codigo = pd.cd_disciplina A' +
        'ND d.curso = pd.cd_curso)'
      'WHERE'
      '   pd.cd_prova = :cd_prova'
      'ORDER BY'
      '   d.descricao')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_prova'
        ParamType = ptUnknown
      end>
    DataSource = srcGabarito
    Left = 352
    Top = 192
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_prova'
        ParamType = ptUnknown
      end>
    object qyDisciplinacd_prova_disciplina: TIntegerField
      FieldName = 'cd_prova_disciplina'
      Origin = 'WMESTRE12.leitora_provas_disciplinas.cd_prova_disciplina'
    end
    object qyDisciplinadescricao: TStringField
      FieldName = 'descricao'
      Size = 100
    end
  end
