  object qryRelatorios: TUMZReadOnlyQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'mysql-5=SELECT'#13#10'  R.NM_RELATORIO,'#13#10'  R.CD_MODULO,'#13#10'  R.CD_CABECA' +
        'LHO,'#13#10'  R.DS_GRUPO,'#13#10'  R.NM_ARQUIVO,'#13#10'  R.DS_PARAMETROS,'#13#10'  R.DS' +
        '_FORMULA,'#13#10'  R.DS_SQL_EXP,'#13#10'  R.DS_ESPECIAL,'#13#10'  R.DS_ORDEM,'#13#10'  R' +
        '.SN_DISPONIVEL,'#13#10'  R.DS_FORMULA_GRUPO,'#13#10'  R.DS_SQL,'#13#10'  R.DS_SQL_' +
        'ORDEM,'#13#10'  R.SN_IMPRESSAO_NUMERO,'#13#10'  R.CD_RELATORIO,'#13#10'  R.DS_VARI' +
        'AVEIS'#13#10'FROM'#13#10'  RELATORIOS R'#13#10'  INNER JOIN NU_PARAMETROS P ON (R.' +
        'NM_ARQUIVO LIKE P.DS_VALOR)'#13#10'  INNER JOIN NU_MODULOS M ON (P.CD_' +
        'MODULO = M.CD_MODULO)'#13#10'WHERE'#13#10'  M.DS_CHAVE LIKE '#39'ProvaInterdisci' +
        'plinar'#39' AND'#13#10'  P.DS_PARAMETRO LIKE '#39'relatorios.%'#39#13#10
      
        'oracle=SELECT'#13#10'  R.NM_RELATORIO,'#13#10'  R.CD_MODULO,'#13#10'  R.CD_CABECAL' +
        'HO,'#13#10'  R.DS_GRUPO,'#13#10'  R.NM_ARQUIVO,'#13#10'  R.DS_PARAMETROS,'#13#10'  R.DS_' +
        'FORMULA,'#13#10'  R.DS_SQL_EXP,'#13#10'  R.DS_ESPECIAL,'#13#10'  R.DS_ORDEM,'#13#10'  R.' +
        'SN_DISPONIVEL,'#13#10'  R.DS_FORMULA_GRUPO,'#13#10'  R.DS_SQL,'#13#10'  R.DS_SQL_O' +
        'RDEM,'#13#10'  R.SN_IMPRESSAO_NUMERO,'#13#10'  R.CD_RELATORIO,'#13#10'  R.DS_VARIA' +
        'VEIS'#13#10'FROM'#13#10'  RELATORIOS R'#13#10'  INNER JOIN NU_PARAMETROS P ON (R.N' +
        'M_ARQUIVO LIKE P.DS_VALOR)'#13#10'  INNER JOIN NU_MODULOS M ON (P.CD_M' +
        'ODULO = M.CD_MODULO)'#13#10'WHERE'#13#10'  M.DS_CHAVE LIKE '#39'ProvaInterdiscip' +
        'linar'#39' AND'#13#10'  P.DS_PARAMETRO LIKE '#39'relatorios.%'#39)
    Left = 120
    Top = 248
