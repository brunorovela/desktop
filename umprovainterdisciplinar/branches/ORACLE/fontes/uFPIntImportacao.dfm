  object qryQuestoesPessoa: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   cd_prova_pessoa_questao,'
      '   cd_prova_pessoa,'
      '   cd_questao,'
      '   nr_ordem_questao,'
      '   cd_alternativa_resposta'
      'FROM'
      '   pint_provas_pessoas_questoes'
      'WHERE'
      '   cd_prova_pessoa IN ('
      '      SELECT'
      '         cd_prova_pessoa'
      '      FROM'
      '         pint_provas_pessoas'
      '      WHERE'
      '         cd_prova = :cd_prova AND'
      '         cd_pessoa = :cd_pessoa'
      '   )')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_prova'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 104
    Top = 336
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_prova'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
  end
  object qryAlternativasPessoa: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   a.cd_prova_pessoa_alternativa,'
      '   a.cd_prova_pessoa_questao,'
      '   a.cd_alternativa,'
      '   a.nr_ordem_alternativa'
      'FROM'
      '   pint_provas_pessoas_alt a'
      
        #9' INNER JOIN pint_provas_pessoas_questoes q ON (a.cd_prova_pesso' +
        'a_questao = q.cd_prova_pessoa_questao)'
      'WHERE'
      '   q.cd_prova_pessoa IN ('
      '      SELECT'
      '         cd_prova_pessoa'
      '      FROM'
      '         pint_provas_pessoas'
      '      WHERE'
