  object qryProvas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   cd_prova,'
      '   ds_prova,'
      '   nr_anosemestre,'
      '   dt_prova,'
      '   sn_finalizada,'
      '   sn_atribuir_nota_automatico'
      'FROM'
