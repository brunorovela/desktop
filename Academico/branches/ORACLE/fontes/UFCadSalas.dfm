  object qrySalas: TUMZQuery
    Connection = DM.db
    AfterOpen = qrySalasAfterOpen
    Filtered = True
    AfterPost = qrySalasAfterPost
    AfterCancel = qrySalasAfterCancel
    OnNewRecord = qrySalasNewRecord
    SQL.Strings = (
      'SELECT'
      '   id as CD_SALA,'
      '   DS_SALA,'
      '   NR_QTD_VAGAS as QTD_VAGAS,'
      '   SN_ATIVO'
      'FROM'
      '   unim_sala'
      'WHERE'
      '   SN_ATIVO = 1')
    Params = <>
    Left = 64
    Top = 264
    object qrySalasCD_SALA: TLargeintField
      FieldName = 'CD_SALA'
      Required = True
    end
    object qrySalasDS_SALA: TStringField
