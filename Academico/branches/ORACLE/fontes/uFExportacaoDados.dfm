  object qyAlunos: TUMZQuery
    Connection = DM.db
    OnCalcFields = qyAlunosCalcFields
    SQL.Strings = (
      
        'SELECT epp.cd_pessoa, p.nm_pessoa, epp.cd_turma, epp.dt_exportad' +
        'o,'
      
        '       c.codigo AS cd_curso, GET_PERCCH_CURSADA(epp.cd_pessoa, e' +
        'pp.cd_turma, epp.nr_anosemestre) AS nr_carga_horaria,'
      
        '       s.ds_valor AS ds_situacao, ss.ds_valor AS ds_situacao_cur' +
        'so, epp.cd_situacao, epp.cd_situacao_curso, epp.nr_anosemestre'
      'FROM expo_processo_pessoas epp'
      
        '     INNER JOIN turmas t ON ( t.codigo = epp.cd_turma AND t.anos' +
        'emestre = epp.nr_anosemestre )'
      
        '     INNER JOIN cursos c ON ( c.codigo = t.curso AND c.anosemest' +
        're = t.anosemestre )'
      '     INNER JOIN pessoas p ON ( p.cd_pessoa = epp.cd_pessoa )'
      
        '     INNER JOIN situacoes s ON ( ss.cd_modulo = 1080 AND ss.cd_s' +
        'ituacao = epp.cd_situacao )'
      'WHERE 1=1 AND epp.sn_selecionado = 1')
    Params = <>
    Left = 16
    Top = 240
    object qyAlunoscd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
    end
    object qyAlunosnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyAlunoscd_turma: TStringField
      FieldName = 'cd_turma'
      Size = 50
    end
    object qyAlunoscd_curso: TStringField
      FieldName = 'cd_curso'
      Size = 15
    end
    object qyAlunosnr_carga_horaria: TFloatField
      FieldName = 'nr_carga_horaria'
      DisplayFormat = '#00.00'
    end
    object qyAlunosnr_anosemestre: TSmallintField
      FieldName = 'nr_anosemestre'
    end
    object qyAlunosds_situacao: TStringField
      FieldName = 'ds_situacao'
      Size = 100
    end
    object qyAlunoscd_situacao: TSmallintField
      FieldName = 'cd_situacao'
    end
    object qyAlunosdt_exportado: TDateTimeField
      FieldName = 'dt_exportado'
    end
    object qyAlunoscd_situacao_curso: TSmallintField
      FieldName = 'cd_situacao_curso'
    end
    object qyAlunosds_situacao_curso: TStringField
      FieldName = 'ds_situacao_curso'
      Size = 100
    end
    object qyAlunosnr_anosemestre_formatado: TStringField
      FieldKind = fkCalculated
      FieldName = 'nr_anosemestre_formatado'
      Calculated = True
    end
    object qyAlunosds_situacao_matricula: TStringField
      FieldName = 'ds_situacao_matricula'
    end
    object qyAlunossn_excluir: TStringField
      FieldKind = fkCalculated
      FieldName = 'sn_excluir'
      Calculated = True
    end
  end
  object dsAlunos: TDataSource
    DataSet = qyAlunos
    Left = 16
    Top = 272
  end
  object qyArquivosExportados: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      
        '  epl.cd_processo, epl.nr_exportacao, epl.sn_oficial, p.nm_pesso' +
        'a AS nome,'
      
        '  DATE_FORMAT(epl.dt_exportacao, '#39'%d/%m/%Y %H:%i:%s'#39') AS dt_expo' +
        'rtacao'
      'FROM'
      '  expo_processo_logs epl'
      '  INNER JOIN pessoas p ON (p.cd_pessoa = epl.cd_usuario)'
      'WHERE'
      '  epl.cd_processo = :cd_processo'
      'ORDER BY'
      '  epl.dt_exportacao DESC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_processo'
        ParamType = ptUnknown
      end>
    Left = 824
    Top = 376
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_processo'
        ParamType = ptUnknown
      end>
    object qyArquivosExportadoscd_processo: TIntegerField
      FieldName = 'cd_processo'
      Origin = 'WMESTRE12.expo_processo_logs.cd_processo'
    end
    object qyArquivosExportadosnr_exportacao: TIntegerField
      FieldName = 'nr_exportacao'
      Origin = 'WMESTRE12.expo_processo_logs.nr_exportacao'
    end
    object qyArquivosExportadossn_oficial: TIntegerField
      FieldName = 'sn_oficial'
      Origin = 'WMESTRE12.expo_processo_logs.sn_oficial'
    end
    object qyArquivosExportadosnome: TStringField
      FieldName = 'nome'
      Size = 100
    end
    object qyArquivosExportadosdt_exportacao: TStringField
      FieldName = 'dt_exportacao'
      Size = 100
    end
  end
  object dsArquivosExportados: TDataSource
    DataSet = qyArquivosExportados
    Left = 824
    Top = 408
  end
