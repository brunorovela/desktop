  object dsDespesas: TDataSource
    DataSet = qryDespesas
    Left = 96
    Top = 256
  end
  object qryDespesas: TUMZQuery
    Connection = DM.db
    AfterRefresh = qryDespesasAfterRefresh
    UpdateObject = updDespesas
    SQL.Strings = (
      'SELECT'
      '  D.`CD_DESPESA`,'
      '  D.`DS_OBSERVACAO`,'
      '  D.`VL_TOTAL`,'
      '  C.`DS_CONTA`,'
      '  T.`DS_TIPO_DESPESA`,'
      '  S.`DS_SITUACAO`,'
      '  P.`NM_PESSOA`,'
      '  D.`CD_DIARIO_AULA`'
      'FROM'
      '  `LGTC_DESPESA_AULA` D'
      ''
      '    JOIN `PESSOAS` P ON'
      '      (D.`CD_FORNECEDOR` = P.`CD_PESSOA`)'
      ''
      '    JOIN `LGTC_TIPO_DESPESA` T ON'
      '      (D.`CD_TIPO_DESPESA` = T.`CD_TIPO_DESPESA`)'
      ''
      '    JOIN `LGTC_DESPESA_SITUACAO` S ON'
      '      (D.`CD_SITUACAO` = S.`CD_SITUACAO`)'
      ''
      '    JOIN `FIN_CONFIG_PLANO_CONTAS` C ON'
      '      (D.`CD_CONTA` = C.`CD_CONTA`) AND'
      '      (D.`CD_COLIGADA_MATRIZ` = C.`CD_COLIGADA_MATRIZ`)'
      'WHERE'
      '  D.`CD_DIARIO_AULA` = :CD_DIARIO_AULA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    DataSource = dsAula
    LinkedFields = 'CD_DIARIO_AULA'
    Left = 128
    Top = 256
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    object qryDespesasCD_DESPESA: TLargeintField
      FieldName = 'CD_DESPESA'
      Required = True
    end
    object qryDespesasDS_OBSERVACAO: TStringField
      FieldName = 'DS_OBSERVACAO'
      Size = 255
    end
    object qryDespesasVL_TOTAL: TFloatField
      FieldName = 'VL_TOTAL'
      DisplayFormat = '###,###,##0.00'
    end
    object qryDespesasDS_CONTA: TStringField
      FieldName = 'DS_CONTA'
      Size = 255
    end
    object qryDespesasDS_TIPO_DESPESA: TStringField
      FieldName = 'DS_TIPO_DESPESA'
      Required = True
      Size = 64
    end
    object qryDespesasDS_SITUACAO: TStringField
      FieldName = 'DS_SITUACAO'
      Required = True
      Size = 64
    end
    object qryDespesasNM_PESSOA: TStringField
      FieldName = 'NM_PESSOA'
      Size = 60
    end
    object qryDespesasCD_DIARIO_AULA: TLargeintField
      FieldName = 'CD_DIARIO_AULA'
      Required = True
    end
  end
  object qryAula: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  A.`CD_DIARIO_AULA`,'
      '  A.`TURMA`,'
      '  A.`CD_PROFESSOR`,'
      '  A.`BIMESTRE`,'
      '  A.`NRO_AULA`,'
      '  A.`DATA`,'
      '  A.`ANOSEMESTRE`,'
      '  D.`DESCRICAO`,'
      '  T.`CURSO`,'
      '  P.`NM_PESSOA`'
      'FROM'
      '  `DIARIO_AULAS` A'
      ''
      '    JOIN `PESSOAS` P ON'
      '      (A.`CD_PROFESSOR` = P.`CD_PESSOA`)'
      ''
      '    JOIN `TURMAS` T ON'
      '      (A.`TURMA` = T.`CODIGO`) AND'
      '      (A.`ANOSEMESTRE` = T.`ANOSEMESTRE`)'
      ''
      '      JOIN `DISCIPLINAS` D ON'
      '        (T.`CURSO` = D.`CURSO`) AND'
      '        (A.`DISCIPLINA` = D.`CODIGO`)'
      'WHERE'
      '  A.`CD_DIARIO_AULA` = :CD_DIARIO_AULA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    Left = 688
    Top = 32
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    object qryAulaCD_DIARIO_AULA: TLargeintField
      FieldName = 'CD_DIARIO_AULA'
      Required = True
    end
    object qryAulaTURMA: TStringField
      FieldName = 'TURMA'
      Required = True
      Size = 50
    end
    object qryAulaCD_PROFESSOR: TIntegerField
      FieldName = 'CD_PROFESSOR'
      Required = True
    end
    object qryAulaBIMESTRE: TSmallintField
      FieldName = 'BIMESTRE'
