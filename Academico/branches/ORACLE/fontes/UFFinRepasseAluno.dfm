  object qryAlunos: TUMZReadOnlyQuery
    Connection = DM.db
    SortedFields = 'NM_PESSOA'
    SQL.Strings = (
      'SELECT'
      '  M.CODIGOALUNO,'
      '  P.NM_PESSOA,'
      '  S.CD_SITUACAO_PAI,'
      '  S.DS_SITUACAO,'
      '  C.CD_CONTRATO,'
      '  C.NR_PARCELAS,'
      '  C.VL_REPASSE,'
      
        '  CAST(COALESCE(C.SN_ATIVO, S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 11' +
        ', 14, 15)) AS UNSIGNED) SN_ATIVO'
      'FROM'
      '  MATRICULAS M'
      ''
      '    JOIN PESSOAS P ON'
      '      (M.CODIGOALUNO = P.CD_PESSOA)'
      ''
      '    JOIN SITUACAO S ON'
      '      (M.SITUACAO = S.CD_SITUACAO)'
      ''
      '    LEFT JOIN CONV_CONTRATOS_TURMAS_PESSOAS C ON'
      '      (M.CODIGOALUNO = C.CD_PESSOA) AND'
      '      (M.TURMA = C.CD_TURMA) AND'
      '      (M.ANOSEMESTRE = C.NR_ANOSEMESTRE) AND'
      '      (C.CD_CONTRATO = :CD_CONTRATO)'
      'WHERE'
      '  M.TURMA = :CD_TURMA AND'
      '  M.ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_CONTRATO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    IndexFieldNames = 'NM_PESSOA Asc'
    Left = 72
    Top = 200
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_CONTRATO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    object qryAlunosCODIGOALUNO: TIntegerField
      FieldName = 'CODIGOALUNO'
    end
    object qryAlunosNM_PESSOA: TStringField
      FieldName = 'NM_PESSOA'
      Size = 60
    end
    object qryAlunosCD_SITUACAO_PAI: TIntegerField
      FieldName = 'CD_SITUACAO_PAI'
    end
    object qryAlunosDS_SITUACAO: TStringField
      FieldName = 'DS_SITUACAO'
      Size = 15
    end
    object qryAlunosCD_CONTRATO: TLargeintField
      FieldName = 'CD_CONTRATO'
    end
    object qryAlunosNR_PARCELAS: TSmallintField
      FieldName = 'NR_PARCELAS'
    end
    object qryAlunosVL_REPASSE: TFloatField
      FieldName = 'VL_REPASSE'
    end
    object qryAlunosSN_ATIVO: TFloatField
      FieldName = 'SN_ATIVO'
    end
  end
