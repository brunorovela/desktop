  object qryTurma: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  CD_CONTRATO,'
      '  CD_TURMA,'
      '  NR_ANOSEMESTRE,'
      '  NR_PARCELAS,'
      '  VL_REPASSE,'
      '  SN_ATIVO,'
      '  DT_REFERENCIA'
      'FROM'
      '  CONV_CONTRATOS_TURMAS'
      'WHERE'
      '  CD_CONTRATO = :CD_CONTRATO AND'
      '  CD_TURMA = :CD_TURMA AND'
      '  NR_ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
