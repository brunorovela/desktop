  object qryDispHorariosU: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'select'
      #9#9'cd_horario,'
      #9#9'ds_nome,'
      #9#9'ds_chave_integracao,'
      #9#9'cd_turno,'
      '    cd_coligada'
