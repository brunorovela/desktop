    end
  end
  object qryDispHorariosUnimestreU: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'select '
      
        #9'disp_hu.cd_uni_horario, disp_hu.cd_horario, uni_h.ds_horario, u' +
        'ni_h.hr_inicio, uni_h.hr_fim, uni_h.ds_sigla, uni_h.turno, uni_h' +
        '.ds_chave, uni_h.cd_horario_urania, uni_h.ds_categoria, uni_h.qt' +
        'd_aulas'
      'from '
      #9'disp_horarios_unimestre disp_hu'
      #9
      #9'INNER JOIN horarios as uni_h ON ('
      #9#9'uni_h.codigo = disp_hu.cd_uni_horario'
      #9')'
      ''
      #9'where disp_hu.cd_horario = :cd_horario')
    Params = <
      item
        DataType = ftInteger
        Name = 'cd_horario'
        ParamType = ptUnknown
      end>
    DataSource = dsDispHorarios
    Left = 240
    Top = 112
