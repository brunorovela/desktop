  object qryCursos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      ' SELECT '
      '    cc.CD_CURSO as codigo  , CM.DS_CURSO as descricao'
      ' FROM'
      '    cursos_mestre cm'
      
        '    INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO' +
        ' AND cc.SN_ATIVO = 1)')
    Params = <>
    Left = 636
    Top = 589
    object qryCursoscodigo: TStringField
      FieldName = 'codigo'
      Required = True
      Size = 15
    end
