  object tblDespesas: TUMZQuery
    Connection = DM.db
    BeforePost = tblDespesasBeforePost
    AfterPost = tblDespesasAfterPost
    OnNewRecord = tblDespesasNewRecord
    SQL.Strings = (
      'select '
      '   *'
      'from '
      '   turmas_despesas'
      'where '
      '  nr_anosemestre = :anosemestre and '
      '  cd_turma = :codigo'
      '  '
      'order by dt_despesa ')
    Params = <
      item
        DataType = ftSmallint
        Name = 'anosemestre'
        ParamType = ptUnknown
        Size = 2
      end
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
        Size = 16
      end>
    DataSource = dsTurmas
    Left = 524
    Top = 241
    ParamData = <
      item
        DataType = ftSmallint
        Name = 'anosemestre'
        ParamType = ptUnknown
        Size = 2
      end
      item
        DataType = ftString
        Name = 'codigo'
        ParamType = ptUnknown
        Size = 16
      end>
