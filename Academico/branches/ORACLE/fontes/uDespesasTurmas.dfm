  object tblTurmas: TUMZQuery
    Connection = DM.db
    OnNewRecord = tblDespesasNewRecord
    SQL.Strings = (
      'select '
      
        '   t.codigo, t.curso, c.descricao desc_curso, t.descricao desc_t' +
        'urma, t.anosemestre'
      'from '
      '   turmas t, cursos c'
      'where'
      '   t.curso = c.codigo and '
      '   t.anosemestre = c.anosemestre'
      '  and t.anosemestre = :anosemestre'
      'order by t.codigo')
    Params = <
      item
        DataType = ftInteger
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    Left = 524
    Top = 281
    ParamData = <
      item
        DataType = ftInteger
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
