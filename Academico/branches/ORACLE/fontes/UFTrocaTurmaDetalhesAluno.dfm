  object qryFichaIndividual: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT DISTINCT'
      '  F.ANOSEMESTRE NR_ANOSEMESTRE,'
      '  F.TURMA CD_TURMA,'
      '  F.CODIGOALUNO CD_PESSOA,'
      '  F.DISCIPLINA CD_DISCIPLINA,'
      '  F.SERIE NR_SERIE,'
      '  F.TURMAMATRICULA CD_TURMA_MATRICULA,'
      '  D.DESCRICAO DS_DISCIPLINA,'
      '  D.SIGLA DS_SIGLA,'
      '  F.CURSO CD_CURSO,'
      '  M.SITUACAO CD_SITUACAO,'
      '  COALESCE(TOP.serie,0) = -100 as SN_OPTATIVA'
      'FROM'
      #9'FICHAINDIVIDUAL F'
      #9#9'JOIN DISCIPLINAS D ON'
      #9#9#9'(F.DISCIPLINA = D.CODIGO) AND'
      #9#9#9'(F.CURSO = D.CURSO)'
      #9#9'JOIN SITUACAO S ON'
      #9#9#9'(F.SITUACAO = S.CD_SITUACAO)'
      '    JOIN MATRICULAS M ON'
      '      (F.ANOSEMESTRE = M.ANOSEMESTRE) AND'
      '      (F.TURMAMATRICULA = M.TURMA) AND'
      '      (F.CURSO = M.CURSO) AND'
      '      (F.CODIGOALUNO = M.CODIGOALUNO)'
      '    JOIN SITUACAO I ON'
      '      (M.SITUACAO = I.CD_SITUACAO)'
      '    LEFT JOIN TURMAS TOP ON ('
      '      TOP.ANOSEMESTRE = F.ANOSEMESTRE AND'
      #9#9#9'TOP.CODIGO = F.TURMA AND'
      #9#9#9'TOP.SERIE = -100'
      '    )'
      'WHERE'
      #9'F.ANOSEMESTRE = :NR_ANOSEMESTRE AND'
      #9'F.TURMAMATRICULA = :CD_TURMA AND'
      #9'(F.TURMA != :CD_TURMA_DESTINO) AND'
      '  F.CURSO = :CD_CURSO AND'
      #9'F.TURMA != F.TURMAMATRICULA AND'
      #9'S.CD_SITUACAO_PAI IN (1, 10) AND'
      '  I.CD_SITUACAO_PAI IN (1, 10)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA_DESTINO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end>
    Left = 128
    Top = 40
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA_DESTINO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end>
    object qryFichaIndividualNR_ANOSEMESTRE: TSmallintField
      FieldName = 'NR_ANOSEMESTRE'
      Required = True
    end
