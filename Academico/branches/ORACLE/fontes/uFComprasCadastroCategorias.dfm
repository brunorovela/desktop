  object qyTiposTitulo: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      '('
      '  SELECT'
      '    CAST( 0 AS SIGNED ) AS cd_tipo_titulo,'
      '    '#39#39' AS ds_tipo_titulo'
      '  FROM'
      '    DUAL'
      ')'
      'UNION'
      '('
      '  SELECT'
      '    cd_tipo_titulo, ds_tipo_titulo'
      '  FROM'
      '    fin_config_tipos_titulo'
      '  WHERE'
      '    cd_coligada_matriz = :cd_coligada_matriz'
      '    AND sn_ativo = 1'
      ')'
      'ORDER BY'
      '  CASE WHEN cd_tipo_titulo = 0 THEN 1 ELSE ds_tipo_titulo END')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada_matriz'
        ParamType = ptUnknown
      end>
    Left = 408
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada_matriz'
        ParamType = ptUnknown
      end>
    object qyTiposTitulocd_tipo_titulo: TLargeintField
      FieldName = 'cd_tipo_titulo'
    end
    object qyTiposTitulods_tipo_titulo: TStringField
      FieldName = 'ds_tipo_titulo'
      Size = 255
    end
  end
  object qyTiposTituloLista: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      '('
      #9' SELECT'
      '   '#9' CAST( 0 AS SIGNED ) AS cd_tipo_titulo,'
      '     '#39#39' AS ds_tipo_titulo,'
      '     CAST( 0 AS SIGNED ) AS cd_coligada'
      #9' FROM dual'
      ')'
      'UNION'
      '('
      #9' SELECT'
      #9' '#9' cd_tipo_titulo, ds_tipo_titulo, cd_coligada'
      #9' FROM'
      #9' '#9' fin_tipos_titulo'#9' '#9' '
      #9' ORDER BY'
      #9'    ds_tipo_titulo'
      ')')
    Params = <>
    Left = 440
    Top = 360
    object LargeintField1: TLargeintField
      FieldName = 'cd_tipo_titulo'
    end
    object StringField1: TStringField
      FieldName = 'ds_tipo_titulo'
      Size = 255
    end
    object LargeintField2: TLargeintField
      FieldName = 'cd_coligada'
    end
  end
