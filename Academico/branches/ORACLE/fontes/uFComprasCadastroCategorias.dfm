  object qyCategorias: TUMZQuery
    Connection = DM.db
    UpdateObject = updCategorias
    BeforeInsert = qyCategoriasBeforeInsert
    AfterInsert = qyCategoriasAfterInsert
    BeforeEdit = qyCategoriasBeforeEdit
    BeforePost = qyCategoriasBeforePost
    SQL.Strings = (
      'SELECT'
      '  cd_categoria,'
      '  cd_tipo_titulo,'
      '  ds_categoria,'
      '  SN_CANTINA'
      'FROM'
      '  comp_categorias'
      'ORDER BY'
      '  ds_categoria')
    Params = <>
    Left = 376
    Top = 360
