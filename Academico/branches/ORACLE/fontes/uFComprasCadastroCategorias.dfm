  object updCategorias: TZUpdateSQL
    DeleteSQL.Strings = (
      'DELETE FROM'
      '   comp_categorias'
      'WHERE'
      '   cd_categoria = :cd_categoria')
    InsertSQL.Strings = (
      
        'INSERT INTO comp_categorias (CD_TIPO_TITULO, DS_CATEGORIA, SN_CA' +
        'NTINA)'
      'VALUES (:CD_TIPO_TITULO, :DS_CATEGORIA, :SN_CANTINA)')
    ModifySQL.Strings = (
      ' UPDATE'
      '    comp_categorias'
      ' SET'
      '    CD_TIPO_TITULO = :CD_TIPO_TITULO,'
      '    DS_CATEGORIA = :DS_CATEGORIA,'
      '    SN_CANTINA = :SN_CANTINA'
      ' WHERE '
      '    CD_CATEGORIA = :CD_CATEGORIA')
    UseSequenceFieldForRefreshSQL = False
    Left = 376
    Top = 424
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TIPO_TITULO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DS_CATEGORIA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SN_CANTINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_CATEGORIA'
        ParamType = ptUnknown
      end>
  end
