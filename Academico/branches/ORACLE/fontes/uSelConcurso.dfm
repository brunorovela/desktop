  object qyConcursos: TUMZReadOnlyQuery
    Connection = DM.db
    OnCalcFields = qyConcursosCalcFields
    SQL.Strings = (
      'SELECT'
      #9'cc.ds_concurso,'
      #9'ca.ds_area,'
      #9'ci.dt_cadastro DT_INSCRICAO,'
      #9'cs.ds_situacao DS_SITUACAO,'
      #9'ca.cd_curso CD_CURSO,'
      #9'cc.nr_anosemestre NR_ANOSEMESTRE,'
      #9'cuc.cd_grade CD_GRADE,'
      '  cuc.cd_coligada CD_COLIGADA,'
      '  co.nm_coligada NM_COLIGADA'
      'FROM'
      #9'con_concursos cc'
      ''
      
        #9'INNER JOIN con_inscricoes ci ON (ci.cd_concurso = cc.cd_concurs' +
        'o )'
      ''
      
        #9'INNER JOIN con_inscricoes_areas cia ON ( cia.cd_inscricao = ci.' +
        'cd_inscricao )'
      ''
      #9'INNER JOIN con_areas ca ON ( ca.cd_area = cia.cd_area )'
      ''
      
        #9'INNER JOIN con_situacoes cs ON (cs.cd_situacao = ci.cd_situacao' +
        ')'
      #9
      
        #9'INNER JOIN turmas as t ON (t.codigo = cc.turma AND t.anosemestr' +
        'e = cc.nr_anosemestre)'
      ''
      
        #9'INNER JOIN cursos_coligadas cuc ON ( cuc.cd_curso = ca.cd_curso' +
        ' AND cuc.CD_COLIGADA = t.cd_coligada)'
      ''
      
        #9'INNER JOIN coligadas co ON (  cuc.cd_coligada = co.cd_coligada ' +
        ')'
      ''
      'WHERE'
      #9'ci.cd_pessoa = :cd_pessoa AND'
      #9'cuc.sn_ativo = 1'#9)
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 48
    Top = 80
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qyConcursosDT_INSCRICAO: TDateTimeField
      FieldName = 'DT_INSCRICAO'
    end
    object qyConcursosDS_SITUACAO: TStringField
      FieldName = 'DS_SITUACAO'
    end
    object qyConcursosCD_CURSO: TStringField
      FieldName = 'CD_CURSO'
    end
    object qyConcursosPROCESSO: TStringField
      FieldKind = fkCalculated
      FieldName = 'PROCESSO'
      Size = 255
      Calculated = True
    end
    object qyConcursosds_concurso: TStringField
      FieldName = 'ds_concurso'
      Size = 255
    end
    object qyConcursosds_area: TStringField
      FieldName = 'ds_area'
      Size = 255
    end
    object qyConcursosNR_ANOSEMESTRE: TIntegerField
      FieldName = 'NR_ANOSEMESTRE'
    end
    object qyConcursosCD_GRADE: TIntegerField
      FieldName = 'CD_GRADE'
    end
    object qyConcursosCD_COLIGADA: TSmallintField
      FieldName = 'CD_COLIGADA'
      Required = True
    end
    object qyConcursosNM_COLIGADA: TStringField
      FieldName = 'NM_COLIGADA'
      Size = 50
    end
  end
