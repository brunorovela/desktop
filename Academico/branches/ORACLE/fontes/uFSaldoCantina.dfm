  object qrySaldo: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT  TRUNCATE(GET_SALDO_CANTINA(:pessoa, null, null),2) as sa' +
        'ldo;')
    Params = <
      item
        DataType = ftUnknown
        Name = 'pessoa'
        ParamType = ptUnknown
      end>
    Left = 352
    Top = 48
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'pessoa'
        ParamType = ptUnknown
      end>
    object qrySaldosaldo: TFloatField
      FieldName = 'saldo'
      DisplayFormat = '###,###,##0.00'
    end
  end
  object dsSaldo: TDataSource
    DataSet = qrySaldo
    Left = 312
    Top = 48
  end
  object qryCreditos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'date(dt_acao) as dt_acao,'
      #9'vl_valor'
      'FROM'
      #9'ctn_movimentacao_credito cmc'
      'LEFT JOIN ctn_movimentacao_financeiro cmf on ('
      #9'cmf.cd_movimentacao = cmc.cd_movimentacao'
      ')'
      'WHERE'
      #9'cd_pessoa = :cd_pessoa AND'
      #9'sn_estorno = 0 AND'
      #9'tp_entrada_saida = 1'
      'ORDER BY '
      #9'dt_acao desc'
      'LIMIT 1')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 352
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qryCreditosvl_valor: TFloatField
      FieldName = 'vl_valor'
      DisplayFormat = '###,###,##0.00'
    end
    object qryCreditosdt_acao: TDateField
      FieldName = 'dt_acao'
    end
  end
  object dsCreditos: TDataSource
    DataSet = qryCreditos
    Left = 312
    Top = 16
  end
