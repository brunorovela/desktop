  object updContratos: TZUpdateSQL
    DeleteSQL.Strings = (
      
        'DELETE FROM CONV_CONTRATOS_TURMAS WHERE CD_CONTRATO = :CD_CONTRA' +
        'TO;'
      'DELETE FROM CONV_CONTRATOS WHERE CD_CONTRATO = :CD_CONTRATO;')
    InsertSQL.Strings = (
      'INSERT INTO CONV_CONTRATOS ('
      '        CD_TIPO,'
      '        CD_PESSOA,'
      '        NR_DIA_VENCIMENTO,'
      '        CD_COLIGADA,'
      '        SN_ATIVO,'
      '        VL_CONTRATO,'
      '        DS_CONTRATO,'
      '        CD_TIPO_TITULO'
      ') VALUES ('
      '        :CD_TIPO,'
      '        :CD_PESSOA,'
      '        :NR_DIA_VENCIMENTO,'
      '        :CD_COLIGADA,'
      '        :SN_ATIVO,'
      '        :VL_CONTRATO,'
      '        :DS_CONTRATO,'
      '        :CD_TIPO_TITULO'
      ')')
    ModifySQL.Strings = (
      'UPDATE'
      '        CONV_CONTRATOS'
      'SET'
      '        CD_TIPO = :CD_TIPO,'
      '        CD_PESSOA = :CD_PESSOA,'
      '        NR_DIA_VENCIMENTO = :NR_DIA_VENCIMENTO,'
      '        CD_COLIGADA = :CD_COLIGADA,'
      '        SN_ATIVO = :SN_ATIVO,'
      '        VL_CONTRATO = :VL_CONTRATO,'
      '        DS_CONTRATO = :DS_CONTRATO,'
      '        CD_TIPO_TITULO = :CD_TIPO_TITULO'
      'WHERE'
      '        CD_CONTRATO = :CD_CONTRATO')
    RefreshSQL.Strings = (
      'SELECT'
      '  C.CD_CONTRATO,'
      '  C.CD_TIPO,'
      '  C.CD_PESSOA,'
      '  C.NR_DIA_VENCIMENTO,'
      '  C.CD_COLIGADA,'
      '  C.SN_ATIVO,'
      '  C.VL_CONTRATO,'
      '  C.DS_CONTRATO,'
      '  C.CD_TIPO_TITULO,'
      '  P.NM_PESSOA,'
      '  O.NM_COLIGADA,'
      '  EXISTS ('
      '    SELECT'
      '      A.CD_CONTRATO'
      '    FROM'
      '      CONV_ANEXOS A'
      '    WHERE'
      '      C.CD_CONTRATO = A.CD_CONTRATO'
      '  ) SN_ANEXO'
      'FROM'
      '  CONV_CONTRATOS C'
      ''
      '    JOIN PESSOAS P ON'
      '      (C.CD_PESSOA = P.CD_PESSOA)'
      ''
      '    JOIN COLIGADAS O ON'
      '      (C.CD_COLIGADA = O.CD_COLIGADA)'
      '')
    UseSequenceFieldForRefreshSQL = False
    MultiStatements = False
    Left = 424
    Top = 184
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TIPO'
        ParamType = ptUnknown
