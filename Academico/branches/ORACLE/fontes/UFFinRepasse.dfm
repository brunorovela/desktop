  object updTurmas: TZUpdateSQL
    DeleteSQL.Strings = (
      'DELETE FROM CONV_CONTRATOS_TURMAS_PESSOAS'
      'WHERE'
      '        CD_CONTRATO = :CD_CONTRATO AND'
      '        CD_TURMA = :CD_TURMA AND'
      '        NR_ANOSEMESTRE = :NR_ANOSEMESTRE;'
      ''
      'DELETE FROM CONV_CONTRATOS_TURMAS'
      'WHERE'
      '        CD_CONTRATO = :CD_CONTRATO AND'
      '        CD_TURMA = :CD_TURMA AND'
      '        NR_ANOSEMESTRE = :NR_ANOSEMESTRE;')
    InsertSQL.Strings = (
      'INSERT INTO CONV_CONTRATOS_TURMAS ('
      '        CD_CONTRATO,'
      '        CD_TURMA,'
      '        NR_ANOSEMESTRE,'
      '        NR_PARCELAS,'
      '        VL_REPASSE,'
      '        SN_ATIVO,'
      '        DT_REFERENCIA'
      ') VALUES ('
      '        :CD_CONTRATO,'
      '        :CD_TURMA,'
      '        :NR_ANOSEMESTRE,'
      '        :NR_PARCELAS,'
      '        :VL_REPASSE,'
      '        :SN_ATIVO,'
      '        :DT_REFERENCIA'
      ')')
    ModifySQL.Strings = (
      'UPDATE'
      '        CONV_CONTRATOS_TURMAS'
      'SET'
      '        CD_CONTRATO = :CD_CONTRATO,'
      '        CD_TURMA = :CD_TURMA,'
      '        NR_ANOSEMESTRE = :NR_ANOSEMESTRE,'
      '        NR_PARCELAS = :NR_PARCELAS,'
      '        VL_REPASSE = :VL_REPASSE,'
      '        SN_ATIVO = :SN_ATIVO,'
      '        DT_REFERENCIA = :DT_REFERENCIA'
      'WHERE'
