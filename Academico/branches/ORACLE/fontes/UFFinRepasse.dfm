  object qryContratos: TUMZQuery
    Connection = DM.db
    SortedFields = 'DS_CONTRATO'
    AfterRefresh = qryContratosAfterRefresh
    OnCalcFields = qryContratosCalcFields
    UpdateObject = updContratos
    SQL.Strings = (
      'SELECT'
      '  C.CD_CONTRATO,'
      '  C.CD_TIPO,'
      '  C.CD_PESSOA,'
      '  C.NR_DIA_VENCIMENTO,'
      '  C.CD_COLIGADA,'
      '  C.SN_ATIVO,'
      '  C.VL_CONTRATO,'
      '  C.DS_CONTRATO,'
      '  C.CD_TIPO_TITULO,'
      '  P.NM_PESSOA,'
      '  O.NM_COLIGADA,'
      '  EXISTS ('
      '    SELECT'
      '      A.CD_CONTRATO'
      '    FROM'
      '      CONV_ANEXOS A'
      '    WHERE'
      '      C.CD_CONTRATO = A.CD_CONTRATO'
      '  ) SN_ANEXO'
      'FROM'
      '  CONV_CONTRATOS C'
      ''
      '    JOIN PESSOAS P ON'
      '      (C.CD_PESSOA = P.CD_PESSOA)'
      ''
      '    JOIN COLIGADAS O ON'
      '      (C.CD_COLIGADA = O.CD_COLIGADA)')
    Params = <>
    IndexFieldNames = 'DS_CONTRATO Asc'
    Left = 424
    Top = 224
    object qryContratosCD_CONTRATO: TLargeintField
      FieldName = 'CD_CONTRATO'
      Required = True
    end
    object qryContratosCD_TIPO: TSmallintField
