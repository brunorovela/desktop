  object qyCalendario: TUMZQuery
    Connection = DM.db
    AfterOpen = qyCalendarioAfterOpen
    AfterClose = qyCalendarioAfterClose
    OnCalcFields = qyCalendarioCalcFields
    BeforeInsert = qyCalendarioBeforeInsert
    AfterInsert = qyCalendarioAfterInsert
    BeforeEdit = qyCalendarioBeforeEdit
    AfterEdit = qyCalendarioAfterEdit
    AfterPost = qyCalendarioAfterPost
    AfterCancel = qyCalendarioAfterCancel
    SQL.Strings = (
      'SELECT'
      '  c.nr_dia,'
      '  c.nr_mes,'
      '  c.nr_ano,'
      '  c.sn_biblioteca,'
      '  c.sn_financeiro,'
      '  c.sn_secretaria,'
      '  c.cd_coligada,'
      '  c.cd_calendario,'
      '  c.dt_alteracao,'
      '  c.cd_categoria,'
      '  u.ds_descricao,'
      '  u.hr_inicio,'
      '  u.hr_fim'
      'FROM'
      '  calendario c'
      
        'LEFT JOIN unim_calendario_eventos u ON (u.cd_calendario = c.cd_c' +
        'alendario)'
      'WHERE'
      '  c.cd_coligada = :cd_coligada'
      'ORDER BY'
      '  c.nr_dia')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
    Left = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
