  object qyUnidadeCertificadora: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  ie.*,'
      '  t.codigo'
      'FROM'
      '  instituicoes_ensino AS ie'
      
        'INNER JOIN turmas AS t ON(ie.cd_instituicao = t.cd_unidade_certi' +
        'ficadora)'
      'GROUP BY'
      #9'ie.cd_instituicao'
      'ORDER BY'
      '  ie.nm_instituicao')
    Params = <>
    Left = 304
    Top = 16
