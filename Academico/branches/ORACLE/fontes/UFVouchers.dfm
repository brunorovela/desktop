  object qryTurmas: TUMZQuery
    Connection = DM.db
    UpdateObject = updTurmas
    SQL.Strings = (
      'SELECT'
      '  V.`CD_LOTE`,'
      '  V.`NR_ANOSEMESTRE`,'
      '  V.`CD_TURMA`,'
      '  T.`DESCRICAO` `DS_TURMA`,'
      '  COALESCE(C.`DS_APELIDO`, C.`DS_CURSO`) `NM_CURSO`'
      'FROM'
      '  `UNIM_VOUCHER_LOTE_TURMA` V'
      ''
      '    JOIN `TURMAS` T ON'
      '      (V.`NR_ANOSEMESTRE` = T.`ANOSEMESTRE`) AND'
      '      (V.`CD_TURMA` = T.`CODIGO`)'
      ''
      '      JOIN `CURSOS_MESTRE` C ON'
      '        (T.`CURSO` = C.`CD_CURSO`)'
      'WHERE'
      '  V.`CD_LOTE` = :CD_LOTE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_LOTE'
        ParamType = ptUnknown
      end>
    Left = 104
    Top = 224
