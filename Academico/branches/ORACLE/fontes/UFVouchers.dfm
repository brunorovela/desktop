  object qryLotes: TUMZQuery
    Connection = DM.db
    OnCalcFields = qryLotesCalcFields
    UpdateObject = updLote
    SQL.Strings = (
      'SELECT'
      '  L.`CD_LOTE`,'
      '  L.`CD_FORNECEDOR`,'
      '  L.`DS_LOTE`,'
      '  L.`DT_VENCIMENTO`,'
      '  L.`DS_PREFIXO`,'
      '  L.`DS_SUFIXO`,'
      '  L.`VL_DESCONTO`,'
      '  L.`NR_QUANTIDADE`,'
      '  P.`NM_PESSOA`,'
      '   L.`VL_DESCONTO_VISTA`,'
      '  L.TP_DESCONTO'
      'FROM'
      '  `UNIM_VOUCHER_LOTE` L'
      ''
      '    JOIN `PESSOAS` P ON'
      '      (L.`CD_FORNECEDOR` = P.`CD_PESSOA`)')
    Params = <>
    Left = 40
    Top = 224
