  object qryDisciplinaPaiU: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'select * from disciplinas group by cd_disciplina_pai order by cd' +
        '_disciplina_pai')
    Params = <>
    SQLList.Strings = (
      
        'oracle=    SELECT'#13#10#9'*'#13#10'FROM'#13#10'('#13#10#9'select '#13#10#9#9'cd_disciplina_pai,'#13#10 +
        #9#9'FIRST_OCCURRENCE( codigo ) codigo,'#13#10#9#9'FIRST_OCCURRENCE( ordem ' +
        ') ordem,'#13#10#9#9'FIRST_OCCURRENCE( curso ) curso,'#13#10#9#9'FIRST_OCCURRENCE' +
        '( sigla ) sigla,'#13#10#9#9'FIRST_OCCURRENCE( descricao ) descricao,'#13#10#9#9 +
        'FIRST_OCCURRENCE( ementa_backup ) ementa_backup,'#13#10#9#9'FIRST_OCCURR' +
        'ENCE( id_disciplina ) id_disciplina,'#13#10#9#9'FIRST_OCCURRENCE( qtd_fr' +
        'ases_fixas ) qtd_frases_fixas,'#13#10#9#9'FIRST_OCCURRENCE( cd_disc_mec ' +
        ') cd_disc_mec,'#13#10#9#9'FIRST_OCCURRENCE( sn_bloqueado ) sn_bloqueado,' +
        #13#10#9#9'FIRST_OCCURRENCE( sn_ementa_padrao ) sn_ementa_padrao'#13#10#9'from' +
        ' '#13#10#9#9'disciplinas '#13#10#13#10#9'group by '#13#10#9#9'cd_disciplina_pai '#13#10') sub'#13#10'or' +
        'der by '#13#10#9'cd_disciplina_pai,'#13#10#9'codigo,'#9#13#10#9'ordem,'#13#10#9'curso,'#13#10#9'sigl' +
        'a,'#13#10#9'descricao,'#13#10#9'ementa_backup,'#13#10#9'id_disciplina,'#13#10#9'qtd_frases_f' +
        'ixas,'#13#10#9'cd_disc_mec,'#13#10#9'sn_bloqueado,'#13#10#9'sn_ementa_padrao'
      
        'mysql-5=  SELECT'#13#10#9'*'#13#10'FROM'#13#10'('#13#10#9'select '#13#10#9#9'cd_disciplina_pai,'#13#10#9 +
        #9' codigo,'#13#10#9#9' ordem,'#13#10#9#9'curso,'#13#10#9#9' sigla,'#13#10#9' descricao,'#13#10#9#9' emen' +
        'ta_backup,'#13#10#9#9' id_disciplina,'#13#10#9#9' qtd_frases_fixas,'#13#10#9#9'cd_disc_m' +
        'ec,'#13#10#9#9'sn_bloqueado,'#13#10#9#9' sn_ementa_padrao'#13#10#9'from '#13#10#9#9'disciplinas' +
        ' '#13#10#13#10#9'group by '#13#10#9#9'cd_disciplina_pai '#13#10') sub'#13#10'order by '#13#10#9'cd_dis' +
        'ciplina_pai,'#13#10#9'codigo,'#9#13#10#9'ordem,'#13#10#9'curso,'#13#10#9'sigla,'#13#10#9'descricao,'#13 +
        #10#9'ementa_backup,'#13#10#9'id_disciplina,'#13#10#9'qtd_frases_fixas,'#13#10#9'cd_disc_' +
        'mec,'#13#10#9'sn_bloqueado,'#13#10#9'sn_ementa_padrao')
    Left = 184
    Top = 72
