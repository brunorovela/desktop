      FieldName = 'cd_turma'
      Size = 50
    end
  end
  object qryDispDisciplinasAgrupadasCompletarU: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'select distinct '
      '  disp_das.cd_agrupamento,'
      ' disp_das.cd_disciplina,'
      ' disp_das.cd_turma,'
      ' uni_d.descricao'
      ' from '
      '  '
      '  disp_disciplinas_agrupadas disp_das'
      ''
      #9'INNER JOIN disp_disciplina_agrupamento  disp_da ON ('
      #9#9'disp_da.cd_agrupamento = disp_das.cd_agrupamento'
      #9')'
      ''
      #9'INNER JOIN  disciplinas  uni_d ON ('
      #9#9'uni_d.codigo = disp_das.cd_disciplina  and'
      #9#9'disp_da.cd_disciplina_pai = uni_d.cd_disciplina_pai '
      ')'
      ''
      #9'INNER JOIN turmas  uni_t ON ('
      #9#9' uni_t.curso '#9#9#9' = uni_d.curso'#9'and '
      #9#9' uni_t.anosemestre = disp_da.nr_anosemestre  '#9'and'
      '                               uni_t.codigo = disp_das.cd_turma '
      #9
      #9')'
      ''
      'INNER JOIN grades g ON ( '
      #9'g.CD_GRADE = uni_t.cd_grade AND '
      #9'g.CD_CURSO = uni_t.curso AND'
      #9'g.SN_ATIVO = '#39'S'#39
      ')'
      'INNER JOIN grades_disciplinas gd ON ('
      #9'gd.CD_GRADE = g.CD_GRADE AND'
      #9'gd.CD_CURSO = g.CD_CURSO AND'
      #9'uni_t.serie = gd.NR_SERIE'
      ')'
      ''
      ''
      'where  disp_das.cd_agrupamento = :cd_agrupamento')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_agrupamento'
        ParamType = ptUnknown
      end>
    Left = 88
    Top = 216
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_agrupamento'
        ParamType = ptUnknown
      end>
    object qryDispDisciplinasAgrupadasCompletarUcd_agrupamento: TIntegerField
      FieldName = 'cd_agrupamento'
    end
    object qryDispDisciplinasAgrupadasCompletarUcd_disciplina: TIntegerField
      FieldName = 'cd_disciplina'
    end
    object qryDispDisciplinasAgrupadasCompletarUcd_turma: TStringField
      FieldName = 'cd_turma'
      Size = 50
    end
    object qryDispDisciplinasAgrupadasCompletarUdescricao: TStringField
      FieldName = 'descricao'
      Size = 150
    end
  end
