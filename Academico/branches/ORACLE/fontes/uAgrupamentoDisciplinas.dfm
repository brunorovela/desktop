  object qryDispDisciplinasAgrupadasU: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'select '
      #9'cd_agrupamento,'
      #9'cd_disciplina,'
      #9'cd_turma'#9
      ' from '
      '  disp_disciplinas_agrupadas'
      'where cd_agrupamento = :cd_agrupamento')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_agrupamento'
        ParamType = ptUnknown
      end>
    Left = 24
    Top = 216
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_agrupamento'
        ParamType = ptUnknown
      end>
    object qryDispDisciplinasAgrupadasUcd_agrupamento: TIntegerField
      FieldName = 'cd_agrupamento'
    end
    object qryDispDisciplinasAgrupadasUcd_disciplina: TIntegerField
      FieldName = 'cd_disciplina'
    end
