  object updConveniosPessoas: TZUpdateSQL
    DeleteSQL.Strings = (
      'DELETE FROM fin_nfe_convenios'
      'WHERE'
      '  fin_nfe_convenios.cd_convenio = :OLD_cd_convenio')
    InsertSQL.Strings = (
      'INSERT INTO fin_nfe_convenios'
      
        '  (cd_convenio, cd_pessoa, dt_inicial, dt_final, me_pdf, sn_ativ' +
        'o)'
      'VALUES'
      
        '  (:cd_convenio, :cd_pessoa, :dt_inicial, :dt_final, :me_pdf, :s' +
        'n_ativo)')
    ModifySQL.Strings = (
      'UPDATE fin_nfe_convenios SET'
      '  cd_convenio = :cd_convenio,'
      '  cd_pessoa = :cd_pessoa,'
      '  dt_inicial = :dt_inicial,'
      '  dt_final = :dt_final,'
      '  me_pdf = :me_pdf,'
      '  sn_ativo = :sn_ativo'
      'WHERE'
      '  fin_nfe_convenios.cd_convenio = :OLD_cd_convenio')
    UseSequenceFieldForRefreshSQL = False
    Left = 152
    Top = 176
    ParamData = <
      item
        DataType = ftUnknown
