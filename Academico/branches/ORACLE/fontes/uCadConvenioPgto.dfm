  object qyCriterios: TUMZQuery
    Connection = DM.db
    UpdateObject = updCriterios
    SQL.Strings = (
      'SELECT'
      '   fncc.*,'
      '   dep.descricao,'
      '   fnct.ds_tipo'
      'FROM'
      '   fin_nfe_convenios_criterios fncc'
      '   INNER JOIN departamentos dep ON (dep.codigo = fncc.cd_depto)'
      
        '   INNER JOIN fin_nfe_criterios_tipos fnct ON (fnct.cd_nfe_crite' +
        'rio_tipo = fncc.cd_nfe_criterio_tipo)'
      'WHERE'
      '   fncc.cd_convenio = :cd_convenio'
      'ORDER BY'
      '   fncc.ds_cargo')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_convenio'
        ParamType = ptUnknown
      end>
    DataSource = dsNfeConveniosEmpresas
    Left = 568
    Top = 160
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_convenio'
        ParamType = ptUnknown
      end>
    object qyCriterioscd_convenio_criterio: TIntegerField
      FieldName = 'cd_convenio_criterio'
      Required = True
    end
    object qyCriterioscd_nfe_criterio_tipo: TIntegerField
      FieldName = 'cd_nfe_criterio_tipo'
      Required = True
    end
    object qyCriteriosds_cargo: TStringField
      FieldName = 'ds_cargo'
      Size = 255
    end
    object qyCriterioscd_depto: TIntegerField
      FieldName = 'cd_depto'
    end
    object qyCriteriosvl_valor: TFloatField
      FieldName = 'vl_valor'
      DisplayFormat = '###,###,##0.00'
    end
    object qyCriteriosvl_valor_limite: TFloatField
      FieldName = 'vl_valor_limite'
      DisplayFormat = '###,###,##0.00'
    end
    object qyCriteriosdescricao: TStringField
      FieldName = 'descricao'
      Size = 50
    end
    object qyCriteriosds_tipo: TStringField
      FieldName = 'ds_tipo'
      Size = 100
    end
    object qyCriterioscd_convenio: TLargeintField
      FieldName = 'cd_convenio'
      Required = True
    end
  end
  object qyNfeConveniosEmpresas: TUMZQuery
    Connection = DM.db
    UpdateObject = updConveniosPessoas
    SQL.Strings = (
      'SELECT'
      '  nf_con.cd_convenio,'
      '  nf_con.cd_pessoa, '
      '  nf_con.dt_inicial, '
      '  nf_con.dt_final, '
      '  nf_con.sn_ativo,   '
      '  p.nm_pessoa,'
      '  IF('
      '    nf_con.sn_ativo = 1,'
      '    "X",'
      '    "N'#227'o"'
      '  ) AS ds_ativo, '
      '  IF('
      '      ISNULL(nf_con.me_pdf), '
      '      "N'#227'o", '
      '      "X"'
      '  ) AS sn_contrato,'
      '  IFNULL(('
      #9#9'SELECT'
      ' '#9#9'GROUP_CONCAT( DISTINCT(mc.cd_curso) SEPARATOR '#39', '#39' ) '
      #9#9'FROM'
      #9'  '#9'fin_nfe_pessoas_conveniadas fnpc'
      #9#9'INNER JOIN fin_nfe_convenios_criterios fncc ON ('
      #9#9'  fncc.cd_convenio_criterio = fnpc.cd_convenio_criterio'
      #9#9')'
      #9#9'INNER JOIN matriculas_curso mc ON ('
      '      mc.cd_pessoa = fnpc.cd_pessoa'
      #9#9')'
      #9#9'WHERE'
      #9#9#9'fncc.cd_convenio = nf_con.cd_convenio'
      #9'),"") AS ds_cursos'
      'FROM'
      '    fin_nfe_convenios as nf_con'
      'INNER JOIN pessoas p ON ('
      '  nf_con.cd_pessoa = p.cd_pessoa'
      ')')
    Params = <>
    Left = 112
    Top = 152
    object qyNfeConveniosEmpresascd_convenio_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
      Required = True
    end
    object qyNfeConveniosEmpresasnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyNfeConveniosEmpresasdt_inicial: TDateTimeField
      FieldName = 'dt_inicial'
      EditMask = '!99/99/9999;1; '
    end
    object qyNfeConveniosEmpresasdt_final: TDateTimeField
      FieldName = 'dt_final'
      EditMask = '!99/99/9999;1; '
    end
    object qyNfeConveniosEmpresasds_ativo: TStringField
      FieldName = 'ds_ativo'
      ReadOnly = True
      Size = 100
    end
    object qyNfeConveniosEmpresassn_ativo: TSmallintField
      FieldName = 'sn_ativo'
    end
    object qyNfeConveniosEmpresascd_convenio: TLargeintField
      FieldName = 'cd_convenio'
      Required = True
    end
    object qyNfeConveniosEmpresasds_cursos: TMemoField
      FieldName = 'ds_cursos'
      OnGetText = qyNfeConveniosEmpresasds_cursosGetText
      BlobType = ftMemo
      Size = 500
    end
    object qyNfeConveniosEmpresassn_contrato: TStringField
      FieldName = 'sn_contrato'
      Size = 5
    end
  end
  object qyAlunosFuncionarios: TUMZQuery
    Connection = DM.db
    BeforeOpen = qyAlunosFuncionariosBeforeOpen
    UpdateObject = updAlunosFuncionarios
    SQL.Strings = (
      'SELECT'
      '   fnpc.*,'
      '   p.nm_pessoa,'
      '   p.ds_cpf,'
      '   fncc.ds_cargo'
      'FROM'
      '   fin_nfe_pessoas_conveniadas fnpc'
      
        '   INNER JOIN fin_nfe_convenios_criterios fncc ON (fncc.cd_conve' +
        'nio_criterio = fnpc.cd_convenio_criterio)'
      
        '   INNER JOIN fin_nfe_convenios fnc ON(fnc.cd_convenio = fncc.cd' +
        '_convenio)'
      '   INNER JOIN pessoas p ON (p.cd_pessoa = fnpc.cd_pessoa)'
      'WHERE '
      '   fncc.cd_convenio = :cd_convenio'
      'ORDER BY'
      '   p.nm_pessoa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_convenio'
        ParamType = ptUnknown
      end>
    Left = 568
    Top = 480
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_convenio'
        ParamType = ptUnknown
      end>
