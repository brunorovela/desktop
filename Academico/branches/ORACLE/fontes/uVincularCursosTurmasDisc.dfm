  object dsPrazosTurmas: TDataSource
    DataSet = qyPrazosTurmas
    Left = 80
    Top = 80
  end
  object qyPrazosTurmas: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'dpt.nr_anosemestre nr_anosemestre,'
      #9'dpt.cd_curso cd_curso,'
      #9'dpt.cd_turma cd_turma,'
      #9'dpt.cd_disciplina cd_disciplina,'
      '  d.descricao ds_disciplina,'
      #9'dpt.cd_prazo cd_prazo,'
      #9'dp.nm_prazo nm_prazo,'
      #9'dtp.ds_tipo_prazo ds_tipo_prazo,'
      '  dtp.cd_tipo_prazo cd_tipo_prazo'
      'FROM'
      #9'dia_prazos_turmas dpt'
      #9'INNER JOIN dia_prazos dp ON (dpt.cd_prazo = dp.cd_prazo)'
      
        #9'INNER JOIN dia_tipo_prazo dtp ON (dtp.cd_tipo_prazo = dp.cd_tip' +
        'o_prazo)'
      
        '  INNER JOIN disciplinas d ON (d.codigo = dpt.cd_disciplina AND ' +
        'd.curso = dpt.cd_curso)'
      'WHERE'
      #9'dpt.cd_prazo = :cd_prazo')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_prazo'
        ParamType = ptUnknown
      end>
    Left = 48
    Top = 80
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_prazo'
        ParamType = ptUnknown
      end>
    object qyPrazosTurmasNR_ANOSEMESTRE: TIntegerField
      FieldName = 'NR_ANOSEMESTRE'
    end
    object qyPrazosTurmasCD_CURSO: TStringField
      FieldName = 'CD_CURSO'
      Size = 15
    end
    object qyPrazosTurmasCD_TURMA: TStringField
      FieldName = 'CD_TURMA'
      Size = 50
    end
    object qyPrazosTurmasCD_DISCIPLINA: TIntegerField
      FieldName = 'CD_DISCIPLINA'
    end
    object qyPrazosTurmasCD_PRAZO: TIntegerField
      FieldName = 'CD_PRAZO'
    end
    object qyPrazosTurmasNM_PRAZO: TStringField
      FieldName = 'NM_PRAZO'
      Size = 255
    end
    object qyPrazosTurmasDS_TIPO_PRAZO: TStringField
      FieldName = 'DS_TIPO_PRAZO'
      Size = 255
    end
    object qyPrazosTurmasDS_DISCIPLINA: TStringField
      FieldName = 'DS_DISCIPLINA'
      Size = 255
    end
    object qyPrazosTurmasCD_TIPO_PRAZO: TIntegerField
      FieldName = 'CD_TIPO_PRAZO'
    end
  end
  object qyVerificaVincularCurso: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT DISTINCT'
      #9'dpt.NR_ANOSEMESTRE nr_anosemestre,'
      #9'dpt.CD_CURSO cd_curso,'
      #9'dpt.CD_TURMA cd_turma,'
      #9'dpt.CD_DISCIPLINA cd_disciplina,'
      '  dpt.CD_TIPO_PRAZO cd_tipo_prazo,'
      '  dpt.CD_PRAZO cd_prazo'
      'FROM'
      #9'turmas t'
      
        #9'INNER JOIN cursos c ON (c.codigo = t.curso AND c.anosemestre = ' +
        't.anosemestre)'
      #9'INNER JOIN disciplinas d ON (d.curso = c.codigo)'
      #9'INNER JOIN dia_prazos_turmas dpt ON '
      #9#9#9#9#9#9#9#9'(dpt.NR_ANOSEMESTRE = c.anosemestre AND'
      #9#9#9#9#9#9#9#9' dpt.CD_CURSO = d.curso AND '
      #9#9#9#9#9#9#9#9' dpt.CD_TURMA = t.codigo AND '
      #9#9#9#9#9#9#9#9' dpt.CD_DISCIPLINA = d.codigo)'
      'WHERE'
      #9'c.codigo LIKE :cd_curso AND'
      #9'c.anosemestre = :nr_anosemestre AND'
      '  t.cd_coligada = :cd_coligada AND'
      '  dpt.CD_TIPO_PRAZO = :cd_tipo_prazo AND'
      '  CASE WHEN :depto > 0 THEN c.depto = :depto ELSE 1=1 END')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_tipo_prazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'depto'
        ParamType = ptUnknown
      end>
    Left = 168
    Top = 272
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_tipo_prazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'depto'
        ParamType = ptUnknown
      end>
  end
  object qyVincularCurso: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'INSERT INTO dia_prazos_turmas'
      
        '  (nr_anosemestre, cd_curso, cd_turma, cd_disciplina, cd_tipo_pr' +
        'azo, cd_prazo)'
      'SELECT DISTINCT'
      #9't.anosemestre nr_anosemestre,'
      #9'd.curso cd_curso,'
      #9't.codigo cd_turma,'
      #9'd.codigo cd_disciplina,'
      '  :cd_tipo_prazo cd_tipo_prazo,'
      #9':cd_prazo cd_prazo'
      'FROM'
      #9'turmas t'
      #9'INNER JOIN grades_disciplinas gd ON ('
      
        '    gd.CD_GRADE = t.cd_grade AND gd.CD_CURSO = t.curso AND gd.NR' +
        '_SERIE = t.serie'
      '  )'
      
        #9'INNER JOIN disciplinas d ON (d.codigo = gd.CD_DISCIPLINA AND d.' +
        'curso = gd.CD_CURSO)'
      
        '                INNER JOIN cursos_coligadas cc ON (t.cd_coligada' +
        ' = cc.CD_COLIGADA AND t.curso = cc.CD_CURSO)'
      'WHERE'
      #9't.curso LIKE :cd_curso AND'
      #9't.anosemestre = :nr_anosemestre AND'
      '  t.cd_coligada = :cd_coligada')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_tipo_prazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_prazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
    Left = 168
    Top = 304
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_tipo_prazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_prazo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
  end
  object qyVerificaVincularTurma: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '                distinct'
      #9'dpt.NR_ANOSEMESTRE nr_anosemestre,'
      #9'dpt.CD_CURSO cd_curso,'
      #9'dpt.CD_TURMA cd_turma,'
      #9'dpt.CD_DISCIPLINA cd_disciplina,'
      '  dpt.CD_TIPO_PRAZO cd_tipo_prazo,'
      #9'dpt.CD_PRAZO cd_prazo'
      'FROM'
      #9'turmas t'
      
        #9'INNER JOIN cursos c ON (c.codigo = t.curso AND c.anosemestre = ' +
        't.anosemestre)'
      #9'INNER JOIN disciplinas d ON (d.curso = c.codigo)'
      ' '#9'INNER JOIN dia_prazos_turmas dpt ON '
      #9#9#9#9#9#9#9#9'(dpt.NR_ANOSEMESTRE = c.anosemestre AND '
      #9#9#9#9#9#9#9#9' dpt.CD_CURSO = d.curso AND '
      #9#9#9#9#9#9#9#9' dpt.CD_TURMA = t.codigo AND '
      #9#9#9#9#9#9#9#9' dpt.CD_DISCIPLINA = d.codigo)'
      'WHERE'
      #9'c.codigo LIKE :cd_curso AND'
      #9't.codigo LIKE :cd_turma AND'
      #9'c.anosemestre = :nr_anosemestre AND'
      '  dpt.CD_TIPO_PRAZO = :cd_tipo_prazo')
    Params = <
