  object qAlunos: TUMZQuery
    Connection = db
    SQL.Strings = (
      
        'Select DISTINCT CodigoAluno, Aluno, Codigo AS TURMA, Disciplina,' +
        ' AnoSemestre, DataSaida, Situacao'
      'FROM DIARIO_EXTRAIR_TURMAS'
      'WHERE Professor = :PROFESSOR AND ANOSEMESTRE = :AnoSemestre and'
      'CURSO = :CURSO AND CODIGO = :TURMA and disciplina = :disciplina'
      'ORDER BY Aluno, Codigo, Disciplina')
    Left = 332
    Top = 4
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PROFESSOR'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disciplina'
        ParamType = ptUnknown
      end>
  end
  object qFicha: TUMZQuery
    Connection = db
    SQL.Strings = (
      'Select DISTINCT * from DIARIO_EXTRAIR_FICHA '
      'WHERE '
      '    Turma = :TURMA AND DISCIPLINA = :DISCIPLINA '
      '    AND ANOSEMESTRE = :ANOSEMESTRE')
    Left = 540
    Top = 4
    ParamData = <
      item
        DataType = ftString
        Name = 'TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'DISCIPLINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'ANOSEMESTRE'
        ParamType = ptUnknown
      end>
  end
