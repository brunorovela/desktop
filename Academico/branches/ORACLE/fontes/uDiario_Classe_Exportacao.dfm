  object qTurmas: TUMZQuery
    OnCalcFields = qTurmasCalcFields
    Connection = db
    SQL.Strings = (
      
        'Select Curso, DsCurso, Codigo, Disciplina, Descricao, AnoSemestr' +
        'e, QtadeBimestres FROM DIARIO_EXTRAIR_TURMAS'
      
        'WHERE Professor = :PROFESSOR AND ANOSEMESTRE = :AnoSemestre AND ' +
        'CURSO LIKE :CURSO'
      
        'Group By Curso, DsCurso, Codigo, Disciplina, Descricao, AnoSemes' +
        'tre, QtadeBimestres ')
    Left = 476
    Top = 4
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PROFESSOR'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CURSO'
        ParamType = ptUnknown
      end>
    object qTurmasCurso: TStringField
      FieldName = 'Curso'
      Size = 15
    end
    object qTurmasDsCurso: TStringField
      FieldName = 'DsCurso'
      Size = 50
    end
    object qTurmasCodigo: TStringField
      FieldName = 'Codigo'
      Size = 15
    end
    object qTurmasDisciplina: TSmallintField
      FieldName = 'Disciplina'
    end
    object qTurmasDescricao: TStringField
      FieldName = 'Descricao'
      Size = 50
    end
    object qTurmasAnoSemestre: TSmallintField
      FieldName = 'AnoSemestre'
      DisplayFormat = '0000/0'
    end
    object qTurmasBimestre: TIntegerField
      FieldKind = fkCalculated
      FieldName = 'Bimestre'
      Calculated = True
    end
    object qTurmasQtadeBimestres: TSmallintField
      FieldName = 'QtadeBimestres'
    end
  end
