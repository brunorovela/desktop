  object qTurmasImport: TUMZQuery
    Connection = db
    SQL.Strings = (
      'Select MAX(BIMESTRE) AS BIM from diario_Turmas'
      
        'Where Turma = :TURMA AND CURSO = :CURSO AND ANOSEMESTRE = :ANOSE' +
        'MESTRE AND DISCIPLINA = :DISCIPLINA')
    Left = 416
