procedure TfrmRepasseParceiro.btnFiltrarClick(Sender: TObject);
const
   SSQL =
      'SELECT ' +
         'frp.cd_repasse_parceiro,' +
         'alu.cd_pessoa cd_aluno,' +
         'alu.nm_pessoa ds_aluno,' +
         'alu.ds_cidade,' +
         'cur.descricao ds_curso,' +
         'tur.descricao ds_turma,' +
         'vend.cd_pessoa cd_vendedor,' +
         'vend.nm_pessoa ds_vendedor,' +
         'frp.vl_percentual,' +
         'mat.id_matricula,' +
         'cur.codigo cd_curso,' +
         'tur.codigo cd_turma,' +
         'frp.nr_anosemestre' +
      ' FROM ' +
         'fin_repasse_parceiro frp ' +
         'INNER JOIN pessoas alu ON (frp.cd_aluno = alu.cd_pessoa) ' +
         'LEFT JOIN pessoas vend ON (frp.cd_vendedor = vend.cd_pessoa) ' +
         'INNER JOIN cursos cur ON (frp.cd_curso = cur.cd_curso AND cur.ANOSEMESTRE = frp.nr_anosemestre) ' +
         'INNER JOIN turmas tur ON (tur.codigo = frp.cd_turma AND tur.curso = frp.cd_curso AND tur.anosemestre = frp.nr_anosemestre) ' +
         'INNER JOIN matriculas mat ON (mat.id_matricula = frp.id_matricula AND mat.anosemestre = frp.nr_anosemestre AND mat.turma = tur.codigo AND mat.curso = frp.cd_curso) ' +
      ' WHERE ';
var
   SQL : string;
   Parte : TStringList;
   ds_dt_inicio : string;
   ds_dt_fim : string;
begin
   SQL := SSQL;

   try
      SQL := SQL + 'frp.nr_anosemestre = '+ intToStr(nr_anosemestre);

      if cd_curso <> '' then
      begin
         SQL := SQL + ' AND frp.cd_curso = '+Chr(39)+cd_curso+Chr(39);
      end;

      if cd_turma <> '' then
      begin
         SQL := SQL + ' AND frp.cd_turma = '+Chr(39)+cd_turma+Chr(39);
      end;

      if (edPeriodoDe.Checked = true) and (edPeriodoAte.Checked = true) then
      begin
         Parte := TStringList.Create;

         Parte.Delimiter := '/';
         Parte.DelimitedText := DateToStr(edPeriodoDe.DateTime);
         ds_dt_inicio := Parte[2]+'-'+Parte[1]+'-'+Parte[0];
         Parte.Clear;

         Parte.Delimiter := '/';
         Parte.DelimitedText := DateToStr(edPeriodoAte.DateTime);
         ds_dt_fim := Parte[2]+'-'+Parte[1]+'-'+Parte[0];
         Parte.Clear;

         SQL := SQL + ' AND mat.dataemissao BETWEEN '+chr(34)+ds_dt_inicio+ chr(34)+' AND '+chr(34)+ds_dt_fim+ chr(34);

         FreeAndNil(Parte);
      end;

      SQL := SQL + ' ORDER BY frp.cd_repasse_parceiro ';

      qyRepasseParceiro.Close;
      qyRepasseParceiro.SQL.Text := SQL;
      qyRepasseParceiro.Open;
   finally

   end;

end;

procedure TfrmRepasseParceiro.btnFiltroAlunoClick(Sender: TObject);
var
   resultado_filtro : TResultadoFiltroPessoa;
begin
    { Abrir Janela de BUSCA de PESSOAS }
    resultado_filtro := TfrmSelecionarPessoa.Filtrar([], afpEstudante, nr_anosemestre, cd_aluno);

    if not resultado_filtro.filtrado then  Exit;

    if (resultado_filtro.cd_pessoa <> cd_aluno) then
    begin
        cd_aluno := resultado_filtro.cd_pessoa;
        ds_aluno := resultado_filtro.nm_pessoa;

        edAluno.Text := IntToStr(cd_aluno) + ' - ' + ds_aluno;
    end;
end;


