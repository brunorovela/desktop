   btnCancelar.Enabled := value;
   btnSalvar.Enabled := value;

   btnInserir.Enabled := not value;
   btnAlterar.Enabled := not value;
   btnExcluir.Enabled := not value;
end;

procedure TfrmRepasseParceiro.limparCampos;
begin
   setCampos(0,0,DM.GetAnoSemestreAtual(),'','',0,'',0,'',0);
end;

procedure TfrmRepasseParceiro.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
   Action := caFree;
   frmRepasseParceiro := nil;
end;

procedure TfrmRepasseParceiro.FormCreate(Sender: TObject);
const
   SChavePermissao = 'UMFinanceiro.RepasseParceiro';
begin
   FPermissoes := DM.UsuarioLogado.GetPermissoes(DM.UsuarioLogado.Pessoa.Codigo, SChavePermissao);
   FParams := TParams.Create;
end;

procedure TfrmRepasseParceiro.FormKeyUp(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
case Key of
    VK_F2 : btnInserirClick( nil );
    VK_F3 : btnAlterarClick( nil );
    VK_F5 : btnSalvarClick( nil );
    VK_F9 : btnExcluirClick( nil );
    VK_F6 : btnCancelarClick( nil );
    VK_F12 : btnSairClick( nil );
  end;
end;

procedure TfrmRepasseParceiro.FormShow(Sender: TObject);
begin
   edAnosemestre.Visible := DM.UsaAnosemestre;
   edAnosemestre.OnKeyPress := SomenteNumeros;
   edCadAnosemestre.OnKeyPress := SomenteNumeros;
   edCadComissao.OnKeyPress := SomenteNumeros;

   nr_anosemestre  := DM.GetAnoSemestreAtual();

   btnFiltrarClick(Sender);
   inserindo := false;
   editando := false;
   InputsEnable(false);

   qyRepasseParceiro.First;
   setCamposCadastro();

   edPeriodoDe.date := Date;
   edPeriodoAte.date := Date;
   edPeriodoDe.Checked := false;
   edPeriodoAte.Checked := false;
end;

procedure TfrmRepasseParceiro.udAnosemestreClick(Sender: TObject; Button: TUDBtnType);
begin
   if Button = btNext then
   begin
      nr_anosemestre := StrToInt( DM.incrementar_ano_semestre( IntToStr( nr_anosemestre ) ) );
   end else begin
      nr_anosemestre := StrToInt( DM.decrementar_ano_semestre( IntToStr( nr_anosemestre ) ) );
   end;
end;

procedure TfrmRepasseParceiro.UpDown1Click(Sender: TObject; Button: TUDBtnType);
begin
   if Button = btNext then
   begin
      cad_nr_anosemestre := StrToInt( DM.incrementar_ano_semestre( IntToStr( cad_nr_anosemestre ) ) );
   end else begin
      cad_nr_anosemestre := StrToInt( DM.decrementar_ano_semestre( IntToStr( cad_nr_anosemestre ) ) );
   end;
end;

procedure TfrmRepasseParceiro.SomenteNumeros(Sender: TObject; var Key: Char);
begin
   if not ( Key IN ['0'..'9', Chr(8), Chr(9)] ) then Key := #0;
end;
procedure TfrmRepasseParceiro.btnBuscarAlunoClick(Sender: TObject);
var
   resultado_filtro : TResultadoFiltroPessoa;
begin
   { Abrir Janela de BUSCA de PESSOAS }
   resultado_filtro := TfrmSelecionarPessoa.Filtrar([], afpEstudante, cad_nr_anosemestre, cad_cd_aluno);

   if not resultado_filtro.filtrado then  Exit;

   if resultado_filtro.cd_pessoa <> cad_cd_aluno then
   Begin
      cad_id_matricula := resultado_filtro.id_matricula;

      cad_cd_aluno := resultado_filtro.cd_pessoa;
      cad_ds_aluno := resultado_filtro.nm_pessoa;
      edCadAluno.Text := IntToStr(cad_cd_aluno) + ' - ' + cad_ds_aluno;

      cad_nr_anosemestre := resultado_filtro.nr_anosemestre;

      cad_cd_curso :=  resultado_filtro.cd_curso;
      edCadCurso.text := cad_cd_curso;

      cad_cd_turma :=  resultado_filtro.cd_turma;
      edCadTurma.text := cad_cd_turma;
   end;
end;

procedure TfrmRepasseParceiro.btnBuscarCursoClick(Sender: TObject);
var
   resultado_filtro : TResultadoFiltroCurso;
begin
   { Pesquisar Cursos }
   resultado_filtro := TfrmSelecionarCurso.Filtrar([],-1,-1,cad_nr_anosemestre);

   if not resultado_filtro.filtrado then  Exit;

   if (resultado_filtro.cd_curso <> cad_cd_curso) then
   begin
      cad_cd_curso := resultado_filtro.cd_curso;

      edCadCurso.Text := cad_cd_curso;
   end;
end;

procedure TfrmRepasseParceiro.btnBuscarTurmaClick(Sender: TObject);
var
   resultado_filtro : TResultadoFiltroTurma;
begin
   { Pesquisar Turmas }
   resultado_filtro := TfrmSelecionarTurma.Filtrar([], cad_nr_anosemestre, -1, -1, cad_cd_curso);

   if not resultado_filtro.filtrado then  Exit;

   if (resultado_filtro.cd_turma <> cad_cd_turma) then
   begin
      cad_cd_turma := resultado_filtro.cd_turma;

      edCadTurma.Text := cad_cd_turma;
   end;

end;

procedure TfrmRepasseParceiro.btnBuscarVendedorClick(Sender: TObject);
var
   resultado_filtro : TResultadoFiltroPessoa;
begin
   { Abrir Janela de BUSCA de PESSOAS }
   resultado_filtro := TfrmSelecionarPessoa.Filtrar([], afpEstudante, cad_nr_anosemestre, cad_cd_vendedor);

   if not resultado_filtro.filtrado then  Exit;

   if resultado_filtro.cd_pessoa <> cad_cd_vendedor then
