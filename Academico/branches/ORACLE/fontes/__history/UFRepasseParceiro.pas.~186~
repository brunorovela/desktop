procedure TfrmRepasseParceiro.btnSalvarClick(Sender: TObject);
const
   SQL_INSERT = ''
         + ' INSERT INTO fin_repasse_parceiro ('
         + '   id_matricula, '
         + '   nr_anosemestre, '
         + '   cd_curso, '
         + '   cd_turma, '
         + '   cd_aluno, '
         + '   cd_vendedor, '
         + '   vl_percentual, '
         + '   dt_inclusao, '
         + '   dt_alteracao '
         + ' ) '
         + ' VALUES ( '
         + '   :id_matricula, '
         + '   :nr_anosemestre, '
         + '   :cd_curso, '
         + '   :cd_turma, '
         + '   :cd_aluno, '
         + '   :cd_vendedor, '
         + '   :vl_percentual, '
         + '   :dt_inclusao, '
         + '   :dt_alteracao '
         + ' )';

   SQL_UPDATE = '' +
          ' UPDATE fin_repasse_parceiro SET '
         + ' id_matricula = :id_matricula, '
         + ' nr_anosemestre = :nr_anosemestre, '
         + ' cd_curso = :cd_curso, '
         + ' cd_turma = :cd_turma, '
         + ' cd_aluno = :cd_aluno, '
         + ' cd_vendedor = :cd_vendedor, '
         + ' vl_percentual = :vl_percentual, '
         + ' dt_alteracao = :dt_alteracao '
         + ' WHERE cd_repasse_parceiro = :cd_repasse_parceiro ';
Var
   qyAux : TUMZQuery;
begin
   DM.CriarConsulta(qyAux);
   qyAux.Close();

   cad_vl_percentual := strtoint(edCadComissao.Text);

   if cad_id_matricula = 0 then
   begin
      Mensagem('Por favor, informe a matrícula.'); exit;
   end;

   if cad_nr_anosemestre = 0 then
   begin
      Mensagem('Por favor, informe o anosemestre.'); exit;
   end;

   if cad_cd_curso = '' then
   begin
      Mensagem('Por favor, informe o curso.'); exit;
   end;

   if cad_cd_turma = '' then
   begin
      Mensagem('Por favor, informe a turma.'); exit;
   end;

   if cad_cd_aluno = 0 then
   begin
      Mensagem('Por favor, informe o aluno.'); exit;
   end;

   //inserir
   if cad_cd_repasse_parceiro = 0 then
   begin
      qyAux.SQL.Clear();
      qyAux.SQL.Add(SQL_INSERT);
      qyAux.ParamByName('id_matricula').AsInteger := cad_id_matricula;
      qyAux.ParamByName('nr_anosemestre').AsInteger := cad_nr_anosemestre;
      qyAux.ParamByName('cd_curso').AsString := cad_cd_curso;
      qyAux.ParamByName('cd_turma').AsString := cad_cd_turma;
      qyAux.ParamByName('cd_aluno').AsInteger := cad_cd_aluno;
      qyAux.ParamByName('cd_vendedor').AsInteger := cad_cd_vendedor;
      qyAux.ParamByName('vl_percentual').AsInteger := cad_vl_percentual;
      qyAux.ParamByName('dt_inclusao').AsDateTime := DM.DataAtual;
      qyAux.ParamByName('dt_alteracao').AsDateTime := DM.DataAtual;
      qyAux.ExecSQL;
   end;

   //alterar
   if cad_cd_repasse_parceiro <> 0 then
   begin
      qyAux.SQL.Clear();
      qyAux.SQL.Add(SQL_UPDATE);
      qyAux.ParamByName('id_matricula').AsInteger := cad_id_matricula;
      qyAux.ParamByName('nr_anosemestre').AsInteger := cad_nr_anosemestre;
      qyAux.ParamByName('cd_curso').AsString := cad_cd_curso;
      qyAux.ParamByName('cd_turma').AsString := cad_cd_turma;
      qyAux.ParamByName('cd_aluno').AsInteger := cad_cd_aluno;
      qyAux.ParamByName('cd_vendedor').AsInteger := cad_cd_vendedor;
      qyAux.ParamByName('vl_percentual').AsInteger := cad_vl_percentual;
      qyAux.ParamByName('dt_alteracao').AsDateTime := DM.DataAtual;
      qyAux.ParamByName('cd_repasse_parceiro').AsInteger := cad_cd_repasse_parceiro;
      qyAux.ExecSQL;
   end;

   qyAux.Free;
   qyRepasseParceiro.Close;
   qyRepasseParceiro.Open;

   InputsEnable(false);
end;

