procedure TPrincipalForm.CarregarInformacoesPorMatriz;
begin
   PrincipalForm.Caption := Application.Title + ' - ' + DM.sColigadaSelecionada + ' - (' + TGeneral.getVersaoSistema() + ')';

   if DM.lite then
      PrincipalForm.Caption := PrincipalForm.Caption + ' - LITE ';

   // Ligar as coligadas selecionas para utilizar nas combobox
   DM.qryColigadas.Close();
   DM.qryColigadas.SQL.Text :=
     ' SELECT CD_COLIGADA, NM_COLIGADA FROM COLIGADAS ' +
     '  WHERE CD_COLIGADA IN ( ' + DM.GetColigadas() + ' ) '+
     '  ORDER BY NM_COLIGADA ';
   DM.qryColigadas.Open();

   // Ligar as coligadas com a opção de TODAS AS COLIGADAS
   if(DM.db.Protocol = DB_PROTOCOL_MYSQL)then
   begin
      DM.qryColigadasTodas.Close();
      DM.qryColigadasTodas.SQL.Text :=
        ' ( SELECT CAST(0 AS SIGNED)  AS CD_COLIGADA, ' + QuotedStr('Todas as Unidades de Ensino') +' AS NM_COLIGADA )  ' +
        ' UNION ALL '+
        ' ( SELECT CD_COLIGADA, NM_COLIGADA FROM COLIGADAS ' +
        '  WHERE CD_COLIGADA IN ( ' + DM.GetColigadas() + ' ) ' +
        '  ORDER BY NM_COLIGADA )';
      DM.qryColigadasTodas.Open();
   end
   else
   begin
      DM.qryColigadasTodas.Close();
      DM.qryColigadasTodas.SQL.Text :=         ''+
      'SELECT                                   '+
      '  cast(0 as NUMBER(5))   AS CD_COLIGADA, '+
      QuotedStr('Todas as Unidades de Ensino')+' AS NM_COLIGADA '+
      'FROM dual                                                                 ' +
      'UNION ALL                                                                 ' +
      'SELECT                                                                    ' +
      '  CD_COLIGADA,                                                            ' +
      '  NM_COLIGADA                                                             ' +
      'FROM                                                                      ' +
      '  COLIGADAS                                                               ' +
      'WHERE                                                                     ' +
      '  CD_COLIGADA IN ( ' + DM.GetColigadas() + ' )                            ' +
      'ORDER BY                                                                  ' +
      '  NM_COLIGADA                                                             ';
      DM.qryColigadasTodas.Open();
   end;
end;

