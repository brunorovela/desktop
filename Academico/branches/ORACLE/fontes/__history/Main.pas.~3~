procedure TPrincipalForm.tesFinAprovaoPrestaoContaClick(Sender: TObject);
var
   qyGrupoPessoa  : TUMZReadOnlyQuery;
begin
   if not DM.UsuarioLogado.TemPermissao( 1060, npAcesso, True ) then Exit;

   if DM.iCdPessoaLogado <> 0 then
   begin
      //verifica se a pessoa está configurada para mais de um grupo e se mais
      //de um desses grupos estão configurados na prestação de contas.
      DM.CriarConsulta( qyGrupoPessoa );
      qyGrupoPessoa.SQL.Clear;
      qyGrupoPessoa.SQL.Add('SELECT ngp.cd_grupo');
      qyGrupoPessoa.SQL.Add('FROM nu_grupos_pessoas ngp ');
      qyGrupoPessoa.SQL.add('     INNER JOIN fin_grupo_prestacao_contas gpc ON (gpc.cd_grupo = ngp.cd_grupo)');
      qyGrupoPessoa.SQL.Add(Format('WHERE cd_pessoa = :cd_pessoa AND ngp.cd_coligada IN (%s)', [DM.UsuarioLogado.GetColigadasFilhaSelecionada()]));
      qyGrupoPessoa.SQL.Add('ORDER BY gpc.nr_nivel DESC LIMIT 1');
      qyGrupoPessoa.ParamByName('cd_pessoa').AsInteger := DM.GetUsuarioLogado.Pessoa.Codigo;
      qyGrupoPessoa.Open;

      //se houver mais de um grupo configurado seleciona o maior
      if qyGrupoPessoa.RecordCount = 1 then
      begin
         if qyGrupoPessoa.FieldByName('cd_grupo').AsInteger > 0 then
         begin
            
            if not ProcuraForm( TForm(TfrmAprovacaoPrestacaoContas) ) then
               Application.CreateForm(TfrmAprovacaoPrestacaoContas, frmAprovacaoPrestacaoContas)
            else
                frmAprovacaoPrestacaoContas.Show;

            frmAprovacaoPrestacaoContas.setDataAtual( DM.DataAtual() );
            frmAprovacaoPrestacaoContas.setCdPessoaLogada( DM.iCdPessoaLogado );
            frmAprovacaoPrestacaoContas.setCdGrupoPessoaLogada( qyGrupoPessoa.FieldByName('cd_grupo').AsInteger );
            frmAprovacaoPrestacaoContas.carregaInfoGrupoLogado();
            frmAprovacaoPrestacaoContas.carregaColigadas();

         end;
      end else begin
         Mensagem('Seu usuário não está configurado.', 'Aviso');
      end;

      FreeAndNil( qyGrupoPessoa );
   end else begin
      Mensagem('Seu usuário não está configurado.', 'Aviso');
   end;
end;

{ Aluno1Click }

