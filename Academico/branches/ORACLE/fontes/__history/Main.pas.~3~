procedure TPrincipalForm.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
const
   SRemessaExecutando = ''
      + 'Este computador está executando a geração automática de arquivos da '
      + 'remessa. Deseja realmente fechar o sistema que cancelar todas as '
      + 'operações?';
   SCaptionQuestion = 'Confirmação';
var
   I, UserChoice: Integer;
begin
   if FecharForcado then
   begin
      CanClose := True;

      if Relatorio <> nil then
      begin
         Relatorio.CloseEngine;
         Relatorio.Free();
      end;

      Exit;
   end;

   if ( DM.UsuarioLogado = nil ) OR
      ( Mensagem('Deseja realmente sair do sistema ?', '', MB_YESNO + MB_ICONQUESTION, Handle) = IDYES ) then
   begin

      CanClose := True;

      if DM.tiRemessa.Visible then
      begin
         UserChoice := MessageBox(0, SRemessaExecutando, SCaptionQuestion,
            MB_YESNO + MB_DEFBUTTON2 + MB_ICONQUESTION);

         CanClose := UserChoice = ID_YES;
      end;

      FecharFormularios();

      if Relatorio <> nil then
      begin
         Relatorio.CloseEngine;
        // FreeAndNil(Relatorio);
      end;
  end else begin
    CanClose := False;
  end;

end; { FormCloseQuery }


