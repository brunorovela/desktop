procedure TPrincipalForm.FormCreate(Sender: TObject);
var
   RotinaTratarErroBancoP: Pointer;
   RotinaTratarErroBancoM: Pointer;
   LIniFile: TIniFile;
begin
   FStopWatch := TStopWatch.Create(False);
   FCarregarMenus := False;

   PegaDadosODBC();

   FecharForcado := False;

   RotinaTratarErroBancoP := Pointer(self);
   RotinaTratarErroBancoM := self.MethodAddress('tratarErroBanco');

   LIniFile := TIniFile.Create(ExtractFilePath(ParamStr(0)) + 'unimestre.ini');
   try
      FForcarFechamentoRel := LIniFile.ReadBool('Configuracoes', 'ForcarFechamentoRelatorio', False);
   finally
      FreeAndNil(LIniFile);
   end;

   // Application.OnException := TTrataExcecao.Create(TTratamentoExcecaoAcademico.Create).TrataExcecao;
   Application.OnException := TTrataExcecao.Create(TTratamentoExcecaoAcademico.Create, RotinaTratarErroBancoP, RotinaTratarErroBancoM ).TrataExcecao;

   { Carregar Parâmetros gerais da aplicação }
   CarregarParametrosGerais();

   { Redirecionamento dos Hints }
   Application.OnHint := MostraHint;

   { Carregar o Objeto de relatório usado no sistema }
   CarregarObjetoRelatorio();

   miRelatorios.Visible := EnableNewReportMenu;
end;  { FormCreate }


