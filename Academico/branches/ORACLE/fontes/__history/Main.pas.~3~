procedure TPrincipalForm.tmRelogio2Timer(Sender: TObject);
begin
   FStopWatch.Stop;
   FRelogio := DM.DataAtual;
   FStopWatch.Start;                                                   
   btnDatas.Caption := Format('Data/hora servidor: %s', [FormatDateTime('dd/mm/yyyy hh:nn', FRelogio)]);

   //nova tentativa de evitar desconexão com o banco de dados
   try
      with DM.db do
      begin
        Connected := true;
        //showmessage('Banco de Dados Conectado' );
      end;
   except on E:exception do
      begin
        DM.db.Connected := false;
        showmessage('Falha ao conectar com o banco de dados. Erro = "'+E.message+'"' );
        Application.Terminate;
      end;
   end;
   //nova tentativa de evitar desconexão com o banco de dados
end;

