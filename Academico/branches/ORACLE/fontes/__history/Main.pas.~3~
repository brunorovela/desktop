procedure TPrincipalForm.cadAtualizarDocumentacaoClick(Sender: TObject);
var
   qyInsereLog, qyInserirLog, qyAtualizarDocumentacao : TUMZQuery;
   i: integer;
   sn_virgula: String;
begin
   if DM.UsuarioLogado.TemPermissao(1110, npAlterar, true) then
   begin
      if Mensagem('Esse procedimento irá atualizar os documentos necessários para os alunos já matriculados. Deseja continuar?',
                  'Confirmação', MB_YESNO + MB_ICONQUESTION, Handle) <> mrYes then
         Exit;

      DM.CriarConsulta(qyAtualizarDocumentacao);
      DM.CriarConsulta(qyInsereLog);
      DM.CriarConsulta(qyInserirLog);
      {qyInsereLog serve apenas executar o SELECT da query qyAtualizarDocumentacao
      para inserir log da operação dos registros alterados.}



      qyInsereLog.SQL.Text :=
         '  SELECT MA.CODIGOALUNO, DN.COD_DOCUMENTO, ''N'' FROM MATRICULAS MA ' +
         '  INNER JOIN TURMAS T ON ( T.CODIGO = MA.TURMA AND T.ANOSEMESTRE = MA.ANOSEMESTRE ) ' +
         '  INNER JOIN PESSOAS PE ON (PE.CD_PESSOA = MA.CODIGOALUNO) ' +
         '  INNER JOIN DOCUMENTOS_NECESSARIOS DN ON (DN.CURSO = MA.CURSO) ' +
         '  INNER JOIN DOCUMENTOS D ON (D.codigo = DN.cod_documento AND (D.DS_SEXO = ''A'' OR D.DS_SEXO = PE.DS_SEXO) AND (D.CD_TIPO_PESSOA IN (1,2))) ' +
         '   LEFT JOIN DOCUMENTOS_ALUNOS DA ON (DA.CODIGOALUNO = MA.CODIGOALUNO AND DA.COD_DOCUMENTO = DN.COD_DOCUMENTO) ' +
         '  WHERE DA.codigoaluno IS NULL AND t.cd_coligada IN ( %s ) ' +
         '  GROUP BY MA.CODIGOALUNO, DN.COD_DOCUMENTO ';

      qyInsereLog.SQL.Text := Format(qyInsereLog.SQL.Text, [DM.UsuarioLogado.GetColigadasFilhaSelecionada()]);
      qyInsereLog.Open;

      i:=0;
      qyInserirLog.SQL.Text := ' INSERT INTO log_geral ' +
               ' (cd_usuario, cd_modulo, cd_chave, ds_observacoes, dt_log) VALUES ';
      //Percorre a query e insere um log para cada registro
      while not(qyInsereLog.Eof) do
      begin

         if (i = 10) then
         begin
            qyInserirLog.ExecSQL;

            qyInserirLog.Close;
            qyInserirLog.SQL.Text := ' INSERT INTO log_geral ' +
               ' (cd_usuario, cd_modulo, cd_chave, ds_observacoes, dt_log) VALUES ';

            i:=0;
         end;

         if (i = 0) then
         begin
            sn_virgula := '';
         end
         else
         begin
            sn_virgula := ',';
         end;

         qyInserirLog.SQL.Text := qyInserirLog.SQL.Text + sn_virgula + ' ( ' +
            IntToStr(DM.iCdPessoaLogado) + ', ' + IntToStr(1110) + ', ' +
            '"'+qyInsereLog.FieldByName('CODIGOALUNO').asString + ';' +
            qyInsereLog.FieldByName('COD_DOCUMENTO').asString + '", ' +
            '"Documento inserido via Atualização da Documentação"' +
            ', now()'  + ' ) ';

         qyInsereLog.Next;
         i := i + 1;

      end;
      Try
         qyInserirLog.ExecSQL;
      Except
         i := i + 1;
      End;

      qyAtualizarDocumentacao.SQL.Text :=
         ' INSERT INTO documentos_alunos (codigoaluno, cod_documento, apresentou) ' +
         ' SELECT MA.CODIGOALUNO, DN.COD_DOCUMENTO, ''N'' FROM MATRICULAS MA ' +
         '  INNER JOIN TURMAS T ON ( T.CODIGO = MA.TURMA AND T.ANOSEMESTRE = MA.ANOSEMESTRE ) ' +
         '  INNER JOIN PESSOAS PE ON (PE.CD_PESSOA = MA.CODIGOALUNO) ' +
         '  INNER JOIN DOCUMENTOS_NECESSARIOS DN ON (DN.CURSO = MA.CURSO) ' +
         '  INNER JOIN DOCUMENTOS D ON (D.codigo = DN.cod_documento AND (D.DS_SEXO = ''A'' OR D.DS_SEXO = PE.DS_SEXO) AND (D.CD_TIPO_PESSOA IN (1,2))) ' +
         '   LEFT JOIN DOCUMENTOS_ALUNOS DA ON (DA.CODIGOALUNO = MA.CODIGOALUNO AND DA.COD_DOCUMENTO = DN.COD_DOCUMENTO) ' +
         '  WHERE DA.codigoaluno IS NULL AND t.cd_coligada IN ( %s ) ' +
         '  GROUP BY MA.CODIGOALUNO, DN.COD_DOCUMENTO ';

      qyAtualizarDocumentacao.SQL.Text := Format(qyAtualizarDocumentacao.SQL.Text, [DM.UsuarioLogado.GetColigadasFilhaSelecionada()]);

      qyAtualizarDocumentacao.ExecSQL();
      Mensagem('Documentos atualizados com sucesso!', 'UNIMESTRE', MB_OK + MB_ICONEXCLAMATION, Handle);

   end;
end;

