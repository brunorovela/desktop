procedure TfMatricular.bbtnBaixarClick(Sender: TObject);
const
   SConfirmImpRec = 'Deseja imprimir o recibo para o título baixado?';
var
   I: Integer;
   S, FilRecibo: string;
   Recibo: TFinReciboManager;
   MensBaixa: TMBMensalidadeBaixa;
   sNomeRelatorio: String;
   PodeExportar: Boolean;
   infoRelatorio: ClasseRegistros;
   listaParcelas: uMensalidades_Baixar.TDynamicIntArray;
begin
   S := Trim(DM.variavel_parametro('tela_baixa_mensalidade'));

   if (S = '1') then
   begin
      Application.CreateForm(TfrmMensalidadesBaixar, frmMensalidadesBaixar);
      try

        SetLength(listaParcelas, cdsBoletos.RecordCount);

        cdsBoletos.First;

        i := 0;
        while not cdsBoletos.Eof do
        begin

         if cdsBoletosSN_SELECIONADO.AsBoolean = True then
         begin
            listaParcelas[i] := cdsBoletosCD_MENSALIDADE.AsInteger;
            i := i + 1;
         end;

         cdsBoletos.Next;

        end;

         frmMensalidadesBaixar.setArrParcelasSelecionadas(listaParcelas);
         frmMensalidadesBaixar.setPessoaSelecionada(Format('%d', [Pessoa]));
         frmMensalidadesBaixar.setNmPessoaSelecionada(NomePessoa);
         frmMensalidadesBaixar.setTurmaSelecionada(
            qryMatriculaCD_TURMA.AsString
         );
         frmMensalidadesBaixar.setNrAnoSemestreSelecionado(
            qryMatriculaNR_ANOSEMESTRE.AsString
         );
         frmMensalidadesBaixar.AutoRelease := False;
         frmMensalidadesBaixar.ShowModal;

         cdsBoletos.DisableControls;

         if Assigned(frmMensalidadesBaixar.ListaMensalidadesBaixa) then
            for I := 0 to frmMensalidadesBaixar.ListaMensalidadesBaixa.Count - 1 do
            begin
               MensBaixa := TMBMensalidadeBaixa(
                  frmMensalidadesBaixar.ListaMensalidadesBaixa.Items[I]
               );
               if cdsBoletos.Locate('CD_MENSALIDADE',
                  MensBaixa.getValorCampo('cd_mensalidade'), []) then
               begin
                  cdsBoletos.Edit;
                  cdsBoletosSN_BAIXOU.AsBoolean := True;
                  cdsBoletos.Post;
               end;
            end;

         cdsBoletos.EnableControls;
         frmMensalidadesBaixar.LiberaObjetos;
      finally
         frmMensalidadesBaixar.Free;
      end;
   end
   else
   begin
      Application.CreateForm(Tfrm_mensa_baixar, frm_mensa_baixar);
      try
         frm_mensa_baixar.lngCodigoAluno := Pessoa;
         frm_mensa_baixar.intParcela := cdsBoletosNR_PARCELA.AsInteger;
         frm_mensa_baixar.datVencimento := cdsBoletosDT_VENCTO.AsDateTime;
         frm_mensa_baixar.strTurma := qryMatriculaCD_TURMA.AsString;
         frm_mensa_baixar.strAluno := '';
         frm_mensa_baixar.iCodigoMensalidade := cdsBoletosCD_MENSALIDADE.AsInteger;
         frm_mensa_baixar.iConta := qryDeptoCD_CAIXA.AsInteger;
         frmDinCh.AlunoAtual := Pessoa;
         frmDinCh.iCaixa := qryDeptoCD_CAIXA.AsInteger;

         if frm_mensa_baixar.ShowModal = mrOk then
         begin
            cdsBoletos.DisableControls;
            cdsBoletos.Edit;
            cdsBoletosSN_BAIXOU.AsBoolean := True;
            cdsBoletos.Post;
            cdsBoletos.EnableControls;

            S := Trim(DM.variavel_parametro('financeiro_qtd_autenticacao_baixa'));

            if (S <> '') and (S <> '-1') then
            begin
               TfrmMensalidades.AutenticarMensalidade;
            end;

            S := UpperCase(Trim(DM.variavel_parametro('financeiro_forcar_recibo')));

            if (S = 'NORMAL') or (S = 'FISCAL') then
            begin
               if MessageDlg(SConfirmImpRec, mtConfirmation, [mbYes, mbNo], -1) = mrYes then
               begin
                  if S = 'NORMAL' then
                  begin
                     Recibo := TFinReciboManager.Create(cdsBoletosCD_MENSALIDADE.AsInteger);
                     try
                        Recibo.imprimirRecibo;

                        infoRelatorio := PrincipalForm.GetInfoRpt('relatorio_padrao_recibo');
                        sNomeRelatorio := infoRelatorio.Campo['nm_arquivo']+'.rpt';

                        PodeExportar := True;
                        if infoRelatorio.Campo['sn_pode_exportar'] = 0 then
                           PodeExportar := False;

                        FilRecibo :=
                           Format('{MENSALIDADES.CD_MENSALIDADE} = %d', [
                              cdsBoletosCD_MENSALIDADE.AsInteger
                           ]);
                        PrincipalForm.ImprimeRpt(Self, sNomeRelatorio, -1, FilRecibo,
                           '', nil, nil, nil, nil, True, False, nil, PodeExportar);
                     finally
                        Recibo.Free;
                     end;
                  end
                  else if S = 'FISCAL' then
                  begin
                     I := StrToIntDef(S, 1);
                     Application.CreateForm(TfrmImpMens, frmImpMens);
                     try
                        while I > 0 do
                        begin
                           frmImpMens.ImprimirReciboDOS(
                              cdsBoletosCD_MENSALIDADE.AsString
                           );
                           Dec(I);
                        end;
                     finally
                        frmImpMens.Free;
                     end;
                  end;
               end;
            end;
         end;
      finally
         frm_mensa_baixar.Free;
      end;
   end;
end;

