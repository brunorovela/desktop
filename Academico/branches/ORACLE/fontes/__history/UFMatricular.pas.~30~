      cdsBoletosDT_VENCTO.AsDateTime := cdsMensalidadesDT_VENCTO.AsDateTime;
      cdsBoletosVL_BRUTO.AsCurrency := cdsMensalidadesVL_BRUTO.AsCurrency;
      cdsBoletosVL_DESCONTO.AsCurrency := cdsMensalidadesVL_DESCONTO.AsCurrency;
      cdsBoletosVL_BOLSA.AsCurrency := cdsMensalidadesVL_BOLSA.AsCurrency;
      cdsBoletosVL_EXTRA.AsCurrency := cdsMensalidadesVL_EXTRA.AsCurrency;
      cdsBoletosNM_RESPONSAVEL.AsString := cdsMensalidadesNM_RESPONSAVEL.AsString;
      cdsBoletosCD_MENSALIDADE.AsInteger := cdsMensalidadesCD_MENSALIDADE.AsInteger;
      cdsBoletosSN_SELECIONADO.AsBoolean := True;
      cdsBoletosSN_BAIXOU.AsBoolean := False;
      cdsMensalidades.Next;
