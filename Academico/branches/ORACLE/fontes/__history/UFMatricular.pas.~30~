procedure TfMatricular.bbtnAvancarClick(Sender: TObject);
const
   STitConfirm = 'Confirmação';
   STitInform = 'Informação';
   STitAtencao = 'Atenção';
   SMsgMatTurmaDup = 'O aluno já possui uma matrícula nesta turma. Caso queira realizar algum ajuste utilize a Planilha de Matrículas.';
   SQuestConfirmMat = 'Deseja realmente realizar a matrícula? Ao confirmar esta ação não é possível retornar.';
   SMsgMatRealizada = 'O processo de matrícula foi finalizado com sucesso.';
   SMsgSemInfos = 'Para prosseguir com o processo de matrícula é necessário informar o turno e a forma de ingresso.';
   SMsgSitInativa = 'A situação da matrícula do aluno no curso é inválida.'#13'Não é possível prosseguir.';
   SMsgBloqVagas = #13 + 'Entre no cadastro de Turmas e verifique a quantidade de vagas preenchida.';
   SMsgBloqVagasTurma = 'A quantidade de vagas da turma expirou.' +  SMsgBloqVagas ;
   SMsgBloqVagasDisc = 'A quantidade de vagas por disciplina da turma expirou.' + SMsgBloqVagas ;
   SMsgUltrapassouLimiteMatLite = 'Limite de matrículas alcançado! A versão LITE do UNIMESTRE permite apenas %s matrículas por ano/semestre. Para aumentar este número, sugerimos a aquisição da versão FULL.';
   SMParamNaoConfigurada = 'O parâmetro de limite de matriculas de aluno no UNIMESTRE LITE não está configurado!';
   SMsgChaveDuplicada = 'Este aluno já possui uma matricula neste curso e neste Ano/Semestre de ingresso.'; 
var
   i, j, qtdDiscObrigatorias, qtdDiscObrigatoriasSelecionadas, vagasPorDisciplina, inscritosPorDisciplina: Integer;
   mensagem, sn_obrigar_optativas, msgBloq, slimiteDisciplinasSelecionadas: String;
   configurarTurmaOptativa, configurarOptativas, selecionarOptativas, bloquear_vagas: Boolean;
   disciplinasSelecionadas, disciplinasSelecionadasAux, disciplinasDuplicadas: TStringList;
begin
   FAvancando := True;

   if pgcEtapas.ActivePageIndex = 0 then
   begin
      if qryMatriculaCursoCD_TURNO.IsNull or qryMatriculaCursoCD_INGRESSO.IsNull then
      begin
         MessageBox(Handle, SMsgSemInfos, STitAtencao, MB_ICONWARNING or MB_OK);

         dblcMatriculaCursoTurno.SetFocus;
      end
      else if qryMatriculaCursoCD_SITUACAO.AsInteger <> 1 then
      begin
         MessageBox(Handle, SMsgSitInativa, STitAtencao, MB_ICONWARNING or MB_OK);
         dblcMatriculaCursoSituacao.SetFocus;
      end
      else
      begin
         // Verifica se o aluno ja não possui uma matricula neste curso e anosemestre
         qryVerificaMatriculaUnica.Close;
         qryVerificaMatriculaUnica.ParamByName('pessoa').AsString := qryMatriculaCursoCD_PESSOA.AsString;
         qryVerificaMatriculaUnica.ParamByName('curso').AsString := qryMatriculaCursoCD_CURSO.AsString;
         qryVerificaMatriculaUnica.ParamByName('anosem').AsString := qryMatriculaCursoNR_ANOSEM_INGRESSO.AsString;
         qryVerificaMatriculaUnica.Open;

         if(qryVerificaMatriculaUnica.FieldByName('cont').AsInteger > 0) then
         begin
            MessageBox(Handle, PChar(SMsgChaveDuplicada), PChar(STitInform),MB_ICONINFORMATION or MB_OK);
            exit;
         end;

         tsEtapas.SelectNext(True);
      end;
   end
   else if pgcEtapas.ActivePageIndex = 1 then
   begin

      if DM.lite then
      begin
         if (DM.variavel_parametro('limite_matriculas_lite') = '')then
         begin
            MessageBox(Handle, PChar(SMParamNaoConfigurada), PChar(STitInform),MB_ICONINFORMATION or MB_OK);
            exit;            
         end;

         qryLimiteMat.Close;
         qryLimiteMat.ParamByName('anosemestre').AsInteger := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qryLimiteMat.Open;

         if qryLimiteMat.FieldByName('qtd_mat').AsInteger >= StrToInt( TUMCriptografia.UMCrypt( DM.variavel_parametro('limite_matriculas_lite'), ctDecode, CHAVE_LITE) )  then
         begin
            mensagem := Format(SMsgUltrapassouLimiteMatLite, [TUMCriptografia.UMCrypt( DM.variavel_parametro('limite_matriculas_lite'), ctDecode, CHAVE_LITE)] );
            MessageBox(Handle, PChar(mensagem), PChar(STitInform),MB_ICONINFORMATION or MB_OK);
            exit;
         end;
      end;

      if qryMatriculaTurma.Active then
      begin
         qryMatriculaTurma.Close;
      end;
      qryMatriculaTurma.Open;

      if qryMatriculaTurma.IsEmpty then
      begin
         bloquear_vagas := false;
         if(qryTurmaSN_BLOQUEAR_VAGAS.AsInteger = 1) then
         begin
            // Verifica se deve bloquear vaga e se a quantidade de matriculas é maior que o limite, nesse caso bloqueia
            bloquear_vagas := ( qryTurmaNR_MATRICULAS.AsInteger >= qryTurmaNR_VAGAS.AsInteger );
            msgBloq := SMsgBloqVagasTurma;
         end else if (qryTurmaSN_BLOQUEAR_VAGAS.AsInteger = 2) then
         begin
            // Pega o numero total de inscritos por disciplina
            With qryVerificaVagasPorDisciplina do
            begin
               Close;
               ParamByName('turma').AsString := qryTurmaCD_TURMA.AsString;
               ParamByName('anosemestre').AsString := qryTurmaNR_ANOSEMESTRE.AsString;
               Open;

               if not (FieldByName('NrMatriculas').IsNull) then
               begin
                  inscritosPorDisciplina := FieldByName('NrMatriculas').AsInteger;
               end else begin
                  inscritosPorDisciplina := 0;
               end;
            end;

            // Pega o numero total de disicplinas para calcular as vagas
            With qryVerificaNrInscritosPorDisciplina do
            begin
               Close;
               ParamByName('turma').AsString := qryTurmaCD_TURMA.AsString;
               ParamByName('anosemestre').AsString := qryTurmaNR_ANOSEMESTRE.AsString;
               Open;

               if not (FieldByName('nrVagas').IsNull) then
               begin
                  vagasPorDisciplina := FieldByName('nrVagas').AsInteger;
               end else begin
                  vagasPorDisciplina := 0;
               end;
            end;

            bloquear_vagas := ((qryTurmaNR_VAGAS.AsInteger * vagasPorDisciplina) <= (inscritosPorDisciplina));
            msgBloq := SMsgBloqVagasDisc;
         end;

         if bloquear_vagas then
         begin
            MessageBox(Handle, PChar(msgBloq), PChar(STitInform),
                  MB_ICONINFORMATION or MB_OK);
            Exit;
         end;

         if qryTurma.IsEmpty then
         begin
            MessageBox(Handle, PChar('Para prosseguir com a matrícula é necessário selecionar uma turma.'), PChar(STitInform),
                  MB_ICONINFORMATION or MB_OK);
            Exit;
         end;

         // Atribui o código grade e o turno da turma selecionada para a matricula curso que será criada
         // Quando for um processo de Rematricula e for entre cursos
         if Ajuste and (Length(RematriculaNovoCurso) > 0) then
         begin
            qryMatriculaCursoCD_GRADE.AsInteger := qryTurma.FieldByName('CD_GRADE').AsInteger;
            qryMatriculaCursoCD_TURNO.AsString := qryTurma.FieldByName('CD_TURNO').AsString;
         end;

         // Verifica se o usuário optou por "Usar grade da turma"
         if (cbMatriculaCursoGrade.ItemIndex = 0) and (not Ajuste) then
         begin
            if not qryTurmaCD_GRADE.IsNull then
            begin
               qryMatriculaCursoCD_GRADE.AsInteger := qryTurma.FieldByName('CD_GRADE').AsInteger;
            end else begin
               MessageBox(Handle, PChar('Para prosseguir a turma selecionada deve estar vinculada a uma grade curricular.'), PChar(STitInform),
                     MB_ICONINFORMATION or MB_OK);
               Exit;
            end;
         end;

         if ListaPreRequisito <> nil then
         begin
            sn_consultou_usa_pre_requisito   := false;
            sn_usa_pre_requisito             := false;
            FreeAndNil(ListaPreRequisito);
         end;

         tsEtapas.SelectNext(True);
      end
      else
      begin
         MessageBox(Handle, PChar(SMsgMatTurmaDup), PChar(STitInform),
            MB_ICONINFORMATION or MB_OK);
      end;
   end
   else if pgcEtapas.ActivePageIndex = 2 then
   begin

      disciplinasSelecionadas := TStringList.Create;
      disciplinasDuplicadas := TStringList.Create;

      cdsDisciplinas.First;
      while not cdsDisciplinas.Eof do
      begin
         if cdsDisciplinasSN_SELECIONADA.AsBoolean then
         begin
            disciplinasSelecionadas.AddObject (
               cdsDisciplinasCD_TURMA.AsString,
               TItemCombo.Create
               (
                  cdsDisciplinasCD_DISCIPLINA.AsString,
                  cdsDisciplinasCD_CURSO.AsString,
                  cdsDisciplinasNM_DISCIPLINA.AsString   
               )
            );
         end;

         cdsDisciplinas.Next;
      end;

      disciplinasSelecionadasAux := disciplinasSelecionadas;

      for i := 0 to disciplinasSelecionadas.Count - 1 do
      begin
         if (disciplinasDuplicadas.Count >= 10) then break;

         for j := i to disciplinasSelecionadasAux.Count - 1 do
         begin
            if (TItemCombo(disciplinasSelecionadas.Objects[i]).getCodigo = TItemCombo(disciplinasSelecionadasAux.Objects[j]).getCodigo) and
               (TItemCombo(disciplinasSelecionadas.Objects[i]).getDescricao = TItemCombo(disciplinasSelecionadasAux.Objects[j]).getDescricao) and
               (disciplinasSelecionadas[i] <> disciplinasSelecionadas[j]) then
            begin
               if (disciplinasDuplicadas.IndexOf(TItemCombo(disciplinasSelecionadas.Objects[i]).getVariavel) = -1) then
               begin
                  disciplinasDuplicadas.Add(TItemCombo(disciplinasSelecionadas.Objects[i]).getVariavel);
               end;
               
               if (disciplinasDuplicadas.Count >= 10) then break;
            end;
         end;
      end;                                  

      mensagem := '';
      for i := 0 to disciplinasDuplicadas.Count-1 do
      begin
         mensagem := mensagem + ' - ' +disciplinasDuplicadas[i]+#13;;
      end;

      if disciplinasDuplicadas.Count = 10 then mensagem := mensagem + '...';

      // Parâmetro que define a obrigatoriedade do aluno cursar as disciplinas optativas da turma matrícula
      sn_obrigar_optativas := DM.variavel_parametro('sn_obrigar_optativas');

      if sn_obrigar_optativas = 'S' then
      begin
         // Pega as disciplinas Optativas Genéricas da Grade Curricular da turma matrícula
         qryGenericasOptativasGrade.Close;
         qryGenericasOptativasGrade.ParamByName('NR_ANOSEMESTRE').AsInteger := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qryGenericasOptativasGrade.ParamByName('CD_TURMA').AsString := qryMatriculaCD_TURMA.AsString;
         qryGenericasOptativasGrade.Open;

         // Pega as disciplinas Optativas Genéricas definidas para a turma matrícula
         qryGenericasOptativas.Close;
         qryGenericasOptativas.ParamByName('NR_ANOSEMESTRE').AsInteger := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qryGenericasOptativas.ParamByName('CD_TURMA').AsString := qryMatriculaCD_TURMA.AsString;
         qryGenericasOptativas.ParamByName('CD_CURSO').AsString := qryMatriculaCD_CURSO.AsString;
         qryGenericasOptativas.Open;

         // Pega a turma optativa em que as optativas serão cadastradas
         qryTurmaOptativa.Close;
         qryTurmaOptativa.ParamByName('NR_ANOSEMESTRE').AsInteger := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qryTurmaOptativa.ParamByName('CD_CURSO').AsString := qryMatriculaCD_CURSO.AsString;
         qryTurmaOptativa.ParamByName('CD_GRADE').AsString := qryMatriculaCursoCD_GRADE.AsString;
         qryTurmaOptativa.Open;

         // Verifica se foi criada uma turma optativa para anosemestre/grade/curso
         configurarTurmaOptativa := False;
         if qryTurmaOptativa.Eof then
         begin
            configurarTurmaOptativa := True;
         end;         

         // Varre as discipinas genéricas da grade curricular
         configurarOptativas := False;
         while not qryGenericasOptativasGrade.Eof do
         begin

            // Verifica se NÃO foi configurada a disciplina optativa genérica para a turma matrícula (está na grade e não esta configurada para turma)
            if not qryGenericasOptativas.Locate('CD_DISCIPLINA_GENERICA', qryGenericasOptativasGradeCD_DISCIPLINA_GENERICA.AsInteger, [loCaseInsensitive]) then
            begin
               configurarOptativas := True;
               break;
            end;

            qryGenericasOptativasGrade.Next;
         end;

         // Varre as disciplinas genéricas optativas da turma
         selecionarOptativas := False;
         qryGenericasOptativas.First;
         while not qryGenericasOptativas.Eof do
         begin

            // Verifica se NÃO foi selecionada uma disciplina optativa para a genérica da turma matrícula
            if not cdsDisciplinas.Locate('cd_curso;cd_turma;cd_disciplina_generica;sn_selecionada', VarArrayOf([qryMatriculaCD_CURSO.AsString, qryMatriculaCD_TURMA.AsString, qryGenericasOptativasCD_DISCIPLINA_GENERICA.AsInteger, True]), [loCaseInsensitive]) then
            begin
               selecionarOptativas := True;
               break;
            end;

            qryGenericasOptativas.Next;
         end;

      end;

      if mensagem <> '' then
      begin
         MessageBox(Handle, PChar('Não foi possível prosseguir, pois as disciplinas abaixo foram selecionadas para mais de uma turma: '#13#13+mensagem), STitAtencao,
            MB_ICONWARNING or MB_OK);

      end else if disciplinasSelecionadas.Count = 0 then
      begin
         MessageBox(Handle, PChar('Necessário selecionar ao menos uma disciplina para prosseguir.'), STitAtencao,
            MB_ICONWARNING or MB_OK);

      end else if configurarTurmaOptativa then
      begin
         MessageBox(Handle, PChar('Não foi cadastrada uma turma na etapa "Optativa".'#13'Será necessário realizar o cadastro de uma turma nesta etapa para prosseguir.'), STitAtencao,
            MB_ICONWARNING or MB_OK);

      end else if configurarOptativas then
      begin
         MessageBox(Handle, PChar('As disciplinas optativas não estão configuradas para a turma ['+qryMatriculaCD_TURMA.AsString+']. Existem optativas na grade curricular que não foram configuradas para essa turma.'#13'Necessário configurar a turma para prosseguir.'), STitAtencao,
            MB_ICONWARNING or MB_OK);

      end else if selecionarOptativas then
      begin
         MessageBox(Handle, PChar('É necessário selecionar todas as disciplinas optativas da turma ['+qryMatriculaCD_TURMA.AsString+'] para prosseguir.'), STitAtencao,
            MB_ICONWARNING or MB_OK);

      end else if (DM.variavel_parametro('sn_logica_matricula', False) = 'S') then
      begin

         cdsDisciplinasObrigatorias.Data := cdsDisciplinas.Data;

         cdsDisciplinasObrigatorias.Filtered := True;
         cdsDisciplinasObrigatorias.Filter := ' SN_OBRIGATORIO ';

         // Busca a quantidade de disciplinas obrigatórias
         qtdDiscObrigatorias := cdsDisciplinasObrigatorias.RecordCount;

         // Busca a quantidade de disciplinas obrigatórias que estão selecionadas
         qtdDiscObrigatoriasSelecionadas := 0;
         while not cdsDisciplinasObrigatorias.Eof do
         begin
            if cdsDisciplinasObrigatorias.FieldByName('SN_SELECIONADA').AsBoolean then
            begin
               inc(qtdDiscObrigatoriasSelecionadas);
            end else begin
               // Se a disciplina obrigatória não estiver selecionada verifica se
               // essa disciplina está selecionada em outra turma então
               cdsDisciplinas.First;
               while not cdsDisciplinas.Eof do
               begin
                  if (cdsDisciplinas.FieldByName('CD_DISCIPLINA').AsInteger = cdsDisciplinasObrigatorias.FieldByName('CD_DISCIPLINA').AsInteger) and
                     (cdsDisciplinas.FieldByName('CD_CURSO').AsString = cdsDisciplinasObrigatorias.FieldByName('CD_CURSO').AsString) and
                     (cdsDisciplinas.FieldByName('SN_SELECIONADA').AsBoolean) then
                  begin
                     inc(qtdDiscObrigatoriasSelecionadas);
                  end;

                  cdsDisciplinas.Next;
               end;
            end;
            cdsDisciplinasObrigatorias.Next;
         end;

         slimiteDisciplinasSelecionadas := DM.variavel_parametro('limite_disciplinas_matricula');

         if slimiteDisciplinasSelecionadas <> '' then
         begin

           // Verifica se usuário selecionou mais disciplinas que o permitido
           if disciplinasSelecionadas.Count > StrToInt(slimiteDisciplinasSelecionadas) then
           begin
              MessageBox(Handle, PChar('Não é possível selecionar mais que '+slimiteDisciplinasSelecionadas+' disciplinas.'), STitAtencao,
              MB_ICONWARNING or MB_OK);

           // Verifica se usuário deve selecionar X disciplinas obrigatórias, dentro todas que existem (mais que X), onde X é o valor definido no parâmetro "limite_disciplinas_matricula"
           end else if (qtdDiscObrigatorias > StrToInt(slimiteDisciplinasSelecionadas)) and (qtdDiscObrigatoriasSelecionadas <> StrToInt(slimiteDisciplinasSelecionadas)) then
           begin
              MessageBox(Handle, PChar('Não foi possível prosseguir, pois é necessário selecionar '+slimiteDisciplinasSelecionadas+' disciplinas obrigatórias por reprovação.'), STitAtencao,
              MB_ICONWARNING or MB_OK);

           // Verifica se usuário deve selecionar todas as disciplinas obrigatórias
           end else if (qtdDiscObrigatorias <= StrToInt(slimiteDisciplinasSelecionadas)) and (qtdDiscObrigatoriasSelecionadas <> qtdDiscObrigatorias) then
           begin
              MessageBox(Handle, PChar('Não foi possível prosseguir, pois é necessário selecionar todas as disciplinas obrigatórias por reprovação.'), STitAtencao,
              MB_ICONWARNING or MB_OK);

           end else begin
              tsEtapas.SelectNext(True);
           end;

         end else begin
           tsEtapas.SelectNext(True);
         end;

      end else begin
         tsEtapas.SelectNext(True);
      end;

   end
   else if pgcEtapas.ActivePageIndex = 3 then
   begin
      if FFrmPlanoAfrica <> nil then
      begin
         qryMatriculaCD_PLANO_PGTO.AsInteger := FFrmPlanoAfrica.qryPlanoPgtoCD_PLANO.AsInteger;
      end
      else
      begin
         qryMatriculaCD_PLANO_PGTO.AsInteger:= FFrmPlanoBrasil.qryPlanoPgtoCD_PLANO.AsInteger;
      end;

      if (fMatricularPlanoDesconto <> nil) and (fMatricularPlanoDesconto.bPlanoSelecionado) then
      begin
         qryMatriculaCD_PLANO_DESC.AsInteger := fMatricularPlanoDesconto.cdsPlanosDescontoCD_PLANO.AsInteger;
      end;

      tsEtapas.SelectNext(True);

   end
   else if pgcEtapas.ActivePageIndex = 4 then
   begin
      if MessageBox(Handle, PChar(SQuestConfirmMat), PChar(STitConfirm),
         MB_ICONQUESTION or MB_YESNO) = ID_YES then
      begin
         RegistraMatricula;
         MessageBox(Handle, PChar(SMsgMatRealizada), PChar(STitInform),
            MB_ICONINFORMATION or MB_OK);
         tsEtapas.SelectNext(True);
         bbtnVoltar.Enabled := False;
      end;
   end
   else
   begin
      tsEtapas.SelectNext(True);
   end;
end;

