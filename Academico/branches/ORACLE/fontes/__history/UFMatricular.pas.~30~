function TfMatricular.EhSerieProfissionalizante: Boolean;
var
   nrSerieProfissionalizante, nrProxSerie: Integer;
begin

   if DM.variavel_parametro('sn_logica_matricula', false) <> 'S' then
   begin
      exit;
   end;

   // Busca qual o número da série que inicia as disciplinas profissionalizantes para o curso do aluno
   qrySerieProfissionalizante.Close;

   qrySerieProfissionalizante.ParamByName('cd_pessoa').AsInteger := qryMatriculaCD_PESSOA.AsInteger;
   qrySerieProfissionalizante.ParamByName('cd_curso').AsString := qryMatriculaCD_CURSO.AsString;

   qrySerieProfissionalizante.Open;

   nrSerieProfissionalizante := qrySerieProfissionalizante.FieldByName('nr_serie_profissionalizante').AsInteger;

   // Busca a próxima série que será oferecida para o aluno
   nrProxSerie := qryUltimaSerieNR_SERIE.AsInteger + 1;

   // Verifica se a próxima série do aluno é uma série profissionalizante
   if (nrProxSerie >= nrSerieProfissionalizante) then
   begin
      Result := True;
   end else begin
      Result := False;
   end;

end;

function TfMatricular.GetQtdLimiteDisciplinasPendentes: Integer;
var
   nrSerie1Ano, nrSerie2Ano, qtdDisciplinasAno, qtdDisciplinasReprovadas: Integer;
begin

   if DM.variavel_parametro('sn_logica_matricula', false) <> 'S' then
   begin
      Exit;
   end;

   // Inicia a quantidade de disciplinas limite com 3, padrão das séries basicas
   Result := 3;

   // Se for uma série profissionalizante, a quantidade limite deve ser checada e pode ser alterada
   if EhSerieProfissionalizante() then
   begin
      // Pega as duas séries do ano que o aluno está cursando
      nrSerie1Ano := qryUltimaSerieNR_SERIE.AsInteger-1;
      nrSerie2Ano := qryUltimaSerieNR_SERIE.AsInteger;

      // 1) Verifica qual a quantidade de disciplinas oferecidas no ano que o aluno está cursando (verificar se possui mais ou menos de 12 disciplinas)
      // 2) Verifica qual a quantidade de disciplinas que o aluno reprovou nesse ano (levando em conta que se a disciplina possui pré-requisito que estiver reprovada contará como duas)
      qryDisciplinasAno.Close;
      qryDisciplinasAno.ParamByName('cd_pessoa').AsInteger := qryMatriculaCD_PESSOA.AsInteger;
      qryDisciplinasAno.ParamByName('cd_curso').AsString := qryMatriculaCD_CURSO.AsString;
      qryDisciplinasAno.ParamByName('nr_serie1').AsInteger := nrSerie1Ano;
      qryDisciplinasAno.ParamByName('nr_serie2').AsInteger := nrSerie2Ano;
      qryDisciplinasAno.Open;

      qtdDisciplinasAno := qryDisciplinasAno.FieldByName('qtd_disciplinas').AsInteger;

      // Se o número de disciplinas do ano que o aluno está cursando é >= 12 então o aluno pode ficar pendente em 3 disciplinas
      // Se o número de disciplinas do ano que o aluno está cursando é < 12 então o aluno pode ficar pendente em 2 disciplinas
      if qtdDisciplinasAno >= 12 then
      begin
         Result := 3;
      end else begin
         Result := 2;
      end;
   end;

end;

procedure TfMatricular.sbDiscTodasClick(Sender: TObject);
const
   SQuestConfirm = 'Tem certeza que deseja matricular o aluno em todas as disciplinas disponíveis filtradas?';
   SMsgRestricoesSemPermissao = 'A disciplina [%s] possui um ou mais impedimentos e, portanto, o aluno não pode ser matriculado.'#13'Impedimentos:'#13'%s';
   SMsgRestricoesComPermissao = 'A disciplina [%s] possui um ou mais impedimentos. Deseja realizar a matrícula mesmo assim?'#13'Impedimentos:'#13'%s';
   MsgQuestFlags = MB_ICONQUESTION or MB_YESNO or MB_DEFBUTTON2;
var
   I: Integer;
   NodeCurso, NodeTurma: TTreeNode;
   NodeList: TList;
begin
   if tvDisciplinasDisp.Items.Count = 0 then Abort;

   // Cria a lista que vai armazenar as turmas a serem repassadas
   NodeList := TList.Create;
   try
      // Pega o primeiro item da TreeView (curso)
      NodeCurso := tvDisciplinasDisp.Items[0];
      // Varre todos os cursos
      while NodeCurso <> nil do
      begin
         // Varre todas as turmas
         NodeTurma := NodeCurso.getFirstChild;
         while NodeTurma <> nil do
         begin
            // Inclui as turmas na lista que será repassada para as disciplinas selecionadas
            NodeList.Add(NodeTurma);
            NodeTurma := NodeTurma.getNextSibling;
         end;
         NodeCurso := NodeCurso.getNextSibling;
      end;

      // Varre a lista de turmas e repassa as mesmas para as disciplinas selecionadas
      for I := 0 to NodeList.Count - 1 do
      begin
         NodeTurma := NodeList.Items[I];
         NodeTurma.Selected := True;
         sbDiscSelClick(Sender);
      end;
   finally
      NodeList.Free;
   end;
end;

procedure TfMatricular.sbMatriculaCursoSelCursoClick(Sender: TObject);
const
   mensagemCurso =
   'Deseja criar uma nova matricula para este aluno no mesmo curso?';
   mensagemAnoSemestre =
   'Você esta selecionando um ano/semestre diferente do atual, deseja continuar?';
var
   I, nr_anosemestre : Integer;
   resultado_filtro : TResultadoFiltroCurso;
begin
   if FAjuste then
   begin
      nr_anosemestre := FProximoAnoSem
   end
   else
   begin
      try
         // Busca o anosemestre para realizar as matrículas dos alunos que ficarão em reserva
         nr_anosemestre := StrToInt(DM.variavel_parametro('estuda_reserv_matric_anosem_atual'));

      except on E: Exception do
         // Caso não houver informado o sistema irá trabalhar com o anosemestre atual (tempo real)
         nr_anosemestre := dm.GetAnoSemestreAtual;
      end;
   end;
      
   resultado_filtro := TfrmSelecionarCurso.Filtrar([], -1, -1, nr_anosemestre);
   
   if ( resultado_filtro.filtrado ) and (resultado_filtro.cd_curso <> '') then
   begin

      cd_coligada := resultado_filtro.cd_coligada;

      I := tcMatriculaCurso.Tabs.IndexOf(resultado_filtro.cd_curso);

      //  Se for do mesmo curso, apresentar a mensagem e posiciona a aba no curso caso seja escolhido o não
      if (I <> -1) then
      begin
         if (MessageBox(Handle,PChar(mensagemCurso),PChar(Application.title),MB_ICONQUESTION+MB_YESNO) = mrNo) then
         begin

            if(qryMatriculaCurso.state = dsInsert) then
            begin
               qryMatriculaCurso.Cancel;
            end;

            // Tenta localizar primeiro com o ano/semestre e depois apenas o curso
            if not (qryMatriculaCurso.Locate('CD_CURSO;NR_ANOSEM_INGRESSO', VarArrayOf([resultado_filtro.cd_curso,resultado_filtro.nr_anosemestre]), [])) then
            begin
               qryMatriculaCurso.Locate('CD_CURSO', resultado_filtro.cd_curso, []);
            end;
            exit;
         end;
      end;

      if ((DM.UsaAnosemestre) AND (nr_anosemestre <> resultado_filtro.nr_anosemestre)) then
      begin
         if (MessageBox(Handle,PChar(mensagemAnoSemestre),PChar(Application.title),MB_ICONQUESTION+MB_YESNO) = mrNo) then
         begin
            exit;
         end;      
      end;

      //  Senão sai ou seja, é pra fazer a matricula no mesmo curso ou é uma matricula em outro curso
      qryMatriculaCursoCD_CURSO.AsString := resultado_filtro.cd_curso;
      qryMatriculaCursoCD_GRADE.Clear;
      qryGrade.Refresh;

      if DM.UsaAnosemestre then
      begin
         qryMatriculaCursoNR_ANOSEM_INGRESSO.AsInteger := resultado_filtro.nr_anosemestre;
      end
      else
      begin
         qryMatriculaCursoNR_ANOSEM_INGRESSO.AsInteger := 1;
      end;

      if qryMatriculaCursoCD_INGRESSO.AsInteger = 3 then
      begin
         qryMatriculaCursoNR_MATRICULA.AsString := DM.NovoCodMatricula(
            Pessoa,
            qryMatriculaCursoCD_CURSO.AsString,
            qryMatriculaCursoNR_ANOSEM_INGRESSO.AsInteger,
            DM.GetAnoSemestreAtual
         );
      end
      else
      begin
         qryMatriculaCursoNR_MATRICULA.AsString := DM.NovoCodMatricula(
            Pessoa,
            qryMatriculaCursoCD_CURSO.AsString,
            qryMatriculaCursoNR_ANOSEM_INGRESSO.AsInteger,
            qryMatriculaCursoNR_ANOSEM_INGRESSO.AsInteger
         );
      end;
   end;
end;

