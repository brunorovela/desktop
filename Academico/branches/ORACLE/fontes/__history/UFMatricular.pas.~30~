procedure TfMatricular.dbgBoletosDrawColumnCell(Sender: TObject;
  const Rect: TRect; DataCol: Integer; Column: TColumn; State: TGridDrawState);
const
   IsChecked: array [Boolean] of Integer =
      (DFCS_BUTTONCHECK, DFCS_BUTTONCHECK or DFCS_CHECKED);
var
   DrawRect: TRect;

   procedure DrawPrinterIcon;
   var
      Bmp: TBitmap;
   begin
      DrawRect := TCustomDrawGrid(Column.Grid).CellRect(Column.Index + 1, 0);
      TDBGrid(Column.Grid).Canvas.FillRect(DrawRect);
      DrawEdge(TDBGrid(Column.Grid).Canvas.Handle, DrawRect, BDR_RAISEDINNER, BF_FLAT);
      TDBGrid(Column.Grid).Canvas.Brush.Style := bsClear;

      Bmp := TBitmap.Create;
      try   
         Bmp.TransparentColor := clWhite;
         Bmp.TransparentMode := tmAuto;
         Bmp.Transparent := True;
         ilBoletos.GetBitmap(1, Bmp);

         DrawRect := Bounds(
            DrawRect.Left + (DrawRect.Right - DrawRect.Left - Bmp.Width) div 2,
            DrawRect.Top + (DrawRect.Bottom - DrawRect.Top - Bmp.Height) div 2,
            Bmp.Width, Bmp.Height);
         TDBGrid(Column.Grid).Canvas.FillRect(DrawRect);
         TDBGrid(Column.Grid).Canvas.Draw(DrawRect.Left, DrawRect.Top, Bmp);
      finally
         Bmp.Free;
      end;
   end;

begin
   if cdsBoletosSN_BAIXOU.AsBoolean then
   begin
      dbgBoletos.Canvas.Brush.Color := clAqua;
      dbgBoletos.Canvas.Font.Color := clWindowText;
   end;
   
   if Column.FieldName = 'SN_SELECIONADO' then
   begin
      DrawRect := Rect;
      InflateRect(DrawRect, -1, -1);
      dbgBoletos.Canvas.FillRect(Rect);
      DrawFrameControl(dbgBoletos.Canvas.Handle, DrawRect, DFC_BUTTON,
         IsChecked[Column.Field.AsBoolean]);
      DrawPrinterIcon;
   end
   else
      dbgBoletos.DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

