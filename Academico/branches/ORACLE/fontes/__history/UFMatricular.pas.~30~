procedure TfMatricular.sbMatriculaSelCursoClick(Sender: TObject);
const
   STitAtencao = 'Atenção';
   SMsgCursoDif = 'Você optou por realizar a matrícula em uma turma de curso diferente do curso de matrícula.'#13'Deseja realmente continuar?';
   mensagemAnoSemestre = 'Você esta selecionando um ano/semestre diferente do atual, deseja continuar?';

   SQLTurma = 'SELECT ' +
              '   T.ANOSEMESTRE NR_ANOSEMESTRE, '+
              '   T.CODIGO CD_TURMA, '+
              '   T.CURSO CD_CURSO, '+
              '   T.GRAU NR_GRAU, '+
              '   T.SERIE NR_SERIE, '+
              '   T.TURNO CD_TURNO, '+
              '   T.DESCRICAO DS_TURMA, '+
              '   T.VAGAS NR_VAGAS, '+
              '   T.SN_BLOQUEAR_VAGAS, '+
              '   T.CD_COLIGADA, '+
              '   T.CD_GRADE, '+
              '   T.CD_SITUACAO, '+
              '   T.CD_PLANO_PADRAO, '+
              '   CC.CD_DEPTO, '+
              '   S.DS_VALOR DS_SITUACAO, '+
              '   T.CD_CENTRO, '+
              '   T.CD_CAIXA, '+
              '   c.cd_coligada_matriz AS cd_coligada_matriz, '+
              '   NOW() as data_atual '+
              'FROM '+
              '   TURMAS T '+
              'INNER JOIN CURSOS_COLIGADAS CC ON ( '+
              '   T.CD_COLIGADA = CC.CD_COLIGADA AND '+
              '   T.CURSO = CC.CD_CURSO '+
              ') '+
              'INNER JOIN coligadas c ON ( '+
              '   c.cd_coligada = t.cd_coligada '+
              ') '+
              'LEFT JOIN SITUACOES S ON ( '+
              '   T.CD_SITUACAO = S.CD_SITUACAO AND '+
              '   S.CD_MODULO = 1148 '+
              ') '+
              'WHERE '+
              '   CC.SN_ATIVO = 1 AND '+
              '   CC.CD_CURSO = :CD_CURSO AND '+
              '   ( '+
              '      (T.ANOSEMESTRE = :NR_ANOSEMESTRE AND :SN_USA_ANOSEMESTRE) OR '+
              '      (NOT :SN_USA_ANOSEMESTRE) '+
              '    ) AND '+
              '   T.CD_COLIGADA IN (:CD_COLIGADA) AND '+
              '   T.SERIE <> -100 AND '+
              '   T.turno :cd_turno ';

var
   nr_anosemestre : Integer;
   resultado_filtro : TResultadoFiltroCurso;
   anoSemParam: String;
begin
   if FAjuste then
      nr_anosemestre := DM.GetNextAnoSemestre
   else
   begin
      nr_anosemestre := qryMatricula.FieldByName('NR_ANOSEMESTRE').AsInteger;
   end;

   resultado_filtro := TfrmSelecionarCurso.Filtrar([], -1, -1, nr_anosemestre);

   anoSemParam := DM.variavel_parametro('estuda_reserv_matric_anosem_atual');
   if((resultado_filtro.filtrado) AND (anoSemParam <> '') AND (strtoint(anoSemParam) <> resultado_filtro.nr_anosemestre)) then
   begin
      if (MessageBox(Handle,PChar(mensagemAnoSemestre),PChar(Application.title),MB_ICONQUESTION+MB_YESNO) = mrNo) then
      begin
         exit;
      end;
   end;

   if resultado_filtro.filtrado and (resultado_filtro.cd_curso <> '') then
   begin
      if qryMatriculaCD_CURSO.AsString <> resultado_filtro.cd_curso then
      begin
         if MessageBox(Handle, PChar(SMsgCursoDif), PChar(STitAtencao),
            MB_ICONQUESTION or MB_YESNO or MB_DEFBUTTON2) = ID_NO then
         begin
            exit;
         end;
      end;

      if (qryMatriculaCD_CURSO.AsString <> resultado_filtro.cd_curso) OR
         (resultado_filtro.nr_anosemestre <> qryMatriculaNR_ANOSEMESTRE.AsInteger) OR
         (resultado_filtro.cd_coligada <> cdColigadaBuscadaEtapa) then
      begin
         qryMatriculaCD_CURSO.AsString := resultado_filtro.cd_curso;
         qryMatriculaNR_ANOSEMESTRE.AsInteger := resultado_filtro.nr_anosemestre;
         qryTurma.Close;

         qryTurma.SQL.Text := SQLTurma;

         cdColigadaBuscadaEtapa := resultado_filtro.cd_coligada;
         qryTurma.ParamByName('SN_USA_ANOSEMESTRE').AsInteger := Ord(DM.UsaAnosemestre);

         if cdColigadaBuscadaEtapa <> 0 then
         begin
            qryTurma.ParamByName('cd_coligada').AsInteger := cdColigadaBuscadaEtapa;
         end else begin
            qryTurma.SQL.Text := ReplaceStr(qryTurma.SQL.Text, ':CD_COLIGADA', DM.GetColigadas);
         end;

         if DM.variavel_parametro('sn_logica_matricula', false) <> 'S' then
         begin
            // Inicia a série como um se não houver última turma ou caso for matrícula em um novo curso
            if qryUltimaSerie.IsEmpty OR (Length(RematriculaNovoCurso) > 0) then
            begin
               qryTurma.Filter := 'NR_SERIE = 1';
            end
            else
            begin
               qryTurma.Filter := Format('NR_SERIE = %d',
                  [qryUltimaSerieNR_SERIE.AsInteger + 1]
               );
            end;
         end
         else
         begin
            // Aqui o sistema trabalha conforme lógica específica do cliente ISPTEC
            qryTurma.SQL.Add(' ORDER BY T.SERIE DESC, (CASE WHEN t.turno = :turno THEN 1 ELSE 0 END) DESC');
            qryTurma.ParamByName('turno').AsString := qryMatriculaCursoCD_TURNO.AsString;
         end;

         //Filtra etapa
         if chkSoProxEtapa.Checked = True then
         begin
            qryTurma.SQL.Text := StringReplace(qryTurma.SQL.Text, ':cd_turno', ' = ''' + qryMatriculaCursoCD_TURNO.AsString + '''', [rfReplaceAll]);
         end
         else
         begin
            qryTurma.SQL.Text := StringReplace(qryTurma.SQL.Text, ':cd_turno', ' <>  "z"', [rfReplaceAll]);
         end;

         VerificaQtdReprovadasIsptec;
         qryTurma.Open;
      end;
   end;
end;

