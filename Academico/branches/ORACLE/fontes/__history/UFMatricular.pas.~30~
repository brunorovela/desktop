      qryDisciplinasDisp.ParamByName('CD_PESSOA').AsInteger := Pessoa;
      qryDisciplinasDisp.ParamByName('NR_ANOSEMESTRE').AsInteger :=
         qryMatriculaNR_ANOSEMESTRE.AsInteger;
      qryDisciplinasDisp.ParamByName('SN_USA_ANOSEMESTRE').AsInteger :=
         Ord(DM.UsaAnosemestre);
      qryDisciplinasDisp.ParamByName('CURSO').AsString := resultado_filtro.cd_curso;
      qryDisciplinasDisp.SQL.Text := ReplaceStr (qryDisciplinasDisp.SQL.Text, ':CD_COLIGADA', DM.GetColigadas);
      qryDisciplinasDisp.SQL.Text := ReplaceStr (qryDisciplinasDisp.SQL.Text, ':DISCIPLINAS_SELECIONADAS', GetStrTurmasDiscSelecionadas);
      qryDisciplinasDisp.ParamByName('SN_MOSTRA_DISCIPLINAS_HORARIOS').AsString :=
         DM.variavel_parametro('sn_mostra_disciplinas_horarios');
      qryDisciplinasDisp.Open;

      edtDiscDispTurma.Text := resultado_filtro.cd_turma;

      qryDisciplinasDisp.Filter := Format(SFiltroDisc, [
         QuotedStr(resultado_filtro.cd_turma)
      ]);

      LoadDisciplinasDispOnDataSet;
      LoadDisciplinasDispOnTreeView;
   end;

   cdsDisciplinas.Locate('SN_SELECIONADA', True, []);
end;

procedure TfMatricular.checaConflitoHorario(nodeSelecionado: TTreeNode; removerConflitoHorario: Boolean);
var
  condicao: String;
  possuiConflito: Boolean;
  i, nr_restricao: Integer;
  node: TTreeNode;
  qyChecarHorarios: TUMZQuery;
begin

   if cdsDisciplinas.BookmarkValid(nodeSelecionado.Data) then
   begin

      // Posiciona o registro de disciplinas no nodo selecionado
      cdsDisciplinas.GotoBookmark(nodeSelecionado.Data);

      // Busca os horários que se encontram em conflito (das disciplinase selecionadas) com a disciplina passada
      qyChecarHorarios := getHorariosConflito(qryMatriculaNR_ANOSEMESTRE.AsInteger, cdsDisciplinasCD_TURMA.AsString, cdsDisciplinasCD_DISCIPLINA.AsInteger);

      // Se houve algum conflito de horário
      if not qyChecarHorarios.Eof then
      begin

         node := tvDisciplinasSel.Items.GetFirstNode;
         while node <> nil do
         begin
            // Verifica se é uma disiciplina Optativa genérica e possui apenas 1 optativa para ser escolhida
            if (not node.HasChildren) and (cdsDisciplinas.BookmarkValid(node.Data)) then
            begin
               // Posiciona na disciplina do nodo que está varrendo para pegar os dados da mesma
               cdsDisciplinas.GotoBookmark(node.Data);

               // Verifica se o nodo que está varrendo está em conflito de horário
               if qyChecarHorarios.Locate('turma;disciplina', VarArrayOf([cdsDisciplinasCD_TURMA.AsString, cdsDisciplinasCD_DISCIPLINA.AsInteger]), [loCaseInsensitive]) then
               begin

                  // Verifica se deve remover o Conflito de Horario das disciplinas envolvidas ou deve adicionar o mesmo
                  nr_restricao := 0;
                  if removerConflitoHorario then
                  begin
                     // Caso for para remover o conflito de horário de uma disciplina, primeiro verifica se ela não está em conflito com nenhuma outra
                     // A verificação é "nrConflitos > 1" pois o primeiro conflito é a disciplina que está sendo testada a qual ainda não foi retirado o conflito
                     possuiConflito := (getHorariosConflito(qryMatriculaNR_ANOSEMESTRE.AsInteger, cdsDisciplinasCD_TURMA.AsString, cdsDisciplinasCD_DISCIPLINA.AsInteger).RecordCount > 1);

                     // Posiciona na disciplina do nodo que está varrendo para pegar os dados da mesma
                     cdsDisciplinas.GotoBookmark(node.Data);

                     if ((cdsDisciplinasNR_RESTRICAO.AsInteger and 64) = 64) and (not possuiConflito) then nr_restricao := -64; // remover o conflito de horario
                  end else begin

                     // adicionar o conflito de horario (caso já não houver o mesmo)
                     if ((cdsDisciplinasNR_RESTRICAO.AsInteger and 64) <> 64) then nr_restricao := 64;
                  end;

                  // Verifica se houve alteração na restrição
                  if nr_restricao <> 0 then
                  begin
                     // Define a restrição para as disciplinas que já estavam selecionadas
                     cdsDisciplinas.Edit;
                     cdsDisciplinasNR_RESTRICAO.AsInteger := cdsDisciplinasNR_RESTRICAO.AsInteger + nr_restricao;
                     cdsDisciplinas.Post;

                     // Define a imagem de impedimento para o nodo selecionado
                     if cdsDisciplinasSN_OBRIGATORIO.AsBoolean then
                     begin
                        node.ImageIndex := 10;
                     end
                     else
                     begin
                        node.ImageIndex := GetImageIndex(cdsDisciplinasNR_RESTRICAO.AsInteger);
                     end;
                     node.SelectedIndex := node.ImageIndex;
                     node.Data := cdsDisciplinas.GetBookmark;
                  end;

               end;
            end;

            node := node.GetNext;
         end;

         // Define conflito de horário na disciplina que será selecionada
         if cdsDisciplinas.BookmarkValid(nodeSelecionado.Data) then
         begin
            // Posiciona na disciplina do nodo que está varrendo para pegar os dados da mesma
            cdsDisciplinas.GotoBookmark(nodeSelecionado.Data);

            // Verifica se deve remover o Conflito de Horario das disciplinas envolvidas ou deve adicionar o mesmo
            nr_restricao := 0;
            if removerConflitoHorario then
            begin
               if (cdsDisciplinasNR_RESTRICAO.AsInteger and 64) = 64 then nr_restricao := -64; // remover o conflito de horario
            end else begin
               nr_restricao := 64; // adicionar o conflito de horario
            end;

            // Define a restrição para a disciplina que está sendo selecionada
            cdsDisciplinas.Edit;
            cdsDisciplinasNR_RESTRICAO.AsInteger := cdsDisciplinasNR_RESTRICAO.AsInteger + nr_restricao;
            cdsDisciplinas.Post;

            // Define a imagem de impedimento para o nodo selecionado
            nodeSelecionado.ImageIndex := GetImageIndex(cdsDisciplinasNR_RESTRICAO.AsInteger);
            nodeSelecionado.SelectedIndex := nodeSelecionado.ImageIndex;
            nodeSelecionado.Data := cdsDisciplinas.GetBookmark;
         end;

      end;

   end;

end;

function TfMatricular.getHorariosConflito(anoSemestre: Integer; cdTurma: String; cdDisciplina: Integer): TUMZQuery;
var
   condicao: String;
   qyChecarHorarios: TUMZQuery;
   listaCondicoesTurmasDiscSelecionadas: TStringList;   
begin
   // Cria consulta para checar conflito de horarios
   DM.CriarConsulta( qyChecarHorarios );

   // Inicializa a lista de condição
   listaCondicoesTurmasDiscSelecionadas := TStringList.Create;

   // Varre a lista de disciplinas para pegar as selecionadas
   cdsDisciplinas.First;
   while not cdsDisciplinas.Eof do
   begin

      // Verifica se a disciplina não está selecionada
      if cdsDisciplinasSN_SELECIONADA.AsBoolean then
      begin
        // Define a condicao
        condicao := '('+qryMatriculaNR_ANOSEMESTRE.AsString+', "'+cdsDisciplinasCD_TURMA.AsString+'", '+cdsDisciplinasCD_DISCIPLINA.AsString+')';

        // Adiciona a condicao de turmas disciplinas que estão selecionadas
        listaCondicoesTurmasDiscSelecionadas.Add(condicao);
      end;

      cdsDisciplinas.Next;
   end;

   // Define o separador das condicoes na lista
   listaCondicoesTurmasDiscSelecionadas.Delimiter := ',';
   listaCondicoesTurmasDiscSelecionadas.QuoteChar := ' ';

   // Prepara o SQL que será executado
   qyChecarHorarios.SQL.Text := qryCheckConflitoHorario.SQL.Text;

   // Prepara SQL para checar se houve conflito de horário
   qyChecarHorarios.Close;

   // Seta as condicoes do SQL
   qyChecarHorarios.ParamByName('NR_ANOSEMESTRE').AsInteger := anoSemestre;
   qyChecarHorarios.ParamByName('CD_TURMA').AsString := cdTurma;
   qyChecarHorarios.ParamByName('CD_DISCIPLINA').AsInteger := cdDisciplina;

   if listaCondicoesTurmasDiscSelecionadas.Count > 0 then
   begin
      // Seta a condição da lista de disciplinas selecionadas
      qyChecarHorarios.SQL.Text := StringReplace(qyChecarHorarios.SQL.Text, ':TURMAS_DISC_SELECIONADAS', listaCondicoesTurmasDiscSelecionadas.DelimitedText, [rfReplaceAll, rfIgnoreCase]);
   end else begin
      // Seta a condição da lista de disciplinas selecionadas
      qyChecarHorarios.SQL.Text := StringReplace(qyChecarHorarios.SQL.Text, ':TURMAS_DISC_SELECIONADAS', '(-1, "-1", -1)', [rfReplaceAll, rfIgnoreCase]);
   end;

   // Busca se houve conflito em algum horário
   qyChecarHorarios.Open;

   Result := qyChecarHorarios;
end;

procedure TfMatricular.sbDiscSelClick(Sender: TObject);
const
   SMsgRestricoesSemPermissao = 'A disciplina [%s] possui um ou mais impedimentos e, portanto, o aluno não pode ser matriculado.'#13'Impedimentos:'#13'%s';
   SMsgRestricoesComPermissao = 'A disciplina [%s] possui um ou mais impedimentos. Deseja realizar a matrícula mesmo assim?'#13'Impedimentos:'#13'%s';
   SMsgNaoPossivelIncluirOptativa = 'Não é possível adicionar mais de uma optativa na disciplina [%s] da turma [%s].'#13'Primeiro remova a optativa já existente.';
   SMsgOptativaJaSeleciona = 'Não é possível adicionar duas vezes a mesma optativa, a [%s] já foi adicionada.'#13'Selecione outra optativa.';
   SMsgGenericaJaSelecionaSemPermissao = 'Não é possível adicionar duas vezes a mesma disciplina genérica, a [%s] já foi utilizada para outra optativa.';
   SMsgGenericaJaSelecionaComPermissao = 'A disciplina genérica [%s] já foi utilizada para outra optativa.'#13'Deseja utilizar essa disciplina genérica mesmo assim?';
   SMsgGenericaJaCursadaSemPermissao = 'A disciplina genérica [%s] que se está tentando matricular já foi utilizada para matricula de outra disciplina optativa.';
   SMsgGenericaJaCursadaComPermissao = 'A disciplina genérica [%s] que se está tentando matricular já foi utilizada para matricula de outra disciplina optativa.'#13'Deseja utilizar essa disciplina genérica mesmo assim?';
   MsgQuestFlags = MB_ICONQUESTION or MB_YESNO or MB_DEFBUTTON2;
var
   I, MsgResult: Integer;
   Node, NodeCurso, NodeDisc, OldParent: TTreeNode;
   NodeList: TList;
   ConfirmaTodos, CancelaTodos, TemPermissao: Boolean;
begin
   NodeList := TList.Create;
   try
      if tvDisciplinasDisp.Selected = nil then Abort;
      
      if tvDisciplinasDisp.Selected.ImageIndex = 1 then
      begin
         Node := tvDisciplinasDisp.Selected.getFirstChild;
         while Node <> nil do
         begin
            // Verifica se é uma disiciplina Optativa genérica e possui apenas 1 optativa para ser escolhida
            if Node.Count = 1 then
            begin
               // Adiciona a disciplina optativa
               NodeList.Add(Node.getFirstChild);
            end else
            begin
               NodeList.Add(Node);
            end;
            Node := Node.getNextSibling;
         end;
      end
      else
         for I := 0 to tvDisciplinasDisp.SelectionCount - 1 do
         begin
            NodeList.Add(tvDisciplinasDisp.Selections[I]);
         end;
      
      tvDisciplinasDisp.ClearSelection(False);
      tvDisciplinasSel.Items.BeginUpdate;
      tvDisciplinasDisp.Items.BeginUpdate;

      ConfirmaTodos := False;
      CancelaTodos := False;
      TemPermissao := DM.UsuarioLogado.TemPermissao(1019, npEspecial, False);

      // Apaga o nodo sem disciplina antes de adicionar qualquer disciplina
      checaRemoverNodoSemDisciplina;

      for I := 0 to NodeList.Count - 1 do
      begin
         if TTreeNode(NodeList.Items[I]).Data <> nil then
         begin
            if cdsDisciplinas.BookmarkValid(TTreeNode(NodeList.Items[I]).Data) then
            begin
               // Checa se a disciplina que está sendo inserida está em conflito de horário com outra disciplina já selecionada
               checaConflitoHorario(TTreeNode(NodeList.Items[I]), False);

               cdsDisciplinas.GotoBookmark(TTreeNode(NodeList.Items[I]).Data);
               
               if (cdsDisciplinasNR_RESTRICAO.AsInteger > 0) and
                  (not ConfirmaTodos) then
               begin
                  if CancelaTodos then
                  begin
                     // Remove os conflitos de horário entre disciplinas selecionadas
                     checaConflitoHorario(TTreeNode(NodeList.Items[I]), True);
                     Continue;
                  end
                  else
                     if not TemPermissao then
                     begin
                        // Remove os conflitos de horário entre disciplinas selecionadas
                        checaConflitoHorario(TTreeNode(NodeList.Items[I]), True);

                        if MessageDlg(Format(SMsgRestricoesSemPermissao,
                              [cdsDisciplinasNM_DISCIPLINA.AsString, GetImpedimentos(cdsDisciplinasNR_RESTRICAO.AsInteger)]),
                               mtConfirmation, [mbOK, mbAbort], -1, mbOK) = mrAbort
                        then
                           Break
                        else
                           Continue;
                     end
                  else
                  begin
                     MsgResult := MessageDlg(Format(SMsgRestricoesComPermissao,
                        [cdsDisciplinasNM_DISCIPLINA.AsString, GetImpedimentos(cdsDisciplinasNR_RESTRICAO.AsInteger)]), mtConfirmation,
                        [mbYes, mbYesToAll, mbNo, mbNoToAll], -1, mbNo);
                     
                     ConfirmaTodos := MsgResult = mrYesToAll;
                     CancelaTodos := MsgResult = mrNoToAll;

                     if MsgResult in [mrNo, mrNoToAll] then
                     begin
                        // Remove os conflitos de horário entre disciplinas selecionadas
                        checaConflitoHorario(TTreeNode(NodeList.Items[I]), True);
                        Continue;
                     end;
                  end;
               end;

               NodeCurso := FindNode(tvDisciplinasSel, nil, cdsDisciplinasCD_CURSO.AsString);
               NodeCurso.ImageIndex := 0;
               NodeCurso.SelectedIndex := 0;

               Node := FindNode(tvDisciplinasSel, NodeCurso, cdsDisciplinasCD_TURMA.AsString);
               Node.ImageIndex := 1;
               Node.SelectedIndex := 1;

               DM.setLog(1009, 'Inclusão', qryMatriculaCursoCD_PESSOA.AsString + ';' + cdsDisciplinasCD_CURSO.AsString + ';' + cdsDisciplinasCD_DISCIPLINA.AsString,
                         Dm.getColigadaByTurma(cdsDisciplinasCD_TURMA.AsString,qryMatriculaNR_ANOSEMESTRE.AsInteger), 'Matrícula Desktop - incluiu disciplina: ' + cdsDisciplinasNM_DISCIPLINA.AsString);

               // Verifica se a disciplina inserida é OPTATIVA
               if not cdsDisciplinasCD_DISCIPLINA_GENERICA.IsNull then
               begin
                  // Verifica se na turma essa disciplina já foi incluída
                  // Pode ter sido incluida em outra disciplina genérica ou em outra turma
                  if verificaOptativaJahAdicionada(NodeCurso, cdsDisciplinasNM_DISCIPLINA.AsString) then
                  begin
                     // Verifica se a turma adiciona possui alguma disciplina filha, caso não então
                     // Deleta a turma que já foi adicionada, pois a optativa não pode ser selecionada
                     if not Node.HasChildren then
                     begin
                        Node.Delete;
                     end;                                       

                     // Exibe a mesagem de disiciplina já selecionada
                     MessageDlg(Format(SMsgOptativaJaSeleciona, [cdsDisciplinasNM_DISCIPLINA.AsString]),
                                mtInformation, [mbOK], -1, mbOK);
                     Continue;
                  end; 

                  // Verifica se a disciplina Genérica já foi adicionada,
                  // não permite utilizar uma mesma disciplina genérica para
                  // duas optativas diferentes na mesma etapa
                  if verificaGenericaJahAdicionada(NodeCurso, cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString) then
                  begin
                     if not TemPermissao then
                     begin
                        // Exibe a mesagem de disiciplina genérica já selecionada
                        MessageDlg(Format(SMsgGenericaJaSelecionaSemPermissao, [cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString]),
                                   mtInformation, [mbOK], -1, mbOK);

                        MsgResult := mrNo;
                     end else begin
                        MsgResult := MessageDlg(Format(SMsgGenericaJaSelecionaComPermissao, [cdsDisciplinasNM_DISCIPLINA.AsString]),
                                   mtConfirmation, [mbYes, mbNo], -1, mbNo);
                     end;

                     if MsgResult in [mrNo] then
                     begin
                        // Verifica se a turma adiciona possui alguma disciplina filha, caso não então
                        // Deleta a turma que já foi adicionada, pois a optativa não pode ser selecionada
                        if not Node.HasChildren then
                        begin
                           Node.Delete;
                        end;
                        
                        Continue;
                     end;    
                  end;

                  // Verifica se a disciplina genérica já foi cursada em outro momento
                  // não permite utilizar uma disciplina genérica que já foi cursada
                  // e aprovada anteiormente ou que está sendo cursada pelo aluno
                  if qryGenericasCursadas.Locate('cd_curso;nr_serie;cd_disciplina_generica', VarArrayOf([cdsDisciplinasCD_CURSO.AsString,cdsDisciplinasNR_ETAPA.AsInteger,cdsDisciplinasCD_DISCIPLINA_GENERICA.AsInteger]), []) then
                  begin
                     if not TemPermissao then
                     begin
                        // Exibe a mesagem de disiciplina genérica já cursada
                        MessageDlg(Format(SMsgGenericaJaCursadaSemPermissao, [cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString]),
                                   mtInformation, [mbOK], -1, mbOK);
                                   
                        MsgResult := mrNo;
                     end else begin
                        MsgResult := MessageDlg(Format(SMsgGenericaJaCursadaComPermissao, [cdsDisciplinasNM_DISCIPLINA.AsString]),
                                   mtConfirmation, [mbYes, mbNo], -1, mbNo);
                     end;
                     
                     if MsgResult in [mrNo] then
                     begin
                        // Verifica se a turma adiciona possui alguma disciplina filha, caso não então
                        // Deleta a turma que já foi adicionada, pois a optativa não pode ser selecionada
                        if not Node.HasChildren then
                        begin
                           Node.Delete;
                        end;
                        
                        Continue;
                     end;
                  end;

                  // Insere/Procura o nodo da disciplina GENÉRICA
                  Node := FindNode(tvDisciplinasSel, Node, cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString);
                  Node.ImageIndex := 3;
                  Node.SelectedIndex := 3;

                  // Verifica se a disciplina Genérica já possui filhos, ou seja,
                  // Ja existe uma disciplina optativa para a genérica selecionada,
                  // nesse caso não adiciona a disciplina 
                  if Node.HasChildren then
                  begin
                     MessageDlg(Format(SMsgNaoPossivelIncluirOptativa, [cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString, cdsDisciplinasCD_TURMA.AsString]),
                                mtInformation, [mbOK], -1, mbOK);
                     Continue;
                  end;

               end;

               cdsDisciplinas.Edit;
               cdsDisciplinasSN_SELECIONADA.AsBoolean := True;
               cdsDisciplinas.Post;

               OldParent := TTreeNode(NodeList.Items[I]).Parent;
               TTreeNode(NodeList.Items[I]).MoveTo(Node, naAddChild);
               TTreeNode(NodeList.Items[I]).Data := cdsDisciplinas.GetBookmark;
               DeleteOldParents(OldParent);
            end;
         end;
      end;

      // Se não ficou nenhum nodo para ser selecionado, cria um nodo padrão dizendo que não existem nodos selecionados
      checaAddNodoSemDisciplina;

      cdsDisciplinas.Locate('SN_SELECIONADA', True, []);
      tvDisciplinasSel.Items.EndUpdate;
      tvDisciplinasDisp.Items.EndUpdate;
   finally
      NodeList.Free;
   end;
end;

function TfMatricular.verificaGenericaJahAdicionada(nodoCurso: TTreeNode; disciplina: String): Boolean;
var
   nodoTurma, nodoDisc: TTreeNode;
begin
   Result := False;

   if nodoCurso <> nil then
   begin
      // Pega a primeira turma do curso
      nodoTurma := nodoCurso.getFirstChild;

      // Varre as turmas do curso
      while nodoTurma <> nil do
      begin
         // Pega a primeira discipina da turma   
         nodoDisc := nodoTurma.getFirstChild;

         // Varre as disciplinas da turma
         while nodoDisc <> nil do
         begin
            // Verifica se a disciplina da turma possui filhos (Disciplina Genérica com Optativas)
            if nodoDisc.HasChildren then
            begin
               // Verifica se a disciplina que está adicionando já foi adicionada
               if nodoDisc.Text = disciplina then
               begin
                  // Disciplina genérica já adicionada
                  Result := True;
                  Exit;
               end;
            end;

            nodoDisc := nodoDisc.getNextSibling;
         end;

         nodoTurma := nodoTurma.getNextSibling;
      end;

   end;

end;

function TfMatricular.verificaOptativaJahAdicionada(nodoCurso: TTreeNode; disciplina: String): Boolean;
var
   nodoTurma, nodoDisc, nodoDiscOptativa: TTreeNode;
begin
   Result := False;

   if nodoCurso <> nil then
   begin
      // Pega a primeira turma do curso
      nodoTurma := nodoCurso.getFirstChild;

      // Varre as turmas do curso
      while nodoTurma <> nil do
      begin
         // Pega a primeira discipina da turma   
         nodoDisc := nodoTurma.getFirstChild;

         // Varre as disciplinas da turma
         while nodoDisc <> nil do
         begin
            // Verifica se a disciplina da turma possui filhos (Disciplina Genérica com Optativas)
            if nodoDisc.HasChildren then
            begin
               // Pega as disciplinas optativas da disciplina genérica
               nodoDiscOptativa := nodoDisc.getFirstChild;
               // Varre as disciplinas optativas
               while nodoDiscOptativa <> nil do
               begin
                  // Verifica se a disciplina que está adicionando já foi adicionada
                  if nodoDiscOptativa.Text = disciplina then
                  begin
                     // Disciplina já adicionada
                     Result := True;
                     Exit;
                  end;
                  nodoDiscOptativa := nodoDiscOptativa.getNextSibling;
               end;
            end;

            nodoDisc := nodoDisc.getNextSibling;
         end;

         nodoTurma := nodoTurma.getNextSibling;
      end;

   end;

end;

procedure TfMatricular.VerificaQtdReprovadasIsptec;
const
  SQL_GET_SERIE_ESTUDANTE = 'SELECT GET_SERIE_ESTUDANTE(:cd_pessoa, :cd_curso, :nr_serie, :nr_anosemestre) nr_serie_estudante';
var
   nrSerie : String;
   qrySerieEstudante : TUMZQuery;
begin

   if DM.variavel_parametro('sn_logica_matricula', false) <> 'S' then
   begin
      exit;
   end;

   //qtdLimiteDisciplinasReprovadas := GetQtdLimiteDisciplinasPendentes();

   //Inicia com base na ultima turma do aluno
   nrSerie := IntToStr(qryUltimaSerieNR_SERIE.AsInteger + 1);

   //Se for pra trocar de ano mas o aluno não pode transitar buscamos a série reprovada
   //(onde ele ira cursar novamente), senão mantemos a serie da turma + 1
   if isTrocaAno(qryMatriculaNR_ANOSEMESTRE.AsString) then
   begin
      //Verificamos se o aluno pode transitar
      if ( not alunoPodeTransitarFuncao()) then
      begin
         qyBuscaSerieReprovadas.Close;
         qyBuscaSerieReprovadas.ParamByName('codaluno').AsInteger :=
            qryMatriculaCD_PESSOA.AsInteger;
         qyBuscaSerieReprovadas.ParamByName('anosemestre').AsInteger :=
            qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qyBuscaSerieReprovadas.ParamByName('curso').AsString :=
            qryMatriculaCD_CURSO.AsString;

         qyBuscaSerieReprovadas.Open;
         
         nrSerie := qyBuscaSerieReprovadas.FieldByName('serie').AsString;
      end;
   end;

   chkSoProxEtapa.OnClick := nil;
   chkSoProxEtapa.Checked := False;
   chkSoProxEtapa.OnClick := chkSoProxEtapaClick;
   chkSoProxEtapa.Visible := False;

   DM.CriarConsulta(qrySerieEstudante);
   qrySerieEstudante.SQL.Add(SQL_GET_SERIE_ESTUDANTE);
   qrySerieEstudante.ParamByName('cd_pessoa').AsString := qryMatriculaCD_PESSOA.AsString;
   qrySerieEstudante.ParamByName('cd_curso').AsString := qryMatriculaCD_CURSO.AsString;
   qrySerieEstudante.ParamByName('nr_serie').AsInteger := StrToInt(nrSerie);
   qrySerieEstudante.ParamByName('nr_anosemestre').AsInteger := qryUltimoAnoSemNR_ANOSEMESTRE.AsInteger;
   qrySerieEstudante.Open;

