procedure TfMatricular.sbDiscDesClick(Sender: TObject);
var
   I: Integer;
   Node, OldParent, NodeDisc: TTreeNode;
   NodeList: TList;
begin
   NodeList := TList.Create;
   try
      if tvDisciplinasSel.Selected = nil then Abort;

      if tvDisciplinasSel.Selected.ImageIndex = 1 then
      begin
         Node := tvDisciplinasSel.Selected.getFirstChild;
         while Node <> nil do
         begin
            // verifica se é uma optativa genérica
            if Node.HasChildren then
            begin
               NodeDisc := Node.getFirstChild;
               while NodeDisc <> nil do
               begin
                  // Adiciona todas as disciplinas optativas da optativa genérica
                  NodeList.Add(NodeDisc);
                  NodeDisc := NodeDisc.getNextSibling;
               end;
            end;
            
            NodeList.Add(Node);
            Node := Node.getNextSibling;
         end;
      end
      else
         for I := 0 to tvDisciplinasSel.SelectionCount - 1 do
         begin
            NodeList.Add(tvDisciplinasSel.Selections[I]);
         end;
      
      tvDisciplinasSel.ClearSelection(False);
      tvDisciplinasSel.Items.BeginUpdate;
      tvDisciplinasDisp.Items.BeginUpdate;

      // Apaga o nodo sem disciplina antes de adicionar qualquer disciplina
      checaRemoverNodoSemDisciplina;

      for I := 0 to NodeList.Count - 1 do
      begin
         if TTreeNode(NodeList.Items[I]).Data <> nil then
         begin
            if cdsDisciplinas.BookmarkValid(TTreeNode(NodeList.Items[I]).Data) then
            begin
               // Remove os conflitos de horário entre disciplinas selecionadas
               checaConflitoHorario(TTreeNode(NodeList.Items[I]), True);

               cdsDisciplinas.GotoBookmark(TTreeNode(NodeList.Items[I]).Data);

               Node := FindNode(tvDisciplinasDisp, nil, cdsDisciplinasCD_CURSO.AsString);
               Node.ImageIndex := 0;
               Node.SelectedIndex := 0;

               Node := FindNode(tvDisciplinasDisp, Node, cdsDisciplinasCD_TURMA.AsString);
               Node.ImageIndex := 1;
               Node.SelectedIndex := 1;

               DM.setLog(1009, 'Exclusão', qryMatriculaCursoCD_PESSOA.AsString + ';' + cdsDisciplinasCD_CURSO.AsString + ';' + cdsDisciplinasCD_DISCIPLINA.AsString,
                        Dm.getColigadaByTurma(cdsDisciplinasCD_TURMA.AsString,qryMatriculaNR_ANOSEMESTRE.AsInteger), 'Matrícula Desktop - retirou disciplina: ' + cdsDisciplinasNM_DISCIPLINA.AsString);

               // Verifica se a disciplina inserida é OPTATIVA
               if not cdsDisciplinasCD_DISCIPLINA_GENERICA.IsNull then
               begin
                  // Insere/Procura o nodo da disciplina GENÉRICA
                  Node := FindNode(tvDisciplinasDisp, Node, cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString);
                  Node.ImageIndex := 2;
                  Node.SelectedIndex := 2;
               end;

               cdsDisciplinas.Edit;
               cdsDisciplinasSN_SELECIONADA.AsBoolean := False;
               cdsDisciplinas.Post;

               OldParent := TTreeNode(NodeList.Items[I]).Parent;
               TTreeNode(NodeList.Items[I]).MoveTo(Node, naAddChild);
               TTreeNode(NodeList.Items[I]).Data := cdsDisciplinas.GetBookmark;
               DeleteOldParents(OldParent);
            end;
         end;
      end;

      // Se não ficou nenhum nodo para ser selecionado, cria um nodo padrão dizendo que não existem nodos selecionados
      checaAddNodoSemDisciplina;

      cdsDisciplinas.Locate('SN_SELECIONADA', True, []);
      tvDisciplinasSel.Items.EndUpdate;
      tvDisciplinasDisp.Items.EndUpdate;
   finally
      NodeList.Free;
   end;
end;

procedure TfMatricular.checaAddNodoSemDisciplina;
begin
   { O nodo padrão sem disciplinas selecionadas é criado para evitar um problema interno
     do componente TTreeView, o problema que acontece quando usamos o metodo MoveTo da para mover o nodo da TreeView
     para outro local, deixando a TreeView sem nenhum nodo que possa ser selecioando, assim quando é selecionado
     algum outro nodo o componente tenta internamente selecionar o nodo que foi movido na antiga TreeView gerando o erro }

   // Se não ficou nenhum nodo para ser selecionado na treeview de Selecionados,
   // cria um nodo padrão dizendo que não existem nodos selecionados
   if tvDisciplinasSel.Items.Count = 0 then
   begin
      tvDisciplinasSel.Items.Add(tvDisciplinasSel.TopItem, 'Nenhuma disciplina selecionada');
   end;

   // Se não ficou nenhum nodo para ser selecionado na treeview de Selecionados,
   // cria um nodo padrão dizendo que não existem nodos selecionados
   if tvDisciplinasDisp.Items.Count = 0 then
   begin
      tvDisciplinasDisp.Items.Add(tvDisciplinasDisp.TopItem, 'Nenhuma disciplina selecionada');
   end;

end;

procedure TfMatricular.checaRemoverNodoSemDisciplina;
begin
   // Caso a TreeView somente possua o nodo sem disciplinas
   // quando for adicionada uma nova disciplina nela, deve-se remover o nodo de nenhuma disciplina selecionada antes

   // Se somente existe 1 nodo na treeview, significa que é o nodo de Nenhuma disciplina selecionada, então remove ele
   if tvDisciplinasSel.Items.Count = 1 then
   begin
      tvDisciplinasSel.TopItem.Delete;
   end;

   // Se somente existe 1 nodo na treeview, significa que é o nodo de Nenhuma disciplina selecionada, então remove ele
   if tvDisciplinasDisp.Items.Count = 1 then
   begin
      tvDisciplinasDisp.TopItem.Delete;
   end;

end;

