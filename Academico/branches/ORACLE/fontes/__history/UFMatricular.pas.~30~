procedure TfMatricular.GeraMensalidadesAfrica;
var
   S: string;
   Hoje: TDate;
   Situacao, AcaoGerarMens, AcaoDesconto,
   AcaoDescontoPadrao, AcaoDescontoCondicionalPadrao: Integer;
   AlunoSelBoleto: Boolean;
   Movimento: TMovimento;
   qyAtualizarMensalidadeOrigem: TUMZQuery;
begin
   Hoje := DM.DataAtual;
   AlunoSelBoleto :=
      DM.variavel_parametro('financeiro_boleto_escolha_aluno') = 'S';

   S := DM.variavel_parametro('matriculas_situacao_padrao');
   Situacao := StrToIntDef(S, 2);

   Dm.CriarConsulta(qyAtualizarMensalidadeOrigem);

   qyAtualizarMensalidadeOrigem.Close;
   qyAtualizarMensalidadeOrigem.SQL.Text :=
      ' UPDATE '+
      '     mensalidades '+
      ' SET '+
      '     cd_mensalidade_origem = cd_mensalidade '+
      ' WHERE '+
      '     cd_mensalidade = :cd_mensalidade ';

   AcaoGerarMens := DM.BuscarCodigoAcaoPadrao(1);
   AcaoDescontoPadrao := DM.BuscarCodigoAcaoPadrao(11);
   AcaoDescontoCondicionalPadrao := DM.BuscarCodigoAcaoPadrao(24);

   if not qryDepto.Active then
   begin
      qryDepto.Open;
   end;

   if qryMensalidadeAfrica.Active then
   begin
      qryMensalidadeAfrica.Close;
   end;
   qryMensalidadeAfrica.ParamByName('CD_PESSOA').AsInteger := Pessoa;
   qryMensalidadeAfrica.ParamByName('NR_ANOSEMESTRE').AsInteger :=
      qryMatriculaNR_ANOSEMESTRE.AsInteger;
   qryMensalidadeAfrica.ParamByName('CD_TURMA').AsString :=
      qryMatriculaCD_TURMA.AsString;
   qryMensalidadeAfrica.ParamByName('CD_CURSO').AsString :=
      qryMatriculaCD_CURSO.AsString;
   qryMensalidadeAfrica.Open;

   cdsMensalidades.DisableControls;
   cdsMensalidades.First;
   while not cdsMensalidades.Eof do
   begin
      if ( not cdsMensalidadesCD_ACAO_MOVIMENTO.IsNull ) AND
         ( cdsMensalidadesCD_ACAO_MOVIMENTO.AsInteger > 0 ) then
      begin
         AcaoDesconto := cdsMensalidadesCD_ACAO_MOVIMENTO.AsInteger;
      end else begin
         AcaoDesconto := AcaoDescontoPadrao;
      end;

      qryMensalidadeAfrica.Insert;
      qryMensalidadeAfricaCD_CURSO.AsString := qryMatriculaCD_CURSO.AsString;
      qryMensalidadeAfricaCD_DEPTO.AsInteger := qryTurmaCD_DEPTO.AsInteger;
      qryMensalidadeAfricaCD_PESSOA.AsInteger := Pessoa;
      qryMensalidadeAfricaNR_PARCELA.AsInteger :=
         cdsMensalidadesNR_PARCELA.AsInteger;
      qryMensalidadeAfricaCD_TURMA.AsString := qryMatriculaCD_TURMA.AsString;
      qryMensalidadeAfricaDT_EMISSAO.AsDateTime := Hoje;
      if AlunoSelBoleto then
      begin
         qryMensalidadeAfricaNR_NOSSONUMERO.Clear;
      end
      else
      begin
         qryMensalidadeAfricaNR_NOSSONUMERO.AsString := DM.NovoNumero(
            qryTurmaCD_DEPTO.AsInteger,
            qryTurmaCD_TURMA.AsString,
            qryTurmaNR_ANOSEMESTRE.AsInteger, 0, 0, 0, Pessoa
         );
      end;
      qryMensalidadeAfricaVL_BRUTO.AsCurrency :=
         cdsMensalidadesVL_BRUTO.AsCurrency;
      qryMensalidadeAfricaVL_DESCONTO.AsCurrency :=
         cdsMensalidadesVL_DESCONTO.AsCurrency;
      qryMensalidadeAfricaVL_BOLSA.AsCurrency :=
         cdsMensalidadesVL_BOLSA.AsCurrency;
      qryMensalidadeAfricaVL_EXTRA.AsCurrency :=
         cdsMensalidadesVL_EXTRA.AsCurrency;
      qryMensalidadeAfricaVL_TOTAL.AsCurrency :=
         cdsMensalidadesVL_BRUTO.AsCurrency +
         cdsMensalidadesVL_EXTRA.AsCurrency -
         cdsMensalidadesVL_DESCONTO.AsCurrency -
         cdsMensalidadesVL_BOLSA.AsCurrency;
      qryMensalidadeAfricaVL_JUROS.AsCurrency := 0;
      qryMensalidadeAfricaCD_SITUACAO.AsInteger := Situacao;
      qryMensalidadeAfricaCD_USUARIO.AsString := DM.UsuarioLogado.Pessoa.Login;
      qryMensalidadeAfricaSN_BLOQUETO.AsString := #78;
      qryMensalidadeAfricaNR_ANOSEMESTRE.AsInteger :=
         qryMatriculaNR_ANOSEMESTRE.AsInteger;
      qryMensalidadeAfricaNR_TIPO_PARCELA.AsInteger := 0;
      qryMensalidadeAfricaCD_CAIXA.AsInteger := qryDeptoCD_CAIXA.AsInteger;
      qryMensalidadeAfricaVL_INDICE_CORRECAO.AsCurrency := 0;
      qryMensalidadeAfricaDT_VENCTO.AsDateTime :=
         cdsMensalidadesDT_VENCTO.AsDateTime;
      qryMensalidadeAfricaDT_COMPETENCIA.AsDateTime :=
         Max(cdsMensalidadesDT_VENCTO.AsDateTime, Hoje);
      qryMensalidadeAfricaDT_BASE_CORRECAO.AsDateTime := EncodeDate(
         YearOf(cdsMensalidadesDT_VENCTO.AsDateTime),
         MonthOf(cdsMensalidadesDT_VENCTO.AsDateTime), 1
      );
      qryMensalidadeAfricaSN_CREDITO_PARCELA.AsString :=
         cdsMensalidadesSN_CREDITO.AsString;
      qryMensalidadeAfricaNR_CREDITOS.AsFloat :=
         cdsMensalidadesNR_CREDITOS.AsFloat;
      qryMensalidadeAfricaCD_MENSALIDADE_ORIGEM.AsInteger := -1;
      qryMensalidadeAfricaCD_TIPO_TITULO.AsInteger :=
         cdsMensalidadesCD_TIPO_TITULO.AsInteger;

      qryMensalidadeAfricaCD_PLANO_CONTA.AsInteger :=
         cdsMensalidadesCD_CONTA.AsInteger;
      qryMensalidadeAfricaCD_CENTRO_CUSTO.AsInteger :=
         qryTurmaCD_CENTRO.AsInteger;
      qryMensalidadeAfricaDS_HISTORICO.AsString :=
         cdsMensalidadesDS_HISTORICO.AsString;
      qryMensalidadeAfricaCD_COLIGADA.AsInteger :=
         qryTurmaCD_COLIGADA.AsInteger;
      qryMensalidadeAfricaCD_RESP.AsInteger :=
         cdsMensalidadesCD_RESPONSAVEL.AsInteger;
      qryMensalidadeAfricaCD_BOLSA.AsInteger :=
         cdsMensalidadesCD_BOLSA.AsInteger;
      qryMensalidadeAfricaCD_ITEM_PLANO.AsInteger :=
         cdsMensalidadesCD_ITEM_PLANO.AsInteger;
      qryMensalidadeAfrica.Post;

      cdsMensalidades.Edit;
      cdsMensalidadesCD_MENSALIDADE.AsInteger :=
         qryMensalidadeAfricaCD_MENSALIDADE.AsInteger;
      cdsMensalidades.Post;
      cdsMensalidades.Next;
   end;

   qryMensalidadeAfrica.First;
   while not qryMensalidadeAfrica.Eof do
   begin
      // Cria ação de movimento da mensalidade
      Movimento := TMovimento.create;
      Movimento.TipoDeAcao := GerarTitulos;
      Movimento.CodigoTitulo := qryMensalidadeAfricaCD_MENSALIDADE.AsInteger;
      Movimento.CodAcao := AcaoGerarMens;
      Movimento.Coligada := qryTurmaCD_COLIGADA.AsInteger;
      Movimento.ValorMovimento :=
         qryMensalidadeAfricaVL_BRUTO.AsCurrency +
         qryMensalidadeAfricaVL_EXTRA.AsCurrency;
      Movimento.RegistrarMovimentacaoCR(0);
      Movimento.Free;

      // Cria ação de movimento do desconto fixo
      if qryMensalidadeAfricaVL_BOLSA.AsCurrency > 0 then
      begin
         Movimento := TMovimento.create;
         Movimento.CodigoTitulo := qryMensalidadeAfricaCD_MENSALIDADE.AsInteger;      
         Movimento.TipoDeAcao := BaixarporDesconto;
         Movimento.CodAcao := AcaoDesconto;
         Movimento.Coligada := qryTurmaCD_COLIGADA.AsInteger;
         Movimento.ValorMovimento := RoundFloat(qryMensalidadeAfricaVL_BOLSA.AsCurrency, 2);
         Movimento.CodigoMovimento := qryMensalidadeAfricaCD_MENSALIDADE.AsInteger;
         Movimento.RegistrarMovimentacaoCR(0);
         Movimento.Free;
      end;

      // Cria ação de movimento do desconto condicional
      if qryMensalidadeAfricaVL_DESCONTO.AsCurrency > 0 then
      begin
         Movimento := TMovimento.create;
         Movimento.TipoDeAcao := BaixarporDesconto;
         Movimento.CodigoTitulo := qryMensalidadeAfricaCD_MENSALIDADE.AsInteger;
         Movimento.Observacao := 'Desconto condicional aplicado na matrícula.';
         Movimento.CodAcao := AcaoDescontoCondicionalPadrao;
         Movimento.Coligada := qryTurmaCD_COLIGADA.AsInteger;
         Movimento.ValorMovimento := 0;
         Movimento.ValorDesconto := RoundFloat(qryMensalidadeAfricaVL_DESCONTO.AsCurrency, 2);
         Movimento.CodigoMovimento := Movimento.CodigoTitulo;
         Movimento.DescCondicional := 1;
         Movimento.RegistrarMovimentacaoCR(0);
         Movimento.Free;
      end;

      // Atualiza o código da mensalidade origem
      qyAtualizarMensalidadeOrigem.Close;
      qyAtualizarMensalidadeOrigem.ParamByName('cd_mensalidade').AsInteger := qryMensalidadeAfricaCD_MENSALIDADE.AsInteger;
      qyAtualizarMensalidadeOrigem.ExecSQL;

      qryMensalidadeAfrica.Next;
   end;
end;

procedure TfMatricular.GeraMensalidadesBrasil;
const
   SSQLPerdoarMens = 'UPDATE MENSALIDADES SET VALORDESCONTO = 0, VALORTOTAL = 0, SITUACAO = 4, DATAPAGAMENTO = NOW() WHERE CD_MENSALIDADE = ?';
   SMotivoPerdao = 'Matrícula realizada após o início das aulas da turma';
var
   Competencia, Inicio, Hoje: TDate;
   Situacao, Mensalidade, AcaoDescontoCondicional: Integer;
   S, MensDataBaixa, ObsDescCondicional: string;
   Stmt: IZPreparedStatement;
begin
   Hoje := DM.DataAtual;
   Inicio := FFrmPlanoBrasil.qryPlanoPgtoDT_APARTIR.AsDateTime;

   S := DM.variavel_parametro('matriculas_situacao_padrao');
   S := Trim(S);

   if S <> '' then
   begin
      Situacao := StrToIntDef(S, 2);
   end
   else
   begin
      Situacao := 2;
   end;

   MensDataBaixa := DM.variavel_parametro('mensalidades_data_baixa');
   MensDataBaixa := Trim(MensDataBaixa);

   cdsMensalidades.DisableControls;
   cdsMensalidades.First;

   while not cdsMensalidades.Eof do
   begin
      if ( not cdsMensalidadesCD_DESC_CONDICIONAL.IsNull ) and
         ( cdsMensalidadesCD_DESC_CONDICIONAL.AsInteger > 0 )  then
      begin
         AcaoDescontoCondicional := cdsMensalidadesCD_DESC_CONDICIONAL.AsInteger;
         ObsDescCondicional := 'Desconto condicional aplicado na matrícula.';
      end else begin
         AcaoDescontoCondicional := 0;
         ObsDescCondicional := '';
      end;


      Competencia := cdsMensalidadesDT_VENCTO.AsDateTime;
      Competencia := Max(Competencia, Max(Inicio, Hoje));

      Mensalidade := DM.GerarMensalidade(
         Pessoa, cdsMensalidadesNR_PARCELA.AsInteger,
         qryMatriculaCD_TURMA.AsString, cdsMensalidadesVL_BRUTO.AsCurrency, 0,
         qryMatriculaNR_ANOSEMESTRE.AsInteger,
         cdsMensalidadesDT_VENCTO.AsDateTime, Competencia, Situacao,
         qryMatriculaCD_CURSO.AsString, qryTurmaCD_DEPTO.AsInteger, 0, -1,
         cdsMensalidadesVL_DESCONTO.AsCurrency,
         cdsMensalidadesNR_CREDITOS.AsFloat,
         cdsMensalidadesDS_TIPO_TITULO.AsString,
         cdsMensalidadesCD_TIPO_TITULO.AsInteger,
         cdsMensalidadesCD_CONTA.AsInteger, qryTurmaCD_CENTRO.AsInteger,
         cdsMensalidadesVL_BOLSA.AsCurrency, cdsMensalidadesVL_EXTRA.AsCurrency,
         cdsMensalidadesSN_CREDITO.AsString[1],
         cdsMensalidadesVL_CREDITO.AsFloat,
         cdsMensalidadesCD_ITEM_PLANO.AsInteger, 1, 0,
         cdsMensalidadesCD_RESPONSAVEL.AsInteger,
         qryTurmaCD_COLIGADA.AsInteger, 0, cdsMensalidadesVL_PERCENTUAL_DIVISAO.AsCurrency,
         AcaoDescontoCondicional,
         ObsDescCondicional, 0, false, false
      );

      if not cdsMensalidadesIDX_PARCELA.IsNull then
      begin
         // Gerar as ações de movimento dos DESCONTOS da parcela que está sendo gerada,
         // a ação de movimento da parcela foi gerada no momento de geração da parcela
         gerarAcoesMovimento(Mensalidade, cdsMensalidadesIDX_PARCELA.AsString);
      end;
      
      // Realiza a atualização da baixa da mensalidade por desconto (quando ela for aplicada) 
      atualizarBaixaPorDesconto(Mensalidade, MensDataBaixa);

      if cdsMensalidadesSN_PERDOAR.AsBoolean then
      begin
         if DM.FindMotivo(Pessoa,
               cdsMensalidadesNR_PARCELA.AsInteger,
               cdsMensalidadesDT_VENCTO.AsDateTime,
               qryMatriculaCD_TURMA.AsString) then
         begin
            DM.tblMotivos.Edit;
         end
         else
         begin
            DM.tblMotivos.Insert;
            DM.tblMotivosturma.AsString := qryMatriculaCD_TURMA.AsString;
            DM.tblMotivosCodigoAluno.AsInteger := Pessoa;
            DM.tblMotivosParcela.AsInteger := cdsMensalidadesNR_PARCELA.AsInteger;
            DM.tblMotivosDataMotivo.AsDateTime := cdsMensalidadesDT_VENCTO.AsDateTime;
         end;

         DM.tblMotivosAutorizadoPor.AsInteger := DM.iCdPessoaLogado;
         DM.tblMotivosMotivo.AsString := SMotivoPerdao;
         DM.tblMotivos.Post;

         Stmt := PrepareStatement(SSQLPerdoarMens);
         try
            Stmt.SetInt(1, Mensalidade);
            Stmt.ExecutePrepared;
         finally
            Stmt.Close;
         end;
      end;

      cdsMensalidades.Edit;
      cdsMensalidadesCD_MENSALIDADE.AsInteger := Mensalidade;
      cdsMensalidades.Post;
      cdsMensalidades.Next;
   end;
end;

procedure TfMatricular.gerarAcoesMovimento(cd_mensalidade: Integer; idxParcela: String);
var
   Movimento: TMovimento;
   AcaoDescontoFixoPadrao, AcaoDescontoCondicionalPadrao: Integer;
begin

   // Ação de desconto padrão do fixo e condicional
   AcaoDescontoFixoPadrao := DM.BuscarCodigoAcaoPadrao(11);
   AcaoDescontoCondicionalPadrao := DM.BuscarCodigoAcaoPadrao(24);

   cdsDescontos.DisableControls;

   // Filtra apenas os descontos FIXOS (CD_TIPO_DESCONTO = 2) da parcela
   cdsDescontos.Filter := 'IDX_PARCELA = '+idxParcela+' AND CD_TIPO_DESCONTO = 2';
   cdsDescontos.Filtered := true;
   cdsDescontos.First;
   while not cdsDescontos.Eof do
   begin
      Movimento := TMovimento.create;
      try
         Movimento.Observacao := cdsDescontosDS_OBSERVACAO.AsString;
         Movimento.TipoDeAcao := BaixarporDesconto;
         Movimento.CodigoTitulo := cd_mensalidade;
         Movimento.CodAcao := AcaoDescontoFixoPadrao;
         if cdsDescontosCD_ACAO_MOVIMENTO.AsInteger > 0 then
         begin
            Movimento.CodAcao := cdsDescontosCD_ACAO_MOVIMENTO.AsInteger;
         end;         
         Movimento.ValorMovimento := RoundFloat(cdsDescontosVL_DESCONTO.AsCurrency, 2);
         Movimento.DescontoPlano := cdsDescontosSN_DESCONTO_PLANO.AsInteger;
         Movimento.Coligada := qryTurmaCD_COLIGADA.AsInteger;
         Movimento.RegistrarMovimentacaoCR(0, false);
      finally
         Movimento.Free;
      end;

      cdsDescontos.Next;
   end;

   cdsDescontos.DisableControls;
   // Filtra apenas os descontos CONDICIONAIS (CD_TIPO_DESCONTO = 1) da parcela
   cdsDescontos.Filter := 'IDX_PARCELA = '+idxParcela+' AND CD_TIPO_DESCONTO = 1';
   cdsDescontos.Filtered := true;
   cdsDescontos.First;
   while not cdsDescontos.Eof do
   begin
      Movimento := TMovimento.create;
      try
         Movimento.Observacao := cdsDescontosDS_OBSERVACAO.AsString;
         Movimento.TipoDeAcao := BaixarporDesconto;
         Movimento.CodigoTitulo := cd_mensalidade;
         Movimento.CodAcao := AcaoDescontoCondicionalPadrao;
         if cdsDescontosCD_ACAO_MOVIMENTO.AsInteger > 0 then
         begin
            Movimento.CodAcao := cdsDescontosCD_ACAO_MOVIMENTO.AsInteger;
         end;
         Movimento.ValorDesconto := RoundFloat(cdsDescontosVL_DESCONTO.AsCurrency, 2);
         Movimento.DescontoPlano := cdsDescontosSN_DESCONTO_PLANO.AsInteger;
         Movimento.Coligada := qryTurmaCD_COLIGADA.AsInteger;
         Movimento.DescCondicional := 1;
         Movimento.RegistrarMovimentacaoCR(0, false);
      finally
         Movimento.Free;
      end;

      cdsDescontos.Next;
   end;

end;

