procedure TfMatricular.btnComissaoClick(Sender: TObject);
const
   SChavePermissao = 'UMFinanceiro.RepasseParceiro';
   SQL_SELECT = ''
         + ' SELECT '
         + '   mat.id_matricula, '
         + '   mat.anosemestre, '
         + '   mat.curso, '
         + '   mat.turma, '
         + '   mat.codigoaluno, '
         + '   pes.nm_pessoa '
         + ' FROM  '
         + '   matriculas mat  '
         + '   INNER JOIN pessoas pes ON(pes.cd_pessoa = mat.codigoaluno) '
         + ' WHERE '
         + '   anosemestre = :nr_anosemestre '
         + '   AND turma = :cd_turma '
         + '   AND codigoaluno = :codigoaluno ';
var
   frmRepasseParceiro :TfrmRepasseParceiro;
   qyAux : TUMZQuery;
   id_matricula : integer;
   cd_aluno : integer;
   ds_aluno : string;
   nr_anosemestre: integer;
   cd_curso: string;
   cd_turma: string;
begin

   DM.CriarConsulta(qyAux);
   qyAux.Close();

   if DM.UsuarioLogado.TemPermissao(DM.UsuarioLogado.Pessoa.Codigo, SChavePermissao, npAcesso, true) then
   begin
      qyAux.sql.Text := SQL_SELECT;
      qyAux.ParamByName('nr_anosemestre').AsInteger := 20181;//qryMatriculaNR_ANOSEMESTRE.AsInteger;
      qyAux.ParamByName('cd_turma').AsString := '047FA20151TMA_1';//qryMatriculaCD_TURMA.AsString;
      qyAux.ParamByName('codigoaluno').AsInteger := 216974;//qryMatriculaCursoCD_PESSOA.AsInteger;
      qyAux.Open;
      qyAux.First;
      id_matricula := qyAux.FieldByName('id_matricula').AsInteger;
      cd_aluno := qyAux.FieldByName('codigoaluno').AsInteger;
      ds_aluno := qyAux.FieldByName('nm_pessoa').AsString;
      nr_anosemestre := qyAux.FieldByName('anosemestre').AsInteger;

      Application.CreateForm(TfrmRepasseParceiro, frmRepasseParceiro);
      frmRepasseParceiro.btnInserirClick(Sender);
      frmRepasseParceiro.setCampos(0,id_matricula,nr_anosemestre,cd_curso,cd_turma,cd_aluno,ds_aluno,0,'',0);

      qryMatricula.FieldByName('id_matricula').AsString;
      frmRepasseParceiro.Show;
   end;

   FreeAndNil(qyAux);
end;

procedure TfMatricular.bbtnBaixarCartaoClick(Sender: TObject);
var
   i : integer;
   ds_chave, ds_mensalidades_selecionadas : String;

begin
   ds_chave := '';
   cdsBoletos.First;

   // PERCORRE AS MENSALIDADES SELECIONADAS
   while not cdsBoletos.Eof do
   begin
      if cdsBoletosSN_SELECIONADO.AsBoolean = True then
      begin
         ds_mensalidades_selecionadas :=
            ds_mensalidades_selecionadas
            + cdsBoletosCD_MENSALIDADE.AsString
            + ',';
      end;
      cdsBoletos.Next;
   end;

   {
     REMOVE A ULTIMA VIRGULA, ESSA STRING SERÁ USADA
     NA CLAUSULA WHERE(CONDICAO IN() ) PARA RETORNAR AS MENSALIDADES NO CHECKOUT
   }
   ds_mensalidades_selecionadas := copy(
      ds_mensalidades_selecionadas,
      0,
      length(ds_mensalidades_selecionadas)-1
   );

   {
      ADICIONA OS PARAMETRO NA URL:
       -> SN_PAGAMENTO_LOCAL = INFORMA QUE O PAGAMENTO ESTA SENDO FEITO ATRAVES DO SISTEMA LOCAL
   }
   ds_url_param := ds_url_param
                  +'?sn_pagamento_local=S'
                  +'&cd_pessoa='      + qryMatriculaCD_PESSOA.AsString
                  +'&codigoCurso='    + qryMatriculaCD_CURSO.AsString
                  +'&codigoTurma='    + qryMatriculaCD_TURMA.AsString
                  +'&anosemestre='    + qryMatriculaNR_ANOSEMESTRE.AsString
                  +'&cd_plano='       + qryMatriculaCD_PLANO_PGTO.AsString
                  +'&dt_vencimento='  + cdsBoletosDT_VENCTO.AsString
                  +'&ds_mensalidades=' + ds_mensalidades_selecionadas;

   //GERA UMA CHAVE COM NUMEROS ALEATÓRIOS P/ CRIAR SEMPRE UMA NOVA SESSÃO
   ds_chave := gerar_random();
   
   { ABRE O NAVEGADOR EM MODO APLICATIVO  }
   ShellExecute(
      self.WindowHandle,
      'open',
      PChar('chrome.exe'),
      PChar('--app=' + ds_url_param ),
      PChar(
         '--user-data-dir='
         + ds_chave
         + '--window-size=585,935 --window-position=580,240'
      ),
      SW_SHOW
   );
end;

