   slLista := TStringList.Create;
   slLista.Delimiter := ',';
   slLista.QuoteChar := ' ';

   slSelecionados := TStringList.Create;

   // Varre as disciplinas já selecionadas adicionada as mesmas num string list de selecionados
   // Com excessão das disciplinas optativas, essas disciplinas serão carregadas
   cdsDisciplinas.First;
   while not cdsDisciplinas.Eof do
   begin
      // Varre somente as disciplinas selecionadas
      if cdsDisciplinasSN_SELECIONADA.AsBoolean and
         cdsDisciplinasCD_DISCIPLINA_GENERICA.IsNull then
      begin
         slSelecionados.Add(
               cdsDisciplinasCD_CURSO.AsString+', '+
               cdsDisciplinasCD_TURMA.AsString+', '+
               cdsDisciplinasCD_DISCIPLINA.AsString
         );
      end;

      cdsDisciplinas.Next;
   end;

   qryDisciplinasGrade.Close;
   qryDisciplinasGrade.Open;

   qryDisciplinasGrade.First;
   while not qryDisciplinasGrade.Eof do
   begin
      sDiscProcurar :=
         qryDisciplinasGrade.FieldByName('CD_CURSO').AsString+', '+
         qryDisciplinasGrade.FieldByName('CD_TURMA').AsString+', '+
         qryDisciplinasGrade.FieldByName('CD_DISCIPLINA').AsString;

