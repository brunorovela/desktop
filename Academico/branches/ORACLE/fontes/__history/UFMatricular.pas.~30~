procedure TfMatricular.CarregaProximoAnoSemestre;
begin
   // Recupera o anosemestre da matricula atual
   qryAnoSemestreMatricula.ParamByName('CD_PESSOA').AsInteger := Pessoa;
   qryAnoSemestreMatricula.ParamByName('CD_CURSO').AsString := Curso;
   qryAnoSemestreMatricula.Open;

   FProximoAnoSem := qryAnoSemestreMatricula.FieldByName('NR_ANOSEMESTRE').AsInteger;

   if FProximoAnoSem = 0 then
   begin
      FProximoAnoSem := DM.GetAnoSemestreAtual;
   end;

   if DM.UsaAnosemestre then
   begin
      if ano_semestre_incremento = 1 then
      begin
         if (FProximoAnoSem mod 2) = 0 then
         begin
            Inc(FProximoAnoSem, 9);
         end
         else
            Inc(FProximoAnoSem);
      end
      else
         Inc(FProximoAnoSem, 10);
   end;

end;

