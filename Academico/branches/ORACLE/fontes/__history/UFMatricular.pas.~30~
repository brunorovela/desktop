function TfMatricular.alunoPodeTransitarFuncao: Boolean;
const
   SQL_GetSituacaoEstudante =
   'SELECT GET_SITUACAO_ESTUDANTE( :pessoa, :curso, :ano, :anosemestre ) AS situacao_estudante';
var
   qrySituacaoEstudante : TUMZQuery;
   situacaoEstudante : String;
   nrAno : String;
begin
    { Utiliza a função GET_SITUACAO_ESTUDANTE pois ela pode ser alterada caso sejam alteradas as regras do cliente
      Atualmente os retornos são os seguintes:
       Situação = 1 >> Aprovado sem nenhuma disciplina reprovada - PODE TRANSITAR
       Situação = 2 >> Aprovado com disciplinas em atraso - PODE TRANSITAR
       Situação = 3 >> Reprovado
       Situação = 4 >> Sem situação definida, não se enquadra em nenhuma situação acima. }

   //Formata a seríe para o ano usado pelo cleinte
   //Engloba também o 0 para casos do aluno fazendo nova matricula
   case qryUltimaSerieNR_SERIE.AsInteger of
      0..2: begin
         nrAno := '1';
      end;
      3..4: begin
         nrAno := '2';
      end;
      5..6: begin
         nrAno := '3';
      end;
      7..8: begin
         nrAno := '4';
      end;
      9..10: begin
         nrAno := '5';
      end;
   end;

   DM.CriarConsulta(qrySituacaoEstudante);
   qrySituacaoEstudante.SQL.Add(SQL_GetSituacaoEstudante);
   qrySituacaoEstudante.ParamByName('pessoa').AsString := qryMatriculaCD_PESSOA.AsString;
   qrySituacaoEstudante.ParamByName('curso').AsString := qryMatriculaCD_CURSO.AsString;
   qrySituacaoEstudante.ParamByName('ano').AsString := nrAno;
   qrySituacaoEstudante.ParamByName('anosemestre').AsString := qryUltimoAnoSemNR_ANOSEMESTRE.AsString;
   qrySituacaoEstudante.Open;

   situacaoEstudante := qrySituacaoEstudante.FieldByName('situacao_estudante').AsString;

   result := ((situacaoEstudante = '1') OR (situacaoEstudante = '2'));

   FreeAndNil(qrySituacaoEstudante);
end;

