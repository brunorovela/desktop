function TfMatricular.GetFiltrosRelatorio: string;
var
   Filtros, FilProcessado: TStringList;
   I: Integer;
   S: string;
begin
   Result := '';
   Filtros := TStringList.Create;
   FilProcessado := TStringList.Create;
   try
      Filtros.Delimiter := #59;
      Filtros.NameValueSeparator := #46;
      Filtros.StrictDelimiter := True;
      Filtros.DelimitedText := AnsiUpperCase(qryRelatorioDS_PARAMETROS.AsString);

      for I := 0 to Filtros.Count - 1 do
      begin
         if Filtros.ValueFromIndex[I] = 'ANOSEMESTRE' then
         begin
            S := qryMatriculaNR_ANOSEMESTRE.AsString;
         end
         else
         if Filtros.ValueFromIndex[I] = 'CURSO' then
         begin
            S := QuotedStr(qryMatriculaCD_CURSO.AsString);
         end
         else
         if Filtros.ValueFromIndex[I] = 'DEPTO' then
         begin
            S := qryTurmaCD_DEPTO.AsString;
         end
         else
         if Filtros.ValueFromIndex[I] = 'TURMA' then
         begin
            S := QuotedStr(qryMatriculaCD_TURMA.AsString);
         end
         else
         if Filtros.ValueFromIndex[I] = 'CODIGOALUNO' then
         begin
            S := qryMatriculaCD_PESSOA.AsString;
         end
         else
         begin
            Continue;
         end;

         if Result <> '' then
         begin
            Result := Result + ' AND ';
         end;

         Result := Result + Format('{%s} = %s', [Filtros.Strings[I], S]);
      end;
   finally
      Filtros.Free;
      FilProcessado.Free;
   end;
end;

