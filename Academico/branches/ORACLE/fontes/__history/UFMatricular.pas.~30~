function TfMatricular.ImprimeBoletos: Boolean;

   function GetFiltroParcelas: string;
   begin
      Result := '';
      cdsBoletos.First;
      while not cdsBoletos.Eof do
      begin
         if Result <> '' then
         begin
            Result := Result + #44;
         end;
         Result := Result + cdsBoletosNR_PARCELA.AsString;
         cdsBoletos.Next;
      end;
      cdsBoletos.Filtered := False;
   end;

const
   SRelNaoConfigurado = 'Relatório para impressão de boletos não configurado.'#13'Entre em contato com o suporte técnico.';
   SSemParcelasSel = 'Não foram selecionadas parcelas para impressão.';
   SErroPreparacao = 'Ocorreu um erro na preparação dos boletos para impressão.'#13'Entre em contato com o suporte técnico.';
   SFiltroBloq =
      'C.SN_ATIVA = ''S'' AND M.CODIGOALUNO = %d AND M.PARCELA IN (%s) AND ' +
      'M.TURMA = %s AND M.SITUACAO IN (2, 10)';
   SFiltroRel =
      '{FIN_CADASTRO_CONTAS.SN_ATIVA} = ''S'' AND ' +
      '{MENSALIDADES.CODIGOALUNO} = %d AND ' +
      '{MENSALIDADES.PARCELA} IN [%s] AND ' +
      '{MENSALIDADES.TURMA} = %s AND ' +
      '{MENSALIDADES.SITUACAO} IN [2, 10]';
var
   NomeRel, LocalRel, CaminhoRel, FilParcelas, S, CodigoCaixa: string;
   Crpe: TCrpe;
   Preparado: Boolean;
   qyBoletoImpresso: TUMZQuery;
begin
   DM.CriarConsulta(qyBoletoImpresso);

   cdsBoletos.DisableControls;
   cdsBoletos.Filter := 'SN_SELECIONADO';
   cdsBoletos.Filtered := True;
   
   if not cdsBoletos.IsEmpty then
   begin
      NomeRel := DM.NomeDoBoleto(
         qryTurmaCD_DEPTO.AsInteger,
         qryMatriculaCD_TURMA.AsString,
         qryMatriculaNR_ANOSEMESTRE.AsInteger
      );
      
      LocalRel := Format('%s%s%s%s', [
         ExtractFilePath(Application.ExeName), PathDelim, 'relatorios', PathDelim
      ]);
      LocalRel := DM.GetUnimestreINI.ReadString('Configuracoes', 'Relatorios', LocalRel);
      
      CaminhoRel := Format('%s%s%s', [LocalRel, PathDelim, NomeRel]);

      if FileExists(CaminhoRel) then
      begin

         Application.CreateForm(TfrmRepBloquetos, frmRepBloquetos);
         try
            if not qryDepto.Active then
               qryDepto.Open;

            IF (qryTurmaCD_CAIXA.AsInteger > 0) THEN
                CodigoCaixa := qryTurmaCD_CAIXA.AsString
            else
               CodigoCaixa := qryDeptoCD_BOLETO_PADRAO.AsString;


            FilParcelas := GetFiltroParcelas;
            S := Format(SFiltroBloq,
               [Pessoa, FilParcelas, QuotedStr(qryMatriculaCD_TURMA.AsString)]
            );

            Preparado := frmRepBloquetos.PrepararBloquetosParaImpressao(S,
               DM.isTrue(DM.variavel_parametro('financeiro_boletos_agrupados')), CodigoCaixa, False);

            if Preparado then
            begin
               Result := True;
               Crpe := NovoRelatorio;
               Crpe.ReportName := '';
               Crpe.ReportName := CaminhoRel;

               if Crpe.HasSavedData then
               begin
                  Crpe.DiscardSavedData;
               end;

               if DM.db.Protocol = DB_PROTOCOL_MYSQL then
               begin
                  Crpe.Connect.Clear;
                  Crpe.Connect.ServerName := 'unimestre';
                  Crpe.Connect.UserID := DM.db.User;
                  Crpe.Connect.Password := DM.db.Password;
                  Crpe.Connect.DatabaseName := ODBCInfo('DATABASE');
               end
               else
               if DM.db.Protocol = DB_PROTOCOL_ORACLE then
               begin
                  Crpe.Connect.Clear;
                  Crpe.Connect.ServerName := DM.db.Database;
                  Crpe.Connect.UserID := DM.db.User;
                  Crpe.Connect.Password := DM.db.Password;
                  Crpe.Connect.DatabaseName := DM.db.Database;
               end;

               Crpe.ReportTitle := Application.Title;

               S := Format(SFiltroRel, [
                  Pessoa, FilParcelas, QuotedStr(qryMatriculaCD_TURMA.AsString)
               ]);
               Crpe.Selection.Formula.Text := S;
               Crpe.Execute;
               Crpe.HideWindow;

               cdsBoletos.Filtered := True;
               cdsBoletos.First;
               while not cdsBoletos.Eof do
               begin
                  qyBoletoImpresso.Close;
                  qyBoletoImpresso.SQL.Text := 'UPDATE mensalidades SET bloqueto = ''S'' WHERE cd_mensalidade = '+cdsBoletosCD_MENSALIDADE.AsString;
                  DM.FazAcaoRemessa(arImpBoleto, cdsBoletosCD_MENSALIDADE.AsInteger);
                  qyBoletoImpresso.ExecSQL();

                  cdsBoletos.Next;
               end;
               cdsBoletos.Filtered := False;

            end
            else
               MessageDlg(SErroPreparacao, mtError, [mbOK], -1);
         finally
            frmRepBloquetos.Free;
         end;
      end
      else
      begin
         Result := False;
         MessageDlg(SRelNaoConfigurado, mtInformation, [mbOK], -1);
      end;
   end
   else
   begin
      Result := False;
      MessageDlg(SSemParcelasSel, mtWarning, [mbOK], -1);
   end;

   cdsBoletos.Filtered := False;
   cdsBoletos.EnableControls;
end;

procedure TfMatricular.ImprimeDocumentos;
var
   CodCabcalho, I, N: Integer;
   NomeRel, LocalRel, CaminhoRel, S: string;
   SL: TStringList;
   Crpe: TCrpe;
begin
   NomeRel := qryRelatorioNM_ARQUIVO.AsString;
   if not AnsiEndsText('.rpt', NomeRel) then
   begin
      NomeRel := NomeRel + '.rpt';
   end;

   LocalRel := Format('%s%s%s%s', [
      ExtractFilePath(Application.ExeName), PathDelim, 'relatorios', PathDelim
   ]);
   LocalRel := DM.GetUnimestreINI.ReadString('Configuracoes', 'Relatorios', LocalRel);
   CaminhoRel := Format('%s%s%s', [LocalRel, PathDelim, NomeRel]);

   if FileExists(CaminhoRel) then
   begin
      Crpe := NovoRelatorio;
      Crpe.ReportName := '';
      Crpe.ReportName := CaminhoRel;

      if Crpe.HasSavedData then
      begin
         Crpe.DiscardSavedData;
      end;

      if DM.db.Protocol = DB_PROTOCOL_MYSQL then
      begin
         Crpe.Connect.Clear;
         Crpe.Connect.ServerName := 'unimestre';
         Crpe.Connect.UserID := DM.db.User;
         Crpe.Connect.Password := DM.db.Password;
         Crpe.Connect.DatabaseName := ODBCInfo('DATABASE');
      end
      else
      if DM.db.Protocol = DB_PROTOCOL_ORACLE then
      begin
         Crpe.Connect.Clear;
         Crpe.Connect.ServerName := DM.db.Database;
         Crpe.Connect.UserID := DM.db.User;
         Crpe.Connect.Password := DM.db.Password;
         Crpe.Connect.DatabaseName := DM.db.Database;
      end;

      Crpe.PrintOptions.Copies := speNumCopias.Value;
      Crpe.ReportTitle := qryRelatorioNM_RELATORIO.AsString;

      I := Crpe.Formulas.IndexOf('cd_cabecalho');
      if I > -1 then
      begin
         CodCabcalho := qryRelatorioCD_CABECALHO.AsInteger;
         if CodCabcalho > -1 then
         begin
            if RelObj.FindObjetoItem(CodCabcalho) = -1 then
            begin
               DM.CabecalhoParamFixos;
               RelObj.Add(CodCabcalho);
               RelObj.getObjetoItem(CodCabcalho).ProcessaRelObjetos(
                  DM.CabecalhoCampos(CodCabcalho), slPFixos
               );
               RelObj.DefineCabecalho(Crpe, 'Cabecalho', CodCabcalho, nil);
            end;
            Crpe.Formulas.Items[I].Formula.Text :=
               qryRelatorioCD_CABECALHO.AsString;
         end;
      end;

      S := Trim(qryRelatorioDS_FORMULA_GRUPO.AsString);
      if S <> '' then
      begin
         Crpe.GroupSelection.Formula.Text := S;
      end
      else
      begin
         Crpe.GroupSelection.Formula.Clear;
      end;

      SL := TStringList.Create;
      try
         SL.Delimiter := #59;

         S := Trim(qryRelatorioDS_FORMULA.AsString);
         if S <> '' then
         begin
            SL.DelimitedText := S;
            for I := 0 to SL.Count - 1 do
            begin
               N := Crpe.Formulas.IndexOf(SL.Names[I]);
            
               if N > -1 then
               begin
                  if SL.Names[I] <> 'coligada' then
                  begin
                     Crpe.Formulas.Items[N].Formula.Text :=
                        SL.ValueFromIndex[I];
                  end
                  else
                  begin
                     Crpe.Formulas.Items[N].Formula.Text :=
                        Format('%d', [DM.getColigadaByTurma(qryMatriculaCD_TURMA.AsString, qryMatriculaNR_ANOSEMESTRE.AsInteger)]);
                  end;
               end;
            end;
         end;

         S := Trim(qryRelatorioDS_SQL_EXP.AsString);
         if S <> '' then
         begin
            SL.Clear;
            SL.DelimitedText := S;

            for I := 0 to SL.Count - 1 do
            begin

               N := Crpe.SQLExpressions.IndexOf(SL.Names[I]);
            
               if N > -1 then
               begin
                  Crpe.SQLExpressions.Items[N].Expression.Text :=
                     SL.ValueFromIndex[I];
               end;
            end;
         end;

         S := Trim(qryRelatorioDS_ORDEM.AsString);
         if S <> '' then
         begin
            SL.Clear;
            SL.DelimitedText := S;
            if SL.Count > 0 then
            begin
               Crpe.SortFields.Clear;
            
               for I := 0 to SL.Count - 1 do
               begin
            
                  N := Crpe.SortFields.Add(SL.Names[I]);
                  S := AnsiUpperCase(Trim(SL.ValueFromIndex[I]));
               
                  if S = 'DESC' then
                  begin
                     Crpe.SortFields.Items[N].Direction := sdDescending;
                  end
                  else
                  begin
                     Crpe.SortFields.Items[N].Direction := sdAscending;
                  end;
               end;
            end;
         end;
         
      finally
         SL.Free;
      end;

      Crpe.Selection.Formula.Text := GetFiltrosRelatorio;
      Crpe.Execute;
      Crpe.HideWindow;
   end;
end;

