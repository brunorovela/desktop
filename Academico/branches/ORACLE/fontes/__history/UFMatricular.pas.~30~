   SMsgRestricoesComPermissao = 'A disciplina [%s] possui um ou mais impedimentos. Deseja realizar a matrícula mesmo assim?'#13'Impedimentos:'#13'%s';
var
   selecionada, remover: Boolean;
   sn_mostra_disciplinas_horarios,msgLogDisciplinas: String;
   OptativasSelecionadas: TStringList;
   qryVerificaRetorno: TUMZQuery;
   ponteiro: Pointer;
   Restricao: Integer;
   DiscHasPreReqEspecial: Boolean;
begin
   OptativasSelecionadas := TStringList.Create;
