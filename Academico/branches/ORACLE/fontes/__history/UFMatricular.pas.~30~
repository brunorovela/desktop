function TfMatricular.FindNode(TreeView: TTreeView; ParentNode: TTreeNode;
  const S: string): TTreeNode;
var
   Node: TTreeNode;
begin
   Result := nil;

   if ParentNode = nil then
      Node := TreeView.Items.GetFirstNode
   else
      Node := ParentNode.getFirstChild;

   while Node <> nil do
   begin
      if Node.Text = S then
      begin
         Result := Node;
         Break;
      end;
      Node := Node.getNextSibling;
   end;

   if Result = nil then
      if ParentNode = nil then
         Result := TreeView.Items.Add(TreeView.TopItem, S)
      else
         Result := TreeView.Items.AddChild(ParentNode, S);
end;

