   bbtnVoltar.Enabled := (NewTab > 0) and not (Ajuste and (NewTab = 1));
   bbtnAvancar.Enabled := NewTab + 1 < tsEtapas.Tabs.Count;
   pgcEtapas.ActivePageIndex := NewTab;
   pgcEtapas.ActivePage.SetFocus;
   bbtnFinalizar.Visible := NewTab = 5;
   btnComissao.Visible := DM.UsuarioLogado.TemPermissao(DM.UsuarioLogado.Pessoa.Codigo, 'UMFinanceiro.RepasseParceiro', npIncluir, false) and (NewTab = 5);

   bbtnCancelar.Enabled := NewTab < 5;
   if pgcEtapas.ActivePageIndex = 2 then
   begin
      tbLegenda.Visible := True;
      lbLegendaTitulo.Visible := True;
   end else begin
      tbLegenda.Visible := False;
      lbLegendaTitulo.Visible := False;
   end;
   AtualizaOrientacoes;
end;

procedure TfMatricular.tvDisciplinasSelDblClick(Sender: TObject);
var
   TreeView: TTreeView;
begin
   TreeView := TTreeView(Sender);

   if (TreeView.Selected <> nil) and
      (TreeView.Selected.Data <> nil) and
      cdsDisciplinas.BookmarkValid(TreeView.Selected.Data) then
   begin
      cdsDisciplinas.GotoBookmark(TreeView.Selected.Data);
      if cdsDisciplinasNR_RESTRICAO.AsInteger > 0 then
      begin
         if fMatricularDiscImpedmnts = nil then
         begin
            Application.CreateForm(
               TfMatricularDiscImpedmnts,
               fMatricularDiscImpedmnts
            );
         end;
         // Recupera o total de vagas da turma e se tem bloqueio pela número de vagas
         qryVagas.Close;
         qryVagas.ParamByName('NR_ANOSEMESTRE').AsInteger := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qryVagas.ParamByName('CD_TURMA').AsString := cdsDisciplinasCD_TURMA_MATRICULAR.AsString;
         qryVagas.Open;

         fMatricularDiscImpedmnts.Pessoa := Pessoa;
         fMatricularDiscImpedmnts.Disciplina := cdsDisciplinasCD_DISCIPLINA.AsInteger;
         fMatricularDiscImpedmnts.Etapa := cdsDisciplinasNR_ETAPA.AsInteger;
         fMatricularDiscImpedmnts.Grade := cdsDisciplinasCD_GRADE.AsInteger;
         fMatricularDiscImpedmnts.AnoSemestre := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         fMatricularDiscImpedmnts.Restricao := cdsDisciplinasNR_RESTRICAO.AsInteger;
         fMatricularDiscImpedmnts.Vagas := qryVagas.FieldByName('vagas').AsInteger;
         fMatricularDiscImpedmnts.BloqueiaVagas := qryVagas.FieldByName('sn_bloquear_vagas').AsInteger = 1;
         fMatricularDiscImpedmnts.Curso := cdsDisciplinasCD_CURSO.AsString;
         fMatricularDiscImpedmnts.Turma := cdsDisciplinasCD_TURMA_MATRICULAR.AsString;
         fMatricularDiscImpedmnts.SerieAluno := qryTurmaNR_SERIE.AsInteger;
         fMatricularDiscImpedmnts.PorcentagemAluno := getPorcentagemReprovacaoAluno(Pessoa, cdsDisciplinasCD_CURSO.AsString);
         fMatricularDiscImpedmnts.LoadImpedimentos;

         fMatricularDiscImpedmnts.Left := fMatricular.ClientOrigin.X + Round((fMatricular.Width - fMatricularDiscImpedmnts.Width)/2); // Centraliza no frame da matrícula
         fMatricularDiscImpedmnts.Top := fMatricular.ClientOrigin.Y;
         fMatricularDiscImpedmnts.ShowModal;
      end;
   end;
end;

