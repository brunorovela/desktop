   while not cdsDisciplinas.IsEmpty do cdsDisciplinas.Delete;

   if DM.variavel_parametro('sn_logica_matricula', False) = 'S' then
   begin
      // Busca a maior série das disciplinas reprovadas
      qyBuscaSerieReprovadas.Close;

      qyBuscaSerieReprovadas.ParamByName('codaluno').AsInteger :=
         qryMatriculaCD_PESSOA.AsInteger;
      qyBuscaSerieReprovadas.ParamByName('anosemestre').AsInteger :=
         qryMatriculaNR_ANOSEMESTRE.AsInteger;
      qyBuscaSerieReprovadas.ParamByName('curso').AsString :=
         qryMatriculaCD_CURSO.AsString;

      qyBuscaSerieReprovadas.Open;

      // SQL das obrigatórias
      qryDisciplinasObrigatorias.Close;
      qryDisciplinasObrigatorias.ParamByName('CD_PESSOA').AsInteger := qryMatriculaCD_PESSOA.AsInteger;
      qryDisciplinasObrigatorias.ParamByName('NR_ANOSEMESTRE').AsInteger :=
         qryMatriculaNR_ANOSEMESTRE.AsInteger;
      qryDisciplinasObrigatorias.ParamByName('SN_USA_ANOSEMESTRE').AsInteger :=
         Ord(DM.UsaAnosemestre);
      qryDisciplinasObrigatorias.ParamByName('CURSO').AsString := qryMatriculaCD_CURSO.AsString;
      qryDisciplinasObrigatorias.SQL.Text := ReplaceStr (qryDisciplinasObrigatorias.SQL.Text, ':CD_COLIGADA', DM.GetColigadas);
      qryDisciplinasObrigatorias.ParamByName('SN_MOSTRA_DISCIPLINAS_HORARIOS').AsString :=
            DM.variavel_parametro('sn_mostra_disciplinas_horarios');
      qryDisciplinasObrigatorias.ParamByName('TURMA').AsString := qryMatriculaCD_TURMA.AsString;
      qryDisciplinasObrigatorias.ParamByName('TURNO').AsString := qryMatriculaCursoCD_TURNO.AsString;
      qryDisciplinasObrigatorias.ParamByName('NR_SERIE').AsString := qyBuscaSerieReprovadas.FieldByName('serie').AsString;
      qryDisciplinasObrigatorias.Open;

      qryDisciplinasObrigatorias.First;

      while not qryDisciplinasObrigatorias.Eof do
      begin
         if slDisciplinasSel.IndexOf(
               qryDisciplinasObrigatorias.FieldByName('CD_CURSO').AsString+
               ';'+
               qryDisciplinasObrigatorias.FieldByName('CD_DISCIPLINA').AsString) = -1 then
         begin
            Restricao := qryDisciplinasObrigatorias.FieldByName('NR_RESTRICAO').AsInteger;

            if (Restricao and 2) <> 2 then
            begin
               DiscHasPreReqEspecial := HasPreRequisitoEspecial(
                  Pessoa,
                  qryDisciplinasObrigatorias.FieldByName('CD_DISCIPLINA').AsInteger,
                  qryMatriculaNR_ANOSEMESTRE.AsInteger,
                  qryDisciplinasObrigatorias.FieldByName('CD_GRADE').AsInteger,
                  qryDisciplinasObrigatorias.FieldByName('NR_ETAPA').AsInteger,
                  qryDisciplinasObrigatorias.FieldByName('CD_CURSO').AsString);

               if DiscHasPreReqEspecial then
                  Inc(Restricao, 2);
            
            end;

            cdsDisciplinas.Insert;
            cdsDisciplinasCD_CURSO.AsString := qryDisciplinasObrigatorias.FieldByName('CD_CURSO').AsString;
            cdsDisciplinasCD_TURMA.AsString := qryDisciplinasObrigatorias.FieldByName('CD_TURMA').AsString;
            cdsDisciplinasCD_DISCIPLINA.AsInteger := qryDisciplinasObrigatorias.FieldByName('CD_DISCIPLINA').AsInteger;
            cdsDisciplinasNM_DISCIPLINA.AsString := qryDisciplinasObrigatorias.FieldByName('NM_DISCIPLINA').AsString;
            cdsDisciplinasNR_RESTRICAO.AsInteger := Restricao;
            cdsDisciplinasNR_AULAS.AsFloat := qryDisciplinasObrigatorias.FieldByName('NR_AULAS').AsFloat;
            cdsDisciplinasCD_GRADE.AsInteger := qryDisciplinasObrigatorias.FieldByName('CD_GRADE').AsInteger;
            cdsDisciplinasNR_ETAPA.AsInteger := qryDisciplinasObrigatorias.FieldByName('NR_ETAPA').AsInteger;
            cdsDisciplinasNR_GRAU.AsInteger := qryDisciplinasObrigatorias.FieldByName('NR_GRAU').AsInteger;
            cdsDisciplinasCD_TURMA_MATRICULAR.AsString := qryDisciplinasObrigatorias.FieldByName('CD_TURMA').AsString;
            cdsDisciplinasCD_DISCIPLINA_GENERICA.Clear;
            cdsDisciplinasNM_DISCIPLINA_GENERICA.Clear;
            cdsDisciplinasSN_SELECIONADA.AsBoolean := TRUE;
            cdsDisciplinasSN_OBRIGATORIO.AsBoolean := TRUE;
            cdsDisciplinasVL_CREDITO.AsFloat :=
                  GetValorCreditoTurma(
                     qryMatriculaNR_ANOSEMESTRE.AsInteger,
                     cdsDisciplinasCD_TURMA.AsString);

            cdsDisciplinas.Post;
            cdsDisciplinas.Filtered := false;

            if cdsDisciplinas.Locate(
               'cd_curso;cd_turma;cd_disciplina;sn_obrigatorio',VarArrayOf([
               qryDisciplinasObrigatorias.FieldByName('CD_CURSO').AsString,
               qryDisciplinasObrigatorias.FieldByName('CD_TURMA').AsString,
               qryDisciplinasObrigatorias.FieldByName('CD_DISCIPLINA').AsString, false]),[loCaseInsensitive]
            ) then
            begin
               cdsDisciplinas.Delete;
            end;

            cdsDisciplinas.Filtered := True;

            slDisciplinasSel.Add(
               qryDisciplinasObrigatorias.FieldByName('CD_CURSO').AsString+
               ';'+
               qryDisciplinasObrigatorias.FieldByName('CD_DISCIPLINA').AsString);
         end;
         qryDisciplinasObrigatorias.Next();
      end;
   end;

   qryDisciplinasGrade.First;
   while not qryDisciplinasGrade.Eof do
   begin

      // Verifica se a disciplina é optativa (GENÉRICA)
      if qryDisciplinasGradeSN_OPTATIVA.AsInteger = 1 then
      begin
         // Busca as disciplinas optativas que substituem a genérica em questão
         qryDisciplinasOptativas.Close;
         qryDisciplinasOptativas.ParamByName('CD_PESSOA').AsInteger := Pessoa;
         qryDisciplinasOptativas.ParamByName('CD_CURSO').AsString := qryDisciplinasGradeCD_CURSO.AsString;
         qryDisciplinasOptativas.ParamByName('CD_TURMA').AsString := qryDisciplinasGradeCD_TURMA.AsString;
         qryDisciplinasOptativas.ParamByName('NR_SERIE').AsInteger := qryDisciplinasGradeNR_ETAPA.AsInteger;
         qryDisciplinasOptativas.ParamByName('CD_GRADE').AsInteger := qryDisciplinasGradeCD_GRADE.AsInteger;
         qryDisciplinasOptativas.ParamByName('CD_TURNO').AsString := qryMatriculaCursoCD_TURNO.AsString;
         qryDisciplinasOptativas.ParamByName('NR_ANOSEMESTRE').AsInteger := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qryDisciplinasOptativas.ParamByName('SN_USA_ANOSEMESTRE').AsInteger := Ord(DM.UsaAnosemestre);
         qryDisciplinasOptativas.ParamByName('SN_MOSTRA_DISCIPLINAS_HORARIOS').AsString := sn_mostra_disciplinas_horarios;
         qryDisciplinasOptativas.ParamByName('CD_DISCIPLINA_GENERICA').AsInteger := qryDisciplinasGradeCD_DISCIPLINA.AsInteger;
         qryDisciplinasOptativas.Open;

         qryDisciplinasOptativas.First;
         while (not qryDisciplinasOptativas.Eof) do
         begin

            // Se a disciplina Optativa Genérica possuir mais de uma optativa para escolher
            // passa todas para o lado de Disciplinas Disponíveis, pois o usuário precisa escolher
            // qual delas quer cursar
            if (qryDisciplinasOptativas.RecordCount > 1) or
               (OptativasSelecionadas.IndexOf(qryDisciplinasGradeCD_TURMA.AsString+'/'+qryDisciplinasOptativasCD_DISCIPLINA.AsString) >= 0) then
            begin
               selecionada := False;
            end else begin
               // Verifica se o usuário deseja manter as disciplinas com impedimentos como selecionadas
               selecionada := VerificaDesejaSelecionarDisciplina(
                                 qryDisciplinasOptativasCD_DISCIPLINA.AsInteger,
                                 qryDisciplinasGradeCD_CURSO.AsString,
                                 qryDisciplinasGradeCD_GRADE.AsInteger,
                                 qryDisciplinasGradeNR_ETAPA.AsInteger,
                                 qryDisciplinasOptativasNM_DISCIPLINA.AsString,
                                 qryDisciplinasOptativasNR_RESTRICAO.AsInteger
                              );
            end;

            Restricao := qryDisciplinasOptativasNR_RESTRICAO.AsInteger;

            if (Restricao and 2) <> 2 then
            begin
               DiscHasPreReqEspecial := HasPreRequisitoEspecial(
                  Pessoa,
                  qryDisciplinasOptativasCD_DISCIPLINA.AsInteger,
                  qryMatriculaNR_ANOSEMESTRE.AsInteger,
                  qryDisciplinasGradeCD_GRADE.AsInteger,
                  qryDisciplinasGradeNR_ETAPA.AsInteger,
                  qryDisciplinasGradeCD_CURSO.AsString);

               if DiscHasPreReqEspecial then
                  Inc(Restricao, 2);
            
            end;

            // Adiciona a disciplina normalmente
            cdsDisciplinas.Insert;
            cdsDisciplinasCD_CURSO.AsString := qryDisciplinasGradeCD_CURSO.AsString;
            cdsDisciplinasCD_TURMA.AsString := qryDisciplinasGradeCD_TURMA.AsString;
            cdsDisciplinasCD_DISCIPLINA.AsInteger := qryDisciplinasOptativasCD_DISCIPLINA.AsInteger;
            cdsDisciplinasNM_DISCIPLINA.AsString := qryDisciplinasOptativasNM_DISCIPLINA.AsString;
            cdsDisciplinasNR_RESTRICAO.AsInteger := Restricao;
            cdsDisciplinasNR_AULAS.AsFloat := qryDisciplinasOptativasNR_AULAS.AsFloat;
            cdsDisciplinasCD_GRADE.AsInteger := qryDisciplinasGradeCD_GRADE.AsInteger;
            cdsDisciplinasNR_ETAPA.AsInteger := qryDisciplinasGradeNR_ETAPA.AsInteger;
            cdsDisciplinasNR_GRAU.AsInteger := qryDisciplinasGradeNR_GRAU.AsInteger;
            cdsDisciplinasCD_TURMA_MATRICULAR.AsString := qryDisciplinasOptativasCD_TURMA.AsString;
            cdsDisciplinasCD_DISCIPLINA_GENERICA.AsInteger := qryDisciplinasGradeCD_DISCIPLINA.AsInteger;
            cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString := qryDisciplinasGradeNM_DISCIPLINA.AsString;
            cdsDisciplinasSN_SELECIONADA.AsBoolean := selecionada;
            cdsDisciplinasVL_CREDITO.AsFloat :=
                  GetValorCreditoTurma(
                     qryMatriculaNR_ANOSEMESTRE.AsInteger,
                     cdsDisciplinasCD_TURMA.AsString);
            // Se a disciplina foi selecionada, então coloca ela na lista de optativas já selecionadas
            // Essa lista é para impedir que o sistema selecione a disciplina optativa mais de uma vez (caso ela esteja em mais genéricas)
            if selecionada = True then
            begin
               OptativasSelecionadas.Add(qryDisciplinasGradeCD_TURMA.AsString+'/'+qryDisciplinasOptativasCD_DISCIPLINA.AsString);
            end;

            qryDisciplinasOptativas.Next;
         end;

      end else begin


         // Este IF é só valido caso use a lógica de matrícula do ISPTEC
         // Mas como o TStringList "slDisciplinasSel" estara sempre em branco
         // caso não usa a lógica do ISPTEC, esta verificação não ira interferir
         // em nada pois sempre retornará -1.
         if slDisciplinasSel.IndexOf(
            qryDisciplinasGradeCD_CURSO.AsString+
            ';'+
            qryDisciplinasGradeCD_DISCIPLINA.AsString) = -1 then
         begin
           // Verifica se o usuário deseja manter as disciplinas com impedimentos como selecionadas
           selecionada := VerificaDesejaSelecionarDisciplina(
                             qryDisciplinasGradeCD_DISCIPLINA.AsInteger,
                             qryDisciplinasGradeCD_CURSO.AsString,
                             qryDisciplinasGradeCD_GRADE.AsInteger,
                             qryDisciplinasGradeNR_ETAPA.AsInteger,
                             qryDisciplinasGradeNM_DISCIPLINA.AsString,
                             qryDisciplinasGradeNR_RESTRICAO.AsInteger
                          );


            Restricao := qryDisciplinasGradeNR_RESTRICAO.AsInteger;

            if (Restricao and 2) = 2 then
            begin
               DiscHasPreReqEspecial := HasPreRequisitoEspecial(
                  Pessoa,
                  qryDisciplinasGradeCD_DISCIPLINA.AsInteger,
                  qryMatriculaNR_ANOSEMESTRE.AsInteger,
                  qryDisciplinasGradeCD_GRADE.AsInteger,
                  qryDisciplinasGradeNR_ETAPA.AsInteger,
                  qryDisciplinasGradeCD_CURSO.AsString);

               if DiscHasPreReqEspecial then
                  Inc(Restricao, 2);
            
            end;

           // Adiciona a disciplina normalmente
           cdsDisciplinas.Insert;
           cdsDisciplinasCD_CURSO.AsString := qryDisciplinasGradeCD_CURSO.AsString;
           cdsDisciplinasCD_TURMA.AsString := qryDisciplinasGradeCD_TURMA.AsString;
           cdsDisciplinasCD_DISCIPLINA.AsInteger := qryDisciplinasGradeCD_DISCIPLINA.AsInteger;
           cdsDisciplinasNM_DISCIPLINA.AsString := qryDisciplinasGradeNM_DISCIPLINA.AsString;
           cdsDisciplinasNR_RESTRICAO.AsInteger := Restricao;
           cdsDisciplinasNR_AULAS.AsFloat := qryDisciplinasGradeNR_AULAS.AsFloat;
           cdsDisciplinasCD_GRADE.AsInteger := qryDisciplinasGradeCD_GRADE.AsInteger;
           cdsDisciplinasNR_ETAPA.AsInteger := qryDisciplinasGradeNR_ETAPA.AsInteger;
           cdsDisciplinasNR_GRAU.AsInteger := qryDisciplinasGradeNR_GRAU.AsInteger;
           cdsDisciplinasCD_TURMA_MATRICULAR.AsString := qryDisciplinasGradeCD_TURMA.AsString;
           cdsDisciplinasCD_DISCIPLINA_GENERICA.Clear;
           cdsDisciplinasNM_DISCIPLINA_GENERICA.Clear;
           cdsDisciplinasSN_SELECIONADA.AsBoolean := selecionada;
           cdsDisciplinasVL_CREDITO.AsFloat :=
                  GetValorCreditoTurma(
                     qryMatriculaNR_ANOSEMESTRE.AsInteger,
                     cdsDisciplinasCD_TURMA.AsString);
         end;
      end;


      msgLogDisciplinas := msgLogDisciplinas + ',' + qryDisciplinasGradeNM_DISCIPLINA.AsString;
      qryDisciplinasGrade.Next;
   end;

   if cdsDisciplinas.State = dsInsert then
      cdsDisciplinas.Post;

   if DM.variavel_parametro('sn_logica_matricula', false) = 'S' then
   begin
      cdsDisciplinasObrigatorias.Data := cdsDisciplinas.Data;

      cdsDisciplinasObrigatorias.Filtered := True;
      cdsDisciplinasObrigatorias.Filter := ' SN_OBRIGATORIO ';

      while not cdsDisciplinasObrigatorias.Eof do
      begin

         // Verifica conflitos
         qryVerificaRetorno := getHorariosConflito(qryMatriculaNR_ANOSEMESTRE.AsInteger, cdsDisciplinasObrigatorias.FieldByName('cd_turma').AsString, cdsDisciplinasObrigatorias.FieldByName('cd_disciplina').AsInteger);

         // Verifica se achou conflito com horários selecionados
         if not qryVerificaRetorno.Eof then
         begin

            while not qryVerificaRetorno.Eof do
            begin
               // Procura o registro no cds de disciplinas e remove ela das SELECIONADOS
               if cdsDisciplinas.Locate('cd_turma;cd_disciplina',
                  VarArrayOf([qryVerificaRetorno.FieldByName('turma').AsString, qryVerificaRetorno.FieldByName('disciplina').AsInteger]),
                  [loCaseInsensitive]) then
               begin
                  cdsDisciplinas.Edit;
                  cdsDisciplinasSN_SELECIONADA.AsBoolean := False;
                  cdsDisciplinas.Post;
               end;

               // Caso tenha removido uma obrigatório não necessita mais verificar
               // conflitos para a mesma pois ela não será adicionada
               if cdsDisciplinasObrigatorias.Locate('cd_turma;cd_disciplina',
                  VarArrayOf([qryVerificaRetorno.FieldByName('turma').AsString, qryVerificaRetorno.FieldByName('disciplina').AsInteger]),
                  [loCaseInsensitive]) then
               begin
                  cdsDisciplinasObrigatorias.Delete;
               end;

               qryVerificaRetorno.Next;
            end;
      end;

      cdsDisciplinasObrigatorias.Next;
      end;
   end;

   DM.setLog(1009, 'Inclusão', qryMatriculaCursoCD_PESSOA.AsString + ';' + cdsDisciplinasCD_CURSO.AsString + ';' + cdsDisciplinasCD_DISCIPLINA.AsString,
         Dm.getColigadaByTurma(cdsDisciplinasCD_TURMA.AsString,qryMatriculaNR_ANOSEMESTRE.AsInteger), 'Matrícula Desktop - disciplinas padrões: ' + Copy(msgLogDisciplinas,2,Length(msgLogDisciplinas)));

   cdsDisciplinas.Filtered := False;
   cdsDisciplinas.EnableControls;
   OptativasSelecionadas.Free;
end;

procedure TfMatricular.LoadDisciplinasGradeOnTreeView;
var
   NodeCurso, NodeTurma, NodeDisc: TTreeNode;
   i: integer;
begin
   tvDisciplinasSel.Items.BeginUpdate;
   tvDisciplinasSel.Items.Clear;

   // Apaga o nodo sem disciplina antes de adicionar qualquer disciplina
   checaRemoverNodoSemDisciplina;

   cdsDisciplinas.Filter := 'SN_SELECIONADA';
   cdsDisciplinas.Filtered := False;
   cdsDisciplinas.First;
   
   while not cdsDisciplinas.Eof do
   begin
      if cdsDisciplinasSN_SELECIONADA.AsBoolean then
      begin
         NodeCurso := FindNode(tvDisciplinasSel, nil, cdsDisciplinasCD_CURSO.AsString);
         NodeCurso.ImageIndex := 0;
         NodeCurso.SelectedIndex := 0;
      
         NodeTurma := FindNode(tvDisciplinasSel, NodeCurso, cdsDisciplinasCD_TURMA.AsString);
         NodeTurma.ImageIndex := 1;
         NodeTurma.SelectedIndex := 1;

         // Verifica se a disciplina inserida é OPTATIVA
         if not cdsDisciplinasCD_DISCIPLINA_GENERICA.IsNull then
         begin
            // Insere/Procura o nodo da disciplina GENÉRICA
            NodeDisc := FindNode(tvDisciplinasSel, NodeTurma, cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString);
            NodeDisc.ImageIndex := 3;
            NodeDisc.SelectedIndex := 3;

            // Inclui a disciplina filha dentro da Genérica
            NodeDisc := tvDisciplinasSel.Items.AddChild(NodeDisc, cdsDisciplinasNM_DISCIPLINA.AsString);
            NodeDisc.Data := cdsDisciplinas.GetBookmark;
            NodeDisc.ImageIndex := GetImageIndex(cdsDisciplinasNR_RESTRICAO.AsInteger);
            NodeDisc.SelectedIndex := NodeDisc.ImageIndex;

         end 
         else 
         begin
            // Insere a disciplina normalmente porque não é optativa
            NodeDisc := tvDisciplinasSel.Items.AddChild(NodeTurma, cdsDisciplinasNM_DISCIPLINA.AsString);
            NodeDisc.Data := cdsDisciplinas.GetBookmark;
            
            if cdsDisciplinasSN_OBRIGATORIO.AsBoolean then
            begin
               NodeDisc.ImageIndex := 10;
            end
            else
            begin
               NodeDisc.ImageIndex := GetImageIndex(cdsDisciplinasNR_RESTRICAO.AsInteger);
            end;
            
            NodeDisc.SelectedIndex := NodeDisc.ImageIndex;
         end;
      end;

      cdsDisciplinas.Next;
   end;

   // Se não ficou nenhum nodo para ser selecionado, cria um nodo padrão dizendo que não existem nodos selecionados
   checaAddNodoSemDisciplina;
   
   cdsDisciplinas.Filtered := False;
   tvDisciplinasSel.Items.EndUpdate;

   if tvDisciplinasSel.Items.Count > 0 then
      tvDisciplinasSel.TopItem.Expand(True);
end;

function TfMatricular.VerificaDesejaSelecionarDisciplina(cdDisciplina: Integer; cdCurso: String; cdGrade: Integer; nrSerie: Integer; nmDisciplina: String; nrRestricao: Integer): Boolean;
const
   SMsgRestricoesSemPermissao = 'A disciplina [%s] possui um ou mais impedimentos e, portanto, o aluno não pode ser matriculado.'#13'Impedimentos:'#13'%s';
   SMsgRestricoesComPermissao = 'A disciplina [%s] possui um ou mais impedimentos. Deseja realizar a matrícula mesmo assim?'#13'Impedimentos:'#13'%s';
var
   TemPermissao: Boolean;
   DiscHasPreReqEspecial: Boolean;
begin
   // Verifica se usuário possui permissão especial para matricular disciplinas com impedimentos
   TemPermissao := DM.UsuarioLogado.TemPermissao(1019, npEspecial, False);

   // VERIFICA SE A DISCIPLINA POSSUI ALGUMA RESTRIÇÃO (IMPEDIMENTO)
   // CASO POSSUIR CONFIRMA COM O USUÁRIO SE DESEJA ADICIONAR E MESMA (MEDIANTE PERMISSAO ESPECIAL)
   Result := True;

   if (nrRestricao and 2) = 2 then
   begin
      DiscHasPreReqEspecial := HasPreRequisitoEspecial(Pessoa, cdDisciplina,
         qryMatriculaNR_ANOSEMESTRE.AsInteger, cdGrade, nrSerie, cdCurso);

      if DiscHasPreReqEspecial then
         Inc(nrRestricao, 2);
            
   end;

   // A disciplina possui alguma restrição (impedimento)
   if nrRestricao > 0 then begin

      // Verifica se o usuário NÃO tem permissão, então remove a disciplina
      if not TemPermissao then
      begin
         MessageDlg(Format(SMsgRestricoesSemPermissao,
                  [nmDisciplina, GetImpedimentos(nrRestricao)]),
                   mtConfirmation, [mbOK], -1);
         Result := False;
      end
      else
      begin
         // O usuário possui a permissão então pergunta se ele deseja manter
         // a disciplina com restrição (impedimento) para ser matriculada
         if (MessageDlg(Format(SMsgRestricoesComPermissao,
               [nmDisciplina, GetImpedimentos(nrRestricao)]), mtConfirmation,
               [mbYes, mbNo], -1, mbNo) = mrNo) then
         begin
            // Se ele disser que não deseja manter a disciplina
            Result := False;
         end;
      end;

   end;

end;

function TfMatricular.VerificaDisciplinaReprovada(CodDisciplina: Integer;
  Curso: String; CodAluno, NrAnosemestre: Integer): Boolean;
const
   SQL_VERIFICA_SITUACAO = ' SELECT '+
      '  fi.disciplina '+
      ' FROM '+
      ' 	fichaindividual fi  '+
      ' WHERE '+
      ' 	fi.codigoaluno = :codigo_aluno '+
      ' 	AND  '+
      ' 	LEFT (anosemestre, 4) = ( '+
      ' 	SELECT '+
      ' 		LEFT (max(anosemestre), 4) '+
      ' 	FROM '+
      ' 		matriculas m '+
      ' 	WHERE '+
      ' 		m.codigoaluno = :codigo_aluno '+
      ' 	AND m.anosemestre < :anosemestre '+
      ' AND m.curso = :curso '+
      ' )and fi.curso = :curso '+
      ' and fi.situacao = :situacao '+
      ' and fi.disciplina = :codigo_disciplina '+
      '  ';
var
   qryVerificaSituacao: TUMZQuery;
begin

   Result := True;

   DM.CriarConsulta(qryVerificaSituacao);

   qryVerificaSituacao.SQL.Text := SQL_VERIFICA_SITUACAO;

   qryVerificaSituacao.ParamByName('codigo_aluno').AsInteger := CodAluno;
   qryVerificaSituacao.ParamByName('anosemestre').AsInteger := NrAnosemestre;
   qryVerificaSituacao.ParamByName('curso').AsString := Curso;
   qryVerificaSituacao.ParamByName('codigo_disciplina').AsInteger := CodDisciplina;
   qryVerificaSituacao.ParamByName('situacao').AsInteger := 9;

   qryVerificaSituacao.Open;

   if qryVerificaSituacao.RecordCount > 0 then
   begin
      qryVerificaSituacao.Close;

      qryVerificaSituacao.SQL.Text := SQL_VERIFICA_SITUACAO;

      qryVerificaSituacao.ParamByName('codigo_aluno').AsInteger := CodAluno;
      qryVerificaSituacao.ParamByName('anosemestre').AsInteger := NrAnosemestre;
      qryVerificaSituacao.ParamByName('curso').AsString := Curso;
      qryVerificaSituacao.ParamByName('codigo_disciplina').AsInteger := CodDisciplina;
      qryVerificaSituacao.ParamByName('situacao').AsInteger := 0;

      qryVerificaSituacao.Open;

      if qryVerificaSituacao.RecordCount > 0 then
      begin
         Result := False;
      end;
   end
   else
   begin
      Result := False;
   end;
end;

