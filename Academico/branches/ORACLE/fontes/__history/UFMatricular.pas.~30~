procedure TfMatricular.RegistraMatricula;
Var
   iColigada, iCodPessoa: Integer;
   qyDisciplinasAtivadas: TUMZQuery;
begin
   Dm.CriarConsulta(qyDisciplinasAtivadas);

   qryMatriculaCurso.DisableControls;
   if qryMatriculaCurso.State in [dsInsert, dsEdit] then
   begin
      qryMatriculaCurso.Post;
   end;
   qryMatricula.DisableControls;
   qryMatriculaCD_MATRICULA_CURSO.AsInteger :=
      qryMatriculaCursoCD_MATRICULA_CURSO.AsInteger;
   qryMatricula.Post;

   comissao_anosemestre := qryMatriculaNR_ANOSEMESTRE.AsInteger;
   comissao_turma := qryMatriculaCD_TURMA.AsString;
   comissao_codigoaluno := qryMatriculaCD_PESSOA.AsInteger;

   if qryFichaIndividual.Active then
   begin
      qryFichaIndividual.Close;
   end;
   qryFichaIndividual.ParamByName('NR_ANOSEMESTRE').AsInteger :=
      qryMatriculaNR_ANOSEMESTRE.AsInteger;
   qryFichaIndividual.ParamByName('CD_PESSOA').AsInteger := Pessoa;
   qryFichaIndividual.Open;

   if qryFichaindividualOptativas.Active then
   begin
      qryFichaindividualOptativas.Close;
   end;
   qryFichaindividualOptativas.ParamByName('NR_ANOSEMESTRE').AsInteger :=
      qryMatriculaNR_ANOSEMESTRE.AsInteger;
   qryFichaindividualOptativas.ParamByName('CD_PESSOA').AsInteger := Pessoa;
   qryFichaindividualOptativas.Open;

   cdsDisciplinas.DisableControls;
   cdsDisciplinas.Filter := 'SN_SELECIONADA';
   cdsDisciplinas.Filtered := True;
   cdsDisciplinas.First;

   while not cdsDisciplinas.Eof do
   begin
      qryFichaIndividual.Insert;       
      qryFichaIndividualNR_ANOSEMESTRE.AsInteger :=
         qryMatriculaNR_ANOSEMESTRE.AsInteger;
      qryFichaIndividualCD_PESSOA.AsInteger := Pessoa;
      qryFichaIndividualCD_TURMA_MATRICULA.AsString := qryMatriculaCD_TURMA.AsString;
      // O CD_TURMA_MATRICULAR do cdsDisciplinas contém a turma que será inserida na Fichaindividual,
      // caso tiver disciplinas optativas será a turma OPTATIVA dessas disciplinas
      qryFichaIndividualCD_TURMA.AsString := cdsDisciplinasCD_TURMA_MATRICULAR.AsString;
      qryFichaIndividualCD_DISCIPLINA.AsInteger := cdsDisciplinasCD_DISCIPLINA.AsInteger;
      qryFichaIndividualCD_SITUACAO.AsInteger := qryMatriculaCD_SITUACAO.AsInteger;
      qryFichaIndividualCD_CURSO.AsString := cdsDisciplinasCD_CURSO.AsString;
      qryFichaIndividualNR_SERIE.AsInteger := cdsDisciplinasNR_ETAPA.AsInteger;
      qryFichaIndividualNR_GRAU.AsInteger := cdsDisciplinasNR_GRAU.AsInteger;

      // Verifica se a disciplina inserida é OPTATIVA, nesse caso inclui na tabela de fichaindividual_optativas
      if not cdsDisciplinasCD_DISCIPLINA_GENERICA.IsNull then
      begin
         qryFichaindividualOptativas.Insert;
         qryFichaindividualOptativasNR_ANOSEMESTRE.AsInteger := qryFichaIndividualNR_ANOSEMESTRE.AsInteger;
         qryFichaindividualOptativasCD_TURMA.AsString := qryFichaIndividualCD_TURMA.AsString;
         qryFichaindividualOptativasCD_PESSOA.AsInteger := qryFichaIndividualCD_PESSOA.AsInteger;
         qryFichaindividualOptativasCD_DISCIPLINA.AsInteger := qryFichaIndividualCD_DISCIPLINA.AsInteger;
         qryFichaindividualOptativasNR_SERIE.AsInteger := qryFichaIndividualNR_SERIE.AsInteger;
         qryFichaindividualOptativasCD_TURMA_GENERICA.AsString := cdsDisciplinasCD_TURMA.AsString;
         qryFichaindividualOptativasCD_DISCIPLINA_GENERICA.AsInteger := cdsDisciplinasCD_DISCIPLINA_GENERICA.AsInteger;
      end;

      cdsDisciplinas.Next;
   end;

   if qryFichaIndividual.State = dsInsert then
   begin
      qryFichaIndividual.Post;
   end;

   if qryFichaindividualOptativas.State = dsInsert then
   begin
      qryFichaindividualOptativas.Post;
   end;

   DM.AtualizaDocumentacao(Pessoa, qryMatriculaCursoCD_CURSO.AsString);

   if DM.variavel_parametro('academico_historico_series_inserir') = 'S' then
   begin
      DM.Gerar_Series_Conclusao(Pessoa, qryMatriculaCD_CURSO.AsString,
         qryMatriculaNR_ANOSEMESTRE.AsInteger);
   end;

   if DM.variavel_parametro('africa_bolsas') <> 'S' then
   begin
      GeraMensalidadesBrasil;
   end
   else
   begin
      GeraMensalidadesAfrica;
   end;

   iCodPessoa := Pessoa;
   iColigada  := DM.getColigadaByTurma(qryMatriculaCD_TURMA.AsString, qryMatriculaNR_ANOSEMESTRE.AsInteger);
   // Atualizar grupos de pessoa
   DM.atualizarGruposPessoa(iCodPessoa,iColigada, true);

   DM.Ativar_Matricula(Pessoa, qryMatriculaCD_TURMA.AsString, qryMatriculaNR_ANOSEMESTRE.AsInteger);

   // Busca as disciplinas que serão ativadas
   qyDisciplinasAtivadas.Close;
   qyDisciplinasAtivadas.SQL.Clear;
   qyDisciplinasAtivadas.SQL.Add( 'SELECT anosemestre, turma, disciplina, codigoaluno FROM fichaindividual ' );
   qyDisciplinasAtivadas.SQL.Add( 'WHERE anoSemestre = ' + qryMatriculaNR_ANOSEMESTRE.AsString + ' and ');
   qyDisciplinasAtivadas.SQL.Add( 'turmamatricula = ' + QuotedStr(qryMatriculaCD_TURMA.AsString) + ' and ');
   qyDisciplinasAtivadas.SQL.Add( 'codigoaluno = ' + IntToStr(Pessoa));
   qyDisciplinasAtivadas.Open;

   // Após ativação inicia a matricula do aluno definindo as frequências das aulas retroativas 
   while not qyDisciplinasAtivadas.Eof do
   begin
    DM.callProcedure('CALL INICIAR_MATRICULA( ' +
      qyDisciplinasAtivadas.FieldByName('anosemestre').AsString + ', ' +
      QuotedStr(qyDisciplinasAtivadas.FieldByName('turma').AsString) + ', ' +
      qyDisciplinasAtivadas.FieldByName('disciplina').AsString + ', ' +
      qyDisciplinasAtivadas.FieldByName('codigoaluno').AsString + ')',
      False
    );
                          
    qyDisciplinasAtivadas.Next;
   end;

   self.atualizarRevisaoPessoa();

   DM.setLog(1009, 'Inclusão', IntToStr(Pessoa) + ';' + cdsDisciplinasCD_CURSO.AsString,
      iColigada, 'Matrícula Desktop - matrícula do aluno ' + IntToStr(Pessoa) + ' finalizada.');

end;

