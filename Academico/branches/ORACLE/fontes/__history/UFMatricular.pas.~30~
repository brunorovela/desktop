procedure TfMatricular.DeleteOldParents(Node: TTreeNode);
var
   Temp: TTreeNode;
begin
   while Node <> nil do
   begin
      if not Node.HasChildren then
      begin
         Temp := Node;
         Node := Node.Parent;
         Temp.Delete;
      end
      else
         Node := nil;
   end;
end;

