procedure TfMatricular.LoadDisciplinasDispOnDataSet;
var
   sn_mostra_disciplinas_horarios: String;
   DiscHasPreReqEspecial: Boolean;
   Restricao: Integer;
begin
   sn_mostra_disciplinas_horarios := DM.variavel_parametro('sn_mostra_disciplinas_horarios');

   cdsDisciplinas.DisableControls;
   cdsDisciplinas.Filter := 'NOT SN_SELECIONADA';
   cdsDisciplinas.Filtered := True;
   cdsDisciplinas.First;

   while not cdsDisciplinas.IsEmpty do cdsDisciplinas.Delete;

   qryDisciplinasDisp.First;
   while not qryDisciplinasDisp.Eof do
   begin

      // Verifica se a disciplina é optativa (GENÉRICA)
      if qryDisciplinasDispSN_OPTATIVA.AsInteger = 1 then
      begin
         // Busca as disciplinas optativas que substituem a genérica em questão
         qryDisciplinasOptativas.Close;
         qryDisciplinasOptativas.ParamByName('CD_PESSOA').AsInteger := Pessoa;
         qryDisciplinasOptativas.ParamByName('CD_CURSO').AsString := qryDisciplinasDispCD_CURSO.AsString;
         qryDisciplinasOptativas.ParamByName('CD_TURMA').AsString := qryDisciplinasDispCD_TURMA.AsString;
         qryDisciplinasOptativas.ParamByName('NR_SERIE').AsInteger := qryDisciplinasDispNR_ETAPA.AsInteger;
         qryDisciplinasOptativas.ParamByName('CD_GRADE').AsInteger := qryDisciplinasDispCD_GRADE.AsInteger;
         qryDisciplinasOptativas.ParamByName('CD_TURNO').AsString := qryMatriculaCursoCD_TURNO.AsString;
         qryDisciplinasOptativas.ParamByName('NR_ANOSEMESTRE').AsInteger := qryMatriculaNR_ANOSEMESTRE.AsInteger;
         qryDisciplinasOptativas.ParamByName('SN_USA_ANOSEMESTRE').AsInteger := Ord(DM.UsaAnosemestre);
         qryDisciplinasOptativas.ParamByName('SN_MOSTRA_DISCIPLINAS_HORARIOS').AsString := sn_mostra_disciplinas_horarios;
         qryDisciplinasOptativas.ParamByName('CD_DISCIPLINA_GENERICA').AsInteger := qryDisciplinasDispCD_DISCIPLINA.AsInteger;
         qryDisciplinasOptativas.Open;

         qryDisciplinasOptativas.First;
         while (not qryDisciplinasOptativas.Eof) do
         begin

            cdsDisciplinas.Filtered := False;
            // Não inclui disciplinas se elas já estão incluidas na guia de selecionadas
            if not cdsDisciplinas.Locate('cd_curso;cd_turma;cd_disciplina;cd_disciplina_generica;sn_selecionada', VarArrayOf([qryDisciplinasDispCD_CURSO.AsString, qryDisciplinasDispCD_TURMA.AsString, qryDisciplinasOptativasCD_DISCIPLINA.AsInteger, qryDisciplinasDispCD_DISCIPLINA.AsInteger, True]), [loCaseInsensitive]) then
            begin

               Restricao := qryDisciplinasOptativasNR_RESTRICAO.AsInteger;

               if (Restricao and 2) <> 2 then
               begin
                  DiscHasPreReqEspecial := HasPreRequisitoEspecial(
                     Pessoa,
                     qryDisciplinasOptativasCD_DISCIPLINA.AsInteger,
                     qryMatriculaNR_ANOSEMESTRE.AsInteger,
                     qryDisciplinasDispCD_GRADE.AsInteger,
                     qryDisciplinasDispNR_ETAPA.AsInteger,
                     qryDisciplinasDispCD_CURSO.AsString);

                  if DiscHasPreReqEspecial then
                     Inc(Restricao, 2);
            
               end;

               cdsDisciplinas.Filtered := True;
               // Adiciona a disciplina normalmente
               cdsDisciplinas.Insert;
               cdsDisciplinasCD_CURSO.AsString := qryDisciplinasDispCD_CURSO.AsString;
               cdsDisciplinasCD_TURMA.AsString := qryDisciplinasDispCD_TURMA.AsString;
               cdsDisciplinasCD_DISCIPLINA.AsInteger := qryDisciplinasOptativasCD_DISCIPLINA.AsInteger;
               cdsDisciplinasNM_DISCIPLINA.AsString := qryDisciplinasOptativasNM_DISCIPLINA.AsString;
               cdsDisciplinasNR_RESTRICAO.AsInteger := Restricao;
               cdsDisciplinasNR_AULAS.AsFloat := qryDisciplinasOptativasNR_AULAS.AsFloat;
               cdsDisciplinasCD_GRADE.AsInteger := qryDisciplinasDispCD_GRADE.AsInteger;
               cdsDisciplinasNR_ETAPA.AsInteger := qryDisciplinasDispNR_ETAPA.AsInteger;
               cdsDisciplinasNR_GRAU.AsInteger := qryDisciplinasDispNR_GRAU.AsInteger;
               cdsDisciplinasCD_TURMA_MATRICULAR.AsString := qryDisciplinasOptativasCD_TURMA.AsString;
               cdsDisciplinasCD_DISCIPLINA_GENERICA.AsInteger := qryDisciplinasDispCD_DISCIPLINA.AsInteger;
               cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString := qryDisciplinasDispNM_DISCIPLINA.AsString;
               cdsDisciplinasSN_SELECIONADA.AsBoolean := False;
               cdsDisciplinasVL_CREDITO.AsFloat :=
                  GetValorCreditoTurma(
                     qryMatriculaNR_ANOSEMESTRE.AsInteger,
                     cdsDisciplinasCD_TURMA.AsString);
            end;

            qryDisciplinasOptativas.Next;
         end;

      end else begin

         cdsDisciplinas.Filtered := False;
         // Não inclui disciplinas se elas já estão incluidas na guia de selecionadas
         if not cdsDisciplinas.Locate('cd_curso;cd_turma;cd_disciplina;sn_selecionada', VarArrayOf([qryDisciplinasDispCD_CURSO.AsString, qryDisciplinasDispCD_TURMA.AsString, qryDisciplinasDispCD_DISCIPLINA.AsInteger, True]), [loCaseInsensitive]) then
         begin
            Restricao := qryDisciplinasDispNR_RESTRICAO.AsInteger;

            if (Restricao and 2) <> 2 then
            begin
               DiscHasPreReqEspecial := HasPreRequisitoEspecial(
                  Pessoa,
                  qryDisciplinasDispCD_DISCIPLINA.AsInteger,
                  qryMatriculaNR_ANOSEMESTRE.AsInteger,
                  qryDisciplinasDispCD_GRADE.AsInteger,
                  qryDisciplinasDispNR_ETAPA.AsInteger,
                  qryDisciplinasDispCD_CURSO.AsString);

               if DiscHasPreReqEspecial then
                  Inc(Restricao, 2);
            
            end;

            cdsDisciplinas.Filtered := True;
            // Adiciona a disciplina normalmente
            cdsDisciplinas.Insert;
            cdsDisciplinasCD_CURSO.AsString := qryDisciplinasDispCD_CURSO.AsString;
            cdsDisciplinasCD_TURMA.AsString := qryDisciplinasDispCD_TURMA.AsString;
            cdsDisciplinasCD_DISCIPLINA.AsInteger := qryDisciplinasDispCD_DISCIPLINA.AsInteger;
            cdsDisciplinasNM_DISCIPLINA.AsString := qryDisciplinasDispNM_DISCIPLINA.AsString;
            cdsDisciplinasNR_RESTRICAO.AsInteger := Restricao;
            cdsDisciplinasNR_AULAS.AsFloat := qryDisciplinasDispNR_AULAS.AsFloat;
            cdsDisciplinasCD_GRADE.AsInteger := qryDisciplinasDispCD_GRADE.AsInteger;
            cdsDisciplinasNR_ETAPA.AsInteger := qryDisciplinasDispNR_ETAPA.AsInteger;
            cdsDisciplinasNR_GRAU.AsInteger := qryDisciplinasDispNR_GRAU.AsInteger;
            cdsDisciplinasCD_TURMA_MATRICULAR.AsString := qryDisciplinasDispCD_TURMA.AsString;
            cdsDisciplinasCD_DISCIPLINA_GENERICA.Clear;
            cdsDisciplinasNM_DISCIPLINA_GENERICA.Clear;
            cdsDisciplinasSN_SELECIONADA.AsBoolean := False;
            cdsDisciplinasVL_CREDITO.AsFloat :=
                  GetValorCreditoTurma(
                     qryMatriculaNR_ANOSEMESTRE.AsInteger,
                     cdsDisciplinasCD_TURMA.AsString);
         end;
      end;
      
      qryDisciplinasDisp.Next;
   end;

   if cdsDisciplinas.State = dsInsert then
      cdsDisciplinas.Post;

   cdsDisciplinas.Filtered := False;
   cdsDisciplinas.EnableControls;
end;

function TfMatricular.GetImageIndex(const Number: Integer): Integer;
begin
   if (Number and 32) = 32 then
      Result := 9
   else if (Number and 1) = 1 then
      Result := 4
   else if (Number and 2) = 2 then
      Result := 5
   else if (Number and 8) = 8 then
      Result := 6
   else if (Number and 4) = 4 then
      Result := 7
   else if (Number and 64) = 64 then
      Result := 7
   else if (Number and 16) = 16 then
      Result := 8
   else
      Result := 3;
end;

procedure TfMatricular.LoadDisciplinasDispOnTreeView;
var
   NodeCurso, NodeTurma, NodeDisc, Node: TTreeNode;
begin
   tvDisciplinasDisp.Items.BeginUpdate;
   tvDisciplinasDisp.Items.Clear;

   // Apaga o nodo sem disciplina antes de adicionar qualquer disciplina
   checaRemoverNodoSemDisciplina;

   cdsDisciplinas.Filter := 'NOT SN_SELECIONADA';
   cdsDisciplinas.Filtered := False;
   cdsDisciplinas.First;

   while not cdsDisciplinas.Eof do
   begin
      if not cdsDisciplinasSN_SELECIONADA.AsBoolean then
      begin
         NodeCurso := FindNode(tvDisciplinasDisp, nil, cdsDisciplinasCD_CURSO.AsString);
         NodeCurso.ImageIndex := 0;
         NodeCurso.SelectedIndex := 0;

         NodeTurma := FindNode(tvDisciplinasDisp, NodeCurso, cdsDisciplinasCD_TURMA.AsString);
         NodeTurma.ImageIndex := 1;
         NodeTurma.SelectedIndex := 1;
         NodeTurma.Collapse(True);

         // Verifica se a disciplina inserida é OPTATIVA
         if not cdsDisciplinasCD_DISCIPLINA_GENERICA.IsNull then
         begin
            // Insere/Procura o nodo da disciplina GENÉRICA
            NodeDisc := FindNode(tvDisciplinasDisp, NodeTurma, cdsDisciplinasNM_DISCIPLINA_GENERICA.AsString);
            NodeDisc.ImageIndex := 2;
            NodeDisc.SelectedIndex := 2;

            // Inclui a disciplina filha dentro da Genérica
            NodeDisc := tvDisciplinasDisp.Items.AddChild(NodeDisc, cdsDisciplinasNM_DISCIPLINA.AsString);
            NodeDisc.Data := cdsDisciplinas.GetBookmark;
            NodeDisc.ImageIndex := GetImageIndex(cdsDisciplinasNR_RESTRICAO.AsInteger);
            NodeDisc.SelectedIndex := NodeDisc.ImageIndex;

         end else begin
            // Insere a disciplina normalmente porque não é optativa
            NodeDisc := tvDisciplinasDisp.Items.AddChild(NodeTurma, cdsDisciplinasNM_DISCIPLINA.AsString);
            NodeDisc.Data := cdsDisciplinas.GetBookmark;
            NodeDisc.ImageIndex := GetImageIndex(cdsDisciplinasNR_RESTRICAO.AsInteger);
            NodeDisc.SelectedIndex := NodeDisc.ImageIndex;
         end;
         
      end;

      cdsDisciplinas.Next;
   end;

   cdsDisciplinas.Filtered := False;
   tvDisciplinasDisp.Items.EndUpdate;

   // Abre os nodos da Turma Matrícula que estiverem no lado Disponível para selecionar
   NodeCurso := FindNode(tvDisciplinasDisp, nil, qryMatriculaCD_CURSO.AsString);
   NodeCurso.Expand(True);
   NodeTurma := NodeCurso.getFirstChild;
   while NodeTurma <> nil do
   begin
      if NodeTurma.Text = qryMatriculaCD_TURMA.AsString then
      begin
         NodeTurma.Expand(True);
         NodeDisc := NodeTurma.GetLastChild;
         if NodeDisc <> nil then
         begin
            tvDisciplinasDisp.Select(NodeDisc);
         end else begin
            tvDisciplinasDisp.Select(NodeTurma);
         end;
      end else begin
         NodeTurma.Collapse(True);
      end;

      NodeTurma := NodeTurma.getNextSibling;
   end;

   // Caso o curso da matrícula não tenha turmas, remove ele da lista de disponíveis
   if not NodeCurso.HasChildren then
   begin
      NodeCurso.Delete;
   end;

   // Se não ficou nenhum nodo para ser selecionado, cria um nodo padrão dizendo que não existem nodos selecionados
   checaAddNodoSemDisciplina;

end;

