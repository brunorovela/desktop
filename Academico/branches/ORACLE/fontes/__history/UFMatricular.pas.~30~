procedure TfMatricular.CarregaDocumentosMatricula;
var
   I: Integer;
begin
   clbRelatorios.Items.BeginUpdate;
   clbRelatorios.Clear;
   qryRelatorio.DisableControls;
   
   if not qryRelatorio.Active then
   begin
      qryRelatorio.ParamByName('CD_CURSO').AsString := qryMatriculaCD_CURSO.AsString;
      qryRelatorio.ParamByName('CD_COLIGADA').AsInteger := qryTurmaCD_COLIGADA.AsInteger;
      qryRelatorio.Open;
   end
   else
   begin
      qryRelatorio.First;
   end;

   while not qryRelatorio.Eof do
   begin
      clbRelatorios.AddItem(
         qryRelatorioNM_RELATORIO.AsString,
