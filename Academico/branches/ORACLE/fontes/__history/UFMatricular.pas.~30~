   Result := '';

   if slLista.Count > 0 then
   begin
      Result := 'AND (T.CURSO, T.CODIGO, D.CODIGO) NOT IN ('+slLista.DelimitedText+')';
   end;

   slLista.Free;
   slSelecionados.Free;
end;

function TfMatricular.GetValorCreditoTurma(const AnoSemestre: Integer;
  const TurmaId: AnsiString): Double;
const
   SSQLSelectValorCreditoPlanoPadrao = ''
      + 'SELECT '
      + '	p.VL_COBRADO / COALESCE(p.NR_CREDITOS_BASE, 1) VL_CREDITO '
      + 'FROM '
      + '	turmas t '
      + '		JOIN fin_planos p ON '
      + '			(t.CD_PLANO_PADRAO = p.CD_PLANO) '
      + 'WHERE '
      + '	t.codigo = ? AND '
      + '	t.anosemestre = ? AND '
      + '	( '
      + '		p.sn_vigencia = 0 OR '
      + '		CURRENT_DATE BETWEEN DATE(p.dt_vigencia_inicio) AND DATE(p.dt_vigencia_fim) '
      + '	) ';
      
   SSQLSelectValorCreditoTurma = ''
      + 'SELECT '
      + '	p.VL_COBRADO / COALESCE(p.NR_CREDITOS_BASE, 1) VL_CREDITO '
      + 'FROM '
      + '	fin_planos_turmas pt '
      + '		JOIN fin_planos p ON '
      + '			(pt.CD_PLANO = p.CD_PLANO) '
      + 'WHERE '
      + '	pt.CD_TURMA = ? AND '
      + '	p.NR_ANOSEMESTRE = ? AND '
      + '	( '
      + '		p.sn_vigencia = 0 OR '
      + '		CURRENT_DATE BETWEEN DATE(p.dt_vigencia_inicio) AND DATE(p.dt_vigencia_fim) '
      + '	) '
      + 'ORDER BY '
      + '	p.CD_PLANO ASC '
      + 'LIMIT 1 ';
var
   Stmt: IZPreparedStatement;
   Rs: IZResultSet;
begin
   Result := 0;

   if not FUsarValorCreditoDisc then Exit;

   if TurmaId = qryMatriculaCD_TURMA.AsString then Exit;
   
   Stmt := PrepareStatement(SSQLSelectValorCreditoPlanoPadrao);
   try
      Stmt.SetString(1, TurmaId);
      Stmt.SetInt(2, AnoSemestre);
      Rs := Stmt.ExecuteQueryPrepared;
      try
         if Rs.Next then
            Result := Rs.GetDoubleByName('VL_CREDITO');
      finally
         Rs.Close;
      end;
   finally
      Stmt.Close;
      Stmt := nil;
   end;

   if Result <> 0 then
      Exit;

   Stmt := PrepareStatement(SSQLSelectValorCreditoTurma);
   try
      Stmt.SetString(1, TurmaId);
      Stmt.SetInt(2, AnoSemestre);
      Rs := Stmt.ExecuteQueryPrepared;
      try
         if Rs.Next then
            Result := Rs.GetDoubleByName('VL_CREDITO');
      finally
         Rs.Close;
      end;
   finally
      Stmt.Close;
      Stmt := nil;
   end;
end;

function TfMatricular.HasPreRequisitoEspecial(const PessoaID, DisciplinaID,
  AnoSemestre, GradeID, Serie: Integer; const CursoID: AnsiString): Boolean;
const
   SFilter = 'CD_CURSO = %s AND CD_GRADE = %d AND CD_DISCIPLINA = %d';
   SFmtInteger = '%d';
   SVarCurso = '[$CD_CURSO$]';
   SVarGrade = '[$CD_GRADE$]';
   SVarDisciplina = '[$CD_DISCIPLINA$]';
   SVarPessoa = '[$CD_PESSOA$]';
   SVarAnoSemestre = '[$NR_ANOSEM$]';
   SVarSerie = '[$NR_SERIE$]';
var
   S, SQL: AnsiString;
   ResultSet: IZResultSet;
begin
   Result := False;

   if not qryPreRequisitoEspecial.IsEmpty then
   begin
      S := Format(SFilter, [QuotedStr(CursoID), GradeID, DisciplinaID]);
      qryPreRequisitoEspecial.Filter := S;
      qryPreRequisitoEspecial.Filtered := True;

      if not qryPreRequisitoEspecial.IsEmpty then
      begin
         qryPreRequisitoEspecial.First;
         while not qryPreRequisitoEspecial.Eof do
         begin
            SQL := qryPreRequisitoEspecialME_TIPO_SQL.AsString;

            S := QuotedStr(CursoID);
            SQL := StringReplace(SQL, SVarCurso, S, [rfReplaceAll, rfIgnoreCase]);

            S := Format(SFmtInteger, [GradeID]);
            SQL := StringReplace(SQL, SVarGrade, S, [rfReplaceAll, rfIgnoreCase]);

            S := Format(SFmtInteger, [DisciplinaID]);
            SQL := StringReplace(SQL, SVarDisciplina, S, [rfReplaceAll, rfIgnoreCase]);

            S := Format(SFmtInteger, [PessoaID]);
            SQL := StringReplace(SQL, SVarPessoa, S, [rfReplaceAll, rfIgnoreCase]);

            S := Format(SFmtInteger, [AnoSemestre]);
            SQL := StringReplace(SQL, SVarAnoSemestre, S, [rfReplaceAll, rfIgnoreCase]);

            S := Format(SFmtInteger, [Serie]);
            SQL := StringReplace(SQL, SVarSerie, S, [rfReplaceAll, rfIgnoreCase]);

            ResultSet := ExecuteQuery(SQL);

            if ResultSet.Next then
            begin
               Result := True;
               Break;
            end;

            qryPreRequisitoEspecial.Next;
         end;
      end;

      qryPreRequisitoEspecial.Filtered := False;
   end;

end;

