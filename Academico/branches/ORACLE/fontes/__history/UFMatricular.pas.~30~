            qryDisciplinasDisp.Filter := qryDisciplinasDisp.Filter +
               ' NR_ETAPA <= ' +
               IntToStr(qryUltimaSerieNR_SERIE.AsInteger + 1);
         end;
      end;

      // Limpa o Data Client
      cdsDisciplinas.DisableControls;
      cdsDisciplinas.Filter := '';
      cdsDisciplinas.Filtered := False;
      cdsDisciplinas.First;

      while not cdsDisciplinas.IsEmpty do
         cdsDisciplinas.Delete;

      cdsDisciplinas.EnableControls;

      LoadDisciplinasDispOnDataSet;
      LoadDisciplinasGradeOnDataSet;
      LoadDisciplinasDispOnTreeView;
      LoadDisciplinasGradeOnTreeView;
      cdsDisciplinas.Locate('SN_SELECIONADA', True, []);
   end;
end;

procedure TfMatricular.tbsEtapaShow(Sender: TObject);
const
   STitInfo = 'Informação';
   SMsgRematricula = 'Você está realizando um processo de rematrícula.'#13'As informações da etapa exibidas são referentes ao próximo ano/semestre.';
   SQLTurma = 'SELECT ' +
              '   T.ANOSEMESTRE NR_ANOSEMESTRE, '+
              '   T.CODIGO CD_TURMA, '+
              '   T.CURSO CD_CURSO, '+
              '   T.GRAU NR_GRAU, '+
              '   T.SERIE NR_SERIE, '+
              '   T.TURNO CD_TURNO, '+
              '   T.DESCRICAO DS_TURMA, '+
              '   T.VAGAS NR_VAGAS, '+
              '   T.SN_BLOQUEAR_VAGAS, '+
              '   T.CD_COLIGADA, '+
              '   T.CD_GRADE, '+
              '   T.CD_SITUACAO, '+
              '   T.CD_PLANO_PADRAO, '+
              '   CC.CD_DEPTO, '+
              '   S.DS_VALOR DS_SITUACAO, '+
              '   T.CD_CENTRO, '+
              '   T.CD_CAIXA, '+
              '   c.cd_coligada_matriz AS cd_coligada_matriz, '+
              '   NOW() as data_atual '+
              'FROM '+
              '   TURMAS T '+
              'INNER JOIN CURSOS_COLIGADAS CC ON ( '+
              '   T.CD_COLIGADA = CC.CD_COLIGADA AND '+
              '   T.CURSO = CC.CD_CURSO '+
              ') '+
              'INNER JOIN coligadas c ON ( '+
              '   c.cd_coligada = t.cd_coligada '+
              ') '+
              'LEFT JOIN grades g ON ( '+
              '   t.cd_grade = g.CD_GRADE '+
              '   AND t.curso = g.CD_CURSO '+
              ')' +
              'LEFT JOIN SITUACOES S ON ( '+
              '   T.CD_SITUACAO = S.CD_SITUACAO AND '+
              '   S.CD_MODULO = 1148 '+
              ') '+
              'WHERE '+
              '   T.SN_ATIVA = 1 AND '+
              '   CC.CD_CURSO = :CD_CURSO AND '+
              '   ( '+
              '      (T.ANOSEMESTRE = :NR_ANOSEMESTRE AND :SN_USA_ANOSEMESTRE) OR '+
              '      (NOT :SN_USA_ANOSEMESTRE) '+
              '    ) AND '+
              '   T.CD_COLIGADA IN (:CD_COLIGADA) AND '+
              '   T.SERIE <> -100 AND '+
              '   T.turno :cd_turno AND '+
              '   (COALESCE(g.NR_PERC_MAX_REPROVACAO, 9999999) > :percReprovadaAluno OR t.serie <= :ultimaserie) ';
begin
   qryTurma.SQL.Text := SQLTurma;

   qryTurma.ParamByName('percReprovadaAluno').AsFloat := getPorcentagemReprovacaoAluno(
            qryMatriculaCursoCD_PESSOA.AsInteger,
            qryMatriculaCursoCD_CURSO.AsString
         );
   qryTurma.ParamByName('ultimaserie').AsInteger := qryUltimaSerieNR_SERIE.AsInteger;

   lblMatriculaAnoSem.Enabled := DM.UsaAnosemestre;
   dbeMatriculaAnoSem.Enabled := DM.UsaAnosemestre;

   // Verifica se é matrícula em um novo curso e quando utilizado rematrícula
   if (Length(RematriculaNovoCurso) > 0) and Ajuste and (qryMatriculaCurso.State = dsBrowse) then
   begin
      // Cria uma nova matrícula curso (dentro da etapa de rematrícula)
      qryMatriculaCurso.Insert;
   end;

   if qryMatricula.State = dsInactive then
   begin
      qryMatricula.Open;
      qryMatricula.Insert;
   end
   else if not (qryMatricula.State = dsInsert) then
   begin
      qryMatricula.Insert;
   end;

   if not qryUltimaSerie.Active then
   begin
      qryUltimaSerie.Open;
   end;

   if not qryUltimoAnoSem.Active then
   begin
      qryUltimoAnoSem.Open;
   end;

   VerificaQtdReprovadasIsptec;

   if not qryTurma.Active then
   begin
      qryTurma.ParamByName('SN_USA_ANOSEMESTRE').AsInteger :=
         Ord(DM.UsaAnosemestre);

      //Ao abrir a tela
      if cdColigadaBuscadaEtapa = 0 then
      begin
         cdColigadaBuscadaEtapa := cd_coligada;
      end;
      
      if cdColigadaBuscadaEtapa <> 0 then
      begin              //a
         qryTurma.ParamByName('cd_coligada').AsInteger := cdColigadaBuscadaEtapa;
      end else begin
         qryTurma.SQL.Text := ReplaceStr(qryTurma.SQL.Text, ':CD_COLIGADA', DM.GetColigadas);
      end;

      if DM.variavel_parametro('sn_logica_matricula', false) <> 'S' then
      begin
         // Inicia a série como um se não houver última turma ou caso for matrícula em um novo curso
         if qryUltimaSerie.IsEmpty OR (Length(RematriculaNovoCurso) > 0) then
         begin
            qryTurma.Filter := 'NR_SERIE = 1';
         end
         else
         begin
            qryTurma.Filter := Format('NR_SERIE = %d',
               [qryUltimaSerieNR_SERIE.AsInteger + 1]
            );
         end;
      end
      else
      begin
         // Aqui o sistema trabalha conforme lógica específica do cliente ISPTEC
         qryTurma.SQL.Add(' ORDER BY T.SERIE DESC, (CASE WHEN t.turno = :turno THEN 1 ELSE 0 END) DESC');
         qryTurma.ParamByName('turno').AsString := qryMatriculaCursoCD_TURNO.AsString;
      end;
   end;

   if not qryTotalMatriculas.Active then
   begin
      qryTotalMatriculas.Open;
   end;

   if not qryTurma.Active then
   begin

      //Filtra etapa
      if chkSoProxEtapa.Checked = True then
      begin
         qryTurma.SQL.Text := StringReplace(qryTurma.SQL.Text, ':cd_turno', ' = ''' + qryMatriculaCursoCD_TURNO.AsString + '''', [rfReplaceAll]);
      end
      else
      begin
         qryTurma.SQL.Text := StringReplace(qryTurma.SQL.Text, ':cd_turno', ' <>  "z"', [rfReplaceAll]);
      end;
      
      qryTurma.Open;
   end;

   if qryMatriculaCurso.State <> dsInsert then
   begin
      MessageBox(Handle, SMsgRematricula, STitInfo, MB_ICONINFORMATION or MB_OK);
   end;

   if Ajuste then
   begin
      //sbMatriculaSelCurso.Enabled := False;
      sbMatriculaSelInst.Enabled := False;
   end;

   if ((Ajuste) AND (DM.variavel_parametro('sn_logica_matricula', false) = 'S') AND (not alunoPodeTransitarFuncao()) ) then
   begin
      qryIngresso.Locate('CD_INGRESSO',1, [loCaseInsensitive]);
      qryMatriculaCD_INGRESSO.AsInteger := 1;
   end;
end;

