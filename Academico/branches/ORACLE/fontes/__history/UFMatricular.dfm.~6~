  object qryDisciplinasGradeHorarios: TUMZReadOnlyQuery
    Connection = DM.db
    SortedFields = 'CD_CURSO;CD_TURMA;NM_DISCIPLINA'
    SQL.Strings = (
      'SELECT'
      '    TH.CURSO CD_CURSO,'
      '    HEX(TH.CURSO) CD_CURSO_HEX,'
      '    H.TURMA CD_TURMA,'
      '    HEX(H.TURMA) CD_TURMA_HEX,'
      '    GD.CD_DISCIPLINA,'
      '    D.DESCRICAO NM_DISCIPLINA,'
      '    GD.NR_AULAS,'
      '    T.CD_GRADE,'
      '    GD.NR_SERIE NR_ETAPA,'
      '    T.GRAU NR_GRAU,'
      '    GD.SN_OPTATIVA,'
      
        '    CAST(FCD_GET_RESTRICAO_DISCIPLINA(:CD_PESSOA, TH.CURSO, T.CO' +
        'DIGO, D.CODIGO, TH.SERIE, TH.CD_GRADE, :NR_ANOSEMESTRE, :SN_MOST' +
        'RA_DISCIPLINAS_HORARIOS) AS CHAR) NR_RESTRICAO'
      'FROM'
      '      TURMAS as T'
      '      INNER JOIN TURMAS_HORARIOS as H ON ('
      
        '        T.CODIGO = H.TURMA_BASE AND T.ANOSEMESTRE = H.ANOSEMESTR' +
        'E)'
      '      INNER JOIN TURMAS as TH ON ('
      '        H.TURMA = TH.CODIGO AND H.ANOSEMESTRE = TH.ANOSEMESTRE)'
      '      INNER JOIN DISCIPLINAS AS D ON ('
      '        D.CODIGO = H.DISCIPLINA'
      '        AND TH.CURSO = D.CURSO'
      '      )'
      '      INNER JOIN GRADES_DISCIPLINAS AS GD ON ('
      '        TH.CD_GRADE = GD.CD_GRADE'
      '        AND TH.CURSO = GD.CD_CURSO'
      '        AND GD.CD_DISCIPLINA = D.CODIGO'
      '        AND GD.CD_CURSO = D.CURSO'
      '        AND GD.NR_SERIE = TH.SERIE'
      '      )'
      '      INNER JOIN CURSOS_MESTRE as C ON ('
