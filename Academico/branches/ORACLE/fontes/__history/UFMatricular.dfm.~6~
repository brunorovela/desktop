      'WHERE'
      '    T.CODIGO = :CD_TURMA AND'
      '    T.ANOSEMESTRE = :NR_ANOSEMESTRE AND'
      '    GD.NR_SERIE <> -100'
      'GROUP BY'
      '    T.CURSO,'
      '    H.TURMA,'
      '    GD.CD_DISCIPLINA,'
      '    D.DESCRICAO,'
      '    GD.NR_AULAS,'
