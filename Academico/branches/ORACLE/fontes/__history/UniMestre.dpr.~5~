var
   qtdTelas, telaAtual : Integer;

procedure atualizaQtdTelas(zerar : Boolean = False);
begin
   if zerar then
   begin
      qtdTelas := 6;
      telaAtual := 0;
   end;

   Inc(telaAtual);
   TfSplash.GetInstancia.ShowSplashScreen('', Format( 'Carregando recursos... %d de %d', [ telaAtual, qtdTelas ] ));
end;

begin
   // Ativa a exibição de objetos na memória que não foram destruídos. Obs.: Só exibe quando a execução é realizada pelo Delphi (DebugHook <> 0)
   //ReportMemoryLeaksOnShutdown := DebugHook <> 0;

   // Inicialização da aplicação
   Application.Initialize;
   Application.Title := 'UNIMESTRE';

   // Exibe a tela de splash
   TfSplash.GetInstancia.ShowSplashScreen();

   // Inicialização do formulário principal da aplicação
   Application.CreateForm(TPrincipalForm, PrincipalForm);
  // Inicializa o módulo de dados e carrega na memória as informações básicas
   // necessárias para inicialização do sistema e tenta efetuar conexão com o
   // banco de dados
   Application.CreateForm(TDM, DM);

   // Verifica se foi estabelecida conexão com o banco de dados e inicializa o
   // processo de autenticação do usuário no sistema

   if DM.db.Connected then
   begin

      // Executamos uma primeira fez a chamada do GetInstancia, para que o DM seja setado
      TLoginManager.GetInstancia(DM);

      // Carrega a variável se a versão é lite ou não
      DM.lite := DM.IsLite;

      // Verifica se a autenticação foi efetuada com sucesso e carrega na
      // memória os formulários mais comumente usados no sistema
      TfUMLogin.GetInstancia().Caption := Format('%s - [%s]',
         [DM.variavel_parametro('cliente_nome_fantasia'), DM.db.HostName]);

      if DM.lite then
         TfUMLogin.GetInstancia().Caption := TfUMLogin.GetInstancia().Caption + ' - LITE';

      TLoginManager.GetInstancia().RealizarLogin();
      if DM.UsuarioLogado <> nil then
      begin
         { No login, o sistema estava carregando informações que ainda não eram úteis para o mesmo,
            alterado para só executalas apartir do momento que o login é válido. }
         DM.CarregarInformacoesIniciaisDM();

         if TRemessaThread.Enabled then
         begin
            TRemessaThread.Instance.Resume;
         end;

         {$REGION 'Units Auxiliares do Sistema'}
            { Carregar telas auxiliares do Sistema.
              EVITAR ADICIONAR CRIAÇÃO DE UNITS AQUI,
              VERIFICAR POSSIBILIDADE DE USO DE SINGLETON PARA CASOS MAIS ESPECIFICOS DE UNICA INSTANCIA. }

            atualizaQtdTelas(True);
            Application.CreateForm(TfrmDinCh, frmDinCh);
            atualizaQtdTelas();
            Application.CreateForm(TfrmProcessando, frmProcessando);
            atualizaQtdTelas();
            Application.CreateForm(Tfrm_SelCentro, frm_SelCentro);
            atualizaQtdTelas();
            Application.CreateForm(Tfrm_SelConta, frm_SelConta);
            atualizaQtdTelas();
            Application.CreateForm(Tfrm_SelCaixa, frm_SelCaixa);
         {$ENDREGION}

         TfSplash.GetInstancia.CloseSplashScreen;
         Application.Run;

         // Destroi os Singletons do Sistema
         TLoginManager.GetInstancia().Destroy;
         TfSplash.GetInstancia().Destroy;
      end
      
      // Usuário não foi autenticado no sistema. Fecha a conexão com o banco de
      // dados e finaliza a aplicação
      else
      begin
         DM.Free;
         PrincipalForm.Close;
      end;
   end;
end.
