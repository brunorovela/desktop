  object qryTipoAvaliacao: TUMZReadOnlyQuery
    Connection = DM.db
    SortedFields = 'DS_AVALIACAO'
    SQL.Strings = (
      'SELECT'
      '  CD_AVALIACAO_TIPO,'
      '  DS_AVALIACAO'
      'FROM'
      '  AVALIACOES_TIPOS'
      'WHERE'
      '  CD_TIPO IN (1, 2) AND'
      '  SN_DIARIO_LOCAL = '#39'S'#39)
