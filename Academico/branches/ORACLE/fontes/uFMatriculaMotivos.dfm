  object qyMotivos: TUMZQuery
    Connection = DM.db
    BeforeOpen = qyMotivosBeforeOpen
    SQL.Strings = (
      'SELECT'
      '   m.cd_matricula_motivo,'
      '   p.NM_PESSOA ds_usuario,'
      '   m.nr_anosemestre,'
      '   m.cd_curso,'
      '   m.cd_turma,'
      '   m.dt_registro,'
      '   m.tx_motivo,'
      '   s.ds_situacao,'
      '   mm.ds_sigla,'
      '   m.cd_motivo,'
      '   p.cd_pessoa'
      'FROM'
      '   matriculas_motivos m'
      '      JOIN pessoas p ON (m.cd_usuario = p.CD_PESSOA)'
      '      JOIN situacao s ON (m.cd_situacao = s.cd_situacao)'
      '      LEFT JOIN situacoes mm ON (mm.cd_situacao = m.cd_motivo '
      '          and mm.cd_modulo = 1145)'
      'WHERE'
      '   m.cd_pessoa = :cd_pessoa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 64
    Top = 80
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qyMotivosds_usuario: TStringField
      FieldName = 'ds_usuario'
      Size = 30
    end
    object qyMotivosnr_anosemestre: TSmallintField
      FieldName = 'nr_anosemestre'
    end
    object qyMotivoscd_curso: TStringField
      FieldName = 'cd_curso'
      FixedChar = True
      Size = 15
    end
    object qyMotivoscd_turma: TStringField
      FieldName = 'cd_turma'
      FixedChar = True
      Size = 15
    end
    object qyMotivosdt_registro: TDateTimeField
      FieldName = 'dt_registro'
    end
    object qyMotivostx_motivo: TMemoField
      FieldName = 'tx_motivo'
      BlobType = ftMemo
      Size = 1
    end
    object qyMotivosds_situacao: TStringField
      FieldName = 'ds_situacao'
      Size = 15
    end
    object qyMotivosds_sigla: TStringField
      FieldName = 'ds_sigla'
      Size = 50
    end
    object qyMotivosCD_MATRICULA_MOTIVO: TLargeintField
      FieldName = 'CD_MATRICULA_MOTIVO'
    end
  end
