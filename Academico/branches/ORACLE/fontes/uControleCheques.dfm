  object qryGetAlunoCheque: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   C.CD_CHEQUE,'
      '   C.NR_VALOR,'
      '   C.DT_COMPENSACAO,'
      
        '   CONCAT('#39'Cheque '#39' ,DS_CHEQUE , '#39' Conta '#39' , DS_CONTA , '#39' / '#39' , ' +
        'DS_BANCO , '#39' / '#39' , DS_AGENCIA) HISTORICO,'
      '   M.CODIGOALUNO,'
      '   M.TURMA,'
      '   M.CURSO,'
      '   M.DEPTO,'
      '   M.ANOSEMESTRE,'
      '   M.CD_CENTRO_CUSTO,'
      '   M.CD_COLIGADA,'
      '   M.VALORTOTAL,'
      '   TE.vl_cheque'
      'FROM'
      '   FIN_CHEQUES C'
      '      JOIN FIN_CHEQUES_MENSALIDADES CM ON'
      '         (C.CD_CHEQUE = CM.CD_CHEQUE)'
      '         JOIN MENSALIDADES M ON'
      '            (CM.CD_MENSALIDADE = M.CD_MENSALIDADE)'
      '   LEFT JOIN fin_mov_tesouraria as te ON ('
      '    te.cd_mensalidade = m.cd_mensalidade AND'
      '    te.nr_estorno = 0 AND'
      '    TE.vl_cheque IS NOT NULL AND'
      '    te.tp_entrada_saida = 1'
      '   )'
      'WHERE'
      '   C.CD_CHEQUE = :CD_CHEQUE'
      'ORDER BY'
      
        '   m.codigoaluno, te.cd_mensalidade desc, CM.CD_CHEQUE_MENSALIDA' +
        'DE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_CHEQUE'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=SELECT'#13#10'   C.CD_CHEQUE,'#13#10'   C.NR_VALOR,'#13#10'   C.DT_COMPENSA' +
        'CAO,'#13#10'   ('#39'Cheque '#39' || DS_CHEQUE || '#39' Conta '#39' || DS_CONTA || '#39' /' +
        ' '#39' || DS_BANCO || '#39' / '#39' || DS_AGENCIA) HISTORICO,'#13#10'   M.CODIGOAL' +
        'UNO,'#13#10'   M.TURMA,'#13#10'   M.CURSO,'#13#10'   M.DEPTO,'#13#10'   M.ANOSEMESTRE,'#13#10 +
        '   M.CD_CENTRO_CUSTO,'#13#10'   M.CD_COLIGADA'#13#10'FROM'#13#10'   FIN_CHEQUES C'#13 +
        #10'      JOIN FIN_CHEQUES_MENSALIDADES CM ON'#13#10'         (C.CD_CHEQU' +
        'E = CM.CD_CHEQUE)'#13#10'         JOIN MENSALIDADES M ON'#13#10'            ' +
        '(CM.CD_MENSALIDADE = M.CD_MENSALIDADE)'#13#10'WHERE'#13#10'   C.CD_CHEQUE = ' +
        ':CD_CHEQUE'#13#10'ORDER BY'#13#10'   CM.CD_CHEQUE_MENSALIDADE'
      
        'mysql-5=SELECT'#13#10'   C.CD_CHEQUE,'#13#10'   C.NR_VALOR,'#13#10'   C.DT_COMPENS' +
        'ACAO,'#13#10'   CONCAT('#39'Cheque '#39', DS_CHEQUE, '#39' Conta '#39', DS_CONTA, '#39' / ' +
        #39', DS_BANCO, '#39' / '#39', DS_AGENCIA) HISTORICO,'#13#10'   M.CODIGOALUNO,'#13#10' ' +
        '  M.TURMA,'#13#10'   M.CURSO,'#13#10'   M.DEPTO,'#13#10'   M.ANOSEMESTRE,'#13#10'   M.CD' +
        '_CENTRO_CUSTO,'#13#10'   M.CD_COLIGADA,'#13#10'   M.VALORTOTAL,'#13#10'   TE.vl_ch' +
        'eque'#13#10'FROM'#13#10'   FIN_CHEQUES C'#13#10'      JOIN FIN_CHEQUES_MENSALIDADE' +
        'S CM ON'#13#10'         (C.CD_CHEQUE = CM.CD_CHEQUE)'#13#10'         JOIN ME' +
        'NSALIDADES M ON'#13#10'            (CM.CD_MENSALIDADE = M.CD_MENSALIDA' +
        'DE)'#13#10'   LEFT JOIN fin_mov_tesouraria as te ON ('#13#10'    te.cd_mensa' +
        'lidade = m.cd_mensalidade AND'#13#10'    te.nr_estorno = 0 AND'#13#10'    TE' +
        '.vl_cheque IS NOT NULL AND'#13#10'    te.tp_entrada_saida = 1'#13#10'   )'#13#10'W' +
        'HERE'#13#10'   C.CD_CHEQUE = :CD_CHEQUE'#13#10'ORDER BY'#13#10'   m.codigoaluno, t' +
        'e.cd_mensalidade desc, CM.CD_CHEQUE_MENSALIDADE')
    Left = 672
    Top = 64
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_CHEQUE'
        ParamType = ptUnknown
      end>
  end
  object qryGetValorTotalMensa: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   SUM(M.VALORTOTAL) AS valorTotalMensa,'
      '   count(DISTINCT m.codigoaluno) as nrAlunos,'
      '   count(m.cd_mensalidade) as nrMensalidades'
      'FROM'
      '   FIN_CHEQUES C'
      
        'INNER JOIN FIN_CHEQUES_MENSALIDADES CM ON (C.CD_CHEQUE = CM.CD_C' +
        'HEQUE)'
      
        'INNER JOIN MENSALIDADES M ON (CM.CD_MENSALIDADE = M.CD_MENSALIDA' +
        'DE)'
      'WHERE'
      '   C.CD_CHEQUE = :CD_CHEQUE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_CHEQUE'
        ParamType = ptUnknown
      end>
    Left = 704
    Top = 64
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_CHEQUE'
        ParamType = ptUnknown
      end>
  end
