  object qryCheques: TUMZReadOnlyQuery
    Connection = DM.db
    AfterOpen = qryChequesAfterOpen
    BeforeClose = qryChequesBeforeClose
    SQL.Strings = (
      'SELECT'
      '   C.CD_CHEQUE,'
      '   C.DS_CHEQUE,'
      '   C.NM_TITULAR,'
      '   C.DS_CONTA,'
      '   C.DS_BANCO,'
      '   C.DS_AGENCIA,'
      '   C.DT_COMPENSACAO,'
      '   C.CD_SITUACAO,'
      '   C.NR_VALOR,'
      '   C.CD_ORIGEM,'
      '   C.CD_CAIXA,'
      '   C.DT_EMISSAO,'
      
        '   LEFT(GROUP_CONCAT(DISTINCT IFNULL(M.CD_MENSALIDADE, '#39#39') SEPAR' +
        'ATOR '#39' / '#39'), 240) CD_MENSALIDADE,'
      
        '   LEFT(GROUP_CONCAT(DISTINCT IFNULL(M.CODIGOALUNO, '#39#39') SEPARATO' +
        'R '#39' / '#39'), 240) CODIGOALUNO,'
      
        '   LEFT(GROUP_CONCAT(CONCAT(IFNULL(M.PARCELA, '#39#39'), '#39'-'#39', M.ANOSEM' +
        'ESTRE) SEPARATOR '#39' / '#39'), 240) PARCELA,'
      
        '   LEFT(GROUP_CONCAT(DISTINCT IFNULL(M.TURMA, '#39#39') SEPARATOR '#39' / ' +
        #39'), 240) TURMA, '
      
        '   LEFT(GROUP_CONCAT(DISTINCT IFNULL(P.NM_PESSOA, '#39#39') SEPARATOR ' +
        #39' / '#39'), 240) NM_PESSOA, '
      '   COUNT(M.CD_MENSALIDADE) QTDMENSALIDADES,'
      '   COUNT(DISTINCT M.CODIGOALUNO) QTDALUNOS,'
      '   S.DS_VALOR SITUACAO,'
      '   CC.DS_CAIXA'
      'FROM'
      '   FIN_CHEQUES C '
      '      LEFT JOIN FIN_CHEQUES_MENSALIDADES CM ON'
      '         (C.CD_CHEQUE = CM.CD_CHEQUE)'
      '         LEFT JOIN MENSALIDADES M ON'
      '            (CM.CD_MENSALIDADE = M.CD_MENSALIDADE)'
      '            LEFT JOIN PESSOAS P ON'
      '               (M.CODIGOALUNO = P.CD_PESSOA)'
      '      LEFT JOIN FIN_CADASTRO_CONTAS CC ON'
      '         (CC.CD_CAIXA = C.CD_CAIXA)'
      '      JOIN SITUACOES S ON'
      '         (S.CD_SITUACAO = C.CD_SITUACAO)'
      'WHERE'
      '   S.CD_MODULO = 2050 %s'
      'GROUP BY'
      '   C.CD_CHEQUE'
      'ORDER BY'
      '   %s')
    Params = <>
    SQLList.Strings = (
      
        'oracle=SELECT'#13#10'   C.CD_CHEQUE,'#13#10'   C.DS_CHEQUE,'#13#10'   C.NM_TITULAR' +
        ','#13#10'   C.DS_CONTA,'#13#10'   C.DS_BANCO,'#13#10'   C.DS_AGENCIA,'#13#10'   C.DT_COM' +
        'PENSACAO,'#13#10'   C.CD_SITUACAO,'#13#10'   C.NR_VALOR,'#13#10'   C.CD_ORIGEM,'#13#10' ' +
        '  C.CD_CAIXA,'#13#10'   C.DT_EMISSAO,'#13#10'   REPLACE(LEFT(WM_CONCAT(DISTI' +
        'NCT NVL(M.CD_MENSALIDADE, '#39#39')), 240), '#39','#39', '#39' / '#39') CD_MENSALIDADE' +
        ','#13#10'   REPLACE(LEFT(WM_CONCAT(DISTINCT NVL(M.CODIGOALUNO, '#39#39')), 2' +
        '40), '#39','#39', '#39' / '#39') CODIGOALUNO,'#13#10'   REPLACE(LEFT(WM_CONCAT(NVL(M.P' +
        'ARCELA, '#39#39') || '#39'-'#39' || NVL(M.ANOSEMESTRE, '#39#39')), 240), '#39','#39', '#39' / '#39')' +
        ' PARCELA,'#13#10'   REPLACE(LEFT(WM_CONCAT(DISTINCT NVL(M.TURMA, '#39#39')),' +
        ' 240), '#39','#39', '#39' / '#39') TURMA,'#13#10'   REPLACE(LEFT(WM_CONCAT(DISTINCT NV' +
        'L(P.NM_PESSOA, '#39#39')), 240), '#39','#39', '#39' / '#39') NM_PESSOA,'#13#10'   CAST( COUN' +
        'T(M.CD_MENSALIDADE) AS NUMBER(19) ) QTDMENSALIDADES,'#13#10'   CAST( C' +
        'OUNT(DISTINCT M.CODIGOALUNO) AS NUMBER(19) ) QTDALUNOS,'#13#10'   S.DS' +
        '_VALOR SITUACAO,'#13#10'   CC.DS_CAIXA'#13#10'FROM'#13#10'   FIN_CHEQUES C'#13#10'      ' +
        'LEFT JOIN FIN_CHEQUES_MENSALIDADES CM ON'#13#10'         (C.CD_CHEQUE ' +
        '= CM.CD_CHEQUE)'#13#10'         LEFT JOIN MENSALIDADES M ON'#13#10'         ' +
        '   (CM.CD_MENSALIDADE = M.CD_MENSALIDADE)'#13#10'            LEFT JOIN' +
        ' PESSOAS P ON'#13#10'               (M.CODIGOALUNO = P.CD_PESSOA)'#13#10'   ' +
        '   LEFT JOIN FIN_CADASTRO_CONTAS CC ON'#13#10'         (C.CD_CAIXA = C' +
        'C.CD_CAIXA)'#13#10'      JOIN SITUACOES S ON'#13#10'         (C.CD_SITUACAO ' +
        '= S.CD_SITUACAO)'#13#10'WHERE'#13#10'   S.CD_MODULO = 2050 AND M.CD_COLIGADA' +
        ' IN ( %s ) %s'#13#10'GROUP BY'#13#10'   C.CD_CHEQUE,'#13#10'   C.DS_CHEQUE,'#13#10'   C.' +
        'DS_CONTA,'#13#10'   C.DS_BANCO,'#13#10'   C.DS_AGENCIA,'#13#10'   C.DT_COMPENSACAO' +
        ','#13#10'   C.CD_SITUACAO,'#13#10'   C.NR_VALOR,'#13#10'   C.CD_ORIGEM,'#13#10'   C.CD_C' +
        'AIXA,'#13#10'   C.DT_EMISSAO,'#13#10'   S.DS_VALOR,'#13#10'   CC.DS_CAIXA'#13#10'ORDER B' +
        'Y'#13#10'   %s'
      
        'mysql-5=SELECT'#13#10'   C.CD_CHEQUE,'#13#10'   C.DS_CHEQUE,'#13#10'   C.NM_TITULA' +
        'R,'#13#10'   C.DS_CONTA,'#13#10'   C.DS_BANCO,'#13#10'   C.DS_AGENCIA,'#13#10'   C.DT_CO' +
        'MPENSACAO,'#13#10'   C.CD_SITUACAO,'#13#10'   C.NR_VALOR,'#13#10'   C.CD_ORIGEM,'#13#10 +
        '   C.CD_CAIXA,'#13#10'   C.DT_EMISSAO,'#13#10'   LEFT(GROUP_CONCAT(DISTINCT ' +
        'IFNULL(M.CD_MENSALIDADE, '#39#39') SEPARATOR '#39' / '#39'), 240) CD_MENSALIDA' +
        'DE,'#13#10'   LEFT(GROUP_CONCAT(DISTINCT IFNULL(M.CODIGOALUNO, '#39#39') SEP' +
        'ARATOR '#39' / '#39'), 240) CODIGOALUNO,'#13#10'   LEFT(GROUP_CONCAT(CONCAT(IF' +
        'NULL(M.PARCELA, '#39#39'), '#39'-'#39', M.ANOSEMESTRE) SEPARATOR '#39' / '#39'), 240) ' +
        'PARCELA,'#13#10'   LEFT(GROUP_CONCAT(DISTINCT IFNULL(M.TURMA, '#39#39') SEPA' +
        'RATOR '#39' / '#39'), 240) TURMA, '#13#10'   LEFT(GROUP_CONCAT(DISTINCT IFNULL' +
        '(P.NM_PESSOA, '#39#39') SEPARATOR '#39' / '#39'), 240) NM_PESSOA, '#13#10'   COUNT(M' +
        '.CD_MENSALIDADE) QTDMENSALIDADES,'#13#10'   COUNT(DISTINCT M.CODIGOALU' +
        'NO) QTDALUNOS,'#13#10'   S.DS_VALOR SITUACAO,'#13#10'   CC.DS_CAIXA'#13#10'FROM'#13#10' ' +
        '  FIN_CHEQUES C '#13#10'      LEFT JOIN FIN_CHEQUES_MENSALIDADES CM ON' +
        #13#10'         (C.CD_CHEQUE = CM.CD_CHEQUE)'#13#10'         LEFT JOIN MENS' +
        'ALIDADES M ON'#13#10'            (CM.CD_MENSALIDADE = M.CD_MENSALIDADE' +
        ')'#13#10'            LEFT JOIN PESSOAS P ON'#13#10'               (M.CODIGOA' +
        'LUNO = P.CD_PESSOA)'#13#10'      LEFT JOIN FIN_CADASTRO_CONTAS CC ON'#13#10 +
        '         (CC.CD_CAIXA = C.CD_CAIXA)'#13#10'      JOIN SITUACOES S ON'#13#10 +
        '         (S.CD_SITUACAO = C.CD_SITUACAO)'#13#10'WHERE'#13#10'   S.CD_MODULO ' +
        '= 2050 %s'#13#10'GROUP BY'#13#10'   C.CD_CHEQUE'#13#10'ORDER BY'#13#10'   %s')
    Left = 672
