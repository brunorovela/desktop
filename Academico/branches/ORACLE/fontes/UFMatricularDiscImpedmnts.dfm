  object qryPreRequisitos: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   P.CD_CURSO,'
      '   P.CD_DISCIPLI_PRE,'
      '   D.DESCRICAO NM_DISCIPLINA'
      'FROM'
      '   DISCIPLINAS_PREREQ P'
      '      JOIN DISCIPLINAS D ON'
      '         (P.CD_DISCIPLI_PRE = D.CODIGO) AND'
      '         (P.CD_CURSO = D.CURSO)'
      'WHERE'
      '   P.CD_CURSO = :CD_CURSO AND'
      '   P.CD_DISCIPLI = :CD_DISCIPLINA AND'
      '   P.CD_GRADE = :CD_GRADE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_GRADE'
        ParamType = ptUnknown
      end>
    Left = 288
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_GRADE'
        ParamType = ptUnknown
      end>
    object qryPreRequisitosCD_CURSO: TStringField
      FieldName = 'CD_CURSO'
      Required = True
      Size = 15
    end
    object qryPreRequisitosCD_DISCIPLI_PRE: TIntegerField
      FieldName = 'CD_DISCIPLI_PRE'
      Required = True
    end
    object qryPreRequisitosNM_DISCIPLINA: TStringField
      FieldName = 'NM_DISCIPLINA'
      Size = 150
    end
  end
  object qryPreReqEspecial: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   T.DS_TIPO_REQ,'
      '   T.ME_TIPO_SQL'
      'FROM'
      '   DISCIPLINAS_PREREQ_ESPECIAL P'
      '      JOIN DISCIPLINAS_TIPOS_REQ T ON'
      '         (P.CD_TIPO_REQ = T.CD_TIPO_REQ)'
      'WHERE'
      '   P.CD_CURSO = :CD_CURSO AND'
      '   P.CD_GRADE = :CD_GRADE AND'
      '   P.CD_DISCIPLINA = :CD_DISCIPLINA')
