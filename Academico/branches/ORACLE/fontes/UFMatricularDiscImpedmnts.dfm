  object qryConflitoHorariosDisciplinasSel: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'disc.descricao disciplina,'
      #9'th_selecionadas.turma_base turma,'
      #9'th_selecionadas.dia_semana,'
      #9'horario.hr_inicio,'
      #9'horario.hr_fim'
      'FROM'
      #9'turmas_horarios th_disponivel'
      #9'INNER JOIN turmas_horarios th_selecionadas ON ('
      #9#9'th_selecionadas.dia_semana = th_disponivel.dia_semana AND'
      #9#9'th_selecionadas.cd_horario = th_disponivel.cd_horario AND'
      '    (th_selecionadas.anosemestre <> th_disponivel.anosemestre OR'
      '  '#9' th_selecionadas.turma_base <> th_disponivel.turma_base OR'
      #9'   th_selecionadas.disciplina <> th_disponivel.disciplina)'
      #9')'
      
        '  INNER JOIN disciplinas disc ON (disc.codigo = th_selecionadas.' +
        'disciplina)'
      
        #9'INNER JOIN horarios horario ON (th_selecionadas.cd_horario = ho' +
        'rario.codigo)'
      'WHERE'
      #9'th_disponivel.anosemestre = :NR_ANOSEMESTRE AND'
      #9'th_disponivel.turma_base = :CD_TURMA AND'
      #9'th_disponivel.disciplina = :CD_DISCIPLINA AND'
      '  disc.curso LIKE :CD_CURSO AND'
      
        #9'(th_selecionadas.anosemestre, th_selecionadas.turma_base, th_se' +
        'lecionadas.disciplina) IN'
      '  (:TURMAS_DISC_SELECIONADAS)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TURMAS_DISC_SELECIONADAS'
        ParamType = ptUnknown
      end>
    Left = 328
    Top = 88
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TURMAS_DISC_SELECIONADAS'
        ParamType = ptUnknown
      end>
