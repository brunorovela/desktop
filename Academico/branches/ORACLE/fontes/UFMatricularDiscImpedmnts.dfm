  object qryConflitoHorars: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT DISTINCT'
      '  TH_2.CD_HORARIO,'
      '  TH_2.DIA_SEMANA,'
      '  D.CODIGO CD_DISCIPLINA,'
      '  D.DESCRICAO NM_DISCIPLINA,'
      '  H.HR_INICIO,'
      '  H.HR_FIM'
      'FROM'
      '  FICHAINDIVIDUAL F'
      '     JOIN SITUACAO S ON'
      '        (F.SITUACAO = S.CD_SITUACAO)'
      '     JOIN TURMAS_HORARIOS TH_1 ON'
      '        (F.ANOSEMESTRE = TH_1.ANOSEMESTRE) AND'
      '        (F.TURMA = TH_1.TURMA) AND'
      '        (F.DISCIPLINA = TH_1.DISCIPLINA)'
      '     JOIN TURMAS_HORARIOS TH_2 ON'
      '        (F.ANOSEMESTRE = TH_2.ANOSEMESTRE) AND'
      '        (TH_1.CD_HORARIO = TH_2.CD_HORARIO) AND'
      '        (TH_1.DIA_SEMANA = TH_2.DIA_SEMANA)'
      '     JOIN DISCIPLINAS D ON'
      '        (F.CURSO = D.CURSO) AND'
      '        (F.DISCIPLINA = D.CODIGO)'
      '        JOIN HORARIOS H ON'
      '           (TH_1.CD_HORARIO = H.CODIGO)'
      'WHERE'
      '  S.CD_SITUACAO_PAI NOT IN (3, 4, 5, 6, 7, 8) AND'
      '  F.CODIGOALUNO = :CD_PESSOA AND'
      '  F.ANOSEMESTRE = :NR_ANOSEMESTRE AND'
      '  TH_2.TURMA = :CD_TURMA AND'
      '  TH_2.DISCIPLINA = :CD_DISCIPLINA AND'
      '  TH_1.DISCIPLINA != TH_2.DISCIPLINA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end>
    Left = 288
    Top = 88
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end>
    object qryConflitoHorarsCD_HORARIO: TSmallintField
      FieldName = 'CD_HORARIO'
      Required = True
    end
    object qryConflitoHorarsDIA_SEMANA: TSmallintField
      FieldName = 'DIA_SEMANA'
      Required = True
    end
    object qryConflitoHorarsCD_DISCIPLINA: TIntegerField
      FieldName = 'CD_DISCIPLINA'
      Required = True
    end
    object qryConflitoHorarsNM_DISCIPLINA: TStringField
      FieldName = 'NM_DISCIPLINA'
      Size = 150
    end
    object qryConflitoHorarsHR_INICIO: TTimeField
      FieldName = 'HR_INICIO'
    end
    object qryConflitoHorarsHR_FIM: TTimeField
      FieldName = 'HR_FIM'
    end
  end
  object qryMatriculasDisc: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   COUNT(F.CODIGOALUNO) NR_MATRICULAS'
      'FROM'
      '   FICHAINDIVIDUAL F'
      '      JOIN SITUACAO S ON'
      '         (F.SITUACAO = S.CD_SITUACAO)'
      'WHERE'
      '   S.CD_SITUACAO_PAI NOT IN (3, 4, 5, 6, 7, 8) AND'
      '   F.TURMA = :CD_TURMA AND'
      '   F.DISCIPLINA = :CD_DISCIPLINA AND'
      '   F.ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    Left = 288
    Top = 128
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_DISCIPLINA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    object qryMatriculasDiscNR_MATRICULAS: TLargeintField
      FieldName = 'NR_MATRICULAS'
      ReadOnly = True
    end
  end
