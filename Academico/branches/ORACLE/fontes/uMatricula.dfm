        'redito_parcela, :nr_creditos, :cd_mensalidade_origem, :cd_tipo_t' +
        'itulo, :cd_plano_conta, :cd_centro_custo, :ds_historico,  :cd_co' +
        'ligada, :cd_resp, :cd_bolsa, :cd_caixa, :cd_item_plano)')
