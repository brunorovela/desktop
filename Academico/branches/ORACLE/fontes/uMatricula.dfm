  object qySituacoes: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT cd_situacao, ds_valor, ds_sigla FROM situacoes WHERE cd_m' +
        'odulo = 1019 ORDER by ds_valor')
    Params = <>
    Left = 680
  end
  object tblTurmas: TUMZQuery
    Connection = DM.db
    SortedFields = 'CODIGO'
    Filtered = True
    SQL.Strings = (
      'SELECT'
      '   T.CODIGO,'
      '   T.ANOSEMESTRE,'
      '   T.CD_COLIGADA,'
      '   T.CURSO,'
      '   CC.CD_DEPTO,'
      '   T.CD_CENTRO,'
      '   T.SN_BLOQUEAR_DISC_PENDENTES,'
      '   T.TURNO,'
      '   T.CD_GRADE,'
      '   T.SERIE,'
      '   T.DESCRICAO,'
      '   T.VAGAS,'
      
        '   COALESCE((SELECT COUNT(DISTINCT M.CD_MATRICULA_CURSO) FROM MA' +
        'TRICULAS M JOIN SITUACAO S ON (M.SITUACAO = S.CD_SITUACAO) WHERE' +
        ' M.TURMA = T.CODIGO AND M.ANOSEMESTRE = T.ANOSEMESTRE AND S.CD_S' +
        'ITUACAO_PAI NOT IN (3, 4, 6, 7, 8) GROUP BY T.CODIGO, T.ANOSEMES' +
        'TRE), 0) NR_MATRICULAS'
      'FROM'
      '   TURMAS T'
      '      JOIN CURSOS_COLIGADAS CC ON'
      '         (T.CURSO = CC.CD_CURSO) AND'
      '         (T.CD_COLIGADA = CC.CD_COLIGADA)'
      '         JOIN CURSOS_MESTRE C ON'
      '            (CC.CD_CURSO = C.CD_CURSO)'
      'WHERE'
      '   CC.SN_ATIVO = 1 AND'
      '   T.ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    IndexFieldNames = 'CODIGO Asc'
    Left = 664
    Top = 316
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    object tblTurmasCODIGO: TStringField
      FieldName = 'CODIGO'
      Required = True
      Size = 50
    end
