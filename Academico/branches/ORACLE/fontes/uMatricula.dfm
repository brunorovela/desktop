  object qyTmpMensa: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT m.*, a.nm_pessoa nm_aluno, r.nm_pessoa nm_resp, t.ds_tipo' +
        '_titulo FROM tmp_mensalidades m'
      'INNER JOIN pessoas a ON (m.cd_aluno = a.cd_pessoa) '
      'INNER JOIN pessoas r ON (m.cd_resp = r.cd_pessoa)'
      
        'INNER JOIN fin_tipos_titulo t ON (m.cd_tipo_parcela = t.cd_tipo_' +
        'titulo AND t.cd_coligada =:cd_coligada)'
      'WHERE m.cd_aluno = :cd_aluno'
      'ORDER BY cd_resp, dt_vencimento, nr_parcela, t.ds_tipo_titulo')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'cd_aluno'
        ParamType = ptUnknown
      end>
    Left = 600
    Top = 344
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'cd_aluno'
        ParamType = ptUnknown
      end>
