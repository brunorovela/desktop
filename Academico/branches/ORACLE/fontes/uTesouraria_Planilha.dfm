  object qyCalcCC: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   LEFT(GROUP_CONCAT(FT.CD_CONTA), 150) CD_CONTA,'
      '   CC.CD_CENTRO,'
      '   CC.DS_CENTRO,'
      
        '   LEFT(CAST(GROUP_CONCAT(PC.DS_CONTA SEPARATOR '#39' / '#39') AS CHAR),' +
        '150) DS_CONTA'
      'FROM'
      '   FIN_APROPRIA_TE FT'
      '      JOIN FIN_CENTRO_CUSTOS CC ON'
      '         (FT.CD_COLIGADA = CC.CD_COLIGADA) AND'
      '         (FT.CD_CENTRO = CC.CD_CENTRO)'
      '      JOIN FIN_PLANO_CONTAS PC ON'
      '         (FT.CD_COLIGADA = PC.CD_COLIGADA) AND'
      '         (FT.CD_CONTA = PC.CD_CONTA)'
      'WHERE'
      '   FT.CD_MOVIMENTO_TE = :CD_MOVIMENTO_TE'
      'GROUP BY'
      '   CC.CD_CENTRO,'
      '   CC.DS_CENTRO,'
      '   PC.DS_CONTA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_MOVIMENTO_TE'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=SELECT'#13#10'   GROUP_CONCAT(TE.CD_CONTA) CD_CONTA,'#13#10'   CC.CD_' +
        'CENTRO,'#13#10'   CC.DS_CENTRO,'#13#10'   GROUP_CONCAT(PC.DS_CONTA SEPARATOR' +
        ' '#39' / '#39') DS_CONTA'#13#10'FROM'#13#10'   FIN_APROPRIA_TE FT'#13#10'      JOIN FIN_CE' +
        'NTRO_CUSTOS CC ON'#13#10'         (FT.CD_COLIGADA = CC.CD_COLIGADA) AN' +
        'D'#13#10'         (FT.CD_CENTRO = CC.CD_CENTRO)'#13#10'      JOIN FIN_PLANO_' +
        'CONTAS PC ON'#13#10'         (FT.CD_COLIGADA = PC.CD_COLIGADA) AND'#13#10'  ' +
        '       (FT.CD_CONTA = PC.CD_CONTA)'#13#10'WHERE'#13#10'   FT.CD_MOVIMENTO_TE' +
        ' = :CD_MOVIMENTO_TE AND'#13#10'   FT.CD_COLIGADA = :CD_COLIGADA'#13#10'GROUP' +
        ' BY'#13#10'   CC.CD_CENTRO,'#13#10'   CC.DS_CENTRO,'#13#10'   PC.DS_CONTA'
      
        'mysql-5=SELECT'#13#10'   LEFT(CAST(GROUP_CONCAT(FT.CD_CONTA) AS CHAR),' +
        '150) CD_CONTA,'#13#10'   CC.CD_CENTRO,'#13#10'   CC.DS_CENTRO,'#13#10'   LEFT(CAST' +
        '(GROUP_CONCAT(PC.DS_CONTA SEPARATOR '#39' / '#39') AS CHAR),150) DS_CONT' +
        'A'#13#10'FROM'#13#10'   FIN_APROPRIA_TE FT'#13#10'      JOIN FIN_CENTRO_CUSTOS CC ' +
        'ON'#13#10'         (FT.CD_COLIGADA = CC.CD_COLIGADA) AND'#13#10'         (FT' +
        '.CD_CENTRO = CC.CD_CENTRO)'#13#10'      JOIN FIN_PLANO_CONTAS PC ON'#13#10' ' +
        '        (FT.CD_COLIGADA = PC.CD_COLIGADA) AND'#13#10'         (FT.CD_C' +
        'ONTA = PC.CD_CONTA)'#13#10'WHERE'#13#10'   FT.CD_MOVIMENTO_TE = :CD_MOVIMENT' +
        'O_TE'#13#10'GROUP BY'#13#10'   CC.CD_CENTRO')
    Left = 440
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_MOVIMENTO_TE'
        ParamType = ptUnknown
      end>
    object qyCalcCCCD_CONTA: TStringField
      FieldName = 'CD_CONTA'
      ReadOnly = True
      Size = 4000
    end
    object qyCalcCCDS_CENTRO: TStringField
      FieldName = 'DS_CENTRO'
      Size = 255
    end
    object qyCalcCCCD_CENTRO: TIntegerField
      FieldName = 'CD_CENTRO'
    end
    object qyCalcCCDS_CONTA: TStringField
      DisplayWidth = 255
      FieldName = 'DS_CONTA'
    end
  end
