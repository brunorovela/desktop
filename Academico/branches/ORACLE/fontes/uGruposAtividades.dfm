  object qyGrupos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'dg.cd_grupo,'
      #9'dg.nm_grupo,'
      #9'dg.cd_curso,'
      #9'dg.cd_turma,'
      '                dg.nr_anosemestre,'
      '  dg.cd_disciplina,'
      '  d.descricao as descDisc,'
      #9'prof.nm_pessoa nm_professor,'
      '                prof.cd_pessoa as cd_professor,'
      '               dg.nr_max_alunos,'
      
        #9'CONCAT(SUM(CASE WHEN dgp.dt_saida IS NULL THEN 1 ELSE 0 END),'#39'/' +
        #39',dg.nr_max_alunos) nr_alunos_grupo,'
      #9'CASE WHEN dg.sn_ativo = 1 THEN '#39'Sim'#39' ELSE '#39'N'#227'o'#39' END sn_ativo,'
      
        '  LEFT((SELECT GROUP_CONCAT(alu.nm_pessoa SEPARATOR ", ") FROM d' +
        'iario_grupos_pessoas dgpc INNER JOIN pessoas alu ON (dgpc.cd_pes' +
        'soa = alu.cd_pessoa AND dgpc.dt_saida IS NULL) WHERE dgpc.cd_gru' +
        'po = dg.cd_grupo), 255) nome_alunos'
      'FROM'
      #9'diario_grupos dg'
      #9'INNER JOIN pessoas prof ON (prof.cd_pessoa = dg.cd_professor)'
      
        #9'LEFT JOIN diario_grupos_pessoas dgp ON (dgp.cd_grupo = dg.cd_gr' +
        'upo)'
      
        '  LEFT JOIN pessoas alu ON (alu.cd_pessoa = dgp.cd_pessoa AND dg' +
        'p.dt_saida IS NULL)'
      
        '  LEFT JOIN disciplinas D on (d.codigo = dg.cd_disciplina and dg' +
        '.cd_curso = d.curso)'
      'WHERE'
      #9'dg.nr_anosemestre = :nr_anosemestre AND'
      #9'dg.cd_curso LIKE :cd_curso AND'
      #9'dg.cd_turma LIKE :cd_turma AND'
      #9'dg.cd_disciplina = :cd_disciplina AND'
      #9'dg.cd_professor = :cd_professor AND'
      #9'dg.sn_ativo = :sn_ativo AND'
      #9'dgp.cd_pessoa = :cd_aluno'
      'GROUP BY'
      #9'dg.cd_grupo')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_disciplina'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_professor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sn_ativo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_aluno'
        ParamType = ptUnknown
      end>
    Left = 288
    Top = 240
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_disciplina'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_professor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'sn_ativo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_aluno'
        ParamType = ptUnknown
      end>
