  object qyVerificaExcluirGrupo: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'COUNT(da.cd_diario_aula) qtd_aulas,'
      '  COUNT(dp.cd_prova) qtd_provas,'
      '  COUNT(dat.cd_atividade) qtd_atividades'
      'FROM'
      #9'diario_grupos dg'
      #9'LEFT JOIN diario_aulas da ON (da.cd_grupo = dg.cd_grupo)'
      #9'LEFT JOIN diario_provas dp ON (dp.cd_grupo = dg.cd_grupo)'
      
        '  LEFT JOIN diario_atividades dat ON (dat.cd_grupo = dg.cd_grupo' +
        ')'
      'WHERE'
      #9'dg.cd_grupo = :cd_grupo')
    Params = <
