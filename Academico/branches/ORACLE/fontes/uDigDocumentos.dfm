  object qyDocumentos: TUMZQuery
    Connection = DM.dbDocs
    SQL.Strings = (
      'SELECT'
      '    *'
      'FROM'
      '    documentos'
      'WHERE'
      '   sn_digitaliza='#39'S'#39
      'ORDER BY'
      '   documento')
