  object qyAlunos: TUMZQuery
    Connection = DM.db
    OnCalcFields = qyAlunosCalcFields
    SQL.Strings = (
      
        'SELECT CAST( 0 AS SIGNED) AS sn_selecionado, p.cd_pessoa, m.anos' +
        'emestre AS nr_anosemestre, '
      'p.nm_pessoa, m.turma AS cd_turma, m.curso AS cd_curso, '
      
        ' GET_PERCCH_CURSADA(p.cd_pessoa, m.turma, m.anosemestre) AS nr_c' +
        'arga_horaria, CAST((CASE WHEN epp.sn_selecionado = 0 THEN 0 WHEN' +
        ' epp.sn_selecionado = 1 THEN 1 ELSE -1 END) AS SIGNED) AS seleci' +
        'onado, '
      
        ' GET_SITUACAO_CURSO_ALUNO(2, m.codigoaluno, m.turma, m.anosemest' +
        're) AS cd_situacao_curso'
      'FROM matriculas m'
      'INNER JOIN pessoas p ON (p.cd_pessoa = m.codigoaluno)'
      
        'LEFT JOIN expo_processo_pessoas epp ON (epp.cd_turma = m.turma A' +
        'ND epp.cd_pessoa = p.cd_pessoa AND epp.nr_anosemestre = m.anosem' +
        'estre AND epp.cd_processo = 2)'
      
        'WHERE 1=1 AND m.anosemestre = 20102 AND m.curso = 100 AND m.turm' +
        'a = '#39'MKT18'#39' AND m.codigoaluno = 105171'
      'GROUP BY m.codigoaluno, m.anosemestre, m.curso, m.turma'
      'ORDER BY p.nm_pessoa, m.curso, m.turma')
    Params = <>
    Left = 16
    Top = 192
    object qyAlunoscd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
    end
    object qyAlunosnr_anosemestre: TSmallintField
      FieldName = 'nr_anosemestre'
    end
    object qyAlunosnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyAlunoscd_turma: TStringField
      FieldName = 'cd_turma'
      Size = 50
    end
    object qyAlunoscd_curso: TStringField
      FieldName = 'cd_curso'
      Size = 15
    end
    object qyAlunosnr_carga_horaria: TFloatField
      FieldName = 'nr_carga_horaria'
    end
    object qyAlunosds_situacao_curso: TStringField
      FieldKind = fkLookup
      FieldName = 'ds_situacao_curso'
      LookupDataSet = qySituacoes
      LookupKeyFields = 'cd_situacao'
      LookupResultField = 'ds_valor'
      KeyFields = 'cd_situacao_curso'
      Size = 50
      Lookup = True
    end
    object qyAlunossn_selecionado: TLargeintField
      FieldName = 'sn_selecionado'
    end
    object qyAlunosselecionado: TStringField
      FieldName = 'selecionado'
    end
    object qyAlunosnr_anosemestre_formatado: TStringField
      FieldKind = fkCalculated
      FieldName = 'nr_anosemestre_formatado'
      Calculated = True
    end
    object qyAlunosds_situacao: TStringField
      FieldName = 'ds_situacao'
    end
    object qyAlunoscd_situacao_curso: TIntegerField
      FieldName = 'cd_situacao_curso'
    end
  end
  object qySituacoes: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT cd_situacao, ds_valor FROM situacoes '
      'WHERE cd_modulo = 1081'
      'ORDER BY ds_valor')
    Params = <>
    Left = 64
    Top = 192
    object qySituacoescd_situacao: TIntegerField
