  object qryFiltros: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      '   cd_empresa,'
      '   nm_empresa'
      'FROM'
      '   empresas'
      'WHERE '
      '   nm_empresa like :nm_empresa'
      'ORDER BY '
      '   nm_empresa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nm_empresa'
        ParamType = ptUnknown
      end>
    Left = 555
    Top = 270
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nm_empresa'
        ParamType = ptUnknown
      end>
    object qryFiltroscd_empresa: TIntegerField
      FieldName = 'cd_empresa'
      Required = True
    end
