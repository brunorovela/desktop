  object updDespesas: TZUpdateSQL
    DeleteSQL.Strings = (
      
        'DELETE FROM `LGTC_DESPESA_ANEXO` WHERE `CD_DESPESA` = :CD_DESPES' +
        'A;'
      'DELETE FROM `LGTC_DESPESA_AULA` WHERE `CD_DESPESA` = :CD_DESPESA')
    ModifySQL.Strings = (
      'UPDATE `LGTC_DESPESA_AULA`'
      'SET'
      '        `CD_SITUACAO` = :CD_SITUACAO,'
      '        `DT_ALTERACAO` = CURRENT_TIMESTAMP'
      'WHERE'
      '        `CD_DESPESA` = :CD_DESPESA')
