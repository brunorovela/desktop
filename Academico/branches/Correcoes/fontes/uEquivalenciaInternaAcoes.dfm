  object qyComboGrade: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT DISTINCT'
      '   CD_GRADE'
      'FROM'
      '   GRADES'
      'WHERE'
      '   CD_CURSO = :CD_CURSO AND'
      '   SN_ATIVO = '#39'S'#39)
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end>
    Left = 432
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end>
  end
  object qyListaDisc: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      #9'DISTINCT '
      #9#9'uni_d.descricao, '
      #9#9'uni_gd.cd_disciplina disciplina,  '
      #9#9'uni_gd.cd_grade cd_grade, '
      #9#9'uni_gd.cd_curso curso, '
      #9#9'dei.cd_equivalencia'
      'FROM'
      '  '
      #9'grades uni_g'
      ''
      '  INNER JOIN grades_disciplinas  uni_gd ON ( '
      #9#9'uni_gd.cd_grade = uni_g.cd_grade and '
      #9#9'uni_gd.cd_curso = uni_g.cd_curso'
      #9')'
      ''
      '  INNER JOIN disciplinas uni_d on ( '
      #9#9'uni_d.codigo '#9'= uni_gd.cd_disciplina and '
      #9#9'uni_d.curso '#9'= uni_gd.cd_curso'
      #9')'
      '  '
      '  left outer join disciplinas_equiv_interna dei on ( '
      #9#9'uni_gd.cd_grade '#9#9#9'= dei.cd_grade '#9#9#9'and '
      #9#9'uni_gd.cd_curso '#9#9#9'= dei.cd_curso'#9#9' '#9'and '
      #9#9'uni_gd.cd_disciplina '#9'= dei.cd_disciplina'
      #9')'
      ''
      'where'#9
      #9'uni_gd.cd_curso = :curso'#9'and '
      #9'uni_gd.cd_grade = :grade'
      ''
      'group by'#9
      
        #9'uni_d.descricao, uni_gd.cd_disciplina , uni_gd.cd_curso, uni_gd' +
        '.cd_grade'
      ''
      'order by'
      '   uni_d.descricao')
    Params = <
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grade'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'mysql-5=SELECT '#13#10#9'DISTINCT '#13#10#9#9'uni_d.descricao, '#13#10#9#9'uni_gd.cd_di' +
        'sciplina disciplina,  '#13#10#9#9'uni_gd.cd_grade cd_grade, '#13#10#9#9'uni_gd.c' +
        'd_curso curso, '#13#10#9#9'dei.cd_equivalencia'#13#10'FROM'#13#10'  '#13#10#9'grades uni_g'#13 +
        #10#13#10'  INNER JOIN grades_disciplinas  uni_gd ON ( '#13#10#9#9'uni_gd.cd_gr' +
        'ade = uni_g.cd_grade and '#13#10#9#9'uni_gd.cd_curso = uni_g.cd_curso'#13#10#9 +
        ')'#13#10#13#10'  INNER JOIN disciplinas uni_d on ( '#13#10#9#9'uni_d.codigo '#9'= uni' +
        '_gd.cd_disciplina and '#13#10#9#9'uni_d.curso '#9'= uni_gd.cd_curso'#13#10#9')'#13#10'  ' +
        #13#10'  left outer join disciplinas_equiv_interna dei on ( '#13#10#9#9'uni_g' +
        'd.cd_grade '#9#9#9'= dei.cd_grade '#9#9#9'and '#13#10#9#9'uni_gd.cd_curso '#9#9#9'= dei' +
        '.cd_curso'#9#9' '#9'and '#13#10#9#9'uni_gd.cd_disciplina '#9'= dei.cd_disciplina'#13#10 +
        #9')'#13#10#13#10'where'#9#13#10#9'uni_gd.cd_curso = :curso'#9'and '#13#10#9'uni_gd.cd_grade =' +
        ' :grade'#13#10#13#10'group by'#9#13#10#9'uni_d.descricao, uni_gd.cd_disciplina , u' +
        'ni_gd.cd_curso, uni_gd.cd_grade'#13#10#13#10'order by'#13#10'   uni_d.descricao'
      
        'oracle=SELECT '#13#10#9'DISTINCT '#13#10#9#9'uni_d.descricao, '#13#10#9#9'uni_gd.cd_dis' +
        'ciplina disciplina,  '#13#10#9#9'uni_gd.cd_grade cd_grade, '#13#10#9#9'uni_gd.cd' +
        '_curso curso, '#13#10#9#9'dei.cd_equivalencia'#13#10'FROM'#13#10'  '#13#10#9'grades uni_g'#13#10 +
        #13#10'  INNER JOIN grades_disciplinas  uni_gd ON ( '#13#10#9#9'uni_gd.cd_gra' +
        'de = uni_g.cd_grade and '#13#10#9#9'uni_gd.cd_curso = uni_g.cd_curso'#13#10#9')' +
        #13#10#13#10'  INNER JOIN disciplinas uni_d on ( '#13#10#9#9'uni_d.codigo '#9'= uni_' +
        'gd.cd_disciplina and '#13#10#9#9'uni_d.curso '#9'= uni_gd.cd_curso'#13#10#9')'#13#10'  '#13 +
        #10'  left outer join disciplinas_equiv_interna dei on ( '#13#10#9#9'uni_gd' +
        '.cd_grade '#9#9#9'= dei.cd_grade '#9#9#9'and '#13#10#9#9'uni_gd.cd_curso '#9#9#9'= dei.' +
        'cd_curso'#9#9' '#9'and '#13#10#9#9'uni_gd.cd_disciplina '#9'= dei.cd_disciplina'#13#10#9 +
        ')'#13#10#13#10'where'#9#13#10#9'uni_gd.cd_curso = :curso'#9'and '#13#10#9'uni_gd.cd_grade = ' +
        ':grade'#13#10#13#10'group by'#9#13#10#9'uni_d.descricao, uni_gd.cd_disciplina , un' +
        'i_gd.cd_curso, uni_gd.cd_grade'#13#10#13#10'order by'#13#10'   uni_d.descricao')
    Left = 464
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grade'
        ParamType = ptUnknown
      end>
  end
  object qyCarregaEquiv: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      #9'DISTINCT gd.cd_grade, gd.cd_curso'
      'FROM'
      '  grades_disciplinas gd'
      
        '  INNER JOIN disciplinas_equiv_interna dei ON (gd.cd_grade = dei' +
        '.cd_grade) AND (gd.curso = dei.cd_curso) AND (gd.disciplina = de' +
        'i.cd_disciplina)'
      'WHERE'
      #9'dei.cd_grupo = :grupo'
      'ORDER BY'
      #9'gd.anosemestre DESC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'grupo'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'mysql-5=SELECT '#13#10#9'DISTINCT gd.cd_grade, gd.cd_curso'#13#10'FROM'#13#10'  gra' +
        'des_disciplinas gd'#13#10'  INNER JOIN disciplinas_equiv_interna dei O' +
        'N (gd.cd_grade = dei.cd_grade) AND (gd.cd_curso = dei.cd_curso) ' +
        'AND (gd.cd_disciplina = dei.cd_disciplina)'#13#10'WHERE'#13#10#9'dei.cd_grupo' +
        ' = :grupo'#13#10'ORDER BY'#13#10#9'gd.cd_grade DESC'#13#10'LIMIT 1'
      
        'oracle=SELECT '#13#10#9'DISTINCT gd.cd_grade, gd.cd_curso'#13#10'FROM'#13#10'  grad' +
        'es_disciplinas gd'#13#10'  INNER JOIN disciplinas_equiv_interna dei ON' +
        ' (gd.cd_grade = dei.cd_grade) AND (gd.cd_curso = dei.cd_curso) A' +
        'ND (gd.cd_disciplina = dei.cd_disciplina)'#13#10'WHERE'#13#10#9'dei.cd_grupo ' +
        '= :grupo'#13#10'ORDER BY'#13#10#9'gd.cd_grade DESC')
    Left = 528
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'grupo'
        ParamType = ptUnknown
      end>
  end
  object qyAux: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      #9'DISTINCT gd.cd_grade, gd.curso, gd.anosemestre'
      'FROM'
      '  gradecurricular gd'
      
        '  INNER JOIN disciplinas_equiv_interna dei ON (gd.cd_grade = dei' +
        '.cd_grade) AND (gd.curso = dei.cd_curso) AND (gd.disciplina = de' +
        'i.cd_disciplina)'
      'WHERE'
      #9'dei.cd_grupo = :grupo'
      'ORDER BY'
      #9'gd.anosemestre DESC'
      'LIMIT 1')
    Params = <
      item
        DataType = ftUnknown
        Name = 'grupo'
        ParamType = ptUnknown
      end>
    Left = 560
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'grupo'
        ParamType = ptUnknown
      end>
  end
  object qyVerificaEqui: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  count(*) as  cont'
      'FROM'
      '   disciplinas_equiv_interna equivalencia '
      
        'INNER JOIN disciplinas d_equivalencia ON (d_equivalencia.codigo ' +
        '= equivalencia.cd_disciplina AND d_equivalencia.curso = equivale' +
        'ncia.cd_curso)'
      
        'INNER JOIN disciplinas_equiv_grupos eg ON (equivalencia.cd_grupo' +
        ' = eg.cd_grupo1) '
      
        'INNER JOIN disciplinas_equiv_interna equivalente ON (equivalente' +
        '.cd_grupo = eg.cd_grupo2)'
      
        'INNER JOIN disciplinas d_equivalente ON (d_equivalente.codigo = ' +
        'equivalente.cd_disciplina AND d_equivalente.curso = equivalente.' +
        'cd_curso)'
      'WHERE'
      ' equivalencia.cd_curso = :curso1'
      'AND'
      ' equivalencia.cd_disciplina = :disc1'
      'AND'
      ' equivalencia.cd_grade = :grad1'
      'AND'
      ' equivalente.cd_curso = :curso2'
      'AND'
      ' equivalente.cd_disciplina = :disc2'
      'AND'
      ' equivalente.cd_grade = :grad2')
    Params = <
      item
        DataType = ftUnknown
        Name = 'curso1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disc1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grad1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disc2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grad2'
        ParamType = ptUnknown
      end>
    Left = 592
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'curso1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disc1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grad1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disc2'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grad2'
        ParamType = ptUnknown
      end>
  end
  object qryVerificaExistenciaEquivalencia: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'select'
      '  count(cd_equivalencia_grupo) as cont'
      'from'
      '  disciplinas_equiv_grupos'
      'where'
      '  (cd_grupo1 = :grupo1 AND cd_grupo2 = :grupo2) OR'
      '  (cd_grupo1 = :grupo2 AND cd_grupo2 = :grupo1 )')
    Params = <
      item
        DataType = ftUnknown
        Name = 'grupo1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grupo2'
        ParamType = ptUnknown
      end>
    Left = 624
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'grupo1'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'grupo2'
        ParamType = ptUnknown
      end>
  end
end
