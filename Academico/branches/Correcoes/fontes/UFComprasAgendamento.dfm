  object updAgendamento: TZUpdateSQL
    ModifySQL.Strings = (
      'UPDATE'
      '        comp_agendamento'
      'SET'
      '        ds_situacao = :ds_situacao,'
      '        cd_usuario_cancelamento = :cd_usuario_cancelamento,'
      '        dt_cancelamento = CURRENT_TIMESTAMP'
      'WHERE'
