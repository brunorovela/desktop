  object qryAgendamentos: TZQuery
    Connection = DM.db
    UpdateObject = updAgendamento
    SQL.Strings = (
      'SELECT'
      #9'a.cd_agendamento,'
      #9'a.cd_pessoa,'
      #9'a.cd_produto,'
      #9'a.cd_turma,'
      #9'a.cd_usuario_agendamento,'
      #9'a.cd_usuario_cancelamento,'
      #9'a.ds_situacao,'
      #9'a.dt_agendamento,'
      #9'a.dt_cancelamento,'
      #9'a.dt_fim_vigencia,'
      #9'a.dt_inicio_vigencia,'
      #9'a.nr_anosemestre,'
      #9'a.nr_quantidade,'
      #9'p.nm_pessoa nm_aluno,'
      #9'pa.nm_pessoa nm_usuario_agendamento,'
      #9'pc.nm_pessoa nm_usuario_cancelamento,'
      #9'r.DS_PRODUTO'
      'FROM'
      #9'comp_agendamento a'
      #9#9'JOIN pessoas p ON'
      #9#9#9'(a.cd_pessoa = p.cd_pessoa)'
      #9#9'JOIN pessoas pa ON'
      #9#9#9'(a.cd_usuario_agendamento = pa.cd_pessoa)'
      #9#9'JOIN pessoas pc ON'
      #9#9#9'(a.cd_usuario_cancelamento = pc.cd_pessoa)'
      #9#9'JOIN comp_produtos r ON'
      #9#9#9'(a.cd_produto = r.CD_PRODUTO)')
    Params = <>
    Left = 144
    Top = 376
