  object qryAgendamentos: TZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '    p.CD_PRODUTO,'
      '    p.DS_PRODUTO,'
      '    p.VL_PRODUTO,'
      #9#9'p.NR_PARCELAS,'
      #9#9'p.SN_ACUMULAR_VALORES,'
      #9#9'p.SN_GERAR_TITULO,'
      #9#9'p.SN_IMPRIMIR_CUPOM,'
      '    a.cd_agendamento,'
      '    a.dt_inicio_vigencia,'
      '    a.dt_fim_vigencia,'
      '    a.nr_quantidade,'
      '    GET_COMPRAS_QTD_ESTOQUE(p.CD_PRODUTO) NR_QUANTIDADE_ESTOQUE'
      'FROM'
      '    comp_produtos p'
      '        JOIN comp_agendamento a ON'
      '            (p.CD_PRODUTO = a.cd_produto)'
      'WHERE'
      '    a.cd_pessoa = :cd_pessoa AND'
      '    a.ds_situacao = '#39'Pendente'#39
      'GROUP BY'
      '    p.CD_PRODUTO')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 296
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qryAgendamentosCD_PRODUTO: TStringField
      FieldName = 'CD_PRODUTO'
      Required = True
      Size = 30
    end
