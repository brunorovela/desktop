  object qryRelatorio: TUMZQuery
    Connection = DM.db
    UpdateObject = updRelatorio
    SQL.Strings = (
      'SELECT'
      #9'P.CD_PERMISSAO,'
      #9'COALESCE(P.CD_RELATORIO, :CD_RELATORIO) CD_RELATORIO,'
      #9'COALESCE(P.SN_CONCEDER, 0) SN_CONCEDER,'
      #9'COALESCE(P.SN_IMPRIMIR, 0) SN_IMPRIMIR,'
      #9'COALESCE(P.SN_RENOMEAR, 0) SN_RENOMEAR,'
      '  G.CD_GRUPO,'
      '  G.DS_NOME_GRUPO'
      'FROM'
      '  NU_GRUPOS G'
      #9'  LEFT JOIN UNI_RELATORIO_PERMISSAO P ON'
      #9#9#9'(G.CD_GRUPO = P.CD_GRUPO) AND'
      '      (P.CD_RELATORIO = :CD_RELATORIO)'
      'WHERE'
      #9'EXISTS ('
      #9#9'SELECT'
      #9#9#9'GP.CD_PESSOA'
      #9#9'FROM'
      #9#9#9'NU_GRUPOS_PESSOAS GP'
      #9#9#9#9'JOIN NU_GRUPOS_HIERARQUIA H ON'
      #9#9#9#9#9'(GP.CD_GRUPO = H.CD_GRUPO)'
      #9#9'WHERE'
      #9#9#9'GP.CD_PESSOA = :CD_PESSOA AND'
      #9#9#9'G.CD_GRUPO = H.CD_GRUPO_LIBERADO'
      #9') AND'
      #9'EXISTS ('
      #9#9'SELECT'
      #9#9#9'R.CD_PERMISSAO'
      #9#9'FROM'
      #9#9#9'UNI_RELATORIO_PERMISSAO R'
      #9#9#9#9'JOIN NU_GRUPOS_PESSOAS GP ON'
      #9#9#9#9#9'(R.CD_GRUPO = GP.CD_GRUPO)'
      #9#9'WHERE'
      #9#9#9'GP.CD_PESSOA = :CD_PESSOA AND'
      '      R.SN_CONCEDER = 1 AND'
      #9#9#9'R.CD_RELATORIO = :CD_RELATORIO'
      #9')')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_RELATORIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end>
    Left = 72
    Top = 112
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_RELATORIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end>
    object qryRelatorioCD_PERMISSAO: TLargeintField
      FieldName = 'CD_PERMISSAO'
    end
