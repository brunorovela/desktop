  object qryCategoria: TUMZQuery
    Connection = DM.db
    UpdateObject = updCategoria
    SQL.Strings = (
      'SELECT'
      '  P.CD_PERMISSAO,'
      #9'COALESCE(P.CD_CATEGORIA, :CD_CATEGORIA) CD_CATEGORIA,'
      #9'COALESCE(P.SN_CONCEDER, 0) SN_CONCEDER,'
      #9'COALESCE(P.SN_IMPRIMIR, 0) SN_IMPRIMIR,'
      #9'COALESCE(P.SN_RENOMEAR, 0) SN_RENOMEAR,'
      '  G.CD_GRUPO,'
      '  G.DS_NOME_GRUPO'
      'FROM'
      '  NU_GRUPOS G'
      #9#9'LEFT JOIN UNI_RELATORIO_CATEGORIA_PERMISSAO P ON'
      #9#9#9'(G.CD_GRUPO = P.CD_GRUPO) AND'
      '      (P.CD_CATEGORIA = :CD_CATEGORIA)'
      'WHERE'
      #9'EXISTS ('
      #9#9'SELECT'
      #9#9#9'GP.CD_PESSOA'
      #9#9'FROM'
      #9#9#9'NU_GRUPOS_PESSOAS GP'
      #9#9#9#9'JOIN NU_GRUPOS_HIERARQUIA H ON'
      #9#9#9#9#9'(GP.CD_GRUPO = H.CD_GRUPO)'
      #9#9'WHERE'
      #9#9#9'GP.CD_PESSOA = :CD_PESSOA AND'
      #9#9#9'G.CD_GRUPO = H.CD_GRUPO_LIBERADO'
      #9') AND'
      #9'EXISTS ('
