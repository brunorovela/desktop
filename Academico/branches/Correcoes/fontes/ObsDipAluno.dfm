  object quHist: TUMZQuery
    Connection = DM.db
    UpdateObject = usHist
    BeforePost = quHistBeforePost
    SQL.Strings = (
      'SELECT *'
      'FROM OBSDIPALUNO'
      'WHERE'
      '   (CODIGOALUNO = :CDALUNO) and'
      '   (CURSO = :CURSO)')
    Params = <
      item
        DataType = ftInteger
        Name = 'cdAluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Curso'
        ParamType = ptUnknown
      end>
    Left = 376
    Top = 168
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cdAluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Curso'
        ParamType = ptUnknown
      end>
    object quHistcodigoaluno: TIntegerField
      FieldName = 'codigoaluno'
    end
    object quHistcurso: TStringField
      FieldName = 'curso'
      Size = 10
    end
    object quHistobs: TMemoField
      FieldName = 'obs'
      BlobType = ftMemo
    end
  end
  object usHist: TZUpdateSQL
    DeleteSQL.Strings = (
      'delete from OBSDIPALUNO'
      'where'
      '  CODIGOALUNO = :OLD_CODIGOALUNO and'
      '  CURSO = :OLD_CURSO'
      '')
    InsertSQL.Strings = (
      'insert into OBSDIPALUNO'
      '  (CODIGOALUNO, CURSO, OBS)'
      'values'
      '  (:CODIGOALUNO, :CURSO, :OBS)')
    ModifySQL.Strings = (
      'update OBSDIPALUNO'
      'set'
      '  CODIGOALUNO = :CODIGOALUNO,'
      '  CURSO = :CURSO,'
      '  OBS = :OBS'
      'where'
      '  CODIGOALUNO = :OLD_CODIGOALUNO and'
      '  CURSO = :OLD_CURSO')
    UseSequenceFieldForRefreshSQL = False
    Left = 416
    Top = 168
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CODIGOALUNO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'OBS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'OLD_CODIGOALUNO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'OLD_CURSO'
        ParamType = ptUnknown
      end>
  end
