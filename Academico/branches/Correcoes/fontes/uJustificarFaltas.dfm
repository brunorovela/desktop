  object qyCarregaHistorico: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'dj.nr_anosemestre,'
      #9'dj.cd_turma,'
      #9'd.descricao,'
      #9'dj.cd_bimestre,'
      #9'dj.nr_aula,'
      '  dj.cd_disciplina,'
      #9'DATE_FORMAT(dj.dt_aula,'#39'%d/%m/%Y'#39') as dataaula,'
      #9'dj.nr_qtd_aulas,'
      #9'p.nm_pessoa as nm_usuario_registrou,'
      #9'dj.ds_justificativa,'
      '  pa.nm_pessoa'
      'FROM'
      #9'diario_justifica dj'
      'INNER JOIN turmas t ON ('
      #9'dj.nr_anosemestre = t.anosemestre'
      #9'AND dj.cd_turma = t.codigo'
      ')'
      'INNER JOIN disciplinas d ON ('
      #9'd.codigo = dj.cd_disciplina'
      #9'AND d.curso = t.curso'
      ')'
      'INNER JOIN pessoas p ON ('
      #9'p.cd_pessoa = dj.cd_usuario_registrou'
      ')'
      'INNER JOIN pessoas pa ON ('
      #9'pa.cd_pessoa = dj.cd_pessoa'
      ')'
      'WHERE'
      #9'dj.cd_pessoa = :cd_pessoa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 568
    Top = 200
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
  end
  object qyCorrigeAulasAlunos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
