  object qyCursosColigadas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      '  CD_GRADE, DS_GRADE'
      'FROM '
      '   GRADES'
      'WHERE'
      '   CD_CURSO LIKE :CD_CURSO')
