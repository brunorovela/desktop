  object qryBoletos: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT DISTINCT'
      '      B.CD_BOLETO,'
      '      B.CD_RESP_FINAN,'
      '      B.NR_NOSSONUMERO,'
      '      B.DT_VENCIMENTO,'
      '      B.VL_BOLETO,'
      '      B.VL_DESCONTO,'
      '      E.DT_INCLUSAO,'
      '      P.NM_PESSOA'
      'FROM'
      '      REM_ENVIOS E'
      
        '      INNER JOIN REM_OCORRENCIAS O ON (E.CD_OCORRENCIA = O.CD_OC' +
        'ORRENCIA AND O.CD_LAYOUT = E.CD_LAYOUT)'
      '      INNER JOIN REM_ACOES A ON (O.CD_ACAO = A.CD_ACAO)'
      '      INNER JOIN FIN_BOLETO B ON (E.CD_BOLETO = B.CD_BOLETO)'
      
        '      INNER JOIN FIN_CADASTRO_CONTAS C ON (B.CD_CONTA = C.CD_CAI' +
        'XA)'
      '      INNER JOIN PESSOAS P ON (B.CD_RESP_FINAN = P.CD_PESSOA)'
      'WHERE'
      '      E.SN_IGNORADO = 0 AND'
      '      O.SN_ATIVO = 1 AND'
      '      A.DS_CHAVE = '#39'incluir_dda'#39' AND'
      '      COALESCE(C.SN_IGNORAR_DDA, 0) = 0 AND'
      '      EXISTS ('
      '            SELECT'
      '                  M.CD_MENSALIDADE'
      '            FROM'
      '                  MENSALIDADES M'
      '            WHERE'
      '                  B.NR_NOSSONUMERO = M.NOSSONUMERO AND'
      
        '                  M.PARCELA BETWEEN :NR_PARCELA_INICIO AND :NR_P' +
        'ARCELA_FIM AND'
      '                  M.SITUACAO IN (2, 10) AND'
      '                  M.TURMA = :CD_TURMA AND'
      '                  M.CODIGOALUNO = :CD_PESSOA'
      '      )')
    Params = <
      item
        DataType = ftUnknown
        Name = 'NR_PARCELA_INICIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_PARCELA_FIM'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end>
    Left = 192
    Top = 192
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NR_PARCELA_INICIO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_PARCELA_FIM'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end>
    object qryBoletosCD_BOLETO: TIntegerField
      FieldName = 'CD_BOLETO'
    end
    object qryBoletosCD_RESP_FINAN: TIntegerField
      FieldName = 'CD_RESP_FINAN'
    end
    object qryBoletosNR_NOSSONUMERO: TStringField
      FieldName = 'NR_NOSSONUMERO'
      Size = 50
    end
    object qryBoletosDT_VENCIMENTO: TDateTimeField
      FieldName = 'DT_VENCIMENTO'
