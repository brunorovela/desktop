  object qyTurmas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  cm.ds_curso AS descricao,'
      #9't.codigo, t.anosemestre, t.cd_centro, t.cd_coligada'
      'FROM'
      #9'turmas t'
      #9'INNER JOIN cursos_mestre cm ON ( cm.cd_curso = t.curso )'
      '  INNER JOIN coligadas c ON ( c.cd_coligada = t.cd_coligada )'
      'WHERE'
      #9't.cd_centro = :cd_centro AND'
      '  :coligadas'
      'ORDER BY'
      #9'cm.DS_CURSO,'
      '  t.codigo,'
      '  t.anosemestre')
    Params = <
      item
        DataType = ftInteger
        Name = 'cd_centro'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftUnknown
        Name = 'coligadas'
        ParamType = ptUnknown
      end>
    DataSource = frm_CadCentros.srcCentrosCustos
    Left = 24
    Top = 96
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cd_centro'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftUnknown
        Name = 'coligadas'
        ParamType = ptUnknown
      end>
    object qyTurmasdescricao: TStringField
      DisplayLabel = 'Curso'
      FieldName = 'descricao'
      Origin = 'WMESTRE12.cursos.descricao'
      Size = 100
    end
    object qyTurmascodigo: TStringField
      DisplayLabel = 'Turma'
      FieldName = 'codigo'
      Origin = 'WMESTRE12.turmas.codigo'
      Size = 250
    end
    object qyTurmasanosemestre: TSmallintField
      DisplayLabel = 'Ano/Sem.'
      FieldName = 'anosemestre'
      Origin = 'WMESTRE12.turmas.anosemestre'
    end
    object qyTurmascd_centro: TLargeintField
      FieldName = 'cd_centro'
    end
    object qyTurmascd_coligada: TIntegerField
      FieldName = 'cd_coligada'
    end
  end
