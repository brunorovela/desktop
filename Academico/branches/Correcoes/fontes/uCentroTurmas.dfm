  object qryDeleteApropriaTurma: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'DELETE'
      'FROM'
      '   FIN_APROPRIA_TE'
      'WHERE'
      '   CD_MOVIMENTO_TE IN'
      '   ('
      '      SELECT'
      '         T.CD_MOVIMENTO_TE'
      '      FROM'
      '         FIN_MOV_TESOURARIA T'
      '            JOIN MENSALIDADES M ON'
      '               (T.CD_MENSALIDADE = M.CD_MENSALIDADE)'
      '      WHERE'
      '         M.TURMA = :CD_TURMA AND'
      '         M.ANOSEMESTRE = :NR_ANOSEMESTRE'
      '   )')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    Left = 128
    Top = 216
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
  end
  object qryUpdateMensTurma: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      '   MENSALIDADES'
      'SET'
      '   CD_CENTRO_CUSTO = CD_CENTRO_CUSTO'
      'WHERE'
      '   TURMA = :CD_TURMA AND'
      '   ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=MERGE INTO MENSALIDADES M USING'#13#10'('#13#10'   SELECT'#13#10'      M.CD' +
        '_MENSALIDADE,'#13#10'      T.CD_CENTRO'#13#10'   FROM'#13#10'      MENSALIDADES M'#13 +
        #10'         JOIN TURMAS T ON'#13#10'            (M.TURMA = T.CODIGO) AND' +
        #13#10'            (M.ANOSEMESTRE = T.ANOSEMESTRE)'#13#10'   WHERE'#13#10'      T' +
        '.CODIGO = :CD_TURMA AND'#13#10'      T.ANOSEMESTRE = :NR_ANOSEMESTRE'#13#10 +
        ') UP ON'#13#10'   (M.CD_MENSALIDADE = UP.CD_MENSALIDADE)'#13#10'WHEN MATCHED' +
        ' THEN'#13#10'   UPDATE SET M.CD_CENTRO_CUSTO = UP.CD_CENTRO'
      
        'mysql-5=UPDATE'#13#10'   MENSALIDADES M'#13#10'      JOIN TURMAS T ON'#13#10'     ' +
        '    (T.CODIGO = M.TURMA) AND'#13#10'         (T.ANOSEMESTRE = M.ANOSEM' +
        'ESTRE)'#13#10'SET'#13#10'   M.CD_CENTRO_CUSTO = T.CD_CENTRO'#13#10'WHERE'#13#10'   T.COD' +
        'IGO = :CD_TURMA AND'#13#10'   T.ANOSEMESTRE = :NR_ANOSEMESTRE')
    Left = 128
    Top = 184
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
  end
  object qryReplaceApropiaTurma: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'INSERT INTO FIN_APROPRIA_TE'
      
        '   (CD_MOVIMENTO_TE, CD_CONTA, CD_COLIGADA, CD_CENTRO, VL_MOVIME' +
        'NTO)'
      'SELECT'
      '   TE.CD_MOVIMENTO_TE,'
      '   ME.CD_PLANO_CONTA,'
      '   ME.CD_COLIGADA,'
      '   ME.CD_CENTRO_CUSTO,'
      '   TE.VL_MOVIMENTO'
      'FROM'
      '   FIN_MOV_TESOURARIA TE'
      '      JOIN MENSALIDADES ME ON'
      '         (TE.CD_MENSALIDADE = ME.CD_MENSALIDADE)'
      'WHERE'
      '   TE.NR_ESTORNO = 0 AND'
      '   ME.TURMA = :CD_TURMA AND'
      '   ME.ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'mysql-5=REPLACE INTO FIN_APROPRIA_TE'#13#10'   (CD_MOVIMENTO_TE, CD_CO' +
        'NTA, CD_COLIGADA, CD_CENTRO, VL_MOVIMENTO)'#13#10'SELECT'#13#10'   TE.CD_MOV' +
        'IMENTO_TE,'#13#10'   ME.CD_PLANO_CONTA,'#13#10'   ME.CD_COLIGADA,'#13#10'   ME.CD_' +
        'CENTRO_CUSTO,'#13#10'   TE.VL_MOVIMENTO'#13#10'FROM'#13#10'   FIN_MOV_TESOURARIA T' +
        'E'#13#10'      JOIN MENSALIDADES ME ON'#13#10'         (TE.CD_MENSALIDADE = ' +
        'ME.CD_MENSALIDADE)'#13#10'WHERE'#13#10'   TE.NR_ESTORNO = 0 AND'#13#10'   ME.TURMA' +
        ' = :CD_TURMA AND'#13#10'   ME.ANOSEMESTRE = :NR_ANOSEMESTRE'
      
        'oracle=MERGE INTO FIN_APROPRIA_TE A USING'#13#10'('#13#10'   SELECT'#13#10'      T' +
        'E.CD_MOVIMENTO_TE,'#13#10'      ME.CD_PLANO_CONTA,'#13#10'      ME.CD_COLIGA' +
        'DA,'#13#10'      ME.CD_CENTRO_CUSTO,'#13#10'      TE.VL_MOVIMENTO'#13#10'   FROM'#13#10 +
        '      FIN_MOV_TESOURARIA TE'#13#10'         JOIN MENSALIDADES ME ON'#13#10' ' +
        '           (TE.CD_MENSALIDADE = ME.CD_MENSALIDADE)'#13#10'   WHERE'#13#10'  ' +
        '    TE.NR_ESTORNO = 0 AND'#13#10'      ME.TURMA = :CD_TURMA AND'#13#10'     ' +
        ' ME.ANOSEMESTRE = :NR_ANOSEMESTRE'#13#10') UP ON'#13#10'   (A.CD_MOVIMENTO_T' +
        'E = UP.CD_MOVIMENTO_TE AND'#13#10'    A.CD_CONTA = UP.CD_PLANO_CONTA A' +
        'ND'#13#10'    A.CD_COLIGADA = UP.CD_COLIGADA AND'#13#10'    A.CD_CENTRO = UP' +
        '.CD_CENTRO_CUSTO)'#13#10'WHEN MATCHED THEN'#13#10'   UPDATE SET A.VL_MOVIMEN' +
        'TO = UP.VL_MOVIMENTO'#13#10'WHEN NOT MATCHED THEN'#13#10'   INSERT'#13#10'      (A' +
        '.CD_MOVIMENTO_TE, A.CD_CONTA, A.CD_COLIGADA, A.CD_CENTRO, A.VL_M' +
        'OVIMENTO)'#13#10'   VALUES'#13#10'      (UP.CD_MOVIMENTO_TE, UP.CD_PLANO_CON' +
        'TA, UP.CD_COLIGADA, UP.CD_CENTRO_CUSTO, UP.VL_MOVIMENTO)')
    Left = 128
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
  end
  object qryUpdateMensCurso: TUMZQuery
