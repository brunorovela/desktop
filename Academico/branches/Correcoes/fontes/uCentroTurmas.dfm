  object qryReplaceApropriaCurso: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'INSERT INTO FIN_APROPRIA_TE'
      
        '   (CD_MOVIMENTO_TE, CD_CONTA, CD_COLIGADA, CD_CENTRO, VL_MOVIME' +
        'NTO)'
      'SELECT'
      '   TE.CD_MOVIMENTO_TE,'
      '   ME.CD_PLANO_CONTA,'
      '   ME.CD_COLIGADA,'
      '   ME.CD_CENTRO_CUSTO,'
      '   TE.VL_MOVIMENTO'
      'FROM'
      '   FIN_MOV_TESOURARIA TE'
      '      JOIN MENSALIDADES ME ON'
      '         (TE.CD_MENSALIDADE = ME.CD_MENSALIDADE)'
      'WHERE'
      '   TE.NR_ESTORNO = 0 AND'
      '   ME.CURSO = :CD_CURSO AND'
      '   ME.ANOSEMESTRE = :NR_ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=MERGE INTO FIN_APROPRIA_TE A USING'#13#10'('#13#10'   SELECT'#13#10'      T' +
        '.CD_MOVIMENTO_TE,'#13#10'      M.CD_PLANO_CONTA,'#13#10'      M.CD_COLIGADA,' +
        #13#10'      M.CD_CENTRO_CUSTO,'#13#10'      T.VL_MOVIMENTO'#13#10'   FROM'#13#10'     ' +
        ' FIN_MOV_TESOURARIA T'#13#10'         JOIN MENSALIDADES M ON'#13#10'        ' +
        '    (T.CD_MENSALIDADE = M.CD_MENSALIDADE)'#13#10'   WHERE'#13#10'      T.NR_' +
        'ESTORNO = 0 AND'#13#10'      M.CURSO = :CD_CURSO AND'#13#10'      M.ANOSEMES' +
        'TRE = :NR_ANOSEMESTRE'#13#10') UP ON'#13#10'   (A.CD_MOVIMENTO_TE = UP.CD_MO' +
        'VIMENTO_TE AND'#13#10'    A.CD_CONTA = UP.CD_PLANO_CONTA AND'#13#10'    A.CD' +
        '_COLIGADA = UP.CD_COLIGADA AND'#13#10'    A.CD_CENTRO = UP.CD_CENTRO_C' +
        'USTO)'#13#10'WHEN MATCHED THEN'#13#10'   UPDATE SET A.VL_MOVIMENTO = UP.VL_M' +
        'OVIMENTO'#13#10'WHEN NOT MATCHED THEN'#13#10'   INSERT'#13#10'      (A.CD_MOVIMENT' +
        'O_TE, A.CD_CONTA, A.CD_COLIGADA, A.CD_CENTRO, A.VL_MOVIMENTO)'#13#10' ' +
        '  VALUES'#13#10'      (UP.CD_MOVIMENTO_TE, UP.CD_PLANO_CONTA, UP.CD_CO' +
        'LIGADA, UP.CD_CENTRO_CUSTO, UP.VL_MOVIMENTO)'
      
        'mysql-5=REPLACE INTO FIN_APROPRIA_TE'#13#10'   (CD_MOVIMENTO_TE, CD_CO' +
        'NTA, CD_COLIGADA, CD_CENTRO, VL_MOVIMENTO)'#13#10'SELECT'#13#10'   TE.CD_MOV' +
        'IMENTO_TE,'#13#10'   ME.CD_PLANO_CONTA,'#13#10'   ME.CD_COLIGADA,'#13#10'   ME.CD_' +
        'CENTRO_CUSTO,'#13#10'   TE.VL_MOVIMENTO'#13#10'FROM'#13#10'   FIN_MOV_TESOURARIA T' +
        'E'#13#10'      JOIN MENSALIDADES ME ON'#13#10'         (TE.CD_MENSALIDADE = ' +
        'ME.CD_MENSALIDADE)'#13#10'WHERE'#13#10'   TE.NR_ESTORNO = 0 AND'#13#10'   ME.CURSO' +
        ' = :CD_CURSO AND'#13#10'   ME.ANOSEMESTRE = :NR_ANOSEMESTRE')
