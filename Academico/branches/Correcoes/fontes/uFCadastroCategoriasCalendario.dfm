  object qryCategorias: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      '  cd_categoria,'
      '  ds_categoria,'
      '  ds_cor'
      'FROM'
      '  unim_calendario_categorias'
      'WHERE'
      ' cd_categoria = :categoria')
    Params = <
      item
        DataType = ftUnknown
        Name = 'categoria'
        ParamType = ptUnknown
      end>
    Left = 400
    Top = 104
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'categoria'
        ParamType = ptUnknown
      end>
    object qryCategoriascd_categoria: TIntegerField
      FieldName = 'cd_categoria'
    end
    object qryCategoriasds_categoria: TStringField
      FieldName = 'ds_categoria'
      Size = 255
    end
    object qryCategoriasds_cor: TStringField
      FieldName = 'ds_cor'
      Size = 50
    end
  end
  object dsCategorias: TDataSource
    DataSet = qryCategorias
    Left = 400
    Top = 72
  end
  object qryVerificar: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      '  count(cd_categoria) as contador'
      'FROM'
      '  calendario'
      'WHERE'
      ' cd_categoria = :categoria AND'
      ' cd_calendario <> :calendario')
    Params = <
      item
        DataType = ftUnknown
        Name = 'categoria'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'calendario'
        ParamType = ptUnknown
      end>
    Left = 296
    Top = 104
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'categoria'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'calendario'
        ParamType = ptUnknown
      end>
  end
