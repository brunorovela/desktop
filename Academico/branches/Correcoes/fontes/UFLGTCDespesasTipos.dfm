  object qryCampos: TUMZReadOnlyQuery
    Connection = DM.db
    SortedFields = 'DS_CAMPO'
    OnCalcFields = qryCamposCalcFields
    SQL.Strings = (
      'SELECT'
      '  `CD_CAMPO`,'
      '  `DS_CAMPO`,'
      '  `DS_TIPO`,'
      '  CASE `DS_PESSOA`'
      '    WHEN '#39'A'#39' THEN '#39'Aluno'#39
      '    WHEN '#39'F'#39' THEN '#39'Fornecedor'#39
      '    WHEN '#39'P'#39' THEN '#39'Pessoa'#39
      '    WHEN '#39'S'#39' THEN '#39'Ficha de Sa'#250'de'#39
      '    WHEN '#39'C'#39' THEN '#39'Planilha de Contatos'#39
      '    ELSE '#39#39
      '  END `TP_CAMPO`'
      'FROM'
      '  `PESSOAS_CAMPOS_ADICIONAIS`'
      'WHERE'
      '  `DS_TIPO` IN ('#39'A'#39', '#39'N'#39') AND'
      '  `SN_ATIVO` = 1')
    Params = <>
    IndexFieldNames = 'DS_CAMPO Asc'
    Left = 520
    Top = 336
    object qryCamposCD_CAMPO: TIntegerField
      FieldName = 'CD_CAMPO'
      Required = True
    end
    object qryCamposDS_CAMPO: TStringField
      FieldName = 'DS_CAMPO'
      Size = 30
    end
    object qryCamposDS_TIPO: TStringField
      FieldName = 'DS_TIPO'
      Size = 1
    end
    object qryCamposTP_CAMPO: TStringField
