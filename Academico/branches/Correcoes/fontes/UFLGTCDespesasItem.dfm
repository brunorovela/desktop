  object qryDespesas: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  D.`CD_DESPESA`,'
      '  D.`CD_DIARIO_AULA`,'
      '  T.`DS_TIPO_DESPESA`,'
      '  V.`DS_CHAVE`'
      'FROM'
      '  `LGTC_DESPESA_AULA` D'
      ''
      '    JOIN `LGTC_TIPO_DESPESA` T ON'
      '      (D.`CD_TIPO_DESPESA` = T.`CD_TIPO_DESPESA`)'
      ''
      '      JOIN `LGTC_TD_VALOR` V ON'
      '        (T.`CD_VALOR` = V.`CD_VALOR`)'
      'WHERE'
      '  D.`CD_DIARIO_AULA` = :CD_DIARIO_AULA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    Left = 144
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    object qryDespesasCD_DESPESA: TLargeintField
      FieldName = 'CD_DESPESA'
      Required = True
    end
    object qryDespesasCD_DIARIO_AULA: TLargeintField
      FieldName = 'CD_DIARIO_AULA'
      Required = True
    end
    object qryDespesasDS_TIPO_DESPESA: TStringField
      FieldName = 'DS_TIPO_DESPESA'
      Required = True
      Size = 64
    end
    object qryDespesasDS_CHAVE: TStringField
      FieldName = 'DS_CHAVE'
      Required = True
      Size = 16
    end
  end
  object qryFornecedorSala: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  S.cd_pessoa_fornecedor as CD_FORNECEDOR'
      'FROM'
      '  `unim_sala` S'
      'WHERE'
      '  EXISTS ('
      '    SELECT'
      '      A.`CD_DIARIO_AULA`'
      '    FROM'
      '      `DIARIO_AULAS` A'
      '        JOIN `TURMAS` T ON'
      '          (A.`TURMA` = T.`CODIGO`) AND'
      '          (A.`ANOSEMESTRE` = T.`ANOSEMESTRE`)'
      '    WHERE'
      '      A.`CD_DIARIO_AULA` = :CD_DIARIO_AULA AND'
      '      S.`ID` = T.`CD_SALA`'
      '  )')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    Left = 176
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_DIARIO_AULA'
        ParamType = ptUnknown
      end>
    object qryFornecedorSalaCD_FORNECEDOR: TIntegerField
      FieldName = 'CD_FORNECEDOR'
    end
  end
