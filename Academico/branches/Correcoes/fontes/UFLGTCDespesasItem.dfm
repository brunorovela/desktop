  object qryTiposDespesa: TUMZReadOnlyQuery
    Connection = DM.db
    SortedFields = 'DS_TIPO_DESPESA'
    Filter = 'SN_PADRAO = 1'
    SQL.Strings = (
      'SELECT'
      '  T.`CD_TIPO_DESPESA`,'
      '  T.`CD_CONTA`,'
      '  T.`CD_COLIGADA_MATRIZ`,'
      '  T.`CD_TIPO_TITULO`,'
      '  T.`DS_TIPO_DESPESA`,'
      '  T.`SN_PADRAO`,'
      '  T.`SN_ATIVO`,'
      '  V.`DS_CHAVE`,'
      '  F.`DS_CHAVE` `DS_CHAVE_FORNECEDOR`'
      'FROM'
      '  `LGTC_TIPO_DESPESA` T'
      ''
      '    JOIN `LGTC_TD_VALOR` V ON'
      '      (T.`CD_VALOR` = V.`CD_VALOR`)'
      ''
      '    JOIN `LGTC_TD_FORNECEDOR` F ON'
      '      (T.`CD_FORNECEDOR` = F.`CD_FORNECEDOR`)'
      ''
      'WHERE'
      '  T.`SN_ATIVO` = 1')
    Params = <>
    IndexFieldNames = 'DS_TIPO_DESPESA Asc'
    Left = 80
    Top = 120
    object qryTiposDespesaCD_TIPO_DESPESA: TLargeintField
      FieldName = 'CD_TIPO_DESPESA'
      Required = True
    end
    object qryTiposDespesaCD_CONTA: TLargeintField
      FieldName = 'CD_CONTA'
    end
    object qryTiposDespesaCD_COLIGADA_MATRIZ: TIntegerField
      FieldName = 'CD_COLIGADA_MATRIZ'
    end
    object qryTiposDespesaDS_TIPO_DESPESA: TStringField
      FieldName = 'DS_TIPO_DESPESA'
      Required = True
      Size = 64
    end
    object qryTiposDespesaSN_PADRAO: TSmallintField
      FieldName = 'SN_PADRAO'
      Required = True
    end
    object qryTiposDespesaSN_ATIVO: TSmallintField
      FieldName = 'SN_ATIVO'
      Required = True
    end
    object qryTiposDespesaDS_CHAVE: TStringField
      FieldName = 'DS_CHAVE'
      Required = True
      Size = 16
    end
