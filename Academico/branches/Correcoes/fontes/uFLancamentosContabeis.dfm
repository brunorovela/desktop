  object qryLancamentos: TUMZQuery
    Connection = DM.db
    ReadOnly = True
    SQL.Strings = (
      'SELECT'
      #9'fc.dt_movimento,'
      #9'CONCAT(fc.cd_credito, '#39' - '#39',fcpc_cre.ds_conta) as credito,'
      #9'concat(fc.cd_debito, '#39' - '#39',fcpc_deb.ds_conta) as debito,'#9
      #9'fc.vl_movimento,'
      #9'fch.ds_historico,'
      #9'fc.ds_historico AS ds_complemento,'
      #9'fc.cd_origem,'
      #9'fc.cd_chave,'
      #9'fc.cd_titulo,'
      '  fc.cd_operacao'
      'FROM'
      #9'fin_contabil fc'
      'LEFT JOIN fin_config_plano_contas fcpc_cre ON ('
      #9'fcpc_cre.cd_conta = fc.cd_credito'
      ')'
      'LEFT JOIN fin_config_plano_contas fcpc_deb ON ('
      #9'fcpc_deb.cd_conta = fc.cd_debito'
      ')'
      'LEFT JOIN fin_cp_historicos fch ON ('
      #9'fch.cd_historico = fc.cd_historico'
      ')')
    Params = <>
    Left = 8
    Top = 248
    object qryLancamentosdt_movimento: TDateField
      FieldName = 'dt_movimento'
      Required = True
    end
    object qryLancamentosvl_movimento: TFloatField
      FieldName = 'vl_movimento'
      Required = True
      DisplayFormat = '###,###,##0.00'
    end
    object qryLancamentosds_compemento: TStringField
      FieldName = 'ds_complemento'
      Size = 250
    end
    object qryLancamentoscd_origem: TStringField
      FieldName = 'cd_origem'
      Required = True
      Size = 2
    end
    object qryLancamentosds_historico: TStringField
      FieldName = 'ds_historico'
      Size = 255
    end
    object qryLancamentoscd_chave: TLargeintField
      FieldName = 'cd_chave'
      Required = True
    end
    object qryLancamentoscd_titulo: TIntegerField
      FieldName = 'cd_titulo'
      Required = True
    end
    object qryLancamentoscredito: TStringField
      FieldName = 'credito'
      ReadOnly = True
      Size = 269
    end
    object qryLancamentosdebito: TStringField
      FieldName = 'debito'
      ReadOnly = True
      Size = 269
    end
    object qryLancamentoscd_operacao: TStringField
      FieldName = 'cd_operacao'
      Required = True
      Size = 2
    end
  end
