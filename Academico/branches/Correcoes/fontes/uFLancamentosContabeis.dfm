  object qryBuscaAnosDisponiveis: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      #9'DISTINCT DATE_FORMAT(dt_movimento, '#39'%Y'#39') AS ano'
      'FROM'
      #9'fin_contabil'
      'GROUP BY'
      #9'DATE_FORMAT(dt_movimento, '#39'%Y'#39')'
      'ORDER BY'
      '  DATE_FORMAT(dt_movimento, '#39'%Y'#39') DESC'
      '')
    Params = <>
    Left = 8
    Top = 296
  end
