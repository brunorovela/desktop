    Left = 840
    Top = 112
  end
  object qryListaSalas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   u.ID as CD_SALA,'
      '   u.DS_SALA,'
      '   u.NR_QTD_VAGAS as QTD_VAGAS,'
      
        '   CASE WHEN u.SN_ATIVO = 0 THEN '#39'N'#227'o'#39' ELSE '#39'Sim'#39' END as SN_ATIV' +
        'O_MASK,'
      '   u.SN_ATIVO,  '
      '   u.cd_pessoa_fornecedor as CD_FORNECEDOR,'
      '   u.nr_intervalo_uso,'
      '   p.NM_PESSOA as DS_FORNECEDOR'
      'FROM'
      '  unim_sala u'
      '  LEFT JOIN pessoas p ON  (p.CD_PESSOA = u.cd_pessoa_fornecedor)')
    Params = <>
    Left = 776
    Top = 112
    object qryListaSalasCD_SALA: TLargeintField
      FieldName = 'CD_SALA'
    end
    object qryListaSalasDS_SALA: TStringField
      DisplayWidth = 15
      FieldName = 'DS_SALA'
      Size = 100
    end
    object qryListaSalasQTD_VAGAS: TLargeintField
      FieldName = 'QTD_VAGAS'
    end
    object qryListaSalasSN_ATIVO: TIntegerField
      FieldName = 'SN_ATIVO'
    end
    object qryListaSalasSN_ATIVO_MASK: TStringField
      FieldName = 'SN_ATIVO_MASK'
    end
    object qryListaSalasCD_FORNECEDOR: TLargeintField
      FieldName = 'CD_FORNECEDOR'
    end
    object qryListaSalasDS_FORNECEDOR: TStringField
      DisplayWidth = 15
      FieldName = 'DS_FORNECEDOR'
      Size = 100
    end
    object qryListaSalasnr_intervalo_uso: TLargeintField
      FieldName = 'nr_intervalo_uso'
    end
  end
end
