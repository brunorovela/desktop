  object qryAdministradoraCartao: TUMZQuery
    Connection = DM.db
    AfterOpen = qryAdministradoraCartaoAfterOpen
    BeforeInsert = qryAdministradoraCartaoBeforeInsert
    AfterInsert = qryAdministradoraCartaoAfterInsert
