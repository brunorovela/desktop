    BeforeDelete = qryAdministradoraCartaoBeforeDelete
    SQL.Strings = (
      'SELECT'
      #9'fcac.cd_admin_cartao,'
      #9'fcac.ds_nome,'
      #9'fcac.nr_dia_vencimento_credito,'
      #9'fcac.nr_dia_vencimento_debito,'
      #9'fcac.cd_conta_credito,'
      #9'fcac.cd_conta_debito,'
      #9'fcac.cd_conta_baixa_credito,'
      #9'fcac.cd_conta_baixa_debito,'
      #9'fcac.nr_taxa_debito,'
      '                fcac.vl_min_operacao,'
      '                fcac.sn_ativo'
      'FROM'
      #9'fin_cadastro_admin_cartao AS fcac'
      'ORDER BY'
      #9'fcac.ds_nome ASC')
    Params = <>
    Left = 832
    Top = 544
