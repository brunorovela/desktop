      FieldName = 'CD_PESSOA'
    end
    object qryContatosCD_CONTATO: TIntegerField
      FieldName = 'CD_CONTATO'
    end
    object qryContatosDS_CONTATO: TStringField
      FieldName = 'DS_CONTATO'
      Size = 100
    end
  end
