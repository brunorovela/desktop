  object qyResumo: TUMZQuery
    Connection = DM.db
    AfterOpen = qyRegistrosAfterOpen
    BeforeClose = qyRegistrosBeforeClose
    SQL.Strings = (
      'SELECT'
      '  rem_ocorrencias.ds_ocorrencia, '
      #9'Count(DISTINCT mensalidades.codigoaluno) QtdAlunos, '
      #9'Count( DISTINCT remessa.cd_remessa)  QtdTitulos, '
      
        #9'SUM(m.valorbruto) + SUM(m.valorextra) + SUM(m.valorjuros)- SUM(' +
        'm.descontoextra) VALTOTAL,'
      '  mensalidades.nossonumero'
      'FROM'
      '  rem_dados remessa'
      
        '  INNER JOIN mensalidades ON (remessa.cd_mensalidade = mensalida' +
        'des.cd_mensalidade)'
      
        '  INNER JOIN pessoas aluno ON (mensalidades.codigoaluno = aluno.' +
        'cd_pessoa)'
      
        '  INNER JOIN pessoas responsavel ON (aluno.cd_resp_finan = respo' +
        'nsavel.cd_pessoa)'
      
        '  INNER JOIN situacoes_financeiras ON (mensalidades.situacao = s' +
        'ituacoes_financeiras.cd_situacao)'
      
        '  INNER JOIN rem_layouts ON (remessa.cd_layout = rem_layouts.cd_' +
        'layout)'
      
        '  INNER JOIN rem_ocorrencias ON (remessa.cd_ocorrencia = rem_oco' +
        'rrencias.cd_ocorrencia) AND '
      '    (remessa.cd_layout = rem_ocorrencias.cd_layout)'
      'GROUP BY rem_ocorrencias.ds_ocorrencia'
      'LIMIT 10')
    Params = <>
    Left = 712
    object qyResumods_ocorrencia: TStringField
      FieldName = 'ds_ocorrencia'
      Size = 255
    end
    object qyResumoValTotal: TFloatField
      FieldName = 'ValTotal'
      DisplayFormat = '###,###,##0.00'
    end
    object qyResumoQtdAlunos: TLargeintField
      FieldName = 'QtdAlunos'
      ReadOnly = True
      DisplayFormat = '000'
    end
    object qyResumoQtdTitulos: TLargeintField
      FieldName = 'QtdTitulos'
      ReadOnly = True
      DisplayFormat = '00000'
    end
  end
  object dsResumo: TDataSource
    DataSet = qyResumo
    Left = 744
  end
  object qyRegistros: TUMZQuery
    Connection = DM.db
    AfterOpen = qyRegistrosAfterOpen
    BeforeClose = qyRegistrosBeforeClose
    UpdateObject = updRegistros
    SQL.Strings = (
      'SELECT '
      '  mensalidades.codigoaluno,'
      '  aluno.nm_pessoa,'
      '  mensalidades.parcela,'
      '  mensalidades.turma,'
      
        '  (COALESCE(m.valorbruto,0) + COALESCE(m.valorextra,0) + COALESC' +
        'E(m.valorjuros,0)- COALESCE(m.descontoextra,0)) valortotal,'
      '  mensalidades.valorpago,'
      '  situacoes_financeiras.ds_situacao,'
      '  rem_ocorrencias.ds_ocorrencia,'
      '  remessa.cd_remessa,'
      '  mensalidades.nossonumero'
      'FROM'
      '  rem_dados remessa'
      
        '  INNER JOIN mensalidades ON (remessa.cd_mensalidade = mensalida' +
        'des.cd_mensalidade)'
      
        '  INNER JOIN pessoas aluno ON (mensalidades.codigoaluno = aluno.' +
        'cd_pessoa)'
      
        '  INNER JOIN pessoas responsavel ON (aluno.cd_resp_finan = respo' +
        'nsavel.cd_pessoa)'
      
        '  INNER JOIN situacoes_financeiras ON (mensalidades.situacao = s' +
        'ituacoes_financeiras.cd_situacao)'
      
        '  INNER JOIN rem_layouts ON (remessa.cd_layout = rem_layouts.cd_' +
        'layout)'
      
        '  INNER JOIN rem_ocorrencias ON (remessa.cd_ocorrencia = rem_oco' +
        'rrencias.cd_ocorrencia) AND '
      '    (remessa.cd_layout = rem_ocorrencias.cd_layout)'
      'LIMIT 1')
    Params = <>
    Left = 632
    object qyRegistroscodigoaluno: TIntegerField
      FieldName = 'codigoaluno'
    end
    object qyRegistrosnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyRegistrosparcela: TSmallintField
      FieldName = 'parcela'
    end
    object qyRegistrosturma: TStringField
      FieldName = 'turma'
      Size = 50
    end
    object qyRegistrosvalortotal: TFloatField
      FieldName = 'valortotal'
      DisplayFormat = '###,##0.00'
    end
    object qyRegistrosvalorpago: TFloatField
      FieldName = 'valorpago'
      DisplayFormat = '###,##0.00'
    end
    object qyRegistrosds_situacao: TStringField
      FieldName = 'ds_situacao'
      Size = 15
    end
    object qyRegistrosds_ocorrencia: TStringField
      FieldName = 'ds_ocorrencia'
      Size = 255
    end
    object qyRegistroscd_remessa: TLargeintField
      FieldName = 'cd_remessa'
    end
    object qyRegistrosnossonumero: TStringField
      FieldName = 'nossonumero'
    end
    object qyRegistrosds_tipo_titulo: TStringField
      FieldName = 'ds_tipo_titulo'
      Size = 200
    end
  end
  object qryLayoutEspec: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   NR_INICIO,'
