  object qryHierarquia: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      '     gh.cd_grupo_liberado as cd_grupo_liberado ,'
      '      g.ds_nome_grupo as ds_nome_grupo , '
      '      g1.ds_nome_grupo as ds_nome_grupo_liberado'
      'FROM '
      '     nu_grupos_hierarquia gh '
      '     join nu_grupos g on (gh.cd_grupo = g.cd_grupo)'
      '     join nu_grupos g1  on (gh.cd_grupo_liberado = g1.cd_grupo)'
      'WHERE  '
      '     g.cd_grupo =:hierarquia'
      'ORDER BY'
      '     g1.ds_nome_grupo'
      '')
    Params = <
      item
        DataType = ftUnknown
        Name = 'hierarquia'
        ParamType = ptUnknown
      end>
    Left = 312
    Top = 352
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'hierarquia'
        ParamType = ptUnknown
      end>
    object qryHierarquiads_nome_grupo: TStringField
      FieldName = 'ds_nome_grupo'
      Required = True
      Size = 50
    end
    object qryHierarquiads_nome_grupo_liberado: TStringField
      FieldName = 'ds_nome_grupo_liberado'
      Required = True
      Size = 50
    end
    object qryHierarquiacd_grupo_liberado: TIntegerField
      FieldName = 'cd_grupo_liberado'
      Required = True
    end
  end
  object qryLogs: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT GROUP_CONCAT(cd_grupo_liberado) as logs ,cd_grupo  FROM  ' +
        'nu_grupos_hierarquia WHERE cd_grupo = :cd_grupo  GROUP BY cd_gru' +
        'po ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end>
    Left = 312
    Top = 320
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end>
  end
  object qryInsereHierarquia: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'INSERT IGNORE INTO nu_grupos_hierarquia VALUES (null,:cd_grupo,:' +
        'cd_grupo_liberado)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_grupo_liberado'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'mysql=INSERT IGNORE INTO nu_grupos_hierarquia VALUES (null,:cd_g' +
        'rupo,:cd_grupo_liberado)'
      
        'oracle=INSERT INTO nu_grupos_hierarquia VALUES (null,:cd_grupo,:' +
        'cd_grupo_liberado)')
    Left = 360
    Top = 320
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_grupo_liberado'
        ParamType = ptUnknown
      end>
  end
  object qryExisteHierarquia: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   cd_grupo'
      'FROM'
      '   nu_grupos_hierarquia'
      'WHERE'
      
        '   cd_grupo = :cd_grupo AND cd_grupo_liberado = :cd_grupo_libera' +
        'do')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_grupo_liberado'
