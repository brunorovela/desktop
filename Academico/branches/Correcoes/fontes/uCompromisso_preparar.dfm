  object qyItens: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   p.* ,  cp.ds_despesa, cp.dt_vencimento, pe.nm_pessoa'
      'FROM'
      '   fin_cp_preparacao_itens p, fin_contas_pagar cp, pessoas pe'
      'WHERE'
      '   p.cd_titulo = cp.cd_titulo AND'
      '   cp.cd_pessoa = pe.cd_pessoa AND'
      '   p.cd_preparacao = :cd_Preparacao AND'
      '   p.cd_coligada = :cd_coligada')
    Params = <
      item
        DataType = ftInteger
        Name = 'cd_preparacao'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftSmallint
        Name = 'cd_coligada'
        ParamType = ptUnknown
        Size = 2
      end>
    DataSource = srcPreparacao
    Left = 684
    Top = 97
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cd_preparacao'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftSmallint
        Name = 'cd_coligada'
        ParamType = ptUnknown
        Size = 2
      end>
