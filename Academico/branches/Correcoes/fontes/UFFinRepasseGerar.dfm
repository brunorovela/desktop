  object qryRepasses: TUMZQuery
    Connection = DM.db
    UpdateObject = updRepasses
    SQL.Strings = (
      'SELECT DISTINCT'
      '  R.CD_CONTRATO,'
      '  R.CD_TURMA,'
      '  R.NR_ANOSEMESTRE,'
      '  R.NR_PARCELA,'
      '  R.NR_PARCELAS,'
      '  R.VL_REPASSE,'
      '  R.DT_VENCIMENTO,'
      '  C.NR_DIA_VENCIMENTO,'
      '  C.CD_PESSOA,'
      '  C.CD_TIPO_TITULO,'
      '  O.NM_COLIGADA,'
      '  TT.CD_CONTA,'
      '  P.NM_PESSOA,'
      '  T.CURSO,'
      '  T.CD_CENTRO,'
      '  CC.CD_DEPTO,'
      '  M.CD_MENSALIDADE,'
      '  C.CD_TIPO,'
      '  CASE'
      '    WHEN C.CD_TIPO = 1 THEN COUNT(DISTINCT MAT.CODIGOALUNO)'
      '    WHEN C.CD_TIPO = 0 THEN COUNT(DISTINCT CTP.CD_PESSOA)'
      '    ELSE 0'
      '  END NR_ALUNOS'
      'FROM'
      #9'CONV_REPASSES R'
      ''
      #9#9'JOIN CONV_CONTRATOS C ON'
      #9#9#9'(R.CD_CONTRATO = C.CD_CONTRATO)'
      ''
      #9#9'LEFT JOIN CONV_CONTRATOS_TURMAS_PESSOAS CTP ON'
      #9#9#9'(R.CD_CONTRATO = CTP.CD_CONTRATO) AND'
      #9#9#9'(R.CD_TURMA = CTP.CD_TURMA) AND'
      #9#9#9'(R.NR_ANOSEMESTRE = CTP.NR_ANOSEMESTRE) AND'
      '      (CTP.SN_ATIVO = 1)'
      ''
      '    LEFT JOIN MATRICULAS MAT ON'
      '      (R.CD_TURMA = MAT.TURMA) AND'
      '      (R.NR_ANOSEMESTRE = MAT.ANOSEMESTRE)'
      ''
      '    LEFT JOIN SITUACAO S ON'
      '      (MAT.SITUACAO = S.CD_SITUACAO) AND'
      '      (S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 11, 14, 15))'
      ''
      '    JOIN COLIGADAS O ON'
      '      (C.CD_COLIGADA = O.CD_COLIGADA)'
      ''
      #9#9'JOIN FIN_CONFIG_TIPOS_TITULO TT ON'
      #9#9#9'(C.CD_TIPO_TITULO = TT.CD_TIPO_TITULO) AND'
      #9#9#9'(O.CD_COLIGADA_MATRIZ = TT.CD_COLIGADA_MATRIZ)'
      ''
      '    JOIN PESSOAS P ON'
      '      (C.CD_PESSOA = P.CD_PESSOA)'
      ''
      #9#9'JOIN TURMAS T ON'
      #9#9#9'(R.CD_TURMA = T.CODIGO) AND'
      #9#9#9'(R.NR_ANOSEMESTRE = T.ANOSEMESTRE)'
      ''
      #9#9'JOIN CURSOS_COLIGADAS CC ON'
      #9#9#9'(T.CURSO = CC.CD_CURSO) AND'
      #9#9#9'(T.CD_COLIGADA = CC.CD_COLIGADA)'
      ''
      #9#9'LEFT JOIN MENSALIDADES M ON'
      #9#9#9'(R.CD_MENSALIDADE = M.CD_MENSALIDADE)'
      ''
      'WHERE'
      #9'C.CD_COLIGADA IN (:CD_COLIGADA) AND'
      #9'MONTH(R.DT_VENCIMENTO) = :NR_MES AND'
      #9'YEAR(R.DT_VENCIMENTO) = :NR_ANO'
      'GROUP BY'
      '  R.CD_CONTRATO,'
      '  R.CD_TURMA,'
      '  R.NR_ANOSEMESTRE,'
      '  R.NR_PARCELA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_COLIGADA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_MES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANO'
        ParamType = ptUnknown
      end>
    Left = 344
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_COLIGADA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_MES'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANO'
        ParamType = ptUnknown
      end>
    object qryRepassesCD_CONTRATO: TLargeintField
      FieldName = 'CD_CONTRATO'
    end
    object qryRepassesCD_TURMA: TStringField
      FieldName = 'CD_TURMA'
      Size = 50
    end
    object qryRepassesNR_ANOSEMESTRE: TIntegerField
      FieldName = 'NR_ANOSEMESTRE'
