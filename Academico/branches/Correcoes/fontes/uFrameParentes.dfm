  object qyParentes: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'p.nm_pessoa,'
      #9'p.cd_pessoa,'
      #9'p.ds_cpf,'
      #9'ppt.ds_pessoa_desc,'
      '  ppt.cd_parentesco_tipo      '
      'FROM'
      #9'pessoas_parentesco AS pp'
      'INNER JOIN pessoas AS p ON('
      #9'p.cd_pessoa = pp.cd_parente'
      ')'
      'INNER JOIN pessoas_parentesco_tipos AS ppt ON('
      #9'ppt.cd_parentesco_tipo = pp.cd_parentesco_tipo'
      ')'
      'WHERE'
      #9'pp.cd_pessoa = :cd_pessoa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 488
    Top = 344
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qyParentesnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyParentescd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
      Required = True
    end
    object qyParentesds_cpf: TStringField
      FieldName = 'ds_cpf'
      Size = 15
    end
    object qyParentesds_pessoa_desc: TStringField
      FieldName = 'ds_pessoa_desc'
      Size = 30
    end
    object qyParentescd_parentesco_tipo: TIntegerField
      FieldName = 'cd_parentesco_tipo'
