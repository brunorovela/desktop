  object srcPresencas: TDataSource
    DataSet = qyPresencas
    Left = 556
    Top = 241
  end
  object pmQtd: TPopupMenu
    Left = 664
    Top = 264
  end
  object qyPresencas: TUMZQuery
    Connection = DM.db
    OnCalcFields = qyPresencasCalcFields
    SQL.Strings = (
      'SELECT'
      '   dlp.cd_pessoa,'
      '   p.nm_pessoa,'
      '   dlp.dt_aula,'
      '   h.codigo,'
      '   h.ds_horario,'
      '   h.hr_inicio,'
      '   h.hr_fim,'
      '   d.descricao AS ds_disc,'
      '   dlp.sn_presente,'
      '   dlp.sn_imp_diario,'
      '   f.turma'
      'FROM'
      '  diario_lista_presenca dlp'
      
        '  INNER JOIN fichaindividual f ON (dlp.cd_pessoa = f.codigoaluno' +
        ') AND (dlp.nr_anosemestre = f.anosemestre) AND (dlp.cd_turma = f' +
        '.turma) AND (dlp.cd_disciplina = f.disciplina)'
      
        '  INNER JOIN disciplinas d ON (f.curso = d.curso) AND (dlp.cd_di' +
        'sciplina = d.codigo)'
      '  INNER JOIN pessoas p ON (dlp.cd_pessoa = p.cd_pessoa)'
      '  INNER JOIN horarios h ON (dlp.cd_horario = h.codigo)'
      'WHERE'
      '  dlp.sn_presente = "N"'
      'LIMIT 1000')
    Params = <>
    Left = 520
    Top = 240
    object qyPresencascd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
    end
    object qyPresencasnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyPresencasdt_aula: TDateTimeField
      FieldName = 'dt_aula'
    end
    object qyPresencascodigo: TSmallintField
      FieldName = 'codigo'
    end
    object qyPresencasds_horario: TStringField
