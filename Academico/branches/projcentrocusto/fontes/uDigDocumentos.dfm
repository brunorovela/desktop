  object qyDocsAluno: TUMZQuery
    Connection = DM.dbDocs
    SQL.Strings = (
      'SELECT'
      '   d.codigo,'
      '   d.documento,'
      '   d.prazo,'
      '   d.sigla,'
      '   d.ordem,'
      '   d.ds_sexo,'
      '   d.sn_digitaliza,'
      '   d.nr_dpi,'
      '   d.nr_largura,'
      '   d.nr_altura,'
      '   da.cd_documento'
      'FROM'
      '   documentos d'
      #9#9'LEFT JOIN documentos_alunos da ON'
      #9#9#9'(da.cd_documento = d.codigo) AND'
      #9#9#9'(da.cd_pessoa = :cd_pessoa)'
      'WHERE'
      '   d.sn_digitaliza = '#39'S'#39' AND'
      '   d.codigo IN (%s)'
      'GROUP BY'
      '   d.codigo'
      'ORDER BY'
      '   d.documento   ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 16
    Top = 120
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
  end
  object dsDocsAluno: TDataSource
    AutoEdit = False
