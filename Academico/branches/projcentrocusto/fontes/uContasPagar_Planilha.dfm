  object qyCalcCC: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   LEFT(GROUP_CONCAT(AP.CD_CONTA),150) CD_CONTA,'
      '   CC.CD_CENTRO,'
      '   CC.DS_CENTRO,'
      
        '   LEFT(CONCAT(GROUP_CONCAT(PC.DS_CONTA SEPARATOR '#39' / '#39'),'#39#39'),150' +
        ') DS_CONTA,'
      '   SUM(AP.VL_MOVIMENTO) VL_MOVIMENTO'
      'FROM'
      '   FIN_APROPRIA_CP AP'
      '      JOIN FIN_CENTRO_CUSTOS CC ON'
      '        (AP.CD_COLIGADA = CC.CD_COLIGADA) AND'
      '        (AP.CD_CENTRO = CC.CD_CENTRO)'
      '      JOIN FIN_PLANO_CONTAS PC ON'
      '        (AP.CD_COLIGADA = PC.CD_COLIGADA) AND'
      '        (AP.CD_CONTA = PC.CD_CONTA)'
      'WHERE'
      '   AP.CD_TITULO = :CD_TITULO AND'
      '   AP.CD_COLIGADA = :CD_COLIGADA'
      'GROUP BY'
      '   CC.CD_CENTRO,'
      '   CC.DS_CENTRO,'
      '   PC.DS_CONTA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_titulo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=SELECT'#13#10'   GROUP_CONCAT(AP.CD_CONTA) CD_CONTA,'#13#10'   CC.CD_' +
        'CENTRO,'#13#10'   CC.DS_CENTRO,'#13#10'   CONCAT(GROUP_CONCAT(PC.DS_CONTA SE' +
        'PARATOR '#39' / '#39'),'#39#39') DS_CONTA,'#13#10'   SUM(AP.VL_MOVIMENTO) VL_MOVIMEN' +
        'TO'#13#10'FROM'#13#10'   FIN_APROPRIA_CP AP'#13#10'      JOIN FIN_CENTRO_CUSTOS CC' +
        ' ON'#13#10'         (AP.CD_COLIGADA = CC.CD_COLIGADA) AND'#13#10'         (A' +
        'P.CD_CENTRO = CC.CD_CENTRO)'#13#10'      JOIN FIN_PLANO_CONTAS PC ON'#13#10 +
        '         (AP.CD_COLIGADA = PC.CD_COLIGADA) AND'#13#10'         (AP.CD_' +
        'CONTA = PC.CD_CONTA)'#13#10'WHERE'#13#10'   AP.CD_TITULO = :CD_TITULO AND'#13#10' ' +
        '  AP.CD_COLIGADA = :CD_COLIGADA'#13#10'GROUP BY'#13#10'   CC.CD_CENTRO,'#13#10'   ' +
        'CC.DS_CENTRO,'#13#10'   PC.DS_CONTA'
      
        'mysql-5=SELECT'#13#10'   LEFT(CAST(GROUP_CONCAT(AP.CD_CONTA) AS CHAR),' +
        '150) CD_CONTA,'#13#10'   CC.CD_CENTRO,'#13#10'   CC.DS_CENTRO,'#13#10'   LEFT(CONC' +
        'AT(GROUP_CONCAT(PC.DS_CONTA SEPARATOR '#39' / '#39'),'#39#39'),150) DS_CONTA,'#13 +
        #10'   SUM(AP.VL_MOVIMENTO) VL_MOVIMENTO'#13#10'FROM'#13#10'   FIN_APROPRIA_CP ' +
        'AP'#13#10'      LEFT JOIN FIN_CENTRO_CUSTOS CC ON'#13#10'         (AP.CD_COL' +
        'IGADA = CC.CD_COLIGADA) AND'#13#10'         (AP.CD_CENTRO = CC.CD_CENT' +
        'RO)'#13#10'      JOIN FIN_PLANO_CONTAS PC ON'#13#10'         (AP.CD_COLIGADA' +
        ' = PC.CD_COLIGADA) AND'#13#10'         (AP.CD_CONTA = PC.CD_CONTA)'#13#10'WH' +
        'ERE'#13#10'   AP.CD_TITULO = :CD_TITULO AND'#13#10'   AP.CD_COLIGADA = :CD_C' +
        'OLIGADA'#13#10'GROUP BY'#13#10'   CC.CD_CENTRO')
    Left = 584
    Top = 136
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_titulo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
    object qyCalcCCCD_CONTA: TStringField
      FieldName = 'CD_CONTA'
      ReadOnly = True
      Size = 4000
    end
    object qyCalcCCDS_CENTRO: TStringField
      FieldName = 'DS_CENTRO'
      Size = 255
    end
    object qyCalcCCVL_MOVIMENTO: TFloatField
      FieldName = 'VL_MOVIMENTO'
      ReadOnly = True
    end
    object qyCalcCCDS_CONTA: TStringField
      DisplayWidth = 255
      FieldName = 'DS_CONTA'
      Size = 255
    end
    object qyCalcCCCD_CENTRO: TIntegerField
      FieldName = 'CD_CENTRO'
    end
  end
  object qyMaxParcela: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   CAST(MAX(NR_PARCELA) AS NUMBER(19)) PARCELA'
      'FROM'
      '   FIN_CONTAS_PAGAR'
      'WHERE'
      '   CD_TITULO_PRINCIPAL = :CD_TITULO')
    Params = <
      item
        DataType = ftInteger
        Name = 'cd_titulo'
        ParamType = ptInputOutput
      end>
    SQLList.Strings = (
      
        'oracle=SELECT'#13#10'   CAST(MAX(NR_PARCELA) AS NUMBER(19)) PARCELA'#13#10'F' +
        'ROM'#13#10'   FIN_CONTAS_PAGAR'#13#10'WHERE'#13#10'   CD_TITULO_PRINCIPAL = :CD_TI' +
        'TULO'#13#10
      
        'mysql-5=SELECT'#13#10'   CAST(MAX(NR_PARCELA) AS SIGNED) PARCELA'#13#10'FROM' +
        #13#10'   FIN_CONTAS_PAGAR'#13#10'WHERE'#13#10'   CD_TITULO_PRINCIPAL = :CD_TITUL' +
        'O'#13#10)
    Left = 544
    Top = 136
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cd_titulo'
        ParamType = ptInputOutput
      end>
    object qyMaxParcelaPARCELA: TLargeintField
      FieldName = 'PARCELA'
      ReadOnly = True
    end
  end
  object qryContasPagar: TUMZQuery
    Connection = DM.db
    OnCalcFields = qryContasPagarCalcFields
    AfterInsert = qryContasPagarAfterInsert
    SQL.Strings = (
      'SELECT'
      '   PI.CD_PREPARACAO,'
      '   CP.CD_TITULO,'
      '   CP.CD_COLIGADA,'
      '   CP.CD_PESSOA,'
      '   CP.DS_DESPESA,'
      '   CP.NR_DOCUMENTO,'
      '   CP.NR_PARCELA,'
      '   CP.DT_EMISSAO_NOTA,'
      '   CP.DT_LANCAMENTO,'
      '   CP.DT_COMPETENCIA,'
      '   CP.DT_VENCIMENTO,'
      '   CP.DT_PROVAVEL_PGTO,'
      '   CP.DT_PAGAMENTO,'
      '   CP.VL_DESPESA,'
      '   CP.CD_SITUACAO,'
      '   CP.SN_PREVISAO,'
      '   CP.CD_TIPO_TITULO,'
      '   CP.TP_ENTRADA_SAIDA,'
      '   CP.CD_FORMA_PGTO,'
      '   CP.NR_CHEQUE,'
      '   CP.CD_CAIXA,'
      '   CP.CD_TITULO_ORIGEM,'
      '   CP.CD_AUTORIZA,'
      '   CP.CD_TITULO_PRINCIPAL,'
      '   U.NOME NM_USUARIO_AUTORIZA,'
      '   P.NM_PESSOA,'
      '   CC.DS_CAIXA,'
      '   PR.DS_PREPARACAO,'
      '   CA.CD_AUTORIZA_SITU,'
      '   CA.DT_AUTORIZA,'
      '   SUM(M.VL_ENTRADA) VL_ENTRADAS,'
      '   SUM(M.VL_SAIDA) VL_SAIDAS,'
      '   SUM(M.VL_LIQUIDO) VL_LIQUIDO,'
      
        '   CASE WHEN CA.CD_AUTORIZA_SITU = 0 OR CA.CD_AUTORIZA_SITU is n' +
        'ull THEN 3 ELSE CA.CD_AUTORIZA_SITU END as CD_AUTORIZA_SITU_ORDE' +
        'NA'
      '  fcpa.CD_ANEXO'
      'FROM'
      '   FIN_CONTAS_PAGAR CP'
      '      JOIN PESSOAS P ON'
      '         (CP.CD_PESSOA = P.CD_PESSOA)'
      '      %s'
      '      LEFT JOIN FIN_MOV_CP M ON'
      '         (CP.CD_TITULO = M.CD_TITULO) AND'
      '         (CP.CD_COLIGADA = M.CD_COLIGADA)'
      '      LEFT JOIN fin_cadastro_contas CC ON'
      '         (CP.CD_CAIXA = CC.CD_CAIXA) '
      '      LEFT JOIN FIN_CP_PREPARACAO_ITENS PI ON'
      '         (CP.CD_TITULO = PI.CD_TITULO) AND'
      '         (CP.CD_COLIGADA = PI.CD_COLIGADA)'
      '         LEFT JOIN FIN_CP_PREPARACAO PR ON'
      '            (PI.CD_PREPARACAO = PR.CD_PREPARACAO)'
      '      LEFT JOIN FIN_CONTAS_PAGAR_AUTORIZA CA ON'
      '         (CP.CD_AUTORIZA = CA.CD_AUTORIZA)'
      '         LEFT JOIN USUARIOS U ON'
      '            (CA.CD_AUTORIZA_USUARIO = U.CODIGO)'
      
        'LEFT JOIN fin_contas_pagar_anexos fcpa ON (fcpa.CD_TITULO = CP.c' +
        'd_titulo)'
      'WHERE'
      '   CP.CD_COLIGADA = :CD_COLIGADA AND'
      '   %s'
      'GROUP BY'
      '   PI.CD_PREPARACAO,'
      '   CP.CD_TITULO,'
      '   CP.CD_COLIGADA,'
      '   CP.CD_PESSOA,'
      '   CP.DS_DESPESA,'
      '   CP.NR_DOCUMENTO,'
      '   CP.NR_PARCELA,'
      '   CP.DT_EMISSAO_NOTA,'
      '   CP.DT_LANCAMENTO,'
      '   CP.DT_COMPETENCIA,'
      '   CP.DT_VENCIMENTO,'
      '   CP.DT_PROVAVEL_PGTO,'
      '   CP.DT_PAGAMENTO,'
      '   CP.VL_DESPESA,'
      '   CP.CD_SITUACAO,'
      '   CP.SN_PREVISAO,'
      '   CP.CD_TIPO_TITULO,'
      '   CP.TP_ENTRADA_SAIDA,'
      '   CP.CD_FORMA_PGTO,'
      '   CP.NR_CHEQUE,'
      '   CP.CD_CAIXA,'
      '   CP.CD_TITULO_ORIGEM,'
      '   CP.CD_AUTORIZA,'
      '   CP.CD_TITULO_PRINCIPAL,'
      '   U.NOME,'
      '   P.NM_PESSOA,'
      '   CC.DS_CAIXA,'
      '   PR.DS_PREPARACAO,'
      '   CA.CD_AUTORIZA_SITU,'
      '   CA.DT_AUTORIZA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_COLIGADA'
