        'O_PRINCIPAL,'#13#10'   U.NOME NM_USUARIO_AUTORIZA,'#13#10'   P.NM_PESSOA,'#13#10' ' +
        '  CC.DS_CAIXA,'#13#10'   PR.DS_PREPARACAO,'#13#10'   CA.CD_AUTORIZA_SITU,'#13#10' ' +
        '  CA.DT_AUTORIZA,'#13#10'   SUM(M.VL_ENTRADA) VL_ENTRADAS,'#13#10'   SUM(M.V' +
        'L_SAIDA) VL_SAIDAS,'#13#10'   SUM(M.VL_LIQUIDO) VL_LIQUIDO'#13#10'FROM'#13#10'   F' +
        'IN_CONTAS_PAGAR CP'#13#10'      JOIN PESSOAS P ON'#13#10'         (CP.CD_PES' +
        'SOA = P.CD_PESSOA)'#13#10'      %s'#13#10'      LEFT JOIN FIN_MOV_CP M ON'#13#10' ' +
        '        (CP.CD_TITULO = M.CD_TITULO) AND'#13#10'         (CP.CD_COLIGA' +
        'DA = M.CD_COLIGADA)'#13#10'      LEFT JOIN fin_cadastro_contas CC ON'#13#10 +
        '         (CP.CD_CAIXA = CC.CD_CAIXA)          '#13#10'      LEFT JOIN ' +
        'FIN_CP_PREPARACAO_ITENS PI ON'#13#10'         (CP.CD_TITULO = PI.CD_TI' +
        'TULO) AND'#13#10'         (CP.CD_COLIGADA = PI.CD_COLIGADA)'#13#10'         ' +
        'LEFT JOIN FIN_CP_PREPARACAO PR ON'#13#10'            (PI.CD_PREPARACAO' +
        ' = PR.CD_PREPARACAO)'#13#10'      LEFT JOIN FIN_CONTAS_PAGAR_AUTORIZA ' +
