  object qyMatriculaAluno: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'm.curso,'
      #9't.serie,'
      #9'm.anosemestre'
      'FROM'
      #9'matriculas m'
      
        #9#9'JOIN turmas t ON(m.turma = t.codigo AND m.anosemestre = t.anos' +
        'emestre AND m.curso = t.curso)'
      #9#9'JOIN situacao s ON(m.situacao = s.cd_situacao)'
      'WHERE'
      #9'm.codigoaluno = :cd_pessoa AND'
      #9's.cd_situacao_pai NOT IN(3, 4, 5, 6, 7, 8)'
      'ORDER BY'
      #9'm.anosemestre DESC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 24
    Top = 240
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
  end
