  object qyDados: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   i.CD_INSCRICAO,'
      '   i.CD_PESSOA,'
      '   p.nm_pessoa,'
      '   COALESCE(v.nr_horas_evento,0),'
      '   COALESCE(v.nr_horas_participacao,0),'
      '   COALESCE(v.vl_presenca,0),'
      '   COALESCE(l.nm_livro, '#39#39')  nm_livro,'
      '   c.nr_folha,'
      '   c.nr_registro'
      'FROM'
      '   VIEW_EVENTOS_CARGAS v'
      '   JOIN tam_inscricoes i ON(v.cd_inscricao = i.CD_INSCRICAO)'
      '   JOIN pessoas p ON(i.CD_PESSOA = p.cd_pessoa)'
      
        '    LEFT JOIN certificado_eventos c ON(i.CD_EVENTO = c.cd_evento' +
        ' AND i.CD_PESSOA = c.cd_pessoa)'
      
        '    LEFT JOIN certificado_livros l ON(c.cd_livro = l.cd_cert_liv' +
        'ro)'
      'WHERE'
      '   i.CD_EVENTO = :cd_evento AND'
      '   i.CD_PESSOA = :cd_pessoa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_evento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 24
    Top = 176
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_evento'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
  end
  object qyInsereAtividade: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'INSERT INTO ge_alunos('
      '   cd_pessoa,'
      '   cd_curso,'
      '   nr_anosem,'
      '   nr_etapa,'
      '   cd_ge_atividade,'
      '   nr_horas,'
      '   ds_atividade,'
      '   ds_local,'
      '   dt_inicio,'
      '   dt_termino,'
      '   cd_situacao,'
      '   nr_horas_original'
      ')'
