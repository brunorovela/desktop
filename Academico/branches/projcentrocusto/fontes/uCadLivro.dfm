  object qyInsereLivro: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'INSERT INTO certificado_livros'
      
        '   (nm_livro, cd_tipo, nr_paginas, nr_linhas, pg_atual, sn_abert' +
        'o)'
      'VALUES'
      '   (:nm_livro, "F", :nr_paginas, :nr_linhas, 1, 1)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nm_livro'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_paginas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_linhas'
        ParamType = ptUnknown
      end>
    Left = 40
    Top = 184
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nm_livro'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_paginas'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
