  object qryAreasAtuacao: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'caa.cd_area,'
      #9'caa.ds_area,'
      #9'CAST(caa.me_observacoes as CHAR(100)) as me_observacoes,'
      '               caa.me_observacoes as observacao'
      'FROM'
      #9'cursos_areas_atuacao caa')
    Params = <>
    Left = 408
    Top = 496
    object qryAreasAtuacaocd_area: TLargeintField
