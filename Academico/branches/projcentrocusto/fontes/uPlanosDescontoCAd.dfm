  object tblPlanos: TUMZQuery
    Connection = DM.db
    SortType = stIgnored
    OnNewRecord = tblPlanosNewRecord
    SQL.Strings = (
      'select'
      '   * '
      'from '
      '   PlanosDesconto'
      'ORDER BY '
      '   descricaoplano ')
    Params = <>
    Left = 504
    Top = 312
    object tblPlanosCodigo: TIntegerField
      FieldName = 'Codigo'
      Origin = 'PlanosDesconto.Codigo'
    end
    object tblPlanosPercentualDesconto: TFloatField
      DisplayLabel = '(%)'
      FieldName = 'PercentualDesconto'
      Origin = 'PlanosDesconto.PercentualDesconto'
      DisplayFormat = '##0.00 %'
    end
    object tblPlanosValorDesconto: TFloatField
      DisplayLabel = 'Vlr. Desconto'
      FieldName = 'ValorDesconto'
      Origin = 'PlanosDesconto.ValorDesconto'
      DisplayFormat = '0.00'
    end
    object tblPlanosAcaoMovimento: TStringField
      FieldKind = fkLookup
      FieldName = 'AcaoMovimento'
      LookupDataSet = qyAcoes
      LookupKeyFields = 'cd_acao'
      LookupResultField = 'ds_acao'
      KeyFields = 'cd_acao_movimento'
      Size = 50
      Lookup = True
    end
    object tblPlanossn_condicional: TSmallintField
      FieldName = 'sn_condicional'
      Origin = 'WMESTRE12.planosdesconto.sn_condicional'
    end
    object tblPlanoscd_tipo_desconto: TSmallintField
      FieldName = 'cd_tipo_desconto'
      Origin = 'WMESTRE12.planosdesconto.cd_tipo_desconto'
    end
    object tblPlanoscd_acao_movimento: TLargeintField
      FieldName = 'cd_acao_movimento'
    end
    object tblPlanosdescricaoplano: TStringField
      FieldName = 'descricaoplano'
      Size = 255
    end
  end
  object dtcPlanosDesconto: TDataSource
    DataSet = tblPlanos
    OnStateChange = dtcPlanosDescontoStateChange
    Left = 504
    Top = 344
  end
  object qryMax: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT CAST(MAX(CODIGO) AS NUMBER(19)) AS ULTIMO FROM PLANOSDESC' +
        'ONTO')
    Params = <>
    SQLList.Strings = (
      
        'oracle=SELECT CAST(MAX(CODIGO) AS NUMBER(19)) AS ULTIMO FROM PLA' +
        'NOSDESCONTO'
      
        'mysql-5=SELECT CAST(MAX(CODIGO) AS SIGNED) AS ULTIMO FROM PLANOS' +
        'DESCONTO')
    Left = 504
    Top = 424
    object qryMaxULTIMO: TLargeintField
      FieldName = 'ULTIMO'
      ReadOnly = True
    end
  end
