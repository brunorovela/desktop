  object qyObsExclusaoAtividadeDomiciliar: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  atd.cd_pessoa,'
      '  atd.nr_anosemestre,'
      '  atd.cd_curso,'
      '  atd.cd_turma,'
      '  DATE_FORMAT(atd.dt_inicio, '#39'%d/%m/%Y'#39') dt_inicio,'
      #9'DATE_FORMAT(atd.dt_fim, '#39'%d/%m/%Y'#39') dt_fim,'
      '  s.ds_valor ds_situacao,'
      '  atd.ds_observacao'
      'FROM'
      '  atd_atividades_domiciliares atd'
      
        '  INNER JOIN situacoes s ON (s.codigo = atd.cd_situacao AND s.cd' +
        '_modulo = 525)'
      'WHERE'
      '  atd.cd_atividade = :cd_atividade')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_atividade'
        ParamType = ptUnknown
      end>
    Left = 192
    Top = 512
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_atividade'
        ParamType = ptUnknown
      end>
