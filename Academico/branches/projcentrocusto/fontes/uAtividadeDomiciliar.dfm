  object qySituacao: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  codigo, ds_valor'
      'FROM'
      '  situacoes'
      'WHERE'
      '  cd_modulo = 525'
      'ORDER BY'
      '  cd_situacao')
    Params = <>
    Left = 448
    Top = 176
    object qySituacaocodigo: TLargeintField
      FieldName = 'codigo'
    end
    object qySituacaods_valor: TStringField
      FieldName = 'ds_valor'
      Size = 255
    end
  end
  object qyAtividades: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  a.cd_atividade,'
      '  p.nm_pessoa nm_pessoa,'
      '  a.nr_anosemestre nr_anosemestre,'
      #9'cm.ds_curso ds_curso,'
      '  a.cd_turma cd_turma,'
      #9'DATE_FORMAT(a.dt_inicio, '#39'%d/%m/%Y'#39') dt_inicio,'
      #9'DATE_FORMAT(a.dt_fim, '#39'%d/%m/%Y'#39') dt_fim'
      'FROM'
      '  atd_atividades_domiciliares a'
      '  INNER JOIN pessoas p ON (a.cd_pessoa = p.cd_pessoa)'
      '  INNER JOIN cursos_mestre cm ON (cm.cd_curso = a.cd_curso)'
      #9'INNER JOIN cursos_coligadas cc ON (cc.cd_curso = cm.cd_curso)'
      
        #9'INNER JOIN turmas t ON (t.cd_coligada = cc.cd_coligada AND t.co' +
        'digo = a.cd_turma AND t.anosemestre = a.nr_anosemestre)'
      'WHERE'
      '  cc.cd_coligada = COALESCE(:cd_coligada, cc.cd_coligada) AND'
      '  t.anosemestre = :nr_anosemestre AND'
      '  cm.cd_curso LIKE COALESCE(:cd_curso, cm.cd_curso) AND'
      '  a.cd_turma LIKE COALESCE(:cd_turma, a.cd_turma) AND  '
      '  a.cd_pessoa = COALESCE(:cd_pessoa, a.cd_pessoa) AND'
      '  a.dt_inicio >= COALESCE(:dt_inicio, a.dt_inicio) AND'
      '  a.dt_fim <= COALESCE(:dt_fim, a.dt_fim) AND'
      '  a.cd_situacao = COALESCE(:cd_situacao, a.cd_situacao)'
      'ORDER BY'
      '  a.cd_atividade DESC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dt_inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dt_fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_situacao'
        ParamType = ptUnknown
      end>
    Left = 344
    Top = 344
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dt_inicio'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'dt_fim'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_situacao'
        ParamType = ptUnknown
      end>
    object qyAtividadescd_atividade: TIntegerField
      FieldName = 'cd_atividade'
    end
    object qyAtividadesnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 255
    end
    object qyAtividadesnr_anosemestre: TIntegerField
      FieldName = 'nr_anosemestre'
