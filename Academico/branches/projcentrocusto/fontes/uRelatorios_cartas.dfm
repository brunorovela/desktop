  object qRelatorios: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  r.*'
      'FROM'
      '  relatorios AS r'
      
        '    LEFT JOIN modulos AS m ON(r.ds_grupo = m.modulo AND m.catego' +
        'ria = '#39'Impress'#227'o'#39')'
      
        '      JOIN modulosusuarios AS mu ON(m.codigo = mu.codigomodulo A' +
        'ND mu.codigousuario = :cd_usuario AND mu.acessar = '#39'S'#39')'
      'WHERE'
      '  sn_disponivel = '#39'S'#39' AND'
      '  cd_modulo = :modulo'
      'ORDER BY'
      '  ds_grupo, nm_relatorio')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_usuario'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'modulo'
        ParamType = ptUnknown
      end>
    Left = 587
    Top = 116
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_usuario'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'modulo'
        ParamType = ptUnknown
      end>
  end
