  object qusMatriculasCurso: TZUpdateSQL
    InsertSQL.Strings = (
      'INSERT INTO MATRICULAS_CURSO ('
      '   CD_PESSOA, NR_MATRICULA, CD_CURSO, CD_GRADE, NR_ANOSEM_GRADE,'
      
        '   NR_ANOSEM_INGRESSO, CD_TURNO, DT_INGRESSO, CD_INGRESSO, CD_IN' +
        'STITUICAO,'
      
        '   CD_SITUACAO, NR_ANOSEM_CONCLUSAO, DT_CONCLUSAO, DT_COLACAO, D' +
        'T_EXP_DIPLOMA,'
      
        '   DT_SAIDA, DS_OBS, NR_MEDIA_CURSO, NR_CERT_FOLHA, NR_CERT_REGI' +
        'STRO,'
      '   CD_CERT_LIVRO, SN_GERADO_MANUAL'
      ')'
      'VALUES ('
      
        '   :CD_PESSOA, :NR_MATRICULA, :CD_CURSO, :CD_GRADE, :NR_ANOSEM_G' +
        'RADE,'
      
        '   :NR_ANOSEM_INGRESSO, :CD_TURNO, :DT_INGRESSO, :CD_INGRESSO, :' +
        'CD_INSTITUICAO,'
      
        '   :CD_SITUACAO, :NR_ANOSEM_CONCLUSAO, :DT_CONCLUSAO, :DT_COLACA' +
        'O,'
      
        '   :DT_EXP_DIPLOMA, :DT_SAIDA, :DS_OBS, :NR_MEDIA_CURSO, :NR_CER' +
        'T_FOLHA,'
      '   :NR_CERT_REGISTRO, :CD_CERT_LIVRO, :SN_GERADO_MANUAL'
      ')')
    ModifySQL.Strings = (
      'UPDATE'
      '        MATRICULAS_CURSO'
      'SET'
      '        NR_MATRICULA = :NR_MATRICULA,'
      '        CD_CURSO = :CD_CURSO,'
      '        CD_GRADE = :CD_GRADE,'
      '        NR_ANOSEM_GRADE = :NR_ANOSEM_GRADE,'
      '        NR_ANOSEM_INGRESSO = :NR_ANOSEM_INGRESSO,'
      '        CD_TURNO = :CD_TURNO,'
      '        DT_INGRESSO = :DT_INGRESSO,'
      '        CD_INGRESSO = :CD_INGRESSO,'
      '        CD_INSTITUICAO = :CD_INSTITUICAO,'
      '        CD_SITUACAO = :CD_SITUACAO,'
      '        NR_ANOSEM_CONCLUSAO = :NR_ANOSEM_CONCLUSAO,'
      '        DT_CONCLUSAO = :DT_CONCLUSAO,'
      '        DT_COLACAO = :DT_COLACAO,'
      '        DT_EXP_DIPLOMA = :DT_EXP_DIPLOMA,'
      '        DT_SAIDA = :DT_SAIDA,'
      '        DS_OBS = :DS_OBS,'
      '        NR_CERT_FOLHA = :NR_CERT_FOLHA,'
      '        NR_CERT_REGISTRO = :NR_CERT_REGISTRO,'
      '        CD_CERT_LIVRO = :CD_CERT_LIVRO,'
      '        SN_GERADO_MANUAL = :SN_GERADO_MANUAL'
      'WHERE'
      '        CD_MATRICULA_CURSO = :CD_MATRICULA_CURSO')
    UseSequenceFieldForRefreshSQL = False
    Left = 120
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
