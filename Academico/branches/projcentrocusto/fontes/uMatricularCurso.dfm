  object qyMatriculaCurso: TUMZQuery
    Connection = DM.db
    BeforeOpen = qyMatriculaCursoBeforeOpen
    AfterOpen = qyMatriculaCursoAfterOpen
    UpdateObject = qusMatriculasCurso
    BeforePost = qyMatriculaCursoBeforePost
    OnNewRecord = qyMatriculaCursoNewRecord
    SQL.Strings = (
      'SELECT '
      '   CD_MATRICULA_CURSO,'
      '   CD_PESSOA,'
      '   NR_MATRICULA,'
      '   CD_CURSO,'
      '   CD_GRADE,'
      '   NR_ANOSEM_INGRESSO,'
      '   CD_TURNO,'
      '   DT_INGRESSO,'
      '   CD_INGRESSO,'
      '   CD_INSTITUICAO,'
      '   CD_SITUACAO,'
      '   NR_ANOSEM_CONCLUSAO,'
      '   DT_CONCLUSAO,'
      '   DT_COLACAO,'
      '   DT_EXP_DIPLOMA,'
      '   DT_SAIDA,'
      '   DS_OBS,'
      '   NR_MEDIA_CURSO,'
      '   NR_CERT_FOLHA,'
      '   NR_CERT_REGISTRO,'
      '   CD_CERT_LIVRO,'
      '   SN_GERADO_MANUAL'
      'FROM '
      '   MATRICULAS_CURSO '
      'WHERE'
      '   CD_MATRICULA_CURSO = :CD_MATRICULA_CURSO')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_MATRICULA_CURSO'
        ParamType = ptUnknown
      end>
    Left = 152
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_MATRICULA_CURSO'
        ParamType = ptUnknown
      end>
