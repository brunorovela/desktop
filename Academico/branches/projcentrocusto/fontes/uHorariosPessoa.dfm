  object qyHorarios: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      
        #9'd.descricao, d.sigla, fi.turma, th.cd_horario, th.dia_semana, u' +
        's.ds_sala'
      'FROM '
      #9'fichaindividual fi'
      
        #9'INNER JOIN turmas t ON (t.Codigo = fi.Turma AND t.AnoSemestre =' +
        ' fi.AnoSemestre )'
      
        #9'INNER JOIN disciplinas d ON (fi.Disciplina = d.Codigo AND fi.Cu' +
        'rso = d.Curso)'
      
        #9'LEFT JOIN turmas_horarios th ON(th.disciplina = fi.disciplina A' +
        'ND th.turma = fi.turma AND th.anosemestre = fi.anosemestre)'
      '  LEFT JOIN unim_sala us ON (t.cd_sala = us.id)'
      ''
      'WHERE  '
      #9'fi.CodigoAluno = :codigoaluno AND'
      #9'fi.TurmaMatricula = :turma AND'
      #9'fi.AnoSemestre = :anosemestre')
    Params = <
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    Left = 704
    Top = 288
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    object qyHorariosdescricao: TStringField
      FieldName = 'descricao'
    end
    object qyHorariossigla: TStringField
      FieldName = 'sigla'
    end
    object qyHorarioscd_horario: TIntegerField
      FieldName = 'cd_horario'
    end
    object qyHorariosdia_semana: TIntegerField
      FieldName = 'dia_semana'
    end
    object qyHorariosds_sala: TStringField
      FieldName = 'ds_sala'
    end
    object qyHorariosturma: TStringField
      FieldName = 'turma'
    end
  end
  object qySala: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9's.ds_sala'
      'FROM'
      #9'matriculas m'
      
