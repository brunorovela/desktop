  object qyExtras: TUMZQuery
    Connection = DM.db
    OnCalcFields = qyExtrasCalcFields
    SQL.Strings = (
      'SELECT al.*, p.nm_pessoa, at.ds_ge_atividade, '
      '   gr.ds_ge_grupo ds_ge_grupo_original, ar.ds_ge_area, c.apelido'
      'FROM ge_alunos al '
      
        'INNER JOIN ge_atividades at ON (at.cd_ge_atividade = al.cd_ge_at' +
        'ividade) '
      'INNER JOIN ge_grupos gr ON (at.cd_ge_grupo = gr.cd_ge_grupo)'
      'INNER JOIN ge_areas ar ON (gr.cd_ge_area = ar.cd_ge_area)'
      'INNER JOIN pessoas p ON (p.cd_pessoa = al.cd_pessoa)'
      
        'LEFT JOIN cursos c ON (al.cd_curso = c.codigo AND al.nr_anosem =' +
        ' c.anosemestre)'
      'WHERE 1=1')
    Params = <>
    Left = 712
    Top = 80
