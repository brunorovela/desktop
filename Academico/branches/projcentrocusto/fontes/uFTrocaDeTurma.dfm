  object qyInativarAluno: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      '  diario_grupos_pessoas'
      'SET'
      
        '  dt_saida = CASE WHEN :dt_saida >= dt_entrada THEN :dt_saida EL' +
        'SE NOW() END'
      'WHERE'
      '  cd_pessoa = :cd_pessoa AND'
      '  cd_grupo = :cd_grupo AND'
      '  dt_saida IS NULL')
