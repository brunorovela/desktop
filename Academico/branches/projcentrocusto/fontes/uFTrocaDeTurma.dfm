  object qryAtual: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'select Codigo, Curso, Serie, Turno from Turmas where Codigo = :T' +
        'urma and AnoSemestre = :AnoSemestre')
    Params = <
      item
        DataType = ftUnknown
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end>
    Left = 224
    Top = 336
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end>
  end
  object qryNova: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'select t.Codigo, t.Curso, t.Serie, t.Turno, c.depto, t.cd_coliga' +
        'da from Turmas t, Cursos c'
      'where t.curso = c.codigo and t.anosemestre = c.anosemestre'
