  object qyFiltrar: TUMZQuery
    Connection = DM.db
    AfterOpen = qyFiltrarAfterOpen
    SQL.Strings = (
      'SELECT'
      
        #9'cp.CD_PRODUTO, cp.DS_PRODUTO, SUM(ce.NR_QUANTIDADE) AS NR_QUANT' +
        'IDADE,'
      
        '  SUM(ce.VL_COMPRA) AS VL_TOTAL, ca.CD_COMPRA, ce.CD_PESSOA, p.n' +
        'm_pessoa'
      'FROM'
      #9'comp_acumulados ca'
      #9'INNER JOIN comp_estoque ce ON ( ce.CD_COMPRA = ca.CD_COMPRA )'
      
        #9'INNER JOIN comp_produtos cp ON ( cp.CD_PRODUTO = ce.CD_PRODUTO ' +
        ')'
      '  INNER JOIN pessoas p ON ( p.cd_pessoa = ce.CD_PESSOA )'
      'GROUP BY'
      #9'ce.CD_PESSOA, ce.CD_PRODUTO'
      'ORDER BY'
      '  cp.DS_PRODUTO')
    Params = <>
    Top = 80
    object qyFiltrarSN_SELECIONADO: TIntegerField
      FieldKind = fkCalculated
      FieldName = 'SN_SELECIONADO'
      Calculated = True
    end
    object qyFiltrarDS_PRODUTO: TStringField
      FieldName = 'DS_PRODUTO'
      Required = True
      Size = 255
    end
    object qyFiltrarNR_QUANTIDADE: TLargeintField
      FieldName = 'NR_QUANTIDADE'
      ReadOnly = True
    end
    object qyFiltrarVL_TOTAL: TFloatField
      FieldName = 'VL_TOTAL'
      ReadOnly = True
      DisplayFormat = '###,###,##0.00'
    end
    object qyFiltrarCD_COMPRA: TIntegerField
      FieldName = 'CD_COMPRA'
      Required = True
    end
    object qyFiltrarCD_PESSOA: TIntegerField
      FieldName = 'CD_PESSOA'
    end
    object qyFiltrarNM_PESSOA: TStringField
      FieldName = 'NM_PESSOA'
      Size = 60
    end
    object qyFiltrarCD_PRODUTO: TStringField
      FieldName = 'CD_PRODUTO'
      Required = True
      Size = 30
    end
  end
