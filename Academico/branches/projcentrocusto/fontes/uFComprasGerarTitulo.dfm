  object qyItensVenda: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT ca.DT_REGISTRO, ce.NR_QUANTIDADE, ce.VL_COMPRA'
      'FROM COMP_ESTOQUE ce'
      
        '     INNER JOIN COMP_ACUMULADOS ca ON ( ca.CD_COMPRA = ce.CD_COM' +
        'PRA )'
      
        'WHERE ce.CD_PESSOA = :CD_PESSOA AND ce.CD_PRODUTO = :CD_PRODUTO ' +
        'AND'
      '      ce.TP_ENTRADA_SAIDA = 2 AND ca.SN_PAGO = 0'
      'ORDER BY ca.DT_REGISTRO')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PRODUTO'
        ParamType = ptUnknown
      end>
    Top = 112
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PRODUTO'
        ParamType = ptUnknown
      end>
    object qyItensVendaDT_REGISTRO: TDateTimeField
      FieldName = 'DT_REGISTRO'
      Required = True
      DisplayFormat = 'dd/mm/yyyy'
    end
    object qyItensVendaNR_QUANTIDADE: TIntegerField
      FieldName = 'NR_QUANTIDADE'
      Required = True
    end
    object qyItensVendaVL_COMPRA: TFloatField
      FieldName = 'VL_COMPRA'
      DisplayFormat = '###,###,##0.000'
    end
  end
  object dsItensVenda: TDataSource
    DataSet = qyItensVenda
    Left = 32
    Top = 112
  end
