  object qryContas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  ds_caixa, cd_caixa'
      'FROM'
      '  fin_cadastro_contas'
      'WHERE'
      '  cd_coligada IN ( -1 ) OR sn_todas_coligadas = 1'
      'ORDER BY'
      '  ds_caixa')
