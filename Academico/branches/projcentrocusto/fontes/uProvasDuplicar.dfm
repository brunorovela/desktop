  object qyProvas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  dp.cd_prova,'
      '  dp.anosemestre,'
      #9'dp.turma,'
      #9'd.descricao disciplina,'
      #9'dp.nro_nota,'
      #9'prof.nm_pessoa nm_professor,'
      #9'avt.ds_avaliacao ds_avaliacao_tipo,'
      #9'dp.assunto,'
      #9'dp.data'
      'FROM'
      '  diario_provas dp'
      
        #9'INNER JOIN avaliacoes_tipos avt ON (avt.cd_avaliacao_tipo = dp.' +
        'cd_avaliacao_tipo)'
      
        #9'INNER JOIN turmas t ON (t.codigo = dp.turma AND t.anosemestre =' +
        ' dp.anosemestre)'
      
        #9'INNER JOIN disciplinas d ON (d.codigo = dp.disciplina AND d.cur' +
        'so = t.curso)'
      #9'LEFT JOIN pessoas prof ON (prof.cd_pessoa = dp.cd_professor)'
      'WHERE'
      '  dp.cd_prova IN (:cd_provas)'
      'ORDER BY'
      
        #9'dp.anosemestre, dp.turma, dp.disciplina, dp.bimestre, dp.nro_no' +
        'ta')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_provas'
        ParamType = ptUnknown
      end>
    Left = 352
    Top = 176
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_provas'
        ParamType = ptUnknown
      end>
    object qyProvascd_prova: TIntegerField
