  object qyInserirProva: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'INSERT IGNORE INTO diario_provas (turma, cd_professor, disciplin' +
        'a, anosemestre, bimestre, data, assunto, sn_bloqueado, sn_profic' +
        'iencia, nro_nota, sn_especial, sn_compoe, nr_dias_bloqueio, ds_c' +
        'have, vl_peso, nr_nota_minima, nr_nota_maxima, cd_avaliacao_tipo' +
        ')'
      'SELECT'
      #9'dp.turma,'
      #9'dp.cd_professor,'
      #9'dp.disciplina,'
      #9'dp.anosemestre,'
      '  :bimestre,'
      #9':data,'
      #9'dp.assunto,'
      #9'dp.sn_bloqueado,'
      #9'dp.sn_proficiencia,'
      
        #9'(SELECT CASE WHEN ((dp.nro_nota = -1) OR (sn_especial = 1)) THE' +
        'N -1 ELSE COALESCE(MAX(dpn.nro_nota), 0)+1 END'
      
        '  FROM diario_provas dpn WHERE dpn.anosemestre = dp.anosemestre ' +
        'AND dpn.turma = dp.turma AND dpn.disciplina = dp.disciplina AND ' +
        'dpn.nro_nota > 0 AND dpn.bimestre = :bimestre) nro_nota,'
      #9'dp.sn_especial, '
      #9'dp.sn_compoe, '
      #9'dp.nr_dias_bloqueio, '
      #9'dp.ds_chave, '
      #9'dp.vl_peso, '
      #9'dp.nr_nota_minima, '
      #9'dp.nr_nota_maxima,'
      #9'dp.cd_avaliacao_tipo'
      'FROM'
      #9'diario_provas dp'
      'WHERE'
      #9'dp.cd_prova = :cd_prova')
    Params = <
      item
        DataType = ftUnknown
        Name = 'bimestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'data'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_prova'
        ParamType = ptUnknown
      end>
    Left = 312
    Top = 176
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'bimestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'data'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_prova'
        ParamType = ptUnknown
      end>
