  object qyMotivos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   CD_SITUACAO,'
      '   DS_VALOR,'
      '   DS_SIGLA'
      'FROM'
      '   SITUACOES'
      'WHERE'
      '   CD_MODULO = 1145'
      'ORDER BY'
      '   DS_SIGLA')
    Params = <>
    Left = 488
    Top = 120
  end
