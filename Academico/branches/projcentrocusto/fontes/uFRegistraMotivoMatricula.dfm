  object qyAtuaDataSaida: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      '   matriculas'
      'SET'
      '   datasaida = :datasaida'
      'WHERE'
      '   anosemestre = :anosemestre AND'
      '   turma = :turma AND'
      '   codigoaluno = :codigoaluno AND'
      '   curso = :curso')
    Params = <
      item
        DataType = ftUnknown
        Name = 'datasaida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end>
    Left = 472
    Top = 264
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datasaida'
        ParamType = ptUnknown
      end
      item
