  object qRelatorios: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   FIRST_OCCURRENCE(R.NM_RELATORIO) NM_RELATORIO,'
      '   FIRST_OCCURRENCE(R.CD_MODULO) CD_MODULO,'
      '   FIRST_OCCURRENCE(R.CD_CABECALHO) CD_CABECALHO,'
      '   FIRST_OCCURRENCE(R.DS_GRUPO) DS_GRUPO,'
      '   FIRST_OCCURRENCE(R.NM_ARQUIVO) NM_ARQUIVO,'
      '   FIRST_OCCURRENCE(R.DS_PARAMETROS) DS_PARAMETROS,'
      '   FIRST_OCCURRENCE(R.DS_ORDEM) DS_ORDEM,'
      '   FIRST_OCCURRENCE(R.SN_DISPONIVEL) SN_DISPONIVEL,'
      '   FIRST_OCCURRENCE(R.DS_FORMULA_GRUPO) DS_FORMULA_GRUPO,'
      '   FIRST_OCCURRENCE(R.DS_SQL_ORDEM) DS_SQL_ORDEM,'
      '   FIRST_OCCURRENCE(R.SN_IMPRESSAO_NUMERO) SN_IMPRESSAO_NUMERO,'
      '   FIRST_OCCURRENCE(R.DS_VARIAVEIS) DS_VARIAVEIS,'
      '   FIRST_OCCURRENCE(R.DS_FORMULA) DS_FORMULA,'
      '   FIRST_OCCURRENCE(R.DS_SQL_EXP) DS_SQL_EXP,'
      '   FIRST_OCCURRENCE(R.DS_ESPECIAL) DS_ESPECIAL,'
      '   FIRST_OCCURRENCE(R.DS_SQL) DS_SQL,'
      '   R.CD_RELATORIO,'
      '   FIRST_OCCURRENCE(R.SN_PODE_EXPORTAR) SN_PODE_EXPORTAR'
      'FROM'
      '   RELATORIOS R'
      '      LEFT JOIN NU_MODULOS_ACOES MA ON'
      '         (CONCAT('#39'Rel.Grupo.'#39', R.DS_GRUPO) = MA.DS_CHAVE)'
      '         LEFT JOIN NU_MODULOS M ON'
      '            (MA.CD_MODULO = M.CD_MODULO) AND'
      '              (M.DS_CHAVE = :DS_CHAVE)'
      '         LEFT JOIN NU_GRUPOS_PERMISSOES GP ON'
      '            (MA.CD_ACAO = GP.CD_ACAO)'
      '            LEFT JOIN NU_GRUPOS_PESSOAS GPE ON'
      '               (GP.CD_GRUPO = GPE.CD_GRUPO) AND'
      '               (GPE.CD_PESSOA = :CD_PESSOA)'
      'WHERE'
      '   R.SN_DISPONIVEL = '#39'S'#39' AND'
      '   R.CD_MODULO = :CD_MODULO AND'
      '   (MOD(GP.NR_PERMISSAO, 2)) = 1'
      'GROUP BY'
      '   R.CD_RELATORIO'
      'ORDER BY'
      '   DS_GRUPO, NM_RELATORIO')
    Params = <
      item
        DataType = ftUnknown
        Name = 'DS_CHAVE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_MODULO'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=SELECT'#13#10'   FIRST_OCCURRENCE(R.NM_RELATORIO) NM_RELATORIO,' +
        #13#10'   FIRST_OCCURRENCE(R.CD_MODULO) CD_MODULO,'#13#10'   FIRST_OCCURREN' +
        'CE(R.CD_CABECALHO) CD_CABECALHO,'#13#10'   FIRST_OCCURRENCE(R.DS_GRUPO' +
        ') DS_GRUPO,'#13#10'   FIRST_OCCURRENCE(R.NM_ARQUIVO) NM_ARQUIVO,'#13#10'   F' +
        'IRST_OCCURRENCE(R.DS_PARAMETROS) DS_PARAMETROS,'#13#10'   FIRST_OCCURR' +
        'ENCE(R.DS_ORDEM) DS_ORDEM,'#13#10'   FIRST_OCCURRENCE(R.SN_DISPONIVEL)' +
        ' SN_DISPONIVEL,'#13#10'   FIRST_OCCURRENCE(R.DS_FORMULA_GRUPO) DS_FORM' +
        'ULA_GRUPO,'#13#10'   FIRST_OCCURRENCE(R.DS_SQL_ORDEM) DS_SQL_ORDEM,'#13#10' ' +
        '  FIRST_OCCURRENCE(R.SN_IMPRESSAO_NUMERO) SN_IMPRESSAO_NUMERO,'#13#10 +
        '   FIRST_OCCURRENCE(R.DS_VARIAVEIS) DS_VARIAVEIS,'#13#10'   FIRST_OCCU' +
        'RRENCE(R.DS_FORMULA) DS_FORMULA,'#13#10'   FIRST_OCCURRENCE(R.DS_SQL_E' +
        'XP) DS_SQL_EXP,'#13#10'   FIRST_OCCURRENCE(R.DS_ESPECIAL) DS_ESPECIAL,' +
        #13#10'   FIRST_OCCURRENCE(R.DS_SQL) DS_SQL,'#13#10'   R.CD_RELATORIO,'#13#10'   ' +
        'FIRST_OCCURRENCE(R.SN_PODE_EXPORTAR) SN_PODE_EXPORTAR'#13#10'FROM'#13#10'   ' +
        'RELATORIOS R'#13#10'      LEFT JOIN NU_MODULOS_ACOES MA ON'#13#10'         (' +
        'CONCAT('#39'Rel.Grupo.'#39', R.DS_GRUPO) = MA.DS_CHAVE)'#13#10'         LEFT J' +
        'OIN NU_MODULOS M ON'#13#10'            (MA.CD_MODULO = M.CD_MODULO) AN' +
        'D'#13#10'            (M.DS_CHAVE = :DS_CHAVE)'#13#10'         LEFT JOIN NU_G' +
        'RUPOS_PERMISSOES GP ON'#13#10'            (MA.CD_ACAO = GP.CD_ACAO)'#13#10' ' +
        '           LEFT JOIN NU_GRUPOS_PESSOAS GPE ON'#13#10'               (G' +
        'P.CD_GRUPO = GPE.CD_GRUPO) AND'#13#10'               (GPE.CD_PESSOA = ' +
        ':CD_PESSOA)'#13#10'WHERE'#13#10'   R.SN_DISPONIVEL = '#39'S'#39' AND'#13#10'   (MOD(GP.NR_' +
        'PERMISSAO, 2)) = 1'#13#10'GROUP BY'#13#10'   R.CD_RELATORIO'#13#10'ORDER BY'#13#10'   DS' +
        '_GRUPO, NM_RELATORIO'
      
        'mysql-5=SELECT'#13#10'   R.NM_RELATORIO,'#13#10'   R.CD_MODULO,'#13#10'   R.CD_CAB' +
        'ECALHO,'#13#10'   R.DS_GRUPO,'#13#10'   R.NM_ARQUIVO,'#13#10'   R.DS_PARAMETROS,'#13#10 +
        '   R.DS_ORDEM,'#13#10'   R.SN_DISPONIVEL,'#13#10'   R.DS_FORMULA_GRUPO,'#13#10'   ' +
        'R.DS_SQL_ORDEM,'#13#10'   R.SN_IMPRESSAO_NUMERO,'#13#10'   R.DS_VARIAVEIS,'#13#10 +
        '   R.DS_FORMULA,'#13#10'   R.DS_SQL_EXP,'#13#10'   R.DS_ESPECIAL,'#13#10'   R.DS_S' +
        'QL,'#13#10'   R.CD_RELATORIO,'#13#10'   R.SN_PODE_EXPORTAR'#13#10'FROM'#13#10'   relator' +
        'ios r'#13#10'   JOIN NU_MODULOS_ACOES MA ON'#13#10'         (CONCAT('#39'Rel.Gru' +
        'po.'#39', R.DS_GRUPO) = MA.DS_CHAVE)'#13#10'      '#9' JOIN NU_MODULOS M ON'#13#10 +
        '            (MA.CD_MODULO = M.CD_MODULO) AND'#13#10'            (M.DS_' +
        'CHAVE = :DS_CHAVE)'#13#10'        JOIN NU_GRUPOS_PERMISSOES GP ON'#13#10'   ' +
        '        (MA.CD_ACAO = GP.CD_ACAO AND gp.nr_permissao >= 1)'#13#10'    ' +
        '     JOIN NU_GRUPOS_PESSOAS GPE ON'#13#10'               (GP.CD_GRUPO ' +
        '= GPE.CD_GRUPO)'#13#10'WHERE'#13#10'   GPE.CD_PESSOA = :CD_PESSOA AND'#13#10'   R.' +
        'SN_DISPONIVEL = '#39'S'#39#13#10'GROUP BY'#13#10'   R.CD_RELATORIO'#13#10'ORDER BY'#13#10'   D' +
        'S_GRUPO, NM_RELATORIO')
    Left = 651
    Top = 84
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DS_CHAVE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_MODULO'
        ParamType = ptUnknown
      end>
  end
