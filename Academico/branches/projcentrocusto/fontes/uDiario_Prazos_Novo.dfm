  object qyPrazos: TUMZQuery
    Connection = DM.db
    BeforePost = qyPrazosBeforePost
    SQL.Strings = (
      'SELECT'
      '   dp.*'
      'FROM'
      '  dia_prazos dp'
      #9'JOIN dia_prazos_turmas dpt ON(dpt.CD_PRAZO = dp.CD_PRAZO)'
      #9'JOIN turmas t ON(t.codigo = dpt.CD_TURMA)'
      'WHERE'
      #9'dp.nr_anosemestre = :nr_anosemestre'
      #9'AND t.cd_coligada IN ( :coligadas )'
      'GROUP BY dp.cd_prazo'
      'ORDER BY'
      '  dp.cd_prazo DESC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'coligadas'
        ParamType = ptUnknown
      end>
    Left = 592
    Top = 240
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'coligadas'
        ParamType = ptUnknown
      end>
