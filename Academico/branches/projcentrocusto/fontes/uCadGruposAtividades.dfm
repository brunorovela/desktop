  object qyVerificaRemoverAluno: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'COUNT(daa.cd_pessoa) possui_aula,'
      '  COUNT(dpa.cd_pessoa) possui_provas,'
      '  COUNT(datia.cd_pessoa) possui_atividades'
      'FROM'
      #9'diario_grupos dg'
      
        #9'INNER JOIN diario_grupos_pessoas dgp ON (dgp.cd_grupo = dg.cd_g' +
        'rupo AND dgp.dt_saida IS NULL)'
      #9'LEFT JOIN diario_aulas da ON (da.cd_grupo = dg.cd_grupo)'
      #9'LEFT JOIN diario_aulas_alunos daa ON ('
      #9#9#9'daa.nr_anosem = da.anosemestre AND'
      #9#9#9'daa.cd_turma = da.turma AND'
      #9#9#9'daa.cd_disciplina = da.disciplina AND'
      #9#9#9'daa.cd_bimestre = da.bimestre AND'
      #9#9#9'daa.nr_aula = da.nro_aula AND'
      #9#9#9'daa.cd_pessoa = dgp.cd_pessoa'
      #9')'
      #9'LEFT JOIN diario_provas dp ON (dp.cd_grupo = dg.cd_grupo)'
      #9'LEFT JOIN diario_provas_alunos dpa ON ('
      #9#9#9'dpa.nr_anosem = dp.anosemestre AND'
      #9#9#9'dpa.cd_turma = dp.turma AND'
      #9#9#9'dpa.cd_disciplina = dp.disciplina AND'
      #9#9#9'dpa.cd_bimestre = dp.bimestre AND'
      #9#9#9'dpa.nr_prova = dp.nro_nota AND'
      #9#9#9'dpa.cd_pessoa = dgp.cd_pessoa'
      #9')'
      
        '  LEFT JOIN diario_atividades dat ON (dat.cd_grupo = dg.cd_grupo' +
        ')'
      #9'LEFT JOIN diario_atividades_alunos datia ON ('
      #9#9#9'datia.cd_atividade = dat.cd_atividade AND'
      #9#9#9'datia.cd_pessoa = dgp.cd_pessoa'
      #9')'
      'WHERE'
      #9'dg.cd_grupo = :cd_grupo AND'
      #9'dgp.cd_pessoa = :cd_pessoa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 632
    Top = 318
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qyVerificaRemoverAlunopossui_aula: TLargeintField
      FieldName = 'possui_aula'
    end
    object qyVerificaRemoverAlunopossui_provas: TLargeintField
      FieldName = 'possui_provas'
    end
    object qyVerificaRemoverAlunopossui_atividades: TLargeintField
      FieldName = 'possui_atividades'
    end
  end
