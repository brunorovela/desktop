  object qyBuscarAlunos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'p.cd_pessoa,'
      #9'p.nm_pessoa,'
      #9'CASE WHEN dgp.cd_grupo > 0 THEN 1 ELSE 0 END selecionado'
      'FROM'
      #9'fichaindividual fi'
      #9'INNER JOIN pessoas p ON (p.cd_pessoa = fi.codigoaluno)'
      #9'LEFT JOIN diario_grupos_pessoas dgp ON ('
      #9#9'dgp.cd_pessoa = fi.codigoaluno AND'
      #9#9'dgp.cd_grupo = :cd_grupo AND'
      #9#9'dgp.dt_saida IS NULL'
      #9')'
      'WHERE'
      #9'fi.anosemestre = :nr_anosemestre AND'
      #9'fi.curso LIKE :cd_curso AND'
      #9'fi.turma LIKE :cd_turma AND'
      #9'fi.disciplina = :cd_disciplina AND'
      '  fi.situacao IN (0, 1, 2, 9, 10, 11)'
      'ORDER BY'
      '  p.nm_pessoa ASC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_disciplina'
        ParamType = ptUnknown
      end>
    Left = 664
    Top = 318
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_grupo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_disciplina'
        ParamType = ptUnknown
      end>
