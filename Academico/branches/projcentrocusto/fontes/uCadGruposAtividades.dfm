  object qySalvarGrupo: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'INSERT INTO diario_grupos (cd_grupo, nm_grupo, nr_anosemestre, c' +
        'd_curso, cd_turma, cd_disciplina, cd_professor, nr_max_alunos, s' +
        'n_ativo) VALUES (:cd_grupo, :nm_grupo, :nr_anosemestre, :cd_curs' +
        'o, :cd_turma, :cd_disciplina, :cd_professor, :nr_max_alunos, :sn' +
        '_ativo)'
      
        '  ON DUPLICATE KEY UPDATE nm_grupo=VALUES(nm_grupo), cd_professo' +
        'r=VALUES(cd_professor), nr_max_alunos=VALUES(nr_max_alunos), sn_' +
        'ativo=VALUES(sn_ativo)')
    Params = <
      item
        DataType = ftUnknown
