  object qyEstoque: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '                ce.CD_COMPRA,'
      #9'cp.DS_PRODUTO,'
      #9'ce.DT_ENTRADA,'
      '                ce.TP_ENTRADA_SAIDA,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA = 1 || ce.TP_ENTRADA_SAIDA = 3 TH' +
        'EN'
      #9#9'CONCAT(ce.NR_QUANTIDADE, '#39#39')'
      #9'ELSE'
      #9#9#39#39
      #9'END AS DS_ENTRADA,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA != 1 AND ce.TP_ENTRADA_SAIDA != 3' +
        ' THEN'
      #9#9'CONCAT(ce.NR_QUANTIDADE, '#39#39')'
      #9'ELSE'
      #9#9#39#39
      #9'END AS DS_SAIDA,'
      #9'ce.NR_QUANTIDADE,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA = 1 || ce.TP_ENTRADA_SAIDA = 3 TH' +
        'EN'
      #9#9'CONCAT(CASE'
      #9#9#9'WHEN ce.TP_PESSOA = 1 THEN'
      #9#9#9#9'p.nm_pessoa'
      #9#9#9'WHEN ce.TP_PESSOA = 2 THEN'
      #9#9#9#9'e.nm_empresa'
      #9#9#9'ELSE'
      #9#9#9#9#39'[N'#227'o informado]'#39
      
        #9#9'END, CAST( CASE WHEN ce.TP_ENTRADA_SAIDA = 3 THEN '#39' (Estorno)'#39 +
        ' ELSE '#39' '#39' END AS char ))'
      #9'ELSE'
      #9#9#39'Almoxarifado'#39
      #9'END AS DS_ORIGEM,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA = 1 || ce.TP_ENTRADA_SAIDA = 3 TH' +
        'EN'
      #9#9#39'Almoxarifado'#39
      #9'ELSE'
      #9#9'CASE'
      #9#9#9'WHEN ce.TP_PESSOA = 1 THEN'
      #9#9#9#9'p.nm_pessoa'
      #9#9#9'WHEN ce.TP_PESSOA = 2 THEN'
      #9#9#9#9'e.nm_empresa'
      #9#9#9'ELSE'
      #9#9#9#9#39#39
      #9#9'END'
      #9'END AS DS_DESTINO,'
      '  ce.CD_MENSALIDADE'
      'FROM'
      #9'comp_estoque ce'
      
        #9'INNER JOIN comp_produtos cp ON ( cp.CD_PRODUTO = ce.CD_PRODUTO ' +
        ')'
      
        #9'LEFT JOIN pessoas p ON ( ce.TP_PESSOA = 1 AND p.cd_pessoa = ce.' +
        'CD_PESSOA )'
      
        #9'LEFT JOIN empresas e ON ( ce.TP_PESSOA = 2 AND e.cd_empresa = p' +
        '.cd_pessoa )'
      'ORDER BY'
      '  ce.DT_ENTRADA')
    Params = <>
    Left = 496
    Top = 72
    object qyEstoqueDS_PRODUTO: TStringField
      FieldName = 'DS_PRODUTO'
      Required = True
      Size = 255
    end
    object qyEstoqueDT_ENTRADA: TDateTimeField
      FieldName = 'DT_ENTRADA'
      DisplayFormat = 'dd/mm/yyyy'
    end
    object qyEstoqueDS_ENTRADA: TStringField
      FieldName = 'DS_ENTRADA'
      ReadOnly = True
      Size = 7
    end
    object qyEstoqueDS_SAIDA: TStringField
      FieldName = 'DS_SAIDA'
      ReadOnly = True
      Size = 5
    end
    object qyEstoqueDS_ORIGEM: TStringField
      FieldName = 'DS_ORIGEM'
      ReadOnly = True
      Size = 80
    end
    object qyEstoqueDS_DESTINO: TStringField
      FieldName = 'DS_DESTINO'
      ReadOnly = True
      Size = 80
    end
    object qyEstoqueTP_ENTRADA_SAIDA: TSmallintField
      FieldName = 'TP_ENTRADA_SAIDA'
      Required = True
    end
    object qyEstoqueCD_COMPRA: TIntegerField
      FieldName = 'CD_COMPRA'
      Required = True
    end
    object qyEstoqueCD_MENSALIDADE: TIntegerField
      FieldName = 'CD_MENSALIDADE'
    end
  end
