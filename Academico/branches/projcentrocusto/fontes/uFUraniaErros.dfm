    Left = 608
    Top = 256
  end
  object qyDisciplinas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      '('
      'SELECT'
      '   1 as vinculado,'
      '   d.codigo,'
      '   d.curso,'
      '   d.sigla,'
      '   d.descricao descricao'
      'FROM'
      '   turmasprofessores tp'
      '      JOIN disciplinas d ON'
      '         (tp.disciplina = d.codigo) AND'
      '         (tp.curso = d.curso)'
      'WHERE'
      '   anosemestre = :anosemestre AND'
      '   turma = :turma AND'
      '   professor = :professor'
      ')'
      'UNION'
      '('
      'SELECT'
      '   0 as vinculado,'
      '   d.codigo,'
      '   d.curso,'
      '   d.sigla,'
      '   d.descricao descricao'
      'FROM'
      '   disciplinas d'
      '      JOIN turmas t ON (t.curso = d.curso)'
      'WHERE'
      '   t.codigo = :turma AND'
      '   t.anosemestre = :anosemestre AND'
      '   d.codigo = :codigo'
      ')'
      'ORDER BY'
      '   descricao')
    Params = <
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'professor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
    Left = 608
    Top = 96
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'professor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigo'
        ParamType = ptUnknown
      end>
  end
