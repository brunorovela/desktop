  object qyHorarios: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   codigo,'
      '   ds_horario,'
      '   hr_inicio,'
      '   hr_fim,'
      '   ds_sigla,'
      '   turno,'
      '   ds_chave,'
      '   ds_categoria,'
      '   cd_horario_urania'
      'FROM'
      '   horarios'
      'WHERE'
      '   ds_categoria = :ds_categoria'
      'ORDER BY'
      '   hr_inicio')
    Params = <
      item
        DataType = ftUnknown
        Name = 'ds_categoria'
        ParamType = ptUnknown
      end>
    Left = 608
    Top = 32
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ds_categoria'
        ParamType = ptUnknown
      end>
  end
  object qyProfessores: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   p.cd_pessoa,'
      '   p.nm_pessoa,'
      
        '   IF(ISNULL(r.sn_professor), 2, IF(r.sn_professor = "S", 0, 1))' +
        ' sn_professor'
      'FROM'
      '   pessoas p'
      '      LEFT JOIN professores r ON'
      '         (p.cd_pessoa = r.cd_pessoa)'
      'WHERE'
      '   p.cd_pessoa IN (%s)')
    Params = <>
    Left = 608
    Top = 64
  end
