      'SELECT'
      #9'fcac.ds_nome,'
      #9'IF(fco.sn_credito = 1, '#39'Cr'#233'dito'#39', '#39'D'#233'bito'#39') AS tipo_operacao,'
      #9'fcp.nr_parcela,'
      #9'fcp.dt_vencimento,'
      
        #9'IF(fcp.sn_liquidado = 1, '#39'Recebido'#39', '#39'Aguardando Recebimento'#39') ' +
        'AS situacao,'
      #9'fcp.vl_valor_parcela AS vl_parcela,'
      #9'fco.nr_taxa,'
      
        #9'ROUND((ROUND((fco.nr_taxa * fcp.vl_valor_parcela), 2) / 100), 2' +
        ') AS tarifa,'
      
        #9'ROUND(fcp.vl_valor_parcela - ROUND((ROUND((fco.nr_taxa * fcp.vl' +
        '_valor_parcela), 2) / 100), 2),2) AS valor_liquido,'
      #9'fcc.ds_caixa,'
      #9'fco.cd_operacao,'
      '  fcp.cd_parcela,'
      #9'fcac.cd_admin_cartao,'
      #9'fco.sn_credito,'
      '  fcp.sn_liquidado '
      'FROM'
      #9'fin_cartao_parcelas fcp'
      'INNER JOIN fin_cartao_operacao fco ON('
      #9'fco.cd_operacao = fcp.cd_operacao'
      ')'
      'INNER JOIN fin_cadastro_contas fcc ON ('
      #9'fcc.cd_caixa = fcp.cd_caixa_atual'
      ')'
      'INNER JOIN fin_cadastro_admin_cartao fcac ON ('
      #9'fcac.cd_admin_cartao = fco.cd_admin_cartao'
      ')'
      'WHERE'
      #9'fcp.dt_vencimento >= DATE_FORMAT(NOW(), '#39'%Y-%m-%d'#39') '
      
        #9'AND fcp.dt_vencimento <= DATE_FORMAT(DATE_ADD(NOW(),INTERVAL 7 ' +
        'day), '#39'%Y-%m-%d'#39')')
    Params = <>
