  object tblContratos: TUMZQuery
    CachedUpdates = True
    OnCalcFields = tblContratosCalcFields
    Connection = db
    
    SQL.Strings = (
      'SELECT Alunos.*, Matriculas.*, PlanosPagamento.*, Turmas.*'
      'FROM Turmas INNER JOIN '
      '(PlanosPagamento INNER JOIN (Alunos INNER JOIN Matriculas '
      'ON Alunos.Codigo = Matriculas.CodigoAluno) '
      'ON PlanosPagamento.Codigo = Matriculas.PlanoPagamento) '
      'ON Turmas.Codigo = Matriculas.Turma'
      'where'
      '(Matriculas.CodigoAluno = :Codigo) and'
      '(Matriculas.Turma = :Turma) and'
      '(Matriculas.AnoSemestre = :AnoSemestre) and'
      '(Turmas.AnoSemestre = :AnoSemestre)')
    Params.Data = {
      0100040006436F6469676F00030400000000000000055475726D610001020030
      0000000B416E6F53656D6573747265000304000000000000000B416E6F53656D
      657374726500030400000000000000}
    Left = 56
    Top = 16
