  object qyFiltrar: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   t.anosemestre anosemestre,'
      '   cm.ds_curso curso,'
      '   t.codigo turma,'
      '   d.id_disciplina id_disciplina,'
      '   d.descricao disciplina,'
      '   t.serie etapa,'
      '   cm.cd_curso as cd_curso'
      ''
      'FROM'
      ''
      '   disciplinas d'
      ''
      
        'INNER JOIN grades_disciplinas g ON ( g.CD_DISCIPLINA = d.codigo ' +
        'AND g.CD_CURSO = d.curso )'
      
        'INNER JOIN turmas t ON ( t.cd_grade = g.cd_grade AND t.curso = g' +
        '.cd_curso AND t.serie = g.nr_serie )'
      'INNER JOIN coligadas c on ( t.cd_coligada = c.cd_coligada )'
      'LEFT JOIN cursos_mestre cm ON (d.curso = cm.cd_curso)')
    Params = <>
    Left = 776
    Top = 352
    object qyFiltraranosemestre: TIntegerField
      FieldName = 'anosemestre'
    end
    object qyFiltrarcurso: TStringField
      FieldName = 'curso'
      Size = 250
    end
    object qyFiltrarcd_turma: TStringField
      FieldName = 'turma'
      Size = 250
    end
    object qyFiltrardisciplina: TStringField
      FieldName = 'disciplina'
      Size = 250
    end
    object qyFiltrarid_disciplina: TLargeintField
      FieldName = 'id_disciplina'
    end
    object qyFiltrarcd_curso: TStringField
      FieldName = 'cd_curso'
      Size = 150
    end
  end
