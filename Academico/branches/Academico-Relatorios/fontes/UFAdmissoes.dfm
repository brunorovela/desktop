  object updAdmissoes: TZUpdateSQL
    DeleteSQL.Strings = (
      'DELETE C.* FROM `ADMISSAO_HISTORICO_CAMPO_CURSO` C'
      'WHERE'
      #9'EXISTS ('
      #9#9'SELECT'
      #9#9#9'H.`CD_ADMISSAO_HISTORICO`'
      #9#9'FROM'
      #9#9#9'`ADMISSAO_HISTORICO` H'
      #9#9'WHERE'
      #9#9#9'C.`CD_ADMISSAO_HISTORICO` = H.`CD_ADMISSAO_HISTORICO` AND'
      #9#9#9'H.`CD_ADMISSAO` = :CD_ADMISSAO'
      #9');'
      ''
      'DELETE C.* FROM `ADMISSAO_HISTORICO_CAMPO` C'
      'WHERE'
      #9'EXISTS ('
      #9#9'SELECT'
      #9#9#9'H.`CD_ADMISSAO_HISTORICO`'
      #9#9'FROM'
      #9#9#9'`ADMISSAO_HISTORICO` H'
      #9#9'WHERE'
      #9#9#9'C.`CD_ADMISSAO_HISTORICO` = H.`CD_ADMISSAO_HISTORICO` AND'
      #9#9#9'H.`CD_ADMISSAO` = :CD_ADMISSAO'
      #9');'
      ''
      'DELETE FROM `ADMISSAO_HISTORICO`'
      'WHERE'
      #9'`CD_ADMISSAO` = :CD_ADMISSAO;'
      ''
      'DELETE FROM `ADMISSAO`'
      'WHERE'
      '        `CD_ADMISSAO` = :CD_ADMISSAO')
    UseSequenceFieldForRefreshSQL = False
    Left = 480
    Top = 152
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_ADMISSAO'
        ParamType = ptUnknown
      end>
  end
