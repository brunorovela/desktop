      'SELECT'
      '  `CD_ADMISSAO`,'
      '  `CD_PESSOA`,'
      '  `CD_FUNCAO`,'
      '  `CD_SITUACAO`,'
      '  `DT_ADMISSAO`,'
      '  `DT_SAIDA`,'
      '  `VL_HORAS_SEMANAIS`,'
      '  `DS_OBSERVACAO`,'
      '  `DS_CODIGO_EXTERNO`'
