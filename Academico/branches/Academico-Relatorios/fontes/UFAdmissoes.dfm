  object qryAtualizarCampos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'INSERT INTO `ADMISSAO_HISTORICO_CAMPO` (`CD_ADMISSAO_HISTORICO`,' +
        ' `CD_ADMISSAO_CAMPO`)'
      'SELECT'
      '  :CD_ADMISSAO_HISTORICO,'
      '  C.`CD_ADMISSAO_CAMPO`'
      'FROM'
      '  `ADMISSAO_CAMPO` C'
      'WHERE'
      '  NOT EXISTS ('
      '    SELECT'
      '      H.`CD_ADMISSAO_HISTORICO`'
      '    FROM'
      '      `ADMISSAO_HISTORICO_CAMPO` H'
      '    WHERE'
      '      C.`CD_ADMISSAO_CAMPO` = H.`CD_ADMISSAO_CAMPO` AND'
      '      H.`CD_ADMISSAO_HISTORICO` = :CD_ADMISSAO_HISTORICO'
      '  )')
    Params = <
