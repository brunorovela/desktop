  object qryCampos: TUMZQuery
    Connection = DM.db
    SortedFields = 'DS_TITULO'
    UpdateObject = updCampos
    SQL.Strings = (
      'SELECT DISTINCT'
      '  H.`CD_ADMISSAO_HISTORICO`,'
      '  H.`CD_ADMISSAO_CAMPO`,'
      '  H.`SN_ATIVO`,'
      '  CASE `SN_CURSOS`'
      '    WHEN 1 THEN SUM(COALESCE(A.`VL_HORAS`, 0))'
      '    ELSE H.`VL_HORAS`'
      '  END `VL_HORAS`,'
      '  H.`CD_CENTRO`,'
      '  H.`CD_COLIGADA_MATRIZ`,'
      '  C.`DS_CHAVE`,'
      '  C.`DS_TITULO`,'
      '  C.`NR_ORDEM`,'
      '  C.`SN_HORAS`,'
      '  C.`SN_CURSOS`,'
      '  C.`SN_CENTRO_CUSTO`,'
      '  F.`DS_CENTRO`,'
      '  LEFT(GROUP_CONCAT(A.`CD_CURSO`), 255) `CD_CURSOS`'
      'FROM'
      '  `ADMISSAO_HISTORICO_CAMPO` H'
      '      JOIN `ADMISSAO_CAMPO` C ON'
      '        (H.`CD_ADMISSAO_CAMPO` = C.`CD_ADMISSAO_CAMPO`)'
      '      LEFT JOIN `FIN_CONFIG_CENTRO_CUSTOS` F ON'
      '        (H.`CD_CENTRO` = F.`CD_CENTRO`) AND'
      '        (H.`CD_COLIGADA_MATRIZ` = F.`CD_COLIGADA_MATRIZ`)'
      '      LEFT JOIN `ADMISSAO_HISTORICO_CAMPO_CURSO` A ON'
      #9#9#9#9'(H.`CD_ADMISSAO_HISTORICO` = A.`CD_ADMISSAO_HISTORICO`) AND'
      #9#9#9#9'(H.`CD_ADMISSAO_CAMPO` = A.`CD_ADMISSAO_CAMPO`)'
      'WHERE'
      '  H.`CD_ADMISSAO_HISTORICO` = :CD_ADMISSAO_HISTORICO'
      'GROUP BY'
      #9'H.`CD_ADMISSAO_CAMPO`,'
      #9'H.`CD_ADMISSAO_HISTORICO`')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_ADMISSAO_HISTORICO'
        ParamType = ptUnknown
      end>
    DataSource = dsHistorico
    IndexFieldNames = 'DS_TITULO Asc'
    Left = 40
    Top = 520
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_ADMISSAO_HISTORICO'
        ParamType = ptUnknown
      end>
    object qryCamposCD_ADMISSAO_HISTORICO: TLargeintField
      FieldName = 'CD_ADMISSAO_HISTORICO'
      ReadOnly = True
      Required = True
    end
