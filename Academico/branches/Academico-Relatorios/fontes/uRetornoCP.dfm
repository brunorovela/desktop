      Size = 60
    end
    object qyItensds_ocorrencia: TStringField
      DisplayLabel = 'Ocorr'#234'ncia'
      FieldName = 'ds_ocorrencia'
      Size = 50
    end
    object qyItensds_motivos: TStringField
      DisplayLabel = 'Motivos'
      FieldName = 'ds_motivos'
      Size = 200
    end
    object qyItenssn_baixa: TStringField
      Alignment = taCenter
      DisplayLabel = 'Baixado'
      FieldName = 'sn_baixa'
      Size = 3
    end
  end
