    end
    object qyItenscd_ocorrencia: TStringField
      DisplayLabel = 'C'#243'd. Ocorr'#234'ncia'
      FieldName = 'cd_ocorrencia'
      Size = 10
    end
    object qyItenssn_baixado: TSmallintField
      DisplayLabel = 'Baixado'
      FieldName = 'sn_baixado'
    end
    object qyItensds_despesa: TStringField
      DisplayLabel = 'Hist'#243'rico'
