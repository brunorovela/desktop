  object OpenDialog: TOpenDialog
    Filter = 'Arquivos de Retorno|*.ret;*.txt|Todos os Arquivos *.*|*.*'
    Left = 664
    Top = 248
  end
  object qyItens: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT ite.*, fcp.ds_despesa, pes.nm_pessoa, bcr.ds_ocorrencia, ' +
        'CASE WHEN ite.sn_baixado = 1 AND IFNULL(fcp.cd_situacao,0) = 2 T' +
        'HEN '#39'Sim'#39' ELSE '#39'N'#227'o'#39' END As sn_baixa'
      '  FROM retorno_cp_itens ite'
      ' INNER JOIN retorno_cp ret ON (ite.cd_retorno = ret.cd_retorno)'
      
        '  LEFT JOIN fin_contas_pagar fcp ON (ite.cd_titulo = fcp.cd_titu' +
        'lo )'
      '  LEFT JOIN pessoas pes ON (pes.cd_pessoa = fcp.cd_pessoa)'
      
        '  LEFT JOIN banco_codigo_retorno bcr ON (bcr.cd_banco = ret.cd_b' +
        'anco AND bcr.cd_retorno = ite.cd_ocorrencia AND bcr.cd_origem = ' +
        '2)'
      'WHERE ite.cd_retorno = :cd_retorno')
    Params = <
      item
        DataType = ftInteger
        Name = 'cd_retorno'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=SELECT CAST(ite.cd_retorno AS NUMBER(9)) AS cd_retorno, C' +
        'AST( ite.nr_linha AS NUMBER(9) ) AS nr_linha, CAST( ite.cd_titul' +
        'o AS NUMBER(9) ) AS cd_titulo, ite.*, fcp.ds_despesa, pes.nm_pes' +
        'soa, bcr.ds_ocorrencia, CASE WHEN ite.sn_baixado = 1 AND COALESC' +
        'E(fcp.cd_situacao,0) = 2 THEN '#39'Sim'#39' ELSE '#39'N'#227'o'#39' END As sn_baixa'#13#10 +
        '  FROM retorno_cp_itens ite'#13#10' INNER JOIN retorno_cp ret ON (ite.' +
        'cd_retorno = ret.cd_retorno)'#13#10'  LEFT JOIN fin_contas_pagar fcp O' +
        'N (ite.cd_titulo = fcp.cd_titulo AND ret.cd_coligada = fcp.cd_co' +
        'ligada)'#13#10'  LEFT JOIN pessoas pes ON (pes.cd_pessoa = fcp.cd_pess' +
        'oa)'#13#10'  LEFT JOIN banco_codigo_retorno bcr ON (bcr.cd_banco = ret' +
        '.cd_banco AND bcr.cd_retorno = ite.cd_ocorrencia AND bcr.cd_orig' +
        'em = 2)'#13#10'WHERE ite.cd_retorno = :cd_retorno')
    Left = 400
    Top = 296
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cd_retorno'
        ParamType = ptUnknown
      end>
    object qyItenscd_retorno: TIntegerField
      DisplayLabel = 'C'#243'd. Retorno'
      FieldName = 'cd_retorno'
    end
    object qyItensnr_linha: TIntegerField
      DisplayLabel = 'N'#186' Linha'
      FieldName = 'nr_linha'
    end
