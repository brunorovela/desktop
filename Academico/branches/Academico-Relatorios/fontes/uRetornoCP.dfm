  object qyArquivos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT rcp.cd_retorno, rcp.dt_processamento, rcp.nm_arquivo, usu' +
        '.nm_pessoa as nm_usuario, rcp.cd_banco, ban.nome as nm_banco, rc' +
        'p.cd_caixa, fcc.ds_caixa, col.nm_coligada'
      '  FROM retorno_cp rcp'
      
        ' INNER JOIN fin_cadastro_contas fcc ON (fcc.cd_caixa = rcp.cd_ca' +
        'ixa AND fcc.cd_coligada = rcp.cd_coligada)'
      ' INNER JOIN bancos ban ON (ban.codigo = rcp.cd_banco)'
      ' INNER JOIN pessoas usu ON (usu.cd_pessoa = rcp.cd_usuario)'
      ' INNER JOIN coligadas col ON (col.cd_coligada = rcp.cd_coligada)'
      ' WHERE rcp.dt_processamento >= :data1'
      '   AND rcp.dt_processamento <= :data2'
      'ORDER BY rcp.cd_retorno DESC'
      '  ')
    Params = <
      item
        DataType = ftString
        Name = 'data1'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'data2'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'oracle=SELECT CAST(rcp.cd_retorno AS NUMBER(9)) AS cd_retorno, r' +
        'cp.dt_processamento, rcp.nm_arquivo, usu.nm_pessoa as nm_usuario' +
        ', rcp.cd_banco, ban.nome as nm_banco, rcp.cd_caixa, fcc.ds_caixa' +
        ', col.nm_coligada'#13#10'  FROM retorno_cp rcp'#13#10' INNER JOIN fin_cadast' +
        'ro_contas fcc ON (fcc.cd_caixa = rcp.cd_caixa AND fcc.cd_coligad' +
        'a = rcp.cd_coligada)'#13#10' INNER JOIN bancos ban ON (ban.codigo = rc' +
        'p.cd_banco)'#13#10' INNER JOIN pessoas usu ON (usu.cd_pessoa = rcp.cd_' +
        'usuario)'#13#10' INNER JOIN coligadas col ON (col.cd_coligada = rcp.cd' +
        '_coligada)'#13#10' WHERE rcp.dt_processamento >= TO_DATE(:data1, '#39'YYYY' +
        '-MM-DD HH24:MI:SS'#39')'#13#10'   AND rcp.dt_processamento <= TO_DATE(:dat' +
        'a2, '#39'YYYY-MM-DD HH24:MI:SS'#39')'#13#10'ORDER BY rcp.cd_retorno DESC')
    Left = 400
    Top = 240
    ParamData = <
      item
        DataType = ftString
        Name = 'data1'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'data2'
        ParamType = ptUnknown
      end>
    object qyArquivosdt_processamento: TDateTimeField
      DisplayLabel = 'Dt. Processamento'
      FieldName = 'dt_processamento'
    end
    object qyArquivosnm_arquivo: TStringField
      DisplayLabel = 'Nome Arquivo'
      FieldName = 'nm_arquivo'
      Size = 150
    end
    object qyArquivosnm_usuario: TStringField
      DisplayLabel = 'Usu'#225'rio'
      FieldName = 'nm_usuario'
      Size = 30
    end
    object qyArquivosnm_banco: TStringField
      DisplayLabel = 'Banco'
      FieldName = 'nm_banco'
      Size = 40
    end
    object qyArquivosds_caixa: TStringField
      DisplayLabel = 'Nome da Conta'
      FieldName = 'ds_caixa'
      Size = 255
    end
    object qyArquivosnm_coligada: TStringField
      DisplayLabel = 'Unidade de Ensino'
      FieldName = 'nm_coligada'
      Size = 50
    end
    object qyArquivoscd_banco: TStringField
      DisplayLabel = 'C'#243'd. Banco'
      FieldName = 'cd_banco'
      Size = 3
    end
