  object qryUpdateNotas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      '   FICHAINDIVIDUAL F1'
      'SET'
      '   F1.NOTA1 = F2.NOTA1,'
      '   F1.FALTA1 = F2.FALTA1,'
      '   F1.EXAME1 = F2.EXAME1,'
      '   F1.SN_BLOQUEADO1 = IF(F2.NOTA_D1 IS NULL, 0, 1),'
      '   F1.NOTA2 = F2.NOTA2,'
      '   F1.FALTA2 = F2.FALTA2,'
      '   F1.EXAME2 = F2.EXAME2,'
      '   F1.SN_BLOQUEADO2 = IF(F2.NOTA_D2 IS NULL, 0, 1),'
      '   F1.NOTA3 = F2.NOTA3,'
      '   F1.FALTA3 = F2.FALTA3,'
      '   F1.EXAME3 = F2.EXAME3,'
      '   F1.SN_BLOQUEADO3 = IF(F2.NOTA_D3 IS NULL, 0, 1),'
      '   F1.NOTA4 = F2.NOTA4,'
      '   F1.FALTA4 = F2.FALTA4,'
      '   F1.EXAME4 = F2.EXAME4,'
      '   F1.SN_BLOQUEADO4 = IF(F2.NOTA_D4 IS NULL, 0, 1),'
      '   F1.NOTA5 = F2.NOTA5,'
      '   F1.FALTA5 = F2.FALTA5,'
      '   F1.EXAME5 = F2.EXAME5,'
      '   F1.SN_BLOQUEADO5 = IF(F2.NOTA_D5 IS NULL, 0, 1),'
      '   F1.NOTA6 = F2.NOTA6,'
      '   F1.FALTA6 = F2.FALTA6,'
      '   F1.EXAME6 = F2.EXAME6,'
      '   F1.SN_BLOQUEADO6 = IF(F2.NOTA_D6 IS NULL, 0, 1),'
      '   F1.NOTA7 = F2.NOTA7,'
      '   F1.FALTA7 = F2.FALTA7,'
      '   F1.EXAME7 = F2.EXAME7,'
      '   F1.SN_BLOQUEADO7 = IF(F2.NOTA_D7 IS NULL, 0, 1),'
      '   F1.NOTA8 = F2.NOTA8,'
      '   F1.FALTA8 = F2.FALTA8,'
      '   F1.EXAME8 = F2.EXAME8,'
      '   F1.SN_BLOQUEADO8 = IF(F2.NOTA_D8 IS NULL, 0, 1),'
      '   F1.NOTA9 = F2.NOTA9,'
      '   F1.FALTA9 = F2.FALTA9,'
      '   F1.EXAME9 = F2.EXAME9,'
      '   F1.SN_BLOQUEADO9 = IF(F2.NOTA_D9 IS NULL, 0, 1),'
      '   F1.NOTA10 = F2.NOTA10,'
      '   F1.FALTA10 = F2.FALTA10,'
      '   F1.EXAME10 = F2.EXAME10,'
      '   F1.SN_BLOQUEADO10 = IF(F2.NOTA_D10 IS NULL, 0, 1),'
      '   F1.NOTAEXAME = F2.NOTAEXAME,'
      '   F1.SEGUNDA_EPOCA = F2.SEGUNDA_EPOCA,'
      '   F1.MEDIAANUAL = F2.MEDIAANUAL,'
      '   F1.MEDIAFINAL = F2.MEDIAFINAL,'
      '   F1.FREQUENCIA = F2.FREQUENCIA,'
      '   F1.TOTALFALTAS = F2.TOTALFALTAS,'
      '   F1.ARRUMARDIARIO = F2.ARRUMARDIARIO,'
      '   F1.APROVEITAMENTO = IF(F2.MEDIAFINAL IS NULL, "N", "S"),'
      '   F1.NOTA_D1 = F2.NOTA_D1,'
      '   F1.NOTA_D2 = F2.NOTA_D2,'
      '   F1.NOTA_D3 = F2.NOTA_D3,'
      '   F1.NOTA_D4 = F2.NOTA_D4,'
      '   F1.NOTA_D5 = F2.NOTA_D5,'
      '   F1.NOTA_D6 = F2.NOTA_D6,'
      '   F1.NOTA_D7 = F2.NOTA_D7,'
      '   F1.NOTA_D8 = F2.NOTA_D8,'
      '   F1.NOTA_D9 = F2.NOTA_D9,'
      '   F1.NOTA_D10 = F2.NOTA_D10,'
      '   F1.CARGA_HORARIA = F2.CARGA_HORARIA,'
      '   F1.SIMBOLO_OBS = F2.SIMBOLO_OBS,'
      '   F1.CODIGOESCOLA = F2.CODIGOESCOLA'
      'WHERE'
      '  F1.CODIGOALUNO = :CODIGOALUNO AND'
      '  F1.ANOSEMESTRE = :ANOSEMESTRE AND'
      '  F1.TURMA = :TURMA_DESTINO AND'
      '  EXISTS ('
      '    SELECT'
      '      S.CD_SITUACAO'
      '    FROM'
      '      SITUACAO S'
      '    WHERE'
      '      F1.SITUACAO = S.CD_SITUACAO AND'
      '      S.CD_SITUACAO_PAI = 1'
      '  ) AND'
      '  EXISTS ('
      '    SELECT'
      '      F2.CODIGOALUNO'
      '    FROM'
      '      FICHAINDIVIDUAL F2'
      '        JOIN SITUACAO S ON'
      '          (F2.SITUACAO = S.CD_SITUACAO)'
      '    WHERE'
      '      F1.CODIGOALUNO = F2.CODIGOALUNO AND'
      '      F1.ANOSEMESTRE = F2.ANOSEMESTRE AND'
      '      F1.DISCIPLINA = F2.DISCIPLINA AND'
      '      S.CD_SITUACAO_PAI = :SITUACAO AND'
      '      F2.TURMA = :TURMA_ORIGEM'
      '  )')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CODIGOALUNO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TURMA_DESTINO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SITUACAO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TURMA_ORIGEM'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'mysql-5=UPDATE'#13#10'   FICHAINDIVIDUAL F1,'#13#10'   FICHAINDIVIDUAL F2'#13#10'S' +
        'ET'#13#10'   F1.NOTA1 = F2.NOTA1,'#13#10'   F1.FALTA1 = F2.FALTA1,'#13#10'   F1.EX' +
        'AME1 = F2.EXAME1,'#13#10'   F1.SN_BLOQUEADO1 = IF(ISNULL(F2.NOTA_D1), ' +
        '0, 1),'#13#10'   F1.NOTA2 = F2.NOTA2,'#13#10'   F1.FALTA2 = F2.FALTA2,'#13#10'   F' +
        '1.EXAME2 = F2.EXAME2,'#13#10'   F1.SN_BLOQUEADO2 = IF(ISNULL(F2.NOTA_D' +
        '2), 0, 1),'#13#10'   F1.NOTA3 = F2.NOTA3,'#13#10'   F1.FALTA3 = F2.FALTA3,'#13#10 +
        '   F1.EXAME3 = F2.EXAME3,'#13#10'   F1.SN_BLOQUEADO3 = IF(ISNULL(F2.NO' +
        'TA_D3), 0, 1),'#13#10'   F1.NOTA4 = F2.NOTA4,'#13#10'   F1.FALTA4 = F2.FALTA' +
        '4,'#13#10'   F1.EXAME4 = F2.EXAME4,'#13#10'   F1.SN_BLOQUEADO4 = IF(ISNULL(F' +
        '2.NOTA_D4), 0, 1),'#13#10'   F1.NOTA5 = F2.NOTA5,'#13#10'   F1.FALTA5 = F2.F' +
        'ALTA5,'#13#10'   F1.EXAME5 = F2.EXAME5,'#13#10'   F1.SN_BLOQUEADO5 = IF(ISNU' +
        'LL(F2.NOTA_D5), 0, 1),'#13#10'   F1.NOTA6 = F2.NOTA6,'#13#10'   F1.FALTA6 = ' +
        'F2.FALTA6,'#13#10'   F1.EXAME6 = F2.EXAME6,'#13#10'   F1.SN_BLOQUEADO6 = IF(' +
        'ISNULL(F2.NOTA_D6), 0, 1),'#13#10'   F1.NOTA7 = F2.NOTA7,'#13#10'   F1.FALTA' +
        '7 = F2.FALTA7,'#13#10'   F1.EXAME7 = F2.EXAME7,'#13#10'   F1.SN_BLOQUEADO7 =' +
        ' IF(ISNULL(F2.NOTA_D7), 0, 1),'#13#10'   F1.NOTA8 = F2.NOTA8,'#13#10'   F1.F' +
        'ALTA8 = F2.FALTA8,'#13#10'   F1.EXAME8 = F2.EXAME8,'#13#10'   F1.SN_BLOQUEAD' +
        'O8 = IF(ISNULL(F2.NOTA_D8), 0, 1),'#13#10'   F1.NOTA9 = F2.NOTA9,'#13#10'   ' +
        'F1.FALTA9 = F2.FALTA9,'#13#10'   F1.EXAME9 = F2.EXAME9,'#13#10'   F1.SN_BLOQ' +
        'UEADO9 = IF(ISNULL(F2.NOTA_D9), 0, 1),'#13#10'   F1.NOTA10 = F2.NOTA10' +
        ','#13#10'   F1.FALTA10 = F2.FALTA10,'#13#10'   F1.EXAME10 = F2.EXAME10,'#13#10'   ' +
        'F1.SN_BLOQUEADO10 = IF(ISNULL(F2.NOTA_D10), 0, 1),'#13#10'   F1.NOTAEX' +
        'AME = F2.NOTAEXAME,'#13#10'   F1.SEGUNDA_EPOCA = F2.SEGUNDA_EPOCA,'#13#10'  ' +
        ' F1.MEDIAANUAL = F2.MEDIAANUAL,'#13#10'   F1.MEDIAFINAL = F2.MEDIAFINA' +
        'L,'#13#10'   F1.FREQUENCIA = F2.FREQUENCIA,'#13#10'   F1.TOTALFALTAS = F2.TO' +
        'TALFALTAS,'#13#10'   F1.ARRUMARDIARIO = F2.ARRUMARDIARIO,'#13#10'   F1.APROV' +
        'EITAMENTO = IF(ISNULL(F2.MEDIAFINAL), "N", "S"),'#13#10'   F1.NOTA_D1 ' +
        '= F2.NOTA_D1,'#13#10'   F1.NOTA_D2 = F2.NOTA_D2,'#13#10'   F1.NOTA_D3 = F2.N' +
        'OTA_D3,'#13#10'   F1.NOTA_D4 = F2.NOTA_D4,'#13#10'   F1.NOTA_D5 = F2.NOTA_D5' +
        ','#13#10'   F1.NOTA_D6 = F2.NOTA_D6,'#13#10'   F1.NOTA_D7 = F2.NOTA_D7,'#13#10'   ' +
        'F1.NOTA_D8 = F2.NOTA_D8,'#13#10'   F1.NOTA_D9 = F2.NOTA_D9,'#13#10'   F1.NOT' +
        'A_D10 = F2.NOTA_D10,'#13#10'   F1.NOTA_SA1 = F2.NOTA_SA1,'#13#10'   F1.NOTA_' +
        'SA2 = F2.NOTA_SA2,'#13#10'   F1.NOTA_SA3 = F2.NOTA_SA3,'#13#10'   F1.NOTA_SA' +
        '4 = F2.NOTA_SA4,'#13#10'   F1.NOTA_SA5 = F2.NOTA_SA5,'#13#10'   F1.NOTA_SA6 ' +
        '= F2.NOTA_SA6,'#13#10'   F1.NOTA_SA7 = F2.NOTA_SA7,'#13#10'   F1.NOTA_SA8 = ' +
        'F2.NOTA_SA8,'#13#10'   F1.NOTA_SA9 = F2.NOTA_SA9,'#13#10'   F1.NOTA_SA10 = F' +
        '2.NOTA_SA10,   '#13#10'   F1.AJUSTE1 = F2.AJUSTE1,'#13#10'   F1.AJUSTE2 = F2' +
        '.AJUSTE2,'#13#10'   F1.AJUSTE3 = F2.AJUSTE3,'#13#10'   F1.AJUSTE4 = F2.AJUST' +
        'E4,'#13#10'   F1.AJUSTE5 = F2.AJUSTE5,'#13#10'   F1.AJUSTE6 = F2.AJUSTE6,'#13#10' ' +
        '  F1.AJUSTE7 = F2.AJUSTE7,'#13#10'   F1.AJUSTE8 = F2.AJUSTE8,'#13#10'   F1.A' +
        'JUSTE9 = F2.AJUSTE9,'#13#10'   F1.AJUSTE10 = F2.AJUSTE10,     '#13#10'   F1.' +
        'DS_MEDIA = F2.DS_MEDIA,   '#13#10'   F1.CARGA_HORARIA = F2.CARGA_HORAR' +
        'IA,'#13#10'   F1.SIMBOLO_OBS = F2.SIMBOLO_OBS,'#13#10'   F1.CODIGOESCOLA = F' +
        '2.CODIGOESCOLA,'#13#10'   F1.APROVEITAMENTO = F2.APROVEITAMENTO'#13#10'WHERE' +
        #13#10'   F1.CODIGOALUNO = :CODIGOALUNO AND'#13#10'   F1.CODIGOALUNO = F2.C' +
        'ODIGOALUNO AND'#13#10'   F1.ANOSEMESTRE = :ANOSEMESTRE AND'#13#10'   F1.ANOS' +
        'EMESTRE = F2.ANOSEMESTRE AND'#13#10'   F1.SITUACAO = 1 AND'#13#10'   F2.SITU' +
        'ACAO = :SITUACAO AND'#13#10'   F1.DISCIPLINA = F2.DISCIPLINA AND'#13#10'   F' +
        '1.TURMA = :TURMA_DESTINO AND'#13#10'   F2.TURMA = :TURMA_ORIGEM'
      
        'oracle=MERGE INTO FICHAINDIVIDUAL F1 USING'#13#10'('#13#10'   SELECT'#13#10'      ' +
        'NOTA1, NOTA2, NOTA3, NOTA4, NOTA5, NOTA6, NOTA7, NOTA8, NOTA9, N' +
        'OTA10,'#13#10'      FALTA1, FALTA2, FALTA3, FALTA4, FALTA5, FALTA6, FA' +
        'LTA7, FALTA8, FALTA9, FALTA10,'#13#10'      EXAME1, EXAME2, EXAME3, EX' +
        'AME4, EXAME5, EXAME6, EXAME7, EXAME8, EXAME9, EXAME10,'#13#10'      NO' +
        'TAEXAME, SEGUNDA_EPOCA, MEDIAANUAL, MEDIAFINAL, FREQUENCIA, TOTA' +
        'LFALTAS, ARRUMARDIARIO,'#13#10'      NOTA_D1, NOTA_D2, NOTA_D3, NOTA_D' +
        '4, NOTA_D5, NOTA_D6, NOTA_D7, NOTA_D8, NOTA_D9, NOTA_D10,'#13#10'     ' +
        ' CARGA_HORARIA, SIMBOLO_OBS, CODIGOESCOLA, APROVEITAMENTO, DISCI' +
        'PLINA, ANOSEMESTRE, CODIGOALUNO'#13#10'   FROM'#13#10'      FICHAINDIVIDUAL'#13 +
        #10'   WHERE'#13#10'      SITUACAO = :SITUACAO AND'#13#10'      TURMA = :TURMA_' +
        'ORIGEM AND'#13#10'      CODIGOALUNO = :CODIGOALUNO AND'#13#10'      ANOSEMES' +
        'TRE = :ANOSEMESTRE'#13#10') F2 ON ('#13#10'   F1.CODIGOALUNO = F2.CODIGOALUN' +
        'O AND'#13#10'   F1.ANOSEMESTRE = F2.ANOSEMESTRE AND'#13#10'   F1.DISCIPLINA ' +
        '= F2.DISCIPLINA AND'#13#10'   F1.TURMA = :TURMA_DESTINO AND'#13#10'   F1.SIT' +
        'UACAO = 1'#13#10')'#13#10'WHEN MATCHED THEN'#13#10'   UPDATE SET'#13#10'      F1.NOTA1 =' +
        ' F2.NOTA1,'#13#10'      F1.NOTA2 = F2.NOTA2,'#13#10'      F1.NOTA3 = F2.NOTA' +
        '3,'#13#10'      F1.NOTA4 = F2.NOTA4,'#13#10'      F1.NOTA5 = F2.NOTA5,'#13#10'    ' +
        '  F1.NOTA6 = F2.NOTA6,'#13#10'      F1.NOTA7 = F2.NOTA7,'#13#10'      F1.NOT' +
        'A8 = F2.NOTA8,'#13#10'      F1.NOTA9 = F2.NOTA9,'#13#10'      F1.NOTA10 = F2' +
        '.NOTA10,'#13#10'      F1.FALTA1 = F2.FALTA1,'#13#10'      F1.FALTA2 = F2.FAL' +
        'TA2,'#13#10'      F1.FALTA3 = F2.FALTA3,'#13#10'      F1.FALTA4 = F2.FALTA4,' +
        #13#10'      F1.FALTA5 = F2.FALTA5,'#13#10'      F1.FALTA6 = F2.FALTA6,'#13#10'  ' +
        '    F1.FALTA7 = F2.FALTA7,'#13#10'      F1.FALTA8 = F2.FALTA8,'#13#10'      ' +
        'F1.FALTA9 = F2.FALTA9,'#13#10'      F1.FALTA10 = F2.FALTA10,'#13#10'      F1' +
        '.EXAME1 = F2.EXAME1,'#13#10'      F1.EXAME2 = F2.EXAME2,'#13#10'      F1.EXA' +
        'ME3 = F2.EXAME3,'#13#10'      F1.EXAME4 = F2.EXAME4,'#13#10'      F1.EXAME5 ' +
        '= F2.EXAME5,'#13#10'      F1.EXAME6 = F2.EXAME6,'#13#10'      F1.EXAME7 = F2' +
        '.EXAME7,'#13#10'      F1.EXAME8 = F2.EXAME8,'#13#10'      F1.EXAME9 = F2.EXA' +
        'ME9,'#13#10'      F1.EXAME10 = F2.EXAME10,'#13#10'      F1.SN_BLOQUEADO1 = I' +
        'FISNULL(NOTA_D1, 0, 1),'#13#10'      F1.SN_BLOQUEADO2 = IFISNULL(NOTA_' +
        'D2, 0, 1),'#13#10'      F1.SN_BLOQUEADO3 = IFISNULL(NOTA_D3, 0, 1),'#13#10' ' +
        '     F1.SN_BLOQUEADO4 = IFISNULL(NOTA_D4, 0, 1),'#13#10'      F1.SN_BL' +
