  object qyDisciplinasMatriculadas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT                                                          ' +
        '                     '
      
        '   GROUP_CONCAT(CONCAT(lpad(codigo,8,0)," - ",descricao ) SEPARA' +
        'TOR "\n\t\t") as msg '
      
        'FROM                                                            ' +
        '                     '
      
        '   disciplinas as d                                             ' +
        '                     '
      
        '   INNER JOIN fichaindividual as f ON (d.codigo = f.disciplina a' +
        'nd d.curso = f.curso)'
      'WHERE'
      '   f.anosemestre = :anosem AND'
      '   f.turmamatricula = :turma'
      'AND'
      '   f.codigoaluno = :codigoAluno                           ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'anosem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigoAluno'
        ParamType = ptUnknown
      end>
    Left = 552
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'anosem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigoAluno'
        ParamType = ptUnknown
      end>
  end
  object qryBuscaDadosMatricula: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  M.cd_matricula_curso,'
      '  M.planopagamento,'
      '  M.planodesconto,'
      '  M.situacao,'
      '  M.cd_ingresso,'
      '  M.cd_instituicao_origem,'
      '  M.cd_matricula_curso,'
      '  MC.nr_matricula,'
      '  M.datasaida,'
      '  M.CD_PESSOA_MATRICULOU'
      'FROM'
      '  matriculas M'
      
        'LEFT JOIN matriculas_curso MC ON (MC.cd_matricula_curso = M.cd_m' +
        'atricula_curso)'
      'WHERE'
      '  M.codigoaluno = :codigoAluno AND'
      '  M.turma = :turma AND'
      '  M.anosemestre = :anosemestre')
