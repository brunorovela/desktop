  object qryTransfereDiscFicha: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      '  FICHAINDIVIDUAL F'
      '    LEFT JOIN FICHAINDIVIDUAL F2 ON'
      '      (F.SERIE = F2.SERIE) AND'
      '      (F.ANOSEMESTRE = F2.ANOSEMESTRE) AND'
      '      (F.CODIGOALUNO = F2.CODIGOALUNO) AND'
      '      (F.DISCIPLINA = F2.DISCIPLINA) AND'
      '      (F.CURSO = F2.CURSO) AND'
      '      (F2.TURMA != F2.TURMAMATRICULA) AND'
      '      (F2.TURMA = :novaturma)'
      '    LEFT JOIN SITUACAO S ON'
      '      (F2.SITUACAO = S.CD_SITUACAO) AND'
      '      (S.CD_SITUACAO_PAI IN (1, 10))'
      'SET'
      '  F.TURMAMATRICULA = :novaturma,'
      '  F.ANOSEMESTRE = :anosemnovo'
      'WHERE'
      '  F.TURMA != F.TURMAMATRICULA AND'
      '  F.ANOSEMESTRE = :anosemAntigo AND'
      '  F.TURMAMATRICULA = :turmamat AND'
      '  F.CODIGOALUNO = :codigoaluno AND'
      '  F2.TURMA = :novaturma AND'
      '  F2.CODIGOALUNO IS NULL')
    Params = <
      item
        DataType = ftUnknown
        Name = 'novaturma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemnovo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemAntigo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turmaMat'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end>
    Left = 520
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'novaturma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemnovo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemAntigo'
        ParamType = ptUnknown
