        ParamType = ptUnknown
      end>
  end
  object qryTransfereFreqs: TUMZQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'oracle=MERGE INTO DIARIO_AULAS_ALUNOS AA1 USING'#13#10'('#13#10'   SELECT'#13#10' ' +
        '     CD_PESSOA,'#13#10'      :CD_TURMA_NOVA CD_TURMA,'#13#10'      :NR_ANOSE' +
        'M_NOVO NR_ANOSEM,'#13#10'      CD_DISCIPLINA,'#13#10'      CD_BIMESTRE,'#13#10'   ' +
        '   NR_AULA,'#13#10'      DS_FREQ'#13#10'   FROM'#13#10'      DIARIO_AULAS_ALUNOS'#13#10 +
        '   WHERE'#13#10'      CD_PESSOA = :CD_PESSOA AND'#13#10'      CD_TURMA = :CD' +
        '_TURMA AND'#13#10'      NR_ANOSEM = :NR_ANOSEM'#13#10') AA2 ON'#13#10'('#13#10'   AA1.CD' +
        '_PESSOA = AA2.CD_PESSOA AND'#13#10'   AA1.CD_TURMA = AA2.CD_TURMA AND'#13 +
        #10'   AA1.NR_ANOSEM = AA2.NR_ANOSEM AND'#13#10'   AA1.CD_DISCIPLINA = AA' +
        '2.CD_DISCIPLINA AND'#13#10'   AA1.CD_BIMESTRE = AA2.CD_BIMESTRE AND'#13#10' ' +
        '  AA1.NR_AULA = AA2.NR_AULA'#13#10')'#13#10'WHEN MATCHED THEN'#13#10'   UPDATE SET' +
        #13#10'      AA1.CD_TURMA = :CD_TURMA_NOVA,'#13#10'      AA1.NR_ANOSEM = :N' +
        'R_ANOSEM_NOVO,'#13#10'      AA1.DS_FREQ = AA2.DS_FREQ'#13#10'WHEN NOT MATCHE' +
        'D THEN'#13#10'   INSERT'#13#10'      (CD_PESSOA, CD_TURMA, NR_ANOSEM, CD_DIS' +
        'CIPLINA, CD_BIMESTRE, NR_AULA, DS_FREQ)'#13#10'   VALUES'#13#10'      (:CD_P' +
        'ESSOA, :CD_TURMA_NOVA, :NR_ANOSEM_NOVO, AA2.CD_BIMESTRE, AA2.NR_' +
        'AULA, AA2.DS_FREQ)'
      
        'mysql-5=REPLACE INTO DIARIO_AULAS_ALUNOS (CD_PESSOA, CD_TURMA, N' +
        'R_ANOSEM, CD_DISCIPLINA, CD_BIMESTRE, NR_AULA, DS_FREQ)'#13#10'SELECT'#13 +
        #10'   daa.CD_PESSOA,'#13#10'   :CD_TURMA_NOVA,'#13#10'   :NR_ANOSEM_NOVO,'#13#10'   ' +
        'daa.CD_DISCIPLINA,'#13#10'   daa.CD_BIMESTRE,'#13#10'   daa.NR_AULA,'#13#10'   daa' +
        '.DS_FREQ'#13#10'FROM'#13#10'   DIARIO_AULAS_ALUNOS daa '#13#10'INNER JOIN diario_a' +
        'ulas da ON ('#13#10#9'da.anosemestre = daa.nr_anosem'#13#10#9'AND da.bimestre ' +
        '= daa.cd_bimestre'#13#10#9'AND daa.cd_disciplina = da.disciplina'#13#10#9'AND ' +
        'daa.cd_turma = da.turma'#13#10#9'AND daa.nr_aula = da.nro_aula'#13#10')'#13#10'WHER' +
        'E'#13#10'   da.`data` <= NOW() AND '#13#10'   daa.CD_PESSOA = :CD_PESSOA AND' +
        #13#10'   daa.CD_TURMA = :CD_TURMA AND'#13#10'   daa.NR_ANOSEM = :NR_ANOSEM')
    Left = 328
    Top = 205
  end
  object qryTransfereNotas: TUMZQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'oracle=MERGE INTO DIARIO_PROVAS_ALUNOS PA1 USING'#13#10'('#13#10'   SELECT'#13#10 +
        '      CD_PESSOA,'#13#10'      :CD_TURMA_NOVA CD_TURMA,'#13#10'      :NR_ANOS' +
        'EM_NOVO NR_ANOSEM,'#13#10'      CD_DISCIPLINA,'#13#10'      CD_BIMESTRE,'#13#10'  ' +
        '    NR_PROVA,'#13#10'      VL_NOTA'#13#10'   FROM'#13#10'      DIARIO_PROVAS_ALUNO' +
        'S'#13#10'   WHERE'#13#10'      CD_PESSOA = :CD_PESSOA AND'#13#10'      CD_TURMA = ' +
        ':CD_TURMA AND'#13#10'      NR_ANOSEM = :NR_ANOSEM'#13#10') PA2 ON'#13#10'('#13#10'   PA1' +
        '.CD_PESSOA = PA2.CD_PESSOA AND'#13#10'   PA1.CD_TURMA = PA2.CD_TURMA A' +
        'ND'#13#10'   PA1.NR_ANOSEM = PA2.NR_ANOSEM AND'#13#10'   PA1.CD_DISCIPLINA =' +
        ' PA2.CD_DISCIPLINA AND'#13#10'   PA1.CD_BIMESTRE = PA2.CD_BIMESTRE AND' +
        #13#10'   PA1.NR_PROVA = PA2.NR_PROVA'#13#10')'#13#10'WHEN MATCHED THEN'#13#10'   UPDAT' +
        'E SET'#13#10'      PA1.CD_TURMA = :CD_TURMA_NOVA,'#13#10'      PA1.NR_ANOSEM' +
        ' = :NR_ANOSEM_NOVO,'#13#10'      PA1.DS_FREQ = AA2.DS_FREQ'#13#10'WHEN NOT M' +
        'ATCHED THEN'#13#10'   INSERT'#13#10'      (CD_PESSOA, CD_TURMA, NR_ANOSEM, C' +
        'D_DISCIPLINA, CD_BIMESTRE, NR_PROVA, VL_NOTA)'#13#10'   VALUES'#13#10'      ' +
        '(:CD_PESSOA, :CD_TURMA_NOVA, :NR_ANOSEM_NOVO, PA2.CD_BIMESTRE, P' +
        'A2.NR_PROVA, PA2.VL_NOTA)'
      
        'mysql-5=REPLACE INTO DIARIO_PROVAS_ALUNOS (CD_PESSOA, CD_TURMA, ' +
        'NR_ANOSEM, CD_DISCIPLINA, CD_BIMESTRE, NR_PROVA, VL_NOTA)'#13#10'SELEC' +
        'T'#13#10'   CD_PESSOA,'#13#10'   :CD_TURMA_NOVA,'#13#10'   :NR_ANOSEM_NOVO,'#13#10'   CD' +
        '_DISCIPLINA,'#13#10'   CD_BIMESTRE,'#13#10'   NR_PROVA,'#13#10'   VL_NOTA'#13#10'FROM'#13#10' ' +
        '  DIARIO_PROVAS_ALUNOS'#13#10'WHERE'#13#10'   CD_PESSOA = :CD_PESSOA AND'#13#10'  ' +
        ' CD_TURMA = :CD_TURMA AND'#13#10'   NR_ANOSEM = :NR_ANOSEM')
    Left = 296
    Top = 205
  end
