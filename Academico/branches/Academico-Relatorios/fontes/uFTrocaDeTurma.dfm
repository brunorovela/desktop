  object qryAlunos: TUMZReadOnlyQuery
    Connection = DM.db
    SortedFields = 'NM_PESSOA'
    SQL.Strings = (
      'SELECT DISTINCT'
      #9'P.CD_PESSOA,'
      #9'P.NM_PESSOA,'
      '  SUM(CASE WHEN ((F.CODIGOALUNO IS NOT NULL)) THEN 1'
      '           ELSE 0 END) NR_DISCIPLINAS_FORA'
      'FROM'
      #9'PESSOAS P'
      #9#9'JOIN MATRICULAS M ON'
      #9#9#9'(P.CD_PESSOA = M.CODIGOALUNO)'
      #9#9'JOIN SITUACAO S ON'
      #9#9#9#9'(M.SITUACAO = S.CD_SITUACAO)'
      #9#9'LEFT JOIN FICHAINDIVIDUAL F ON'
      #9#9#9'(M.ANOSEMESTRE = F.ANOSEMESTRE) AND'
      #9#9#9'(M.CODIGOALUNO = F.CODIGOALUNO) AND'
      #9#9#9'(M.TURMA = F.TURMAMATRICULA) AND'
      #9#9#9'(F.TURMA != F.TURMAMATRICULA) AND'
      #9#9#9'(F.TURMA != :CD_TURMA_DESTINO)'
      '    LEFT JOIN TURMAS T ON ('
      #9#9#9'T.ANOSEMESTRE = F.ANOSEMESTRE AND'
      #9#9#9'T.CODIGO = F.TURMA'
      #9#9')'
      #9#9'LEFT JOIN SITUACAO I ON'
      #9#9#9'(F.SITUACAO = I.CD_SITUACAO) AND'
      #9#9#9'(I.CD_SITUACAO_PAI IN (1, 10))'
      'WHERE'
      #9'M.ANOSEMESTRE = :NR_ANOSEMESTRE AND'
      #9'M.CURSO = :CD_CURSO AND'
      #9'M.TURMA = :CD_TURMA AND'
      #9'S.CD_SITUACAO_PAI NOT IN (0, 2, 4, 5, 6, 7, 8, 9)'
      'GROUP BY'
      #9'P.CD_PESSOA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA_DESTINO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end>
    IndexFieldNames = 'NM_PESSOA Asc'
    Left = 216
    Top = 352
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA_DESTINO'
        ParamType = ptUnknown
