        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end>
  end
  object qyAlteraSituacaoTransInterna: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      #9'FICHAINDIVIDUAL F '
      'SET '
      #9'F.SITUACAO = 1 '
      'WHERE'
      '  EXISTS ('
      '    SELECT'
      '      S.CD_SITUACAO'
      '    FROM'
      '      SITUACAO S'
      '    WHERE'
      '      F.SITUACAO = S.CD_SITUACAO AND'
      '      S.CD_SITUACAO_PAI IN (8, -8)'
      '  ) AND '
      #9'F.CODIGOALUNO = :CODIGOALUNO AND'
      '  F.TURMAMATRICULA = :TURMA AND'
      '  F.ANOSEMESTRE = :ANOSEMESTRE')
    Params = <
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    Left = 680
