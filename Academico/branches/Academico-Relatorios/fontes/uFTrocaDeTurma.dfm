  object qryNova: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT         '
      '  t.codigo,    '
      '  t.curso,     '
      '  t.serie,     '
      '  t.turno,     '
      '  cc.cd_depto, '
      '  t.cd_grade,  '
      '  t.cd_coligada'
      'FROM           '
      '  turmas t     '
      
        '  INNER JOIN cursos_coligadas cc ON (cc.cd_curso = t.curso AND c' +
        'c.cd_coligada = t.cd_coligada)'
      'WHERE          '
      '  t.Codigo = :Turma'
      'AND t.anosemestre = :AnoSemestre')
    Params = <
      item
        DataType = ftUnknown
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end>
    Left = 392
    Top = 205
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end>
  end
