  object qyGetTurnoAltera: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      '  t.turno cd_turno'
      'FROM'
      '  matriculas m'
      'INNER JOIN turmas t ON('
      '    m.curso = t.curso'
      '  AND'
      '    m.turma = t.codigo'
      '  AND'
      '    m.anosemestre = t.anosemestre'
      ' )'
      ' WHERE'
      '    m.anosemestre = :nr_anosemestre'
      ' AND'
      '    m.curso = :cd_curso'
      ' AND'
      '    m.turma = :cd_turma'
      ' GROUP BY'
      '    t.turno')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end>
    Left = 640
    Top = 288
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end>
  end
  object sqlScriptAtualizaPED: TZSQLProcessor
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA_NOVA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end>
    Script.Strings = (
      'UPDATE `PED_AVALIACAO_ALUNO` A'
      'SET'
      '   A.`CD_TURMA` = :CD_TURMA_NOVA'
      'WHERE'
      '   A.`CD_ALUNO` = :CD_PESSOA AND'
      '   A.`CD_TURMA` = :CD_TURMA AND'
      '   A.`NR_ANOSEMESTRE` = :NR_ANOSEMESTRE AND'
      '   EXISTS ('
      '      SELECT'
      '         F.`CODIGOALUNO`'
      '      FROM'
      '         `FICHAINDIVIDUAL` F'
      '            JOIN `DISCIPLINAS` D ON'
      '                (F.`DISCIPLINA` = D.`CODIGO`)'
      '      WHERE'
      '        A.`NR_ANOSEMESTRE` = F.`ANOSEMESTRE` AND'
      '        A.`CD_TURMA` = F.`TURMA` AND'
      '        A.`NR_ETAPA` = F.`SERIE` AND'
      '        A.`CD_ALUNO` = F.`CODIGOALUNO` AND'
      '        A.`CD_DISCIPLINA` = D.`ID_DISCIPLINA`'
      '   );'
      ''
      'UPDATE `PED_AVALIACAO_ALUNO_INDICADOR` A'
      'SET'
      '   A.`CD_TURMA` = :CD_TURMA_NOVA'
      'WHERE'
      '   A.`CD_ALUNO` = :CD_PESSOA AND'
      '   A.`CD_TURMA` = :CD_TURMA AND'
      '   A.`NR_ANOSEMESTRE` = :NR_ANOSEMESTRE AND'
      '   EXISTS ('
      '      SELECT'
      '         F.`CODIGOALUNO`'
      '      FROM'
      '         `FICHAINDIVIDUAL` F'
      '            JOIN `DISCIPLINAS` D ON'
      '                (F.`DISCIPLINA` = D.`CODIGO`)'
      '      WHERE'
      '        A.`NR_ANOSEMESTRE` = F.`ANOSEMESTRE` AND'
      '        A.`CD_TURMA` = F.`TURMA` AND'
      '        A.`NR_ETAPA` = F.`SERIE` AND'
      '        A.`CD_ALUNO` = F.`CODIGOALUNO` AND'
      '        A.`CD_DISCIPLINA` = D.`ID_DISCIPLINA`'
      '   );')
    Connection = DM.db
    Delimiter = ';'
    Left = 640
    Top = 344
  end
  object sqlScriptTrocaTurmaPED: TZSQLProcessor
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA_NOVA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE_NOVO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ETAPA'
        ParamType = ptUnknown
      end>
    Script.Strings = (
      'UPDATE `PED_AVALIACAO_ALUNO` A'
      'SET'
      '   A.`CD_TURMA` = :CD_TURMA_NOVA,'
      '   A.`NR_ANOSEMESTRE` = :NR_ANOSEMESTRE_NOVO'
      'WHERE'
      '   A.`CD_ALUNO` = :CD_PESSOA AND'
      '   A.`CD_TURMA` = :CD_TURMA AND'
      '   A.`NR_ANOSEMESTRE` = :NR_ANOSEMESTRE AND'
      '   A.`NR_ETAPA` = :NR_ETAPA AND'
      '   EXISTS ('
      '      SELECT'
      '         F.`CODIGOALUNO`'
      '      FROM'
      '         `FICHAINDIVIDUAL` F'
      '            JOIN `DISCIPLINAS` D ON'
      '               (F.`DISCIPLINA` = D.`CODIGO`)'
      '      WHERE'
      '        A.`NR_ANOSEMESTRE` = F.`ANOSEMESTRE` AND'
      '        A.`CD_TURMA` = F.`TURMA` AND'
      '        A.`NR_ETAPA` = F.`SERIE` AND'
      '        A.`CD_ALUNO` = F.`CODIGOALUNO` AND'
      '        A.`CD_TURMA` = F.`TURMAMATRICULA` AND'
      '        A.`CD_DISCIPLINA` = D.`ID_DISCIPLINA`'
      '   );'
      ''
      'UPDATE `PED_AVALIACAO_ALUNO_INDICADOR` A'
      'SET'
      '   A.`CD_TURMA` = :CD_TURMA_NOVA,'
      '   A.`NR_ANOSEMESTRE` = :NR_ANOSEMESTRE_NOVO'
      'WHERE'
      '   A.`CD_ALUNO` = :CD_PESSOA AND'
      '   A.`CD_TURMA` = :CD_TURMA AND'
      '   A.`NR_ANOSEMESTRE` = :NR_ANOSEMESTRE AND'
      '   A.`NR_ETAPA` = :NR_ETAPA AND'
      '   EXISTS ('
      '      SELECT'
      '         F.`CODIGOALUNO`'
      '      FROM'
      '         `FICHAINDIVIDUAL` F'
      '            JOIN `DISCIPLINAS` D ON'
      '               (F.`DISCIPLINA` = D.`CODIGO`)'
      '      WHERE'
      '        A.`NR_ANOSEMESTRE` = F.`ANOSEMESTRE` AND'
      '        A.`CD_TURMA` = F.`TURMA` AND'
