  object qryGetAlunoRepasse: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      
        '   m.codigoaluno,p.nm_pessoa,cr.vl_remessa,cr.nr_total_parcelas,' +
        'DATE_FORMAT(cr.dt_inicio_repasse,'#39'%m/%Y'#39') as mes_ano'
      'FROM'
      '   matriculas m'
      '   INNER JOIN pessoas p ON (m.codigoaluno = p.cd_pessoa)'
      
        '   LEFT JOIN conv_repasses cr ON (cr.cd_pessoa = p.cd_pessoa AND' +
        '  m.turma = cr.cd_turma)'
      'WHERE'
      '   m.turma = :cd_turma'
      '  AND m.anosemestre = :anosemestre'
      '  AND m.situacao in'
      '  ('
      '      SELECT'
      '           cd_situacao'
      '      FROM'
      '          nu_modulos_matriculas_sit nms'
      
        '          INNER JOIN nu_modulos nm ON (nm.cd_modulo = nms.cd_mod' +
        'ulo)'
      '      WHERE'
      '         ds_chave = '#39'ContConv'#39' AND sn_aceita = 1'
      '   )')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    Left = 80
    Top = 64
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    object qryGetAlunoRepassecodigoaluno: TIntegerField
      FieldName = 'codigoaluno'
      Required = True
    end
    object qryGetAlunoRepassenm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qryGetAlunoRepassevl_remessa: TFloatField
      FieldName = 'vl_remessa'
    end
    object qryGetAlunoRepassenr_total_parcelas: TIntegerField
      FieldName = 'nr_total_parcelas'
    end
    object qryGetAlunoRepassemes_ano: TStringField
      FieldName = 'mes_ano'
      ReadOnly = True
      Size = 7
    end
  end
  object qryVerificaRepasse: TUMZQuery
    Connection = DM.db
