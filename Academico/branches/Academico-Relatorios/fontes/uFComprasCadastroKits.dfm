  object qyKitsProdutos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  CI.cd_produto, CP.DS_PRODUTO ,CI.nr_quantidade'
      'FROM'
      '  comp_kits_itens CI'
      'LEFT JOIN comp_produtos CP ON (CP.CD_PRODUTO = CI.cd_produto)'
      'WHERE'
      '  CI.cd_kit = :cd_kit'
      'ORDER BY'
      '  CP.DS_PRODUTO')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_kit'
        ParamType = ptUnknown
      end>
    Left = 616
    Top = 488
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_kit'
        ParamType = ptUnknown
      end>
    object qyKitsProdutoscd_produto: TStringField
      FieldName = 'cd_produto'
      Size = 30
    end
    object qyKitsProdutosDS_PRODUTO: TStringField
      FieldName = 'DS_PRODUTO'
      Required = True
      Size = 255
    end
    object qyKitsProdutosnr_quantidade: TSmallintField
      FieldName = 'nr_quantidade'
    end
  end
  object dsKitsProdutos: TDataSource
    DataSet = qyKitsProdutos
    Left = 648
    Top = 488
  end
  object qyCategorias: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   cc.cd_categoria,'
      '   cc.ds_categoria,'
      '   ccc.cd_coligada'
      'FROM'
      '   comp_categorias cc'
      '   INNER JOIN comp_categorias_coligadas ccc ON ('
      '      ccc.cd_categoria = cc.CD_CATEGORIA'
      '   )'
      'GROUP BY'
      '   cc.CD_CATEGORIA'
      'ORDER BY'
      '   ds_categoria')
    Params = <>
    Left = 744
    Top = 488
    object qyCategoriascd_categoria: TIntegerField
      FieldName = 'cd_categoria'
      Required = True
    end
    object qyCategoriasds_categoria: TStringField
      FieldName = 'ds_categoria'
      Required = True
      Size = 255
    end
    object qyCategoriascd_coligada: TSmallintField
      FieldName = 'cd_coligada'
    end
  end
