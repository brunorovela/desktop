  object qyKitsTurmas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      
        '  t.codigo AS cd_turma ,ck.cd_anosemestre,ck.nr_etapa, t.descric' +
        'ao'
      'FROM'
      '  comp_kits_turmas  ck'
      
        'INNER JOIN turmas t on (t.codigo = ck.cd_turma and t.anosemestre' +
        ' = ck.cd_anosemestre)'
      'WHERE'
      '  cd_kit = :cd_kit'
      'ORDER BY'
      '  t.descricao ,ck.cd_turma')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_kit'
        ParamType = ptUnknown
      end>
    Left = 680
    Top = 488
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_kit'
        ParamType = ptUnknown
      end>
    object qyKitsTurmascd_turma: TStringField
      FieldName = 'cd_turma'
      Size = 50
    end
    object qyKitsTurmasdescricao: TStringField
      FieldName = 'descricao'
      Size = 255
    end
    object qyKitsTurmascd_anosemestre: TSmallintField
      FieldName = 'cd_anosemestre'
    end
    object qyKitsTurmasnr_etapa: TSmallintField
      FieldName = 'nr_etapa'
    end
  end
