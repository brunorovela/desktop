  object qryGetRepassesGrid: TUMZQuery
    Connection = DM.db
    OnCalcFields = qryGetRepassesGridCalcFields
    BeforeEdit = qryGetRepassesGridBeforeEdit
    BeforePost = qryGetRepassesGridBeforePost
    SQL.Strings = (
      'SELECT'#9
      '  cd_turma,'
      '  cd_contrato,'
      '  nr_mes_ano_ref,'
      
        '  CONCAT(CONCAT(nr_parcela_atual,'#39'/'#39'),nr_total_parcelas) as parc' +
        'ela,'
      '  vl_total_repasse,'
      '  nr_total_alunos,'
      '  vl_deducao,'
      '  vl_acrescimo,'
      '  ds_observacao,'
      '  cd_pessoa_log,'
      '  nr_parcela_atual,'
      '  nr_total_parcelas'
      'FROM'
      '  conv_repasses_mensal'
      'WHERE'
      '  nr_mes_ano_ref = :nr_mes_ano_ref AND'
      
        '  cd_contrato IN ( SELECT cd_contrato FROM conv_contratos WHERE ' +
        'cd_coligada IN ( %s ) )'
      'ORDER BY'
      '    nr_mes_ano_ref')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_mes_ano_ref'
        ParamType = ptUnknown
      end>
    Left = 80
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_mes_ano_ref'
        ParamType = ptUnknown
      end>
    object qryGetRepassesGridcd_turma: TStringField
      FieldName = 'cd_turma'
      Required = True
      Size = 50
    end
    object qryGetRepassesGridcd_contrato: TLargeintField
      FieldName = 'cd_contrato'
      Required = True
    end
    object qryGetRepassesGridnr_mes_ano_ref: TStringField
      FieldName = 'nr_mes_ano_ref'
      Required = True
      Size = 12
    end
    object qryGetRepassesGridparcela: TStringField
