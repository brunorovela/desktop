      ReadOnly = True
      Size = 23
    end
    object qryGetRepassesGridvl_total_repasse: TFloatField
      FieldName = 'vl_total_repasse'
    end
    object qryGetRepassesGridnr_total_alunos: TLargeintField
      FieldName = 'nr_total_alunos'
    end
    object qryGetRepassesGridvl_deducao: TFloatField
      FieldName = 'vl_deducao'
      OnChange = qryGetRepassesGridvl_deducaoChange
      DisplayFormat = '###,###,##0.00'
    end
    object qryGetRepassesGridvl_acrescimo: TFloatField
      FieldName = 'vl_acrescimo'
      OnChange = qryGetRepassesGridvl_acrescimoChange
      DisplayFormat = '###,###,##0.00'
