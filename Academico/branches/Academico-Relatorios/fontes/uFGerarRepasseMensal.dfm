  object qryGetUnidades: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   c.nm_coligada'
      'FROM'
      '   conv_contratos cc'
      '   INNER JOIN coligadas c ON (c.cd_coligada = cc.cd_coligada)'
      'WHERE'
      '   cc.cd_contrato = :cd_contrato')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_contrato'
        ParamType = ptUnknown
      end>
    Left = 40
    Top = 224
