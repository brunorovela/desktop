  object qyEstoque: TUMZReadOnlyQuery
    Connection = DM.db
    AfterOpen = qyEstoqueAfterOpen
    SQL.Strings = (
      'SELECT'
      '                ce.CD_COMPRA,'
      '                cp.CD_PRODUTO,'
      #9'cp.DS_PRODUTO,'
      #9'ce.DT_ENTRADA,'
      '                ce.DT_COMPRA,'
      '                ce.TP_ENTRADA_SAIDA,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA = 1 || ce.TP_ENTRADA_SAIDA = 3 TH' +
        'EN'
      #9#9'CONCAT(ce.NR_QUANTIDADE, '#39#39')'
      #9'ELSE'
      #9#9#39#39
      #9'END AS DS_ENTRADA,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA != 1 AND ce.TP_ENTRADA_SAIDA != 3' +
        ' THEN'
      #9#9'CONCAT(ce.NR_QUANTIDADE, '#39#39')'
      #9'ELSE'
      #9#9#39#39
      #9'END AS DS_SAIDA,'
      #9'ce.NR_QUANTIDADE,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA = 1 || ce.TP_ENTRADA_SAIDA = 3 TH' +
        'EN'
      #9#9'CONCAT(CASE'
      #9#9#9'WHEN ce.TP_PESSOA = 1 THEN'
      #9#9#9#9'p.nm_pessoa'
      #9#9#9'WHEN ce.TP_PESSOA = 2 THEN'
      #9#9#9#9'e.nm_empresa'
      #9#9#9'ELSE'
      #9#9#9#9#39'[N'#227'o informado]'#39
      
        #9#9'END, CAST( CASE WHEN ce.TP_ENTRADA_SAIDA = 3 THEN '#39' (Estorno)'#39 +
        ' ELSE '#39' '#39' END AS char ))'
      #9'ELSE'
      #9#9#39'Almoxarifado'#39
      #9'END AS DS_ORIGEM,'
      
        #9'CASE WHEN ce.TP_ENTRADA_SAIDA = 1 || ce.TP_ENTRADA_SAIDA = 3 TH' +
        'EN'
      #9#9#39'Almoxarifado'#39
      #9'ELSE'
      #9#9'CASE'
      #9#9#9'WHEN ce.TP_PESSOA = 1 THEN'
      #9#9#9#9'p.nm_pessoa'
      #9#9#9'WHEN ce.TP_PESSOA = 2 THEN'
      #9#9#9#9'e.nm_empresa'
      #9#9#9'ELSE'
      #9#9#9#9#39#39
      #9#9'END'
      #9'END AS DS_DESTINO,'
      '  usu.nm_pessoa as usuario,'
      '  ce.cd_produto,'
      '  ce.cd_kit,'
      '  ce.vl_compra,'
      '  cp.VL_PRODUTO vl_venda,'
      '  ce.cd_compra_troca'
      'FROM'
      #9'comp_estoque ce'
      
        #9'INNER JOIN comp_produtos cp ON ( cp.CD_PRODUTO = ce.CD_PRODUTO ' +
        ')'
      
        #9'LEFT JOIN pessoas p ON ( ce.TP_PESSOA = 1 AND p.cd_pessoa = ce.' +
        'CD_PESSOA )'
      '  LEFT JOIN pessoas usu ON ( usu.cd_pessoa = ce.cd_usuario  )'
      
        #9'LEFT JOIN empresas e ON ( ce.TP_PESSOA = 2 AND e.cd_empresa = p' +
        '.cd_pessoa )'
      'ORDER BY'
      '  ce.DT_ENTRADA')
    Params = <>
    Left = 496
    Top = 72
