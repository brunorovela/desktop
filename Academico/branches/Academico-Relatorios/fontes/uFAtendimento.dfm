  object qryMotivos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  cd_motivo,'
      '  nm_motivo,'
      '  ds_observacoes,'
      '  sn_ativo,'
      '  CASE WHEN sn_ativo = 1 THEN '#39'Sim'#39' ELSE '#39'N'#227'o'#39' END as ativo,'
      '  SUBSTRING(ds_observacoes,1,100) as dsObservacoes'
      'FROM'
      '  pessoas_atendimentos_motivos')
    Params = <>
    Left = 336
    Top = 128
    object qryMotivosnm_motivo: TStringField
      FieldName = 'nm_motivo'
      Size = 100
    end
    object qryMotivosds_observacoes: TMemoField
      FieldName = 'ds_observacoes'
      BlobType = ftMemo
    end
    object qryMotivossn_ativo: TSmallintField
      FieldName = 'sn_ativo'
    end
    object qryMotivosativo: TStringField
      FieldName = 'ativo'
    end
    object qryMotivosdsObservacoes: TStringField
      FieldName = 'dsObservacoes'
      Size = 100
    end
    object qryMotivoscd_motivo: TLargeintField
      FieldName = 'cd_motivo'
    end
  end
