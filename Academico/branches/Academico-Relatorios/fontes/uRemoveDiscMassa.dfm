  object qyDisciplinas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  d.codigo cd_disciplina,'
      #9'd.descricao ds_disciplina,'
      '  t.anosemestre nr_anosemestre,'
      '  t.codigo cd_turma,'
      '  t.curso cd_curso,'
      '  t.cd_grade'
      'FROM'
      #9'turmas t'
      #9'INNER JOIN grades_disciplinas gd ON ('
      #9#9'gd.cd_grade = t.cd_grade AND'
      #9#9'gd.cd_curso = t.curso AND'
      #9#9'gd.nr_serie = t.serie'
      #9')'
      #9'INNER JOIN disciplinas d ON ('
      #9#9'd.codigo = gd.cd_disciplina AND'
      #9#9'd.curso = gd.cd_curso'
      #9')'
      'WHERE'
      #9't.anosemestre = :nr_anosemestre AND'
      #9't.codigo LIKE :cd_turma'
      'ORDER BY'
      '  d.descricao  ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end>
    Left = 271
    Top = 69
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end>
    object qyDisciplinasdisciplina: TStringField
      FieldName = 'ds_disciplina'
      Size = 150
    end
