  object qyAlunos: TUMZQuery
    Connection = DM.db
    OnCalcFields = qyAlunosCalcFields
    SQL.Strings = (
      'SELECT'
      #9'p.cd_pessoa,'
      '  p.nm_pessoa,'
      '  s.sn_final,'
      '  0 selecao'
      'FROM'
      '  fichaindividual f'
      #9'INNER JOIN pessoas p ON (p.cd_pessoa = f.codigoaluno)'
      #9'INNER JOIN situacao s ON ( s.cd_situacao = f.situacao )'
      'WHERE'
      #9'f.anosemestre = :nr_anosemestre AND'
      #9'f.turma LIKE :cd_turma AND'
      '  f.disciplina = :cd_disciplina'
      'GROUP BY'
      #9'p.cd_pessoa'
      'ORDER BY'
      '  p.nm_pessoa'
      '')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_disciplina'
        ParamType = ptUnknown
      end>
    Left = 288
    Top = 152
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_disciplina'
        ParamType = ptUnknown
      end>
