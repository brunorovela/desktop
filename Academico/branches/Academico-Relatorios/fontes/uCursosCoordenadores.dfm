  object qyCursos: TUMZQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'oracle=SELECT'#13#10#9'cm.CD_CURSO codigo, '#13#10#9'cm.DS_APELIDO apelido, '#13#10 +
        #9'cc.CD_COLIGADA cd_coligada,'#13#10#9'FIRST_OCCURRENCE(c.nm_coligada) n' +
        'm_coligada  '#13#10'FROM '#13#10#9'cursos_mestre cm       '#13#10#9'INNER JOIN curso' +
        's_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO AND cc.SN_ATIVO = 1' +
        ')       '#13#10#9'INNER JOIN coligadas c ON (c.cd_coligada = cc.cd_coli' +
        'gada)                          '#13#10'WHERE '#13#10#9'cc.cd_coligada IN (:co' +
        'ligadas) AND        '#13#10#9'cm.SN_ATIVO LIKE '#39'S'#39#13#10'GROUP BY '#13#10'   cm.CD' +
        '_CURSO, '#13#10'   cm.DS_APELIDO, '#13#10'   cc.CD_COLIGADA'#9#13#10'ORDER BY '#13#10#9'cm' +
        '.CD_CURSO'
      
        'mysql-5=SELECT'#13#10#9'cm.CD_CURSO codigo,'#13#10#9'cm.DS_APELIDO apelido,'#13#10#9 +
        'cc.CD_COLIGADA cd_coligada,'#13#10#9'c.nm_coligada nm_coligada'#13#10'FROM'#13#10#9 +
        'cursos_mestre cm'#13#10'INNER JOIN cursos_coligadas cc ON('#13#10#9'cc.CD_CUR' +
        'SO = cm.CD_CURSO'#13#10#9'AND cc.SN_ATIVO = 1'#13#10')'#13#10'INNER JOIN coligadas ' +
        'c ON('#13#10#9'c.cd_coligada = cc.cd_coligada'#13#10')'#13#10'WHERE'#13#10#9'cc.cd_coligad' +
        'a IN (%s) AND cm.SN_ATIVO LIKE '#39'S'#39#13#10'GROUP BY'#13#10#9'cm.CD_CURSO,'#13#10#9'cm' +
        '.DS_APELIDO,'#13#10#9'cc.CD_COLIGADA'#13#10'ORDER BY'#13#10#9'cm.CD_CURSO;')
    Left = 24
    Top = 385
    object qyCursoscodigo: TStringField
      FieldName = 'codigo'
      Origin = 'WMESTRE12.cursos.codigo'
      Size = 15
    end
    object qyCursosapelido: TStringField
      FieldName = 'apelido'
      Origin = 'WMESTRE12.cursos.apelido'
      Size = 50
    end
    object qyCursoscd_coligada: TIntegerField
      FieldName = 'cd_coligada'
    end
    object qyCursosnm_coligada: TStringField
      FieldName = 'nm_coligada'
      Size = 50
    end
  end
