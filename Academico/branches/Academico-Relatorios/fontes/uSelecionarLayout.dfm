  object qyListaLayout: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  CD_LAYOUT, NM_LAYOUT'
      'FROM'
      '  REM_LAYOUTS'
      'WHERE'
      '  sn_ativo = 1'
      '  AND cd_coligada = :cd_coligada'
      '  AND ( cd_origem = 1 or cd_origem = 3)'
      
        '  AND IF((select ds_valor from parametros where ds_variavel like' +
        ' '#39'sn_processo_remessa_novo'#39') = 1, sn_cobranca_bancaria = 0, 1=1 ' +
        ')'
      'ORDER BY'
      '  NM_LAYOUT')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
    Left = 28
    Top = 178
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
  end
