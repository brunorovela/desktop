  object qyFacturas: TUMZQuery
    Connection = DM.db
    Params = <>
    Properties.Strings = (
      'SELECT '
      '  fs.ds_situacao,'
      '  ff.*,'
      '  p.nm_pessoa'
      '  FROM'
      '  fin_facturas ff'
      
        '  INNER JOIN fin_facturas_situacoes fs ON (fs.cd_factura_situaca' +
        'o = ff.cd_situacao)'
      '  INNER JOIN pessoas p ON (p.cd_pessoa = ff.cd_pessoa)'
      'WHERE'
      '  p.cd_pessoa = :cd_pessoa')
    Left = 40
    Top = 176
    object qyFacturascd_factura: TLargeintField
      FieldName = 'cd_factura'
      ReadOnly = True
      Required = True
    end
    object qyFacturasdt_emissao: TDateTimeField
      FieldName = 'dt_emissao'
      ReadOnly = True
      Required = True
      DisplayFormat = 'dd/mm/yyyy'
    end
    object qyFacturascd_pessoa: TLargeintField
      FieldName = 'cd_pessoa'
      ReadOnly = True
      Required = True
    end
    object qyFacturasvl_total: TFloatField
      FieldName = 'vl_total'
      ReadOnly = True
      Required = True
      DisplayFormat = '###,###,##0.00'
    end
    object qyFacturasdt_cancelamento: TDateTimeField
      FieldName = 'dt_cancelamento'
      ReadOnly = True
      DisplayFormat = 'dd/mm/yyyy'
    end
    object qyFacturasnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      ReadOnly = True
      Size = 60
    end
    object qyFacturascd_situacao: TLargeintField
      FieldName = 'cd_situacao'
      Required = True
    end
    object qyFacturasds_descricao: TStringField
      FieldName = 'ds_descricao'
      Size = 100
    end
  end
