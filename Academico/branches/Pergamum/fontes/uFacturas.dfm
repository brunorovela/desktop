    Left = 72
    Top = 176
  end
  object qyFacturasItens: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   ff.cd_factura,'
      '   m.parcela,'
      '   m.datavencimento,'
      '   ftt.ds_tipo_titulo,'
      '   ffi.vl_item,'
      '   sf.ds_situacao'
      'FROM'
      '   fin_facturas ff'
      
        '   INNER JOIN fin_facturas_itens ffi ON(ffi.cd_factura = ff.cd_f' +
        'actura)'
      
        '   INNER JOIN mensalidades m ON(ffi.cd_mensalidade = m.cd_mensal' +
        'idade)'
      
        '   INNER JOIN fin_tipos_titulo ftt ON (ftt.cd_tipo_titulo = m.cd' +
        '_tipo_titulo  AND m.cd_coligada = ftt.cd_coligada)'
      
        '   INNER JOIN situacoes_financeiras sf ON (sf.cd_situacao = m.si' +
        'tuacao)'
      'WHERE'
      '   ff.cd_factura = :cd_factura')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_factura'
        ParamType = ptUnknown
      end>
    DataSource = dsFacturas
    MasterFields = 'cd_factura'
    MasterSource = dsFacturas
    LinkedFields = 'cd_factura'
    Left = 528
    Top = 160
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_factura'
        ParamType = ptUnknown
      end>
    object qyFacturasItensparcela: TSmallintField
      FieldName = 'parcela'
      ReadOnly = True
    end
    object qyFacturasItensdatavencimento: TDateTimeField
      FieldName = 'datavencimento'
      ReadOnly = True
    end
    object qyFacturasItensds_tipo_titulo: TStringField
      FieldName = 'ds_tipo_titulo'
      ReadOnly = True
      Size = 255
    end
    object qyFacturasItensvl_item: TFloatField
      FieldName = 'vl_item'
      ReadOnly = True
      Required = True
      DisplayFormat = '###,###,##0.00'
    end
    object qyFacturasItensds_situacao: TStringField
      FieldName = 'ds_situacao'
      Size = 15
    end
    object qyFacturasItenscd_factura: TLargeintField
      FieldName = 'cd_factura'
      Required = True
    end
  end
