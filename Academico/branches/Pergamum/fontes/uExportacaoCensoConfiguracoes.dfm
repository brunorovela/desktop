  object qyConfigProcesso: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  cd_layout,'
      '  nr_ano,'
      '  dt_ultima_exportacao,'
      #9'dt_ultima_atualizacao,'
      #9'dt_ultimo_bloqueio'
      'FROM'
      '  cen_processos'
      'WHERE'
      '  cd_processo = :cd_processo')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_processo'
        ParamType = ptUnknown
      end>
    Left = 368
    Top = 48
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_processo'
        ParamType = ptUnknown
      end>
    object qyConfigProcessonr_ano: TIntegerField
      FieldName = 'nr_ano'
    end
    object qyConfigProcessocd_layout: TIntegerField
      FieldName = 'cd_layout'
    end
    object qyConfigProcessods_layout: TStringField
      FieldKind = fkLookup
      FieldName = 'ds_layout'
      LookupDataSet = qyLayouts
      LookupKeyFields = 'cd_layout'
      LookupResultField = 'ds_layout'
      KeyFields = 'cd_layout'
      Size = 255
      Lookup = True
    end
    object qyConfigProcessodt_ultima_exportacao: TDateTimeField
      FieldName = 'dt_ultima_exportacao'
    end
    object qyConfigProcessodt_ultima_atualizacao: TDateTimeField
      FieldName = 'dt_ultima_atualizacao'
    end
    object qyConfigProcessodt_ultimo_bloqueio: TDateTimeField
      FieldName = 'dt_ultimo_bloqueio'
    end
  end
  object dsConfigProcesso: TDataSource
    DataSet = qyConfigProcesso
    Left = 400
    Top = 48
  end
  object qyLayouts: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  el.cd_layout,'
      '  el.ds_layout'
      'FROM'
      '  expo_layouts el'
      'WHERE'
      '  el.sn_ativo = 1'
      'ORDER BY'
      '  ds_layout ASC')
    Params = <>
    Left = 368
    Top = 80
    object qyLayoutscd_layout: TIntegerField
      FieldName = 'cd_layout'
    end
    object qyLayoutsds_layout: TStringField
      FieldName = 'ds_layout'
      Size = 255
    end
  end
