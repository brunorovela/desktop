  object tblTurmas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'select * from Turmas '
      'where AnoSemestre = :AnoSemestre and'
      'Curso = :Curso'
      'order by AnoSemestre, Curso, Codigo')
    Params = <
      item
        DataType = ftInteger
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Curso'
        ParamType = ptUnknown
      end>
    Left = 480
    Top = 64
    ParamData = <
