  object tblGrade: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'gr.Codigo, '
      #9'gr.Disciplina, '
      #9'gr.Curso, '
      #9'gr.Serie, '
      #9'gr.Grau,'
      #9'gr.Sigla,'
      #9'gr.Descricao,'
      #9'gr.Turno'
      'FROM '
      #9'(SELECT '
      
        '   NULL as codigo, grades_disciplinas.cd_disciplina disciplina, ' +
        'Turmas.Curso, Turmas.Serie, '
      
        '   Turmas.Grau, Disciplinas.Sigla, Disciplinas.Descricao, Turmas' +
        '.Turno'
      'FROM '
      '   Turmas'
      
        '   INNER JOIN grades_disciplinas ON (grades_disciplinas.CD_GRADE' +
        ' = turmas.cd_grade AND grades_disciplinas.CD_CURSO = turmas.curs' +
        'o and grades_disciplinas.NR_SERIE = turmas.serie)'
      
        '   INNER JOIN Disciplinas ON (grades_disciplinas.cd_curso = Disc' +
        'iplinas.Curso) AND (grades_disciplinas.cd_disciplina = Disciplin' +
        'as.Codigo)'
      
        'WHERE Turmas.Codigo = :Turma AND Turmas.Anosemestre = :Anosemest' +
        're '
      'ORDER BY Disciplinas.Ordem, Disciplinas.Descricao'
      '  ) gr'
      'GROUP BY'
      #9'gr.Codigo, '
      #9'gr.Disciplina, '
      #9'gr.Curso, '
      #9'gr.Serie, '
      #9'gr.Grau,'
      #9'gr.Sigla,'
      #9'gr.Descricao,'
      #9'gr.Turno')
    Params = <
      item
        DataType = ftString
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    Left = 480
    Top = 32
    ParamData = <
      item
        DataType = ftString
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end>
    object tblGradeSerie: TSmallintField
      DisplayWidth = 7
      FieldName = 'Serie'
    end
    object tblGradeCurso: TStringField
      DisplayWidth = 9
      FieldName = 'Curso'
      Size = 15
    end
