  object qryTitulosResp: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   m1.cd_mensalidade'
      'FROM'
      '   mensalidades m1'
      '      JOIN mensalidades m2 ON'
      '         (m1.cd_resp = m2.cd_resp)'
      'WHERE m1.situacao not in (3,4,5,7) AND '
      '   m2.cd_mensalidade = :cd_mensalidade AND'
      '   DATE(m1.datapagamento) LIKE DATE(m2.datapagamento)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_mensalidade'
        ParamType = ptUnknown
      end>
    Left = 248
    Top = 256
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_mensalidade'
        ParamType = ptUnknown
      end>
  end
end
