  object qySituacoes: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  S.CD_SITUACAO,'
      '  S.DS_VALOR,'
      '  S.DS_SIGLA,'
      '  T.CD_SITUACAO CD_SITUACAO_MATRICULA_TURMA'
      'FROM'
      '  SITUACOES S'
      
        '    LEFT JOIN SITUACAO T ON (S.CD_SITUACAO = T.CD_SITUACAO_CURSO' +
        ')'
      'WHERE'
      '  S.CD_MODULO = 1019'
      'ORDER BY'
      '  S.DS_VALOR')
    Params = <>
    Left = 384
    Top = 392
    object qySituacoesCD_SITUACAO: TIntegerField
      FieldName = 'CD_SITUACAO'
    end
    object qySituacoesDS_VALOR: TStringField
      FieldName = 'DS_VALOR'
      Size = 255
    end
    object qySituacoesDS_SIGLA: TStringField
      FieldName = 'DS_SIGLA'
      Size = 50
    end
    object qySituacoesCD_SITUACAO_MATRICULA_TURMA: TIntegerField
      FieldName = 'CD_SITUACAO_MATRICULA_TURMA'
    end
  end
