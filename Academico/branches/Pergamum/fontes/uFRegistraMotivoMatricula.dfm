  object qyAtuaDataSaida: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      '   matriculas'
      'SET'
      '   datasaida = :datasaida'
      'WHERE'
      '   anosemestre = :anosemestre AND'
      '   turma = :turma AND'
      '   codigoaluno = :codigoaluno AND'
      '   curso = :curso')
    Params = <
      item
        DataType = ftUnknown
        Name = 'datasaida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end>
    Left = 472
    Top = 264
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'datasaida'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end>
  end
  object qyMotivos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   CD_SITUACAO,'
      '   DS_VALOR,'
      '   DS_SIGLA'
      'FROM'
      '   SITUACOES'
      'WHERE'
      '   CD_MODULO = 1145'
      'ORDER BY'
      '   DS_SIGLA')
    Params = <>
    Left = 488
    Top = 120
  end
  object qryUpdateMatriculaCurso: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'UPDATE'
      '   matriculas_curso'
      'SET'
      '   dt_saida = :dataconc,'
      '  cd_situacao = :situacao'
      'WHERE'
      '   cd_pessoa = :codigoaluno AND'
      '   cd_curso = :curso')
