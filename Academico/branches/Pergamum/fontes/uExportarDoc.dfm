  object qyExporta: TUMZQuery
    Connection = DM.dbDocs
    Params = <>
    Left = 480
    Top = 288
  end
  object qyListaAlunos: TUMZQuery
    Connection = DM.db
    OnCalcFields = qyListaAlunosCalcFields
    SQL.Strings = (
      'SELECT'
      '  "1" as depto,'
      '  m.codigoaluno,'
      '  p.nm_pessoa, '
      '  m.curso, '
      '  m.turma'
      'FROM'
      '  matriculas m'
      '  INNER JOIN pessoas p ON (m.codigoaluno = p.cd_pessoa)'
      'INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = m.curso)'
      'GROUP BY'
      '   m.codigoaluno'
      'LIMIT 1')
    Params = <>
    Left = 480
    Top = 248
    object qyListaAlunoscodigoaluno: TIntegerField
      FieldName = 'codigoaluno'
    end
    object qyListaAlunosnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyListaAlunosnome_pessoa: TStringField
      FieldKind = fkCalculated
      FieldName = 'nome_pessoa'
      Size = 255
      Calculated = True
    end
    object qyListaAlunosdepto: TStringField
      FieldName = 'depto'
      FixedChar = True
      Size = 1
    end
    object qyListaAlunosturma: TStringField
      FieldName = 'turma'
      Size = 15
    end
    object qyListaAlunoscurso: TStringField
      FieldName = 'curso'
      Size = 15
    end
  end
