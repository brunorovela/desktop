  object qyBolsasTitulos: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      
        '  tt.ds_tipo_titulo, tt.cd_tipo_titulo, bt.cd_coligada, bt.cd_bo' +
        'lsa,'
      '  IFNULL(bt.cd_bolsas_tipo_titulos, -1) cd_bolsas_tipo_titulos,'
      '  tt.cd_coligada, c.nm_coligada'
      'FROM'
      '  fin_tipos_titulo tt'
      '  INNER JOIN coligadas c ON ( c.cd_coligada = tt.cd_coligada )'
      '  LEFT JOIN fin_bolsas_tipos_titulos bt ON ('
      '    tt.cd_tipo_titulo = bt.cd_tipo_titulo AND'
      '    tt.cd_coligada = bt.cd_coligada AND bt.cd_bolsa = :cd_bolsa'
      '  )'
      'WHERE'
      
        '  tt.ct_tipo_titulo = 1 AND tt.cd_coligada_matriz = :cd_coligada' +
        '_matriz')
    Params = <
      item
        DataType = ftInteger
        Name = 'cd_bolsa'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada_matriz'
        ParamType = ptUnknown
      end>
    DataSource = dsBolsas
    Left = 240
    Top = 448
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cd_bolsa'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada_matriz'
        ParamType = ptUnknown
      end>
