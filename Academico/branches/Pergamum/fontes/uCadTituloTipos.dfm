  object qyTituloTipos: TUMZQuery
    Connection = DM.db
    OnCalcFields = qyTituloTiposCalcFields
    BeforeInsert = qyTituloTiposBeforeInsert
    AfterInsert = qyTituloTiposAfterInsert
