    BeforePost = qyTituloTiposBeforePost
    AfterPost = qyTituloTiposAfterPost
    SQL.Strings = (
      'SELECT'
      '   *'
      'FROM'
      '   fin_config_tipos_titulo'
      'WHERE'
      '   cd_coligada_matriz = :cd_coligada_matriz'
      '   AND sn_ativo = 1'
      'ORDER BY'
      '   ds_tipo_titulo')
