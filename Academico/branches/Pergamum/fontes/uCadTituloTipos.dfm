  object qyContas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'SELECT cd_conta, ds_conta, cd_coligada_matriz, cd_classificacao ' +
        'from fin_config_plano_contas'
      'WHERE cd_coligada_matriz = :cd_coligada_matriz AND tp_conta = 1'
      'ORDER BY cd_classificacao, ds_conta')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada_matriz'
        ParamType = ptUnknown
      end>
    Left = 524
    Top = 239
    ParamData = <
