  object qyPessoas: TUMZQuery
    Connection = DM.db
    AfterOpen = qyPessoasAfterOpen
    BeforeScroll = qyPessoasBeforeScroll
    AfterScroll = qyPessoasAfterScroll
    SQL.Strings = (
      'SELECT'
      '  p.cd_pessoa, p.nm_pessoa, m.curso, m.anosemestre, m.turma'
      'FROM'
      '  pessoas p'
      '  INNER JOIN matriculas m ON ( m.codigoaluno = p.cd_pessoa )'
      'WHERE'
      '  m.anosemestre = :nr_anosemestre AND'
      '  m.turma = :cd_turma AND'
      '  m.situacao in (0,1,2,9,11) AND'
      '  ( :cd_pessoa = 0 OR m.codigoaluno = :cd_pessoa )'
      'ORDER BY p.nm_pessoa')
    Params = <
      item
        DataType = ftString
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 525
    Top = 286
    ParamData = <
      item
        DataType = ftString
        Name = 'nr_anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'cd_turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    object qyPessoascd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
      Origin = 'WMESTRE12.pessoas.cd_pessoa'
    end
    object qyPessoasnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Origin = 'WMESTRE12.pessoas.nm_pessoa'
      Size = 60
    end
    object qyPessoascurso: TStringField
      FieldName = 'curso'
      Origin = 'WMESTRE12.matriculas.curso'
      Size = 15
    end
    object qyPessoasanosemestre: TSmallintField
      FieldName = 'anosemestre'
      Origin = 'WMESTRE12.matriculas.anosemestre'
    end
    object qyPessoasturma: TStringField
      FieldName = 'turma'
      Origin = 'WMESTRE12.matriculas.turma'
      Size = 50
    end
  end
