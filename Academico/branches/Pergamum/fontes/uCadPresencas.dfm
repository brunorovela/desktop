  object qyHorarios: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  thc.cd_turmas_horarios,'
      '  fi.codigoaluno,'
      '  thc.cd_horario AS CD_HORARIO,'
      
        '  CONCAT(h.ds_horario, '#39' - '#39', COALESCE(p.nm_pessoa, '#39'<professor ' +
        'n'#227'o definido>'#39')) AS DS_HORARIO,'
      '  h.hr_inicio AS HR_INICIO,'
      '  h.hr_fim AS HR_FIM,'
      '  d.codigo AS CD_DISC,'
      '  d.descricao AS DS_DISC,'
      '  d.curso AS CD_CURSO,'
      '  thc.cd_turma,'
      '  fi.sn_bloq_freq1,'
      '  fi.sn_bloq_freq2,'
      '  fi.sn_bloq_freq3,'
      '  fi.sn_bloq_freq4,'
      '  fi.sn_bloq_freq5,'
      '  fi.sn_bloq_freq6,'
      '  fi.sn_bloq_freq7,'
      '  fi.sn_bloq_freq8,'
      '  fi.sn_bloq_freq9,'
      '  fi.sn_bloq_freq10'
      'FROM'
      '  turmas_horarios_config thc'
      '  INNER JOIN horarios h ON (h.codigo = thc.cd_horario)'
      
        '  INNER JOIN turmas t ON (t.codigo = thc.cd_turma AND t.anosemes' +
        'tre = thc.nr_anosemestre)'
      '  INNER JOIN fichaindividual fi  ON ('
      '    fi.turma = t.codigo AND'
      '    fi.anosemestre = t.anosemestre AND'
      '    fi.disciplina = thc.cd_disciplina AND'
      '    fi.curso = t.curso'
      '  )'
      
        '  INNER JOIN disciplinas d ON (d.codigo = fi.disciplina AND d.cu' +
        'rso = fi.curso)'
      '  LEFT JOIN pessoas p ON (p.cd_pessoa = thc.cd_professor)'
      'WHERE'
      
        '  thc.cd_turma_base = :CD_TURMA AND thc.nr_anosemestre = :NR_ANO' +
        'SEMESTRE AND'
      
        '  thc.nr_dia_semana = :DIA_SEMANA AND fi.codigoaluno = :CD_PESSO' +
        'A AND '
      
        '  IS_HORARIO_TURMA_ATIVA(:DT_SELECIONADA, thc.dt_inicial, thc.dt' +
        '_final, thc.sn_ativo) = 1'
      'GROUP BY'
      
        #9'fi.codigoaluno, thc.cd_horario, thc.cd_disciplina, thc.cd_profe' +
        'ssor'
      'ORDER BY'
      
        '  h.hr_inicio, h.ds_horario, thc.cd_turmas_horarios, fi.codigoal' +
        'uno, fi.turma')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DIA_SEMANA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DT_SELECIONADA'
        ParamType = ptUnknown
      end>
    Left = 536
    Top = 440
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DIA_SEMANA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DT_SELECIONADA'
        ParamType = ptUnknown
      end>
  end
  object qyListaAulasAluno: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  fi.codigoaluno,'
      '  d.codigo AS CD_DISCIPLINA,'
      '  d.descricao AS DS_DISCIPLINA,'
      '  d.curso AS CD_CURSO,'
      '  da.conteudo,'
      '  da.qtd_aulas,'
      '  da.cd_diario_aula,'
      
        '  CASE WHEN thc.cd_turmas_horarios IS NULL THEN 1 ELSE 0 END AS ' +
        'sn_aula_extra,'
      
        '  GROUP_CONCAT(CASE WHEN IS_HORARIO_TURMA_ATIVA(da.data, thc.dt_' +
        'inicial, thc.dt_final, thc.sn_ativo) = 1 THEN thc.cd_turmas_hora' +
        'rios ELSE NULL END ORDER BY h.hr_inicio) AS lista_horarios,'
      '  HEX(CONCAT(da.turma, d.codigo, da.cd_professor)) cd_chave,'
      '  COALESCE(daa.ds_freq, '#39#39') AS ds_freq,'
      '  fi.sn_bloq_freq1,'
      '  fi.sn_bloq_freq2,'
      '  fi.sn_bloq_freq3,'
      '  fi.sn_bloq_freq4,'
      '  fi.sn_bloq_freq5,'
      '  fi.sn_bloq_freq6,'
      '  fi.sn_bloq_freq7,'
      '  fi.sn_bloq_freq8,'
      '  fi.sn_bloq_freq9,'
      '  fi.sn_bloq_freq10'
      'FROM'
      '  fichaindividual fi'
      '  INNER JOIN diario_aulas da ON ('
      '    da.turma = fi.turma AND da.anosemestre = fi.anosemestre AND'
      '    da.disciplina = fi.disciplina'
      '  )'
      
        '  INNER JOIN disciplinas d ON ( d.codigo = fi.disciplina AND d.c' +
        'urso = fi.curso )'
      '  LEFT JOIN turmas_horarios_config thc ON ('
      #9#9'thc.nr_anosemestre = da.anosemestre'
      #9#9'AND thc.cd_turma = da.turma'
      '    AND thc.cd_turma_base = fi.turmamatricula'
      #9#9'AND thc.cd_disciplina = da.disciplina'
      
        #9#9'AND CASE WHEN thc.cd_professor > 0 THEN thc.cd_professor = da.' +
        'cd_professor ELSE 1=1 END'
      #9#9'AND thc.nr_dia_semana = DAYOFWEEK(da.data)'
      #9')'
      #9'LEFT JOIN horarios h ON (h.codigo = thc.cd_horario)'
      '  LEFT JOIN diario_aulas_alunos daa ON ('
      
        '    daa.cd_pessoa = fi.codigoaluno AND daa.cd_turma = da.turma A' +
        'ND'
      
        '    daa.nr_anosem = da.anosemestre AND daa.cd_disciplina = da.di' +
        'sciplina AND'
      '    daa.cd_bimestre = da.bimestre AND daa.nr_aula = da.nro_aula'
      '  )'
      'WHERE'
      
        '  fi.turmamatricula = :CD_TURMA AND fi.anosemestre = :NR_ANOSEME' +
        'STRE AND'
      
        '  DATE_FORMAT(da.`data`, '#39'%Y-%m-%d'#39') = DATE_FORMAT(:DT_SELECIONA' +
        'DA, '#39'%Y-%m-%d'#39') AND'
      '  fi.codigoaluno = :CD_PESSOA AND da.bimestre = :NR_ETAPA'
      'GROUP BY'
      '  da.cd_diario_aula, fi.codigoaluno')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_TURMA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DT_SELECIONADA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ETAPA'
        ParamType = ptUnknown
      end>
