  object qryRemessas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   CD_REMESSA,'
      '   NR_REMESSA,'
      '   DS_REMESSA,'
      '   DT_CRIACAO,'
      '   DT_ENVIO,'
      '   DT_RETORNO,'
      '   CD_CAIXA,'
      '   CD_COLIGADA,'
      '   DT_CP_INICIO,'
      '   DT_CP_FIM,'
      '   CD_USUARIO'
      'FROM'
      '   FIN_REMESSA_CP'
      'WHERE'
      '   CD_REMESSA = :CD_REMESSA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_REMESSA'
        ParamType = ptUnknown
      end>
    Left = 752
    Top = 128
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_REMESSA'
        ParamType = ptUnknown
      end>
    object qryRemessasCD_REMESSA: TLargeintField
      DisplayLabel = 'C'#243'd. Remessa'
      FieldName = 'CD_REMESSA'
      Required = True
    end
    object qryRemessasNR_REMESSA: TLargeintField
      DisplayLabel = 'N'#186' Remessa'
      FieldName = 'NR_REMESSA'
    end
    object qryRemessasDS_REMESSA: TStringField
      DisplayLabel = 'Descri'#231#227'o da Remessa'
      FieldName = 'DS_REMESSA'
      Size = 150
    end
    object qryRemessasDT_CRIACAO: TDateTimeField
      DisplayLabel = 'Data da Cria'#231#227'o'
      FieldName = 'DT_CRIACAO'
    end
    object qryRemessasDT_ENVIO: TDateTimeField
      DisplayLabel = 'Data do Envio'
      FieldName = 'DT_ENVIO'
    end
    object qryRemessasDT_RETORNO: TDateTimeField
      DisplayLabel = 'Data de Retorno'
      FieldName = 'DT_RETORNO'
    end
    object qryRemessasCD_CAIXA: TLargeintField
      DisplayLabel = 'C'#243'd. Conta'
      FieldName = 'CD_CAIXA'
    end
    object qryRemessasCD_COLIGADA: TLargeintField
      DisplayLabel = 'C'#243'd. UE'
      FieldName = 'CD_COLIGADA'
    end
    object qryRemessasDT_CP_INICIO: TDateTimeField
      DisplayLabel = 'In'#237'cio Per'#237'odo'
      FieldName = 'DT_CP_INICIO'
      EditMask = '!99/99/0000;1;_'
    end
    object qryRemessasDT_CP_FIM: TDateTimeField
      DisplayLabel = 'Fim do Per'#237'odo'
      FieldName = 'DT_CP_FIM'
      EditMask = '!99/99/0000;1;_'
    end
    object qryRemessasCD_USUARIO: TLargeintField
      DisplayLabel = 'C'#243'd. Usu'#225'rio'
      FieldName = 'CD_USUARIO'
    end
    object qryRemessasdescConta: TStringField
      DisplayLabel = 'Conta de Pagamento'
      FieldKind = fkLookup
      FieldName = 'descConta'
      LookupDataSet = qryContas
      LookupKeyFields = 'cd_caixa'
      LookupResultField = 'ds_caixa'
      KeyFields = 'CD_CAIXA'
      Lookup = True
    end
    object qryRemessasnm_coligada: TStringField
      FieldKind = fkLookup
      FieldName = 'nm_coligada'
      LookupDataSet = DM.qryColigadas
      LookupKeyFields = 'CD_COLIGADA'
      LookupResultField = 'NM_COLIGADA'
      KeyFields = 'CD_COLIGADA'
      Lookup = True
    end
  end
  object qryCompromissos: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   CP.CD_TITULO,'
      '   FIRST_OCCURRENCE(CP.DS_DESPESA) DS_DESPESA,'
      '   FIRST_OCCURRENCE(CP.NR_DOCUMENTO) NR_DOCUMENTO,'
      
        '   CAST(FIRST_OCCURRENCE(CP.NR_PARCELA) AS NUMBER(5)) NR_PARCELA' +
        ','
      
        '   CAST(FIRST_OCCURRENCE(CP.DT_PROVAVEL_PGTO) AS TIMESTAMP(2)) D' +
        'T_PROVAVEL_PGTO,'
      
        '   SUM(COALESCE(MV.VL_ENTRADA, 0) - COALESCE(MV.VL_SAIDA, 0)) VL' +
        '_PENDENTE,'
      '   CAST(FIRST_OCCURRENCE(CP.CD_PESSOA) AS NUMBER(9)) CD_PESSOA,'
      '   FIRST_OCCURRENCE(P.NM_PESSOA) NM_PESSOA,'
      
        '   CAST(FIRST_OCCURRENCE(CP.CD_REMESSA) AS NUMBER(19)) CD_REMESS' +
        'A,'
      '   FIRST_OCCURRENCE(TT.DS_TIPO_TITULO) DS_TIPO_TITULO,'
      '   FIRST_OCCURRENCE(FP.DS_FORMA_PGTO) DS_FORMA_PGTO'
      'FROM'
      '   FIN_CONTAS_PAGAR CP'
      '      JOIN FIN_MOV_CP MV ON'
      '         (CP.CD_TITULO = MV.CD_TITULO) AND'
      '         (CP.CD_COLIGADA = MV.CD_COLIGADA)'
      '      JOIN PESSOAS P ON'
      '         (P.CD_PESSOA = CP.CD_PESSOA)'
      '      JOIN FIN_TIPOS_TITULO TT ON'
      '         (TT.CD_TIPO_TITULO = CP.CD_TIPO_TITULO) AND'
      '         (TT.CD_COLIGADA = CP.CD_COLIGADA)'
      '      JOIN FIN_FORMAS_PGTO FP ON'
      '         (FP.CD_FORMA_PGTO = CP.CD_FORMA_PGTO) AND'
      '         (FP.CD_COLIGADA = CP.CD_COLIGADA)'
      '      LEFT JOIN FIN_CONTAS_PAGAR_AUTORIZA CA ON'
      '         (CA.CD_AUTORIZA = CP.CD_AUTORIZA)'
      'WHERE'
      '   (CP.CD_CAIXA = :CAIXA AND CP.CD_COLIGADA = :COLIGADA) AND'
      '   (CP.CD_REMESSA IS NULL OR CP.CD_REMESSA = :REMESSA) AND'
      '   CP.SN_PREVISAO <> '#39'S'#39' AND'
      '   CP.CD_SITUACAO <> 2 AND'
      '   CA.CD_AUTORIZA_SITU IN(1, :AUTORIZA) AND'
      '   CP.DT_PROVAVEL_PGTO >= :DATA_INICIO AND'
      '   CP.DT_PROVAVEL_PGTO <= :DATA_FIM AND'
      '   CP.CD_TITULO_ORIGEM = 0'
      'GROUP BY'
      '   CP.CD_TITULO,'
      '   CP.CD_COLIGADA'
      'HAVING'
      
        '   SUM(COALESCE(MV.VL_ENTRADA, 0) - COALESCE(MV.VL_SAIDA, 0)) > ' +
        '0'
      'ORDER BY'
      '   FIRST_OCCURRENCE(P.NM_PESSOA),'
      '   CAST(FIRST_OCCURRENCE(CP.DT_PROVAVEL_PGTO) AS TIMESTAMP(2))')
    Params = <
      item
        DataType = ftUnknown
        Name = 'caixa'
