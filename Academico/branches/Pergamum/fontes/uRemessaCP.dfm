        '_TIPO_TITULO,'#13#10'   FP.DS_FORMA_PGTO'#13#10'FROM'#13#10'   FIN_CONTAS_PAGAR CP' +
        #13#10'      JOIN FIN_MOV_CP MV ON'#13#10'         (CP.CD_TITULO = MV.CD_TI' +
        'TULO) AND'#13#10'         (CP.CD_COLIGADA = MV.CD_COLIGADA)'#13#10'      JOI' +
        'N PESSOAS P ON'#13#10'         (P.CD_PESSOA = CP.CD_PESSOA)'#13#10'      JOI' +
        'N FIN_TIPOS_TITULO TT ON'#13#10'         (TT.CD_TIPO_TITULO = CP.CD_TI' +
        'PO_TITULO) AND'#13#10'         (TT.CD_COLIGADA = CP.CD_COLIGADA)'#13#10'    ' +
        '  JOIN FIN_FORMAS_PGTO FP ON'#13#10'         (FP.CD_FORMA_PGTO = CP.CD' +
        '_FORMA_PGTO) AND'#13#10'         (FP.CD_COLIGADA = CP.CD_COLIGADA)'#13#10'  ' +
        '    LEFT JOIN FIN_CONTAS_PAGAR_AUTORIZA CA ON'#13#10'         (CA.CD_A' +
        'UTORIZA = CP.CD_AUTORIZA)'#13#10'WHERE'#13#10'   (CP.CD_CAIXA = :CAIXA AND C' +
        'P.CD_COLIGADA = :COLIGADA) AND'#13#10'   (CP.CD_REMESSA IS NULL OR CP.' +
        'CD_REMESSA = :REMESSA) AND'#13#10'   CP.SN_PREVISAO <> '#39'S'#39' AND'#13#10'   CP.' +
        'CD_SITUACAO <> 2 AND'#13#10'   (CA.CD_AUTORIZA_SITU = 1 OR :AUTORIZA) ' +
        'AND'#13#10'   CP.DT_PROVAVEL_PGTO >= :DATA_INICIO AND'#13#10'   CP.DT_PROVAV' +
        'EL_PGTO <= :DATA_FIM AND'#13#10'   CP.CD_TITULO_ORIGEM = 0'#13#10'GROUP BY'#13#10 +
        '   CP.CD_TITULO,'#13#10'   CP.CD_COLIGADA'#13#10'HAVING'#13#10'   VL_PENDENTE > 0'#13 +
        #10'ORDER BY'#13#10'   P.NM_PESSOA,'#13#10'   CP.DT_PROVAVEL_PGTO'
      
        'oracle=SELECT'#13#10'   CP.CD_TITULO,'#13#10'   FIRST_OCCURRENCE(CP.DS_DESPE' +
        'SA) DS_DESPESA,'#13#10'   FIRST_OCCURRENCE(CP.NR_DOCUMENTO) NR_DOCUMEN' +
        'TO,'#13#10'   CAST(FIRST_OCCURRENCE(CP.NR_PARCELA) AS NUMBER(5)) NR_PA' +
        'RCELA,'#13#10'   CAST(FIRST_OCCURRENCE(CP.DT_PROVAVEL_PGTO) AS TIMESTA' +
        'MP(2)) DT_PROVAVEL_PGTO,'#13#10'   SUM(COALESCE(MV.VL_ENTRADA, 0) - CO' +
        'ALESCE(MV.VL_SAIDA, 0)) VL_PENDENTE,'#13#10'   CAST(FIRST_OCCURRENCE(C' +
        'P.CD_PESSOA) AS NUMBER(9)) CD_PESSOA,'#13#10'   FIRST_OCCURRENCE(P.NM_' +
        'PESSOA) NM_PESSOA,'#13#10'   CAST(FIRST_OCCURRENCE(CP.CD_REMESSA) AS N' +
        'UMBER(19)) CD_REMESSA,'#13#10'   FIRST_OCCURRENCE(TT.DS_TIPO_TITULO) D' +
        'S_TIPO_TITULO,'#13#10'   FIRST_OCCURRENCE(FP.DS_FORMA_PGTO) DS_FORMA_P' +
        'GTO'#13#10'FROM'#13#10'   FIN_CONTAS_PAGAR CP'#13#10'      JOIN FIN_MOV_CP MV ON'#13#10 +
        '         (CP.CD_TITULO = MV.CD_TITULO) AND'#13#10'         (CP.CD_COLI' +
        'GADA = MV.CD_COLIGADA)'#13#10'      JOIN PESSOAS P ON'#13#10'         (P.CD_' +
        'PESSOA = CP.CD_PESSOA)'#13#10'      JOIN FIN_TIPOS_TITULO TT ON'#13#10'     ' +
        '    (TT.CD_TIPO_TITULO = CP.CD_TIPO_TITULO) AND'#13#10'         (TT.CD' +
        '_COLIGADA = CP.CD_COLIGADA)'#13#10'      JOIN FIN_FORMAS_PGTO FP ON'#13#10' ' +
        '        (FP.CD_FORMA_PGTO = CP.CD_FORMA_PGTO) AND'#13#10'         (FP.' +
        'CD_COLIGADA = CP.CD_COLIGADA)'#13#10'      LEFT JOIN FIN_CONTAS_PAGAR_' +
        'AUTORIZA CA ON'#13#10'         (CA.CD_AUTORIZA = CP.CD_AUTORIZA)'#13#10'WHER' +
        'E'#13#10'   (CP.CD_CAIXA = :CAIXA AND CP.CD_COLIGADA = :COLIGADA) AND'#13 +
        #10'   (CP.CD_REMESSA IS NULL OR CP.CD_REMESSA = :REMESSA) AND'#13#10'   ' +
