    SQLList.Strings = (
      
        'mysql-5=SELECT'#13#10'   CP.CD_TITULO,'#13#10'   CP.DS_DESPESA,'#13#10'   CP.NR_DO' +
        'CUMENTO,'#13#10'   CP.NR_PARCELA,'#13#10'   CP.DT_PROVAVEL_PGTO,'#13#10'   SUM(COA' +
        'LESCE(MV.VL_ENTRADA, 0) - COALESCE(MV.VL_SAIDA, 0)) VL_PENDENTE,' +
