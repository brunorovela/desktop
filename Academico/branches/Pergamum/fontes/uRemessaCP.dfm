        'AUTORIZA_SITU IN(1, :AUTORIZA) AND'#13#10'   CP.DT_PROVAVEL_PGTO >= :D' +
        'ATA_INICIO AND'#13#10'   CP.DT_PROVAVEL_PGTO <= :DATA_FIM AND'#13#10'   CP.C' +
        'D_TITULO_ORIGEM = 0'#13#10'GROUP BY'#13#10'   CP.CD_TITULO,'#13#10'   CP.CD_COLIGA' +
        'DA'#13#10'HAVING'#13#10'   SUM(COALESCE(MV.VL_ENTRADA, 0) - COALESCE(MV.VL_S' +
