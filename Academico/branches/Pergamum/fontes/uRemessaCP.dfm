  object qryContas: TUMZReadOnlyQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT DISTINCT'
      '   C.CD_CAIXA,'
      '   C.DS_CAIXA'
      'FROM '
      '   FIN_CADASTRO_CONTAS C'
      '      JOIN FIN_CONTAS_USUARIOS U ON'
      '         (C.CD_CAIXA = U.CD_CAIXA) AND'
      '         (C.CD_COLIGADA = U.CD_COLIGADA)'
      '      JOIN REM_LAYOUTS L ON'
      '         (C.CD_CAIXA = L.CD_CAIXA) AND'
      '         (C.CD_COLIGADA = L.CD_COLIGADA) AND'
      '         (L.CD_ORIGEM = 2)'
      'WHERE'
      '   C.CD_COLIGADA = :CD_COLIGADA AND'
      '   U.CD_USUARIO = :CD_USUARIO'
      'ORDER BY'
      '   C.DS_CAIXA'
      '')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_usuario'
        ParamType = ptUnknown
      end>
    Left = 752
    Top = 208
    ParamData = <
