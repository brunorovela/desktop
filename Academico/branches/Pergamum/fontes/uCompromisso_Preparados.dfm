  object qryItens: TUMZReadOnlyQuery
    Connection = DM.db
    OnCalcFields = qryItensCalcFields
    SQL.Strings = (
      'SELECT'
      '   P.CD_PREPARACAO,'
      '   P.CD_TITULO,'
      '   P.CD_COLIGADA,'
      '   P.VL_BAIXA,'
      '   P.VL_MULTA,'
      '   P.VL_JUROS,'
      '   P.VL_DESCONTO,'
      '   P.SN_BAIXADO,'
      '   CP.DS_DESPESA,'
      '   CP.DT_VENCIMENTO,'
      '   CP.CD_SITUACAO,'
      '   CP.SN_PREVISAO,'
      '   PE.NM_PESSOA,'
      '   SUM(COALESCE(M.VL_SAIDA, 0))VL_SAIDAS'
      'FROM'
      '   FIN_CP_PREPARACAO_ITENS P'
      '      JOIN FIN_CONTAS_PAGAR CP ON'
      '         (P.CD_TITULO = CP.CD_TITULO) AND'
      '         (P.CD_COLIGADA = CP.CD_COLIGADA)'
      '         JOIN PESSOAS PE ON'
      '            (CP.CD_PESSOA = PE.CD_PESSOA)'
      '         LEFT JOIN FIN_MOV_CP M ON'
      '            (CP.CD_TITULO = M.CD_TITULO) AND'
      '            (CP.CD_COLIGADA = M.CD_COLIGADA)'
      'WHERE'
      '   P.CD_PREPARACAO = :CD_PREPARACAO'
      'GROUP BY'
      '   P.CD_PREPARACAO,'
      '   P.CD_TITULO,'
      '   P.CD_COLIGADA,'
      '   P.VL_BAIXA,'
      '   P.VL_MULTA,'
      '   P.VL_JUROS,'
      '   P.VL_DESCONTO,'
      '   P.SN_BAIXADO,'
      '   CP.DS_DESPESA,'
      '   CP.DT_VENCIMENTO,'
      '   CP.CD_SITUACAO,'
      '   CP.SN_PREVISAO,'
      '   PE.NM_PESSOA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_PREPARACAO'
        ParamType = ptUnknown
      end>
    SQLList.Strings = (
      
        'mysql-5=SELECT'#13#10'   P.CD_PREPARACAO,'#13#10'   P.CD_TITULO,'#13#10'   P.CD_CO' +
        'LIGADA,'#13#10'   P.VL_BAIXA,'#13#10'   P.VL_MULTA,'#13#10'   P.VL_JUROS,'#13#10'   P.VL' +
        '_DESCONTO,'#13#10'   P.SN_BAIXADO,'#13#10'   CP.DS_DESPESA,'#13#10'   CP.DT_VENCIM' +
        'ENTO,'#13#10'   CP.CD_SITUACAO,'#13#10'   CP.SN_PREVISAO,'#13#10'   PE.NM_PESSOA,'#13 +
        #10'   SUM(COALESCE(M.VL_SAIDA, 0)) VL_SAIDAS'#13#10'FROM'#13#10'   FIN_CP_PREP' +
        'ARACAO_ITENS P'#13#10'      JOIN FIN_CONTAS_PAGAR CP ON'#13#10'         (P.C' +
        'D_TITULO = CP.CD_TITULO) AND'#13#10'         (P.CD_COLIGADA = CP.CD_CO' +
        'LIGADA)'#13#10'         JOIN PESSOAS PE ON'#13#10'            (CP.CD_PESSOA ' +
        '= PE.CD_PESSOA)'#13#10'         LEFT JOIN FIN_MOV_CP M ON'#13#10'           ' +
        ' (CP.CD_TITULO = M.CD_TITULO) AND'#13#10'            (CP.CD_COLIGADA =' +
        ' M.CD_COLIGADA)'#13#10'WHERE'#13#10'   P.CD_PREPARACAO = :CD_PREPARACAO'#13#10'GRO' +
        'UP BY'#13#10'   P.CD_TITULO'
      
        'oracle=SELECT'#13#10'   P.CD_PREPARACAO,'#13#10'   P.CD_TITULO,'#13#10'   P.CD_COL' +
        'IGADA,'#13#10'   P.VL_BAIXA,'#13#10'   P.VL_MULTA,'#13#10'   P.VL_JUROS,'#13#10'   P.VL_' +
        'DESCONTO,'#13#10'   P.SN_BAIXADO,'#13#10'   CP.DS_DESPESA,'#13#10'   CP.DT_VENCIME' +
        'NTO,'#13#10'   CP.CD_SITUACAO,'#13#10'   CP.SN_PREVISAO,'#13#10'   PE.NM_PESSOA,'#13#10 +
        '   SUM(COALESCE(M.VL_SAIDA, 0))VL_SAIDAS'#13#10'FROM'#13#10'   FIN_CP_PREPAR' +
        'ACAO_ITENS P'#13#10'      JOIN FIN_CONTAS_PAGAR CP ON'#13#10'         (P.CD_' +
        'TITULO = CP.CD_TITULO) AND'#13#10'         (P.CD_COLIGADA = CP.CD_COLI' +
        'GADA)'#13#10'         JOIN PESSOAS PE ON'#13#10'            (CP.CD_PESSOA = ' +
        'PE.CD_PESSOA)'#13#10'         LEFT JOIN FIN_MOV_CP M ON'#13#10'            (' +
        'CP.CD_TITULO = M.CD_TITULO) AND'#13#10'            (CP.CD_COLIGADA = M' +
        '.CD_COLIGADA)'#13#10'WHERE'#13#10'   P.CD_PREPARACAO = :CD_PREPARACAO'#13#10'GROUP' +
        ' BY'#13#10'   P.CD_PREPARACAO,'#13#10'   P.CD_TITULO,'#13#10'   P.CD_COLIGADA,'#13#10'  ' +
        ' P.VL_BAIXA,'#13#10'   P.VL_MULTA,'#13#10'   P.VL_JUROS,'#13#10'   P.VL_DESCONTO,'#13 +
        #10'   P.SN_BAIXADO,'#13#10'   CP.DS_DESPESA,'#13#10'   CP.DT_VENCIMENTO,'#13#10'   C' +
        'P.CD_SITUACAO,'#13#10'   CP.SN_PREVISAO,'#13#10'   PE.NM_PESSOA')
    Left = 688
    Top = 96
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_PREPARACAO'
        ParamType = ptUnknown
      end>
