  object qryInfoPor: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      #9's.codigo codigo,'
      '               '#9's.cd_situacao cd_situacao,'
      #9's.ds_valor ds_valor'#9
      'FROM'#9
      #9'situacoes s'
      'WHERE'
      #9's.cd_modulo = 30005'
      'ORDER BY '
      '     s.ds_valor ASC')
    Params = <>
    Left = 8
    Top = 408
  end
  object qryPessoasPreferencias: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'npp.cd_preferencias,'
      #9'npp.cd_pessoa,'
      #9'npp.cd_modulo,'
      #9'npp.ds_chave,'
      #9'npp.ds_valor'
      'FROM'
      #9'nu_pessoas_pref npp'
      'WHERE'
      #9'npp.cd_modulo = 53'
      'AND'
      #9'npp.ds_chave = '#39'PlanilhaContatosFiltrosContatos'#39
      'AND'
      #9'npp.cd_pessoa = :cd_pessoa')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end>
    Left = 8
    Top = 440
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
