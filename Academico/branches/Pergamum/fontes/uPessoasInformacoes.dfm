  object qryPessoasInfoFiltrar: TUMZQuery
    Connection = DM.db
    AfterOpen = qryPessoasInfoFiltrarAfterOpen
    SQL.Strings = (
      'SELECT'
      '  pi.cd_informacao,'
      #9'pi.ds_informacao,'
      #9'pi.nm_pessoa,'
      #9'pi.ds_contatos,'
      #9'pi.dt_informacao,'
      #9'pi.cd_origem,'
      #9'pi.cd_turma,'
      #9'pi.ds_obs1,'
      #9'pi.ds_obs2,'
      #9'pi.ds_obs3,'
      #9'pi.ds_telefone2,'
      #9'pi.ds_telefone3,'
      #9'pi.ds_telefone4,'
      #9'pi.ds_email,'
      #9'pi.cd_coligada,'
      #9'pi.nm_usuario,'
      #9'pi.cd_pessoa,'
      #9'pi.ds_cidade,'
      #9'pi.ds_bairro,'
      #9'pi.ds_cep,'
      #9'pi.ds_endereco_nro,'
      #9'pi.ds_uf,'
      #9'pi.ds_status,'
      #9's.ds_sigla,'
      #9'p.nm_pessoa AS nm_consultor,'
      #9'c.nm_coligada,'
      #9'pi.cd_consultor AS cd_consultor,'
      #9'pi.ds_status,'
      #9'pi.ds_area_assunto,'
      #9'pi.ds_curso,'
      #9'pi.ds_endereco,'
      #9'pi.dt_retorno,'
      '                pi.cd_conhecimento'
      'FROM'
      #9'pessoas_info pi'
      'LEFT JOIN pessoas p ON ('
      #9'pi.cd_consultor = p.cd_pessoa'
      ')'
      'LEFT JOIN coligadas c ON ('
      #9'pi.cd_coligada = c.cd_coligada'
      ')'
      'LEFT JOIN situacoes s On ('
      
        's.cd_modulo = 1035 AND s.cd_auxiliar = 1 AND s.ds_valor = pi.ds_' +
        'status'
      ')'
      'GROUP BY'
      #9'pi.cd_informacao'
      'ORDER BY'
      #9'cd_informacao;')
    Params = <>
    Left = 8
    Top = 312
