  object tblGrade: TUMZQuery
    Connection = DM.db
    OnCalcFields = tblGradeCalcFields
    SQL.Strings = (
      'SELECT t.anosemestre AnoSemestre'
      '     , gr.cd_curso Curso'
      #9'  , gr.cd_disciplina Disciplina'
      #9'  , gr.nr_serie Serie'
      #9'  , d.Sigla Sigla'
      #9'  , d.Descricao Descricao'
      #9'  , gr.NR_AULAS NumeroAulas'
      #9'  , t.Grau Grau'
      #9'  , t.Codigo CodigoTurma'
      #9'  , t.cd_grade cd_grade'
      '                  , t.turno turno'
      '                  , gr.sn_optativa'
      '                 , gr.NR_SERIE'
      'FROM '
      'grades_disciplinas gr INNER JOIN Turmas t '
      '                          ON  (gr.cd_curso = t.curso'
      #9#9#9#9#9#9#9#9' AND gr.nr_serie = t.serie '
      #9#9#9#9#9#9#9#9' AND gr.cd_grade = t.cd_grade ) '
      ''
      
        'INNER JOIN  disciplinas d ON (gr.cd_disciplina = d.codigo and gr' +
        '.cd_curso = d.Curso)'
      'WHERE '
      't.Codigo = :Turma and'
      't.AnoSemestre = :AnoSemestre '
      'ORDER BY d.Ordem, d.Descricao')
    Params = <
      item
        DataType = ftString
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end>
    Left = 432
    Top = 136
    ParamData = <
      item
        DataType = ftString
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'AnoSemestre'
        ParamType = ptUnknown
      end>
