  object qyRestricaoDisp: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  T.CURSO CD_CURSO,'
      '  T.CODIGO CD_TURMA,'
      '  D.CODIGO CD_DISCIPLINA,'
      '  D.DESCRICAO NM_DISCIPLINA,'
      '  G.NR_AULAS,'
      '  G.CD_GRADE,'
      '  G.NR_SERIE NR_ETAPA,'
      '  T.GRAU NR_GRAU,'
      '  G.SN_OPTATIVA,'
      '  CASE WHEN G.SN_OPTATIVA = 0 THEN'
      
        '    CAST(FCD_GET_RESTRICAO_DISCIPLINA(:CD_PESSOA, T.CURSO, T.COD' +
        'IGO, D.CODIGO, T.SERIE, G.CD_GRADE, :NR_ANOSEMESTRE, :SN_MOSTRA_' +
        'DISCIPLINAS_HORARIOS) AS CHAR)'
      '  ELSE'
      '    0'
      '  END NR_RESTRICAO'
      'FROM '
      '  TURMAS T'
      '  INNER JOIN GRADES_DISCIPLINAS G ON ('
      '      T.CURSO = G.CD_CURSO AND'
      '      T.CD_GRADE = G.CD_GRADE AND'
      '      T.SERIE = G.NR_SERIE'
      '  )'
      '  INNER JOIN DISCIPLINAS D ON ('
      '      D.CURSO = T.CURSO AND'
      '      D.CODIGO = G.CD_DISCIPLINA'
      '  )'
      'WHERE'
      
        '  ((T.ANOSEMESTRE = :NR_ANOSEMESTRE AND :SN_USA_ANOSEMESTRE) OR ' +
        '(NOT :SN_USA_ANOSEMESTRE))'
      '  AND T.CURSO LIKE :CURSO AND T.CD_COLIGADA IN (:CD_COLIGADA)'
      ''
      ' AND G.NR_SERIE <> -100'
      ' AND T.DATAFIM > :DT_FIM'
      ' AND T.CODIGO = :TURMA'
      ' AND D.CODIGO = :DISCIPLINA')
    Params = <
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SN_MOSTRA_DISCIPLINAS_HORARIOS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SN_USA_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_COLIGADA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DT_FIM'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disciplina'
        ParamType = ptUnknown
      end>
    Left = 264
    Top = 192
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CD_PESSOA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'NR_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SN_MOSTRA_DISCIPLINAS_HORARIOS'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SN_USA_ANOSEMESTRE'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CURSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_COLIGADA'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'DT_FIM'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disciplina'
        ParamType = ptUnknown
