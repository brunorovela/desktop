  object qyHorarios: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   th.*, h.*'
      'FROM'
      '   fichaindividual fi'
      
        '   INNER JOIN turmas_horarios th ON (fi.anosemestre = th.anoseme' +
        'stre) AND (fi.turma = th.turma) AND (fi.disciplina = th.discipli' +
        'na)'
      #9'INNER JOIN horarios as h ON (h.codigo = th.cd_horario)'
      'WHERE'
      '   fi.anosemestre = :anosem'
      '   AND fi.curso = :curso'
      '   AND fi.turma = :turma'
      '   AND fi.disciplina = :disciplina')
    Params = <
      item
        DataType = ftUnknown
        Name = 'anosem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disciplina'
        ParamType = ptUnknown
      end>
    Left = 496
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'anosem'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'disciplina'
        ParamType = ptUnknown
      end>
