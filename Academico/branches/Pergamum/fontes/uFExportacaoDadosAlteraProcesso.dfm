  object qyProcesso: TUMZQuery
    Connection = DM.db
    AfterEdit = qyProcessoAfterEdit
    BeforePost = qyProcessoBeforePost
    SQL.Strings = (
      'SELECT'
      '  cd_processo,'
      '  cd_layout,'
      '  ds_processo,'
      '  me_edital,'
      '  dt_processo'
      'FROM'
      '  expo_processos'
      'WHERE'
      '  cd_processo = :cd_processo')
