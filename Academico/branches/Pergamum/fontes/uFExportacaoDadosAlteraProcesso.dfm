  object qyLayouts: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  cd_layout, ds_layout'
      'FROM'
      '  expo_layouts'
      'WHERE'
      '  sn_ativo = 1 AND sn_exportacao = 1'
      'ORDER BY'
      '  ds_layout')
