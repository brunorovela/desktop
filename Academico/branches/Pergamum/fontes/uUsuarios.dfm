  object qryDeleteModulos: TUMZQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'oracle=DELETE'#13#10'FROM'#13#10#9'MODULOS M '#13#10'WHERE NOT EXISTS'#13#10'  ('#13#10#9#9'SELEC' +
        'T'#13#10#9#9#9'*'#13#10#9#9'FROM'#13#10'       RELATORIOS R'#13#10#9#9'WHERE'#13#10#9#9#9'M.MODULO = R.D' +
        'S_GRUPO '#13#10#13#10#13#10#9') AND M.CATEGORIA = '#39'Impress'#227'o'#39'  '
      
        'mysql-5=DELETE '#13#10'   mu.*, m.* '#13#10'FROM'#13#10'   modulosusuarios AS mu '#13 +
        #10'   JOIN modulos AS m ON(mu.codigomodulo = m.codigo) '#13#10'   LEFT J' +
        'OIN relatorios AS r ON(m.modulo = r.ds_grupo) '#13#10'WHERE '#13#10'   m.cat' +
        'egoria = "Impress'#227'o" AND '#13#10'   r.cd_relatorio IS NULL;')
    Left = 216
    Top = 216
  end
  object qryDeleteModUsuarios: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'DELETE FROM MODULOSUSUARIOS'
      'WHERE'
      '   CODIGOMODULO IN'
      '   ('
      '      SELECT'
      '         M.CODIGO'
      '      FROM'
      '         MODULOS'
      '            LEFT JOIN RELATORIOS R ON'
      '               (M.MODULO = R.DS_GRUPO)'
      '      WHERE'
      '         M.CATEGORIA = '#39'Impress'#227'o'#39' AND'
      '         R.CD_RELATORIO IS NULL'
      '   )')
    Params = <>
    SQLList.Strings = (
      
        'oracle=DELETE'#13#10'FROM'#13#10#9'MODULOS M '#13#10'WHERE NOT EXISTS'#13#10'  ('#13#10#9#9'SELEC' +
        'T'#13#10#9#9#9'*'#13#10#9#9'FROM'#13#10'       RELATORIOS R'#13#10#9#9'WHERE'#13#10#9#9#9'M.MODULO = R.D' +
        'S_GRUPO '#13#10#13#10#13#10#9') AND M.CATEGORIA = '#39'Impress'#227'o'#39'  '
      
        'mysql-5=DELETE '#13#10'   mu.*, m.* '#13#10'FROM'#13#10'   modulosusuarios AS mu '#13 +
        #10'   JOIN modulos AS m ON(mu.codigomodulo = m.codigo) '#13#10'   LEFT J' +
        'OIN relatorios AS r ON(m.modulo = r.ds_grupo) '#13#10'WHERE '#13#10'   m.cat' +
        'egoria = "Impress'#227'o" AND '#13#10'   r.cd_relatorio IS NULL;')
    Left = 256
    Top = 216
  end
  object qryInserePermissoes: TUMZQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'mysqld-5=INSERT IGNORE INTO modulosusuarios (codigousuario, codi' +
        'gomodulo, acessar) '#13#10'            SELECT  '#13#10'               u.codi' +
        'go codigousuario, '#13#10'               m.codigo codigomodulo, '#13#10'    ' +
        '           '#39'S'#39' AS acessar  '#13#10'            FROM  '#13#10'               ' +
        'usuarios AS u JOIN modulos AS m  '#13#10'                  JOIN relato' +
        'rios AS r ON(m.modulo = r.ds_grupo)  '#13#10'            WHERE  '#13#10'    ' +
        '           m.categoria = '#39'Impress'#227'o'#39'  '#13#10'            GROUP BY  '#13#10 +
        '               u.codigo, m.codigo  '#13#10'            ORDER BY  '#13#10'   ' +
        '            m.codigo;'#13#10
      
        'oracle=MERGE INTO modulosusuarios mu USING('#13#10'      SELECT  '#13#10'   ' +
        '      u.codigo codigousuario, '#13#10'         m.codigo codigomodulo, ' +
        #13#10'         '#39'S'#39' AS acessar  '#13#10'      FROM  '#13#10'         usuarios u, ' +
        #13#10#9#9#9'modulos  m  '#13#10'         JOIN relatorios  r ON(m.modulo = r.d' +
        's_grupo)  '#13#10'      WHERE  '#13#10'         m.categoria = '#39'Impress'#227'o'#39'  '#13 +
        #10'      GROUP BY  '#13#10'         u.codigo, m.codigo ) ins ON (mu.codi' +
        'gousuario = ins.codigousuario AND  mu.codigomodulo = ins.codigom' +
        'odulo)'#13#10'      WHEN NOT MATCHED THEN '#13#10'      INSERT (codigousuari' +
        'o, codigomodulo, acessar) VALUES (ins.codigousuario ,ins.codigom' +
        'odulo , ins.acessar)'#13#10#9#9#9#9#9)
    Left = 256
    Top = 248
  end
  object qryInserePermNulas: TUMZQuery
    Connection = DM.db
    Params = <>
    SQLList.Strings = (
      
        'mysql-5=INSERT IGNORE INTO modulosusuarios('#13#10'   codigomodulo,'#13#10' ' +
        '  codigousuario,'#13#10'   incluir,'#13#10'   alterar,'#13#10'   deletar,'#13#10'   aces' +
        'sar,'#13#10'   especial'#13#10')SELECT'#13#10'   M.codigo,'#13#10'   U.codigo,'#13#10'   "N",'#13 +
        #10'   "N",'#13#10'   "N",'#13#10'   "N",'#13#10'   "N"'#13#10'FROM'#13#10'   usuarios AS U,'#13#10'   ' +
        'modulos AS M'
      
        'oracle=MERGE INTO modulosusuarios mu USING('#13#10#9'SELECT'#13#10#9#9'U.codigo' +
        ' as codigomodulo,'#13#10#9#9'M.codigo as codigousuario,'#13#10#9#9#39'N'#39' n1,'#13#10#9#9#39'N' +
        #39' n2,'#13#10#9#9#39'N'#39' n3,'#13#10#9#9#39'N'#39' n4,'#13#10#9#9#39'N'#39' n5'#13#10#9'FROM'#13#10#9#9'USUARIOS U,'#13#10#9#9'M' +
        'ODULOS M'#13#10') ins ON ( ins.codigomodulo = mu.codigomodulo AND mu.c' +
        'odigousuario =  ins.codigousuario )'#13#10'WHEN NOT MATCHED THEN '#13#10#9'IN' +
        'SERT (codigomodulo,codigousuario,incluir,alterar,deletar,acessar' +
        ',especial) VALUES (ins.codigomodulo , ins.codigousuario , ins.n1' +
        ' , ins.n2 , ins.n3 , ins.n4 , ins.n5 )')
    Left = 296
    Top = 216
  end
  object qryInsPermNovoUsuario: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'INSERT INTO modulosusuarios('
      '   codigousuario,'
      '   codigomodulo,'
      '   incluir,'
      '   alterar,'
      '   deletar,'
      '   acessar,'
      '   especial'
      ')'
      'VALUES'
      '('
      '   :usuario,'
      '   :modulo,'
      '   '#39'N'#39','
      '   '#39'N'#39','
      '   '#39'N'#39','
      '   '#39'N'#39','
      '   '#39'N'#39
      ')')
    Params = <
      item
        DataType = ftUnknown
        Name = 'usuario'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'modulo'
        ParamType = ptUnknown
      end>
    Left = 296
    Top = 248
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'usuario'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'modulo'
        ParamType = ptUnknown
      end>
  end
  object qryMax: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT CAST(MAX(CODIGO) AS NUMBER(19)) AS Max FROM Usuarios')
    Params = <>
    SQLList.Strings = (
      
        'oracle=SELECT CAST(MAX(CODIGO) AS NUMBER(19)) AS Max FROM Usuari' +
        'os'
      'mysql-5=SELECT CAST(MAX(CODIGO) AS SIGNED) AS Max FROM USUARIOS')
    Left = 216
    Top = 248
    object qryMaxMAX: TLargeintField
      FieldName = 'Max'
      ReadOnly = True
    end
  end
