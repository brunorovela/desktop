  object tblListaModulos: TUMZQuery
    Connection = DM.db
    CachedUpdates = True
    AfterPost = tblModulosUsuariosAfterPost
    SQL.Strings = (
      'select MU.*, M.*  from ModulosUsuarios MU, Modulos M'
      'where  MU.CodigoModulo = M.Codigo AND '
      'MU.CodigoUsuario = :Codigo'
      'ORDER BY M.Categoria, M.Modulo'
      '')
    Params = <
      item
        DataType = ftUnknown
        Name = 'Codigo'
        ParamType = ptUnknown
      end>
    DataSource = dtcUsuarios
    Left = 120
    Top = 216
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Codigo'
        ParamType = ptUnknown
      end>
    object tblListaModulosCodigoUsuario: TIntegerField
      FieldName = 'CodigoUsuario'
      Origin = 'WMESTRE12.ModulosUsuarios.CodigoUsuario'
    end
