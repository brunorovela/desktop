  object qyProcesso: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  cd_processo,'
      #9'cd_layout,'
      #9'nr_ano,'
      '  cd_coligada,'
      '  sn_bloqueado,'
      #9'dt_ultima_exportacao,'
      #9'dt_ultima_atualizacao,'
      #9'dt_ultimo_bloqueio'
      'FROM'
      '  cen_processos'
      'WHERE'
      '  nr_ano = :nr_ano AND'
      '  cd_coligada = :cd_coligada  ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_ano'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
    Left = 16
    Top = 144
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_ano'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
  end
  object qyCriarProcesso: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      
        'INSERT INTO cen_processos (nr_ano, cd_coligada) VALUES (:nr_ano,' +
        ' :cd_coligada);')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_ano'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
    Left = 51
    Top = 144
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_ano'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'cd_coligada'
        ParamType = ptUnknown
      end>
  end
