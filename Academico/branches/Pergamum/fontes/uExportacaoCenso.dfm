  object qyMatriculas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  cem.cd_matricula,'
      '  cem.nr_ano,'
      '  cem.cd_curso,'
      '  cm.ds_curso,'
      '  cem.cd_curso_origem,'
      '  cmo.ds_curso ds_curso_origem,'
      '  cem.nr_anosemestre,'
      '  p.cd_pessoa,'
      '  p.nm_pessoa,'
      '  cem.sn_bloqueado,'
      '  cms.ds_status,'
      '  cem.sn_enviar,'
      '  sm.cd_situacao,'
      '  sm.ds_situacao,'
      '  cem.dt_saida,'
      '  cem.cd_processo,'
      '  cem.cd_turma_matricula,'
      '  cem.cd_situacao_mec,'
      '  cem.cd_status,'
      
        '  CASE WHEN cem.sn_bloqueado = 1 THEN '#39'X'#39' ELSE '#39#39' END sn_bloquea' +
        'do_col'
      'FROM'
      '  cen_matriculas cem'
      '  INNER JOIN pessoas p ON (p.cd_pessoa = cem.cd_pessoa)'
      '  INNER JOIN cursos_mestre cm ON (cm.cd_curso = cem.cd_curso)'
      
        '  INNER JOIN cen_matriculas_status cms ON (cms.cd_status = cem.c' +
        'd_status)'
      
        '  INNER JOIN cen_situacoes_mec sm ON (cem.cd_situacao_mec = sm.c' +
        'd_situacao)'
      
        '  LEFT JOIN cursos_mestre cmo ON (cmo.cd_curso = cem.cd_curso_or' +
        'igem)'
      'WHERE'
      '  nr_ano = :nr_ano'
      'ORDER BY'
      '  p.nm_pessoa ASC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nr_ano'
        ParamType = ptUnknown
      end>
    Left = 184
    Top = 144
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nr_ano'
        ParamType = ptUnknown
      end>
    object qyMatriculascd_matricula: TIntegerField
      FieldName = 'cd_matricula'
    end
    object qyMatriculasnr_ano: TIntegerField
      FieldName = 'nr_ano'
    end
    object qyMatriculascd_curso: TStringField
      FieldName = 'cd_curso'
      Size = 15
    end
    object qyMatriculasds_curso: TStringField
      FieldName = 'ds_curso'
      Size = 255
    end
    object qyMatriculascd_curso_origem: TStringField
      FieldName = 'cd_curso_origem'
      Size = 15
    end
    object qyMatriculasds_curso_origem: TStringField
      FieldName = 'ds_curso_origem'
      Size = 255
    end
    object qyMatriculasnr_anosemestre: TIntegerField
      FieldName = 'nr_anosemestre'
    end
    object qyMatriculascd_pessoa: TIntegerField
      FieldName = 'cd_pessoa'
    end
    object qyMatriculasnm_pessoa: TStringField
      FieldName = 'nm_pessoa'
      Size = 60
    end
    object qyMatriculassn_bloqueado: TSmallintField
      FieldName = 'sn_bloqueado'
    end
    object qyMatriculasds_status: TStringField
      FieldName = 'ds_status'
      Size = 255
    end
    object qyMatriculassn_enviar: TSmallintField
      FieldName = 'sn_enviar'
    end
    object qyMatriculascd_situacao: TIntegerField
      FieldName = 'cd_situacao'
    end
    object qyMatriculasds_situacao: TStringField
      FieldName = 'ds_situacao'
      Size = 255
    end
    object qyMatriculasdt_saida: TDateTimeField
      FieldName = 'dt_saida'
