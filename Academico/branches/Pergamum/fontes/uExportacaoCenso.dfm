  object qyLogs: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  l.dt_log,'
      '  p.ds_login,'
      '  l.ds_log_resumo'
      'FROM'
      '  cen_logs l'
      '  INNER JOIN pessoas p ON (p.cd_pessoa = l.cd_pessoa)'
      'WHERE'
      '  l.ds_chave LIKE :ds_chave'
      'ORDER BY'
      '  l.dt_log ASC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'ds_chave'
        ParamType = ptUnknown
      end>
    Left = 856
    Top = 392
