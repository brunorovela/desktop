  object qyProfissoes: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'cd_opcao,'
      #9'cd_campo,'
      #9'ds_opcao'
      'FROM'
      #9'pessoas_campos_adicionais_opc'
      'WHERE'
      #9'ds_opcao IS NOT NULL'
      'ORDER BY'
      '                ds_opcao  ')
    Params = <>
    Left = 152
    Top = 280
    object qyProfissoesCD_OPCAO: TIntegerField
      FieldName = 'CD_OPCAO'
    end
    object qyProfissoesCD_CAMPO: TIntegerField
      FieldName = 'CD_CAMPO'
    end
    object qyProfissoesDS_OPCAO: TStringField
      FieldName = 'DS_OPCAO'
      Size = 256
    end
  end
  object dsProfissoes: TDataSource
    DataSet = qyProfissoes
    OnStateChange = dsProfissoesStateChange
    Left = 184
    Top = 280
  end
  object qyRetornaCodCampo: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      '  CD_CAMPO'
      'FROM '
      '  PESSOAS_CAMPOS_ADICIONAIS'
      'WHERE '
      '  DS_CHAVE = "profissao"')
    Params = <>
    Left = 120
    Top = 280
    object qyRetornaCodCampoCD_CAMPO: TIntegerField
      FieldName = 'CD_CAMPO'
    end
  end
