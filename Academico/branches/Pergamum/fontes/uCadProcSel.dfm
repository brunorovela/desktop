  object qyDisc: TUMZQuery
    Connection = DM.db
    OnNewRecord = qyDiscNewRecord
    SQL.Strings = (
      'SELECT'
      '   pspd.cd_proc_sel,'
      '   pspd.cd_disc,'
      '   pspd.cd_curso,'
      '   d.sigla AS ds_sigla,'
      '   d.descricao AS ds_disc,'
      '   pspd.ds_titulacao_minima,'
      '   pspd.sn_matutino,'
      '   pspd.sn_vespertino,'
      '   pspd.sn_noturno'
      'FROM'
      '   proc_sel_prof_disc pspd'
      
        '      INNER JOIN disciplinas d ON (pspd.cd_disc = d.codigo AND p' +
        'spd.cd_curso = d.curso)'
      
        '      INNER JOIN proc_sel_areas_disc psad ON (pspd.cd_disc = psa' +
        'd.cd_disc AND pspd.cd_curso = psad.cd_curso)'
      
        '      INNER JOIN proc_sel_prof_areas pspa ON (psad.cd_area = psp' +
        'a.cd_area)'
      'WHERE'
      '   pspa.cd_area = :cd_area AND'
      '   pspa.cd_proc_sel = :cd_proc_sel AND'
      '   pspa.cd_proc_sel = pspd.cd_proc_sel'
      'ORDER BY'
      '   d.descricao')
    Params = <
      item
        DataType = ftString
        Name = 'cd_area'
        ParamType = ptUnknown
        Size = 16
      end
      item
        DataType = ftInteger
        Name = 'cd_proc_sel'
        ParamType = ptUnknown
        Size = 4
      end>
    DataSource = srcAreas
    Left = 264
    Top = 48
    ParamData = <
      item
        DataType = ftString
        Name = 'cd_area'
        ParamType = ptUnknown
        Size = 16
      end
      item
        DataType = ftInteger
        Name = 'cd_proc_sel'
        ParamType = ptUnknown
        Size = 4
      end>
    object qyDisccd_proc_sel: TIntegerField
      FieldName = 'cd_proc_sel'
    end
    object qyDisccd_disc: TIntegerField
      FieldName = 'cd_disc'
    end
    object qyDisccd_curso: TStringField
      FieldName = 'cd_curso'
      Size = 15
    end
    object qyDiscds_sigla: TStringField
      FieldName = 'ds_sigla'
      Size = 5
    end
    object qyDiscds_disc: TStringField
      FieldName = 'ds_disc'
      Size = 100
    end
    object qyDiscds_titulacao_minima: TMemoField
      FieldName = 'ds_titulacao_minima'
      BlobType = ftMemo
      Size = 1
    end
    object qyDiscsn_matutino: TStringField
      FieldName = 'sn_matutino'
      FixedChar = True
      Size = 1
    end
    object qyDiscsn_vespertino: TStringField
      FieldName = 'sn_vespertino'
      FixedChar = True
      Size = 1
    end
    object qyDiscsn_noturno: TStringField
      FieldName = 'sn_noturno'
      FixedChar = True
      Size = 1
    end
  end
