  object qyAreas: TUMZQuery
    Connection = DM.db
    AfterInsert = qyAreasAfterInsert
    SQL.Strings = (
      'SELECT '
      '   psa.cd_area,'
      '   psa.ds_area,'
      '   pspa.ds_tema,'
      '   pspa.cd_proc_sel'
      'FROM'
      '   proc_sel_areas psa'
      
        '      INNER JOIN proc_sel_prof_areas pspa ON (psa.cd_area = pspa' +
        '.cd_area)'
      'WHERE'
      '   pspa.cd_proc_sel = :cd_proc_sel'
      'ORDER BY'
      '   pspa.cd_area')
    Params = <
      item
        DataType = ftInteger
        Name = 'cd_proc_sel'
        ParamType = ptUnknown
        Size = 4
      end>
    DataSource = srcProcSel
    Left = 132
    Top = 49
    ParamData = <
      item
        DataType = ftInteger
        Name = 'cd_proc_sel'
        ParamType = ptUnknown
        Size = 4
      end>
    object qyAreascd_area: TStringField
      FieldName = 'cd_area'
      Origin = 'WMESTRE12.proc_sel_areas.cd_area'
      Size = 15
    end
    object qyAreasds_area: TStringField
      FieldName = 'ds_area'
      Origin = 'WMESTRE12.proc_sel_areas.ds_area'
      Size = 100
    end
    object qyAreasds_tema: TStringField
      FieldName = 'ds_tema'
      Origin = 'WMESTRE12.proc_sel_prof_areas.ds_tema'
      Size = 255
    end
    object qyAreascd_proc_sel: TIntegerField
