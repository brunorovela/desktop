  object qyAux: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT '
      #9'DISTINCT gd.cd_grade, gd.curso, gd.anosemestre'
      'FROM'
      '  gradecurricular gd'
      
        '  INNER JOIN disciplinas_equiv_interna dei ON (gd.cd_grade = dei' +
        '.cd_grade) AND (gd.curso = dei.cd_curso) AND (gd.disciplina = de' +
        'i.cd_disciplina)'
      'WHERE'
      #9'dei.cd_grupo = :grupo'
      'ORDER BY'
      #9'gd.anosemestre DESC'
      'LIMIT 1')
    Params = <
      item
        DataType = ftUnknown
        Name = 'grupo'
        ParamType = ptUnknown
      end>
    Left = 712
    Top = 40
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'grupo'
        ParamType = ptUnknown
      end>
  end
