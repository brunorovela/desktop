  object qyEquivalencias: TUMZQuery
    Connection = DM.db
    SortType = stIgnored
    SQL.Strings = (
      'SELECT'
      #9' * '
      'FROM'
      #9' disciplinas_equiv_interna equivalencia '
      'INNER JOIN disciplinas d_equivalencia ON('
      #9'd_equivalencia.codigo = equivalencia.cd_disciplina'
      #9'AND d_equivalencia.curso = equivalencia.cd_curso'
      ')'
      'INNER JOIN cursos cu_eqvlc ON('
      #9'cu_eqvlc.codigo = equivalencia.cd_curso'
      ')'
      'INNER JOIN disciplinas_equiv_grupos eg ON('
      #9'equivalencia.cd_grupo = eg.cd_grupo1'
      ')'
      'INNER JOIN disciplinas_equiv_interna equivalente ON('
      #9'equivalente.cd_grupo = eg.cd_grupo2'
      ')'
      'INNER JOIN disciplinas d_equivalente ON('
      #9'd_equivalente.codigo = equivalente.cd_disciplina'
      #9'AND d_equivalente.curso = equivalente.cd_curso'
      ')'
      'INNER JOIN cursos cu_eqvlt ON('
      #9'cu_eqvlt.codigo = equivalente.cd_curso'
      ')'
      '%FILTRO%')
    Params = <>
    WhereMode = wmWhereAll
    SQLList.Strings = (
      
        'oracle=SELECT '#13#10#9'eg.cd_equivalencia_grupo,'#9#13#10#9'CAST(FIRST_OCCURRE' +
        'NCE(eg.cd_grupo1) AS NUMBER(19)) cd_grupo1, '#13#10#9'CAST(FIRST_OCCURR' +
        'ENCE(eg.cd_grupo2) AS NUMBER(19)) cd_grupo2,'#13#10#9'CAST(FIRST_OCCURR' +
        'ENCE(equivalencia.cd_grade) AS NUMBER(19)) cd_grade_eqvlc,      ' +
        '                                '#13#10#9'FIRST_OCCURRENCE(equivalencia' +
        '.cd_curso) cd_curso_eqvlc,'#13#10#9'FIRST_OCCURRENCE(cu_eqvlc.ds_apelid' +
        'o) ds_curso_eqvlc,'#13#10#9'CAST(FIRST_OCCURRENCE(equivalente.cd_grade)' +
        ' AS NUMBER(19)) cd_grade_eqvlt,'#13#10#9'FIRST_OCCURRENCE(DISTINCT cu_e' +
        'qvlt.ds_apelido) ds_curso_eqvlt,'#13#10#9'FIRST_OCCURRENCE(equivalente.' +
        'cd_curso) cd_curso_eqvlt,'#13#10#9'REPLACE(GROUP_CONCAT( DISTINCT d_equ' +
        'ivalente.descricao ), '#39','#39', '#39'/'#39') ds_disc_eqvltX,'#13#10#9'REPLACE(GROUP_' +
        'CONCAT( DISTINCT d_equivalencia.descricao ), '#39','#39', '#39'/'#39') ds_disc_e' +
        'qvlcX,'#13#10#9'SUBSTR(REPLACE(GROUP_CONCAT( DISTINCT d_equivalente.des' +
        'cricao ), '#39','#39', '#39'/'#39'), 1, 250) ds_disc_eqvlt, '#13#10#9'SUBSTR(REPLACE(GR' +
        'OUP_CONCAT( DISTINCT d_equivalencia.descricao ), '#39','#39', '#39'/'#39'), 1, 2' +
        '50) ds_disc_eqvlc'#13#10'FROM '#13#10#9'disciplinas_equiv_interna equivalenci' +
        'a '#13#10#9'INNER JOIN disciplinas d_equivalencia ON (d_equivalencia.co' +
        'digo = equivalencia.cd_disciplina AND d_equivalencia.curso = equ' +
        'ivalencia.cd_curso)'#13#10#9'INNER JOIN cursos_mestre cu_eqvlc ON (cu_e' +
        'qvlc.CD_CURSO = equivalencia.cd_curso)'#13#10#9'INNER JOIN disciplinas_' +
        'equiv_grupos eg ON (equivalencia.cd_grupo = eg.cd_grupo1) '#13#10#9'INN' +
        'ER JOIN disciplinas_equiv_interna equivalente ON (equivalente.cd' +
        '_grupo = eg.cd_grupo2)'#13#10#9'INNER JOIN disciplinas d_equivalente ON' +
        ' (d_equivalente.codigo = equivalente.cd_disciplina AND d_equival' +
        'ente.curso = equivalente.cd_curso)'#13#10#9'INNER JOIN cursos_mestre cu' +
        '_eqvlt ON (cu_eqvlt.CD_CURSO = equivalente.cd_curso)'#13#10'%FILTRO%'#13#10 +
        'GROUP BY '#13#10'   eg.cd_equivalencia_grupo'
      
        'mysql-5=SELECT'#13#10'   d_equivalencia.codigo as cd_disciplina,'#13#10'   d' +
        '_equivalencia.sigla,'#13#10'   d_equivalente.codigo as cd_disciplina_1' +
        ','#13#10'   d_equivalente.sigla,    '#13#10'   eg.cd_equivalencia_grupo, '#13#10' ' +
        '  eg.cd_grupo1, eg.cd_grupo2,'#13#10#9'equivalencia.cd_grade cd_grade_e' +
        'qvlc, '#13#10#9'equivalencia.cd_curso cd_curso_eqvlc, '#13#10#9'cu_eqvlc.ds_ap' +
        'elido ds_curso_eqvlc,   '#13#10'   (GROUP_CONCAT( DISTINCT d_equivalen' +
        'te.descricao ORDER BY d_equivalente.descricao SEPARATOR '#39'/'#39' )) d' +
        's_disc_eqvltX,'#13#10#9'(GROUP_CONCAT( DISTINCT d_equivalencia.descrica' +
        'o ORDER BY d_equivalencia.descricao SEPARATOR '#39'/'#39' )) ds_disc_eqv' +
        'lcX,'#13#10#9'LEFT((GROUP_CONCAT( DISTINCT d_equivalente.descricao ORDE' +
        'R BY d_equivalente.descricao SEPARATOR '#39'/'#39' )), 250) ds_disc_eqvl' +
        't, '#13#10#9'LEFT((GROUP_CONCAT( DISTINCT d_equivalencia.descricao ORDE' +
        'R BY d_equivalencia.descricao SEPARATOR '#39'/'#39' )), 250) ds_disc_eqv' +
        'lc,'#13#10'  '#9'equivalente.cd_grade cd_grade_eqvlt, '#13#10#9'equivalente.cd_c' +
        'urso cd_curso_eqvlt, '#13#10#9'cu_eqvlt.ds_apelido ds_curso_eqvlt'#13#10'FROM' +
        ' '#13#10'   disciplinas_equiv_interna equivalencia '#13#10'   INNER JOIN dis' +
        'ciplinas d_equivalencia ON (d_equivalencia.codigo = equivalencia' +
        '.cd_disciplina AND d_equivalencia.curso = equivalencia.cd_curso)' +
        #13#10'   INNER JOIN cursos_mestre cu_eqvlc ON (cu_eqvlc.CD_CURSO = e' +
        'quivalencia.cd_curso)'#13#10'   INNER JOIN disciplinas_equiv_grupos eg' +
        ' ON (equivalencia.cd_grupo = eg.cd_grupo1) '#13#10'   INNER JOIN disci' +
        'plinas_equiv_interna equivalente ON (equivalente.cd_grupo = eg.c' +
        'd_grupo2)'#13#10'   INNER JOIN disciplinas d_equivalente ON (d_equival' +
        'ente.codigo = equivalente.cd_disciplina AND d_equivalente.curso ' +
        '= equivalente.cd_curso)'#13#10'   INNER JOIN cursos_mestre cu_eqvlt ON' +
        ' (cu_eqvlt.CD_CURSO = equivalente.cd_curso)'#13#10'%FILTRO%'#13#10'GROUP BY ' +
        #13#10'   eg.cd_equivalencia_grupo')
    Left = 712
    Top = 80
    object qyEquivalenciascd_curso_eqvlc: TStringField
      Tag = 1
      DisplayLabel = 'Curso'
      DisplayWidth = 10
      FieldName = 'cd_curso_eqvlc'
      Size = 15
