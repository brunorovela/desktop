  object qyDisciplinasGenericas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  gd.nr_serie,'
      '  gd.cd_disciplina cd_disciplina_generica,'
      #9'dg.descricao ds_disciplina_generica,'
      '  fio.disciplina cd_disciplina_optativa,'
      
        #9'CASE WHEN fio.disciplina IS NOT NULL THEN CONCAT('#39'Disciplina ge' +
        'n'#233'rica de "['#39',dop.codigo,'#39'] '#39', dop.descricao, '#39'" na '#39',fio.serie,' +
        ' '#39#170' fase.'#39') ELSE '#39#39' END ds_vinculo'
      'FROM'
      #9'matriculas m'
      #9'INNER JOIN matriculas_curso mc ON ('
      #9#9'm.cd_matricula_curso = mc.cd_matricula_curso'
      #9')'
      #9'INNER JOIN grades_disciplinas gd ON ('
      #9#9'gd.cd_grade = mc.cd_grade AND'
      #9#9'gd.cd_curso = m.curso AND'
      #9#9'gd.sn_optativa = 1'
      #9')'
      '  INNER JOIN disciplinas dg ON ('
      '    dg.codigo = gd.cd_disciplina AND'
      '    dg.curso = gd.cd_curso'
      '  )'
      #9'LEFT JOIN fichaindividual_optativas fio ON ('
      #9#9'fio.codigoaluno = :codigoaluno AND'
      #9#9'fio.cd_disciplina_generica = gd.cd_disciplina AND'
      '    fio.anosemestre = m.anosemestre'
      #9')'
      '  LEFT JOIN disciplinas dop ON ('
      #9#9'dop.codigo = fio.disciplina AND'
      #9#9'dop.curso = gd.cd_curso'
      #9')'
      'WHERE'
      #9'm.codigoaluno = :codaluno'
      #9'AND m.anosemestre = :anosemestre'
      #9'AND m.curso = :curso'
      #9'AND m.turma = :turma'
      'GROUP BY'
      #9'gd.cd_grade, gd.cd_curso, gd.cd_disciplina, gd.nr_serie')
    Params = <
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'curso'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end>
    Left = 312
    Top = 144
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'codaluno'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'anosemestre'
        ParamType = ptUnknown
