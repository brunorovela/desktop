package inner;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD OFF}
{%File 'consts.inc'}

requires
  rtl,
  vcl,
  ZDbc,
  ZCore,
  ZParseSql,
  core;

contains
  Inner_TLB in 'Inner_TLB.pas',
  mscorlib_TLB in 'mscorlib_TLB.pas',
  EasyInner_DLL in 'EasyInner_DLL.pas',
  UInnerClasses in 'UInnerClasses.pas';

end.
