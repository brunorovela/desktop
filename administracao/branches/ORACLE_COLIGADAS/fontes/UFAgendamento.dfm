      'das atrav'#233's do banco'#13#10'no parametro [b]Administracao.Backup.Tabel' +
      'as_Ignoradas_Backup_Otimizado[/b].'
    Titulo = 'Ajuda - Qual tipo utilizar ?'
    PanelWidth = 550
    PanelHeight = 200
  end
