  object qryConfig: TUMZQuery
    Connection = conn
    UpdateObject = qryConfigUpd
    SQL.Strings = (
      'SELECT'
      '   NM_SERVIDOR,'
      '   NM_USUARIO,'
      '   DS_SENHA,'
      '   DT_BACKUP,'
      '   HR_BACKUP,'
      '   DS_CAMINHO_BKP,'
      '   DS_BASES,'
      '   NR_INTERVALO,'
      '   NR_TIPO,'
      '   SN_ATIVO,'
      '   SN_ALTERADO,'
      '   SN_AGENDADO,'
      '   SN_BACKUP_COMPLETO,'
      '   SN_BACKUP_MONGO,'
      '   CONCAT('
      '    ROUND(('
      
        '      (select ds_valor from nu_parametros where ds_parametro lik' +
        'e '#39'%max_allowed_packet_mysqldump%'#39')/1048576), 0), '#39'MB'#39') as MAX_P' +
        'ACKET'
      'FROM'
      '   BACKUP_CONFIG'
      'WHERE'
      '   SN_AGENDADO = :agendado'
      'AND'
      '  SN_BACKUP_COMPLETO = :completo')
    Params = <
      item
        DataType = ftUnknown
        Name = 'agendado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'completo'
        ParamType = ptUnknown
      end>
    Left = 40
    Top = 128
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'agendado'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'completo'
        ParamType = ptUnknown
      end>
    object qryConfigNM_SERVIDOR: TStringField
      FieldName = 'NM_SERVIDOR'
      Required = True
      Size = 50
    end
