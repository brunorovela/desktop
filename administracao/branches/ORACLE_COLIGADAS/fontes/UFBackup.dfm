        's as tabelas do sistema '#13#10'(recomendada a utiliza'#231#227'o peri'#243'dica de' +
        'sta op'#231#227'o, garantindo o backup de todas as informa'#231#245'es '#13#10'present' +
        'es no banco de dados) '#13#10#13#10#13#10'[b]Otimizado[/b]'#13#10'Esta op'#231#227'o realiza' +
        'r'#225' um backup otimizado das informa'#231#245'es do banco de dados, ignora' +
        'ndo tabelas definidas, '#13#10'como informa'#231#245'es secund'#225'rias ou que pos' +
        'suam um maior volume para armazenamento '#13#10'(recomendada a utiliza' +
        #231#227'o di'#225'ria desta op'#231#227'o, garantindo que as informa'#231#245'es de maior r' +
        'elev'#226'ncia estejam '#13#10'sendo salvas com seguran'#231'a). '#13#10'As tabelas ig' +
        'noradas podem ser visualizadas pelo menu de agendamento e altera' +
        'das atrav'#233's do banco'#13#10'no parametro [b]Administracao.Backup.Tabel' +
        'as_Ignoradas_Backup_Otimizado[/b].'
      Titulo = 'Ajuda - Qual tipo utilizar ?'
      PanelWidth = 550
      PanelHeight = 200
    end
