  object qryAtualizacoes: TUMZQuery
    Connection = DM.connUnimestre
    SQL.Strings = (
      'SELECT'
      '   CD_ATUALIZACAO,'
      '   SN_COMPLETO'
      'FROM'
      '   ATU_ATUALIZACOES'
      'WHERE'
      '   CD_ATUALIZACAO IS NULL')
    Params = <>
    Left = 312
    Top = 56
    object qryAtualizacoesCD_ATUALIZACAO: TStringField
