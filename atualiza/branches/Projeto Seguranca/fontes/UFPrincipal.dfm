  object updComandos: TZUpdateSQL
    InsertSQL.Strings = (
      'INSERT INTO ATU_COMANDOS'
      
        '   (NR_COMANDO, CD_ATUALIZACAO, SN_SUCESSO, TX_CONTEUDO, DT_EXEC' +
        'UCAO, TX_ERRO)'
      'VALUES'
      
        '   (:NR_COMANDO, :CD_ATUALIZACAO, :SN_SUCESSO, :TX_CONTEUDO, NOW' +
        '(), :TX_ERRO)')
    UseSequenceFieldForRefreshSQL = False
    Left = 352
    Top = 88
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NR_COMANDO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'CD_ATUALIZACAO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'SN_SUCESSO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TX_CONTEUDO'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'TX_ERRO'
        ParamType = ptUnknown
      end>
  end
  object sqlInstall: TZSQLProcessor
    Params = <>
    Script.Strings = (
      'CREATE TABLE ATU_ATUALIZACOES ('
      '   CD_ATUALIZACAO CHAR(38) NOT NULL,'
      '   SN_COMPLETO TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,'
      '   CONSTRAINT PK_ATUALIZACOES PRIMARY KEY (CD_ATUALIZACAO)'
      ') ENGINE=INNODB;'
      ''
      'CREATE TABLE ATU_COMANDOS ('
      '   NR_COMANDO INTEGER UNSIGNED NOT NULL,'
      '   CD_ATUALIZACAO CHAR(38) NOT NULL,'
      '   SN_SUCESSO TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,'
      '   TX_CONTEUDO TEXT NOT NULL,'
      '   DT_EXECUCAO DATETIME NOT NULL,'
      '   TX_ERRO TEXT,'
      
        '   CONSTRAINT PK_COMANDOS PRIMARY KEY (NR_COMANDO, CD_ATUALIZACA' +
        'O)'
      ') ENGINE=INNODB;'
      ''
      'ALTER TABLE ATU_COMANDOS'
      
        '   ADD CONSTRAINT FK_CDOS_ATULIZACS_CD_ATULIZCAO FOREIGN KEY (CD' +
        '_ATUALIZACAO) REFERENCES ATU_ATUALIZACOES (CD_ATUALIZACAO);'
      ''
      'INSERT INTO ATU_ATUALIZACOES (CD_ATUALIZACAO, SN_COMPLETO)'
      'SELECT'
      '   CODIGO,'
      '   CASE ERRO'
      '      WHEN 0 THEN 1'
      '      ELSE 0'
      '   END'
      'FROM'
      '   ATUALIZACOES'
      'ORDER BY'
      '   DT_EXECUCAO')
    Connection = DM.connUnimestre
    Delimiter = ';'
    Left = 104
    Top = 120
  end
end
