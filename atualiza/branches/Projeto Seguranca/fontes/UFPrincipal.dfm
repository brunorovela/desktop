      FieldName = 'SN_COMPLETO'
      Required = True
    end
  end
  object qryComandos: TUMZQuery
    Connection = DM.connUnimestre
    UpdateObject = updComandos
    SQL.Strings = (
      'SELECT'
      '   NR_COMANDO,'
      '   CD_ATUALIZACAO,'
      '   SN_SUCESSO,'
      '   TX_CONTEUDO,'
      '   DT_EXECUCAO,'
      '   TX_ERRO'
      'FROM'
      '   ATU_COMANDOS'
