<atualizacoes><atualiza codigo="{71E596D9-9C14-432D-B4C3-717CDC6EE290}" protocolo="ansi"><![CDATA[ALTER TABLE `fin_cp_preparacao` CHANGE `cd_caixa` `cd_caixa` INT(11)  DEFAULT "0";

ALTER TABLE `fin_cp_preparacao` ADD `cd_coligada` SMALLINT(6)  UNSIGNED DEFAULT "1" AFTER `cd_caixa`;

ALTER TABLE `fin_cp_preparacao_itens` ADD `cd_coligada` SMALLINT(6)  UNSIGNED DEFAULT "1" NOT NULL AFTER `cd_titulo`;

]]></atualiza><atualiza codigo="{01FCCB0E-BAC9-4911-8EB9-151279958FFD}" protocolo="ansi"><![CDATA[DELIMITER //

DROP PROCEDURE IF EXISTS PROC_DEFINE_ORDEM_GABARITOS//

SET GLOBAL log_bin_trust_function_creators=1//

CREATE PROCEDURE `PROC_DEFINE_ORDEM_GABARITOS`()
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
    drop temporary table if exists tmp_pint_gabarito_pessoa;
    create temporary table tmp_pint_gabarito_pessoa AS
    		SELECT
    			p.*, c.*
    		FROM
    		(
    		SELECT p.cd_prova, COUNT(q.cd_questao) as "qtd_questoes", p.cd_pessoa as cd_pessoa
    		FROM pint_provas_pessoas as p INNER JOIN pint_provas_pessoas_questoes as q ON (p.cd_prova_pessoa = q.cd_prova_pessoa)
    		GROUP BY p.cd_pessoa
    		) as p
    		INNER JOIN (
    				(SELECT 'A' as ds_gabarito, 1 as nr_minimo) UNION (SELECT	'B' as ds_gabarito, 40 as nr_minimo)
    			) as c ON (p.qtd_questoes > nr_minimo)
    		ORDER BY
    		   p.cd_pessoa, c.ds_gabarito;
    		
    drop temporary table if exists tmp_pint_salas_preenchimento;
    create temporary table tmp_pint_salas_preenchimento AS
    		SELECT 	
    			e.cd_prova, e.cd_sala, count(e.cd_pessoa) as nr_vagas_preenchidas,
    			(count(e.cd_pessoa) DIV 2)+1 as metade,
    			s.ds_sala
    		FROM
    			pint_ensalamento as e
    			INNER JOIN tmp_pint_gabarito_pessoa as gp ON (e.cd_pessoa = gp.cd_pessoa AND e.cd_prova = gp.cd_prova)
    			INNER JOIN uni_salas as s ON (e.cd_sala = s.cd_sala)
    		GROUP BY e.cd_prova,e.cd_sala;
    SET @sala:='';
    SET @numeracao  :=0;
    SET @numeracaoP :=0;
    SET @numeracaoI :=0;
    DROP TABLE IF EXISTS pint_pessoas_ordem_gabaritos;
    CREATE TABLE pint_pessoas_ordem_gabaritos AS
    (
    	SELECT
    		IF(@sala<>ordem.ds_sala, @numeracao := 0, 'NADA NUMERACAO') as zeraNumeracao,
    		IF(@sala<>ordem.ds_sala, @numeracaoP := 0, 'NADA P') as zeraP,
    		IF(@sala<>ordem.ds_sala, @numeracaoI := -1, 'NADA I') as zeraI,	
    		@numeracao:=@numeracao+1 as nr_numeracao,
    		@sala := ordem.ds_sala as calculo_sala,
    		IF((@numeracao) < ordem.nr_metade,@numeracaoI:=@numeracaoI+2, @numeracaoP:=@numeracaoP+2 ) as calculo_sequencia,
    		IF((@numeracao) < ordem.nr_metade,@numeracaoI, @numeracaoP ) as nr_sequencia,
    		ordem.*
    	FROM
    		(
    		SELECT
    			e.*, sp.nr_vagas_preenchidas, sp.metade as nr_metade, sp.ds_sala, gp.ds_gabarito
    		FROM
    			pint_ensalamento as e
    			INNER JOIN tmp_pint_gabarito_pessoa as gp ON (e.cd_prova = gp.cd_prova AND e.cd_pessoa = gp.cd_pessoa)
    			INNER JOIN tmp_pint_salas_preenchimento as sp ON (sp.cd_prova = e.cd_prova AND sp.cd_sala = e.cd_sala)
    		ORDER BY
    			sp.ds_sala, e.nr_posicao, gp.ds_gabarito
    		) as ordem
    	ORDER BY 	ordem.ds_sala, nr_sequencia
    );
END//]]></atualiza><atualiza codigo="{3F3707F5-CB48-4B07-A842-E6E04A0A9E15}" protocolo="mysql-5"><![CDATA[DELIMITER //

  # ---------------------------------------
  # ALTERAÇÕES DE ESTRUTURA
  # ---------------------------------------
  DROP TABLE IF EXISTS `dia_prazos`//
  CREATE TABLE `dia_prazos` (
    `CD_PRAZO` int(11) NOT NULL auto_increment,
    `NM_PRAZO` varchar(255) NOT NULL,
    `NR_ANOSEMESTRE` int(6) NOT NULL,
    `CD_TIPO_PRAZO` int(11) NOT NULL,
    `DT_INICIO_ETAPA` datetime default NULL,
    `DT_FIM_ETAPA` datetime default NULL,
    `DT_INICIO_FREQUENCIA` datetime default NULL,
    `DT_FIM_FREQUENCIA` datetime default NULL,
    `DT_INICIO_NOTAS` datetime default NULL,
    `DT_FIM_NOTAS` datetime default NULL,
    `DT_LIBERACAO` datetime default NULL,
    PRIMARY KEY  (`CD_PRAZO`)
  ) ENGINE=MyISAM DEFAULT CHARSET=latin1//
  
  
  DROP TABLE IF EXISTS `dia_prazos_turmas`//
  CREATE TABLE `dia_prazos_turmas` (
    `NR_ANOSEMESTRE` smallint(6) NOT NULL default '0',
    `CD_CURSO` varchar(15) NOT NULL default '',
    `CD_TURMA` varchar(15) NOT NULL default '',
    `CD_DISCIPLINA` int(11) NOT NULL,
    `CD_TIPO_PRAZO` int(11) NOT NULL,
    `CD_PRAZO` int(11) NOT NULL default '0',
    PRIMARY KEY  (`NR_ANOSEMESTRE`,`CD_CURSO`,`CD_TURMA`,`CD_DISCIPLINA`,`CD_TIPO_PRAZO`)
  ) ENGINE=MyISAM DEFAULT CHARSET=latin1//
  
  
  DROP TABLE IF EXISTS `dia_tipo_prazo`//
  CREATE TABLE `dia_tipo_prazo` (
    `CD_TIPO_PRAZO` int(11) NOT NULL default '0',
    `DS_TIPO_PRAZO` varchar(255) NOT NULL,
    `NR_ORDEM` int(11) NOT NULL,
    PRIMARY KEY  (`CD_TIPO_PRAZO`)
  ) ENGINE=MyISAM DEFAULT CHARSET=latin1//
  
  
  
  
  
