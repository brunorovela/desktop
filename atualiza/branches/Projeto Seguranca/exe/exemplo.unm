ALTER TABLE FIN_COBRANCA RENAME COLUMN SN_SERASA_BKP TO SN_SERASA;]]></atualiza><atualiza codigo="{FF32F8D7-1DA1-4604-8599-72D495C685D8}" protocolo="ansi"><![CDATA[ALTER TABLE `fin_plano_contas` ADD `cd_criterio` INT(11) UNSIGNED NULL;
