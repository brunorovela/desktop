CREATE TABLE CONV_REPASSES (
 CD_REPASSE NUMBER(19) , 
 CD_CONTRATO NUMBER(19), 
 CD_PESSOA NUMBER(19), 
 CD_TURMA VARCHAR (50), 
 VL_REMESSA FLOAT(126), 
 NR_TOTAL_PARCELAS NUMBER(9), 
 DT_INICIO_REPASSE TIMESTAMP(2) 
)NOCOMPRESS;

