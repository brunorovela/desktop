  PRIMARY KEY  (cd_coligada,cd_professor)
);

]]></atualiza><atualiza codigo="{27BABDC6-519C-4ADC-B042-1F05B18E74AE}" protocolo="oracle"><![CDATA[CREATE TABLE 
  professores_unidades
 (
   cd_professor NUMBER(19) NULL ,
   cd_coligada NUMBER(5) NULL ,
   sn_orientador NUMBER(5) NULL ,
   sn_professor NUMBER(5) NULL ,
   sn_funcionario NUMBER(5) NULL ,
  PRIMARY KEY (cd_professor, cd_coligada)

