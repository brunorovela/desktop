CREATE TABLE GCOML_TURMAS (
   CD_TURMA VARCHAR2(50) NOT NULL,
   NR_ANOSEMESTRE NUMBER(5) NOT NULL,
   NR_META NUMBER(5) NOT NULL,
   VL_DESCONTO FLOAT(126),
   VL_COMISSAO FLOAT(126),
   SN_ATIVO NUMBER(5) DEFAULT 0 NOT NULL,
   CONSTRAINT PK_GCOML_TURMAS PRIMARY KEY(CD_TURMA, NR_ANOSEMESTRE)
)//

CREATE TABLE GCOML_HISTORICO (
   CD_HISTORICO NUMBER(19) NOT NULL,
   CD_TURMA VARCHAR2(50) NOT NULL,
   NR_ANOSEMESTRE NUMBER(5) NOT NULL,
   NR_META NUMBER(5) NOT NULL,
   VL_DESCONTO FLOAT(126),
   VL_COMISSAO FLOAT(126),
   DT_INICIO TIMESTAMP(2) NOT NULL,
   DT_FIM TIMESTAMP(2),
   CONSTRAINT PK_GCOML_HISTORICO PRIMARY KEY(CD_HISTORICO)
)//

CREATE SEQUENCE SEQ_GCOML_HIST_CD_HISTORICO NOCYCLE NOORDER CACHE 20 NOMAXVALUE MINVALUE 1 INCREMENT BY 1 START WITH 1//

CREATE OR REPLACE TRIGGER AUTINC_GCOML_HIST_CD_HISTORICO BEFORE INSERT ON GCOML_HISTORICO REFERENCING NEW AS NEW FOR EACH ROW
BEGIN
   SELECT SEQ_GCOML_HIST_CD_HISTORICO.NEXTVAL INTO :NEW.CD_HISTORICO FROM DUAL;
   PACKAGE_LAST_INSERT_ID.SET_LAST_INSERT_ID(:NEW.CD_HISTORICO);
END//

