		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 160) AS FREQ160
		, CASE WHEN dpt.bimestre = 1 THEN
			fi.ajuste1
		WHEN dpt.bimestre = 2 THEN
			fi.ajuste2
		WHEN dpt.bimestre = 3 THEN
			fi.ajuste3
		WHEN dpt.bimestre = 4 THEN
			fi.ajuste4
		WHEN dpt.bimestre = 5 THEN
			fi.ajuste5
		WHEN dpt.bimestre = 6 THEN
			fi.ajuste6
		WHEN dpt.bimestre = 7 THEN
			fi.ajuste7
		WHEN dpt.bimestre = 8 THEN
			fi.ajuste8
		WHEN dpt.bimestre = 9 THEN
			fi.ajuste9
		WHEN dpt.bimestre = 10 THEN
			fi.ajuste10
		END ajuste
		, FI.situacao AS situacao
		FROM
		FICHAINDIVIDUAL AS FI
		INNER JOIN DIARIO_TURMAS DPT ON (
		FI.ANOSEMESTRE = DPT.ANOSEMESTRE AND FI.CURSO = DPT.CURSO AND FI.TURMA = DPT.TURMA AND
		FI.DISCIPLINA = DPT.DISCIPLINA)//]]></atualiza><atualiza codigo="{C73BB2A9-5F38-469F-8559-2A6312EFE40A}" protocolo="ansi"><![CDATA[UPDATE mol_processos SET sn_responsavel_rematricula = 0;

ALTER TABLE `mol_processos` MODIFY COLUMN `sn_responsavel_rematricula` smallint(1) NULL DEFAULT 0;]]></atualiza><atualiza codigo="{510ACA73-A15A-408D-B350-D3AB8AB54B0B}" protocolo="ansi"><![CDATA[DELIMITER //

DROP VIEW IF EXISTS gradecurricular//

CREATE VIEW gradecurricular AS
SELECT
                DISTINCT T.ANOSEMESTRE AS ANOSEMESTRE,
                G.CD_CURSO AS CURSO,
                GD.CD_DISCIPLINA AS DISCIPLINA,
                GD.NR_SERIE AS SERIE,
                T.TURNO AS TURNO,
                GD.NR_AULAS AS NUMEROAULAS,
                GD.VL_VALOR AS VALOR,
   CAST(CONCAT(
                               T.ANOSEMESTRE, GD.CD_GRADE, 
                                G.CD_CURSO,
                                 LPAD(GD.NR_SERIE, 2, 0),
                                 T.TURNO,
                                 LPAD(GD.CD_DISCIPLINA, 10, 0)) AS char) AS CODIGO,
                GD.SN_COMPARTILHADA,
                GD.NR_CREDITOS_ACADEMICOS,
                GD.CD_GRADE,
                GD.CD_DISCIPLINA_CATEGORIA AS CD_DISC_CATEGORIA,
                GD.NR_CARGA_HORARIA_PRATICA AS NR_CH_PRATICA,
                GD.NR_CARGA_HORARIA_TEORICA AS NR_CH_TEORICA
FROM
                TURMAS T
                INNER JOIN GRADES G ON (G.CD_GRADE = T.CD_GRADE AND G.CD_CURSO = T.CURSO AND G.SN_ATIVO = 'S')
                INNER JOIN GRADES_DISCIPLINAS GD ON (GD.CD_GRADE = G.CD_GRADE AND GD.CD_CURSO = G.CD_CURSO AND T.SERIE = GD.NR_SERIE)//

UPDATE IGNORE fichaindividual as f 
INNER JOIN turmas as t ON (f.turma = t.codigo and f.anosemestre = t.anosemestre)
  SET f.codigograde = 
(CONCAT(`t`.`anosemestre`, t.cd_grade, `f`.`CURSO`, LPAD(`t`.`serie`,2,0),`t`.`turno`, LPAD(`f`.`DISCIPLINA`,10,0)) )//
		

CREATE TRIGGER `fichaindividual_before_ins_tr` BEFORE INSERT ON `fichaindividual`
  FOR EACH ROW
BEGIN
   DECLARE CODIGOGRADE, GRADE VARCHAR(50) DEFAULT NULL;

   SELECT  CONCAT( NEW.ANOSEMESTRE,  cd_grade, NEW.CURSO, LPAD(serie, 2, 0), turno, LPAD(NEW.DISCIPLINA, 10, 0 )), cd_grade
   FROM turmas
   WHERE codigo = NEW.turma
                 AND anosemestre = NEW.anosemestre
   INTO CODIGOGRADE, GRADE;

   IF NOT ISNULL(GRADE) THEN
      SET NEW.codigograde = CODIGOGRADE;
   END IF;
END//

CREATE TRIGGER `fichaindividual_before_upd_tr` BEFORE UPDATE ON `fichaindividual`
  FOR EACH ROW
BEGIN
   DECLARE CODIGOGRADE, GRADE VARCHAR(50) DEFAULT NULL;

   SELECT  CONCAT( NEW.ANOSEMESTRE,  cd_grade, NEW.CURSO, LPAD(serie, 2, 0), turno, LPAD(NEW.DISCIPLINA, 10, 0 )), cd_grade
   FROM turmas
   WHERE codigo = NEW.turma
                 AND anosemestre = NEW.anosemestre
   INTO CODIGOGRADE, GRADE;

   IF NOT ISNULL(GRADE) THEN
      SET NEW.codigograde = CODIGOGRADE;
   END IF;
END//


DELIMITER ; ]]></atualiza><atualiza codigo="{4DA10E98-2C73-4EE5-9F61-62F18BCAB106}" protocolo="mysql-5"><![CDATA[CREATE TABLE `bib_coligadas` (`cd_coligada` SMALLINT UNSIGNED NOT NULL, `cd_biblioteca` SMALLINT UNSIGNED NOT NULL) TYPE = MyISAM /*!40100 DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci */;
ALTER TABLE `bib_coligadas` ADD UNIQUE INDEX   `unique` (`cd_biblioteca`, `cd_coligada`);]]></atualiza><atualiza codigo="{4DA10E98-2C73-4EE5-9F61-62F18BCAB106}" protocolo="oracle"><![CDATA[CREATE TABLE "BIB_COLIGADAS" (
"CD_BIBLIOTECA" NUMBER(5) NULL ,
"CD_COLIGADA" NUMBER(5) NULL 
)
NOCOMPRESS;

ALTER TABLE "BIB_COLIGADAS" ADD CONSTRAINT "unique" UNIQUE ("CD_BIBLIOTECA", "CD_COLIGADA");]]></atualiza><atualiza codigo="{77C7CD22-F303-4118-B1A4-108362FDFA37}" protocolo="ansi"><![CDATA[INSERT INTO `nu_modulos_acoes` (`cd_acao`,`cd_modulo`,`ds_nome_acao`,`ds_chave`) VALUES (NULL, (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'Avaliacoes'), 'Avaliacoes - Permite digitar avaliação manual', 'AvaliacoesDigitarManual');]]></atualiza><atualiza codigo="{03F208AB-C50E-4593-93C7-60B7BDE35044}" protocolo="ansi"><![CDATA[INSERT INTO parametros (ds_variavel, ds_valor, ds_variavel_usuario, cd_coligada) VALUES ('matricula_curso_exibe_concurso', 'N', 'Define se deve ou não exibir como padrão a caixa de filtro do concurso. Apenas exibida quando não houverem turmas cursando e houver inscrição.', 0);]]></atualiza><atualiza codigo="{9373F27E-AF0E-46CB-833C-DF57B276C53B}" protocolo="ansi"><![CDATA[DELIMITER //

SET SQL_LOG_BIN := 0//

SET GLOBAL log_bin_trust_function_creators := 1//

DROP FUNCTION IF EXISTS FCD_GRUPO_ESTUDANTES//
 
CREATE FUNCTION `FCD_GRUPO_ESTUDANTES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isEstudante BOOLEAN DEFAULT NULL;
   DECLARE codigoAluno INTEGER DEFAULT NULL;
 
   SELECT
      M.CODIGOALUNO
   FROM
      MATRICULAS M
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      M.CODIGOALUNO = pessoa AND
      T.CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoAluno;
 
   IF codigoAluno IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 2 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isEstudante;
 
   IF isEstudante THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_PROFESSORES//
 
CREATE FUNCTION `FCD_GRUPO_PROFESSORES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isProfessor BOOLEAN DEFAULT FALSE;
   DECLARE codigoProfessor INTEGER DEFAULT NULL;
 
   SELECT
      TP.PROFESSOR
   FROM
      TURMASPROFESSORES TP
         JOIN TURMAS T ON
            (TP.TURMA = T.CODIGO)
   WHERE
      TP.PROFESSOR = pessoa AND
      T.CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoProfessor;
 
   IF codigoProfessor IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 3 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isProfessor;
 
   IF isProfessor THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_COORDENADORES//
 
CREATE FUNCTION `FCD_GRUPO_COORDENADORES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isCoordenador BOOLEAN DEFAULT FALSE;
   DECLARE codigoCoordenador INTEGER DEFAULT NULL;
 
   SELECT
      CD_PESSOA
   FROM
      CURSOS_COORDENADORES
   WHERE
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoCoordenador;
 
   IF codigoCoordenador IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 4 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isCoordenador;
 
   IF isCoordenador THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_FUNCIONARIOS//
 
CREATE FUNCTION `FCD_GRUPO_FUNCIONARIOS`(cdPessoa INTEGER(11), coligada INTEGER(11))
    RETURNS tinyint(1)
    NOT DETERMINISTIC
    CONTAINS SQL
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE isFuncionario BOOLEAN DEFAULT FALSE;
   DECLARE codigoPessoa INTEGER DEFAULT NULL;
 
   SELECT
	   cd_pessoa
   FROM
	   professores
   WHERE
      sn_funcionario = "S" AND
      cd_pessoa = cdPessoa AND
      cd_coligada = coligada
   GROUP BY
      cd_pessoa
   INTO
      codigoPessoa;
 
   SELECT
      sn_incluir
   FROM
      nu_grupos_excecoes
   WHERE
      cd_grupo = 5 AND
      cd_pessoa = cdPessoa AND
      cd_coligada = coligada
   INTO
      isFuncionario;
 
   IF codigoPessoa IS NULL AND isFuncionario <> 1 THEN
      RETURN FALSE;
   ELSE
      RETURN TRUE;
   END IF;
 
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_RESPACADEMICO//
 
CREATE FUNCTION `FCD_GRUPO_RESPACADEMICO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespAcad BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_ACAD
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      T.CD_COLIGADA = coligada AND
      (P.CD_RESP_ACAD = pessoa OR ((P.CD_PAI = pessoa AND P.SN_PAI_RESP = 1) OR 

(P.CD_MAE = pessoa AND P.SN_MAE_RESP = 1))) AND
      P.CD_PESSOA != P.CD_RESP_ACAD
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 6 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespAcad;
 
   IF isRespAcad THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_RESPFINANCEIRO//
 
CREATE FUNCTION `FCD_GRUPO_RESPFINANCEIRO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespFinan BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_FINAN
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      P.CD_RESP_FINAN = pessoa AND
      T.cd_coligada = coligada AND
      P.CD_PESSOA != P.CD_RESP_FINAN      
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 7 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespFinan;
 
   IF isRespFinan THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
 
   RETURN 0;
END//]]></atualiza><atualiza codigo="{5517077D-DC85-4E90-9DE7-A05D52EAE89B}" protocolo="ansi"><![CDATA[ALTER TABLE avaliacoes_parametros ADD COLUMN calcular_media_fecha_diario smallint(6) NULL DEFAULT 0;]]></atualiza><atualiza codigo="{1BCBDE7B-8B51-453C-B983-67DB1855202D}" protocolo="ansi"><![CDATA[ALTER TABLE bib_contatos DROP FOREIGN KEY bib_contatos_ibfk_1;

