ALTER TABLE turmas ENGINE=InnoDB;
ALTER TABLE COLIGADAS ENGINE=InnoDB;
ALTER TABLE FIN_TIPOS_TITULO ENGINE=InnoDB;

DROP TABLE IF EXISTS FIN_PLANOS_DISTRATOS_SIT_MATRI;
DROP TABLE IF EXISTS FIN_PLANOS_DISTRATOS_TIPO_TITU;
DROP TABLE IF EXISTS FIN_PLANOS_DISTRATOS;
DROP TABLE IF EXISTS FIN_PLANOS_TURMAS;
DROP TABLE IF EXISTS FIN_PLANOS_ITENS;
DROP TABLE IF EXISTS FIN_PLANOS;

# Cria tabela FIN_PLANOS
CREATE TABLE FIN_PLANOS (
	CD_PLANO INT(11) NOT NULL AUTO_INCREMENT,
	CD_COLIGADA SMALLINT(6) UNSIGNED NOT NULL DEFAULT 1,
	CD_TIPO_PLANO SMALLINT(6) UNSIGNED NOT NULL DEFAULT 1,
	DS_PLANO VARCHAR(50) NULL,
	NR_ANOSEMESTRE SMALLINT(6) NULL,
	NR_PARCELAS SMALLINT(6) NULL,
	VL_COBRADO DOUBLE NULL DEFAULT NULL,
	VL_CONTRATO DOUBLE NULL DEFAULT NULL,
	VL_TAXAMATERIAL DOUBLE NULL DEFAULT NULL,
	VL_TAXAAPOSTILA DOUBLE NULL DEFAULT NULL,
	VL_DESCONTO DOUBLE NULL DEFAULT NULL,
	VL_MATRICULA DOUBLE NULL DEFAULT NULL,
	DT_APARTIR DATETIME NULL DEFAULT NULL,
	NR_TAXASMATERIAL SMALLINT(6) NULL DEFAULT NULL,
	DS_PARAGRAFO3 VARCHAR(150) NULL DEFAULT NULL,
	NR_DIAS_PARCELA_ZERO TINYINT(4) NULL DEFAULT 0,
	SN_DIAS_UTEIS TINYINT(1) SIGNED NOT NULL DEFAULT 1,
	SN_CREDITOS TINYINT(1) SIGNED NOT NULL DEFAULT 0,
	NR_CREDITOS_BASE DOUBLE NOT NULL DEFAULT 0,
	NR_MAX_DISCIPLINAS INT(11) UNSIGNED NULL DEFAULT NULL,
	PRIMARY KEY ( CD_PLANO ),
	FOREIGN KEY FK_FIN_PLANOS_CD_COLIGADA ( CD_COLIGADA ) REFERENCES COLIGADAS ( CD_COLIGADA ) ON UPDATE RESTRICT ON DELETE RESTRICT
) ENGINE=InnoDB;

# Cria tabela FIN_PLANOS_TURMAS
CREATE TABLE FIN_PLANOS_TURMAS (
	CD_PLANO INT(11) NOT NULL,
	CD_CURSO VARCHAR(15) NOT NULL,
	CD_TURMA VARCHAR(50) NOT NULL,
	FOREIGN KEY FK_FIN_PLANOS_TURMAS_CD_PLANO ( CD_PLANO ) REFERENCES FIN_PLANOS ( CD_PLANO ) ON UPDATE RESTRICT ON DELETE CASCADE/*RESTRICT*/,
	UNIQUE KEY UK_FIN_PLANOS_TURMAS ( CD_PLANO, CD_CURSO, CD_TURMA )
) ENGINE=InnoDB;

# Cria tabela FIN_PLANOS_ITENS
CREATE TABLE FIN_PLANOS_ITENS (
	CD_PLANO_ITEM INT(11) NOT NULL AUTO_INCREMENT,
	CD_PLANO INT(11) NOT NULL,
	NR_PARCELA SMALLINT(6) NOT NULL,
	VL_BRUTO DOUBLE NULL,
	VL_DESCONTO DOUBLE NULL,
	VL_EXTRA DOUBLE NULL,
	VL_DESCONTO_EXTRA DOUBLE NULL,
	VL_TOTAL DOUBLE NULL,
	NR_DIA TINYINT(4) UNSIGNED NOT NULL DEFAULT 1,
	NR_MES SMALLINT(6) UNSIGNED NOT NULL DEFAULT 0,
	NR_ANO SMALLINT(6) UNSIGNED NOT NULL DEFAULT 0,
	NR_CREDITOS_MINIMOS DOUBLE NULL DEFAULT 0,
	SN_CREDITO_PARCELA TINYINT(1) SIGNED NOT NULL DEFAULT 0,
	CD_TIPO_PARCELA SMALLINT(6) UNSIGNED NOT NULL DEFAULT 0,
	PRIMARY KEY ( CD_PLANO_ITEM ),
	FOREIGN KEY FK_FIN_PLANOS_TURMAS_CD_PLANO ( CD_PLANO ) REFERENCES FIN_PLANOS ( CD_PLANO ) ON UPDATE RESTRICT ON DELETE CASCADE/*RESTRICT*/
) ENGINE=InnoDB;

# Cria tabela FIN_PLANOS_DISTRATOS
CREATE TABLE FIN_PLANOS_DISTRATOS (
	CD_DISTRATO INT(11) NOT NULL AUTO_INCREMENT,
	CD_PLANO INT(11) NOT NULL,
	VL_COBRANCA DOUBLE NULL DEFAULT NULL,
	SN_ATIVO TINYINT(1) SIGNED NOT NULL DEFAULT 0,
	CD_TIPO_VALOR TINYINT(1) NOT NULL DEFAULT 1,
	NR_DIAS_VENCIMENTO TINYINT(3) NOT NULL DEFAULT 1,
	CD_TIPO_TITULO SMALLINT(6) UNSIGNED NULL,
	PRIMARY KEY( CD_DISTRATO ),
	FOREIGN KEY FK_FIN_PLANO_DISTRATO_CD_PLANO ( CD_PLANO ) REFERENCES FIN_PLANOS ( CD_PLANO ) ON UPDATE RESTRICT ON DELETE CASCADE/*RESTRICT*/
) ENGINE=InnoDB;

# Cria tabela FIN_PLANOS_DISTRATOS_SIT_MATRI
CREATE TABLE FIN_PLANOS_DISTRATOS_SIT_MATRI (
	CD_DISTRATO INT(11) NOT NULL,
	CD_SITUACAO INT(10) NOT NULL,
	FOREIGN KEY FK_FIN_DISTRATO_ST_CD_DISTRATO ( CD_DISTRATO ) REFERENCES FIN_PLANOS_DISTRATOS ( CD_DISTRATO ) ON UPDATE RESTRICT ON DELETE CASCADE/*RESTRICT*/#,
	#FOREIGN KEY FK_DIN_DISTRATO_ST_CD_SITUACAO ( CD_SITUACAO ) REFERENCES SITUACOES ( CD_SITUACAO ) ON UPDATE NO ACTION ON DELETE NO ACTION
) ENGINE=InnoDB;

# Cria tabela FIN_PLANOS_DISTRATOS_TIPO_TIT
CREATE TABLE FIN_PLANOS_DISTRATOS_TIPO_TITU (
	CD_DISTRATO INT(11) NOT NULL,
	CD_TIPO_TITULO SMALLINT(6) UNSIGNED NOT NULL,
	FOREIGN KEY FK_FIN_DISTRATO_TT_CD_DISTRATO ( CD_DISTRATO ) REFERENCES FIN_PLANOS_DISTRATOS ( CD_DISTRATO ) ON UPDATE RESTRICT ON DELETE CASCADE/*RESTRICT*/
) ENGINE=InnoDB;]]></atualiza><atualiza codigo="{D5502614-7B8B-4D94-B7F8-1A5469A38B2A}" protocolo="oracle"><![CDATA[ALTER TABLE turmas ADD CD_PLANO_PADRAO NUMBER(9) NULL;

DROP TABLE FIN_PLANOS_DISTRATOS_SIT_MATRI;
DROP TABLE FIN_PLANOS_DISTRATOS_TIPO_TITU;
DROP TABLE FIN_PLANOS_DISTRATOS;
DROP TABLE FIN_PLANOS_TURMAS;
DROP TABLE FIN_PLANOS_ITENS;
DROP TABLE FIN_PLANOS;

CREATE TABLE FIN_PLANOS (
	CD_PLANO NUMBER(9) NOT NULL,
	CD_COLIGADA NUMBER(5) DEFAULT 1 NOT NULL,
	CD_TIPO_PLANO NUMBER(5) DEFAULT 1 NOT NULL,
	DS_PLANO VARCHAR2(50) NULL,
	NR_ANOSEMESTRE NUMBER(5) NULL,
	NR_PARCELAS NUMBER(5) NULL,
	VL_COBRADO FLOAT DEFAULT NULL NULL,
	VL_CONTRATO FLOAT DEFAULT NULL NULL,
	VL_TAXAMATERIAL FLOAT DEFAULT NULL NULL,
	VL_TAXAAPOSTILA FLOAT DEFAULT NULL NULL,
	VL_DESCONTO FLOAT DEFAULT NULL NULL,
	VL_MATRICULA FLOAT DEFAULT NULL NULL,
	DT_APARTIR TIMESTAMP(2) DEFAULT NULL NULL,
	NR_TAXASMATERIAL NUMBER(5) DEFAULT NULL NULL,
	DS_PARAGRAFO3 VARCHAR2(150) DEFAULT NULL NULL,
	NR_DIAS_PARCELA_ZERO NUMBER(5) DEFAULT 0 NULL,
	SN_DIAS_UTEIS NUMBER(5) DEFAULT 1 NOT NULL,
	SN_CREDITOS NUMBER(5) DEFAULT 0 NOT NULL,
	NR_CREDITOS_BASE FLOAT DEFAULT 0 NOT NULL,
	NR_MAX_DISCIPLINAS NUMBER(19) DEFAULT NULL NULL
);

CALL CRIAR_AUTO_INCREMENT('FIN_PLANOS', 'CD_PLANO', 'SEQ_FIN_PLANOS_CD_PLANO', 'AUTOINC_FIN_PLANOS_CD_PLANO');

ALTER TABLE FIN_PLANOS ADD PRIMARY KEY (CD_PLANO);
ALTER TABLE FIN_PLANOS ADD CONSTRAINT FK_FIN_PLANOS_CD_COLIGADA FOREIGN KEY (CD_COLIGADA) REFERENCES COLIGADAS (CD_COLIGADA);


CREATE TABLE FIN_PLANOS_TURMAS (
	CD_PLANO NUMBER(9) NOT NULL,
	CD_CURSO VARCHAR2(15) NOT NULL,
	CD_TURMA VARCHAR2(50) NOT NULL
);

ALTER TABLE FIN_PLANOS_TURMAS ADD CONSTRAINT FK_FIN_PLANOS_TURMAS_CD_PLANO FOREIGN KEY ( CD_PLANO ) REFERENCES FIN_PLANOS ( CD_PLANO );
ALTER TABLE FIN_PLANOS_TURMAS ADD CONSTRAINT UK_FIN_PLANOS_TURMAS UNIQUE (CD_PLANO, CD_CURSO, CD_TURMA);


CREATE TABLE FIN_PLANOS_ITENS (
	CD_PLANO_ITEM NUMBER(9) NOT NULL,
	CD_PLANO NUMBER(9) NOT NULL,
	NR_PARCELA NUMBER(5) NOT NULL,
	VL_BRUTO FLOAT NULL,
	VL_DESCONTO FLOAT NULL,
	VL_EXTRA FLOAT NULL,
	VL_DESCONTO_EXTRA FLOAT NULL,
	VL_TOTAL FLOAT NULL,
	NR_DIA NUMBER(5) DEFAULT 1 NOT NULL,
	NR_MES NUMBER(5) DEFAULT 0 NOT NULL,
	NR_ANO NUMBER(5) DEFAULT 0 NOT NULL,
	NR_CREDITOS_MINIMOS FLOAT DEFAULT 0 NULL,
	SN_CREDITO_PARCELA NUMBER(5) DEFAULT 0 NOT NULL,
	CD_TIPO_PARCELA NUMBER(5) DEFAULT 0 NOT NULL
);

CALL CRIAR_AUTO_INCREMENT('FIN_PLANOS_ITENS', 'CD_PLANO_ITEM', 'SEQ_FIN_PLAN_INT_CD_PLANO_ITEM', 'AUTOINC_FIN_PLA_INT_CD_PLA_INT');

ALTER TABLE FIN_PLANOS_ITENS ADD PRIMARY KEY (CD_PLANO_ITEM);
ALTER TABLE FIN_PLANOS_ITENS ADD CONSTRAINT FK_FIN_PLANOS_ITENS_CD_PLANO FOREIGN KEY (CD_PLANO) REFERENCES FIN_PLANOS (CD_PLANO);



CREATE TABLE FIN_PLANOS_DISTRATOS (
	CD_DISTRATO NUMBER(9) NOT NULL,
	CD_PLANO NUMBER(9) NOT NULL,
	VL_COBRANCA FLOAT DEFAULT NULL NULL,
	SN_ATIVO NUMBER(5) DEFAULT 0 NOT NULL,
	CD_TIPO_VALOR NUMBER(5) DEFAULT 1 NOT NULL,
	NR_DIAS_VENCIMENTO NUMBER(5) DEFAULT 1 NOT NULL,
	CD_TIPO_TITULO NUMBER(5) NULL
);

CALL CRIAR_AUTO_INCREMENT('FIN_PLANOS_DISTRATOS', 'CD_DISTRATO', 'SEQ_FIN_PLANOS_DIS_CD_DIS', 'AUTOINC_FIN_PLANOS_DIS_CD_DIS');

ALTER TABLE FIN_PLANOS_DISTRATOS ADD PRIMARY KEY (CD_DISTRATO);
ALTER TABLE FIN_PLANOS_DISTRATOS ADD CONSTRAINT FK_FIN_PLANO_DISTRATO_CD_PLANO FOREIGN KEY (CD_PLANO) REFERENCES FIN_PLANOS (CD_PLANO);



CREATE TABLE FIN_PLANOS_DISTRATOS_SIT_MATRI (
	CD_DISTRATO NUMBER(9) NOT NULL,
	CD_SITUACAO NUMBER(9) NOT NULL
);

ALTER TABLE FIN_PLANOS_DISTRATOS_SIT_MATRI ADD CONSTRAINT FK_FIN_DISTRATO_ST_CD_DISTRATO FOREIGN KEY (CD_DISTRATO) REFERENCES FIN_PLANOS_DISTRATOS (CD_DISTRATO);


CREATE TABLE FIN_PLANOS_DISTRATOS_TIPO_TITU (
	CD_DISTRATO NUMBER(9) NOT NULL,
	CD_TIPO_TITULO NUMBER(5) NOT NULL
);

ALTER TABLE FIN_PLANOS_DISTRATOS_TIPO_TITU ADD CONSTRAINT FK_FIN_DISTRATO_TT_CD_DISTRATO FOREIGN KEY (CD_DISTRATO) REFERENCES FIN_PLANOS_DISTRATOS (CD_DISTRATO);]]></atualiza><atualiza codigo="{F4A5ABFC-C67B-4CCB-BF93-965D06239725}" protocolo="mysql-5"><![CDATA[# Em algumas bases, este campo não existe por algum motivo, recriamos... Se já existir da erro no Alter
ALTER TABLE planospagamento ADD COLUMN NUMEROTAXASMATERIAL INT(11) NULL DEFAULT NULL;

# Insere registros FIN_PLANOS
INSERT IGNORE INTO FIN_PLANOS (
	CD_PLANO, CD_COLIGADA, CD_TIPO_PLANO, DS_PLANO, NR_ANOSEMESTRE, NR_PARCELAS,
	VL_COBRADO, VL_CONTRATO, VL_TAXAMATERIAL, VL_TAXAAPOSTILA, VL_DESCONTO, VL_MATRICULA,
	DT_APARTIR, NR_TAXASMATERIAL, DS_PARAGRAFO3, NR_DIAS_PARCELA_ZERO, SN_DIAS_UTEIS, SN_CREDITOS,
	NR_CREDITOS_BASE, NR_MAX_DISCIPLINAS
)
SELECT
	CODIGO, PLANOSPAGAMENTO.CD_COLIGADA, CD_TIPO_PLANO, DESCRICAO, ANOSEMESTRE, PARCELAS,
	VALORCOBRADO, VALORCONTRATO, TAXAMATERIAL, TAXAAPOSTILA, DESCONTO, MATRICULA,
	APARTIR, NUMEROTAXASMATERIAL, PARAGRAFO3, NR_DIAS_PARCZERO, CASE WHEN UPPER(SN_DIAS_UTEIS) = 'N' THEN 0 ELSE 1 END, CASE WHEN UPPER(SN_CREDITOS) = 'N' THEN 0 ELSE 1 END,
	NR_CREDITOS_BASE, NR_MAX_DISCIPLINAS
FROM
	PLANOSPAGAMENTO
        INNER JOIN coligadas ON (PLANOSPAGAMENTO.CD_COLIGADA = coligadas.CD_COLIGADA);

# Insere registros FIN_PLANOS_ITENS
INSERT IGNORE INTO FIN_PLANOS_ITENS (
	CD_PLANO_ITEM, CD_PLANO, NR_PARCELA, VL_BRUTO, VL_DESCONTO, VL_EXTRA, VL_DESCONTO_EXTRA, VL_TOTAL,
	NR_DIA, NR_MES, NR_ANO, NR_CREDITOS_MINIMOS, SN_CREDITO_PARCELA, CD_TIPO_PARCELA
)
SELECT
	CD_ITEM_PLANO, CODIGOPLANO, PARCELA, VALORBRUTO, VALORDESCONTO, VALOREXTRA, DESCONTOEXTRA, VALORTOTAL,
	NR_DIA, MES, NR_ANO, NR_CREDITOS_MINIMOS, CASE WHEN UPPER(SN_CREDITO_PARCELA) = 'N' THEN 0 ELSE 1 END, CD_TIPO_PARCELA
FROM
	ITENSPLANOSPAGAMENTO ipg INNER JOIN PLANOSPAGAMENTO pg ON (pg.codigo = ipg.codigoplano);

# Insere registros FIN_PLANOS_TURMAS, de um CURSO todo
INSERT IGNORE INTO FIN_PLANOS_TURMAS (
	CD_PLANO, CD_CURSO, CD_TURMA
)
SELECT
	DISTINCT pp.codigo, t.curso, t.codigo
FROM
	planospagamento pp
	INNER JOIN turmas t ON ( t.curso = pp.curso AND t.cd_coligada = pp.cd_coligada AND t.anosemestre = pp.anosemestre )
	INNER JOIN fin_planos fp ON ( fp.CD_PLANO = pp.codigo )
WHERE
	TRIM(COALESCE(pp.turma, '')) = '';

# Insere registros FIN_PLANOS_TURMAS, de TURMAS separadas
INSERT IGNORE INTO FIN_PLANOS_TURMAS (
	CD_PLANO, CD_CURSO, CD_TURMA
)
SELECT
	DISTINCT pp.codigo, t.curso, t.codigo
FROM
	planospagamento pp
	INNER JOIN turmas t ON ( t.curso = pp.curso AND t.codigo = pp.turma AND t.cd_coligada = pp.cd_coligada AND t.anosemestre = pp.anosemestre )
	INNER JOIN fin_planos fp ON ( fp.CD_PLANO = pp.codigo )
WHERE
	TRIM(COALESCE(pp.curso, '')) <> '' AND TRIM(COALESCE(pp.turma, '')) <> '';

# INSERIR TAMBEM SEM CODIGO DE CURSO

INSERT IGNORE INTO FIN_PLANOS_TURMAS (
	CD_PLANO, CD_CURSO, CD_TURMA
)
SELECT
	DISTINCT pp.codigo, t.curso, t.codigo
FROM
	planospagamento_bkp pp
	INNER JOIN turmas t ON ( t.codigo = pp.turma AND t.cd_coligada = pp.cd_coligada AND t.anosemestre = pp.anosemestre )
	INNER JOIN fin_planos as fp ON (fp.CD_PLANO = pp.codigo)
WHERE
	TRIM(COALESCE(pp.turma, '')) <> '';]]></atualiza><atualiza codigo="{F4A5ABFC-C67B-4CCB-BF93-965D06239725}" protocolo="oracle"><![CDATA[INSERT INTO FIN_PLANOS (
	CD_PLANO, CD_COLIGADA, CD_TIPO_PLANO, DS_PLANO, NR_ANOSEMESTRE, NR_PARCELAS,
	VL_COBRADO, VL_CONTRATO, VL_TAXAMATERIAL, VL_TAXAAPOSTILA, VL_DESCONTO, VL_MATRICULA,
	DT_APARTIR, NR_TAXASMATERIAL, DS_PARAGRAFO3, NR_DIAS_PARCELA_ZERO, SN_DIAS_UTEIS, SN_CREDITOS,
	NR_CREDITOS_BASE, NR_MAX_DISCIPLINAS
)
SELECT
	CODIGO, CD_COLIGADA, CD_TIPO_PLANO, DESCRICAO, ANOSEMESTRE, PARCELAS,
	VALORCOBRADO, VALORCONTRATO, TAXAMATERIAL, TAXAAPOSTILA, DESCONTO, MATRICULA,
	APARTIR, NUMEROTAXASMATERIAL, PARAGRAFO3, NR_DIAS_PARCZERO, CASE WHEN UPPER(SN_DIAS_UTEIS) = 'N' THEN 0 ELSE 1 END, CASE WHEN UPPER(SN_CREDITOS) = 'N' THEN 0 ELSE 1 END,
	NR_CREDITOS_BASE, NR_MAX_DISCIPLINAS
FROM
	PLANOSPAGAMENTO;



INSERT INTO FIN_PLANOS_TURMAS (
	CD_PLANO, CD_CURSO, CD_TURMA
)
SELECT
	DISTINCT pp.codigo, t.curso, t.codigo
FROM
	planospagamento pp
	INNER JOIN turmas t ON ( t.curso = pp.curso AND t.cd_coligada = pp.cd_coligada AND t.anosemestre = pp.anosemestre )
        INNER JOIN fin_planos fp ON (pp.codigo = fp.cd_plano)
WHERE
	TRIM(COALESCE(pp.turma, 'NULL')) = 'NULL';



INSERT INTO FIN_PLANOS_TURMAS (
	CD_PLANO, CD_CURSO, CD_TURMA
)
SELECT
	DISTINCT pp.codigo, t.curso, t.codigo
FROM
	planospagamento pp
	INNER JOIN turmas t ON ( t.curso = pp.curso AND t.codigo = pp.turma AND t.cd_coligada = pp.cd_coligada AND t.anosemestre = pp.anosemestre )
        INNER JOIN fin_planos fp ON (pp.codigo = fp.cd_plano)
WHERE
	TRIM(COALESCE(pp.curso, 'NULL')) <> 'NULL' AND TRIM(COALESCE(pp.turma, 'NULL')) <> 'NULL';


SELECT * FROM fin_planos
INSERT INTO FIN_PLANOS_ITENS (
	CD_PLANO_ITEM, CD_PLANO, NR_PARCELA, VL_BRUTO, VL_DESCONTO, VL_EXTRA, VL_DESCONTO_EXTRA, VL_TOTAL,
	NR_DIA, NR_MES, NR_ANO, NR_CREDITOS_MINIMOS, SN_CREDITO_PARCELA, CD_TIPO_PARCELA
)
SELECT
	CD_ITEM_PLANO, CODIGOPLANO, PARCELA, VALORBRUTO, VALORDESCONTO, VALOREXTRA, DESCONTOEXTRA, VALORTOTAL,
	NR_DIA, MES, NR_ANO, NR_CREDITOS_MINIMOS, CASE WHEN UPPER(SN_CREDITO_PARCELA) = 'N' THEN 0 ELSE 1 END, CD_TIPO_PARCELA
FROM
	ITENSPLANOSPAGAMENTO ipg 
	INNER JOIN PLANOSPAGAMENTO pg ON (pg.codigo = ipg.codigoplano) 
	INNER JOIN FIN_PLANOS fp ON (fp.cd_plano = ipg.codigoplano);]]></atualiza><atualiza codigo="{0F41CF55-72A6-4036-808D-09322AF4F34B}" protocolo="mysql-5"><![CDATA[ALTER TABLE planospagamento RENAME planospagamento_bkp;
ALTER TABLE itensplanospagamento RENAME itensplanospagamento_bkp;

DROP VIEW IF EXISTS planospagamento;
DROP VIEW IF EXISTS itensplanospagamento;

CREATE VIEW planospagamento AS
SELECT
	fp.CD_PLANO AS codigo,
	fp.CD_COLIGADA AS cd_coligada,
	fp.NR_ANOSEMESTRE AS anosemestre,
	fp.DS_PLANO AS descricao,
	fpt.CD_TURMA AS turma,
	fpt.CD_CURSO AS curso,
	fp.NR_PARCELAS AS parcelas,
	fp.VL_COBRADO AS valorcobrado,
	fp.VL_CONTRATO AS valorcontrato,
	fp.VL_TAXAMATERIAL AS taxamaterial,
	fp.VL_TAXAAPOSTILA AS taxaapostila,
	fp.VL_DESCONTO AS desconto,
	fp.VL_MATRICULA AS matricula,
	fp.DT_APARTIR AS apartir,
	fp.NR_TAXASMATERIAL AS numerotaxasmaterial,
	fp.DS_PARAGRAFO3 AS paragrafo3,
	fp.NR_DIAS_PARCELA_ZERO AS nr_dias_parczero,
	CASE WHEN fp.SN_DIAS_UTEIS = 1 THEN
		'S'
	ELSE
		'N'
	END AS sn_dias_uteis,
	CASE WHEN fp.SN_CREDITOS = 1 THEN
		'S'
	ELSE
		'N'
	END AS sn_creditos,
	fp.NR_CREDITOS_BASE AS nr_creditos_base,
	fp.NR_MAX_DISCIPLINAS AS nr_max_disciplinas,
	fp.CD_TIPO_PLANO AS cd_tipo_plano
FROM
	fin_planos fp
	INNER JOIN fin_planos_turmas fpt ON (fpt.CD_PLANO = fp.CD_PLANO);

CREATE VIEW itensplanospagamento AS
SELECT
	fpi.CD_PLANO_ITEM AS codigoplano,
	fp.CD_COLIGADA AS cd_coligada,
	fpi.NR_MES AS mes,
	fpi.NR_PARCELA AS parcela,
	fpi.VL_BRUTO AS valorbruto,
	fpi.VL_DESCONTO AS valordesconto,
	fpi.VL_EXTRA AS valorextra,
	fpi.VL_DESCONTO_EXTRA AS descontoextra,
	fpi.VL_TOTAL AS valortotal,
	fpi.NR_DIA AS nr_dia,
	fpi.NR_ANO AS nr_ano,
	fpi.NR_CREDITOS_MINIMOS AS nr_creditos_minimos,
	CASE WHEN fpi.SN_CREDITO_PARCELA = 1 THEN
		'S'
	ELSE
		'N'
	END AS sn_credito_parcela,
	fpi.CD_TIPO_PARCELA AS cd_tipo_parcela,
	fpi.CD_PLANO_ITEM AS cd_item_plano
FROM
	fin_planos_itens fpi
	INNER JOIN fin_planos fp ON (fp.CD_PLANO = fpi.CD_PLANO);]]></atualiza><atualiza codigo="{0F41CF55-72A6-4036-808D-09322AF4F34B}" protocolo="oracle"><![CDATA[ALTER TABLE planospagamento RENAME TO planospagamento_bkp;
ALTER TABLE itensplanospagamento RENAME TO itensplanospagamento_bkp;

DROP VIEW planospagamento;
DROP VIEW itensplanospagamento;

CREATE VIEW planospagamento AS
SELECT
	fp.CD_PLANO AS codigo,
	fp.CD_COLIGADA AS cd_coligada,
	fp.NR_ANOSEMESTRE AS anosemestre,
	fp.DS_PLANO AS descricao,
	fpt.CD_TURMA AS turma,
	fpt.CD_CURSO AS curso,
	fp.NR_PARCELAS AS parcelas,
	fp.VL_COBRADO AS valorcobrado,
	fp.VL_CONTRATO AS valorcontrato,
	fp.VL_TAXAMATERIAL AS taxamaterial,
	fp.VL_TAXAAPOSTILA AS taxaapostila,
	fp.VL_DESCONTO AS desconto,
	fp.VL_MATRICULA AS matricula,
	fp.DT_APARTIR AS apartir,
	fp.NR_TAXASMATERIAL AS numerotaxasmaterial,
	fp.DS_PARAGRAFO3 AS paragrafo3,
	fp.NR_DIAS_PARCELA_ZERO AS nr_dias_parczero,
	CASE WHEN fp.SN_DIAS_UTEIS = 1 THEN
		'S'
	ELSE
		'N'
	END AS sn_dias_uteis,
	CASE WHEN fp.SN_CREDITOS = 1 THEN
		'S'
	ELSE
		'N'
	END AS sn_creditos,
	fp.NR_CREDITOS_BASE AS nr_creditos_base,
	fp.NR_MAX_DISCIPLINAS AS nr_max_disciplinas,
	fp.CD_TIPO_PLANO AS cd_tipo_plano
FROM
	fin_planos fp
	INNER JOIN fin_planos_turmas fpt ON (fpt.CD_PLANO = fp.CD_PLANO);



CREATE VIEW itensplanospagamento AS
SELECT
	fpi.CD_PLANO_ITEM AS codigoplano,
	fp.CD_COLIGADA AS cd_coligada,
	fpi.NR_MES AS mes,
	fpi.NR_PARCELA AS parcela,
	fpi.VL_BRUTO AS valorbruto,
	fpi.VL_DESCONTO AS valordesconto,
	fpi.VL_EXTRA AS valorextra,
	fpi.VL_DESCONTO_EXTRA AS descontoextra,
	fpi.VL_TOTAL AS valortotal,
	fpi.NR_DIA AS nr_dia,
	fpi.NR_ANO AS nr_ano,
	fpi.NR_CREDITOS_MINIMOS AS nr_creditos_minimos,
	CASE WHEN fpi.SN_CREDITO_PARCELA = 1 THEN
		'S'
	ELSE
		'N'
	END AS sn_credito_parcela,
	fpi.CD_TIPO_PARCELA AS cd_tipo_parcela,
	fpi.CD_PLANO_ITEM AS cd_item_plano
FROM
	fin_planos_itens fpi
	INNER JOIN fin_planos fp ON (fp.CD_PLANO = fpi.CD_PLANO);]]></atualiza><atualiza codigo="{FF6D6FE7-881C-4DBA-B395-CC5EF3260660}" protocolo="ansi"><![CDATA[ALTER TABLE matriculas_ingresso  CHANGE COLUMN cd_ingresso cd_ingresso INT(11) SIGNED NOT NULL AUTO_INCREMENT;]]></atualiza><atualiza codigo="{7B66C613-CBE5-40B5-BEDA-9F139CD54B6D}" protocolo="mysql-5"><![CDATA[ALTER TABLE avl_avaliacoes   ADD COLUMN SN_RESULTADOS  tinyint(1) NULL DEFAULT 1 ;
ALTER TABLE avl_avaliacoes   ADD sn_relatorios_descritivo TINYINT(3) UNSIGNED DEFAULT '1' NULL;
ALTER TABLE avl_avaliacoes ADD sn_relatorios_respostas TINYINT(3) UNSIGNED DEFAULT '1' NULL;
ALTER TABLE avl_avaliacoes ADD sn_relatorios_asp_gerais TINYINT(3) UNSIGNED DEFAULT '1' NULL;
ALTER TABLE avl_avaliacoes ADD sn_relatorios_disp_prof  TINYINT(3) UNSIGNED DEFAULT '1'  NULL;]]></atualiza><atualiza codigo="{7B66C613-CBE5-40B5-BEDA-9F139CD54B6D}" protocolo="oracle"><![CDATA[ALTER TABLE AVL_AVALIACOES
 
ADD ( SN_RESULTADOS NUMBER(3) DEFAULT 1  NULL  ) 

ADD ( SN_RELATORIOS_DESCRITIVO NUMBER(3) DEFAULT 1  NULL  )
ADD ( SN_RELATORIOS_RESPOSTAS NUMBER(3) DEFAULT 1  NULL  )
ADD ( SN_RELATORIOS_ASP_GERAIS NUMBER(3) DEFAULT 1  NULL  )
ADD ( SN_RELATORIOS_DISP_PROF  NUMBER(3) DEFAULT 1  NULL  ); ]]></atualiza><atualiza codigo="{2AFB38A6-06EA-48F5-A49F-A42145DDEFD8}" protocolo="mysql-5"><![CDATA[DROP TABLE IF EXISTS COMP_ACUMULADOS;
DROP TABLE IF EXISTS COMP_ESTOQUE;
DROP TABLE IF EXISTS COMP_PRODUTOS;
DROP TABLE IF EXISTS COMP_CATEGORIAS;

# Tabela COMP_CATEGORIAS
CREATE TABLE COMP_CATEGORIAS (
	CD_CATEGORIA INT(11) NOT NULL AUTO_INCREMENT,
	CD_TIPO_TITULO SMALLINT(6) UNSIGNED NULL,
	CD_COLIGADA SMALLINT(6) UNSIGNED NOT NULL DEFAULT 1,
	DS_CATEGORIA VARCHAR(255) NOT NULL,
	PRIMARY KEY ( CD_CATEGORIA )
) ENGINE=InnoDB;

# Tabela COMP_PRODUTOS
CREATE TABLE COMP_PRODUTOS (
	CD_PRODUTO VARCHAR(30) NOT NULL,
	CD_CATEGORIA INT(11) NOT NULL,
	DS_PRODUTO VARCHAR(255) NOT NULL,
	VL_PRODUTO DOUBLE NULL,
	SN_GERAR_TITULO TINYINT(1) SIGNED NOT NULL DEFAULT 0,
	SN_ACUMULAR_VALORES TINYINT(1) SIGNED NOT NULL DEFAULT 0,
	SN_IMPRIMIR_CUPOM TINYINT(1) SIGNED NOT NULL DEFAULT 0,
	PRIMARY KEY ( CD_PRODUTO ),
	FOREIGN KEY COMP_PRODUTOS_CD_CATEGORIA ( CD_CATEGORIA ) REFERENCES COMP_CATEGORIAS ( CD_CATEGORIA ) ON UPDATE RESTRICT ON DELETE RESTRICT
) ENGINE=InnoDB;

# Tabela COMP_ESTOQUE
CREATE TABLE COMP_ESTOQUE (
	CD_COMPRA INT(11) NOT NULL AUTO_INCREMENT,
	CD_PRODUTO VARCHAR(30) NOT NULL,
	CD_MENSALIDADE INT(11) NULL,
	TP_ENTRADA_SAIDA TINYINT(1) SIGNED NOT NULL COMMENT '1=ENTRADA; 2=SAíDA; 3=ESTORNO; 4=ESTORNADO',
	CD_PESSOA INT(11) NULL,
	TP_PESSOA TINYINT(1) NOT NULL COMMENT '0=SEM FORNECEDOR; 1=PESSOA; 2=EMPRESA',
	NR_QUANTIDADE INT(11) NOT NULL,
	DT_COMPRA DATETIME,
	DT_ENTRADA DATETIME,
	VL_COMPRA DOUBLE NULL,
	CD_COMPRA_EXTORNADO INT(11) NULL,
	PRIMARY KEY ( CD_COMPRA ),
	FOREIGN KEY FK_COMP_ESTOQUE_CD_PRODUTO ( CD_PRODUTO ) REFERENCES COMP_PRODUTOS ( CD_PRODUTO ) ON UPDATE RESTRICT ON DELETE RESTRICT
) ENGINE=InnoDB;

# Tabela COMP_ACUMULADOS
CREATE TABLE COMP_ACUMULADOS (
	CD_ACUMULADO INT(11) NOT NULL AUTO_INCREMENT,
	CD_COMPRA INT(11) NOT NULL,
	CD_PESSOA INT(11) NULL,
	DT_REGISTRO DATETIME NOT NULL,
	SN_PAGO TINYINT(1) NOT NULL DEFAULT 0,
	PRIMARY KEY ( CD_ACUMULADO ),
	FOREIGN KEY COMP_ACUMULADOS_CD_COMPRA ( CD_COMPRA ) REFERENCES COMP_ESTOQUE ( CD_COMPRA )
) ENGINE=InnoDB;]]></atualiza><atualiza codigo="{2AFB38A6-06EA-48F5-A49F-A42145DDEFD8}" protocolo="oracle"><![CDATA[DROP TABLE COMP_ACUMULADOS;
DROP TABLE COMP_ESTOQUE;
DROP TABLE COMP_PRODUTOS;
DROP TABLE COMP_CATEGORIAS;

-- Tabela COMP_CATEGORIAS
CREATE TABLE COMP_CATEGORIAS (
	CD_CATEGORIA NUMBER(9) NOT NULL,
	CD_TIPO_TITULO NUMBER(5) NULL,
	CD_COLIGADA NUMBER(5) DEFAULT 1 NOT NULL,
	DS_CATEGORIA VARCHAR2(255) NOT NULL,
	PRIMARY KEY ( CD_CATEGORIA )
);

-- Tabela COMP_PRODUTOS
CREATE TABLE COMP_PRODUTOS (
	CD_PRODUTO VARCHAR2(30) NOT NULL,
	CD_CATEGORIA NUMBER(9) NOT NULL,
	DS_PRODUTO VARCHAR2(255) NOT NULL,
	VL_PRODUTO FLOAT(126) NULL,
	SN_GERAR_TITULO NUMBER(5) DEFAULT 0 NOT NULL,
	SN_ACUMULAR_VALORES NUMBER(5) DEFAULT 0 NOT NULL,
	SN_IMPRIMIR_CUPOM NUMBER(5) DEFAULT 0 NOT NULL,
	PRIMARY KEY ( CD_PRODUTO )
);
ALTER TABLE COMP_PRODUTOS ADD CONSTRAINT COMP_PRODUTOS_CD_CATEGORIA FOREIGN KEY (CD_CATEGORIA) REFERENCES COMP_CATEGORIAS (CD_CATEGORIA) ON DELETE CASCADE;

-- Tabela COMP_ESTOQUE
CREATE TABLE COMP_ESTOQUE (
	CD_COMPRA NUMBER(9) NOT NULL,
	CD_PRODUTO VARCHAR2(30) NOT NULL,
	CD_MENSALIDADE NUMBER(9) NULL,
	TP_ENTRADA_SAIDA NUMBER(5) NOT NULL,
	CD_PESSOA NUMBER(9) NULL,
	TP_PESSOA NUMBER(5) NOT NULL,
	NR_QUANTIDADE NUMBER(9) NOT NULL,
	DT_COMPRA TIMESTAMP(2),
	DT_ENTRADA TIMESTAMP(2),
	VL_COMPRA FLOAT(126) NULL,
	CD_COMPRA_EXTORNADO NUMBER(9) NULL,
	PRIMARY KEY ( CD_COMPRA )
);
COMMENT ON COLUMN COMP_ESTOQUE.TP_ENTRADA_SAIDA IS '1=ENTRADA; 2=SAíDA; 3=ESTORNO; 4=ESTORNADO';
COMMENT ON COLUMN COMP_ESTOQUE.TP_PESSOA IS '0=SEM FORNECEDOR; 1=PESSOA; 2=EMPRESA';
ALTER TABLE COMP_ESTOQUE ADD CONSTRAINT FK_COMP_ESTOQUE_CD_PRODUTO FOREIGN KEY (CD_PRODUTO) REFERENCES COMP_PRODUTOS (CD_PRODUTO) ON DELETE CASCADE;

-- Tabela COMP_ACUMULADOS
CREATE TABLE COMP_ACUMULADOS (
	CD_ACUMULADO NUMBER(9) NOT NULL,
	CD_COMPRA NUMBER(9) NOT NULL,
	CD_PESSOA NUMBER(9) NULL,
	DT_REGISTRO TIMESTAMP(2) NOT NULL,
	SN_PAGO NUMBER(5) DEFAULT 0 NOT NULL,
	PRIMARY KEY ( CD_ACUMULADO )
);
ALTER TABLE COMP_ACUMULADOS ADD CONSTRAINT COMP_ACUMULADOS_CD_COMPRA FOREIGN KEY (CD_COMPRA) REFERENCES COMP_ESTOQUE (CD_COMPRA) ON DELETE CASCADE;

CALL CRIAR_AUTO_INCREMENT('COMP_CATEGORIAS', 'CD_CATEGORIA', 'SEQ_COMP_CATEGORIAS_CD_CATEGO', 'AUTOINC_COMP_CATEGO_CD_CATEGO');
CALL CRIAR_AUTO_INCREMENT('COMP_ESTOQUE', 'CD_COMPRA', 'SEQ_COMP_ESTOQUE_CD_COMPRA', 'AUTOINC_COMP_ESTOQUE_CD_COMPRA');
CALL CRIAR_AUTO_INCREMENT('COMP_ACUMULADOS', 'CD_ACUMULADO', 'SEQ_COMP_ACUMULADOS_CD_ACUMULA', 'AUTOINC_COMP_ACUMULA_CD_ACUMUL');]]></atualiza><atualiza codigo="{299E2350-49F3-424F-9FD4-7BF6E8B603D2}" protocolo="mysql-5"><![CDATA[DROP FUNCTION IF EXISTS GET_COMPRAS_QTD_ESTOQUE;
DROP FUNCTION IF EXISTS GET_COMPRAS_QTD_ESTOQUE_LIMIT;
DROP FUNCTION IF EXISTS GET_COMP_QTD_PRODUTOS_PESSOA;

CREATE FUNCTION `GET_COMPRAS_QTD_ESTOQUE`(`PARAM_CD_PRODUTO` varchar(30))
 RETURNS int(11)
BEGIN
	DECLARE retorno INT(11) DEFAULT 0;

	SELECT
		SUM(
			CASE WHEN TP_ENTRADA_SAIDA = 1 || TP_ENTRADA_SAIDA = 3 THEN
				COALESCE( NR_QUANTIDADE, 0 )
			ELSE
				0-COALESCE( NR_QUANTIDADE, 0 )
			END
		) AS registros
	INTO retorno
	FROM COMP_ESTOQUE
	WHERE CD_PRODUTO = PARAM_CD_PRODUTO;

	RETURN COALESCE(retorno, 0);
END;

CREATE FUNCTION `GET_COMPRAS_QTD_ESTOQUE_LIMIT`(`PARAM_CD_PRODUTO` varchar(30), `PARAM_DT_ENTRADA` DATETIME)
 RETURNS int(11)
BEGIN
	DECLARE retorno INT(11) DEFAULT 0;

	SELECT
		SUM(
			CASE WHEN TP_ENTRADA_SAIDA = 1 || TP_ENTRADA_SAIDA = 3 THEN
				COALESCE( NR_QUANTIDADE, 0 )
			ELSE
				0-COALESCE( NR_QUANTIDADE, 0 )
			END
		) AS registros
	INTO retorno
	FROM COMP_ESTOQUE
	WHERE CD_PRODUTO = PARAM_CD_PRODUTO AND DT_ENTRADA <= DATE_FORMAT(PARAM_DT_ENTRADA,'%Y-%m-%d 23:59:59');

	RETURN COALESCE(retorno, 0);
END;

CREATE FUNCTION `GET_COMP_QTD_PRODUTOS_PESSOA`(`PARAM_CD_PESSOA` int(11), `PARAM_DT_ENTRADA` DATETIME, `PARAM_DT_SAIDA` DATETIME)
 RETURNS int(11)
BEGIN
	DECLARE retorno INT(11) DEFAULT 0;

	SELECT
		SUM(NR_QUANTIDADE) AS registros
	INTO retorno
	FROM COMP_ESTOQUE
	WHERE CD_PESSOA = PARAM_CD_PESSOA AND TP_ENTRADA_SAIDA = 2 AND
				DT_ENTRADA >= DATE_FORMAT( PARAM_DT_ENTRADA, '%Y-%m-%d 00:00:00' ) AND
				DT_ENTRADA <= DATE_FORMAT( PARAM_DT_SAIDA, '%Y-%m-%d 23:59:59' );

	RETURN COALESCE(retorno, 0);
END;]]></atualiza><atualiza codigo="{299E2350-49F3-424F-9FD4-7BF6E8B603D2}" protocolo="oracle"><![CDATA[DELIMITER //

CREATE OR REPLACE 
FUNCTION "GET_COMPRAS_QTD_ESTOQUE" (PARAM_CD_PRODUTO IN VARCHAR2)
 RETURN NUMBER
IS
	V_RETORNO NUMBER(9) := 0;
BEGIN
	SELECT
		SUM(
			CASE WHEN TP_ENTRADA_SAIDA = 1 OR TP_ENTRADA_SAIDA = 3 THEN
				COALESCE( NR_QUANTIDADE, 0 )
			ELSE
				0-COALESCE( NR_QUANTIDADE, 0 )
			END
		) AS registros
	INTO V_RETORNO
	FROM COMP_ESTOQUE
	WHERE CD_PRODUTO = PARAM_CD_PRODUTO;

	RETURN COALESCE( V_RETORNO, 0 );
END//

CREATE OR REPLACE
FUNCTION "GET_COMPRAS_QTD_ESTOQUE_LIMIT"(PARAM_CD_PRODUTO VARCHAR2, PARAM_DT_ENTRADA TIMESTAMP, PARAM_DIAS_ANTERIORES NUMBER)
 RETURN NUMBER
IS
	V_RETORNO NUMBER(9) := 0;
BEGIN
	SELECT
		SUM(
			CASE WHEN TP_ENTRADA_SAIDA = 1 OR TP_ENTRADA_SAIDA = 3 THEN
				COALESCE( NR_QUANTIDADE, 0 )
			ELSE
				0-COALESCE( NR_QUANTIDADE, 0 )
			END
		) AS registros
	INTO V_RETORNO
	FROM COMP_ESTOQUE
	WHERE CD_PRODUTO = PARAM_CD_PRODUTO AND 
              DT_ENTRADA <= DATE_FORMAT(DATE_ADD(PARAM_DT_ENTRADA, '-', PARAM_DIAS_ANTERIORES, 'DAY'),'%Y-%m-%d 23:59:59');

	RETURN COALESCE(V_RETORNO, 0);
END//

CREATE FUNCTION "GET_COMP_QTD_PRODUTOS_PESSOA"(PARAM_CD_PESSOA NUMBER, PARAM_DT_ENTRADA TIMESTAMP, PARAM_DT_SAIDA TIMESTAMP)
 RETURN NUMBER
IS
	V_RETORNO NUMBER(9) := 0;
BEGIN
	SELECT
		SUM(NR_QUANTIDADE) AS registros
	INTO V_RETORNO
	FROM COMP_ESTOQUE
	WHERE CD_PESSOA = PARAM_CD_PESSOA AND TP_ENTRADA_SAIDA = 2 AND
				DT_ENTRADA >= DATE_FORMAT( PARAM_DT_ENTRADA, '%Y-%m-%d 00:00:00' ) AND
				DT_ENTRADA <= DATE_FORMAT( PARAM_DT_SAIDA, '%Y-%m-%d 23:59:59' );

	RETURN COALESCE(V_RETORNO, 0);
END//

DELIMITER ;]]></atualiza><atualiza codigo="{C045F7FD-3603-4BBB-9BC0-7DFD377B4E70}" protocolo="ansi"><![CDATA[INSERT INTO parametros (
