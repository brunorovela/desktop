   (SELECT A.CD_ACAO FROM NU_MODULOS M JOIN NU_MODULOS_ACOES A ON (M.CD_MODULO = A.CD_MODULO) WHERE M.DS_CHAVE = 'UMAdministracao' AND A.DS_CHAVE = 'Modulo.Acesso'),
