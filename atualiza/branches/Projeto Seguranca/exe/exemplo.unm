drop table map_materialprofessor_corrige;]]></atualiza><atualiza codigo="{6315AFE1-6A11-4D66-8291-9D23E911C8B3}" protocolo="ansi"><![CDATA[INSERT IGNORE INTO NU_MODULOS (DS_NOME_MODULO, DS_DESCRICAO, DS_CHAVE, SN_FIXO, SN_ONLINE, SN_VISUAL)
VALUES
   ('Laboratório', 'Módulo Laboratório', 'Laboratorio', 1, 0, 0),
   ('Atualiza', 'Módulo Atualiza', 'Atualiza', 1, 0, 0),
   ('Terminal de Acesso', 'Módulo Terminal de Acesso', 'TerminalAcesso', 1, 0, 0),
   ('Leitora de Gabarito', 'Módulo Leitora de Gabarito', 'LeitoraGabarito', 1, 0, 0),
   ('Cursos Extra-Curriculares', 'Módulo Cursos Extra-Curriculares', 'ExtraCurriculares', 1, 0, 0),
   ('Estatísticas Vestibular', 'Módulo Estatísticas Vestibular', 'EstatisticasVestibular', 1, 0, 0),
   ('Exportação', 'Módulo Exportação', 'Exportacao', 1, 0, 0),
   ('Holerith', 'Módulo Holerith', 'Holerith', 1, 0, 0),
   ('Impressão', 'Módulo Impressão', 'Impressao', 1, 0, 0);

INSERT IGNORE INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
SELECT
   CASE
      WHEN CATEGORIA = 'Acadêmico' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Academico')
      WHEN CATEGORIA = 'Financeiro' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'UMFinanceiro')
      WHEN CATEGORIA = 'Adm. Sistema' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ControleAcesso')
      WHEN CATEGORIA = 'Biblioteca' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'UMBiblioteca')
      WHEN CATEGORIA = 'Laboratório' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Laboratorio')
      WHEN CATEGORIA = 'On-Line' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'UniMestre')
      WHEN CATEGORIA = 'Atualiza' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Atualiza')
      WHEN CATEGORIA = 'Terminal de Acesso' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'TerminalAcesso')
      WHEN CATEGORIA = 'Leitora de Gabarito' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'LeitoraGabarito')
      WHEN CATEGORIA = 'Cursos Extra-Curriculares' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares')
      WHEN CATEGORIA = 'Estatísticas Vestibular' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'EstatisticasVestibular')
      WHEN CATEGORIA = 'Exportação' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Exportacao')
      WHEN CATEGORIA = 'Matrícula OnLine' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Matricula')
      WHEN CATEGORIA = 'Holerith' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Holerith')
      WHEN CATEGORIA = 'Impressão' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Impressao')
      WHEN CATEGORIA = 'Prova Interdisciplinar' THEN (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ProvaInterdisciplinar')
      ELSE 0
   END,
   MODULO,
   CODIGO
FROM
   MODULOS M;]]></atualiza><atualiza codigo="{5F9A4040-35FA-4C1A-847E-2DD97669CDCE}" protocolo="ansi"><![CDATA[UPDATE estnc_grupos_acoes SET NM_ACAO='Gerenciar Todas as Pessoas' WHERE (ds_chave='CadastroPessoas');]]></atualiza><atualiza codigo="{500BA07A-1390-48B4-BD71-9B5AEEF36D66}" protocolo="mysql-5"><![CDATA[SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'UMFinanceiro' INTO @modulo;

INSERT INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES (@modulo, 'Pessoas > Alunos > Matricula > Financeiro', 'Pessoas.Alunos.Matriculas.Financeiro');

SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE CD_MODULO = @modulo AND DS_CHAVE = 'Pessoas.Alunos.Matriculas.Financeiro' INTO @acao;

INSERT INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   P.CD_GRUPO,
   (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE CD_ACAO = @acao),
   P.NR_PERMISSAO
FROM
   NU_MODULOS M
      JOIN NU_MODULOS_ACOES A ON
         (M.CD_MODULO = A.CD_MODULO)
         JOIN NU_GRUPOS_PERMISSOES P ON
            (A.CD_ACAO = P.CD_ACAO)
WHERE
   A.DS_CHAVE = '1003' AND
   M.DS_CHAVE = 'Academico';]]></atualiza><atualiza codigo="{500BA07A-1390-48B4-BD71-9B5AEEF36D66}" protocolo="oracle"><![CDATA[DELIMITER //

DECLARE
   modulo NUMBER;
   acao NUMBER;
BEGIN

   SELECT CD_MODULO INTO modulo FROM NU_MODULOS WHERE DS_CHAVE = 'UMFinanceiro';

   INSERT INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
   VALUES (modulo, 'Pessoas > Alunos > Matricula > Financeiro', 'Pessoas.Alunos.Matriculas.Financeiro');

   SELECT CD_ACAO INTO acao FROM NU_MODULOS_ACOES WHERE CD_MODULO = modulo AND DS_CHAVE = 'Pessoas.Alunos.Matriculas.Financeiro';

   INSERT INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
   SELECT
      P.CD_GRUPO,
      (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE CD_ACAO = acao),
      P.NR_PERMISSAO
   FROM
      NU_MODULOS M
         JOIN NU_MODULOS_ACOES A ON
            (M.CD_MODULO = A.CD_MODULO)
            JOIN NU_GRUPOS_PERMISSOES P ON
               (A.CD_ACAO = P.CD_ACAO)
   WHERE
      A.DS_CHAVE = '1003' AND
      M.DS_CHAVE = 'Academico';
END//]]></atualiza><atualiza codigo="{BD3CDFB6-3E3D-4537-8B1D-D4943FCD15E2}" protocolo="ansi"><![CDATA[ALTER TABLE `recibos` CHANGE COLUMN `cd_pessoa` `cd_pessoa` INT(11) NULL;]]></atualiza><atualiza codigo="{CD6E9054-C739-44F3-A691-6172D178D510}" protocolo="ansi"><![CDATA[INSERT INTO nu_parametros (ds_parametro, ds_observacao, cd_modulo, ds_valor, ds_ereg_validacao, cd_parametro, cd_coligada) 
