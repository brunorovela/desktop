SELECT
   NOME, 0, 0
FROM
   USUARIOS;]]></atualiza><atualiza codigo="{4A4F6C41-C152-4A2F-BD11-68B2DF2EAAE9}" protocolo="oracle"><![CDATA[INSERT INTO NU_GRUPOS (DS_NOME_GRUPO, SN_BLOQUEADO, SN_FIXO)
SELECT
   NOME, 0, 0
FROM
   USUARIOS;]]></atualiza><atualiza codigo="{E23CD320-8345-4FA2-9202-3FE18CE04EAD}" protocolo="mysql-5"><![CDATA[INSERT INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   G.CD_GRUPO,
   A.CD_ACAO,
   (CASE WHEN MU.ACESSAR = 'S' THEN 1 ELSE 0 END) +
   (CASE WHEN MU.INCLUIR = 'S' THEN 2 ELSE 0 END) +
   (CASE WHEN MU.ALTERAR = 'S' THEN 4 ELSE 0 END) +
   (CASE WHEN MU.DELETAR = 'S' THEN 8 ELSE 0 END) +
   (CASE WHEN MU.ESPECIAL = 'S' THEN 16 ELSE 0 END)
FROM
   USUARIOS U
      JOIN MODULOSUSUARIOS MU ON
         (U.CODIGO = MU.CODIGOUSUARIO)
      JOIN NU_GRUPOS G ON
         (U.NOME LIKE G.DS_NOME_GRUPO)
      JOIN NU_MODULOS_ACOES A ON
         (MU.CODIGOMODULO = A.DS_CHAVE);]]></atualiza><atualiza codigo="{E23CD320-8345-4FA2-9202-3FE18CE04EAD}" protocolo="oracle"><![CDATA[INSERT INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   G.CD_GRUPO,
   A.CD_ACAO,
   (CASE WHEN MU.ACESSAR = 'S' THEN 1 ELSE 0 END) +
   (CASE WHEN MU.INCLUIR = 'S' THEN 2 ELSE 0 END) +
   (CASE WHEN MU.ALTERAR = 'S' THEN 4 ELSE 0 END) +
   (CASE WHEN MU.DELETAR = 'S' THEN 8 ELSE 0 END) +
   (CASE WHEN MU.ESPECIAL = 'S' THEN 16 ELSE 0 END)
FROM
   USUARIOS U
      JOIN MODULOSUSUARIOS MU ON
         (U.CODIGO = MU.CODIGOUSUARIO)
      JOIN NU_GRUPOS G ON
         (U.NOME LIKE G.DS_NOME_GRUPO)
      JOIN NU_MODULOS_ACOES A ON
         (TO_CHAR(MU.CODIGOMODULO) = A.DS_CHAVE);]]></atualiza><atualiza codigo="{D61D6814-CF03-4211-A1E3-079BBBB2E228}" protocolo="mysql-5"><![CDATA[ALTER TABLE TURMAS
ADD  COLUMN  SN_ATIVA SMALLINT(6) DEFAULT 1;

CREATE TABLE CURSOS_MESTRE (
CD_CURSO VARCHAR(15),
DS_CURSO VARCHAR(255),
DS_APELIDO VARCHAR(255),
NR_GRAU SMALLINT(6)
);

INSERT INTO CURSOS_MESTRE( CD_CURSO, DS_CURSO, DS_APELIDO, NR_GRAU )
SELECT CODIGO, DESCRICAO, APELIDO, MAX(GRAU) FROM (
	SELECT	
		CODIGO, DESCRICAO, APELIDO, GRAU
	FROM	
		CURSOS
	ORDER BY
		ANOSEMESTRE DESC
) t
GROUP BY
	CODIGO;

CREATE TABLE CURSOS_COLIGADAS
   (	CD_CURSO VARCHAR(15) NOT NULL, 
	CD_CURSO_EQUIVALENTE VARCHAR(15), 
	CD_GRADE SMALLINT(6), 
	DS_CONTRATO VARCHAR(30), 
	NR_CARGA_HORARIA FLOAT, 
	CD_COLIGADA SMALLINT(6) NOT NULL, 
	CD_DEPTO SMALLINT(6) NOT NULL, 
	NR_DIAS_LETIVOS FLOAT, 
	NR_DURACAO_AULA FLOAT, 
	CD_CURSO_MEC INT, 
	CD_GRAU_MEC VARCHAR(20), 
	CD_HABILITACAO_MEC INT, 
	DS_NOME_ETAPA VARCHAR(20), 
	NR_SERIES SMALLINT(6), 
	ME_OBSERVACOES MEDIUMTEXT, 
	DS_REQUERIMENTO VARCHAR(50), 
	SN_ACADEMICO SMALLINT(6), 
	 PRIMARY KEY (CD_COLIGADA, CD_CURSO)
   );

INSERT INTO CURSOS_COLIGADAS(
	CD_CURSO, CD_CURSO_EQUIVALENTE, CD_GRADE, DS_CONTRATO, NR_CARGA_HORARIA, CD_COLIGADA, 
	CD_DEPTO,NR_DIAS_LETIVOS, NR_DURACAO_AULA, CD_CURSO_MEC, CD_GRAU_MEC, CD_HABILITACAO_MEC, 
	DS_NOME_ETAPA, NR_SERIES, ME_OBSERVACOES, DS_REQUERIMENTO, SN_ACADEMICO 

)
SELECT
	C.CODIGO,
	C.cd_curso_equivalente, C.cd_grade, C.contrato,
	C.cargahorariatotal, D.cd_coligada, D.codigo,
	C.diasletivos, C.duracaohoraaula, C.mec_cd_curso,
	C.mec_cd_grau, C.mec_cd_habilitacao, C.nome_etapa,
	C.numerodeseries, C.observacoes, C.requerimento,
	C.sn_academico
FROM	
	(
		SELECT	
			*
		FROM	
			CURSOS
		ORDER BY
			ANOSEMESTRE DESC
	) C
	INNER JOIN DEPARTAMENTOS D ON (C.depto = D.codigo)
GROUP BY
	C.CODIGO;]]></atualiza><atualiza codigo="{D61D6814-CF03-4211-A1E3-079BBBB2E228}" protocolo="oracle"><![CDATA[ALTER TABLE TURMAS
ADD ( SN_ATIVA NUMBER(5) NULL  );
 
CREATE TABLE "CURSOS_MESTRE" (
"CD_CURSO" VARCHAR2(15) NULL ,
"DS_CURSO" VARCHAR2(255) NULL ,
"DS_APELIDO" VARCHAR2(255) NULL ,
"NR_GRAU" NUMBER(5) NULL 
);
 
-- Insere todos os cursos existentes atualmente nos cursos mestre
INSERT INTO CURSOS_MESTRE
SELECT	
  CODIGO, FIRST_OCCURRENCE(DESCRICAO), FIRST_OCCURRENCE(APELIDO), MAX(GRAU)
FROM	
  (
  SELECT	
    CODIGO, DESCRICAO, APELIDO, GRAU
  FROM	
    CURSOS
  ORDER BY
    ANOSEMESTRE DESC
  ) t
GROUP BY
	CODIGO;
 
CREATE TABLE "CURSOS_COLIGADAS" 
   (	"CD_CURSO" VARCHAR2(15) NOT NULL ENABLE, 
	"CD_CURSO_EQUIVALENTE" VARCHAR2(15), 
	"CD_GRADE" NUMBER(5,0), 
	"DS_CONTRATO" VARCHAR2(30), 
	"NR_CARGA_HORARIA" FLOAT(126), 
	"CD_COLIGADA" NUMBER(5,0) NOT NULL ENABLE, 
	"CD_DEPTO" NUMBER(5,0) NOT NULL ENABLE, 
	"NR_DIAS_LETIVOS" FLOAT(126), 
	"NR_DURACAO_AULA" FLOAT(126), 
	"CD_CURSO_MEC" NUMBER(9,0), 
	"CD_GRAU_MEC" VARCHAR2(20), 
	"CD_HABILITACAO_MEC" NUMBER(9,0), 
	"DS_NOME_ETAPA" VARCHAR2(20), 
	"NR_SERIES" NUMBER(5,0), 
	"ME_OBSERVACOES" CLOB, 
	"DS_REQUERIMENTO" VARCHAR2(50), 
	"SN_ACADEMICO" NUMBER(5,0), 
	 PRIMARY KEY ("CD_COLIGADA", "CD_CURSO")
   );

INSERT INTO CURSOS_COLIGADAS(
  CD_CURSO, CD_CURSO_EQUIVALENTE, CD_GRADE, DS_CONTRATO, NR_CARGA_HORARIA, CD_COLIGADA, 
  CD_DEPTO,NR_DIAS_LETIVOS, NR_DURACAO_AULA, CD_CURSO_MEC, CD_GRAU_MEC, CD_HABILITACAO_MEC, 
  DS_NOME_ETAPA, NR_SERIES, ME_OBSERVACOES, DS_REQUERIMENTO, SN_ACADEMICO 

)
SELECT
  C.CODIGO, 
  FIRST_OCCURRENCE(C.cd_curso_equivalente), FIRST_OCCURRENCE(C.cd_grade), FIRST_OCCURRENCE(C.contrato), 
  FIRST_OCCURRENCE(C.cargahorariatotal), FIRST_OCCURRENCE(D.cd_coligada), FIRST_OCCURRENCE(D.codigo), 
  FIRST_OCCURRENCE(C.diasletivos), FIRST_OCCURRENCE(C.duracaohoraaula), FIRST_OCCURRENCE(C.mec_cd_curso), 
  FIRST_OCCURRENCE(C.mec_cd_grau), FIRST_OCCURRENCE(C.mec_cd_habilitacao), FIRST_OCCURRENCE(C.nome_etapa), 
  FIRST_OCCURRENCE(C.numerodeseries), FIRST_OCCURRENCE(C.observacoes), FIRST_OCCURRENCE(C.requerimento), 
  FIRST_OCCURRENCE(C.sn_academico)
FROM	
  (
    SELECT	
      *
    FROM	
      CURSOS
    ORDER BY
      ANOSEMESTRE DESC
  ) C
  INNER JOIN DEPARTAMENTOS D ON (C.depto = D.codigo)
GROUP BY
  C.CODIGO;]]></atualiza><atualiza codigo="{0F9D2912-DFF1-4C59-9FD4-8AD8197426B2}" protocolo="mysql-5"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{0F9D2912-DFF1-4C59-9FD4-8AD8197426B2}" protocolo="oracle"><![CDATA[CREATE OR REPLACE 
FUNCTION "SHOW_CREATE_TABLE" (tabela IN VARCHAR2)
RETURN CLOB
IS
	V_RETORNO CLOB := NULL;
BEGIN
	SELECT
		dbms_metadata.get_ddl('TABLE', UPPER(tabela), 'UNIMESTRE') AS create_table
	INTO
		V_RETORNO
	FROM
		dual;

	RETURN V_RETORNO;
END;]]></atualiza><atualiza codigo="{8CC47685-9E93-49EC-BE45-465DDC3F46C7}" protocolo="mysql-5"><![CDATA[ALTER TABLE `audiovisuais_equipamentos_tipos` RENAME `audiovisuais_tipos`;
 
