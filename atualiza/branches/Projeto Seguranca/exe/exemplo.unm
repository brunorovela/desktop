MODIFY ( NR_CREDITOS_ACADEMICOS NUMBER(19) );]]></atualiza><atualiza codigo="{C1F7A0CF-0478-45C9-926C-959E44040C66}" protocolo="mysql-5"><![CDATA[ALTER TABLE grades_disciplinas CHANGE COLUMN NR_CREDITOS_ACADEMICOS NR_CREDITOS_ACADEMICOS INT(11) UNSIGNED NULL DEFAULT NULL;]]></atualiza><atualiza codigo="{C1F7A0CF-0478-45C9-926C-959E44040C66}" protocolo="oracle"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{F783E4EA-096E-4ECE-86C7-EBF5DD42EC42}" protocolo="mysql-5"><![CDATA[DELIMITER //

DROP PROCEDURE IF EXISTS DIA_INICIAR_DIARIO//
CREATE PROCEDURE `DIA_INICIAR_DIARIO`(IN CD_CURSO VARCHAR(40), IN CD_TURMA VARCHAR(40), IN CD_DISCIPLINA INTEGER(11), IN CD_PROFESSOR INTEGER(11), IN NR_ANOSEMESTRE INTEGER(11), IN NR_ETAPA INTEGER(11))
BEGIN
     REPLACE INTO DIARIO_TURMAS (turma, anosemestre, disciplina, bimestre, professor, curso)
     VALUES
     (CD_TURMA,NR_ANOSEMESTRE,CD_DISCIPLINA, NR_ETAPA, CD_PROFESSOR, CD_CURSO);

     INSERT IGNORE INTO DIARIOS_DESCRICOES (nr_anosemestre, cd_turma, nr_disciplina, cd_pessoa, nr_avaliacao)
     SELECT
           tp.anosemestre, tp.turma, tp.disciplina, fi.codigoaluno, NR_ETAPA
     FROM
         fichaindividual fi
         INNER JOIN turmasprofessores tp
               ON (fi.turma = tp.turma AND fi.anosemestre = tp.anosemestre AND fi.disciplina = tp.disciplina)
         INNER JOIN situacao s ON(fi.situacao = s.cd_situacao)
     WHERE
          s.cd_situacao_pai in (0, 1, 2, 9) AND
          tp.anosemestre =  NR_ANOSEMESTRE AND
          tp.curso = CD_CURSO AND
          tp.turma = CD_TURMA AND
          tp.disciplina = CD_DISCIPLINA AND
          tp.professor = CD_PROFESSOR;
END//]]></atualiza><atualiza codigo="{F783E4EA-096E-4ECE-86C7-EBF5DD42EC42}" protocolo="oracle"><![CDATA[DELIMITER //

CREATE OR REPLACE 
PROCEDURE DIA_INICIAR_DIARIO(CD_CURSO VARCHAR2, CD_TURMA VARCHAR2, CD_DISCIPLINA INTEGER, CD_PROFESSOR INTEGER, NR_ANOSEMESTRE INTEGER, NR_ETAPA INTEGER)
    DETERMINISTIC
IS
BEGIN     
			MERGE INTO DIARIO_TURMAS DT USING 
		 (SELECT 
				 NR_ANOSEMESTRE ANOSEMESTRE,
				 CD_CURSO CURSO,
				 CD_TURMA TURMA,
				 CD_DISCIPLINA DISCIPLINA,
				 NR_ETAPA BIMESTRE,
				 CD_PROFESSOR PROFESSOR
			FROM 
				 DIARIO_TURMAS
			WHERE
				 ANOSEMESTRE = NR_ANOSEMESTRE AND
				 TURMA LIKE CD_TURMA AND
				 DISCIPLINA = CD_DISCIPLINA AND
				 BIMESTRE = NR_ETAPA) DT2 ON 
						(DT.ANOSEMESTRE = DT2.ANOSEMESTRE AND 
						 DT.TURMA = DT2.TURMA AND
						 DT.DISCIPLINA = DT2.DISCIPLINA AND
						 DT.BIMESTRE = DT2.BIMESTRE) 
			WHEN NOT MATCHED THEN 
				 INSERT (DT.TURMA,  DT.ANOSEMESTRE,  DT.DISCIPLINA,  DT.BIMESTRE,  DT.PROFESSOR,  DT.CURSO) VALUES 
								(DT2.TURMA, DT2.ANOSEMESTRE, DT2.DISCIPLINA, DT2.BIMESTRE, DT2.PROFESSOR, DT2.CURSO)
      WHEN MATCHED THEN
         UPDATE SET DT.PROFESSOR = DT2.PROFESSOR, DT.CURSO = DT2.CURSO;
		 

		  MERGE INTO DIARIOS_DESCRICOES DD USING 
		 (SELECT 
				 tp.anosemestre anosemestre, 
				 tp.turma turma, 
				 tp.disciplina disciplina, 
				 fi.codigoaluno codigoaluno, 
				 NR_ETAPA nr_etapa
			FROM 
				 fichaindividual fi
				 INNER JOIN turmasprofessores tp ON (
							fi.turma = tp.turma AND 
							fi.anosemestre = tp.anosemestre AND 
							fi.disciplina = tp.disciplina
				 )
				 INNER JOIN situacao s ON(fi.situacao = s.cd_situacao)
			WHERE
				 s.cd_situacao_pai in (0, 1, 2, 9) AND
				 tp.anosemestre =  NR_ANOSEMESTRE AND
				 tp.curso = CD_CURSO AND
				 tp.turma = CD_TURMA AND
				 tp.disciplina = CD_DISCIPLINA AND
				 tp.professor = CD_PROFESSOR) DD2 ON 
						(DD.NR_ANOSEMESTRE = DD2.anosemestre AND 
						 DD.CD_TURMA = DD2.turma AND
						 DD.NR_DISCIPLINA = DD2.disciplina AND
						 DD.CD_PESSOA = DD2.codigoaluno AND
						 DD.NR_AVALIACAO = DD2.nr_etapa) 
			WHEN NOT MATCHED THEN 
				 INSERT (DD.NR_ANOSEMESTRE, DD.CD_TURMA, DD.NR_DISCIPLINA, DD.CD_PESSOA,    DD.NR_AVALIACAO) VALUES 
								(DD2.anosemestre,   DD2.turma,   DD2.disciplina,   DD2.codigoaluno, DD2.nr_etapa);

END//]]></atualiza><atualiza codigo="{90DE1D26-9410-4DE1-9640-1162658F719D}" protocolo="mysql-5"><![CDATA[ALTER TABLE `tam_eventos` CHANGE COLUMN `nr_registro` `NR_REGISTRO`  int(11) NULL DEFAULT NULL AFTER `SN_LIBERAR_PARA_COMUNIDADE`, ADD COLUMN `CD_COLIGADA`  smallint(6) NULL AFTER `NR_REGISTRO`;]]></atualiza><atualiza codigo="{90DE1D26-9410-4DE1-9640-1162658F719D}" protocolo="oracle"><![CDATA[DELIMITER //
ALTER TABLE TAM_EVENTOS ADD ( "CD_COLIGADA" NUMBER(5) NULL  )//
]]></atualiza><atualiza codigo="{35BF8BF8-42A0-40A6-92F1-555FCC6B990C}" protocolo="ansi"><![CDATA[UPDATE 
	fichaindividual fi 
SET 
	fi.falta1 = CASE WHEN fi.sn_bloq_freq1 = 1 THEN fi.falta1 
                ELSE (SELECT 
                         LENGTH( REPLACE( REPLACE( REPLACE( GROUP_CONCAT(COALESCE(daa.ds_freq, '')), ',', '' ), 'C', '' ), '-', '' ) )
											FROM
												diario_aulas_alunos daa
											WHERE
												daa.nr_anosem = fi.anosemestre
												AND daa.cd_turma = fi.turma
												AND daa.cd_disciplina = fi.disciplina
												AND daa.cd_pessoa = fi.codigoaluno
												AND daa.cd_bimestre = 1
											GROUP BY
												daa.nr_anosem,
												daa.cd_turma,
												daa.cd_disciplina,
												daa.cd_pessoa,
												daa.cd_bimestre
										)
						  END
WHERE
	fi.anosemestre >= 20111;


