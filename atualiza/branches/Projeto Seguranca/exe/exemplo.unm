CALL CRIAR_AUTO_INCREMENT( 'POL_QUESTOES_ASSUNTOS', 'CD_QUESTAO_ASSUNTO', 'SEQ_POL_QUESTOES_ASSUNTOS', 'AUTOINC_POL_QUESTOES_ASSUNTOS');]]></atualiza><atualiza codigo="{D062166C-CFA3-45D2-891F-2AC647EB9938}" protocolo="ansi"><![CDATA[INSERT INTO svc_recados( 
	ds_titulo, me_descricao, ds_assunto, 
	me_sql,
	me_msg_email,
	me_msg_recado,
	sn_ativo, tp_recado, nr_intervalo
) VALUES (
	'Notificador de Testes do UNIMESTRE', 'Notificador de Testes do UNIMESTRE', 'Email de Teste do Módulo de Serviços',
	'SELECT\r\n  p.cd_pessoa,\r\n  MD5( CONCAT( p.cd_pessoa, DATE_FORMAT(NOW(),\'%Y-%m-%d %H:%i:%S\') ) ) AS "ds_chave",\r\n  ( SELECT ds_valor FROM parametros WHERE ds_variavel = \'cliente_razao_social\' ) AS "razao_social",\r\n  0 AS nr_anosemestre,\r\n  DATE_FORMAT(NOW(), \'%d/%m/%Y %H:%i\') AS data_atual\r\nFROM\r\n pessoas p\r\n LEFT JOIN svc_recados_pessoas sre ON ( sre.ds_chave = MD5( CONCAT( p.cd_pessoa, DATE_FORMAT(NOW(),\'%Y-%m-%d %H:%i:%S\') ) ) )\r\nWHERE\r\n ds_login = \'admin\' AND\r\n sre.cd_recado_envio IS NULL', 
	'Teste de Envio de email da Instituição: [[razao_social]] - Horário: [[data_atual]]',
	'Teste de Envio de recado - Horário: [[data_atual]]',	
	0, 3, 1
);]]></atualiza><atualiza codigo="{2601D191-324F-4F3C-891A-34A7DFB365A3}" protocolo="ansi"><![CDATA[UPDATE nu_parametros SET ds_parametro = 'instituicao_ensino' WHERE ds_parametro LIKE 'instuticao_ensino';]]></atualiza><atualiza codigo="{85038C9E-3FD7-4EA7-85B3-9C45FC542CB9}" protocolo="ansi"><![CDATA[UPDATE
 mensalidades m
 INNER JOIN  pessoas p ON (p.cd_pessoa = m. codigoaluno)
SET
 cd_resp = IFNULL(p.cd_resp_finan, p.cd_pessoa)
WHERE
 cd_resp is null;]]></atualiza><atualiza codigo="{CEA8A36D-99B3-4B3A-9039-A1AF217D0803}" protocolo="ansi"><![CDATA[ALTER TABLE historico_escolas_grau CHANGE COLUMN ds_escola ds_escola VARCHAR(150) NULL AFTER ano;
