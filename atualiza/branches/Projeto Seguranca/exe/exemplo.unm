DROP TABLE PESSOAS_ATENDIMENTOS;
CREATE TABLE PESSOAS_ATENDIMENTOS (
	CD_ATENDIMENTO NUMBER(9),
	CD_PESSOA NUMBER(9) NOT NULL,
	DT_ATENDIMENTO TIMESTAMP(2) NOT NULL,
	SN_ACOMPANHADO NUMBER(5) NOT NULL,
	NM_ACOMPANHANTE VARCHAR2(255) NULL,
	SN_MEDICADO_CASA NUMBER(5) NOT NULL,
	DS_MEDICAMENTO_CASA VARCHAR2(255) NULL,
	DS_PRESSAO_ARTERIAL VARCHAR2(20) NULL,
	DS_TEMPERATURA VARCHAR2(10) NULL,
	VL_PESO FLOAT(126) NULL,
	SN_COMUNICADO_TELEFONE NUMBER(5) NOT NULL,
	SN_COMUNICADO_AGENDA NUMBER(5) NOT NULL,
	SN_COMUNICADO_EMAIL NUMBER(5) NOT NULL,
	SN_COMUNICADO_OCORRENCIA NUMBER(5) NOT NULL,
	DS_COMUNICADO_OUTROS VARCHAR2(255) NULL,
	CD_RETORNO NUMBER(5) NOT NULL,
	DS_RETORNO_QUEM VARCHAR2(255) NULL,
	DS_PROCEDIMENTO_ADOTADO VARCHAR2(255) NULL,
	PRIMARY KEY ( CD_ATENDIMENTO ),
	FOREIGN KEY (CD_PESSOA) REFERENCES PESSOAS (CD_PESSOA)
);
CALL CRIAR_AUTO_INCREMENT('PESSOAS_ATENDIMENTOS', 'CD_ATENDIMENTO', 'SEQ_PES_ATEND_CD_ATENDIMENTO', 'AUTOINC_PESSOAS_ATENDIMENTOS');

DROP TABLE PESSOAS_DEFICIENCIAS_COMPLETO;
CREATE TABLE PESSOAS_DEFICIENCIAS_COMPLETO (
	CD_PESSOA_DEFICIENCIA NUMBER(9) NOT NULL,
	CD_PESSOA NUMBER(9) NOT NULL,
	CD_CAMPO NUMBER(5) NOT NULL,
	ME_VALOR CLOB NULL,
	PRIMARY KEY (CD_PESSOA_DEFICIENCIA),
	CONSTRAINT PESSOA_DEFC_COMP_PESSOA_CAMPO UNIQUE ( CD_PESSOA, CD_CAMPO ),
	FOREIGN KEY ( CD_PESSOA ) REFERENCES PESSOAS ( CD_PESSOA ),
	FOREIGN KEY ( CD_CAMPO ) REFERENCES PESSOAS_CAMPOS_ADICIONAIS ( CD_CAMPO )
);
CALL CRIAR_AUTO_INCREMENT('PESSOAS_DEFICIENCIAS_COMPLETO', 'CD_PESSOA_DEFICIENCIA', 'SEQ_PES_DEF_COM_CD__PES_COMPL', 'AUTOINC_PESSOAS_DEF_COMPLETO');

INSERT INTO parametros (
	ds_variavel, ds_valor, sn_restrito, ds_variavel_usuario, cd_tipo, cd_coligada
) VALUES (
	'planilha_ficha_saude_atendimentos_campos', 'dt_atendimento;ds_procedimento_adotado', 'S', 
	'Definir os campos que deverão ser apresentados na Planilha de Atendimentos da Ficha de Saúde', 2, 0
);]]></atualiza><atualiza codigo="{D2C76562-2D61-4A7A-92F7-CD6133155052}" protocolo="mysql-5"><![CDATA[SELECT
   CD_MODULO
FROM
   NU_MODULOS
WHERE
   DS_CHAVE = 'ExtraCurriculares'
INTO
   @modulo;

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Cadastros > Tipos de Pessoas', 'Cadastros.TiposPessoas');

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Cadastros > Atividades', 'Cadastros.Atividades');

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Cadastros > Planos de Descontos', 'Cadastros.PlanosDescontos');

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Planilha de Inscrições', 'PlanilhaInscricoes');

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Planilha de Inscrições > Gerar Mensalidades', 'PlanilhaInscricoes.GerarMensalidades');

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Inscrições/Financeiro > Resgatar Pagamentos', 'ResgatarPagamentos');

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Financeiro > Cobrança', 'Financeiro.Cobranca');

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (@modulo, 'Relatórios', 'Relatorios');

INSERT INTO NU_GRUPOS_PERMISSOES
   (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   GP.CD_GRUPO,
   CASE
      WHEN DS_CHAVE = '5001' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Cadastros.TiposPessoas' AND CD_MODULO = @modulo)
      WHEN DS_CHAVE = '5002' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Cadastros.Atividades' AND CD_MODULO = @modulo)
      WHEN DS_CHAVE = '5011' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Cadastros.PlanosDescontos' AND CD_MODULO = @modulo)
      WHEN DS_CHAVE = '5021' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'PlanilhaInscricoes' AND CD_MODULO = @modulo)
      WHEN DS_CHAVE = '5022' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'PlanilhaInscricoes.GerarMensalidades' AND CD_MODULO = @modulo)
      WHEN DS_CHAVE = '5023' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'ResgatarPagamentos' AND CD_MODULO = @modulo)
      WHEN DS_CHAVE = '5024' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Financeiro.Cobranca' AND CD_MODULO = @modulo)
      WHEN DS_CHAVE = '5031' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Relatorios' AND CD_MODULO = @modulo)
   END,
   GP.NR_PERMISSAO
FROM
   NU_GRUPOS_PERMISSOES GP
      JOIN NU_MODULOS_ACOES A ON
         (GP.CD_ACAO = A.CD_ACAO)
WHERE
   A.DS_CHAVE IN ('5001', '5002', '5011', '5021', '5022', '5023', '5024', '5031');

DELETE GP FROM NU_GRUPOS_PERMISSOES GP
WHERE EXISTS
   (
   SELECT
	    M.CD_MODULO
   FROM
      NU_MODULOS M
         JOIN NU_MODULOS_ACOES A ON
            (M.CD_MODULO = A.CD_MODULO)
   WHERE
      A.DS_CHAVE IN ('5001', '5002', '5011', '5021', '5022', '5023', '5024', '5031') AND
      M.DS_CHAVE = 'ExtraCurriculares' AND
      A.CD_ACAO = GP.CD_ACAO
   );

DELETE A FROM NU_MODULOS_ACOES A
WHERE EXISTS
   (
   SELECT
      M.CD_MODULO
   FROM
      NU_MODULOS M
   WHERE
      M.CD_MODULO = A.CD_MODULO AND
      A.DS_CHAVE IN ('5001', '5002', '5011', '5021', '5022', '5023', '5024', '5031')
   );

ALTER TABLE extra_matriculas_atividades ADD COLUMN CD_MENSALIDADE INTEGER(11);

ALTER TABLE EXTRA_MATRICULAS_ATIVIDADES
   ADD CONSTRAINT FK_MATRCS_ATVADS_MENS_CD_MENSA FOREIGN KEY (CD_MENSALIDADE) REFERENCES MENSALIDADES (CD_MENSALIDADE);

UPDATE EXTRA_MATRICULAS_ATIVIDADES MA
SET
   MA.CD_MENSALIDADE = (
      SELECT
         M.CD_MENSALIDADE
      FROM
         EXTRA_MATRICULAS M
      WHERE
         M.NR_ANOSEMESTRE = MA.NR_ANOSEMESTRE AND
         M.NR_MES = MA.NR_MES AND
         M.CD_PESSOA = MA.CD_PESSOA
);

ALTER TABLE extra_matriculas DROP COLUMN cd_mensalidade;

ALTER TABLE `extra_tipos_pessoas` MODIFY COLUMN `tp_pessoa` CHAR(1);

ALTER TABLE extra_matriculas MODIFY COLUMN cd_turma_matricula VARCHAR(50);

ALTER TABLE extra_tipos_pessoas MODIFY COLUMN tp_pessoa CHAR(1);]]></atualiza><atualiza codigo="{D2C76562-2D61-4A7A-92F7-CD6133155052}" protocolo="oracle"><![CDATA[INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
