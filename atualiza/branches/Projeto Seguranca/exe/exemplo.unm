FROM 
	FICHAINDIVIDUAL FI 
	INNER JOIN DIARIO_TURMAS DPT ON (
					FI.ANOSEMESTRE = DPT.ANOSEMESTRE AND 
					FI.CURSO = DPT.CURSO AND 
					FI.TURMA = DPT.TURMA AND 
					FI.DISCIPLINA = DPT.DISCIPLINA
	)//]]></atualiza><atualiza codigo="{889D4CB9-2F5B-4A26-B3D3-DD1043CDD256}" protocolo="mysql-5"><![CDATA[ALTER TABLE cursos_coligadas CHANGE COLUMN CD_GRADE CD_GRADE INT(11) SIGNED NULL DEFAULT NULL;]]></atualiza><atualiza codigo="{889D4CB9-2F5B-4A26-B3D3-DD1043CDD256}" protocolo="oracle"><![CDATA[ALTER TABLE cursos_coligadas MODIFY (CD_GRADE NUMBER(9));]]></atualiza><atualiza codigo="{C02C384B-A509-419D-8C19-B9B0EC612E9B}" protocolo="mysql-5"><![CDATA[DROP VIEW USUARIOS;
CREATE VIEW USUARIOS AS
select
	DISTINCT
	CAST(p.cd_usuario_pessoa AS SIGNED) CODIGO,
	(CASE 
  	WHEN p.sn_bloqueado =1 THEN 'N' 
        ELSE 'S'
	END)  SN_ONLINE,
        (CASE 
  	WHEN p.sn_bloqueado =1 THEN 'N' 
        ELSE 'S'
	END) ONLINE,
	UPPER(p.ds_login) NOME,
	p.ds_senha SENHA,
	p.cd_pessoa CD_PESSOA
FROM
	pessoas p
WHERE 
	p.cd_usuario_pessoa is not null;]]></atualiza><atualiza codigo="{C02C384B-A509-419D-8C19-B9B0EC612E9B}" protocolo="oracle"><![CDATA[DROP VIEW USUARIOS;
CREATE VIEW USUARIOS AS
select
	DISTINCT
	p.cd_usuario_pessoa CODIGO,
  CASE 
  	WHEN p.sn_bloqueado =1 THEN 'N' 
        ELSE 'S'
	END SN_ONLINE,
	UPPER(p.ds_login) NOME,
	p.ds_senha SENHA,
	p.cd_pessoa CD_PESSOA
FROM
	pessoas p
WHERE 
	p.cd_usuario_pessoa is not null;]]></atualiza><atualiza codigo="{D2EADD7A-B1AD-487C-AAB6-02D64EC9CCC4}" protocolo="mysql-5"><![CDATA[ALTER TABLE turmas ADD COLUMN obscontrato MEDIUMTEXT NULL, ADD COLUMN obsgerais MEDIUMTEXT NULL;]]></atualiza><atualiza codigo="{D2EADD7A-B1AD-487C-AAB6-02D64EC9CCC4}" protocolo="oracle"><![CDATA[ALTER TABLE turmas ADD (obscontrato CLOB NULL, obsgerais CLOB NULL);]]></atualiza><atualiza codigo="{CA1CB78E-AB48-44BF-97D4-4421563AE2B2}" protocolo="ansi"><![CDATA[INSERT INTO nu_modulos_acoes(cd_acao, cd_modulo, ds_nome_acao, ds_chave)
VALUES (NULL, (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'Academico'),
 'Alteração de conta da Turma.', '1151');]]></atualiza><atualiza codigo="{E69BB070-438A-41D6-B179-FD8A5283B10E}" protocolo="mysql-5"><![CDATA[ALTER TABLE matriculas_curso CHANGE cd_pessoa cd_pessoa INT(11) DEFAULT '0' NOT NULL;
ALTER TABLE mensalidades CHANGE cd_mensalidade cd_mensalidade INT(11) NOT NULL AUTO_INCREMENT;

CREATE OR REPLACE VIEW CURSOS
AS
SELECT
	t.anosemestre AS ANOSEMESTRE, 
	cc.CD_CURSO AS CODIGO,
	FIRST_OCCURRENCE(cm.DS_APELIDO) AS APELIDO, 
	CAST(FIRST_OCCURRENCE(cm.DS_CURSO) AS VARCHAR(200)) AS DESCRICAO, 
	FIRST_OCCURRENCE(cm.NR_GRAU) AS GRAU,	
	NULL AS PARECERAUTORIZACAO,
	NULL AS PARECERRECONHECIMENTO,
	NULL AS DATACEE,
	FIRST_OCCURRENCE(cc.NR_CARGA_HORARIA) AS CARGAHORARIATOTAL,
	FIRST_OCCURRENCE(cc.NR_DIAS_LETIVOS) AS DIASLETIVOS,
	CAST(NULL AS NUMBER(9)) AS SEMANASLETIVAS,
	NULL AS DIASSEMANASLETIVAS,
	NULL AS HORARIOLETIVO,
	FIRST_OCCURRENCE(cc.NR_DURACAO_AULA) AS DURACAOHORAAULA,
	NULL AS DIASLETIVOSSEMANAIS,
	FIRST_OCCURRENCE(cc.NR_SERIES) AS NUMERODESERIES,
	FIRST_OCCURRENCE(cc.DS_NOME_ETAPA) AS NOME_ETAPA,
	FIRST_OCCURRENCE(cc.DS_CONTRATO) AS CONTRATO,
	NULL AS QTADEBIMESTRES,
	CAST(FIRST_OCCURRENCE(cc.CD_DEPTO) AS NUMBER(9)) AS DEPTO,
	NULL AS SEMANASLETIVASV,
	NULL AS SEMANASLETIVASN,
	FIRST_OCCURRENCE(cc.DS_REQUERIMENTO) AS REQUERIMENTO,
	NULL AS SENHA,
	NULL AS SENHAPROVISORIA,
	NULL AS CD_REGIMENTO,
	NULL AS CD_EDITAL,
	NULL AS CD_INSTRU_GERAIS,
	FIRST_OCCURRENCE(cc.CD_CURSO_EQUIVALENTE) AS CD_CURSO_EQUIVALENTE,
	FIRST_OCCURRENCE(cc.CD_CURSO_MEC) AS MEC_CD_CURSO,
	FIRST_OCCURRENCE(cc.CD_HABILITACAO_MEC) AS MEC_CD_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRAU_MEC) AS MEC_CD_GRAU,
	NULL AS DT_RESULTADO_FINAL,
	NULL AS CLI_MOSTRAR_SITE,
	NULL AS DS_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRADE) AS CD_GRADE,
	FIRST_OCCURRENCE(cc.CD_CURSO) AS CD_CURSO,
	FIRST_OCCURRENCE(cc.ME_OBSERVACOES) AS OBSERVACOES,
	FIRST_OCCURRENCE(cc.SN_ACADEMICO) AS SN_ACADEMICO,
	cc.CD_COLIGADA
FROM
	cursos_mestre cm
	INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO)
	INNER JOIN turmas t ON (t.CURSO = cc.CD_CURSO AND t.CD_COLIGADA = cc.CD_COLIGADA)
GROUP BY
	t.anosemestre, cc.CD_CURSO, cc.CD_COLIGADA;]]></atualiza><atualiza codigo="{E69BB070-438A-41D6-B179-FD8A5283B10E}" protocolo="oracle"><![CDATA[ALTER TABLE PESSOAS MODIFY ( CD_LOCALIDADE_NASC NUMBER(9) );

CREATE OR REPLACE VIEW CURSOS
AS
SELECT
	t.anosemestre AS ANOSEMESTRE, 
	cc.CD_CURSO AS CODIGO,
	FIRST_OCCURRENCE(cm.DS_APELIDO) AS APELIDO, 
	FIRST_OCCURRENCE(cm.DS_CURSO) AS DESCRICAO, 
	CAST(FIRST_OCCURRENCE(cm.NR_GRAU) AS NUMBER(5)) AS GRAU,	
	NULL AS PARECERAUTORIZACAO,
	NULL AS PARECERRECONHECIMENTO,
	NULL AS DATACEE,
	FIRST_OCCURRENCE(cc.NR_CARGA_HORARIA) AS CARGAHORARIATOTAL,
	FIRST_OCCURRENCE(cc.NR_DIAS_LETIVOS) AS DIASLETIVOS,
	CAST(NULL AS NUMBER(9)) AS SEMANASLETIVAS,
	NULL AS DIASSEMANASLETIVAS,
	NULL AS HORARIOLETIVO,
	FIRST_OCCURRENCE(cc.NR_DURACAO_AULA) AS DURACAOHORAAULA,
	NULL AS DIASLETIVOSSEMANAIS,
	FIRST_OCCURRENCE(cc.NR_SERIES) AS NUMERODESERIES,
	FIRST_OCCURRENCE(cc.DS_NOME_ETAPA) AS NOME_ETAPA,
	FIRST_OCCURRENCE(cc.DS_CONTRATO) AS CONTRATO,
	NULL AS QTADEBIMESTRES,
	CAST(FIRST_OCCURRENCE(cc.CD_DEPTO) AS NUMBER(9)) AS DEPTO,
	NULL AS SEMANASLETIVASV,
	NULL AS SEMANASLETIVASN,
	FIRST_OCCURRENCE(cc.DS_REQUERIMENTO) AS REQUERIMENTO,
	NULL AS SENHA,
	NULL AS SENHAPROVISORIA,
	NULL AS CD_REGIMENTO,
	NULL AS CD_EDITAL,
	NULL AS CD_INSTRU_GERAIS,
	FIRST_OCCURRENCE(cc.CD_CURSO_EQUIVALENTE) AS CD_CURSO_EQUIVALENTE,
	FIRST_OCCURRENCE(cc.CD_CURSO_MEC) AS MEC_CD_CURSO,
	FIRST_OCCURRENCE(cc.CD_HABILITACAO_MEC) AS MEC_CD_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRAU_MEC) AS MEC_CD_GRAU,
	NULL AS DT_RESULTADO_FINAL,
	NULL AS CLI_MOSTRAR_SITE,
	NULL AS DS_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRADE) AS CD_GRADE,
	FIRST_OCCURRENCE(cc.CD_CURSO) AS CD_CURSO,
	FIRST_OCCURRENCE(cc.ME_OBSERVACOES) AS OBSERVACOES,
	FIRST_OCCURRENCE(cc.SN_ACADEMICO) AS SN_ACADEMICO,
	cc.CD_COLIGADA
FROM
	cursos_mestre cm
	INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO)
	INNER JOIN turmas t ON (t.CURSO = cc.CD_CURSO AND t.CD_COLIGADA = cc.CD_COLIGADA)
GROUP BY
	t.anosemestre, cc.CD_CURSO, cc.CD_COLIGADA;

ALTER TABLE BANCO_CODIGO_RETORNO ADD ( CD_ORIGEM NUMBER(5) NULL  );
ALTER TABLE BANCO_CODIGO_RETORNO MODIFY ( CD_RETORNO NUMBER(5) DEFAULT 1  );
ALTER TABLE MATRICULAS MODIFY ( CD_MATRICULA_CURSO NUMBER(19) );]]></atualiza><atualiza codigo="{023DD79B-CF94-4764-966B-5B503A14C48F}" protocolo="mysql-5"><![CDATA[ALTER TABLE `nu_modulos` ADD `sn_ativo` TINYINT(1) UNSIGNED DEFAULT '1';


]]></atualiza><atualiza codigo="{023DD79B-CF94-4764-966B-5B503A14C48F}" protocolo="oracle"><![CDATA[ALTER TABLE "NU_MODULOS"
 ADD ( "SN_ATIVO" NUMBER(5) DEFAULT 1  NULL  ) ;]]></atualiza><atualiza codigo="{A2948E24-9C61-4B1B-87C8-87A2654484C6}" protocolo="ansi"><![CDATA[CREATE TABLE `pro_provas` (
  `cd_prova` int(11) NOT NULL auto_increment,
  `cd_tipo_prova` int(11) NOT NULL,
  `ds_prova` varchar(200) NOT NULL,
  `dt_cadastro` datetime default NULL,
  `dt_cad_inicio` datetime default NULL,
  `dt_cad_fim` datetime default NULL,
  `dt_res_inicio` datetime default NULL,
  `dt_res_fim` datetime default NULL,
  `cd_professor` int(11) default NULL,
  `nr_questoes` int(10) unsigned default NULL,
  `vl_peso` float default NULL,
  `nr_anosem` int(6) unsigned default NULL,
  `nr_duracao` int(11) default NULL,
  `ds_situacoes_validas` varchar(255) default NULL,
  `ds_diario_chave` varchar(255) default NULL,
  `sn_ativo` tinyint(1) NOT NULL default '1',
  `sn_concurso` tinyint(3) unsigned default '0',
  `sn_voltar` tinyint(1) default NULL,
  `cd_sorteio` int(11) NOT NULL default '0' COMMENT '0 - Aleatorio | 1 - Sequencial',
  `cd_exibir_resultado` tinyint(11) unsigned NOT NULL default '0' COMMENT '0 - Completo | 1 - Erros | 2 - So a Nota',
  `sn_exibir_gabarito` tinyint(4) NOT NULL default '1',
  `sn_anulada_responde` tinyint(1) unsigned NOT NULL default '0',
  `sn_prova_online` tinyint(4) unsigned default '1',
  `sn_multidisciplinar` tinyint(1) unsigned default '0',
  PRIMARY KEY  (`cd_prova`),
  KEY `cd_tipo_prova` (`cd_tipo_prova`),
  KEY `sn_ativo` (`sn_ativo`),
  KEY `cd_prova` (`cd_prova`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;]]></atualiza><atualiza codigo="{A1EA9A07-6195-40DA-9117-7B02AB2CB36D}" protocolo="ansi"><![CDATA[DELIMITER //

ALTER TABLE `situacao`  ADD COLUMN `nr_ordem_final` INT(11) NULL AFTER `cd_situacao_pai`//

UPDATE `situacao` SET `nr_ordem_final`=1 WHERE `cd_situacao`=1 AND `ds_situacao`='ATIVO' AND `ds_sigla_situacao`='ATIV' AND `cd_situacao_pai`=1 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=2 WHERE `cd_situacao`=2 AND `ds_situacao`='EM EXAME' AND `ds_sigla_situacao`='EXAM' AND `cd_situacao_pai`=2 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=3 WHERE `cd_situacao`=11 AND `ds_situacao`='2ª EPOCA' AND `ds_sigla_situacao`='2ªEPO' AND `cd_situacao_pai`=11 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=4 WHERE `cd_situacao`=9 AND `ds_situacao`='REPROVADO' AND `ds_sigla_situacao`='REPR' AND `cd_situacao_pai`=9 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=5 WHERE `cd_situacao`=0 AND `ds_situacao`='APROVADO' AND `ds_sigla_situacao`='APRO' AND `cd_situacao_pai`=0 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=6 WHERE `cd_situacao`=3 AND `ds_situacao`='CANCELADA' AND `ds_sigla_situacao`='CANC' AND `cd_situacao_pai`=3 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=7 WHERE `cd_situacao`=4 AND `ds_situacao`='TRANCADA' AND `ds_sigla_situacao`='TRAN' AND `cd_situacao_pai`=4 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=8 WHERE `cd_situacao`=6 AND `ds_situacao`='ABANDONO' AND `ds_sigla_situacao`='ABAN' AND `cd_situacao_pai`=6 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=9 WHERE `cd_situacao`=10 AND `ds_situacao`='RESERVA' AND `ds_sigla_situacao`='RESE' AND `cd_situacao_pai`=10 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=10 WHERE `cd_situacao`=5 AND `ds_situacao`='DESISTENCIA' AND `ds_sigla_situacao`='DESI' AND `cd_situacao_pai`=5 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=11 WHERE `cd_situacao`=7 AND `ds_situacao`='TRANSF. EXT.' AND `ds_sigla_situacao`='T.EXT' AND `cd_situacao_pai`=7 AND `nr_ordem_final` IS NULL LIMIT 1//
UPDATE `situacao` SET `nr_ordem_final`=12 WHERE `cd_situacao`=8 AND `ds_situacao`='TRANSF. INT.' AND `ds_sigla_situacao`='T.INT' AND `cd_situacao_pai`=8 AND `nr_ordem_final` IS NULL LIMIT 1//





CREATE PROCEDURE `DIA_CALCULO_MEDIA_DISCIPLINA`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA TINYINT, IN PCD_PESSOA INTEGER(11), IN PDS_FORMULA VARCHAR(255))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
BEGIN
-- esta funcao retorna o valor da me'dia calculada, conforme a formula passada
 -- se a formula nao for passada ela utilizará a formula do diario_turmas

 DECLARE VL_NOTA_MENOR, VL_NOTA_RE, VL_MEDIA_MAXIMA, VL_NOTA_PROFICIENCIA, VL_AJUSTE, VL_NOTA_FINAL, VL_NOTA_FIXA_ETAPA, VL_MEDIA_CALCULADA, VL_NOTA_AUX DOUBLE;

 DECLARE VNR_NOTA, VNR_NOTA_RE, VNR_NOTA_AUX INTEGER(11);
 DECLARE VNR_NOTA_MENOR, VSN_COMPOE INTEGER(11);
 DECLARE SN_PROFICIENCIA CHAR(1) DEFAULT 'N';
 DECLARE DS_FORMULA_ORIGINAL, DS_FORMULA_AUX VARCHAR(255) DEFAULT NULL;
 
 -- DECLARA TODOS OS CAMPOS EXISTENTE NA TABELA AVALIACOES_PARAMETROS
 DECLARE PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PADS_FORMULA_RE, PADS_CONDICAO_RE VARCHAR(255);
 DECLARE PASN_CONVERTER_NOTAS_NULAS VARCHAR(255);
 DECLARE PASN_TRUNCAR VARCHAR(1);
 DECLARE PASN_AJUSTE_APOS_RE, PATP_DECIMAIS_FORCE TINYINT(1);
 DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE INTEGER(11);

 DECLARE registros INTEGER DEFAULT NULL;

 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA EH CUSTOMIZADA
 DECLARE selectNotas CURSOR FOR
         SELECT nro_nota, sn_compoe FROM diario_provas
         WHERE sn_especial = 0
           AND sn_proficiencia = 0
           AND anosemestre = PNR_ANOSEMESTRE
           AND bimestre = PNR_ETAPA
           AND turma = PCD_TURMA
           AND disciplina = PCD_DISCIPLINA
         ORDER BY nro_nota DESC;
         
 -- DECLARA O CURSOS PARA DESCOBRIR AS NOTAS SUBSTITUIVEIS - PEGAR MENOR NOTA
         
 DECLARE selectMenor CURSOR FOR
         SELECT DP.nro_nota
              , IFNULL(DPA.VL_NOTA, 0)
           FROM DIARIO_PROVAS AS DP
           LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
                 AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
          WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1
            AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
            AND DP.BIMESTRE = PNR_ETAPA
            AND DP.TURMA = PCD_TURMA
            AND DP.DISCIPLINA = PCD_DISCIPLINA
          ORDER BY DP.nro_nota;

 -- Criar tabela temporaria para auxiliar nos calculos

 SET DS_FORMULA_ORIGINAL := PDS_FORMULA;

 DROP TABLE IF EXISTS TMP_MEDIAS;
 CREATE TEMPORARY TABLE TMP_MEDIAS ( MEDIA DOUBLE );

 -- CARREGA TODOS OS CAMPOS DA TABELA DE AVALIACOES_PARAMETROS NO DECLARES
 SELECT ap.cd_avaliacao
      , ap.nr_media_proficiencia
      , ap.sn_converter_notas_nulas
      , ap.sn_notas_truncar
      , ap.nr_casas_decimais
      , ap.sn_ajuste_apos_recuperacao
      , ap.ds_formula_recuperacao
      , ap.ds_criterio_recuperacao
      , ap.nr_casas_decimais_forcado
      , ap.tp_ajuste_forcado
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PASN_CONVERTER_NOTAS_NULAS, PASN_TRUNCAR, PAVL_DECIMAIS
       , PASN_AJUSTE_APOS_RE, PADS_FORMULA_RE, PADS_CONDICAO_RE, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE;
       
 -- Verifica se existe Parametro de Avaliacao
 IF ( PACD_AVALIACAO IS NULL ) THEN
    SET VL_MEDIA_CALCULADA := NULL;
 END IF;

 -- Verificar se existe Prova de Proficiencia
 SET VNR_NOTA := NULL;
 
 SELECT dp.nro_nota
   FROM diario_provas dp
  WHERE dp.anosemestre = PNR_ANOSEMESTRE
    AND dp.bimestre = PNR_ETAPA
    AND dp.turma = PCD_TURMA
    AND dp.disciplina = PCD_DISCIPLINA
    AND dp.sn_proficiencia = 1
   INTO VNR_NOTA;

 -- Se tiver nota de proficiencia, faz a verificacao das provas do aluno
 IF ( VNR_NOTA > 0 ) THEN
    SELECT dpa.vl_nota
      FROM diario_provas_alunos dpa
     WHERE dpa.nr_anosem = PNR_ANOSEMESTRE
       AND dpa.cd_bimestre = PNR_ETAPA
       AND dpa.cd_turma = PCD_TURMA
       AND dpa.cd_disciplina = PCD_DISCIPLINA
       AND dpa.cd_pessoa = PCD_PESSOA
       AND dpa.nr_prova = VNR_NOTA
      INTO VL_NOTA_PROFICIENCIA;

    -- Se passou na proficiencia
    IF ( VL_NOTA_PROFICIENCIA >= PANR_MEDIA_PROFICIENCIA ) THEN
       SET VL_MEDIA_CALCULADA := VL_NOTA_PROFICIENCIA;
    END IF;
 END IF;
 -- SE NAO FOR PROVA DE SUFICIENCIA... continuar


 -- SE FOR FORMULA ARITMETICA DAS NOTAS DIGITADAS
 IF ( PDS_FORMULA = 'ARITMETICA' ) THEN
 
    -- MONTAR A FORMULA PARA MEDIA ARITMETICA

    SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 1 THEN
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(*))

           ELSE
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(DPA.VL_NOTA))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;


 -- SE NAO VERIFICA SE EH FORMULA MEDIA_PESO
 ELSEIF PDS_FORMULA = 'MEDIA_PESO' THEN

  SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 0 THEN
                     CASE WHEN COUNT(*) != COUNT(DPA.VL_NOTA) THEN
                               NULL
                     ELSE
                               CONCAT('(',GROUP_CONCAT(CONCAT('NOTA', DP.nro_nota,'*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( DP.VL_PESO ) )
                     END
           ELSE
                     CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota,',0)*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( COALESCE( DP.VL_PESO, 1 ) ))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;

 ELSEIF PDS_FORMULA = 'ZERAR' OR PDS_FORMULA = ''THEN
    SET VL_MEDIA_CALCULADA := NULL;

 -- Formula montada
 END IF;

 -- INICIAR O CALCULO DA FORMULA MONTADA

 -- CRIA UM BACKUP DA FORMULA

 SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

 OPEN selectNotas;

 SELECT FOUND_ROWS() INTO registros;

 WHILE registros > 0 DO
    FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

    SELECT COALESCE( dpa.vl_nota, 0 )
      FROM diario_provas_alunos dpa
     WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
       AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
       AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
      INTO VL_NOTA_AUX;

    SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );
    SET VL_NOTA_AUX := NULL;
    SET registros = registros - 1;

 END WHILE;

 CLOSE selectNotas;
 
-- Atualizar o resultado do calculo em uma tabela temporaria

 IF DS_FORMULA_AUX IS NOT NULL THEN

-- Inserir o resultado da formula montada na TMP_MEDIA e posteriormente resgatar essa informacao junto com o AJUSTE

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (', DS_FORMULA_AUX , ')' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;
    
    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_MEDIA_CALCULADA;
      
    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 ELSE

--  Neste caso a nota do professor ja esta calculada, basta buscar o AJUSTE

    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 END IF;
 
-- buscar o ajuste

 TRUNCATE TMP_MEDIAS;

 SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS (MEDIA) SELECT ajuste', PNR_ETAPA, ' FROM fichaindividual WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '="N" AND aproveitamento="N";' );
 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;

 SELECT MEDIA
   FROM TMP_MEDIAS
   INTO VL_AJUSTE;

 
-- VL_NOTA_FIXA_ETAPA: mantem o valor da nota calculada do professor antes do ajuste
-- VL_AJUSTE: Possui o valor do ajuste DIGITADO para este aluno

-- Verificar se tera nota de recuperacao


 -- Verificar se existe Prova de Recuperacao e buscar a nota do aluno
 SET VNR_NOTA_RE := NULL;
 

 SELECT DP.nro_nota
      , DPA.VL_NOTA
   FROM DIARIO_PROVAS AS DP
   LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
         AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
  WHERE DP.SN_ESPECIAL = 1 
    AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
    AND DP.BIMESTRE = PNR_ETAPA
    AND DP.TURMA = PCD_TURMA
    AND DP.DISCIPLINA = PCD_DISCIPLINA
   INTO VNR_NOTA_RE, VL_NOTA_RE;
   

  IF (VNR_NOTA_RE IS NULL) OR (VL_NOTA_RE IS NULL) THEN
     -- NAOTEM nota de recuperacao
     SET VL_NOTA_FINAL := VL_NOTA_FIXA_ETAPA;
  ELSE
     -- TEM NOTA DE RECUPERACAO
     IF (PASN_AJUSTE_APOS_RE = 0) THEN
        SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE, 0);
        SET VL_MEDIA_CALCULADA := VL_MEDIA_CALCULADA + IFNULL(VL_AJUSTE, 0);
     END IF;
     
     IF (PADS_FORMULA_RE = 'SUBSTITUIR_MENOR') THEN
     
     -- DESCOBRIR QUAL A MENOR NOTA DAS SUBSTITUIVEIS

        OPEN selectMenor;

        SELECT FOUND_ROWS() INTO registros;
        
        SET VL_NOTA_MENOR := 999999;
        SET VNR_NOTA_MENOR := NULL;
        
        SET VNR_NOTA_AUX := NULL;
        SET VL_NOTA_AUX := NULL;

        WHILE registros > 0 DO
        
            FETCH selectMenor INTO VNR_NOTA_AUX, VL_NOTA_AUX;
            
            IF (VL_NOTA_AUX < VL_NOTA_MENOR) AND (VL_NOTA_AUX < VL_NOTA_RE) THEN
               SET VL_NOTA_MENOR := VL_NOTA_AUX;
               SET VNR_NOTA_MENOR := VNR_NOTA_AUX;
            END IF;
            
            SET registros = registros - 1;

        END WHILE;
        
        CLOSE selectMenor;
        
        -- A VARIAVEL VNR_NOTA_MENOR representa o numero da prova que tem a menor nota
        
        -- Efetuar a substituicao da menor nota na formula

        
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;
           
           IF ( VNR_NOTA = VNR_NOTA_MENOR) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;
                
           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;
        
        -- MONTAR A CONDICAO PARA RECUPERACAO - O MEDIA TEM QUE SER MAIOR
        
        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSEIF (PADS_FORMULA_RE = 'SUBSTITUIR_TODAS') THEN
    
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
        
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

           IF ( VSN_COMPOE = 1) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;

           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;

        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSE
       -- VERIFICAR AS OUTRAS FORMULAS DE RECUPERAÇÃO
       -- TROCAR AS PALAVRAS RESERVADAS RB / NOTAP / MEDIA_SUBSTITUIVEIS / MEDIA_NAO_SUBSTITUIVEIS
       
       SET DS_FORMULA_AUX := PADS_FORMULA_RE;
       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'RB', VL_NOTA_RE);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'RB', VL_NOTA_RE);
       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS SUBSTITUIVEIS NAO NULAS
          
          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;
            
            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
       
       END IF;
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS NAO SUBSTITUIVEIS NAO NULAS

          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 0 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;

            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);

       END IF;
       

    END IF;
     
-- Executar a formula de recuperacao

    TRUNCATE TMP_MEDIAS;

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (IF(', IFNULL(PADS_CONDICAO_RE, 'NULL'), ', ', IFNULL(DS_FORMULA_AUX, 'NULL') , ', ', IFNULL(VL_NOTA_FIXA_ETAPA, 'NULL'), ') )' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;

    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_NOTA_FINAL;
      
  END IF;

  IF ((PASN_AJUSTE_APOS_RE = 1) OR (VNR_NOTA_RE IS NULL) ) THEN

     SET VL_NOTA_FINAL := VL_NOTA_FINAL + IFNULL(VL_AJUSTE,0);
     SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE,0);
  END IF;
  
  -- Verificar se o aluno tem COMPLEMENTO DE MEDIA
  
  SET VL_MEDIA_CALCULADA := 0;
  
  SELECT IFNull(SUM(aa.NT_AJUSTE),0)
    FROM DIARIO_AJUSTES_ALUNOS aa
   INNER JOIN DIARIO_AJUSTES_TURMAS at ON (aa.cd_ajuste_turma = at.cd_ajuste_turma)
   WHERE aa.cd_pessoa = PCD_PESSOA
     AND at.cd_turma = PCD_TURMA
     AND at.nr_anosem = PNR_ANOSEMESTRE
     AND at.nr_etapa = PNR_ETAPA
     AND aa.nt_ajuste is not null				
    INTO VL_MEDIA_CALCULADA;
    
 SET VL_NOTA_FINAL := VL_NOTA_FINAL + COALESCE(VL_MEDIA_CALCULADA, 0);
				
 -- Gravar as informacoes na fichaindividual


 SET @sSql := CONCAT('UPDATE fichaindividual SET nota', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FIXA_ETAPA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', nota_d', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FINAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', exame', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_RE, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '="N" AND aproveitamento="N";' );
 

 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;

 CALL DIA_CALCULO_MEDIA_FINAL(PNR_ANOSEMESTRE, PCD_TURMA, PCD_TURMA, PCD_PESSOA);
END//




CREATE PROCEDURE `DIA_MEDIA_TURMA`(IN PCD_TURMA VARCHAR(15), IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA INTEGER(11), IN PDS_FORMULA VARCHAR(255))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE PACD_AVALIACAO VARCHAR(255);
 DECLARE registros INTEGER DEFAULT NULL;
 
 DECLARE VCD_ALUNO INTEGER DEFAULT NULL;
  
 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA Eh CUSTOMIZADA
 DECLARE selectAlunos CURSOR FOR
         SELECT codigoaluno FROM fichaindividual
          WHERE anosemestre = PNR_ANOSEMESTRE
            AND turma = PCD_TURMA
            AND disciplina = PCD_DISCIPLINA
            AND aproveitamento = "N"
         ORDER BY codigoaluno DESC;
		 
 IF PDS_FORMULA = 'NULL' THEN
      SELECT 
         formula_media 
      FROM 
         diario_turmas 
      WHERE 
         turma LIKE PCD_TURMA AND 
         anosemestre = PNR_ANOSEMESTRE AND 
         disciplina = PCD_DISCIPLINA AND 
         bimestre = PNR_ETAPA INTO PDS_FORMULA;
 END IF;		 

 -- VERIFICA SE EXISTE O PARAMETRO DE AVALIAÇÃO
 SELECT ap.cd_avaliacao
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO;

 IF ( PACD_AVALIACAO IS NOT NULL ) THEN
-- SE EXISTE PARAMETRO DE AVALIACAO, GUARDAR A FORMULA NO DIARIO

    IF PDS_FORMULA = 'ZERAR' THEN
    
       UPDATE diario_turmas
          SET formula_media = NULL
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    ELSE
    
       UPDATE diario_turmas
          SET formula_media = PDS_FORMULA
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    END IF;

    OPEN selectAlunos;

    SELECT FOUND_ROWS() INTO registros;

    WHILE registros > 0 DO
        FETCH selectAlunos INTO VCD_ALUNO;
            
        CALL DIA_CALCULO_MEDIA_DISCIPLINA(PNR_ANOSEMESTRE, PCD_TURMA, PCD_DISCIPLINA, PNR_ETAPA, VCD_ALUNO, PDS_FORMULA);

        SET registros = registros - 1;

    END WHILE;

    CLOSE selectAlunos;
          
 END IF;

END//





CREATE FUNCTION `DIA_ARREDONDA_FORCADO`(PVL_NOTA DOUBLE, PNR_PRECISAO SMALLINT, PTP_DIRECAO TINYINT(1))
    RETURNS double
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE dFracao, dDif DOUBLE;
   DECLARE dDiv1, dDiv2, dDiv3, dDiv4 DOUBLE;
   DECLARE AMult INTEGER(11);

   -- Direcao:   1 = Para cima,  2 = Para Baixo,  3 = Ambos
   SET dFracao := PVL_NOTA - TRUNCATE(PVL_NOTA, (PNR_PRECISAO-1));

   -- Sem nenhuma casa decimal - deve arredondar de forma diferenciada
   IF PNR_PRECISAO = 0 THEN

      IF (PTP_DIRECAO = 2) OR (dFracao = 0) THEN
         SET dDif := - dFracao;
      ELSEIF (PTP_DIRECAO = 1) THEN
         SET dDif := (1 - dFracao);
      ELSE
         IF (dFracao < 0.5) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (1 - dFracao);
         END IF;
      END IF;


   ELSE


     SET AMult := TRUNCATE(POWER(10.0, PNR_PRECISAO),0);

      SET dDiv1 := 2.5 / AMult;
      SET dDiv2 := 5 / AMult;
      SET dDiv3 := 7.5 / AMult;
      SET dDiv4 := 10 / AMult;

      IF (dFracao < dDiv1) THEN -- menor que 2.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) OR (dFracao = 0) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (dDiv2 - dFracao);
         END IF;
      ELSEIF ((dFracao >= dDiv1) and (dFracao <= dDiv2)) THEN -- maior que 2.5 e menor que 5
         IF (PTP_DIRECAO = 1 OR PTP_DIRECAO = 3) OR (dFracao = dDiv2) THEN
            SET dDif := (dDiv2 - dFracao);
         ELSE
            SET dDif := -dFracao;
         END IF;
      ELSEIF ((dFracao > dDiv2) and (dFracao < dDiv3)) THEN -- maior que 5 e menor que 7.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) THEN
            SET dDif := - (dFracao - dDiv2);
         ELSE
            SET dDif := (dDiv4 - dFracao);
         END IF;
      ELSEIF (dFracao >= dDiv3) THEN -- maior que 7.5
         IF PTP_DIRECAO = 1 OR PTP_DIRECAO = 3 THEN
            SET dDif := + (dDiv4 - dFracao);
         ELSE
            SET dDif := dDiv2 - dFracao;
         END IF;
      END IF;

   END IF;

   RETURN ROUND(PVL_NOTA + dDif, PNR_PRECISAO);

END//






CREATE FUNCTION `DIA_FORMATAR_MEDIA`(PVL_MEDIA DOUBLE, PSN_TRUNCAR CHAR(1), PVL_DECIMAIS SMALLINT, PVL_DECIMAIS_FORCE SMALLINT, PTP_DECIMAIS_FORCE TINYINT(1))
    RETURNS varchar(10)
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE VL_MEDIA_MAXIMA DOUBLE;
   
   IF ISNULL(PVL_MEDIA) THEN
      RETURN 'NULL';
   END IF;

-- VERIFICAR SE A MEDIA EH SUPERIOR AO MAXIMO PERMITIDO
   SET VL_MEDIA_MAXIMA := GET_PARAMETROS('valor_maximo_medias');

   IF ( (VL_MEDIA_MAXIMA IS NOT NULL) AND (PVL_MEDIA > VL_MEDIA_MAXIMA) )  THEN
   
      SET PVL_MEDIA := VL_MEDIA_MAXIMA;
      
   END IF;
   
   IF PVL_DECIMAIS_FORCE IS NOT NULL THEN

      SET PVL_MEDIA := DIA_ARREDONDA_FORCADO(PVL_MEDIA, PVL_DECIMAIS_FORCE, PTP_DECIMAIS_FORCE);

   END IF;
   -- Implementar o arredondamento forcado
   
   IF PSN_TRUNCAR = 1 THEN
      RETURN TRUNCATE(PVL_MEDIA, PVL_DECIMAIS);
   ELSE
      RETURN ROUND(PVL_MEDIA + 0.0000000001, PVL_DECIMAIS);
   END IF;
   
   
END//





CREATE FUNCTION `GET_PARAMETROS`(PDS_PARAMETRO VARCHAR(255))
    RETURNS varchar(255)
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN

   DECLARE DS_VALOR_PAR VARCHAR(255) DEFAULT NULL;
   
   SELECT ds_valor
     FROM parametros
    WHERE ds_variavel = PDS_PARAMETRO
     INTO DS_VALOR_PAR;
     
   RETURN DS_VALOR_PAR;

END//








CREATE PROCEDURE `DIA_CALCULO_MEDIA_FINAL`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_TURMA_MATRICULA VARCHAR(60), IN PCD_PESSOA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
sProc:BEGIN
  -- DECLARAR AS VARIAVEIS
  DECLARE PANR_BIMESTRES SMALLINT;
  DECLARE PASN_NOTAS, PASN_CONCEITOS, PASN_EXAME, PASN_2AEPOCA, PASN_TRUNCAR, PASN_FREQ_GLOBAL, PADS_FREQ_TIPO VARCHAR(1);
  DECLARE PADS_FORMULA_ANUAL, PADS_FORMULA_FINAL, PADS_APROVA_DIRETA, PADS_REPROVA_DIRETA, PADS_FORMULA_EXAME, PADS_FORMULA_2EPOCA, PADS_APROVA_EXAME, PADS_APROVA_2AEPOCA TEXT;
  DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE, PACD_SITU_APROVA, PACD_SITU_AEXAME, PACD_SITU_A2EPOCA, PANR_MAX_EXAME, PANR_MAX_2AEPOCA, VL_AUX SMALLINT;

  DECLARE VL_MEDIA, VL_FREQUENCIA DOUBLE;
  DECLARE VCD_DISCIPLINA INTEGER;
  
  DECLARE registros INTEGER DEFAULT NULL;
  
  DECLARE selectMedias CURSOR FOR
         SELECT DISCIPLINA, MEDIA
          FROM TMP_MEDIAFIM;

  -- CRIAR TABELA TEMPORARIA
  
  DROP TABLE IF EXISTS TMP_MEDIAFIM;
  CREATE TEMPORARY TABLE TMP_MEDIAFIM ( DISCIPLINA INTEGER(11), MEDIA DOUBLE );

  IF PCD_TURMA_MATRICULA IS NULL OR PCD_TURMA_MATRICULA = '' THEN
    SET PCD_TURMA_MATRICULA := PCD_TURMA;
  END IF;

  -- SELECIONAR OS PARAMETROS DE AVALIACAO

  SELECT ap.nr_avaliacoes
       , ap.ds_formula_media_anual
       , ap.ds_formula_media_final
       , ap.sn_notas
       , ap.sn_exame
       , ap.sn_segunda_epoca
       , ap.sn_conceitos
       , nr_casas_decimais
       , ap.sn_anual_truncar
       , ap.nr_casas_forcado_media
       , ap.tp_ajuste_forcado_media
       , ap.ds_cond_aprov_direta
       , ap.ds_cond_repro_direta
       , ap.sn_frequencia_global
       , ap.ds_frequencia_tipo
       , COALESCE(cd_situacao_aprov_direta, 0)
       , COALESCE(cd_situacao_aprov_exame, 0)
       , COALESCE(cd_situacao_aprov_2epoca, 0)
       , ap.nr_max_disci_exame
       , ap.nr_max_disci_segunda
       , ap.ds_formula_media_exame
       , ap.ds_formula_media_segunda
       , ap.ds_cond_aprov_exame
       , ap.ds_cond_aprov_segunda
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PANR_BIMESTRES
      , PADS_FORMULA_ANUAL
      , PADS_FORMULA_FINAL
      , PASN_NOTAS
      , PASN_EXAME
      , PASN_2AEPOCA
      , PASN_CONCEITOS
      , PAVL_DECIMAIS
      , PASN_TRUNCAR
      , PAVL_DECIMAIS_FORCE
      , PATP_DECIMAIS_FORCE
      , PADS_APROVA_DIRETA
      , PADS_REPROVA_DIRETA
      , PASN_FREQ_GLOBAL
      , PADS_FREQ_TIPO
      , PACD_SITU_APROVA
      , PACD_SITU_AEXAME
      , PACD_SITU_A2EPOCA
      , PANR_MAX_EXAME
      , PANR_MAX_2AEPOCA
      , PADS_FORMULA_EXAME
      , PADS_FORMULA_2EPOCA
      , PADS_APROVA_EXAME
      , PADS_APROVA_2AEPOCA;

  SET PADS_FORMULA_ANUAL := CONCAT('(', lower(PADS_FORMULA_ANUAL), ')');
  SET PADS_FORMULA_FINAL := CONCAT('(', lower(PADS_FORMULA_FINAL), ')');
  SET PADS_APROVA_DIRETA := CONCAT('(', lower(PADS_APROVA_DIRETA), ')');
  SET PADS_REPROVA_DIRETA := CONCAT('(', lower(PADS_REPROVA_DIRETA), ')');
  SET PADS_FORMULA_EXAME := CONCAT('(', lower(PADS_FORMULA_EXAME), ')');
  SET PADS_FORMULA_2EPOCA := CONCAT('(', lower(PADS_FORMULA_2EPOCA), ')');
  SET PADS_APROVA_EXAME := CONCAT('(', lower(PADS_APROVA_EXAME), ')');
  SET PADS_APROVA_2AEPOCA := CONCAT('(', lower(PADS_APROVA_2AEPOCA), ')');
   
  IF PANR_BIMESTRES IS NULL THEN
     LEAVE sProc;
  END IF;

  IF COALESCE(PADS_FORMULA_ANUAL, '') = '' AND (PASN_NOTAS = 'S') THEN
     LEAVE sProc;
  END IF;
  
  -- COLOCAR AS DISCIPLINAS NA SITUAÇÃO CURSANDO INICIALMENTE
  
  UPDATE fichaindividual
     SET situacao = 1
   WHERE anosemestre = PNR_ANOSEMESTRE
     AND Aproveitamento <> 'S'
     AND turma = PCD_TURMA
     AND turmamatricula = PCD_TURMA_MATRICULA
     AND codigoaluno = PCD_PESSOA
     AND situacao not in (3, 4, 5, 6, 7, 8, 10) ;
     
  -- IMPLEMENTAR RECUPERACAO SEMESTRAL **************************
  
  -- IMPLEMENTAR CALCULO DE MÉDIA PERIODICA
  
  IF PASN_NOTAS = 'S' THEN
     -- TEM NOTAS -
     
     -- CALCULAR A MEDIA ANUAL
     
     IF INSTR(PADS_FORMULA_ANUAL, 'mediainstitucional') <= 0 THEN
     
        SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
        SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_ANUAL, ') FROM fichaindividual ');
        SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
        SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
        
        PREPARE sqlUpdate FROM @sSql;
        EXECUTE sqlUpdate;
        DEALLOCATE PREPARE sqlUpdate;
        
     ELSE
        -- IMPLEMENTAR MEDIA COM PI
        SELECT 1;
     
     END IF;
     
     -- SELECIONAR A MÉDIA ANUAL DO TEMPORARIO
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;
         
         SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = IF(ISNULL(media_ajustada), ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE), ', media_ajustada)' );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;

         SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;
     
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS - 1
     
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -1, mediafinal = -1, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ');
     
     SET registros := 1;
     
     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-1');
        SET registros = registros + 1;
     END WHILE;
     

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS -2
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -2, mediafinal = -2, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ');

     SET registros := 1;

     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-2');
        SET registros = registros + 1;
     END WHILE;

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     

     -- CALCULO DA MEDIA FINAL ANTES DO EXAME
     
     TRUNCATE TMP_MEDIAFIM;
     
     SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
     SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_FINAL, ') FROM fichaindividual ');
     SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
     SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

         SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;

         SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;


  END IF; -- FIM SN_NOTAS
  
  -- CONVERTER NOTAS EM CONCEITO
  
  IF (PASN_NOTAS = 'S') AND (PASN_CONCEITOS = 'S') THEN
  
     UPDATE fichaindividual
      INNER JOIN turmas AS t ON (fi.turma = t.codigo AND fi.anosemestre = t.anosemestre)
       LEFT JOIN avaliacoes_conceitos AS ac ON (ac.cd_avaliacao = t.cd_avaliacao)
             AND ac.nr_inicial <= IFNULL(fi.mediaFinal, 0)
             AND ac.nr_final >= IFNULL(fi.mediaFinal, 0)
        SET ds_media = ac.ds_conceito
      WHERE fi.aproveitamento <> "S"
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.turma = PCD_TURMA;
  
  END IF;
  
  
  IF PASN_FREQ_GLOBAL = 'S' THEN
    IF PADS_FREQ_TIPO = 'C' THEN
       --  Pegar a Frequencia pela Carga Horaria
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN

          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(g.vl_valor) * 100)),2)
            FROM fichaindividual as f INNER JOIN turmas t ON (f.turma = t.codigo and f.anosemestre = t.anosemestre)
           INNER JOIN grades_disciplinas as g ON (g.cd_grade = t.cd_grade AND g.cd_curso = t.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = f.serie)
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;
            
           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           
       END IF;
    ELSE
       -- Pegar a Frequencia pelas Aulas Dadas
       
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN
       
          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(t.numeroaulas) * 100)),2)
            FROM fichaindividual f
           INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and  f.curso = t.curso and f.disciplina = t.disciplina and t.cd_categoria = 1 )
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;

           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           

       END IF;
    END IF;
  END IF;


  /* TRATAR AS CONDICOES QUANDO USA AS NOTAS PARCIAIS
  s_condicao_reprova := StringReplace(condicao_reprova, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_reprova := StringReplace(s_condicao_reprova, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_reprova := StringReplace(s_condicao_reprova, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  s_condicao_aprova := StringReplace(condicao_aprova, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_aprova := StringReplace(s_condicao_aprova, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_aprova := StringReplace(s_condicao_aprova, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  */
  
  -- VERIFICAR REPROVAÇÃO DIRETA
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = 9 ');
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_REPROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

  IF PASN_NOTAS = 'S' THEN

     SET @sSql := CONCAT(@sSql, ' AND ( mediafinal is not null ) AND (mediafinal >=0) ' );

  END IF;
  

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  
  -- VERIFICAR APROVACAO DIRETA

  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_APROVA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 9, 10) ');


  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  -- Se não possuem avaliacao por nota, termina por aqui
  IF PASN_NOTAS = 'N' THEN
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
     LEAVE sProc;
  END IF;
  
  -- TENTAR PASSAR O ESTUDANTE COM O PESO PARA ARREDONDAMENTO
  
  -- *** FALTA IMPLEMENTAR ****
  
  IF PASN_EXAME = 'N' THEN
  
     -- Se nao tem exame entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao not in (SELECT cd_situacao FROM situacao WHERE cd_situacao_pai IN(0, 1, 9))
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
        
     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM EXAME
  
  UPDATE fichaindividual fi
     SET fi.situacao = 2
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao <> 9
     AND fi.situacao NOT IN(SELECT cd_situacao FROM situacao WHERE cd_situacao_pai = 0) and fi.mediafinal is not null
     AND ( fi.mediafinal >=0)
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

  IF (PANR_MAX_EXAME > 0) AND (PANR_MAX_EXAME < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em exame - Verificar se o aluno ultrapassou
     
     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2
       INTO VL_AUX;
        
     IF VL_AUX > PANR_MAX_EXAME THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 2;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
           
        LEAVE sProc;
         
     END IF;

  END IF;
  
  -- CALCULAR MEDIA DE EXAME
  

  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'notaexame', 'IF(sn_faltou_exame = 1, 0, notaexame)');
  
  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_EXAME, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) AND (notaexame is not null OR sn_faltou_exame = 1) ');
  
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) and notaexame is not null ');

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  -- TENTAR APROVAR O ALUNO PELO EXAME
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_AEXAME);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_EXAME, ' AND situacao = 2 ');
  

  /* IMPLEMENTAR USO DA TABELA DAS NOTAS PARCIAIS
  
    if (Pos('menor_npns', s_condicao_exame) > 0) OR (Pos('maior_npns', s_condicao_exame) > 0) OR (Pos('media_npns', s_condicao_exame) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPNS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_nps', s_condicao_exame) > 0) OR (Pos('maior_nps', s_condicao_exame) > 0) OR (Pos('media_nps', s_condicao_exame) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_np', s_condicao_exame) > 0) OR (Pos('maior_np', s_condicao_exame) > 0) OR (Pos('media_np', s_condicao_exame) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NP, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', '', []);
  end;

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  s_condicao_exame := StringReplace(s_condicao_exame, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_exame := StringReplace(s_condicao_exame, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_exame := StringReplace(s_condicao_exame, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////

  */
  

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- TENTAR PASSAR O CARA PELO ARREDONDAMENTO APOS O EXAME
  
  -- FALTA IMPLEMENTAR ***********************
  
  IF PASN_2AEPOCA = 'N' THEN

     -- Se nao tem segunda epoca entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2 and fi.notaexame is not null
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);

     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM SEGUNDA EPOCA

  UPDATE fichaindividual fi
   INNER JOIN avaliacoes_parametros ap ON (fi.turma = ap.turma AND fi.anosemestre = ap.anosemestre)
     SET fi.situacao = 11
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 2
     AND (fi.mediafinal >=0)
     AND ( ( ap.sn_falta_exame_forca_2epoca = 1 AND (ap.sn_faltou_exame = 1 OR fi.notaexame IS NOT NULL) )
         OR (fi.notaexame is not null) );

  IF (PANR_MAX_2AEPOCA > 0) AND (PANR_MAX_2AEPOCA < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em segunda epoca - Verificar se o aluno ultrapassou

     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 11
       INTO VL_AUX;

     IF VL_AUX > PANR_MAX_2AEPOCA THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 11;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

        LEAVE sProc;
        
     ELSE
         -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
         -- IMPLEMENTAR **********************
         -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
         SELECT 1;

     END IF;
     
  ELSE
     -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
     -- IMPLEMENTAR **********************
     -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
     SELECT 1;

  END IF;
  
  
  -- CALCULAR MEDIA DE SEGUNDA EPOCA

  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_2EPOCA, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND fi.situacao = 11 and fi.segunda_epoca is not null ');
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND fi.situacao = 11 and fi.segunda_epoca is not null  ');
     
     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;

     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  
  -- TENTAR APROVAR O ALUNO PELO SEGUNDA EPOCA

  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_A2AEPOCA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_2AEPOCA, ' AND situacao = 11 and fi.segunda_epoca is not null ');
  
/*  IMPLEMENTAR CHECAGEM NAS TABELAS PARCIAIS

  if (Pos('menor_npns', s_condicao_segunda) > 0) OR (Pos('maior_npns', s_condicao_segunda) > 0) OR (Pos('media_npns', s_condicao_segunda) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPNS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_nps', s_condicao_segunda) > 0) OR (Pos('maior_nps', s_condicao_segunda) > 0) OR (Pos('media_nps', s_condicao_segunda) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_np', s_condicao_segunda) > 0) OR (Pos('maior_np', s_condicao_segunda) > 0) OR (Pos('media_np', s_condicao_segunda) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NP, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', '', []);
  end;

  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_segunda := StringReplace(s_condicao_segunda, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_segunda := StringReplace(s_condicao_segunda, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////

*/

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- IMPLEMENTAR
  -- TENTAR PASSAR PELO PELO DO ARREDONDAMENTO APOS EXAME
  
  
  -- REPROVAR AS DISCIPLINAS QUE FICARAM EM SEGUNDA EPOCA
  
  
  UPDATE fichaindividual fi
     SET fi.situacao = 9
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 11 and segunda_epoca is not null
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

 -- IMPLEMENTAR - CALCULO MÉDIA DO CURSO
 
 -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
 
 CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
  

END sProc//






CREATE PROCEDURE `DIA_SITUACAO_FINAL`(IN PCD_PESSOA INTEGER(11), IN PCD_TURMA VARCHAR(15), IN PNR_ANOSEMESTRE INTEGER(11))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE CD_SITU_CONCLUIDA, CD_SITUACAO, NR_QTD INTEGER(11) DEFAULT NULL ;
    
 -- SELECIONAR DO PARAMETRO DE AVALIACAO A SITUACAO DE CONCLUSAO (CASO EXISTA)
 SELECT ap.cd_situacao_concluida
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO CD_SITU_CONCLUIDA;


   IF CD_SITU_CONCLUIDA IS NOT NULL THEN
      --  EXISTE A SITUACAO DE CONCLUSAO NESTE CASO... 
      --  DEVE SER VERIFICADO SE O ALUNO CONCLUIU TODAS AS DISCIPLINAS
      
      SELECT COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
         and s.cd_situacao_pai in (1,2,11)
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO NR_QTD;
        
      IF NR_QTD >= 1 THEN
         -- NESTE CASO, O ALUNO CONTINUARA COM A SITUACAO ATIVA (CURSANDO)
         -- POIS EXISTE AINDA ALGUMA SITUACAO PENDENTE.
         
         SET CD_SITUACAO = 1;
      ELSE
         -- SE NÃO TEM NENHUMA SITUACAO PENDENTE, ENTÃO COLOCAR COMO CONCLUIDA
         
         SET CD_SITUACAO = CD_SITU_CONCLUIDA;
      END IF;
   ELSE
      -- SELECIONAR AS DISCIPLINAS DO ALUNO NA TURMA COM A QUANTIDADE EM CADA SITUACAO

      SELECT s.cd_situacao_pai, COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao AND s.nr_ordem_final is not null)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO CD_SITUACAO, NR_QTD;

   END IF;
   
   IF CD_SITUACAO IS NOT NULL THEN
   
      UPDATE MATRICULAS
         SET situacao = CD_SITUACAO
       WHERE situacao <> 10
         AND codigoaluno = PCD_PESSOA
         AND turma = PCD_TURMA
         AND anosemestre = PNR_ANOSEMESTRE;
         
   END IF;

END//]]></atualiza><atualiza codigo="{E5640482-8A88-4A62-A43C-1AC0A9622781}" protocolo="mysql-5"><![CDATA[ALTER TABLE cursos_coligadas ADD COLUMN SN_ATIVO SMALLINT(1) NOT NULL DEFAULT '1';]]></atualiza><atualiza codigo="{E5640482-8A88-4A62-A43C-1AC0A9622781}" protocolo="oracle"><![CDATA[ALTER TABLE cursos_coligadas ADD (SN_ATIVO NUMBER(5) DEFAULT '1' NOT NULL );]]></atualiza><atualiza codigo="{22825BCF-D594-474C-8B97-044E56CACA19}" protocolo="mysql-5"><![CDATA[ALTER TABLE parametros
DROP PRIMARY KEY,
ADD PRIMARY KEY (ds_variavel, cd_coligada);]]></atualiza><atualiza codigo="{22825BCF-D594-474C-8B97-044E56CACA19}" protocolo="oracle"><![CDATA[SELECT 1 FROM dual;]]></atualiza><atualiza codigo="{35777703-F19C-4DE8-9A65-CD4702DAEB5F}" protocolo="ansi"><![CDATA[DELETE from nu_menus where ds_texto like "%Início%";
DELETE from nu_menus where ds_url like "%unimestre1/profes%desemp%";

UPDATE nu_menus SET ds_url = '../../projetos/diario_classes/index.php?tid=0&lid=0&pid=diario_classes' where ds_url like "%conteudo/profes/diario/index.php%";
UPDATE nu_menus SET ds_url = '../../projetos/diario_classes/notas_frequencias_listar.php?tid=0&lid=0&pid=diario_classes' where ds_url like "%estuda_desemp_index.php%";
UPDATE nu_menus SET ds_url = '../../projetos/unimestre/dados_pessoa/pessoas_cadastro.php?tid=0&lid=0&pid=unimestre'  where ds_url like "%pessoa/altera/index.php%";

UPDATE nu_menus SET ds_texto = REPLACE(REPLACE(ds_texto,'<br>',' '),'<BR>','') where ds_texto like "%<br>%";]]></atualiza><atualiza codigo="{B3E83791-A484-4D4A-8364-E63B8A14FD36}" protocolo="mysql-5"><![CDATA[CREATE OR REPLACE VIEW CURSOS
AS
SELECT
	t.anosemestre AS ANOSEMESTRE,
	cc.CD_CURSO AS CODIGO,
	cm.DS_APELIDO AS APELIDO,
	cast(cm.DS_CURSO as char charset latin1) AS DESCRICAO,
	cm.NR_GRAU AS GRAU,
	cast(NULL as char charset latin1) AS PARECERAUTORIZACAO,
	cast(NULL as char charset latin1) AS PARECERRECONHECIMENTO,
	cast(NULL as datetime) AS DATACEE,
	cc.NR_CARGA_HORARIA AS CARGAHORARIATOTAL,
	cc.NR_DIAS_LETIVOS AS DIASLETIVOS,
	cast(NULL as signed) AS SEMANASLETIVAS,
	cast(NULL as signed) AS DIASSEMANASLETIVAS,
	cast(NULL as signed) AS HORARIOLETIVO,
	cc.NR_DURACAO_AULA AS DURACAOHORAAULA,
	cast(NULL as signed) AS DIASLETIVOSSEMANAIS,
	cc.NR_SERIES AS NUMERODESERIES,
	cc.DS_NOME_ETAPA AS NOME_ETAPA,
	cc.DS_CONTRATO AS CONTRATO,
	cast(NULL as signed) AS QTADEBIMESTRES,
	cc.CD_DEPTO AS DEPTO,
	cast(NULL as signed) AS SEMANASLETIVASV,
	cast(NULL as signed) AS SEMANASLETIVASN,
	cc.DS_REQUERIMENTO AS REQUERIMENTO,
	cast(NULL as char charset latin1) AS SENHA,
	cast(NULL as char charset latin1) AS SENHAPROVISORIA,
	cast(NULL as signed) AS CD_REGIMENTO,
	cast(NULL as signed) AS CD_EDITAL,
	cast(NULL as signed) AS CD_INSTRU_GERAIS,
	cc.CD_CURSO_EQUIVALENTE AS CD_CURSO_EQUIVALENTE,
	cc.CD_CURSO_MEC AS MEC_CD_CURSO,
	cc.CD_HABILITACAO_MEC AS MEC_CD_HABILITACAO,
	cc.CD_GRAU_MEC AS MEC_CD_GRAU,
	cast(NULL as datetime) AS DT_RESULTADO_FINAL,
	cast(NULL as char charset latin1) AS CLI_MOSTRAR_SITE,
	cast(NULL as char charset latin1) AS DS_HABILITACAO,
	cc.CD_GRADE AS CD_GRADE,cc.CD_CURSO AS CD_CURSO,
	cc.ME_OBSERVACOES AS OBSERVACOES,
	cc.SN_ACADEMICO AS SN_ACADEMICO,
	cc.CD_COLIGADA AS CD_COLIGADA
FROM
	cursos_mestre cm
	INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO AND cc.SN_ATIVO = 1)
	INNER JOIN turmas t ON (t.CURSO = cc.CD_CURSO AND t.CD_COLIGADA = cc.CD_COLIGADA)
GROUP BY
	t.anosemestre, cc.CD_CURSO, cc.CD_COLIGADA;]]></atualiza><atualiza codigo="{B3E83791-A484-4D4A-8364-E63B8A14FD36}" protocolo="oracle"><![CDATA[CREATE OR REPLACE VIEW CURSOS
AS
SELECT
	t.anosemestre AS ANOSEMESTRE, 
	cc.CD_CURSO AS CODIGO,
	FIRST_OCCURRENCE(cm.DS_APELIDO) AS APELIDO, 
	FIRST_OCCURRENCE(cm.DS_CURSO) AS DESCRICAO, 
	CAST(FIRST_OCCURRENCE(cm.NR_GRAU) AS NUMBER(5)) AS GRAU,	
	NULL AS PARECERAUTORIZACAO,
	NULL AS PARECERRECONHECIMENTO,
	NULL AS DATACEE,
	FIRST_OCCURRENCE(cc.NR_CARGA_HORARIA) AS CARGAHORARIATOTAL,
	FIRST_OCCURRENCE(cc.NR_DIAS_LETIVOS) AS DIASLETIVOS,
	CAST(NULL AS NUMBER(9)) AS SEMANASLETIVAS,
	NULL AS DIASSEMANASLETIVAS,
	NULL AS HORARIOLETIVO,
	FIRST_OCCURRENCE(cc.NR_DURACAO_AULA) AS DURACAOHORAAULA,
	NULL AS DIASLETIVOSSEMANAIS,
	FIRST_OCCURRENCE(cc.NR_SERIES) AS NUMERODESERIES,
	FIRST_OCCURRENCE(cc.DS_NOME_ETAPA) AS NOME_ETAPA,
	FIRST_OCCURRENCE(cc.DS_CONTRATO) AS CONTRATO,
	NULL AS QTADEBIMESTRES,
	CAST(FIRST_OCCURRENCE(cc.CD_DEPTO) AS NUMBER(9)) AS DEPTO,
	NULL AS SEMANASLETIVASV,
	NULL AS SEMANASLETIVASN,
	FIRST_OCCURRENCE(cc.DS_REQUERIMENTO) AS REQUERIMENTO,
	NULL AS SENHA,
	NULL AS SENHAPROVISORIA,
	NULL AS CD_REGIMENTO,
	NULL AS CD_EDITAL,
	NULL AS CD_INSTRU_GERAIS,
	FIRST_OCCURRENCE(cc.CD_CURSO_EQUIVALENTE) AS CD_CURSO_EQUIVALENTE,
	FIRST_OCCURRENCE(cc.CD_CURSO_MEC) AS MEC_CD_CURSO,
	FIRST_OCCURRENCE(cc.CD_HABILITACAO_MEC) AS MEC_CD_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRAU_MEC) AS MEC_CD_GRAU,
	NULL AS DT_RESULTADO_FINAL,
	NULL AS CLI_MOSTRAR_SITE,
	NULL AS DS_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRADE) AS CD_GRADE,
	FIRST_OCCURRENCE(cc.CD_CURSO) AS CD_CURSO,
	FIRST_OCCURRENCE(cc.ME_OBSERVACOES) AS OBSERVACOES,
	FIRST_OCCURRENCE(cc.SN_ACADEMICO) AS SN_ACADEMICO,
	cc.CD_COLIGADA
FROM
	cursos_mestre cm
	INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO AND cc.SN_ATIVO = 1)
	INNER JOIN turmas t ON (t.CURSO = cc.CD_CURSO AND t.CD_COLIGADA = cc.CD_COLIGADA)
GROUP BY
	t.anosemestre, cc.CD_CURSO, cc.CD_COLIGADA;]]></atualiza><atualiza codigo="{1B375A98-9E04-48BA-A7E3-D75450ABF06A}" protocolo="mysql-5"><![CDATA[ALTER TABLE matriculas MODIFY COLUMN cd_matricula_curso int(11) UNSIGNED NULL DEFAULT NULL;]]></atualiza><atualiza codigo="{1B375A98-9E04-48BA-A7E3-D75450ABF06A}" protocolo="oracle"><![CDATA[SELECT 1 FROM dual;]]></atualiza><atualiza codigo="{622B835F-E974-4508-8B47-D37F656615B6}" protocolo="ansi"><![CDATA[ALTER TABLE `pessoas` CHANGE `cd_localidade_nasc` `cd_localidade_nasc` INT(11) NULL;]]></atualiza><atualiza codigo="{A1E4EC59-3D52-4D02-9BDF-7D6F4F90A9E4}" protocolo="ansi"><![CDATA[DELIMITER //

DROP PROCEDURE IF EXISTS `DIA_CALCULO_MEDIA_DISCIPLINA`//
CREATE PROCEDURE `DIA_CALCULO_MEDIA_DISCIPLINA`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA TINYINT, IN PCD_PESSOA INTEGER(11), IN PDS_FORMULA VARCHAR(255))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
BEGIN
-- esta funcao retorna o valor da me'dia calculada, conforme a formula passada
 -- se a formula nao for passada ela utilizará a formula do diario_turmas

 DECLARE VL_NOTA_MENOR, VL_NOTA_RE, VL_MEDIA_MAXIMA, VL_NOTA_PROFICIENCIA, VL_AJUSTE, VL_NOTA_FINAL, VL_NOTA_FIXA_ETAPA, VL_MEDIA_CALCULADA, VL_NOTA_AUX DOUBLE;

 DECLARE VNR_NOTA, VNR_NOTA_RE, VNR_NOTA_AUX INTEGER(11);
 DECLARE VNR_NOTA_MENOR, VSN_COMPOE INTEGER(11);
 DECLARE SN_PROFICIENCIA CHAR(1) DEFAULT 'N';
 DECLARE DS_FORMULA_ORIGINAL, DS_FORMULA_AUX MEDIUMTEXT DEFAULT NULL;
 
 -- DECLARA TODOS OS CAMPOS EXISTENTE NA TABELA AVALIACOES_PARAMETROS
 DECLARE PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PADS_FORMULA_RE, PADS_CONDICAO_RE MEDIUMTEXT;
 DECLARE PASN_CONVERTER_NOTAS_NULAS MEDIUMTEXT;
 DECLARE PASN_TRUNCAR VARCHAR(1);
 DECLARE PASN_AJUSTE_APOS_RE, PATP_DECIMAIS_FORCE TINYINT(1);
 DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE INTEGER(11);

 DECLARE registros INTEGER DEFAULT NULL;

 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA EH CUSTOMIZADA
 DECLARE selectNotas CURSOR FOR
         SELECT nro_nota, sn_compoe FROM diario_provas
         WHERE sn_especial = 0
           AND sn_proficiencia = 0
           AND anosemestre = PNR_ANOSEMESTRE
           AND bimestre = PNR_ETAPA
           AND turma = PCD_TURMA
           AND disciplina = PCD_DISCIPLINA
         ORDER BY nro_nota DESC;
         
 -- DECLARA O CURSOS PARA DESCOBRIR AS NOTAS SUBSTITUIVEIS - PEGAR MENOR NOTA
         
 DECLARE selectMenor CURSOR FOR
         SELECT DP.nro_nota
              , IFNULL(DPA.VL_NOTA, 0)
           FROM DIARIO_PROVAS AS DP
           LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
                 AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
          WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1
            AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
            AND DP.BIMESTRE = PNR_ETAPA
            AND DP.TURMA = PCD_TURMA
            AND DP.DISCIPLINA = PCD_DISCIPLINA
          ORDER BY DP.nro_nota;

  -- DECLARE que será chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
  DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM tmp_medias;

 -- Criar tabela temporaria para auxiliar nos calculos

 SET DS_FORMULA_ORIGINAL := PDS_FORMULA;
 SET DS_FORMULA_ORIGINAL := REPLACE(DS_FORMULA_ORIGINAL, ",", ".");
 SET DS_FORMULA_ORIGINAL := REPLACE(DS_FORMULA_ORIGINAL, ";", ",");


 -- Por padrão a procedure sempre vai tentar criar  a tabela, se ela já existir vai gerar o erro 42S01, chamando o declare continue handle acima.
 CREATE TEMPORARY TABLE TMP_MEDIAS ( MEDIA DOUBLE );

 -- CARREGA TODOS OS CAMPOS DA TABELA DE AVALIACOES_PARAMETROS NO DECLARES
 SELECT ap.cd_avaliacao
      , ap.nr_media_proficiencia
      , ap.sn_converter_notas_nulas
      , ap.sn_notas_truncar
      , ap.nr_casas_decimais
      , ap.sn_ajuste_apos_recuperacao
      , ap.ds_formula_recuperacao
      , ap.ds_criterio_recuperacao
      , ap.nr_casas_decimais_forcado
      , ap.tp_ajuste_forcado
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PASN_CONVERTER_NOTAS_NULAS, PASN_TRUNCAR, PAVL_DECIMAIS
       , PASN_AJUSTE_APOS_RE, PADS_FORMULA_RE, PADS_CONDICAO_RE, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE;
       
 -- Verifica se existe Parametro de Avaliacao
 IF ( PACD_AVALIACAO IS NULL ) THEN
    SET VL_MEDIA_CALCULADA := NULL;
 END IF;

 -- Verificar se existe Prova de Proficiencia
 SET VNR_NOTA := NULL;
 
 SELECT dp.nro_nota
   FROM diario_provas dp
  WHERE dp.anosemestre = PNR_ANOSEMESTRE
    AND dp.bimestre = PNR_ETAPA
    AND dp.turma = PCD_TURMA
    AND dp.disciplina = PCD_DISCIPLINA
    AND dp.sn_proficiencia = 1
   INTO VNR_NOTA;

 -- Se tiver nota de proficiencia, faz a verificacao das provas do aluno
 IF ( VNR_NOTA > 0 ) THEN
    SELECT dpa.vl_nota
      FROM diario_provas_alunos dpa
     WHERE dpa.nr_anosem = PNR_ANOSEMESTRE
       AND dpa.cd_bimestre = PNR_ETAPA
       AND dpa.cd_turma = PCD_TURMA
       AND dpa.cd_disciplina = PCD_DISCIPLINA
       AND dpa.cd_pessoa = PCD_PESSOA
       AND dpa.nr_prova = VNR_NOTA
      INTO VL_NOTA_PROFICIENCIA;

    -- Se passou na proficiencia
    IF ( VL_NOTA_PROFICIENCIA >= PANR_MEDIA_PROFICIENCIA ) THEN
       SET VL_MEDIA_CALCULADA := VL_NOTA_PROFICIENCIA;
    END IF;
 END IF;
 -- SE NAO FOR PROVA DE SUFICIENCIA... continuar


 -- SE FOR FORMULA ARITMETICA DAS NOTAS DIGITADAS
 IF ( PDS_FORMULA = 'ARITMETICA' ) THEN
 
    -- MONTAR A FORMULA PARA MEDIA ARITMETICA

    SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 1 THEN
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(*))

           ELSE
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(DPA.VL_NOTA))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;


 -- SE NAO VERIFICA SE EH FORMULA MEDIA_PESO
 ELSEIF PDS_FORMULA = 'MEDIA_PESO' THEN

  SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 0 THEN
                     CASE WHEN COUNT(*) != COUNT(DPA.VL_NOTA) THEN
                               NULL
                     ELSE
                               CONCAT('(',GROUP_CONCAT(CONCAT('NOTA', DP.nro_nota,'*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( DP.VL_PESO ) )
                     END
           ELSE
                     CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota,',0)*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( COALESCE( DP.VL_PESO, 1 ) ))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;

 ELSEIF PDS_FORMULA = 'ZERAR' OR PDS_FORMULA = '' THEN
    SET VL_MEDIA_CALCULADA := NULL;

 -- Formula montada
 END IF;

 -- INICIAR O CALCULO DA FORMULA MONTADA

 -- CRIA UM BACKUP DA FORMULA

 SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

 OPEN selectNotas;

 SELECT FOUND_ROWS() INTO registros;

 WHILE registros > 0 DO
    FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

    SELECT COALESCE( dpa.vl_nota, 0 )
      FROM diario_provas_alunos dpa
     WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
       AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
       AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
      INTO VL_NOTA_AUX;

    SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );
    SET VL_NOTA_AUX := NULL;
    SET registros = registros - 1;

 END WHILE;

 CLOSE selectNotas;
 
-- Atualizar o resultado do calculo em uma tabela temporaria

 IF DS_FORMULA_AUX IS NOT NULL THEN

-- Inserir o resultado da formula montada na TMP_MEDIA e posteriormente resgatar essa informacao junto com o AJUSTE

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (', DS_FORMULA_AUX , ')' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;
    
    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_MEDIA_CALCULADA;
      
    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 ELSE

--  Neste caso a nota do professor ja esta calculada, basta buscar o AJUSTE

    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 END IF;
 
-- buscar o ajuste

 TRUNCATE TMP_MEDIAS;

 SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS (MEDIA) SELECT ajuste', PNR_ETAPA, ' FROM fichaindividual WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '="N" AND aproveitamento="N";' );
 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;

 SELECT MEDIA
   FROM TMP_MEDIAS
   INTO VL_AJUSTE;

 
-- VL_NOTA_FIXA_ETAPA: mantem o valor da nota calculada do professor antes do ajuste
-- VL_AJUSTE: Possui o valor do ajuste DIGITADO para este aluno

-- Verificar se tera nota de recuperacao


 -- Verificar se existe Prova de Recuperacao e buscar a nota do aluno
 SET VNR_NOTA_RE := NULL;
 

 SELECT DP.nro_nota
      , DPA.VL_NOTA
   FROM DIARIO_PROVAS AS DP
   LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
         AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
  WHERE DP.SN_ESPECIAL = 1 
    AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
    AND DP.BIMESTRE = PNR_ETAPA
    AND DP.TURMA = PCD_TURMA
    AND DP.DISCIPLINA = PCD_DISCIPLINA
   INTO VNR_NOTA_RE, VL_NOTA_RE;
   

  IF (VNR_NOTA_RE IS NULL) OR (VL_NOTA_RE IS NULL) THEN
     -- NAOTEM nota de recuperacao
     SET VL_NOTA_FINAL := VL_NOTA_FIXA_ETAPA;
  ELSE
     -- TEM NOTA DE RECUPERACAO
     IF (PASN_AJUSTE_APOS_RE = 0) THEN
        SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE, 0);
        SET VL_MEDIA_CALCULADA := VL_MEDIA_CALCULADA + IFNULL(VL_AJUSTE, 0);
     END IF;
     
     IF (PADS_FORMULA_RE = 'SUBSTITUIR_MENOR') THEN
     
     -- DESCOBRIR QUAL A MENOR NOTA DAS SUBSTITUIVEIS

        OPEN selectMenor;

        SELECT FOUND_ROWS() INTO registros;
        
        SET VL_NOTA_MENOR := 999999;
        SET VNR_NOTA_MENOR := NULL;
        
        SET VNR_NOTA_AUX := NULL;
        SET VL_NOTA_AUX := NULL;

        WHILE registros > 0 DO
        
            FETCH selectMenor INTO VNR_NOTA_AUX, VL_NOTA_AUX;
            
            IF (VL_NOTA_AUX < VL_NOTA_MENOR) AND (VL_NOTA_AUX < VL_NOTA_RE) THEN
               SET VL_NOTA_MENOR := VL_NOTA_AUX;
               SET VNR_NOTA_MENOR := VNR_NOTA_AUX;
            END IF;
            
            SET registros = registros - 1;

        END WHILE;
        
        CLOSE selectMenor;
        
        -- A VARIAVEL VNR_NOTA_MENOR representa o numero da prova que tem a menor nota
        
        -- Efetuar a substituicao da menor nota na formula

        
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;
           
           IF ( VNR_NOTA = VNR_NOTA_MENOR) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;
                
           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;
        
        -- MONTAR A CONDICAO PARA RECUPERACAO - O MEDIA TEM QUE SER MAIOR
        
        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSEIF (PADS_FORMULA_RE = 'SUBSTITUIR_TODAS') THEN
    
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
        
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

           IF ( VSN_COMPOE = 1) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;

           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;

        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSE
       -- VERIFICAR AS OUTRAS FORMULAS DE RECUPERAÇÃO
       -- TROCAR AS PALAVRAS RESERVADAS RB / NOTAP / MEDIA_SUBSTITUIVEIS / MEDIA_NAO_SUBSTITUIVEIS
       
       SET DS_FORMULA_AUX := PADS_FORMULA_RE;
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, ",", ".");
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, ";", ",");

       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'RB', VL_NOTA_RE);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'RB', VL_NOTA_RE);
       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS SUBSTITUIVEIS NAO NULAS
          
          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;
            
            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
       
       END IF;
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS NAO SUBSTITUIVEIS NAO NULAS

          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 0 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;

            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);

       END IF;
       

    END IF;
     
-- Executar a formula de recuperacao

    TRUNCATE TMP_MEDIAS;

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (IF(', IFNULL(PADS_CONDICAO_RE, 'NULL'), ', ', IFNULL(DS_FORMULA_AUX, 'NULL') , ', ', IFNULL(VL_NOTA_FIXA_ETAPA, 'NULL'), ') )' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;

    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_NOTA_FINAL;
      
  END IF;

  IF ((PASN_AJUSTE_APOS_RE = 1) OR (VNR_NOTA_RE IS NULL) ) THEN

     SET VL_NOTA_FINAL := VL_NOTA_FINAL + IFNULL(VL_AJUSTE,0);
     SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE,0);
  END IF;
  
  -- Verificar se o aluno tem COMPLEMENTO DE MEDIA
  
  SET VL_MEDIA_CALCULADA := 0;
  
  SELECT IFNull(SUM(aa.NT_AJUSTE),0)
    FROM DIARIO_AJUSTES_ALUNOS aa
   INNER JOIN DIARIO_AJUSTES_TURMAS at ON (aa.cd_ajuste_turma = at.cd_ajuste_turma)
   WHERE aa.cd_pessoa = PCD_PESSOA
     AND at.cd_turma = PCD_TURMA
     AND at.nr_anosem = PNR_ANOSEMESTRE
     AND at.nr_etapa = PNR_ETAPA
     AND aa.nt_ajuste is not null				
    INTO VL_MEDIA_CALCULADA;
    
 SET VL_NOTA_FINAL := VL_NOTA_FINAL + COALESCE(VL_MEDIA_CALCULADA, 0);
				
 -- Gravar as informacoes na fichaindividual


 SET @sSql := CONCAT('UPDATE fichaindividual SET nota', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FIXA_ETAPA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', nota_d', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FINAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', exame', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_RE, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '="N" AND aproveitamento="N";' );
 

 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;

 CALL DIA_CALCULO_MEDIA_FINAL(PNR_ANOSEMESTRE, PCD_TURMA, PCD_TURMA, PCD_PESSOA);
END//



DROP PROCEDURE IF EXISTS `DIA_MEDIA_TURMA`//
CREATE PROCEDURE `DIA_MEDIA_TURMA`(IN PCD_TURMA VARCHAR(15), IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA INTEGER(11), IN PDS_FORMULA VARCHAR(255))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE PACD_AVALIACAO MEDIUMTEXT;
 DECLARE registros INTEGER DEFAULT NULL;
 
 DECLARE VCD_ALUNO INTEGER DEFAULT NULL;
  
 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA Eh CUSTOMIZADA
 DECLARE selectAlunos CURSOR FOR
         SELECT codigoaluno FROM fichaindividual
          WHERE anosemestre = PNR_ANOSEMESTRE
            AND turma = PCD_TURMA
            AND disciplina = PCD_DISCIPLINA
            AND aproveitamento = "N"
         ORDER BY codigoaluno DESC;
		 
 IF PDS_FORMULA = 'NULL' THEN
      SELECT 
         formula_media 
      FROM 
         diario_turmas 
      WHERE 
         turma LIKE PCD_TURMA AND 
         anosemestre = PNR_ANOSEMESTRE AND 
         disciplina = PCD_DISCIPLINA AND 
         bimestre = PNR_ETAPA INTO PDS_FORMULA;
 END IF;		 

 -- VERIFICA SE EXISTE O PARAMETRO DE AVALIAÇÃO
 SELECT ap.cd_avaliacao
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO;

 IF ( PACD_AVALIACAO IS NOT NULL ) THEN
-- SE EXISTE PARAMETRO DE AVALIACAO, GUARDAR A FORMULA NO DIARIO

    IF PDS_FORMULA = 'ZERAR' THEN
    
       UPDATE diario_turmas
          SET formula_media = NULL
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    ELSE
    
       UPDATE diario_turmas
          SET formula_media = PDS_FORMULA
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    END IF;

    OPEN selectAlunos;

    SELECT FOUND_ROWS() INTO registros;

    WHILE registros > 0 DO
        FETCH selectAlunos INTO VCD_ALUNO;
            
        CALL DIA_CALCULO_MEDIA_DISCIPLINA(PNR_ANOSEMESTRE, PCD_TURMA, PCD_DISCIPLINA, PNR_ETAPA, VCD_ALUNO, PDS_FORMULA);

        SET registros = registros - 1;

    END WHILE;

    CLOSE selectAlunos;
          
 END IF;

END//




DROP FUNCTION IF EXISTS `DIA_ARREDONDA_FORCADO`//
CREATE FUNCTION `DIA_ARREDONDA_FORCADO`(PVL_NOTA DOUBLE, PNR_PRECISAO SMALLINT, PTP_DIRECAO TINYINT(1))
    RETURNS double
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE dFracao, dDif DOUBLE;
   DECLARE dDiv1, dDiv2, dDiv3, dDiv4 DOUBLE;
   DECLARE AMult INTEGER(11);

   -- Direcao:   1 = Para cima,  2 = Para Baixo,  3 = Ambos
   SET dFracao := PVL_NOTA - TRUNCATE(PVL_NOTA, (PNR_PRECISAO-1));

   -- Sem nenhuma casa decimal - deve arredondar de forma diferenciada
   IF PNR_PRECISAO = 0 THEN

      IF (PTP_DIRECAO = 2) OR (dFracao = 0) THEN
         SET dDif := - dFracao;
      ELSEIF (PTP_DIRECAO = 1) THEN
         SET dDif := (1 - dFracao);
      ELSE
         IF (dFracao < 0.5) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (1 - dFracao);
         END IF;
      END IF;


   ELSE


     SET AMult := TRUNCATE(POWER(10.0, PNR_PRECISAO),0);

      SET dDiv1 := 2.5 / AMult;
      SET dDiv2 := 5 / AMult;
      SET dDiv3 := 7.5 / AMult;
      SET dDiv4 := 10 / AMult;

      IF (dFracao < dDiv1) THEN -- menor que 2.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) OR (dFracao = 0) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (dDiv2 - dFracao);
         END IF;
      ELSEIF ((dFracao >= dDiv1) and (dFracao <= dDiv2)) THEN -- maior que 2.5 e menor que 5
         IF (PTP_DIRECAO = 1 OR PTP_DIRECAO = 3) OR (dFracao = dDiv2) THEN
            SET dDif := (dDiv2 - dFracao);
         ELSE
            SET dDif := -dFracao;
         END IF;
      ELSEIF ((dFracao > dDiv2) and (dFracao < dDiv3)) THEN -- maior que 5 e menor que 7.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) THEN
            SET dDif := - (dFracao - dDiv2);
         ELSE
            SET dDif := (dDiv4 - dFracao);
         END IF;
      ELSEIF (dFracao >= dDiv3) THEN -- maior que 7.5
         IF PTP_DIRECAO = 1 OR PTP_DIRECAO = 3 THEN
            SET dDif := + (dDiv4 - dFracao);
         ELSE
            SET dDif := dDiv2 - dFracao;
         END IF;
      END IF;

   END IF;

   RETURN ROUND(PVL_NOTA + dDif, PNR_PRECISAO);

END//





DROP FUNCTION IF EXISTS `DIA_FORMATAR_MEDIA`//
CREATE FUNCTION `DIA_FORMATAR_MEDIA`(PVL_MEDIA DOUBLE, PSN_TRUNCAR CHAR(1), PVL_DECIMAIS SMALLINT, PVL_DECIMAIS_FORCE SMALLINT, PTP_DECIMAIS_FORCE TINYINT(1))
    RETURNS varchar(10)
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE VL_MEDIA_MAXIMA DOUBLE;
   
   IF ISNULL(PVL_MEDIA) THEN
      RETURN 'NULL';
   END IF;

-- VERIFICAR SE A MEDIA EH SUPERIOR AO MAXIMO PERMITIDO
   SET VL_MEDIA_MAXIMA := GET_PARAMETROS('valor_maximo_medias');

   IF ( (VL_MEDIA_MAXIMA IS NOT NULL) AND (PVL_MEDIA > VL_MEDIA_MAXIMA) )  THEN
   
      SET PVL_MEDIA := VL_MEDIA_MAXIMA;
      
   END IF;
   
   IF PVL_DECIMAIS_FORCE IS NOT NULL THEN

      SET PVL_MEDIA := DIA_ARREDONDA_FORCADO(PVL_MEDIA, PVL_DECIMAIS_FORCE, PTP_DECIMAIS_FORCE);

   END IF;
   -- Implementar o arredondamento forcado
   
   IF PSN_TRUNCAR = 1 THEN
      RETURN TRUNCATE(PVL_MEDIA, PVL_DECIMAIS);
   ELSE
      RETURN ROUND(PVL_MEDIA + 0.0000000001, PVL_DECIMAIS);
   END IF;
   
   
END//




DROP FUNCTION IF EXISTS `GET_PARAMETROS`//
CREATE FUNCTION `GET_PARAMETROS`(PDS_PARAMETRO VARCHAR(255))
    RETURNS MEDIUMTEXT
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN

   DECLARE DS_VALOR_PAR MEDIUMTEXT DEFAULT NULL;
   
   SELECT ds_valor
     FROM parametros
    WHERE ds_variavel = PDS_PARAMETRO
     INTO DS_VALOR_PAR;
     
   RETURN DS_VALOR_PAR;

END//







DROP PROCEDURE IF EXISTS `DIA_CALCULO_MEDIA_FINAL`//
CREATE PROCEDURE `DIA_CALCULO_MEDIA_FINAL`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_TURMA_MATRICULA VARCHAR(60), IN PCD_PESSOA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
sProc:BEGIN
  -- DECLARAR AS VARIAVEIS
  DECLARE PANR_BIMESTRES SMALLINT;
  DECLARE PASN_NOTAS, PASN_CONCEITOS, PASN_EXAME, PASN_2AEPOCA, PASN_TRUNCAR, PASN_FREQ_GLOBAL, PADS_FREQ_TIPO VARCHAR(1);
  DECLARE PADS_FORMULA_ANUAL, PADS_FORMULA_FINAL, PADS_APROVA_DIRETA, PADS_REPROVA_DIRETA, PADS_FORMULA_EXAME, PADS_FORMULA_2EPOCA, PADS_APROVA_EXAME, PADS_APROVA_2AEPOCA TEXT;
  DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE, PACD_SITU_APROVA, PACD_SITU_AEXAME, PACD_SITU_A2EPOCA, PANR_MAX_EXAME, PANR_MAX_2AEPOCA, VL_AUX SMALLINT;

  DECLARE VL_MEDIA, VL_FREQUENCIA DOUBLE;
  DECLARE VCD_DISCIPLINA INTEGER;
  
  DECLARE registros INTEGER DEFAULT NULL;
  
  DECLARE selectMedias CURSOR FOR
         SELECT DISCIPLINA, MEDIA
          FROM TMP_MEDIAFIM;

  -- DECLARE que será chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
  DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM TMP_MEDIAFIM;

  -- CRIAR TABELA TEMPORARIA
  
  -- Por padrão a procedure sempre vai tentar criar  a tabela, se ela já existir vai gerar o erro 42S01, chamando o declare continue handle acima.
  CREATE TEMPORARY TABLE TMP_MEDIAFIM ( DISCIPLINA INTEGER(11), MEDIA DOUBLE );

  IF PCD_TURMA_MATRICULA IS NULL OR PCD_TURMA_MATRICULA = '' THEN
    SET PCD_TURMA_MATRICULA := PCD_TURMA;
  END IF;

  -- SELECIONAR OS PARAMETROS DE AVALIACAO

  SELECT ap.nr_avaliacoes
       , ap.ds_formula_media_anual
       , ap.ds_formula_media_final
       , ap.sn_notas
       , ap.sn_exame
       , ap.sn_segunda_epoca
       , ap.sn_conceitos
       , nr_casas_decimais
       , ap.sn_anual_truncar
       , ap.nr_casas_forcado_media
       , ap.tp_ajuste_forcado_media
       , ap.ds_cond_aprov_direta
       , ap.ds_cond_repro_direta
       , ap.sn_frequencia_global
       , ap.ds_frequencia_tipo
       , COALESCE(cd_situacao_aprov_direta, 0)
       , COALESCE(cd_situacao_aprov_exame, 0)
       , COALESCE(cd_situacao_aprov_2epoca, 0)
       , ap.nr_max_disci_exame
       , ap.nr_max_disci_segunda
       , ap.ds_formula_media_exame
       , ap.ds_formula_media_segunda
       , ap.ds_cond_aprov_exame
       , ap.ds_cond_aprov_segunda
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PANR_BIMESTRES
      , PADS_FORMULA_ANUAL
      , PADS_FORMULA_FINAL
      , PASN_NOTAS
      , PASN_EXAME
      , PASN_2AEPOCA
      , PASN_CONCEITOS
      , PAVL_DECIMAIS
      , PASN_TRUNCAR
      , PAVL_DECIMAIS_FORCE
      , PATP_DECIMAIS_FORCE
      , PADS_APROVA_DIRETA
      , PADS_REPROVA_DIRETA
      , PASN_FREQ_GLOBAL
      , PADS_FREQ_TIPO
      , PACD_SITU_APROVA
      , PACD_SITU_AEXAME
      , PACD_SITU_A2EPOCA
      , PANR_MAX_EXAME
      , PANR_MAX_2AEPOCA
      , PADS_FORMULA_EXAME
      , PADS_FORMULA_2EPOCA
      , PADS_APROVA_EXAME
      , PADS_APROVA_2AEPOCA;

  SET PADS_FORMULA_ANUAL := CONCAT('(', lower(PADS_FORMULA_ANUAL), ')');
  SET PADS_FORMULA_FINAL := CONCAT('(', lower(PADS_FORMULA_FINAL), ')');
  SET PADS_APROVA_DIRETA := CONCAT('(', lower(PADS_APROVA_DIRETA), ')');
  SET PADS_REPROVA_DIRETA := CONCAT('(', lower(PADS_REPROVA_DIRETA), ')');
  SET PADS_FORMULA_EXAME := CONCAT('(', lower(PADS_FORMULA_EXAME), ')');
  SET PADS_FORMULA_2EPOCA := CONCAT('(', lower(PADS_FORMULA_2EPOCA), ')');
  SET PADS_APROVA_EXAME := CONCAT('(', lower(PADS_APROVA_EXAME), ')');
  SET PADS_APROVA_2AEPOCA := CONCAT('(', lower(PADS_APROVA_2AEPOCA), ')');
   
  IF PANR_BIMESTRES IS NULL THEN
     LEAVE sProc;
  END IF;

  IF COALESCE(PADS_FORMULA_ANUAL, '') = '' AND (PASN_NOTAS = 'S') THEN
     LEAVE sProc;
  END IF;
  
  -- COLOCAR AS DISCIPLINAS NA SITUAÇÃO CURSANDO INICIALMENTE
  
  UPDATE fichaindividual
     SET situacao = 1
   WHERE anosemestre = PNR_ANOSEMESTRE
     AND Aproveitamento <> 'S'
     AND turma = PCD_TURMA
     AND turmamatricula = PCD_TURMA_MATRICULA
     AND codigoaluno = PCD_PESSOA
     AND situacao not in (3, 4, 5, 6, 7, 8, 10) ;
     
  -- IMPLEMENTAR RECUPERACAO SEMESTRAL **************************
  
  -- IMPLEMENTAR CALCULO DE MÉDIA PERIODICA
  
  IF PASN_NOTAS = 'S' THEN
     -- TEM NOTAS -
     
     -- CALCULAR A MEDIA ANUAL
     
     IF INSTR(PADS_FORMULA_ANUAL, 'mediainstitucional') <= 0 THEN
     
        SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
        SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_ANUAL, ') FROM fichaindividual ');
        SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
        SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
        
        PREPARE sqlUpdate FROM @sSql;
        EXECUTE sqlUpdate;
        DEALLOCATE PREPARE sqlUpdate;
        
     ELSE
        -- IMPLEMENTAR MEDIA COM PI
        SELECT 1;
     
     END IF;
     
     -- SELECIONAR A MÉDIA ANUAL DO TEMPORARIO
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;
         
         SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = IF(ISNULL(media_ajustada), ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE), ', media_ajustada)' );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;

         SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;
     
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS - 1
     
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -1, mediafinal = -1, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ');
     
     SET registros := 1;
     
     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-1');
        SET registros = registros + 1;
     END WHILE;
     

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS -2
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -2, mediafinal = -2, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ');

     SET registros := 1;

     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-2');
        SET registros = registros + 1;
     END WHILE;

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     

     -- CALCULO DA MEDIA FINAL ANTES DO EXAME
     
     TRUNCATE TMP_MEDIAFIM;
     
     SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
     SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_FINAL, ') FROM fichaindividual ');
     SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
     SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

         SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;

         SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;


  END IF; -- FIM SN_NOTAS
  
  -- CONVERTER NOTAS EM CONCEITO
  
  IF (PASN_NOTAS = 'S') AND (PASN_CONCEITOS = 'S') THEN
  
     UPDATE fichaindividual
      INNER JOIN turmas AS t ON (fi.turma = t.codigo AND fi.anosemestre = t.anosemestre)
       LEFT JOIN avaliacoes_conceitos AS ac ON (ac.cd_avaliacao = t.cd_avaliacao)
             AND ac.nr_inicial <= IFNULL(fi.mediaFinal, 0)
             AND ac.nr_final >= IFNULL(fi.mediaFinal, 0)
        SET ds_media = ac.ds_conceito
      WHERE fi.aproveitamento <> "S"
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.turma = PCD_TURMA;
  
  END IF;
  
  
  IF PASN_FREQ_GLOBAL = 'S' THEN
    IF PADS_FREQ_TIPO = 'C' THEN
       --  Pegar a Frequencia pela Carga Horaria
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN

          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(g.vl_valor) * 100)),2)
            FROM fichaindividual as f INNER JOIN turmas t ON (f.turma = t.codigo and f.anosemestre = t.anosemestre)
           INNER JOIN grades_disciplinas as g ON (g.cd_grade = t.cd_grade AND g.cd_curso = t.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = f.serie)
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;
            
           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           
       END IF;
    ELSE
       -- Pegar a Frequencia pelas Aulas Dadas
       
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN
       
          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(t.numeroaulas) * 100)),2)
            FROM fichaindividual f
           INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and  f.curso = t.curso and f.disciplina = t.disciplina and t.cd_categoria = 1 )
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;

           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           

       END IF;
    END IF;
  END IF;


  /* TRATAR AS CONDICOES QUANDO USA AS NOTAS PARCIAIS
  s_condicao_reprova := StringReplace(condicao_reprova, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_reprova := StringReplace(s_condicao_reprova, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_reprova := StringReplace(s_condicao_reprova, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_reprova := StringReplace(s_condicao_reprova, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  ==================================================================================================================
  ==================================================================================================================
  s_condicao_aprova := StringReplace(condicao_aprova, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_aprova := StringReplace(s_condicao_aprova, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_aprova := StringReplace(s_condicao_aprova, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_aprova := StringReplace(s_condicao_aprova, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  ==================================================================================================================
  */
  
  -- VERIFICAR REPROVAÇÃO DIRETA
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = 9 ');
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_REPROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

  IF PASN_NOTAS = 'S' THEN

     SET @sSql := CONCAT(@sSql, ' AND ( mediafinal is not null ) AND (mediafinal >=0) ' );

  END IF;
  

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  
  -- VERIFICAR APROVACAO DIRETA

  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_APROVA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 9, 10) ');


  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  -- Se não possuem avaliacao por nota, termina por aqui
  IF PASN_NOTAS = 'N' THEN
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
     LEAVE sProc;
  END IF;
  
  -- TENTAR PASSAR O ESTUDANTE COM O PESO PARA ARREDONDAMENTO
  
  -- *** FALTA IMPLEMENTAR ****
  
  IF PASN_EXAME = 'N' THEN
  
     -- Se nao tem exame entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao not in (SELECT cd_situacao FROM situacao WHERE cd_situacao_pai IN(0, 1, 9))
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
        
     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM EXAME
  
  UPDATE fichaindividual fi
     SET fi.situacao = 2
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao <> 9
     AND fi.situacao NOT IN(SELECT cd_situacao FROM situacao WHERE cd_situacao_pai = 0) and fi.mediafinal is not null
     AND ( fi.mediafinal >=0)
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

  IF (PANR_MAX_EXAME > 0) AND (PANR_MAX_EXAME < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em exame - Verificar se o aluno ultrapassou
     
     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2
       INTO VL_AUX;
        
     IF VL_AUX > PANR_MAX_EXAME THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 2;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
           
        LEAVE sProc;
         
     END IF;

  END IF;
  
  -- CALCULAR MEDIA DE EXAME
  

  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'notaexame', 'IF(sn_faltou_exame = 1, 0, notaexame)');
  
  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_EXAME, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) AND (notaexame is not null OR sn_faltou_exame = 1) ');
  
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) and notaexame is not null ');

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  -- TENTAR APROVAR O ALUNO PELO EXAME
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_AEXAME);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_EXAME, ' AND situacao = 2 ');
  

  /* IMPLEMENTAR USO DA TABELA DAS NOTAS PARCIAIS
  
    if (Pos('menor_npns', s_condicao_exame) > 0) OR (Pos('maior_npns', s_condicao_exame) > 0) OR (Pos('media_npns', s_condicao_exame) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPNS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_nps', s_condicao_exame) > 0) OR (Pos('maior_nps', s_condicao_exame) > 0) OR (Pos('media_nps', s_condicao_exame) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_np', s_condicao_exame) > 0) OR (Pos('maior_np', s_condicao_exame) > 0) OR (Pos('media_np', s_condicao_exame) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NP, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', '', []);
  end;

  ==================================================================================================================
  s_condicao_exame := StringReplace(s_condicao_exame, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_exame := StringReplace(s_condicao_exame, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_exame := StringReplace(s_condicao_exame, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_exame := StringReplace(s_condicao_exame, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  ==================================================================================================================

  */
  

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- TENTAR PASSAR O CARA PELO ARREDONDAMENTO APOS O EXAME
  
  -- FALTA IMPLEMENTAR ***********************
  
  IF PASN_2AEPOCA = 'N' THEN

     -- Se nao tem segunda epoca entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2 and fi.notaexame is not null
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);

     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM SEGUNDA EPOCA

  UPDATE fichaindividual fi
   INNER JOIN avaliacoes_parametros ap ON (fi.turma = ap.turma AND fi.anosemestre = ap.anosemestre)
     SET fi.situacao = 11
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 2
     AND (fi.mediafinal >=0)
     AND ( ( ap.sn_falta_exame_forca_2epoca = 1 AND (ap.sn_faltou_exame = 1 OR fi.notaexame IS NOT NULL) )
         OR (fi.notaexame is not null) );

  IF (PANR_MAX_2AEPOCA > 0) AND (PANR_MAX_2AEPOCA < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em segunda epoca - Verificar se o aluno ultrapassou

     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 11
       INTO VL_AUX;

     IF VL_AUX > PANR_MAX_2AEPOCA THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 11;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

        LEAVE sProc;
        
     ELSE
         -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
         -- IMPLEMENTAR **********************
         -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
         SELECT 1;

     END IF;
     
  ELSE
     -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
     -- IMPLEMENTAR **********************
     -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
     SELECT 1;

  END IF;
  
  
  -- CALCULAR MEDIA DE SEGUNDA EPOCA

  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_2EPOCA, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND fi.situacao = 11 and fi.segunda_epoca is not null ');
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND fi.situacao = 11 and fi.segunda_epoca is not null  ');
     
     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;

     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  
  -- TENTAR APROVAR O ALUNO PELO SEGUNDA EPOCA

  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_A2AEPOCA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_2AEPOCA, ' AND situacao = 11 and fi.segunda_epoca is not null ');
  
/*  IMPLEMENTAR CHECAGEM NAS TABELAS PARCIAIS

  if (Pos('menor_npns', s_condicao_segunda) > 0) OR (Pos('maior_npns', s_condicao_segunda) > 0) OR (Pos('media_npns', s_condicao_segunda) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPNS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_nps', s_condicao_segunda) > 0) OR (Pos('maior_nps', s_condicao_segunda) > 0) OR (Pos('media_nps', s_condicao_segunda) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NPS, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else if (Pos('menor_np', s_condicao_segunda) > 0) OR (Pos('maior_np', s_condicao_segunda) > 0) OR (Pos('media_np', s_condicao_segunda) > 0) then begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', ReplaceStr(SQL_CONDICAO_INNER_NP, ':bimestre:', IntToStr(intBimestres)), []);
  end
  else begin
     tblCalc.SQL.Text := StringReplace(tblCalc.SQL.Text, '___CONDICAO___', '', []);
  end;

  ==================================================================================================================
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'menor_npns', '('+SQL_CONDICAO_MENOR_NPNS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'maior_npns', '('+SQL_CONDICAO_MAIOR_NPNS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'media_npns', '('+SQL_CONDICAO_MEDIA_NPNS+')', []);

  s_condicao_segunda := StringReplace(s_condicao_segunda, 'menor_nps', '('+SQL_CONDICAO_MENOR_NPS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'maior_nps', '('+SQL_CONDICAO_MAIOR_NPS+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'media_nps', '('+SQL_CONDICAO_MEDIA_NPS+')', []);

  s_condicao_segunda := StringReplace(s_condicao_segunda, 'menor_np', '('+SQL_CONDICAO_MENOR_NP+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'maior_np', '('+SQL_CONDICAO_MAIOR_NP+')', []);
  s_condicao_segunda := StringReplace(s_condicao_segunda, 'media_np', '('+SQL_CONDICAO_MEDIA_NP+')', []);
  ==================================================================================================================

*/

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- IMPLEMENTAR
  -- TENTAR PASSAR PELO PELO DO ARREDONDAMENTO APOS EXAME
  
  
  -- REPROVAR AS DISCIPLINAS QUE FICARAM EM SEGUNDA EPOCA
  
  
  UPDATE fichaindividual fi
     SET fi.situacao = 9
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 11 and segunda_epoca is not null
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

 -- IMPLEMENTAR - CALCULO MÉDIA DO CURSO
 
 -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
 
 CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
  

END sProc//





DROP PROCEDURE IF EXISTS `DIA_SITUACAO_FINAL`//
CREATE PROCEDURE `DIA_SITUACAO_FINAL`(IN PCD_PESSOA INTEGER(11), IN PCD_TURMA VARCHAR(15), IN PNR_ANOSEMESTRE INTEGER(11))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE CD_SITU_CONCLUIDA, CD_SITUACAO, NR_QTD INTEGER(11) DEFAULT NULL ;
    
 -- SELECIONAR DO PARAMETRO DE AVALIACAO A SITUACAO DE CONCLUSAO (CASO EXISTA)
 SELECT ap.cd_situacao_concluida
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO CD_SITU_CONCLUIDA;


   IF CD_SITU_CONCLUIDA IS NOT NULL THEN
      --  EXISTE A SITUACAO DE CONCLUSAO NESTE CASO... 
      --  DEVE SER VERIFICADO SE O ALUNO CONCLUIU TODAS AS DISCIPLINAS
      
      SELECT COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
         and s.cd_situacao_pai in (1,2,11)
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO NR_QTD;
        
      IF NR_QTD >= 1 THEN
         -- NESTE CASO, O ALUNO CONTINUARA COM A SITUACAO ATIVA (CURSANDO)
         -- POIS EXISTE AINDA ALGUMA SITUACAO PENDENTE.
         
         SET CD_SITUACAO = 1;
      ELSE
         -- SE NÃO TEM NENHUMA SITUACAO PENDENTE, ENTÃO COLOCAR COMO CONCLUIDA
         
         SET CD_SITUACAO = CD_SITU_CONCLUIDA;
      END IF;
   ELSE
      -- SELECIONAR AS DISCIPLINAS DO ALUNO NA TURMA COM A QUANTIDADE EM CADA SITUACAO

      SELECT s.cd_situacao_pai, COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao AND s.nr_ordem_final is not null)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO CD_SITUACAO, NR_QTD;

   END IF;
   
   IF CD_SITUACAO IS NOT NULL THEN
   
      UPDATE MATRICULAS
         SET situacao = CD_SITUACAO
       WHERE situacao <> 10
         AND codigoaluno = PCD_PESSOA
         AND turma = PCD_TURMA
         AND anosemestre = PNR_ANOSEMESTRE;
         
   END IF;

END//]]></atualiza><atualiza codigo="{0AE0216B-B63A-49D7-8D97-4E40F28A1155}" protocolo="ansi"><![CDATA[ALTER TABLE `con_areas` CHANGE `nr_valor_inscricao` `nr_valor_inscricao` DOUBLE(15,2) UNSIGNED DEFAULT '0.00' NOT NULL;]]></atualiza><atualiza codigo="{3858F6CF-4A02-4AC6-B8B0-9072300078EF}" protocolo="mysql-5"><![CDATA[ALTER TABLE res_horarios
