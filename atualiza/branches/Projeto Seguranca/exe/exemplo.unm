UPDATE CURSOS_COORDENADORES SET CD_COLIGADA = (SELECT MIN(CD_COLIGADA) FROM COLIGADAS);]]></atualiza><atualiza codigo="{12F18DF1-DDB2-4CCA-8C7A-BE3EC3934615}" protocolo="mysql-5"><![CDATA[ALTER TABLE CURSOS RENAME TO CURSOS_MUDADO;

CREATE OR REPLACE VIEW CURSOS
AS
SELECT
	t.anosemestre AS ANOSEMESTRE, 
	cc.CD_CURSO AS CODIGO,
	FIRST_OCCURRENCE(cm.DS_APELIDO) AS APELIDO, 
	FIRST_OCCURRENCE(cm.DS_CURSO) AS DESCRICAO, 
	FIRST_OCCURRENCE(cm.NR_GRAU) AS GRAU,	
	NULL AS PARECERAUTORIZACAO,
	NULL AS PARECERRECONHECIMENTO,
	NULL AS DATACEE,
	FIRST_OCCURRENCE(cc.NR_CARGA_HORARIA) AS CARGAHORARIATOTAL,
	FIRST_OCCURRENCE(cc.NR_DIAS_LETIVOS) AS DIASLETIVOS,
	NULL AS SEMANASLETIVAS,
	NULL AS DIASSEMANASLETIVAS,
	NULL AS HORARIOLETIVO,
	FIRST_OCCURRENCE(cc.NR_DURACAO_AULA) AS DURACAOHORAAULA,
	NULL AS DIASLETIVOSSEMANAIS,
	FIRST_OCCURRENCE(cc.NR_SERIES) AS NUMERODESERIES,
	FIRST_OCCURRENCE(cc.DS_NOME_ETAPA) AS NOME_ETAPA,
	FIRST_OCCURRENCE(cc.DS_CONTRATO) AS CONTRATO,
	NULL AS QTADEBIMESTRES,
	FIRST_OCCURRENCE(cc.CD_DEPTO) AS DEPTO,
	NULL AS SEMANASLETIVASV,
	NULL AS SEMANASLETIVASN,
	FIRST_OCCURRENCE(cc.DS_REQUERIMENTO) AS REQUERIMENTO,
	NULL AS SENHA,
	NULL AS SENHAPROVISORIA,
	NULL AS CD_REGIMENTO,
	NULL AS CD_EDITAL,
	NULL AS CD_INSTRU_GERAIS,
	FIRST_OCCURRENCE(cc.CD_CURSO_EQUIVALENTE) AS CD_CURSO_EQUIVALENTE,
	FIRST_OCCURRENCE(cc.CD_CURSO_MEC) AS MEC_CD_CURSO,
	FIRST_OCCURRENCE(cc.CD_HABILITACAO_MEC) AS MEC_CD_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRAU_MEC) AS MEC_CD_GRAU,
	NULL AS DT_RESULTADO_FINAL,
	NULL AS CLI_MOSTRAR_SITE,
	NULL AS DS_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRADE) AS CD_GRADE,
	FIRST_OCCURRENCE(cc.CD_CURSO) AS CD_CURSO,
	FIRST_OCCURRENCE(cc.ME_OBSERVACOES) AS OBSERVACOES,
	FIRST_OCCURRENCE(cc.SN_ACADEMICO) AS SN_ACADEMICO,
	cc.CD_COLIGADA
FROM
	cursos_mestre cm
	INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO)
	INNER JOIN turmas t ON (t.CURSO = cc.CD_CURSO AND t.CD_COLIGADA = cc.CD_COLIGADA)
GROUP BY
	t.anosemestre, cc.CD_CURSO, cc.CD_COLIGADA;]]></atualiza><atualiza codigo="{12F18DF1-DDB2-4CCA-8C7A-BE3EC3934615}" protocolo="oracle"><![CDATA[ALTER TABLE "CURSOS" RENAME TO "CURSOS_MUDADO";

CREATE OR REPLACE VIEW "CURSOS"
AS
SELECT
	t.anosemestre AS ANOSEMESTRE, 
	cc.CD_CURSO AS CODIGO,
	FIRST_OCCURRENCE(cm.DS_APELIDO) AS APELIDO, 
	FIRST_OCCURRENCE(cm.DS_CURSO) AS DESCRICAO, 
	FIRST_OCCURRENCE(cm.NR_GRAU) AS GRAU,	
	NULL AS PARECERAUTORIZACAO,
	NULL AS PARECERRECONHECIMENTO,
	NULL AS DATACEE,
	FIRST_OCCURRENCE(cc.NR_CARGA_HORARIA) AS CARGAHORARIATOTAL,
	FIRST_OCCURRENCE(cc.NR_DIAS_LETIVOS) AS DIASLETIVOS,
	NULL AS SEMANASLETIVAS,
	NULL AS DIASSEMANASLETIVAS,
	NULL AS HORARIOLETIVO,
	FIRST_OCCURRENCE(cc.NR_DURACAO_AULA) AS DURACAOHORAAULA,
	NULL AS DIASLETIVOSSEMANAIS,
	FIRST_OCCURRENCE(cc.NR_SERIES) AS NUMERODESERIES,
	FIRST_OCCURRENCE(cc.DS_NOME_ETAPA) AS NOME_ETAPA,
	FIRST_OCCURRENCE(cc.DS_CONTRATO) AS CONTRATO,
	NULL AS QTADEBIMESTRES,
	FIRST_OCCURRENCE(cc.CD_DEPTO) AS DEPTO,
	NULL AS SEMANASLETIVASV,
	NULL AS SEMANASLETIVASN,
	FIRST_OCCURRENCE(cc.DS_REQUERIMENTO) AS REQUERIMENTO,
	NULL AS SENHA,
	NULL AS SENHAPROVISORIA,
	NULL AS CD_REGIMENTO,
	NULL AS CD_EDITAL,
	NULL AS CD_INSTRU_GERAIS,
	FIRST_OCCURRENCE(cc.CD_CURSO_EQUIVALENTE) AS CD_CURSO_EQUIVALENTE,
	FIRST_OCCURRENCE(cc.CD_CURSO_MEC) AS MEC_CD_CURSO,
	FIRST_OCCURRENCE(cc.CD_HABILITACAO_MEC) AS MEC_CD_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRAU_MEC) AS MEC_CD_GRAU,
	NULL AS DT_RESULTADO_FINAL,
	NULL AS CLI_MOSTRAR_SITE,
	NULL AS DS_HABILITACAO,
	FIRST_OCCURRENCE(cc.CD_GRADE) AS CD_GRADE,
	FIRST_OCCURRENCE(cc.CD_CURSO) AS CD_CURSO,
	FIRST_OCCURRENCE(cc.ME_OBSERVACOES) AS OBSERVACOES,
	FIRST_OCCURRENCE(cc.SN_ACADEMICO) AS SN_ACADEMICO,
	cc.CD_COLIGADA
FROM
	cursos_mestre cm
	INNER JOIN cursos_coligadas cc ON (cc.CD_CURSO = cm.CD_CURSO)
	INNER JOIN turmas t ON (t.CURSO = cc.CD_CURSO AND t.CD_COLIGADA = cc.CD_COLIGADA)
GROUP BY
	t.anosemestre, cc.CD_CURSO, cc.CD_COLIGADA;]]></atualiza><atualiza codigo="{516162FD-4E11-4386-9092-9B3A5F8002E1}" protocolo="mysql-5"><![CDATA[ALTER TABLE `parametros` ADD COLUMN `cd_coligada` smallint(6) NULL AFTER `cd_tipo`;]]></atualiza><atualiza codigo="{516162FD-4E11-4386-9092-9B3A5F8002E1}" protocolo="oracle"><![CDATA[ALTER TABLE "PARAMETROS" ADD ( "CD_COLIGADA" NUMBER(9) NULL );]]></atualiza><atualiza codigo="{5E3B8C55-D534-41D2-ADAA-713BD62BD936}" protocolo="mysql-5"><![CDATA[UPDATE parametros SET cd_coligada = (select cd_Coligada from coligadas limit 1);]]></atualiza><atualiza codigo="{5E3B8C55-D534-41D2-ADAA-713BD62BD936}" protocolo="oracle"><![CDATA[UPDATE parametros SET cd_coligada = (select cd_Coligada from coligadas where ROWNUM = 1);]]></atualiza><atualiza codigo="{1F17D360-F603-4771-B1A7-B481C4BEB666}" protocolo="ansi"><![CDATA[UPDATE parametros SET cd_coligada = (select min(cd_Coligada) from coligadas);]]></atualiza><atualiza codigo="{E8023B1D-E354-4CD2-9FA3-FDAD5C19F179}" protocolo="mysql-5"><![CDATA[DELETE FROM nu_parametros WHERE ds_parametro = 'tela_baixa_mensalidade';
