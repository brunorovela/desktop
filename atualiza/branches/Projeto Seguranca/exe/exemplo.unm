# ---------------------------------------
# IMPORTACAO DE DIA_PRAZOS DE ETAPAS NORMAIS
# ---------------------------------------

INSERT dia_prazos 
	(nr_anosemestre,       nm_prazo,          cd_tipo_prazo,   dt_inicio_etapa, dt_fim_etapa, 
     dt_inicio_frequencia, dt_fim_frequencia, dt_inicio_notas, dt_fim_notas,    dt_liberacao) 
SELECT DISTINCT 
	nr_anosemestre as nr_anosemestre,
    COALESCE(nm_recuperacao, CONCAT(CONCAT(CONCAT('Prazo ', nr_anosemestre),' - '),nr_etapa)) as nm_prazo,
	nr_etapa as cd_tipo_prazo,
	dt_envio_inicio as dt_inicio_etapa,
	dt_envio_fim as dt_fim_etapa,
    dt_envio_inicio as dt_inicio_frequencia,
	dt_envio_fim as dt_fim_frequencia,
	dt_envio_inicio as dt_inicio_notas,
	dt_envio_fim as dt_fim_notas,
	dt_notas_inicio as dt_liberacao	
FROM 
	diario_prazos//

# ---------------------------------------
# IMPORTACAO DE DIA_PRAZOS DE EXAMES
# ---------------------------------------
	
INSERT dia_prazos (nr_anosemestre, nm_prazo, cd_tipo_prazo, dt_inicio_notas, dt_fim_notas, dt_liberacao)
SELECT DISTINCT 
	dp.nr_anosemestre as nr_anosemestre,
	COALESCE(dp.nm_recuperacao, CONCAT(CONCAT(CONCAT('Prazo ', dp.nr_anosemestre),' - '),dp.nr_etapa)) as nm_prazo,
	-1 as cd_tipo_prazo,
	dp.dt_exame_inicio as dt_inicio_notas,
	dp.dt_exame_fim as dt_fim_notas,
	dp.dt_notas_inicio as dt_liberacao
FROM 
	cursos c
	INNER JOIN turmas t ON (
			t.curso = c.codigo AND 
			c.anosemestre = t.anosemestre
	)
	INNER JOIN disciplinas d ON (
			c.codigo = d.curso
	)
	LEFT JOIN avaliacoes_parametros ap ON (
			ap.cd_avaliacao = t.cd_avaliacao
	)
	LEFT JOIN diario_prazos dp4 ON (
			dp4.nr_anosemestre = c.anosemestre AND dp4.cd_curso = c.codigo AND dp4.cd_turma = t.codigo AND dp4.cd_disciplina = d.codigo AND dp4.nr_etapa = ap.nr_avaliacoes
	)
	LEFT JOIN diario_prazos dp3 ON (
			dp3.nr_anosemestre = c.anosemestre AND dp3.cd_curso = c.codigo AND dp3.cd_turma = t.codigo AND dp3.cd_disciplina = 0 AND dp3.nr_etapa = ap.nr_avaliacoes AND dp4.nr_anosemestre IS NULL
	)
	LEFT JOIN diario_prazos dp2 ON (
			dp2.nr_anosemestre = c.anosemestre AND dp2.cd_curso = c.codigo AND dp2.cd_turma = '' AND dp2.cd_disciplina = 0 AND dp2.nr_etapa = ap.nr_avaliacoes AND dp3.nr_anosemestre IS NULL AND dp4.nr_anosemestre IS NULL
	)
	LEFT JOIN diario_prazos dp1 ON (
			dp1.nr_anosemestre = c.anosemestre AND dp1.cd_curso = '' AND dp1.cd_turma = '' AND dp1.cd_disciplina = 0 AND dp1.nr_etapa = ap.nr_avaliacoes AND dp2.nr_anosemestre IS NULL AND dp3.nr_anosemestre IS NULL AND dp4.nr_anosemestre IS NULL
	)
	LEFT JOIN diario_prazos dp ON (
			dp.nr_anosemestre = COALESCE(dp4.nr_anosemestre,dp3.nr_anosemestre,dp2.nr_anosemestre,dp1.nr_anosemestre) AND
			dp.cd_curso = COALESCE(dp4.cd_curso,dp3.cd_curso,dp2.cd_curso,dp1.cd_curso) AND
			dp.cd_turma = COALESCE(dp4.cd_turma,dp3.cd_turma,dp2.cd_turma,dp1.cd_turma) AND
			dp.cd_disciplina = COALESCE(dp4.cd_disciplina,dp3.cd_disciplina,dp2.cd_disciplina,dp1.cd_disciplina)AND
			dp.nr_etapa = COALESCE(dp4.nr_etapa,dp3.nr_etapa,dp2.nr_etapa,dp1.nr_etapa)
	)
WHERE
	(dp.dt_exame_inicio IS NOT NULL OR	dp.dt_exame_fim IS NOT NULL) AND
	(dp.dt_exame_inicio != '0000-00-00 00:00:00' OR dp.dt_exame_fim != '0000-00-00 00:00:00')//

# ---------------------------------------
# IMPORTACAO DE DIA_PRAZOS DE LIBERACAO
# ---------------------------------------

INSERT dia_prazos (nr_anosemestre, nm_prazo, cd_tipo_prazo, dt_liberacao)
SELECT DISTINCT
	c.anosemestre as nr_anosemestre,
	CONCAT('Prazo resultado final ', c.anosemestre) as nm_prazo,
	-3 as cd_tipo_prazo,
	c.dt_resultado_final as dt_liberacao
FROM 
	cursos c
	INNER JOIN turmas t ON (t.curso = c.codigo AND c.anosemestre = t.anosemestre)
	INNER JOIN disciplinas d ON (c.codigo = d.curso)
WHERE 
	c.dt_resultado_final IS NOT NULL AND 
	c.dt_resultado_final != '0000-00-00 00:00:00'//

	
# ---------------------------------------
# IMPORTACAO DE DIA_PRAZOS_TURMAS DE ETAPAS NORMAIS
# ---------------------------------------

INSERT INTO dia_prazos_turmas (nr_anosemestre, cd_curso, cd_turma, cd_disciplina, cd_tipo_prazo, cd_prazo)
SELECT
	c.anosemestre      as nr_anosemestre,
	c.codigo           as cd_curso,
	t.codigo           as cd_turma,
	d.codigo           as cd_disciplina,	
	diap.cd_tipo_prazo as cd_tipo_prazo,
	diap.cd_prazo      as cd_prazo
FROM 
	cursos c
	INNER JOIN turmas t ON (t.curso = c.codigo AND c.anosemestre = t.anosemestre)
	INNER JOIN disciplinas d ON (c.codigo = d.curso) 
	LEFT JOIN diario_prazos dp4 ON (
			dp4.nr_anosemestre = c.anosemestre AND dp4.cd_curso = c.codigo AND dp4.cd_turma = t.codigo AND dp4.cd_disciplina = d.codigo
	)
	LEFT JOIN diario_prazos dp3 ON (
			dp3.nr_anosemestre = c.anosemestre AND dp3.cd_curso = c.codigo AND dp3.cd_turma = t.codigo AND dp3.cd_disciplina = 0 AND dp4.nr_anosemestre IS NULL
	)
	LEFT JOIN diario_prazos dp2 ON (
			dp2.nr_anosemestre = c.anosemestre AND dp2.cd_curso = c.codigo AND dp2.cd_turma = '' AND dp2.cd_disciplina = 0 AND dp3.nr_anosemestre IS NULL AND dp4.nr_anosemestre IS NULL
	)
	LEFT JOIN diario_prazos dp1 ON (
			dp1.nr_anosemestre = c.anosemestre AND dp1.cd_curso = '' AND dp1.cd_turma = '' AND dp1.cd_disciplina = 0 AND dp2.nr_anosemestre IS NULL AND dp3.nr_anosemestre IS NULL AND dp4.nr_anosemestre IS NULL
	)
	INNER JOIN dia_prazos diap ON (
			diap.nr_anosemestre  = c.anosemestre AND
			diap.cd_tipo_prazo   = COALESCE(dp4.nr_etapa, dp3.nr_etapa, dp2.nr_etapa, dp1.nr_etapa) AND
			diap.dt_inicio_etapa = COALESCE(dp4.dt_envio_inicio, dp3.dt_envio_inicio, dp2.dt_envio_inicio, dp1.dt_envio_inicio) AND
			diap.dt_fim_etapa    = COALESCE(dp4.dt_envio_fim, dp3.dt_envio_fim, dp2.dt_envio_fim, dp1.dt_envio_fim) AND
			diap.dt_liberacao    = COALESCE(dp4.dt_notas_inicio, dp3.dt_notas_inicio, dp2.dt_notas_inicio, dp1.dt_notas_inicio)
	)
GROUP BY
	c.anosemestre, c.codigo, t.codigo, d.codigo, diap.cd_tipo_prazo//
	
	
# ---------------------------------------
# IMPORTACAO DE DIA_PRAZOS_TURMAS DE EXAMES
# ---------------------------------------

INSERT INTO dia_prazos_turmas (nr_anosemestre, cd_curso, cd_turma, cd_disciplina, cd_tipo_prazo, cd_prazo)
SELECT
	c.anosemestre      as nr_anosemestre,
	c.codigo           as cd_curso,
	t.codigo           as cd_turma,
	d.codigo           as cd_disciplina,
	diap.cd_tipo_prazo as cd_tipo_prazo,
	diap.cd_prazo      as cd_prazo
FROM 
	cursos c
	INNER JOIN turmas t ON (t.curso = c.codigo AND c.anosemestre = t.anosemestre)
	INNER JOIN disciplinas d ON (c.codigo = d.curso)
	LEFT JOIN avaliacoes_parametros ap ON (
			ap.cd_avaliacao = t.cd_avaliacao
	)
	LEFT JOIN diario_prazos dp4 ON (
			dp4.nr_anosemestre = c.anosemestre AND dp4.cd_curso = c.codigo AND dp4.cd_turma = t.codigo AND dp4.cd_disciplina = d.codigo AND dp4.nr_etapa = ap.nr_avaliacoes
	)
	LEFT JOIN diario_prazos dp3 ON (
			dp3.nr_anosemestre = c.anosemestre AND dp3.cd_curso = c.codigo AND dp3.cd_turma = t.codigo AND dp3.cd_disciplina = 0 AND dp3.nr_etapa = ap.nr_avaliacoes AND dp4.nr_anosemestre IS NULL
	)
	LEFT JOIN diario_prazos dp2 ON (
			dp2.nr_anosemestre = c.anosemestre AND dp2.cd_curso = c.codigo AND dp2.cd_turma = '' AND dp2.cd_disciplina = 0 AND dp2.nr_etapa = ap.nr_avaliacoes AND dp3.nr_anosemestre IS NULL AND dp4.nr_anosemestre IS NULL
	)
	LEFT JOIN diario_prazos dp1 ON (
			dp1.nr_anosemestre = c.anosemestre AND dp1.cd_curso = '' AND dp1.cd_turma = '' AND dp1.cd_disciplina = 0 AND dp1.nr_etapa = ap.nr_avaliacoes AND dp2.nr_anosemestre IS NULL AND dp3.nr_anosemestre IS NULL AND dp4.nr_anosemestre IS NULL
	)
	INNER JOIN dia_prazos diap ON (
			diap.nr_anosemestre  = c.anosemestre AND
			diap.cd_tipo_prazo   = -1 AND
			diap.dt_inicio_notas = COALESCE(dp4.dt_exame_inicio, dp3.dt_exame_inicio, dp2.dt_exame_inicio, dp1.dt_exame_inicio) AND
			diap.dt_fim_notas    = COALESCE(dp4.dt_exame_fim, dp3.dt_exame_fim, dp2.dt_exame_fim, dp1.dt_exame_fim) AND
			diap.dt_liberacao    = COALESCE(dp4.dt_notas_inicio, dp3.dt_notas_inicio, dp2.dt_notas_inicio, dp1.dt_notas_inicio)
	)
GROUP BY
	c.anosemestre, c.codigo, t.codigo, d.codigo, diap.cd_tipo_prazo//

	
# ---------------------------------------
# IMPORTACAO DE DIA_PRAZOS_TURMAS DE LIBERACAO
# ---------------------------------------
	
INSERT INTO dia_prazos_turmas (nr_anosemestre, cd_curso, cd_turma, cd_disciplina, cd_tipo_prazo, cd_prazo)
SELECT
	c.anosemestre      as nr_anosemestre,
	c.codigo           as cd_curso,
	t.codigo           as cd_turma,
	d.codigo           as cd_disciplina,
	diap.cd_tipo_prazo as cd_tipo_prazo,
	diap.cd_prazo      as cd_prazo
FROM 
	cursos c
	INNER JOIN turmas t ON (t.curso = c.codigo AND c.anosemestre = t.anosemestre)
	INNER JOIN disciplinas d ON (c.codigo = d.curso)
	INNER JOIN dia_prazos diap ON (
			diap.nr_anosemestre  = c.anosemestre AND
			diap.cd_tipo_prazo   = -3 AND
			diap.dt_liberacao    = c.dt_resultado_final
	)
GROUP BY
	c.anosemestre, c.codigo, t.codigo, d.codigo, diap.cd_tipo_prazo//
	
# ---------------------------------------
# REMOVE OS PRAZOS QUE NÃO POSSUEM DISCIPLINAS VINCULADAS
# ---------------------------------------
	
DELETE FROM dia_prazos WHERE CD_PRAZO NOT IN (SELECT CD_PRAZO FROM dia_prazos_turmas)//



  
  
