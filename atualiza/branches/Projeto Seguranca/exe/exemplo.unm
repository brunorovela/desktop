-- Criando tabelas do módulo Gestão Comercial

CREATE TABLE GCOML_TURMAS (
   CD_TURMA VARCHAR2(50) NOT NULL,
   NR_ANOSEMESTRE NUMBER(5) NOT NULL,
   NR_META NUMBER(5) NOT NULL,
   VL_DESCONTO FLOAT NULL,
   VL_COMISSAO FLOAT NULL,
   SN_ATIVO NUMBER(5) DEFAULT 0 NOT NULL
)//

ALTER TABLE GCOML_TURMAS ADD PRIMARY KEY (CD_TURMA, NR_ANOSEMESTRE)//

CREATE TABLE GCOML_HISTORICO (
   CD_HISTORICO NUMBER(19) NOT NULL AUTO_INCREMENT,
   CD_TURMA VARCHAR2(50) NOT NULL,
   NR_ANOSEMESTRE NUMBER(5) NOT NULL,
   NR_META NUMBER(5) NOT NULL,
   VL_DESCONTO FLOAT NULL,
   VL_COMISSAO FLOAT NULL,
   DT_INICIO DATE NOT NULL,
   DT_FIM DATE NULL
)//

CALL CRIAR_AUTO_INCREMENT('GCOML_HISTORICO', 'CD_HISTORICO', 'SEQ_GCOML_HIST_CD_HIST', 'AUTOINC_GCOML_HIST_CD_HIST')//

ALTER TABLE GCOML_HISTORICO ADD PRIMARY KEY (CD_HISTORICO)//

CREATE TABLE GCOML_SITUACOES_CONTATO (
   CD_SITUACAO NUMBER(19) NOT NULL,
   NM_SITUACAO VARCHAR2(30) NOT NULL,
   SN_PADRAO NUMBER(5) DEFAULT 0 NOT NULL,
   SN_FINALIZA NUMBER(5) DEFAULT 0 NOT NULL,
   CD_COR_HTML CHAR(6) DEFAULT 'FFFFFF' NOT NULL
)//

CALL CRIAR_AUTO_INCREMENT('GCOML_SITUACOES_CONTATO', 'CD_SITUACAO', 'SEQ_GCOML_SIT_CONT_CD_SIT', 'AUTOINC_GCOML_SIT_CONT_CD_SIT')//

ALTER TABLE GCOML_SITUACOES_CONTATO ADD PRIMARY KEY (CD_SITUACAO)//
ALTER TABLE GCOML_SITUACOES_CONTATO ADD CONSTRAINT UK_SITUACS_CONTATO_NM_SITUACAO UNIQUE (NM_SITUACAO)//

CREATE TABLE GCOML_RESULTADOS_VISITA (
   CD_RESULTADO NUMBER(19) NOT NULL,
   NM_RESULTADO VARCHAR2(30) NOT NULL,
   CD_COR_HTML CHAR(6) DEFAULT 'FFFFFF' NOT NULL,
   SN_MATRICULAR NUMBER(5) DEFAULT 0 NOT NULL
)//

CALL CRIAR_AUTO_INCREMENT('GCOML_RESULTADOS_VISITA', 'CD_RESULTADO', 'SEQ_GCOML_RESUL_VISITA', 'AUTOINC_GCOML_RESUL_VISITA')//

ALTER TABLE GCOML_RESULTADOS_VISITA ADD PRIMARY KEY (CD_RESULTADO)//
ALTER TABLE GCOML_RESULTADOS_VISITA ADD CONSTRAINT UK_RESULT_VISITA_NM_RESULTADO UNIQUE (NM_RESULTADO)//

]]></atualiza><atualiza codigo="{33F9186C-5755-419B-923C-7C4EA52DCAB3}" protocolo="ansi"><![CDATA[UPDATE 
