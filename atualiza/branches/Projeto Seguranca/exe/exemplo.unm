CREATE TABLE diario_aulas_alunos (
  cd_pessoa NUMBER(9) DEFAULT '0' NOT NULL,
  cd_turma VARCHAR2(15) DEFAULT '' NOT NULL,
  nr_anosem NUMBER(19) DEFAULT '0' NOT NULL,
  cd_disciplina NUMBER(19) DEFAULT '0' NOT NULL,
  cd_bimestre NUMBER(19) DEFAULT '0' NOT NULL,
  nr_aula NUMBER(19) DEFAULT '0' NOT NULL,
  ds_freq VARCHAR2(24) DEFAULT NULL,
  sn_importada NUMBER(5) DEFAULT 0 NOT NULL,
  PRIMARY KEY  (cd_pessoa,cd_turma,nr_anosem,cd_disciplina,cd_bimestre,nr_aula)
)//

INSERT INTO diario_aulas_alunos (cd_pessoa, cd_turma, nr_anosem, cd_disciplina, cd_bimestre, nr_aula, ds_freq) SELECT codaluno, turma, anosemestre, disciplina, bimestre, 1, freq1 FROm diario_matriculas WHERE freq1 is not null//
INSERT INTO diario_aulas_alunos (cd_pessoa, cd_turma, nr_anosem, cd_disciplina, cd_bimestre, nr_aula, ds_freq) SELECT codaluno, turma, anosemestre, disciplina, bimestre, 2, freq2 FROm diario_matriculas WHERE freq2 is not null//
INSERT INTO diario_aulas_alunos (cd_pessoa, cd_turma, nr_anosem, cd_disciplina, cd_bimestre, nr_aula, ds_freq) SELECT codaluno, turma, anosemestre, disciplina, bimestre, 3, freq3 FROm diario_matriculas WHERE freq3 is not null//
