WHERE 
	cd_titulo_principal IS NULL OR cd_titulo_principal = 0;]]></atualiza><atualiza codigo="{1BFC737B-4A80-48DE-8842-B52A9AC926E8}" protocolo="ansi"><![CDATA[ALTER TABLE retorno ADD COLUMN cd_coligada smallint(6) NULL;

