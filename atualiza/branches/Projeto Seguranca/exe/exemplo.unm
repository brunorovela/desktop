FUNCTION "GET_COMPRAS_QTD_ESTOQUE_LIMIT"(PARAM_CD_PRODUTO VARCHAR2, PARAM_DT_ENTRADA VARCHAR2, PARAM_DIAS_ANTERIORES NUMBER)
 RETURN NUMBER
IS
	V_RETORNO NUMBER(9) := 0;
BEGIN
	SELECT
		SUM(
			CASE WHEN TP_ENTRADA_SAIDA = 1 OR TP_ENTRADA_SAIDA = 3 THEN
				COALESCE( NR_QUANTIDADE, 0 )
			ELSE
				0-COALESCE( NR_QUANTIDADE, 0 )
			END
		) AS registros
	INTO V_RETORNO
	FROM COMP_ESTOQUE
	WHERE CD_PRODUTO = PARAM_CD_PRODUTO AND
              UNIMESTRE_DATAS.COMPARAR(
                 DT_ENTRADA,
                 DATE_ADD(TO_TIMESTAMP(CONCAT(SUBSTRING(PARAM_DT_ENTRADA, 0, 11), '23:59:59'), 'YYYY-MM-DD HH24:MI:SS'), '-', PARAM_DIAS_ANTERIORES, 'DAY'), 
                 'MENOR_IGUAL', ''
              ) = 1;

	RETURN COALESCE(V_RETORNO, 0);
END;]]></atualiza><atualiza codigo="{01A6D47C-9987-451A-A087-7C4F03A7D1F2}" protocolo="mysql-5"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{01A6D47C-9987-451A-A087-7C4F03A7D1F2}" protocolo="oracle"><![CDATA[CALL CRIAR_AUTO_INCREMENT('FIN_CP_HISTORICOS', 'CD_HISTORICO', 'SEQ_FIN_CP_HIST_CD_HIST', 'AUTOINC_FIN_CP_HIST_CD_HIST');]]></atualiza><atualiza codigo="{61B711D9-2D0A-4D6E-9B23-A439D784EA11}" protocolo="mysql-5"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{61B711D9-2D0A-4D6E-9B23-A439D784EA11}" protocolo="oracle"><![CDATA[CREATE OR REPLACE VIEW VWO_NFSE_RPS_VARIAVEIS AS
	SELECT NM_VARIAVEL, TO_CLOB(DS_VALOR) AS DS_VALOR 
	FROM (
		(
			SELECT
				CAST(TRIM(nm_variavel) AS VARCHAR2(50)) NM_VARIAVEL,
				ds_valor
			FROM
				fin_nfse_rps_variaveis
		)
		UNION
		(
			SELECT
				REPLACE(ds_variavel, 'cliente_', '') NM_VARIAVEL,
				CAST(DS_VALOR AS VARCHAR2(100))
			FROM
				parametros
			WHERE
				ds_variavel IN (
					'cliente_bairro',
					'cliente_cep',
					'cliente_cnpj',
					'cliente_email',
					'cliente_razao_social',
					'cliente_telefone',
					'cliente_uf',
					'cliente_nome_fantasia'
				)
			) 
		) tabela;]]></atualiza><atualiza codigo="{46107E4C-3C23-4F64-9B9E-D1BB7A48C37A}" protocolo="mysql-5"><![CDATA[SELECT 1;]]></atualiza><atualiza codigo="{46107E4C-3C23-4F64-9B9E-D1BB7A48C37A}" protocolo="oracle"><![CDATA[CREATE TABLE TAM_ATIVIDADES (
  CD_ATIVIDADE NUMBER(9) NOT NULL,
  CD_EVENTO NUMBER(9) NOT NULL,
  NM_PALESTRANTE CLOB,
  DS_TEMA CLOB,
  DT_ATIVIDADE DATE,
  HR_INICIO TIMESTAMP(2),
  HR_FIM TIMESTAMP(2),
  NR_HORAS NUMBER(9),
  NR_VAGAS NUMBER(9),
  SN_ESCOLHE NUMBER(5),
  ME_AMBIENTE CLOB,
  DS_ATIVIDADE VARCHAR2(255),
  SN_ATIVIDADE_PADRAO NUMBER(5) DEFAULT 0,
	PRIMARY KEY(CD_ATIVIDADE)
);

CALL CRIAR_AUTO_INCREMENT('TAM_ATIVIDADES', 'CD_ATIVIDADE', 'SEQ_TAM_ATIVIDADE_CD_ATIVIDADE', 'AUTOINC_TAM_ATIV_CD_ATIVIDADE');
ALTER TABLE TAM_ATIVIDADES ADD CONSTRAINT FK_TAM_ATIVIDADES_CD_EVENTO FOREIGN KEY(CD_EVENTO)REFERENCES TAM_EVENTOS(CD_EVENTO);
]]></atualiza><atualiza codigo="{5118EA85-F545-401D-9F1E-537F1198A192}" protocolo="mysql-5"><![CDATA[ALTER TABLE cursos_atos_oficiais DROP PRIMARY KEY;

ALTER TABLE `cursos_atos_oficiais` ADD COLUMN `cd_ato_oficial` integer(9) 
NOT NULL AUTO_INCREMENT FIRST,
ADD PRIMARY KEY (`cd_ato_oficial`);

ALTER TABLE `cursos_atos_oficiais` ADD COLUMN `cd_coligada`  smallint(6) NULL AFTER `sn_impressao`;

]]></atualiza><atualiza codigo="{5118EA85-F545-401D-9F1E-537F1198A192}" protocolo="oracle"><![CDATA[ALTER TABLE CURSOS_ATOS_OFICIAIS DROP PRIMARY KEY;

ALTER TABLE CURSOS_ATOS_OFICIAIS ADD CD_ATO_OFICIAL NUMBER(9) NULL;

CALL CRIAR_AUTO_INCREMENT('CURSOS_ATOS_OFICIAIS', 'CD_ATO_OFICIAL', 'SEQ_CURSOS_ATOS_OFICIAIS', 'AUTOINC_CURSOS_ATOS_OFICIAIS');

CREATE TABLE CURSOS_ATOS_OFICIAIS_SEQ AS 
SELECT 
	CD_CURSO, 
	NR_ANOSEMESTRE,
	DT_ATO,
	DS_ATO,
        DS_TITULO_ATO,
	SN_IMPRESSAO,
	SEQ_CURSOS_ATOS_OFICIAIS.nextval CD_ATO_OFICIAL
FROM 
	CURSOS_ATOS_OFICIAIS;

UPDATE CURSOS_ATOS_OFICIAIS a SET a.CD_ATO_OFICIAL = 
(SELECT 
	CD_ATO_OFICIAL 
FROM 
	CURSOS_ATOS_OFICIAIS_SEQ 
WHERE 
	CD_CURSO = a.CD_CURSO AND
	NR_ANOSEMESTRE = a.NR_ANOSEMESTRE AND
	DT_ATO = a.DT_ATO AND
	DS_ATO = a.DS_ATO AND
        DS_TITULO_ATO = a.DS_TITULO_ATO
);

DROP TABLE CURSOS_ATOS_OFICIAIS_SEQ;

ALTER TABLE CURSOS_ATOS_OFICIAIS MODIFY CD_ATO_OFICIAL NUMBER(9) NOT NULL; 

ALTER TABLE CURSOS_ATOS_OFICIAIS ADD PRIMARY KEY (CD_ATO_OFICIAL);

ALTER TABLE CURSOS_ATOS_OFICIAIS ADD CD_COLIGADA NUMBER(5) NULL;
]]></atualiza><atualiza codigo="{E19BAF92-DFC5-4330-A2E8-094DF08A598C}" protocolo="ansi"><![CDATA[INSERT INTO 
