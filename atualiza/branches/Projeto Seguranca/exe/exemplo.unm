UPDATE sis_prazos SET cd_turma = NULL WHERE TRIM(cd_turma) = '';
UPDATE sis_prazos SET cd_curso = NULL WHERE TRIM(cd_curso) = '';]]></atualiza><atualiza codigo="{A4D0DD98-C9B0-4960-B16C-AA7069EA3B8F}" protocolo="ansi"><![CDATA[DELETE
FROM
professores_unidades;

INSERT INTO professores_unidades(cd_coligada,cd_professor,sn_professor,sn_orientador,sn_funcionario) 	
SELECT
   c.cd_coligada,p.cd_pessoa,0,CASE WHEN p.sn_coordena_ativo = 'S' THEN 1 ELSE 0 END,CASE WHEN p.sn_funcionario = 'S' THEN 1 ELSE 0 END
FROM
   professores p,
   coligadas c;

REPLACE INTO professores_unidades (cd_coligada,cd_professor,sn_professor,sn_orientador,sn_funcionario) 	
SELECT
   t.cd_coligada,tp.professor,CASE WHEN p.sn_professor = 'S' THEN 1 ELSE 0 END ,pu.sn_orientador,pu.sn_funcionario
FROM
	turmasprofessores tp
	INNER JOIN turmas t ON (tp.turma = t.codigo AND tp.anosemestre = t.anosemestre AND t.curso = tp.curso)
	INNER JOIN professores_unidades pu ON (pu.cd_coligada = t.cd_coligada AND pu.cd_professor = tp.professor )
	INNER JOIN professores p ON  (p.cd_pessoa =  tp.professor )	
GROUP BY
	tp.professor, t.cd_coligada;
	]]></atualiza><atualiza codigo="{FFC8EB33-2BA7-4073-A580-D627021A2B2F}" protocolo="ansi"><![CDATA[ALTER TABLE pol_provas_turmas MODIFY COLUMN cd_prova_diario  INT(10) UNSIGNED NULL;

