CREATE TABLE `prod_processo` (
  `cd_processo` int(11) NOT NULL auto_increment,
  `cd_tipo_trabalho` int(11) unsigned NOT NULL,
  `cd_disciplina_pai` varchar(255) NOT NULL,
  `nm_processo` varchar(255) default NULL,
  `dt_inicio` datetime default NULL,
  `dt_fim` datetime default NULL,
  `ds_informacoes` text,
  `cd_professor` int(11) unsigned default NULL,
  `dt_inclusao` datetime default NULL,
  PRIMARY KEY  (`cd_processo`),
  KEY `ix_prod_processo_disciplinas` (`cd_disciplina_pai`),
  KEY `prod_processo_FKIndex2` (`cd_tipo_trabalho`)
) ENGINE=InnoDB;

CREATE TABLE `prod_turmasprocesso` (
  `cd_processo` int(11) NOT NULL auto_increment,
  `cd_turma` varchar(15) NOT NULL,
  `nr_anosemestre` int(11) unsigned NOT NULL,
  `cd_disciplina` int(11) unsigned NOT NULL,
  `cd_curso` varchar(15) NOT NULL,
  PRIMARY KEY  (`cd_processo`,`cd_turma`,`nr_anosemestre`,`cd_disciplina`),
  KEY `ix_prod_processo_turmasproc` (`cd_processo`),
  KEY `ix_turmasprocesso_professores` (`nr_anosemestre`,`cd_curso`,`cd_turma`)
) ENGINE=InnoDB;

CREATE TABLE `prod_alunosprocesso` (
  `cd_processo` int(11) NOT NULL auto_increment,
  `cd_turma` varchar(15) NOT NULL,
  `cd_disciplina` int(11) unsigned NOT NULL,
  `cd_aluno` int(11) unsigned NOT NULL,
  `nr_anosemestre` int(11) unsigned NOT NULL,
  `nr_conceito` int(11) unsigned default '0',
  `cd_situacao` int(11) unsigned default '0',
  `cd_status` int(11) unsigned default '0',
  PRIMARY KEY  (`cd_processo`,`cd_turma`,`cd_disciplina`,`cd_aluno`,`nr_anosemestre`),
  KEY `ix_turmas_alunos_processo` (`cd_processo`,`cd_turma`,`nr_anosemestre`,`cd_disciplina`),
  KEY `prod_alunosprocesso_FKIndex2` (`cd_situacao`)
) ENGINE=InnoDB;

CREATE TABLE `prod_alunospostagens` (
  `cd_postagem` int(11) unsigned NOT NULL auto_increment,
  `cd_processo` int(11) NOT NULL,
  `cd_turma` varchar(15) NOT NULL,
  `cd_disciplina` int(11) unsigned NOT NULL,
  `cd_aluno` int(11) unsigned NOT NULL,
  `nr_anosemestre` int(11) unsigned NOT NULL,
  `dt_postagem` datetime NOT NULL,
  `cd_origem` int(11) unsigned default NULL,
  `me_comentario` text,
  PRIMARY KEY  (`cd_postagem`),
  UNIQUE KEY `idx_unique` (`cd_processo`,`cd_turma`,`cd_disciplina`,`cd_aluno`,`nr_anosemestre`,`dt_postagem`),
  KEY `ix_alunos_postagem_processo` (`cd_processo`,`cd_turma`,`cd_disciplina`,`cd_aluno`,`nr_anosemestre`)
) ENGINE=InnoDB;

CREATE TABLE `prod_anexo` (
  `cd_anexo` int(11) unsigned NOT NULL auto_increment,
  `nr_anosemestre` int(11) unsigned NOT NULL,
  `cd_aluno` int(11) unsigned NOT NULL,
  `cd_disciplina` int(11) unsigned NOT NULL,
  `cd_turma` varchar(15) NOT NULL,
  `cd_processo` int(11) NOT NULL,
  `nm_anexo` varchar(255) default NULL,
  `ds_tipo_anexo` varchar(255) default NULL,
  `me_anexo` mediumblob,
  `dt_inclusao` datetime default NULL,
  PRIMARY KEY  (`cd_anexo`),
  KEY `ix_prod_aluno_anexo` (`cd_processo`,`cd_turma`,`cd_disciplina`,`cd_aluno`,`nr_anosemestre`)
) ENGINE=InnoDB;]]></atualiza><atualiza codigo="{7996AA46-BCB4-45C2-9F06-824A00AAD3C9}" protocolo="mysql-5"><![CDATA[DROP TABLE IF EXISTS `fin_nfe_g2ka_coligadas`;
CREATE TABLE `fin_nfe_g2ka_coligadas` (
  `cd_nfe_g2ka_coligada` int(11) NOT NULL auto_increment,
  `cd_coligada` int(11) default NULL,
  `cd_municipio` int(10) default NULL,
  `nr_inscricao_municipal` int(30) default NULL,
  `ds_cnpj` varchar(20) default NULL,
  `nm_coligada` varchar(50) default NULL,
  `ds_ddd_prestador` varchar(5) default NULL,
  `ds_fone_prestador` varchar(20) default NULL,
  `nr_serieprestacao` varchar(30) default NULL,
  PRIMARY KEY  (`cd_nfe_g2ka_coligada`)
) ENGINE=InnoDB;

DROP TABLE IF EXISTS `fin_nfe_g2ka_sql`;
CREATE TABLE `fin_nfe_g2ka_sql` (
  `cd_nfe_g2ka_sql` int(11) NOT NULL auto_increment,
  `ds_sql` mediumtext,
  PRIMARY KEY  (`cd_nfe_g2ka_sql`)
) ENGINE=InnoDB;

INSERT INTO fin_nfe_g2ka_sql VALUES ( null, 'SELECT\r\n	FORMAT_CNPJ_NUMBER(col.ds_cnpj) AS cnpjprestador,\r\n	col.ds_cnpj AS cnpjformatado,\r\n	col.nm_coligada,\r\n	col.cd_coligada,\r\n	m.codigoaluno,\r\n	MIN(m.cd_mensalidade) AS cd_mensalidade,\r\n	GROUP_CONCAT(M.cd_mensalidade SEPARATOR \',\') AS cd_mensa_atualizar,\r\n	m.cd_tipo_titulo,\r\n	IFNULL(p.nm_sem_acento, p.nm_pessoa) AS razaosocial,\r\n\r\n	IF( p.tp_pessoa = \'F\',\r\n	MID(p.nm_pessoa,\r\n	1,\r\n	(INSTR(p.nm_pessoa, \' \'))-1),\r\n	p.nm_pessoa\r\n	) AS nomefantasia,\r\n\r\n	IF(p.tp_pessoa = \'J\', p.ds_inscri_estadual, \'\') AS inscricaoestadual,\r\n	IF(p.tp_pessoa = \'J\', p.ds_inscri_municipal, \'\') AS inscricaomunicipal,\r\n	l.ds_logradouro AS tipologradourotomador,\r\n\r\n	IF(\r\n	p.tp_pessoa = \'J\',\r\n	IFNULL(p.ds_cnpj, \'00000000000000\'),\r\n	NULL\r\n	) AS cnpj,\r\n\r\n	IF(\r\n	p.tp_pessoa = \'F\',\r\n	IFNULL(p.ds_cpf,\'00000000000\'),\r\n	NULL\r\n	) AS cpf,\r\n\r\n	CONCAT(\r\n	IFNULL(l.ds_logradouro,\'\'),\r\n	\' \',\r\n	IFNULL(p.ds_logradouro, IFNULL(a.ds_logradouro,\'\'))\r\n	) AS logradourotomador,\r\n\r\n	p.ds_estado AS uf,\r\n	l.ds_logradouro AS tipobairrotomador,\r\n	p.ds_logradouro_nro AS numero,\r\n\r\n	LEFT(p.ds_complemento,30) AS complemento,\r\n	p.ds_bairro AS bairro,\r\n	n.cd_municipio AS codigomunicipiotomador,\r\n	p.ds_cep AS ceptomador,\r\n\r\n	LEFT(p.ds_complemento,30) AS pontodereferencia,\r\n	IFNULL(n.ds_municipio, IFNULL(p.ds_cidade, a.ds_cidade)) AS cidadetomadordescricao,\r\n	FORMAT_PHONE_NUMBER((SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 1 AND  ds_contato IS NOT NULL LIMIT 1)) AS telefone,\r\n	(SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 4 AND  ds_contato IS NOT NULL LIMIT 1) AS email,\r\n	\'00\' AS dddtomador,\r\n	\'00\' AS dddtelefonecomercial,\r\n	FORMAT_PHONE_NUMBER((SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 2 AND  ds_contato IS NOT NULL LIMIT 1)) AS telefonecomercial,\r\n	\'00\' AS dddfax,\r\n	FORMAT_PHONE_NUMBER((SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 5 AND  ds_contato IS NOT NULL LIMIT 1)) AS telefonefax,\r\n	st.ds_item_servico AS itemlistaservico,\r\n	st.cd_cnae AS codigocnae,\r\n	st.cd_tributacao_municipio AS codigotributacaomunicipio,\r\n	CONCAT( IFNULL(st.ds_discriminacao,\'\'), \' \', IFNULL(m.ds_historico,\'\') ) AS discriminacao,\r\n	st.ds_nome_municipio AS municipioprestacaodescricao,\r\n	st.ds_tributacao AS tributacao,\r\n	FORMAT(SUM((IF(tipoparcela=0, valorbruto + IFNULL(valorextra,0), if(tipoparcela=4, IFNULL(vl_faturamento, 0), 0)))),2) AS valorservicos,\r\n	IF(( SUM(m.valorbruto + m.valorextra - m.descontoextra)) = 0, \'0.00\', FORMAT((SUM(m.valorbruto + m.valorextra - m.descontoextra)),2) ) AS valorliquidonfse,\r\n	IF(SUM(m.descontoextra) = \'0\', \'0.00\', FORMAT(SUM(m.descontoextra),2) ) AS descontoincondicionado,\r\n	IF(SUM(m.valordesconto) = \'0\', \'0.00\', FORMAT(SUM(m.valordesconto),2) ) AS descontocondicionado,\r\n	IF(SUM(m.descontoextra) = \'0\', \'0.00\', FORMAT(SUM(m.descontoextra),2) ) AS valordeducoes,\r\n	IF(SUM(ifnull(m.valorpago,0)) = \'0\', \'0.00\', FORMAT(SUM(m.valorpago),2) ) AS valorpago,\r\n	p.tp_pessoa AS tipopessoa,\r\n	st.vl_aliquota,\r\n	st.sn_issretido,\r\n	col.cd_municipio AS codigomunicipio_prestador,\r\n	col.nr_inscricao_municipal AS inscricaomunicipal_prestador,\r\n	col.nr_serieprestacao,\r\n	col.ds_ddd_prestador,\r\n	col.ds_fone_prestador\r\nFROM\r\n	MENSALIDADES AS M\r\n	INNER JOIN PESSOAS A ON (M.CODIGOALUNO = A.CD_PESSOA)\r\n	LEFT JOIN PESSOAS P ON (IFNULL(A.CD_RESP_FINAN, A.CD_PESSOA) = P.CD_PESSOA)\r\n	LEFT JOIN MUNICIPIOS N ON ( P.CD_MUNICIPIO = N.CD_MUNICIPIO )\r\n	LEFT JOIN LOGRADOUROS L ON ( P.CD_LOGRADOURO = L.CD_LOGRADOURO )\r\n	LEFT JOIN ESTADOS E ON (P.DS_ESTADO = E.DS_UF)\r\n	LEFT JOIN FIN_TIPOS_TITULO TP ON (M.CD_COLIGADA = TP.CD_COLIGADA) AND  (M.CD_TIPO_TITULO = TP.CD_TIPO_TITULO)\r\n	LEFT JOIN CURSOS C ON (M.CURSO = C.CODIGO)AND ( M.ANOSEMESTRE = C.ANOSEMESTRE )\r\n	INNER JOIN FIN_NFE_G2KA_SERVICOS_TITULOS AS ST ON (ST.CD_NFE_G2KA_SERVICOS_TITULOS = TP.CD_NFE_G2KA_SERVICO_TITULO)\r\n	LEFT JOIN FIN_NFE_G2KA_COLIGADAS AS COL ON ( M.CD_COLIGADA = COL.CD_COLIGADA)\r\nWHERE\r\n	M.SITUACAO NOT IN (10)\r\n	AND ( M.SITUACAO NOT IN (4, 5, 7, 8) OR DATE_FORMAT(M.DT_COMPETENCIA,\"%Y%m\") < DATE_FORMAT(M.DATAPAGAMENTO,\"%Y%m\") OR M.TIPOPARCELA = 1)\r\n	AND TP.SN_FATURAMENTO = 1\r\n	AND (M.TIPOPARCELA = 0 OR IFNULL(M.VL_FATURAMENTO,0) > 0)\r\n	AND M.SN_NFE_GERADA = 0\r\n  [$cd_coligada$]\r\n	[$periodo_competencia$]\r\n	[$cd_mensalidade_in$]\r\nGROUP BY\r\n	M.CODIGOALUNO, M.CD_TIPO_TITULO, DATE_FORMAT(M.DT_COMPETENCIA, \'%Y%m\')\r\nORDER BY\r\n	P.NM_PESSOA');]]></atualiza><atualiza codigo="{7996AA46-BCB4-45C2-9F06-824A00AAD3C9}" protocolo="oracle"><![CDATA[DROP TABLE FIN_NFE_G2KA_COLIGADAS;
CREATE TABLE "FIN_NFE_G2KA_COLIGADAS" (
  "CD_NFE_G2KA_COLIGADA" NUMBER(9) NULL,
  "CD_COLIGADA" NUMBER(9) NULL,
  "CD_MUNICIPIO" NUMBER(9) NULL,
  "NR_INSCRICAO_MUNICIPAL" VARCHAR2(30) NULL,
  "DS_CNPJ" VARCHAR2(20) NULL,
  "NM_COLIGADA" VARCHAR2(50) NULL,
  "DS_DDD_PRESTADOR" VARCHAR2(5) NULL,
  "DS_FONE_PRESTADOR" VARCHAR2(20) NULL,
  "NR_SERIEPRESTACAO" VARCHAR2(30) NULL,
  PRIMARY KEY  ("CD_NFE_G2KA_COLIGADA")
);
CALL CRIAR_AUTO_INCREMENT( 'FIN_NFE_G2KA_COLIGADAS', 'CD_NFE_G2KA_COLIGADA', 'SEQ_NFE_COLIGADAS', 'AUTOINC_SEQ_NFE_COLIGADAS' );

CREATE TABLE "FIN_NFE_G2KA_SQL" (
  "CD_NFE_G2KA_SQL" NUMBER(9) NULL,
  "DS_SQL" CLOB NULL,
  PRIMARY KEY  ("CD_NFE_G2KA_SQL")
);
CALL CRIAR_AUTO_INCREMENT( 'FIN_NFE_G2KA_SQL', 'CD_NFE_G2KA_SQL', 'SEQ_NFE_SQL', 'AUTOINC_SEQ_NFE_SQL' );


DECLARE
	str_longa LONG;
BEGIN
	str_longa := 'SELECT
	FORMAT_CNPJ_NUMBER(col.ds_cnpj) AS cnpjprestador,
	col.ds_cnpj AS cnpjformatado,
	col.nm_coligada,
	col.cd_coligada,
	m.codigoaluno,
	MIN(m.cd_mensalidade) AS cd_mensalidade,
	GROUP_CONCAT(M.cd_mensalidade SEPARATOR '','') AS cd_mensa_atualizar,
	m.cd_tipo_titulo,
	IFNULL(p.nm_sem_acento, p.nm_pessoa) AS razaosocial,

	IF( p.tp_pessoa = ''F'',
	MID(p.nm_pessoa,
	1,
	(INSTR(p.nm_pessoa, '' ''))-1),
	p.nm_pessoa
	) AS nomefantasia,

	IF(p.tp_pessoa = ''J'', p.ds_inscri_estadual, '''') AS inscricaoestadual,
	IF(p.tp_pessoa = ''J'', p.ds_inscri_municipal, '''') AS inscricaomunicipal,
	l.ds_logradouro AS tipologradourotomador,

	IF(
	p.tp_pessoa = ''J'',
	IFNULL(p.ds_cnpj, ''00000000000000''),
	NULL
	) AS cnpj,

	IF(
	p.tp_pessoa = ''F'',
	IFNULL(p.ds_cpf,''00000000000''),
	NULL
	) AS cpf,

	CONCAT(
	IFNULL(l.ds_logradouro,''''),
	'' '',
	IFNULL(p.ds_logradouro, IFNULL(a.ds_logradouro,''''))
	) AS logradourotomador,

	p.ds_estado AS uf,
	l.ds_logradouro AS tipobairrotomador,
	p.ds_logradouro_nro AS numero,

	LEFT(p.ds_complemento,30) AS complemento,
	p.ds_bairro AS bairro,
	n.cd_municipio AS codigomunicipiotomador,
	p.ds_cep AS ceptomador,

	LEFT(p.ds_complemento,30) AS pontodereferencia,
	IFNULL(n.ds_municipio, IFNULL(p.ds_cidade, a.ds_cidade)) AS cidadetomadordescricao,
	FORMAT_PHONE_NUMBER((SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 1 AND  ds_contato IS NOT NULL LIMIT 1)) AS telefone,
	(SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 4 AND  ds_contato IS NOT NULL LIMIT 1) AS email,
	''00'' AS dddtomador,
	''00'' AS dddtelefonecomercial,
	FORMAT_PHONE_NUMBER((SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 2 AND  ds_contato IS NOT NULL LIMIT 1)) AS telefonecomercial,
	''00'' AS dddfax,
	FORMAT_PHONE_NUMBER((SELECT ds_contato FROM CONTATOS_PESSOAS CP WHERE CP.CD_PESSOA = P.CD_PESSOA AND  CP.CD_CONTATO = 5 AND  ds_contato IS NOT NULL LIMIT 1)) AS telefonefax,
	st.ds_item_servico AS itemlistaservico,
	st.cd_cnae AS codigocnae,
	st.cd_tributacao_municipio AS codigotributacaomunicipio,
	CONCAT( IFNULL(st.ds_discriminacao,''''), '' '', IFNULL(m.ds_historico,'''') ) AS discriminacao,
	st.ds_nome_municipio AS municipioprestacaodescricao,
	st.ds_tributacao AS tributacao,
	FORMAT(SUM((IF(tipoparcela=0, valorbruto + IFNULL(valorextra,0), if(tipoparcela=4, IFNULL(vl_faturamento, 0), 0)))),2) AS valorservicos,
	IF(( SUM(m.valorbruto + m.valorextra - m.descontoextra)) = 0, ''0.00'', FORMAT((SUM(m.valorbruto + m.valorextra - m.descontoextra)),2) ) AS valorliquidonfse,
	IF(SUM(m.descontoextra) = ''0'', ''0.00'', FORMAT(SUM(m.descontoextra),2) ) AS descontoincondicionado,
	IF(SUM(m.valordesconto) = ''0'', ''0.00'', FORMAT(SUM(m.valordesconto),2) ) AS descontocondicionado,
	IF(SUM(m.descontoextra) = ''0'', ''0.00'', FORMAT(SUM(m.descontoextra),2) ) AS valordeducoes,
	IF(SUM(ifnull(m.valorpago,0)) = ''0'', ''0.00'', FORMAT(SUM(m.valorpago),2) ) AS valorpago,
	p.tp_pessoa AS tipopessoa,
	st.vl_aliquota,
	st.sn_issretido,
	col.cd_municipio AS codigomunicipio_prestador,
	col.nr_inscricao_municipal AS inscricaomunicipal_prestador,
	col.nr_serieprestacao,
	col.ds_ddd_prestador,
	col.ds_fone_prestador
FROM
	MENSALIDADES AS M
	INNER JOIN PESSOAS A ON (M.CODIGOALUNO = A.CD_PESSOA)
	LEFT JOIN PESSOAS P ON (IFNULL(A.CD_RESP_FINAN, A.CD_PESSOA) = P.CD_PESSOA)
	LEFT JOIN MUNICIPIOS N ON ( P.CD_MUNICIPIO = N.CD_MUNICIPIO )
	LEFT JOIN LOGRADOUROS L ON ( P.CD_LOGRADOURO = L.CD_LOGRADOURO )
	LEFT JOIN ESTADOS E ON (P.DS_ESTADO = E.DS_UF)
	LEFT JOIN FIN_TIPOS_TITULO TP ON (M.CD_COLIGADA = TP.CD_COLIGADA) AND  (M.CD_TIPO_TITULO = TP.CD_TIPO_TITULO)
	LEFT JOIN CURSOS C ON (M.CURSO = C.CODIGO)AND ( M.ANOSEMESTRE = C.ANOSEMESTRE )
	INNER JOIN FIN_NFE_G2KA_SERVICOS_TITULOS AS ST ON (ST.CD_NFE_G2KA_SERVICOS_TITULOS = TP.CD_NFE_G2KA_SERVICO_TITULO)
	LEFT JOIN FIN_NFE_G2KA_COLIGADAS AS COL ON ( M.CD_COLIGADA = COL.CD_COLIGADA)
WHERE
	M.SITUACAO NOT IN (10)
	AND ( M.SITUACAO NOT IN (4, 5, 7, 8) OR DATE_FORMAT(M.DT_COMPETENCIA,"%Y%m") < DATE_FORMAT(M.DATAPAGAMENTO,"%Y%m") OR M.TIPOPARCELA = 1)
	AND TP.SN_FATURAMENTO = 1
	AND (M.TIPOPARCELA = 0 OR IFNULL(M.VL_FATURAMENTO,0) > 0)
	AND M.SN_NFE_GERADA = 0
	[$cd_coligada$]
	[$periodo_competencia$]
	[$cd_mensalidade_in$]
GROUP BY
	M.CODIGOALUNO, M.CD_TIPO_TITULO, DATE_FORMAT(M.DT_COMPETENCIA, ''%Y%m'')
ORDER BY
	P.NM_PESSOA' ;
	INSERT INTO "FIN_NFE_G2KA_SQL" VALUES ('4', str_longa);
END;]]></atualiza><atualiza codigo="{7D883872-E12F-43B3-918B-BCECBFE53DD8}" protocolo="mysql-5"><![CDATA[DELIMITER //

-- Criando tabelas do módulo Gestão Comercial

CREATE TABLE GCOML_TURMAS (
   CD_TURMA VARCHAR(50) NOT NULL,
   NR_ANOSEMESTRE SMALLINT UNSIGNED NOT NULL,
   NR_META TINYINT UNSIGNED NOT NULL,
   VL_DESCONTO FLOAT(5,2) NULL,
   VL_COMISSAO FLOAT(4,2) NULL,
   SN_ATIVO TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,
   CONSTRAINT PK_GCOML_TURMAS PRIMARY KEY(CD_TURMA, NR_ANOSEMESTRE)
) ENGINE=INNODB//

CREATE TABLE GCOML_HISTORICO (
   CD_HISTORICO INTEGER UNSIGNED NOT NULL AUTO_INCREMENT,
   CD_TURMA VARCHAR(50) NOT NULL,
   NR_ANOSEMESTRE SMALLINT UNSIGNED NOT NULL,
   NR_META TINYINT(1) UNSIGNED NOT NULL,
   VL_DESCONTO FLOAT(5, 2) NULL,
   VL_COMISSAO FLOAT(4, 2) NULL,
   DT_INICIO DATETIME NOT NULL,
   DT_FIM DATETIME NULL,
   CONSTRAINT PK_GCOML_HISTORICO PRIMARY KEY(CD_HISTORICO)
) ENGINE=INNODB//

CREATE TABLE GCOML_SITUACOES_CONTATO (
   CD_SITUACAO INTEGER UNSIGNED NOT NULL AUTO_INCREMENT,
   NM_SITUACAO VARCHAR(30) NOT NULL,
   SN_PADRAO TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,
   SN_FINALIZA TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,
   CD_COR_HTML CHAR(6) NOT NULL DEFAULT 'FFFFFF',
   CONSTRAINT PK_GCOML_SITUACOES_CONTATO PRIMARY KEY(CD_SITUACAO),
   CONSTRAINT UK_SITUACS_CONTATO_NM_SITUACAO UNIQUE KEY(NM_SITUACAO)
) ENGINE=INNODB//

CREATE TABLE GCOML_RESULTADOS_VISITA (
   CD_RESULTADO INTEGER UNSIGNED NOT NULL AUTO_INCREMENT,
   NM_RESULTADO VARCHAR(30) NOT NULL,
   CD_COR_HTML CHAR(6) NOT NULL DEFAULT 'FFFFFF',
   SN_MATRICULAR TINYINT(1) NOT NULL DEFAULT 0,   
   CONSTRAINT PK_GCOML_RESULTADOS_VISITA PRIMARY KEY(CD_RESULTADO),
   CONSTRAINT UK_RESULT_VISITA_NM_RESULTADO UNIQUE KEY(NM_RESULTADO)
) ENGINE=INNODB//

CREATE TABLE GCOML_RESPOSTAS_OFERTA (
  CD_RESPOSTA INTEGER UNSIGNED NOT NULL AUTO_INCREMENT,
  DS_RESPOSTA CHAR(50) NOT NULL,
  CONSTRAINT PK_GCOML_RESPOSTAS_OFERTA PRIMARY KEY(CD_RESPOSTA),
  CONSTRAINT UK_RESPOSTS_OFERTA_DS_RESPOSTA UNIQUE KEY(DS_RESPOSTA)
) ENGINE=INNODB//

CREATE TABLE GCOML_CAMPANHAS (
   CD_CAMPANHA INTEGER UNSIGNED NOT NULL AUTO_INCREMENT,
   NM_CAMPANHA VARCHAR(50) NOT NULL,
   DS_CAMPANHA TEXT NULL,
   SN_PERFIL TINYINT(1) UNSIGNED NOT NULL,
   DT_INICIO DATE NOT NULL,
   DT_FIM DATE NOT NULL,
   BB_FOLDER MEDIUMBLOB NULL,
   CD_PESSOA_MASCARA INTEGER UNSIGNED NULL,
   CONSTRAINT PK_GCOML_CAMPANHAS PRIMARY KEY(CD_CAMPANHA)
) ENGINE=INNODB//

CREATE TABLE GCOML_TURMAS_CAMPANHAS (
   CD_CAMPANHA INTEGER UNSIGNED NOT NULL,
   CD_TURMA VARCHAR(50) NOT NULL,
   NR_ANOSEMESTRE SMALLINT UNSIGNED NOT NULL,
   CONSTRAINT PK_GCOML_TURMAS_CAMPANHAS PRIMARY KEY(CD_CAMPANHA, CD_TURMA, NR_ANOSEMESTRE)
) ENGINE=INNODB//

ALTER TABLE GCOML_TURMAS_CAMPANHAS
   ADD CONSTRAINT FK_TURMS_CMPANHSTRMS_COD_ANOSM FOREIGN KEY(CD_TURMA, NR_ANOSEMESTRE) REFERENCES GCOML_TURMAS(CD_TURMA, NR_ANOSEMESTRE),
   ADD CONSTRAINT FK_TRMSCMPS_CMPNHS_CD_CAMPANHA FOREIGN KEY(CD_CAMPANHA) REFERENCES GCOML_CAMPANHAS(CD_CAMPANHA)//

CREATE TABLE GCOML_HISTORICO_CAMPANHAS (
   CD_CAMPANHA INTEGER UNSIGNED NOT NULL,
   CD_HISTORICO INTEGER UNSIGNED NOT NULL,
   CONSTRAINT PK_GCOML_HISTORICO_CAMPANHAS PRIMARY KEY(CD_CAMPANHA, CD_HISTORICO)
) ENGINE=INNODB//

ALTER TABLE GCOML_HISTORICO_CAMPANHAS
   ADD CONSTRAINT FK_HISTCAMPNHS_HISTRC_CD_HISTO FOREIGN KEY(CD_HISTORICO) REFERENCES GCOML_HISTORICO(CD_HISTORICO),
   ADD CONSTRAINT FK_HISTCAMPS_CAMPS_CD_CAMPANHA FOREIGN KEY(CD_CAMPANHA) REFERENCES GCOML_CAMPANHAS(CD_CAMPANHA)//

CREATE TABLE GCOML_VISITAS (
   CD_VISITA INTEGER UNSIGNED NOT NULL AUTO_INCREMENT,
   CD_RESULTADO INTEGER UNSIGNED NOT NULL,
   CD_PESSOA INTEGER UNSIGNED NOT NULL,
   CD_CONSULTOR INTEGER UNSIGNED NOT NULL,
   DT_INCLUSAO DATETIME NOT NULL,
   DT_REALIZADA DATETIME NULL,
   TX_OBSERVACAO TEXT NULL,
   CONSTRAINT PK_GCOML_VISITAS PRIMARY KEY(CD_VISITA)
) ENGINE=INNODB//

ALTER TABLE GCOML_VISITAS
   ADD CONSTRAINT FK_VSTS_RESULTS_VITA_CD_RESULT FOREIGN KEY(CD_RESULTADO) REFERENCES GCOML_RESULTADOS_VISITA(CD_RESULTADO)//

CREATE TABLE GCOML_CONTATOS (
   CD_CAMPANHA INTEGER UNSIGNED NOT NULL,
   CD_PESSOA INTEGER UNSIGNED NOT NULL,
   CD_SITUACAO INTEGER UNSIGNED NOT NULL,
   CD_OPERADOR INTEGER UNSIGNED NULL,
   DT_INCLUSAO DATETIME NOT NULL,
   CONSTRAINT PK_GCOML_CONTATOS PRIMARY KEY(CD_CAMPANHA, CD_PESSOA)
) ENGINE=INNODB//

ALTER TABLE GCOML_CONTATOS
   ADD CONSTRAINT FK_CONTATS_CAMPNHS_CD_CAMPANHA FOREIGN KEY(CD_CAMPANHA) REFERENCES GCOML_CAMPANHAS(CD_CAMPANHA),
   ADD CONSTRAINT FK_CNTATS_SITSCNTS_CD_SITUACAO FOREIGN KEY(CD_SITUACAO) REFERENCES GCOML_SITUACOES_CONTATO(CD_SITUACAO)//

CREATE TABLE GCOML_DIRECIONAMENTOS (
   CD_PESSOA INTEGER UNSIGNED NOT NULL,
   CD_CAMPANHA INTEGER UNSIGNED NOT NULL,
   CD_OPERADOR INTEGER UNSIGNED NOT NULL,
   DT_DIRECIONAMENTO DATETIME NOT NULL
) ENGINE=INNODB//

ALTER TABLE GCOML_DIRECIONAMENTOS
   ADD CONSTRAINT FK_DIRTS_CNTATS_CAMPNHA_CD_PES FOREIGN KEY(CD_CAMPANHA, CD_PESSOA) REFERENCES GCOML_CONTATOS(CD_CAMPANHA, CD_PESSOA)//

CREATE TABLE GCOML_AGENDAS (
   CD_AGENDA INTEGER UNSIGNED NOT NULL AUTO_INCREMENT,
   CD_RESULTADO INTEGER UNSIGNED NULL,
   CD_PESSOA INTEGER UNSIGNED NOT NULL,
   CD_CAMPANHA INTEGER UNSIGNED NOT NULL,
   CD_CONSULTOR INTEGER UNSIGNED NULL,
   DT_INCLUSAO DATETIME NOT NULL,
   DT_AGENDA DATETIME NOT NULL,
   DT_REALIZADA DATETIME NULL,
   SN_EXTERNA TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,
   SN_CANCELADA TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,
   SN_CLASSIFICADA TINYINT(1) UNSIGNED NOT NULL DEFAULT 0,
   DT_CANCELADA DATETIME NULL,
   TX_OBSERVACAO TEXT NULL,
   CD_USUARIO INT(10) UNSIGNED NULL,
   CONSTRAINT PK_GCOML_AGENDAS PRIMARY KEY(CD_AGENDA)
) ENGINE=INNODB//

ALTER TABLE GCOML_AGENDAS
   ADD CONSTRAINT FK_AGENDS_RESULTS_VSITA_RESULT FOREIGN KEY(CD_RESULTADO) REFERENCES GCOML_RESULTADOS_VISITA(CD_RESULTADO),
   ADD CONSTRAINT FK_AGNDS_CNTATS_CAMPNHA_PESSOA FOREIGN KEY(CD_CAMPANHA, CD_PESSOA) REFERENCES GCOML_CONTATOS(CD_CAMPANHA, CD_PESSOA)//

CREATE TABLE GCOML_REGISTROS (
   CD_REGISTRO BIGINT NOT NULL AUTO_INCREMENT,
   CD_PESSOA INTEGER UNSIGNED NOT NULL,
   CD_CAMPANHA INTEGER UNSIGNED NOT NULL,
   CD_CONTATO INTEGER UNSIGNED NOT NULL,
   CD_OPERADOR INTEGER UNSIGNED NULL,
   DT_INICIO DATETIME NOT NULL,
   DT_FIM DATETIME NULL,
   DS_CONTATO VARCHAR(100) NOT NULL,
   TX_OBSERVACAO TEXT NULL,
   CONSTRAINT PK_GCOML_REGISTROS PRIMARY KEY(CD_REGISTRO)
) ENGINE=INNODB//

ALTER TABLE GCOML_REGISTROS
   ADD CONSTRAINT FK_REGSTS_CNTATS_CAMPNHA_PSSOA FOREIGN KEY(CD_CAMPANHA, CD_PESSOA) REFERENCES GCOML_CONTATOS(CD_CAMPANHA, CD_PESSOA)//

CREATE TABLE GCOML_OFERTAS (
   CD_REGISTRO BIGINT NOT NULL,
   NR_ANOSEMESTRE SMALLINT UNSIGNED NOT NULL,
   CD_TURMA VARCHAR(50) NOT NULL,
   CD_RESPOSTA INTEGER UNSIGNED NOT NULL,
   TX_OBSERVACAO TEXT NULL,
   CONSTRAINT PK_GCOML_OFERTAS PRIMARY KEY(CD_REGISTRO, NR_ANOSEMESTRE, CD_TURMA)
) ENGINE=INNODB//

ALTER TABLE GCOML_OFERTAS
   ADD CONSTRAINT FK_OFERTAS_REGSTRS_CD_REGISTRO FOREIGN KEY(CD_REGISTRO) REFERENCES GCOML_REGISTROS(CD_REGISTRO),
   ADD CONSTRAINT FK_OFERTS_RESPSTAS_CD_RESPOSTA FOREIGN KEY(CD_RESPOSTA) REFERENCES GCOML_RESPOSTAS_OFERTA(CD_RESPOSTA),
   ADD CONSTRAINT FK_REGSTRS_TURMAS_TURMA_ANOSEM FOREIGN KEY(CD_TURMA, NR_ANOSEMESTRE) REFERENCES GCOML_TURMAS(CD_TURMA, NR_ANOSEMESTRE)//

CREATE TRIGGER TAI_SALVA_HIST_TURMA AFTER INSERT ON GCOML_TURMAS
FOR EACH ROW
BEGIN
   INSERT INTO GCOML_HISTORICO
      (CD_TURMA, NR_ANOSEMESTRE, NR_META, VL_DESCONTO, VL_COMISSAO, DT_INICIO)
   VALUES
      (NEW.CD_TURMA, NEW.NR_ANOSEMESTRE, NEW.NR_META, NEW.VL_DESCONTO, NEW.VL_COMISSAO, NOW());
END//

CREATE TRIGGER TAU_SALVA_HIST_TURMA AFTER UPDATE ON GCOML_TURMAS
FOR EACH ROW
BEGIN
   UPDATE GCOML_HISTORICO
   SET
      DT_FIM = NOW()
   WHERE
      CD_TURMA = OLD.CD_TURMA AND
      NR_ANOSEMESTRE = OLD.NR_ANOSEMESTRE AND
      DT_FIM IS NULL;

   INSERT INTO GCOML_HISTORICO
      (CD_TURMA, NR_ANOSEMESTRE, NR_META, VL_DESCONTO, VL_COMISSAO, DT_INICIO)
   VALUES
      (NEW.CD_TURMA, NEW.NR_ANOSEMESTRE, NEW.NR_META, NEW.VL_DESCONTO, NEW.VL_COMISSAO, NOW());
END//

CREATE TRIGGER TBD_SALVA_HIST_TURMA BEFORE DELETE ON GCOML_TURMAS
FOR EACH ROW
BEGIN
   UPDATE GCOML_HISTORICO
   SET
      DT_FIM = NOW()
   WHERE
      CD_TURMA = OLD.CD_TURMA AND
      NR_ANOSEMESTRE = OLD.NR_ANOSEMESTRE AND
      DT_FIM IS NULL;
END//

CREATE TRIGGER TAI_SALVA_HIST_TURMA_CAMPANHA AFTER INSERT ON GCOML_TURMAS_CAMPANHAS
FOR EACH ROW
BEGIN
   INSERT INTO GCOML_HISTORICO_CAMPANHAS
      (CD_CAMPANHA, CD_HISTORICO)
   SELECT
      NEW.CD_CAMPANHA,
      CD_HISTORICO
   FROM
      GCOML_HISTORICO
   WHERE
      CD_TURMA = NEW.CD_TURMA AND
      NR_ANOSEMESTRE = NEW.NR_ANOSEMESTRE AND
      DT_FIM IS NULL;
END//

CREATE TRIGGER TAD_SALVA_HIST_TURMA_CAMPANHA BEFORE DELETE ON GCOML_TURMAS_CAMPANHAS
FOR EACH ROW
BEGIN
   DECLARE antigo, novo INTEGER UNSIGNED;

   SELECT
      CD_HISTORICO
   FROM
      GCOML_HISTORICO
   WHERE
      CD_TURMA = OLD.CD_TURMA AND
      NR_ANOSEMESTRE = OLD.NR_ANOSEMESTRE AND
      DT_FIM IS NULL
   INTO
      antigo;

   UPDATE GCOML_HISTORICO
   SET
      DT_FIM = NOW()
   WHERE
      CD_HISTORICO = antigo;

   INSERT INTO GCOML_HISTORICO
      (CD_TURMA, NR_ANOSEMESTRE, NR_META, VL_DESCONTO, VL_COMISSAO, DT_INICIO)
   SELECT
      CD_TURMA,
      NR_ANOSEMESTRE,
      NR_META,
      VL_DESCONTO,
      VL_COMISSAO,
      NOW()
   FROM
      GCOML_HISTORICO
   WHERE
      CD_HISTORICO = antigo;

   SET novo = LAST_INSERT_ID();

   INSERT INTO GCOML_HISTORICO_CAMPANHAS
      (CD_CAMPANHA, CD_HISTORICO)
   SELECT
      CD_CAMPANHA,
      novo
   FROM
      GCOML_HISTORICO_CAMPANHAS
   WHERE
      CD_HISTORICO = antigo AND
      CD_CAMPANHA <> OLD.CD_CAMPANHA;
END//


