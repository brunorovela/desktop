CREATE OR REPLACE 
FUNCTION "SHOW_CREATE_TABLE" (tabela IN VARCHAR2)
RETURN CLOB
IS
	V_RETORNO CLOB := NULL;
BEGIN
	SELECT
		dbms_metadata.get_ddl('TABLE', UPPER(tabela), 'UNIMESTRE') AS create_table
	INTO
		V_RETORNO
	FROM
		dual;

	RETURN V_RETORNO;
END;//]]></atualiza><atualiza codigo="{21209902-A649-4BDD-A18C-2C428360A4FE}" protocolo="mysql-5"><![CDATA[CREATE TABLE disciplinas_tipos_req (
