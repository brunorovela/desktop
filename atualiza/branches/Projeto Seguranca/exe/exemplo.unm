  prod_processo
SET 
  cd_tipo_trabalho = 1;]]></atualiza><atualiza codigo="{A37C1CCA-9240-468A-9AE5-67DD09318AD1}" protocolo="ansi"><![CDATA[DELETE
  pa
FROM
	prod_alunosprocesso pa
WHERE
 concat(
	 pa.cd_processo, '-',
	 pa.cd_turma,'-',
	 pa.cd_disciplina,'-',
	 pa.cd_aluno,'-',
	 pa.nr_anosemestre
 ) not in (
 SELECT 
   chave 
 FROM
 (
	
 SELECT
 concat(
	 pa.cd_processo, '-',
	 pa.cd_turma,'-',
	 pa.cd_disciplina,'-',
	 pa.cd_aluno,'-',
	 pa.nr_anosemestre
 ) as chave
 FROM
 	prod_alunosprocesso pa
 	INNER JOIN turmas t ON (pa.cd_turma = t.codigo AND pa.nr_anosemestre = t.anosemestre)
 	INNER JOIN disciplinas d ON (d.codigo =  pa.cd_disciplina AND d.curso = t.curso )
	INNER JOIN prod_processo pp ON (pp.cd_processo = pa.cd_processo and d.cd_disciplina_pai = pp.cd_disciplina_pai)
	)	as tbl
	) ;]]></atualiza><atualiza codigo="{3E86FD7B-0792-48A4-9E58-86C3F85DA0E9}" protocolo="ansi"><![CDATA[INSERT INTO PARAMETROS (DS_VARIAVEL, DS_VALOR, SN_RESTRITO, DS_VARIAVEL_USUARIO)
