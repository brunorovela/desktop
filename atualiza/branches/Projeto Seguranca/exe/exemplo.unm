   expo_tabelas et
   INNER JOIN information_schema.`TABLES` tabelas ON ( tabelas.TABLE_NAME = et.nm_tabela )
SET
   et.ds_descricao = 
      CASE
         WHEN tabelas.TABLE_TYPE = 'BASE TABLE' THEN
            CONCAT( 'Descrição da tabela ', et.nm_tabela )
         WHEN tabelas.TABLE_TYPE = 'VIEW' THEN
            CONCAT( 'Descrição da view ', et.nm_tabela )
         ELSE
            et.nm_tabela
      END
WHERE
   trim( COALESCE( et.ds_descricao, '' ) ) = '' AND
   tabelas.TABLE_SCHEMA = DATABASE();

UPDATE
   expo_campos ec
SET
   ds_campo = CONCAT( 'Descrição do campo ', nm_campo )   
WHERE
   TRIM( COALESCE( ec.ds_campo, '' ) ) = '';]]></atualiza><atualiza codigo="{A8291C94-C44F-451A-8FD9-BD88CD9D0A02}" protocolo="mysql-5"><![CDATA[UPDATE FIN_COBRANCA
