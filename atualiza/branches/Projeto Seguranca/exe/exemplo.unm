	nr_questao  int(10) UNSIGNED NULL DEFAULT NULL ,
	nr_resolucao  int(10) UNSIGNED NULL DEFAULT NULL ,
	PRIMARY KEY (cd_prova_pessoa_resposta)
);

CREATE TABLE pol_provas_turmas (
	cd_prova_turma  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_prova_diario  int(10) UNSIGNED NULL DEFAULT NULL ,
	cd_prova  int(10) UNSIGNED NOT NULL ,
	cd_turma  varchar(50) NOT NULL ,
	nr_anosemestre  smallint(6) NULL DEFAULT NULL ,
	cd_curso  varchar(15) NULL DEFAULT NULL ,
	cd_disciplina  int(11) NULL DEFAULT 0 ,
	nr_bimestre  int(11) NULL DEFAULT 0 ,
	PRIMARY KEY (cd_prova_turma)
);

CREATE TABLE pol_questoes (
	cd_questao  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_responsavel  int(11) UNSIGNED NULL DEFAULT NULL ,
	cd_disciplina_pai  varchar(255) NULL DEFAULT NULL ,
	cd_nivel  int(10) UNSIGNED NULL DEFAULT NULL ,
	cd_alternativa_certa  int(10) UNSIGNED NULL DEFAULT NULL ,
	ds_questao  blob NULL ,
	sn_ativo  tinyint(3) UNSIGNED NULL DEFAULT NULL ,
	PRIMARY KEY (cd_questao)
);

CREATE TABLE pol_questoes_assuntos (
	cd_questao_assunto  int(11) NOT NULL AUTO_INCREMENT ,
	cd_assunto  int(11) NOT NULL ,
	cd_questao  int(11) NOT NULL ,
	PRIMARY KEY (cd_questao_assunto)
);]]></atualiza><atualiza codigo="{630477AC-5E61-4B53-9138-C7EC7D032E73}" protocolo="oracle"><![CDATA[CREATE TABLE POL_ALTERNATIVAS (
