ALTER TABLE avl_avaliacoes CHANGE anosemestre ds_ano_semestre SMALLINT NULL;]]></atualiza><atualiza codigo="{855403C6-DFD4-452D-907D-DCA03C637B62}" protocolo="oracle"><![CDATA[-- Como se está diminuindo a capacidade de armazenamento o Oracle não permite tal operação no campo, 
-- então é necessário transferir os dados para outra estrutura temporária, truncar a tabela, 
-- modificar o campo e recopiar os dados para a original.
-- Cria tabela temporária
CREATE TABLE RETORNO_CP_BACKUP AS SELECT * FROM RETORNO_CP;
-- Limpa tabela original
TRUNCATE TABLE RETORNO_CP;
-- Modifica a coluna
ALTER TABLE RETORNO_CP MODIFY ( CD_RETORNO NUMBER(9) );
-- Desabilita a trigger de autoincrement
ALTER TRIGGER AUTOINC_RETORNO_C_CD_RETORN400 DISABLE;
-- Copia os dados de volta para a tabela
INSERT INTO RETORNO_CP SELECT * FROM RETORNO_CP_BACKUP;
-- Reabilita a trigger de autoincrement
ALTER TRIGGER AUTOINC_RETORNO_C_CD_RETORN400 ENABLE;
-- Dropa tabela de temporaria de backup
DROP TABLE RETORNO_CP_BACKUP;

-- Como se está diminuindo a capacidade de armazenamento o Oracle não permite tal operação no campo, 
-- então é necessário transferir os dados para outra estrutura temporária, truncar a tabela, 
-- modificar o campo e recopiar os dados para a original.
-- Cria tabela temporária
CREATE TABLE RETORNO_CP_ITENS_BACKUP AS SELECT * FROM RETORNO_CP_ITENS;
-- Limpa tabela original
TRUNCATE TABLE RETORNO_CP_ITENS;
-- Modifica a coluna
ALTER TABLE RETORNO_CP_ITENS MODIFY ( CD_RETORNO NUMBER(9) );
ALTER TABLE RETORNO_CP_ITENS MODIFY ( NR_LINHA NUMBER(9) );
ALTER TABLE RETORNO_CP_ITENS MODIFY ( CD_TITULO NUMBER(9) );
-- Copia os dados de volta para a tabela
INSERT INTO RETORNO_CP_ITENS SELECT * FROM RETORNO_CP_ITENS_BACKUP;
-- Dropa tabela de temporaria de backup
DROP TABLE RETORNO_CP_ITENS_BACKUP;

-- Permite nulo nas colunas
ALTER TABLE HISTORICO_ESCOLAS_GRAU
MODIFY ( DS_ESCOLA VARCHAR2(150 BYTE) NULL  ) 
MODIFY ( DS_ESCOLA_CIDADE VARCHAR2(40 BYTE) NULL  ) 
MODIFY ( DS_ESCOLA_ESTADO CHAR(2 BYTE) NULL  );

