UPDATE tam_inscricoes SET cd_grupo = (SELECT max(cd_grupo)+1 from nu_grupos) where cd_grupo = 0;
UPDATE nu_grupos_pessoas  SET cd_grupo = (SELECT max(cd_grupo)+1 from nu_grupos) where cd_grupo = 0;
update nu_grupos SET cd_grupo = @codigo  where cd_grupo = 0;

INSERT INTO NU_GRUPOS (DS_NOME_GRUPO, SN_BLOQUEADO, SN_FIXO)
SELECT
   NOME, 0, 0
FROM
   USUARIOS
WHERE
   CD_PESSOA IS NOT NULL

;]]></atualiza><atualiza codigo="{9765E984-E713-412B-AC29-9656B4EBDAA2}" protocolo="mysql-5"><![CDATA[INSERT IGNORE INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT DISTINCT
   G.CD_GRUPO,
   A.CD_ACAO,
   (CASE WHEN MU.ACESSAR = 'S' THEN 1 ELSE 0 END) +
   (CASE WHEN MU.INCLUIR = 'S' THEN 2 ELSE 0 END) +
   (CASE WHEN MU.ALTERAR = 'S' THEN 4 ELSE 0 END) +
   (CASE WHEN MU.DELETAR = 'S' THEN 8 ELSE 0 END) +
   (CASE WHEN MU.ESPECIAL = 'S' THEN 16 ELSE 0 END)
FROM
   USUARIOS U
      JOIN MODULOSUSUARIOS MU ON
         (U.CODIGO = MU.CODIGOUSUARIO)
      JOIN NU_GRUPOS G ON
         (U.NOME LIKE G.DS_NOME_GRUPO)
      JOIN NU_MODULOS_ACOES A ON
         (MU.CODIGOMODULO = A.DS_CHAVE);]]></atualiza><atualiza codigo="{9765E984-E713-412B-AC29-9656B4EBDAA2}" protocolo="oracle"><![CDATA[MERGE INTO "NU_GRUPOS_PERMISSOES" ngp using( 
SELECT 
   G.CD_GRUPO as grupo,
   A.CD_ACAO as acao,
   (CASE WHEN MU.ACESSAR = 'S' THEN 1 ELSE 0 END) +
   (CASE WHEN MU.INCLUIR = 'S' THEN 2 ELSE 0 END) +
   (CASE WHEN MU.ALTERAR = 'S' THEN 4 ELSE 0 END) +
   (CASE WHEN MU.DELETAR = 'S' THEN 8 ELSE 0 END) +
   (CASE WHEN MU.ESPECIAL = 'S' THEN 16 ELSE 0 END) as perm
from
   USUARIOS U
     JOIN MODULOSUSUARIOS MU ON
         (U.CODIGO = MU.CODIGOUSUARIO)
      JOIN NU_GRUPOS G ON
         (U.NOME LIKE G.DS_NOME_GRUPO)
      JOIN NU_MODULOS_ACOES A ON
         (TO_CHAR(MU.CODIGOMODULO) = A.DS_CHAVE)
) ins ON (ngp.CD_ACAO = ins.acao AND ngp.CD_GRUPO = ins.grupo )
WHEN NOT MATCHED THEN 
		INSERT (ngp.CD_GRUPO  , ngp.CD_ACAO, ngp.NR_PERMISSAO)  VALUES (ins.grupo,ins.acao,ins.perm)]]></atualiza><atualiza codigo="{C1D6F1E8-C537-4D9F-91AE-3A0AF9137CD6}" protocolo="ansi"><![CDATA[drop view uni_estnc_pessoas;
create view uni_estnc_pessoas as ( 
select ds_cpf, nm_pessoa, DATE_FORMAT( uni_p.dt_nascimento, '%d/%m/%Y' ) as dt_nascimento, ds_logradouro, ds_logradouro_nro,
ds_complemento, GROUP_CONCAT( uni_cp_telefone.ds_contato ) as ds_telefone, GROUP_CONCAT( uni_cp_email.ds_contato ) as ds_email, ds_cep, ds_bairro,
ds_cidade, ds_estado, ds_pais, ds_identidade, ds_identidade_orgao_exp, DATE_FORMAT( uni_p.dt_identidade_expedicao, '%d/%m/%Y' ) as dt_identidade_expedicao,
nm_pai, nm_mae, ds_sexo, ds_login, uni_m.curso as cd_curso, uni_c.descricao as ds_curso,
has_documento_pendente( uni_p.cd_pessoa ) as sn_documentos_pendentes, count( uni_mens.cd_mensalidade ) as sn_financeiro,
uni_p.cd_estado_civil from pessoas as uni_p 
INNER JOIN matriculas as uni_m ON ( uni_m.codigoaluno = uni_p.cd_pessoa )
INNER JOIN matriculas_curso as uni_mc ON ( uni_mc.cd_pessoa = uni_m.codigoaluno )
INNER JOIN cursos as uni_c ON ( uni_mc.cd_curso = uni_c.codigo AND uni_mc.nr_anosem_grade = uni_c.anosemestre )
LEFT JOIN mensalidades as uni_mens ON ( uni_mens.codigoaluno = uni_p.cd_pessoa and uni_mens.dt_competencia  < NOW() and uni_mens.situacao not in ( 0, 1, 3, 4, 5, 6, 7 )  )
LEFT JOIN contatos_pessoas as  uni_cp_telefone ON ( uni_cp_telefone.cd_pessoa = uni_p.cd_pessoa and uni_cp_telefone.cd_contato=3 )
LEFT JOIN contatos_pessoas as  uni_cp_email ON ( uni_cp_email.cd_pessoa = uni_p.cd_pessoa and uni_cp_email.cd_contato=4 )
GROUP BY uni_p.cd_pessoa);]]></atualiza><atualiza codigo="{98B07DDD-4010-4AED-89DC-1CDC38DC5FDD}" protocolo="ansi"><![CDATA[ALTER TABLE `usuarios` ADD `sn_online` CHAR(1) NULL AFTER `codigo`;
UPDATE usuarios SET sn_online = online;]]></atualiza><atualiza codigo="{70050DC6-CC8F-46D7-84EC-9D865DB127AC}" protocolo="mysql-5"><![CDATA[ALTER TABLE `iol_relatorios` ADD COLUMN `cd_modulo`  int(11) NULL AFTER `cd_relatorio`;]]></atualiza><atualiza codigo="{70050DC6-CC8F-46D7-84EC-9D865DB127AC}" protocolo="oracle"><![CDATA[ALTER TABLE IOL_RELATORIOS ADD ( "CD_MODULO" NUMBER(19) NULL  );]]></atualiza><atualiza codigo="{E47D3968-01E1-4F06-BB90-942E3447AF3B}" protocolo="ansi"><![CDATA[INSERT INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
  SELECT
     G.CD_GRUPO,
     P.CD_PESSOA,
     C.CD_COLIGADA
  FROM
     COLIGADAS C,
     USUARIOS U
        JOIN NU_GRUPOS G ON
           (U.NOME LIKE G.DS_NOME_GRUPO)
        JOIN PESSOAS P ON
           (u.cd_pessoa = p.cd_pessoa);]]></atualiza><atualiza codigo="{40C18B4D-0BD3-412C-8462-03CEC4F4B78F}" protocolo="ansi"><![CDATA[SELECT 1 FROM dual;]]></atualiza><atualiza codigo="{4B36FCC0-3864-4DB3-892F-BAF8D58EF09E}" protocolo="ansi"><![CDATA[INSERT INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   G.CD_GRUPO,
   (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = '1'),
   31
FROM
   USUARIOS U
      JOIN NU_GRUPOS G ON
         (U.NOME LIKE G.DS_NOME_GRUPO)
WHERE
   U.ONLINE = 'S';


UPDATE nu_grupos_pessoas SET cd_coligada = (SELECT MIN(CD_COLIGADA) FROM COLIGADAS) where cd_coligada = 0 ;]]></atualiza><atualiza codigo="{2B092ECC-98FC-4FEA-BF44-37FDFCF4FFBA}" protocolo="mysql-5"><![CDATA[DELIMITER //
CREATE FUNCTION `FIRST_OCCURRENCE`(ENTRADA VARCHAR(255))
    RETURNS VARCHAR(255)
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
     RETURN CONCAT(ENTRADA, '');
END//]]></atualiza><atualiza codigo="{2B092ECC-98FC-4FEA-BF44-37FDFCF4FFBA}" protocolo="oracle"><![CDATA[select 1 from dual;]]></atualiza><atualiza codigo="{1C4AAFF7-5125-44E1-9EC4-0292F09D6AF1}" protocolo="mysql-5"><![CDATA[ALTER TABLE `nu_parametros` ADD COLUMN `cd_coligada`  smallint(6) NULL AFTER `cd_parametro_tipo`;
ALTER TABLE `nu_parametros` DROP INDEX `cd_parametro_2`, ADD UNIQUE INDEX `uk_cd_parametro` USING BTREE (`ds_parametro`, `cd_modulo`, `cd_coligada`);]]></atualiza><atualiza codigo="{1C4AAFF7-5125-44E1-9EC4-0292F09D6AF1}" protocolo="oracle"><![CDATA[ALTER TABLE "NU_PARAMETROS"
 ADD ( "CD_COLIGADA" NUMBER(9) NULL  );]]></atualiza><atualiza codigo="{C462194F-F3F9-4FC2-9E8B-01F036829144}" protocolo="mysql-5"><![CDATA[ALTER TABLE GRADES RENAME GRADES_MUDADO;

CREATE TABLE GRADES (
	CD_GRADE INTEGER(11) UNSIGNED NOT NULL,
	CD_CURSO VARCHAR(15) NOT NULL,
	DS_GRADE VARCHAR(255),
	NR_ANO_INICIAL INTEGER(6),
	PRIMARY KEY(CD_GRADE, CD_CURSO)
);

ALTER TABLE GRADES_DISCIPLINAS RENAME GRADES_DISCIPLINAS_MUDADO;

CREATE TABLE GRADES_DISCIPLINAS (
	CD_GRADE INTEGER(11) UNSIGNED NOT NULL,
	CD_CURSO VARCHAR(15) NOT NULL,
	CD_DISCIPLINA INTEGER(11),
	NR_SERIE INTEGER(5),
	NR_AULAS FLOAT,
	VL_VALOR FLOAT,
	SN_COMPARTILHADA INTEGER(1),
	NR_CREDITOS_ACADEMICOS INTEGER(11),
	CD_DISCIPLINA_CATEGORIA INTEGER(11),
	NR_CARGA_HORARIA_PRATICA FLOAT,
	NR_CARGA_HORARIA_TEORICA FLOAT,
	PRIMARY KEY(CD_GRADE, CD_CURSO, CD_DISCIPLINA, NR_SERIE)
);

INSERT INTO GRADES(CD_GRADE, CD_CURSO, DS_GRADE, NR_ANO_INICIAL)
SELECT
		CONCAT(ANOSEMESTRE, CD_GRADE), CURSO,
		LEFT(CONCAT(ANOSEMESTRE, '.' || CD_GRADE || '.' || CURSO || '.' || DISCIPLINAS), 255),
		ANOSEMESTRE
FROM (
		SELECT
				FIRST_OCCURRENCE(ANOSEMESTRE) AS ANOSEMESTRE,
				FIRST_OCCURRENCE(CURSO) AS CURSO,
				FIRST_OCCURRENCE(CD_GRADE) AS CD_GRADE,
				FIRST_OCCURRENCE(QTD_DISCIPLINAS),
				DISCIPLINAS
		FROM
		(
				SELECT
						ANOSEMESTRE, CURSO, CD_GRADE,
						(
								SELECT GROUP_CONCAT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS DISCIPLINAS,
						(
								SELECT COUNT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS QTD_DISCIPLINAS
				FROM
						GRADECURRICULAR GC
				WHERE
						ANOSEMESTRE > 0
				GROUP BY
						ANOSEMESTRE, CURSO, CD_GRADE
				ORDER BY
						ANOSEMESTRE, CURSO, CD_GRADE
		) tabela
		GROUP BY
				tabela.ANOSEMESTRE, tabela.CURSO, tabela.CD_GRADE, tabela.DISCIPLINAS
		ORDER BY
				tabela.ANOSEMESTRE, tabela.CURSO, tabela.CD_GRADE
) t2;

COMMIT;

INSERT INTO GRADES_DISCIPLINAS(
	CD_GRADE, CD_CURSO, CD_DISCIPLINA, NR_SERIE, NR_AULAS, VL_VALOR,
		SN_COMPARTILHADA, NR_CREDITOS_ACADEMICOS, CD_DISCIPLINA_CATEGORIA,
		NR_CARGA_HORARIA_PRATICA, NR_CARGA_HORARIA_TEORICA
)
SELECT
	CONCAT(GC.ANOSEMESTRE, GC.CD_GRADE), GC.CURSO, GC.DISCIPLINA, GC.SERIE,
	FIRST_OCCURRENCE(GC.NUMEROAULAS), FIRST_OCCURRENCE(GC.VALOR),
	FIRST_OCCURRENCE(GC.SN_COMPARTILHADA), FIRST_OCCURRENCE(GC.NR_CREDITOS_ACADEMICOS),
	FIRST_OCCURRENCE(GC.CD_DISC_CATEGORIA), FIRST_OCCURRENCE(GC.NR_CH_PRATICA),
	FIRST_OCCURRENCE(GC.NR_CH_TEORICA)
FROM
	(
		SELECT
			FIRST_OCCURRENCE(ANOSEMESTRE) AS ANOSEMESTRE,
			FIRST_OCCURRENCE(CD_GRADE) AS CD_GRADE,
			FIRST_OCCURRENCE(CURSO) AS CURSO,
			DISCIPLINAS
		FROM
			(
				SELECT
						ANOSEMESTRE, CURSO, CD_GRADE,
						(
								SELECT GROUP_CONCAT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS DISCIPLINAS,
						(
								SELECT COUNT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS QTD_DISCIPLINAS
				FROM
						GRADECURRICULAR GC
				WHERE
						ANOSEMESTRE > 0
				GROUP BY
						ANOSEMESTRE, CURSO, CD_GRADE
				ORDER BY
						ANOSEMESTRE, CURSO, CD_GRADE
			) T1
		GROUP BY DISCIPLINAS
	) T2
	INNER JOIN GRADECURRICULAR GC ON (
		GC.ANOSEMESTRE = T2.ANOSEMESTRE AND
		GC.CD_GRADE = T2.CD_GRADE AND
		GC.CURSO = T2.CURSO
	)
GROUP BY
	CONCAT(GC.ANOSEMESTRE, GC.CD_GRADE), GC.CURSO, GC.DISCIPLINA, GC.SERIE;

COMMIT;]]></atualiza><atualiza codigo="{C462194F-F3F9-4FC2-9E8B-01F036829144}" protocolo="oracle"><![CDATA[ALTER TABLE GRADES RENAME TO "GRADES_MUDADO";

CREATE TABLE "GRADES" (
	"CD_GRADE" NUMBER(9) NOT NULL,
	"CD_CURSO" VARCHAR2(15 CHAR) NOT NULL,
	"DS_GRADE" VARCHAR2(255),
	"NR_ANO_INICIAL" NUMBER(5),
	PRIMARY KEY("CD_GRADE", "CD_CURSO")
);

ALTER TABLE GRADES_DISCIPLINAS RENAME TO "GRADES_DISCIPLINAS";

CREATE TABLE "GRADES_DISCIPLINAS" (
	"CD_GRADE" NUMBER(9) NOT NULL,
	"CD_CURSO" VARCHAR2(15 CHAR) NOT NULL,
	"CD_DISCIPLINA" NUMBER(9),
	"NR_SERIE" NUMBER(5),
	"NR_AULAS" FLOAT(126),
	"VL_VALOR" FLOAT(126),
	"SN_COMPARTILHADA" NUMBER(4),
	"NR_CREDITOS_ACADEMICOS" NUMBER(9),
	"CD_DISCIPLINA_CATEGORIA" NUMBER(9),
	"NR_CARGA_HORARIA_PRATICA" FLOAT(126),
	"NR_CARGA_HORARIA_TEORICA" FLOAT(126),
	PRIMARY KEY("CD_GRADE", "CD_CURSO", "CD_DISCIPLINA", "NR_SERIE")
);

INSERT INTO GRADES(CD_GRADE, CD_CURSO, DS_GRADE, NR_ANO_INICIAL)
SELECT
		CONCAT(ANOSEMESTRE, CD_GRADE), CURSO,
		LEFT(CONCAT(ANOSEMESTRE, '.' || CD_GRADE || '.' || CURSO || '.' || DISCIPLINAS), 255),
		ANOSEMESTRE
FROM (
		SELECT
				FIRST_OCCURRENCE(ANOSEMESTRE) AS ANOSEMESTRE,
				FIRST_OCCURRENCE(CURSO) AS CURSO,
				FIRST_OCCURRENCE(CD_GRADE) AS CD_GRADE,
				FIRST_OCCURRENCE(QTD_DISCIPLINAS),
				DISCIPLINAS
		FROM
		(
				SELECT
						ANOSEMESTRE, CURSO, CD_GRADE,
						(
								SELECT GROUP_CONCAT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = 

GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS DISCIPLINAS,
						(
								SELECT COUNT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = 

GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS QTD_DISCIPLINAS
				FROM
						GRADECURRICULAR GC
				WHERE
						ANOSEMESTRE > 0
				GROUP BY
						ANOSEMESTRE, CURSO, CD_GRADE
				ORDER BY
						ANOSEMESTRE, CURSO, CD_GRADE
		) tabela
		GROUP BY
				tabela.ANOSEMESTRE, tabela.CURSO, tabela.CD_GRADE, tabela.DISCIPLINAS
		ORDER BY
				tabela.ANOSEMESTRE, tabela.CURSO, tabela.CD_GRADE
) t2;

COMMIT;

INSERT INTO GRADES_DISCIPLINAS(
	CD_GRADE, CD_CURSO, CD_DISCIPLINA, NR_SERIE, NR_AULAS, VL_VALOR,
		SN_COMPARTILHADA, NR_CREDITOS_ACADEMICOS, CD_DISCIPLINA_CATEGORIA,
		NR_CARGA_HORARIA_PRATICA, NR_CARGA_HORARIA_TEORICA
)
SELECT
	CONCAT(GC.ANOSEMESTRE, GC.CD_GRADE), GC.CURSO, GC.DISCIPLINA, GC.SERIE,
	FIRST_OCCURRENCE(GC.NUMEROAULAS), FIRST_OCCURRENCE(GC.VALOR),
	FIRST_OCCURRENCE(GC.SN_COMPARTILHADA), FIRST_OCCURRENCE(GC.NR_CREDITOS_ACADEMICOS),
	FIRST_OCCURRENCE(GC.CD_DISC_CATEGORIA), FIRST_OCCURRENCE(GC.NR_CH_PRATICA),
	FIRST_OCCURRENCE(GC.NR_CH_TEORICA)
FROM
	(
		SELECT
			FIRST_OCCURRENCE(ANOSEMESTRE) AS ANOSEMESTRE,
			FIRST_OCCURRENCE(CD_GRADE) AS CD_GRADE,
			FIRST_OCCURRENCE(CURSO) AS CURSO,
			DISCIPLINAS
		FROM
			(
				SELECT
						ANOSEMESTRE, CURSO, CD_GRADE,
						(
								SELECT GROUP_CONCAT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = 

GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS DISCIPLINAS,
						(
								SELECT COUNT(GC2.DISCIPLINA)
								FROM (SELECT * FROM GRADECURRICULAR ORDER BY DISCIPLINA) GC2
								WHERE GC2.ANOSEMESTRE = GC.ANOSEMESTRE AND
											GC2.CURSO = GC.CURSO AND GC.CD_GRADE = 

GC2.CD_GRADE
								GROUP BY GC2.ANOSEMESTRE, GC2.CURSO,GC2.CD_GRADE
						) AS QTD_DISCIPLINAS
				FROM
						GRADECURRICULAR GC
				WHERE
						ANOSEMESTRE > 0
				GROUP BY
						ANOSEMESTRE, CURSO, CD_GRADE
				ORDER BY
						ANOSEMESTRE, CURSO, CD_GRADE
			) T1
		GROUP BY DISCIPLINAS
	) T2
	INNER JOIN GRADECURRICULAR GC ON (
		GC.ANOSEMESTRE = T2.ANOSEMESTRE AND
		GC.CD_GRADE = T2.CD_GRADE AND
		GC.CURSO = T2.CURSO
	)
GROUP BY
	CONCAT(GC.ANOSEMESTRE, GC.CD_GRADE), GC.CURSO, GC.DISCIPLINA, GC.SERIE;

COMMIT;]]></atualiza><atualiza codigo="{6C25CE05-A50D-44DF-A538-D337D3D4CE0D}" protocolo="mysql-5"><![CDATA[INSERT INTO 
