	'Definir os campos que deverão ser apresentados na Planilha de Atendimentos da Ficha de Saúde', 2, 0
);]]></atualiza><atualiza codigo="{FC84F8F7-10E6-42E9-9CD2-58D6CA3F015D}" protocolo="mysql-5"><![CDATA[DELIMITER //

CREATE TRIGGER atualiza_numero_aulas_ins AFTER INSERT ON diario_aulas
FOR EACH ROW   BEGIN
	DECLARE QTD INTEGER;

	SET QTD = NULL;

	SELECT 
		 SUM(QTD_AULAS) 
	FROM 
		 DIARIO_AULAS 
	WHERE 
		 TURMA = NEW.TURMA AND 
		 ANOSEMESTRE = NEW.ANOSEMESTRE AND 
		 DISCIPLINA = NEW.DISCIPLINA 
	INTO QTD;
		
	UPDATE 
		 TURMASPROFESSORES 
	SET 
		 NUMEROAULAS = QTD 
	WHERE 
		 TURMA = NEW.TURMA AND 
		 ANOSEMESTRE = NEW.ANOSEMESTRE AND 
		 DISCIPLINA = NEW.DISCIPLINA;
END//

CREATE TRIGGER atualiza_numero_aulas_upd BEFORE UPDATE ON diario_aulas
FOR EACH ROW  BEGIN
	DECLARE QTD INTEGER;

	SET QTD = NULL;

	SELECT 
		 SUM(QTD_AULAS) 
	FROM 
		 DIARIO_AULAS 
	WHERE 
		 TURMA = NEW.TURMA AND 
		 ANOSEMESTRE = NEW.ANOSEMESTRE AND 
		 DISCIPLINA = NEW.DISCIPLINA 
	INTO QTD;
		
	UPDATE 
		 TURMASPROFESSORES 
	SET 
		 NUMEROAULAS = QTD 
	WHERE 
		 TURMA = NEW.TURMA AND 
		 ANOSEMESTRE = NEW.ANOSEMESTRE AND 
		 DISCIPLINA = NEW.DISCIPLINA;
END//

CREATE TRIGGER atualiza_numero_aulas_del AFTER DELETE ON diario_aulas
FOR EACH ROW    BEGIN
	DECLARE QTD INTEGER;

	SET QTD = NULL;

	SELECT 
		 SUM(QTD_AULAS) 
	FROM 
		 DIARIO_AULAS 
	WHERE 
		 TURMA = OLD.TURMA AND 
		 ANOSEMESTRE = OLD.ANOSEMESTRE AND 
		 DISCIPLINA = OLD.DISCIPLINA 
	INTO QTD;
		
	UPDATE 
		 TURMASPROFESSORES 
	SET 
		 NUMEROAULAS = QTD 
	WHERE 
		 TURMA = OLD.TURMA AND 
		 ANOSEMESTRE = OLD.ANOSEMESTRE AND 
		 DISCIPLINA = OLD.DISCIPLINA;
END//]]></atualiza><atualiza codigo="{FC84F8F7-10E6-42E9-9CD2-58D6CA3F015D}" protocolo="oracle"><![CDATA[DELIMITER //

CREATE OR REPLACE TRIGGER atualiza_numero_aulas_ins AFTER INSERT ON DIARIO_AULAS REFERENCING FOR EACH ROW
DECLARE
	QTD NUMBER;
BEGIN	
	QTD := NULL;

	SELECT 
		 SUM(QTD_AULAS) INTO QTD
	FROM 
		 DIARIO_AULAS 
	WHERE 
		 TURMA LIKE :NEW.TURMA AND 
		 ANOSEMESTRE = :NEW.ANOSEMESTRE AND 
		 DISCIPLINA = :NEW.DISCIPLINA;

	UPDATE 
		 TURMASPROFESSORES 
	SET 
		 NUMEROAULAS = QTD 
	WHERE 
		 TURMA LIKE :NEW.TURMA AND 
		 ANOSEMESTRE = :NEW.ANOSEMESTRE AND 
		 DISCIPLINA = :NEW.DISCIPLINA;

END//

ALTER TRIGGER atualiza_numero_aulas_ins ENABLE//


CREATE OR REPLACE TRIGGER atualiza_numero_aulas_upd BEFORE UPDATE ON DIARIO_AULAS REFERENCING FOR EACH ROW
DECLARE
	QTD NUMBER;
BEGIN	
	QTD := NULL;

	SELECT 
		 SUM(QTD_AULAS) INTO QTD
	FROM 
		 DIARIO_AULAS 
	WHERE 
		 TURMA LIKE :NEW.TURMA AND 
		 ANOSEMESTRE = :NEW.ANOSEMESTRE AND 
		 DISCIPLINA = :NEW.DISCIPLINA;

	UPDATE 
		 TURMASPROFESSORES 
	SET 
		 NUMEROAULAS = QTD 
	WHERE 
		 TURMA LIKE :NEW.TURMA AND 
		 ANOSEMESTRE = :NEW.ANOSEMESTRE AND 
		 DISCIPLINA = :NEW.DISCIPLINA;

END//

ALTER TRIGGER atualiza_numero_aulas_upd ENABLE//


CREATE OR REPLACE TRIGGER atualiza_numero_aulas_del AFTER DELETE ON DIARIO_AULAS REFERENCING FOR EACH ROW
DECLARE
	QTD NUMBER;
BEGIN	
	QTD := NULL;

	SELECT 
		 SUM(QTD_AULAS) INTO QTD
	FROM 
		 DIARIO_AULAS 
	WHERE 
		 TURMA LIKE :OLD.TURMA AND 
		 ANOSEMESTRE = :OLD.ANOSEMESTRE AND 
		 DISCIPLINA = :OLD.DISCIPLINA;

	UPDATE 
		 TURMASPROFESSORES 
	SET 
		 NUMEROAULAS = QTD 
	WHERE 
		 TURMA LIKE :OLD.TURMA AND 
		 ANOSEMESTRE = :OLD.ANOSEMESTRE AND 
		 DISCIPLINA = :OLD.DISCIPLINA;

END//

ALTER TRIGGER atualiza_numero_aulas_del ENABLE//]]></atualiza><atualiza codigo="{0CC159A3-254B-4085-BBB0-09DB2F6AF0C4}" protocolo="mysql-5"><![CDATA[ALTER TABLE equivalenciasdisciplinas ADD COLUMN eq_frequencia DOUBLE NULL;
ALTER TABLE equivalencias ADD COLUMN frequencia DOUBLE NULL;]]></atualiza><atualiza codigo="{0CC159A3-254B-4085-BBB0-09DB2F6AF0C4}" protocolo="oracle"><![CDATA[ALTER TABLE EQUIVALENCIASDISCIPLINAS ADD ( EQ_FREQUENCIA FLOAT NULL ) ;
ALTER TABLE EQUIVALENCIAS ADD ( FREQUENCIA FLOAT NULL ) ;]]></atualiza><atualiza codigo="{207597E9-B853-49B7-BDB9-FBA055C47C56}" protocolo="ansi"><![CDATA[ALTER TABLE `fin_cadastro_contas`  ADD COLUMN `sn_conta_resultado` TINYINT(1) NOT NULL DEFAULT '1' AFTER `sn_ativa`;]]></atualiza><atualiza codigo="{34B9D1C3-560E-4F07-9B1F-EA143FF30998}" protocolo="mysql-5"><![CDATA[CREATE TABLE bib_inventarios_proc (`cd_processo` INT , `ds_codigo_barra` VARCHAR (255) NOT NULL, PRIMARY KEY(`cd_processo`,ds_codigo_barra)) TYPE = MyISAM /*!40100 DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci */;]]></atualiza><atualiza codigo="{34B9D1C3-560E-4F07-9B1F-EA143FF30998}" protocolo="oracle"><![CDATA[CREATE TABLE "BIB_INVENTARIOS_PROC" (
"CD_PROCESSO" NUMBER(9) NULL ,
