	CD_INSCRICAO_ATIVIDADE NUMBER(19) NOT NULL,
	CD_ATIVIDADE NUMBER(19) NOT NULL,
	CD_INSCRICAO NUMBER(19) NOT NULL
	);

ALTER TABLE TAM_INSCRICOES_ATIVIDADES ADD PRIMARY KEY(CD_INSCRICAO_ATIVIDADE);

ALTER TABLE TAM_INSCRICOES_ATIVIDADES ADD CONSTRAINT FK_TAM_INSC_ATIV_CD_INSCRICAO FOREIGN KEY (CD_INSCRICAO) REFERENCES TAM_INSCRICOES(CD_INSCRICAO);
ALTER TABLE TAM_INSCRICOES_ATIVIDADES ADD CONSTRAINT FK_TAM_INSC_ATIV_CD_ATIVIDADE FOREIGN KEY (CD_ATIVIDADE) REFERENCES TAM_ATIVIDADES(CD_ATIVIDADE);

CALL CRIAR_AUTO_INCREMENT('TAM_INSCRICOES_ATIVIDADES', 'CD_INSCRICAO_ATIVIDADE', 'SEQ_TAM_INSC_ATIV_CD_INSC_ATIV', 'AUTOINC_TAM_INS_ATV_CD_INS_ATV');

ALTER TABLE TAM_INSCRICOES_ATIVIDADES ADD CONSTRAINT UK_ATIVIDADE_INSCRICAO UNIQUE (CD_ATIVIDADE, CD_INSCRICAO);

ALTER TABLE TAM_ENTRADAS ADD  CD_INSCRICAO_ATIVIDADE NUMBER(19) NULL;

INSERT INTO TAM_ATIVIDADES(
	CD_ATIVIDADE,
	DS_ATIVIDADE,
	SN_ESCOLHE,
	CD_EVENTO,
	SN_ATIVIDADE_PADRAO
)SELECT DISTINCT
	NULL,
	'atividade padrão',
	0,
	TE.CD_EVENTO,
	1
FROM
	TAM_EVENTOS TE;

--FORMA
INSERT INTO TAM_INSCRICOES_ATIVIDADES TIA 
	(CD_ATIVIDADE, CD_INSCRICAO) 
  SELECT 
      TA.CD_ATIVIDADE,
			TI.CD_INSCRICAO
		FROM
			TAM_INSCRICOES  TI
			INNER JOIN TAM_EVENTOS TE ON(TE.CD_EVENTO = TI.CD_EVENTO)
			INNER JOIN TAM_ATIVIDADES TA ON(TA.CD_EVENTO = TE.CD_EVENTO)
		WHERE
			TE.CD_EVENTO IN(
				SELECT
					CD_EVENTO
				FROM
					TAM_EVENTOS
			)
			AND TA.SN_ESCOLHE = 0;
--FORMA

