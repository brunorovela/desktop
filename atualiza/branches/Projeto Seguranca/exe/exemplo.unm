SET SQL_LOG_BIN := 0//

SET GLOBAL log_bin_trust_function_creators := 1//

ALTER TABLE `parametros`
DROP INDEX `PrimaryKey` ,
ADD UNIQUE INDEX `PrimaryKey` USING BTREE (`ds_variavel`, `cd_coligada`)//

DROP FUNCTION GET_PARAMETROS_COLIGADA//
CREATE FUNCTION `GET_PARAMETROS_COLIGADA`(PDS_PARAMETRO VARCHAR(255), PCD_COLIGADA INT(11))
 RETURNS mediumtext
    DETERMINISTIC
BEGIN
	DECLARE DS_VALOR_PAR MEDIUMTEXT DEFAULT NULL;
	DECLARE NR_REGISTROS INT(11) DEFAULT 0;

	SELECT ds_valor
	FROM parametros
	WHERE ds_variavel = PDS_PARAMETRO AND cd_coligada = PCD_COLIGADA
	INTO DS_VALOR_PAR;

	SELECT FOUND_ROWS() INTO NR_REGISTROS;

	IF ( NR_REGISTROS = 0 AND PCD_COLIGADA != 0 ) THEN
		SELECT ds_valor
		FROM parametros
		WHERE ds_variavel = PDS_PARAMETRO AND cd_coligada = 0
		INTO DS_VALOR_PAR;
	END IF;

	RETURN DS_VALOR_PAR;
END//

