# Por erro do atualiza anterior, este irá deletar as permissoes e parâmetros e recrialos
DELETE FROM parametros WHERE ds_variavel = 'ficha_saude_completa';
DELETE FROM parametros WHERE ds_variavel = 'ficha_saude_impressao_tipo';
DELETE FROM parametros WHERE ds_variavel = 'ficha_saude_campos';
DELETE FROM parametros WHERE ds_variavel = 'planilha_ficha_saude_atendimentos_campos';

DELETE ngp
FROM
	nu_grupos_permissoes ngp
WHERE
	ngp.cd_acao IN (
		SELECT cd_acao 
		FROM nu_modulos_acoes 
		WHERE ds_chave IN ( 'FichaSaude', 'FichaSaude.Prontuario' ) AND 
					cd_modulo = (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'Academico')
	);

DELETE FROM nu_modulos_acoes
WHERE ds_chave IN ( 'FichaSaude', 'FichaSaude.Prontuario' ) AND 
			cd_modulo = (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'Academico');
# Por erro do atualiza anterior, este irá deletar as permissoes e parâmetros e recrialos
########################################################################################################################

# Inclusão do parâmetro "ficha_saude_completa"
