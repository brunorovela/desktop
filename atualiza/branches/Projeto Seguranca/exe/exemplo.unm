INSERT INTO parametros(
	ds_variavel, ds_valor, sn_restrito, ds_variavel_usuario, cd_categoria, cd_tipo, cd_coligada
) VALUES (
	'ficha_saude_campos', '', 'N', 
	'Impressão da Ficha de Saúde da pessoa usando impressora fiscal.\r\nVariáveis disponíveis:\r\n\r\n# Informações sobre o atendimento\r\n[codigo] - Código da Pessoa.\r\n[nome] - Nome da Pessoa.\r\n[acompanhado_sim] - Apresenta \"X\" se a pessoa veio acompanhada;\r\n[acompanhado_nao] - Apresenta \"X\" se a pessoa não veio acompanhada;\r\n[nome_acompanhante] - Nome de quem estava acompanhando a pessoa;\r\n[medicado_casa_sim] - Apresenta \"X\" se a pessoa tomou medicamento em casa;\r\n[medicado_casa_nao] - Apresenta \"X\" se a pessoa não tomou medicamento em casa;\r\n[medicamento_casa] - Nome do medicamento que foi tomado em casa;\r\n[pressao_arterial] - Pressão arterial da pessoa;\r\n[temperatura] - Temperatura da pessoa;\r\n[comunicado_telefone_sim] - Apresenta \"X\" se os pais foram comunicados por telefone;\r\n[comunicado_telefone_nao] - Apresenta \"X\" se os pais não foram comunicados por telefone;\r\n[comunicado_agenda_sim] - Apresenta \"X\" se os pais foram comunicados por agenda;\r\n[comunicado_agenda_nao] - Apresenta \"X\" se os pais não foram comunicados por agenda;\r\n[comunicado_email_sim] - Apresenta \"X\" se os pais foram comunicados por email;\r\n[comunicado_email_nao] - Apresenta \"X\" se os pais não foram comunicados por email;\r\n[comunicado_ocorrencia_sim] - Apresenta \"X\" se os pais foram comunicados por ocorrência;\r\n[comunicado_ocorrencia_nao] - Apresenta \"X\" se os pais não foram comunicados por ocorrência;\r\n[comunicado_outros] - Outro meio de comunicação com os pais;\r\n[retornou_para] - Local para onde o aluno retornou;\r\n[retornou_com_quem] - Nome de quem retornou com a pessoa;\r\n[procedimento_adotado] - Procedimento adotado no atendimento;\r\n[peso] - Peso da pessoa;\r\n\r\n# Outras\r\n[unidade_nome] - NOME cadastrado na Unidade de Ensino.\r\n[DATA] - Data do Computador\r\n[HORA] - Hora do Computador\r\n<b> - inicio de negrito\r\n</b> - término do negrito\r\n#13 - ENTER\r\nCENTRO[Texto|Tamanho] - Centraliza um texto dentro deste tamanho de caracteres\r\nDIREITA[Texto|Tamanho] - Alinha o texto a direita dentro deste tamanho de caracteres', 0, 0, 1
);

