 `ds_chave`)
VALUES (NULL, (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = @modulo),
 @nome_acao, @chave);

# Definir a permissão
INSERT INTO `nu_grupos_permissoes`(`cd_permissao`, `cd_grupo`, `cd_acao`,
 `nr_permissao`)
VALUES (NULL, 1, (SELECT cd_acao FROM nu_modulos_acoes WHERE ds_chave =
 @chave and cd_modulo =(SELECT cd_modulo FROM nu_modulos WHERE
 ds_chave = @modulo)), 31);

ALTER TABLE AVALIACOES_PROVAS_TIPOS ADD COLUMN SN_SEM_LIMITE TINYINT(1) NOT NULL DEFAULT '1';
