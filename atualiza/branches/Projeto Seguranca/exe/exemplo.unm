   ADD CONSTRAINT UK_USUARIO_COLIGADA UNIQUE (CD_PESSOA, CD_GRUPO, CD_COLIGADA);]]></atualiza><atualiza codigo="{33CB2E98-4775-4B8F-9F48-6B4498C1A5D7}" protocolo="oracle"><![CDATA[ALTER TABLE "UNIMESTRE"."NU_GRUPOS_PESSOAS"
