# ATUALIZAÇÕES DE NOTA DE EXAME, RETIRADO O TRATAMENTO DE NOTAEXAME -3 PARA ALUNOS QUE FALTARAM AO EXAME
# PORQUE ESTÁ SENDO UTILIZADO O CAMPO SN_FALTOU_EXAME DA FICHAINDIVIDUAL PARA ESSA CHECAGEM
# --------------------------------------------------------------------------------------------------------

UPDATE fichaindividual SET sn_faltou_exame = 1, notaexame = null WHERE notaexame = -3//


# --------------------------------------------------------------------------------------------------------
# ADICIONADO O CAMPO DE BLOQUEIO DA NOTA DE SEGUNDA EPOCA PARA FICAR IGUAL AO DA NOTA DE EXAME
# --------------------------------------------------------------------------------------------------------

ALTER TABLE fichaindividual ADD sn_bloqueio_2epoca NUMBER(5) DEFAULT 0 NOT NULL//

# --------------------------------------------------------------------------------------------------------
