  # --------------------------------------------------------------------------------------------------------
  # ATUALIZAÇÕES DE NOTA DE EXAME, RETIRADO O TRATAMENTO DE NOTAEXAME -3 PARA ALUNOS QUE FALTARAM AO EXAME
  # PORQUE ESTÁ SENDO UTILIZADO O CAMPO SN_FALTOU_EXAME DA FICHAINDIVIDUAL PARA ESSA CHECAGEM
  # --------------------------------------------------------------------------------------------------------
  
  UPDATE fichaindividual SET sn_faltou_exame = 1, notaexame = null WHERE notaexame = -3//
  
  
  # --------------------------------------------------------------------------------------------------------
  # ADICIONADO O CAMPO DE BLOQUEIO DA NOTA DE SEGUNDA EPOCA PARA FICAR IGUAL AO DA NOTA DE EXAME
  # --------------------------------------------------------------------------------------------------------
  
  ALTER TABLE `fichaindividual`
  ADD COLUMN `sn_bloqueio_2epoca`  tinyint(1) NOT NULL DEFAULT 0 COMMENT 'Define se a nota de segunda epoca desse aluno se encontra bloqueada para alteração.' AFTER `media_ajustada`,
  DROP PRIMARY KEY,
  ADD PRIMARY KEY (`anosemestre`, `turma`, `codigograde`, `codigoaluno`, `disciplina`, `serie`, `situacao`)//
  
  # --------------------------------------------------------------------------------------------------------
  # ADICIONADO O PARAMETRO QUE INDICA SE O PROFESSOR PODE ALTERAR NOTA 2 EPOCA PARA FICAR IGUAL AO DA NOTA DE EXAME
  # --------------------------------------------------------------------------------------------------------
  
  ALTER TABLE `avaliacoes_parametros`
  ADD COLUMN `sn_alterar_2epoca`  tinyint(1) NOT NULL DEFAULT 1 COMMENT 'Parametro que indica se o professor pode alterar a nota da segunda época após lançamento' AFTER `sn_ajuste_media`//
  
  # --------------------------------------------------------------------------------------------------------
  # ADICIONADO O PARAMETRO QUE INDICA SE O PROFESSOR PODE CALCULAR MEDIA ARITMETICA DAS NOTAS DIGITADAS
  # --------------------------------------------------------------------------------------------------------
  
  ALTER TABLE `avaliacoes_parametros`
  ADD COLUMN `sn_calcular_media_aritmetica` tinyint(1) NOT NULL DEFAULT 1 COMMENT 'Permitir aos professores calcularem Média Aritmética das notas digitadas' AFTER `sn_alterar_2epoca`//
  
  # --------------------------------------------------------------------------------------------------------
  # ADICIONADO O CAMPO DE DATA DE ENVIO DAS NOTAS DE SEGUNDA EPOCA PARA FICAR IGUAL AO DA NOTA DE EXAME
  # --------------------------------------------------------------------------------------------------------
  
  ALTER TABLE `diario_turmas`
  ADD COLUMN `dt_envio_2epoca`  datetime NULL DEFAULT NULL COMMENT 'Grava a última data de envio das notas de segunda epoca, preenchimento automático pelo sistema com data atual.' AFTER `dt_envio_exame`//
  
  # -------------------------------------------------------------------------------------------
  # ADICIONANDO CAMPO CD_DIARIO_AULAS NA TABELA DE DIARIO_AULAS (OUTRO ATUALIZA ANTIGO) 
  # TEM QUE GARANTIR QUE O CAMPO ESTEJA NESSA TABELA
  # -------------------------------------------------------------------------------------------
  
  ALTER TABLE `diario_aulas` ADD `cd_diario_aula` INT UNSIGNED NULL FIRST//
  SET @inc :=0//
  update diario_aulas set cd_diario_aula = @inc := @inc+1//
  ALTER TABLE `diario_aulas` ADD PRIMARY KEY (`cd_diario_aula`)//
  ALTER TABLE `diario_aulas` CHANGE `cd_diario_aula` `cd_diario_aula` INT(11) UNSIGNED NULL AUTO_INCREMENT//
  
  # -------------------------------------------------------------------------------------------
  # ADICIONANDO DUAS COLUNA DE CODIGO PAI NOS LOGS PARA VINCULAR CADA LOG AO LOG DE ACESSO PRINCIPAL E CD_PROFESSOR 
  # PORQUE SE NAO FOR PROFESSOR LOGADO ELE ESCOLHERÁ O PROFESSOR QUE QUER MEXER E ESSA INFORMACAO FICARA GRAVADA
  # -------------------------------------------------------------------------------------------
  
  ALTER TABLE `diario_logs`
  ADD COLUMN `cd_log_pai`  int(11) NULL AFTER `descricao`//
  
  ALTER TABLE `diario_logs`
  ADD COLUMN `cd_professor`  int(11) NOT NULL AFTER `cd_log_pai`//
  
  # -------------------------------------------------------------------------------------------
  # PROCEDURE PARA INICIAR O DIARIO EM CURSO / TURMA / DISCIPLINA
  # -------------------------------------------------------------------------------------------
  
  CREATE PROCEDURE `DIA_INICIAR_DIARIO`(IN CD_CURSO VARCHAR(40), IN CD_TURMA VARCHAR(40), IN CD_DISCIPLINA INTEGER(11), IN CD_PROFESSOR INTEGER(11), IN NR_ANOSEMESTRE INTEGER(11), IN NR_ETAPA INTEGER(11))
      DETERMINISTIC
  BEGIN
       INSERT IGNORE INTO DIARIO_TURMAS (turma, anosemestre, disciplina, bimestre, professor, curso)
       VALUES
       (CD_TURMA,NR_ANOSEMESTRE,CD_DISCIPLINA, NR_ETAPA, CD_PROFESSOR, CD_CURSO);
  
       INSERT IGNORE INTO DIARIO_MATRICULAS (codaluno, turma, anosemestre, disciplina, bimestre, situacao)
       SELECT
             fi.codigoaluno, tp.turma, tp.anosemestre, tp.disciplina, NR_ETAPA, fi.situacao
       FROM
           fichaindividual fi
           INNER JOIN turmasprofessores tp
                 ON (fi.turma = tp.turma AND fi.anosemestre = tp.anosemestre AND fi.disciplina = tp.disciplina)
           INNER JOIN situacao s ON(fi.situacao = s.cd_situacao)
       WHERE
            s.cd_situacao_pai in (0, 1, 2, 9) AND
            tp.anosemestre = NR_ANOSEMESTRE  AND
            tp.curso = CD_CURSO AND
            tp.turma = CD_TURMA AND
            tp.disciplina = CD_DISCIPLINA AND
            tp.professor = CD_PROFESSOR;
  
       INSERT IGNORE INTO DIARIOS_DESCRICOES (nr_anosemestre, cd_turma, nr_disciplina, cd_pessoa, nr_avaliacao)
       SELECT
             tp.anosemestre, tp.turma, tp.disciplina, fi.codigoaluno, NR_ETAPA
       FROM
           fichaindividual fi
           INNER JOIN turmasprofessores tp
                 ON (fi.turma = tp.turma AND fi.anosemestre = tp.anosemestre AND fi.disciplina = tp.disciplina)
           INNER JOIN situacao s ON(fi.situacao = s.cd_situacao)
       WHERE
            s.cd_situacao_pai in (0, 1, 2, 9) AND
            tp.anosemestre =  NR_ANOSEMESTRE AND
            tp.curso = CD_CURSO AND
            tp.turma = CD_TURMA AND
            tp.disciplina = CD_DISCIPLINA AND
            tp.professor = CD_PROFESSOR;
  END//]]></atualiza><atualiza codigo="{3F3707F5-CB48-4B07-A842-E6E04A0A9E15}" protocolo="oracle"><![CDATA[DELIMITER //

# ---------------------------------------
# ALTERAÇÕES DE ESTRUTURA
# ---------------------------------------
DROP TABLE dia_prazos//
CREATE TABLE dia_prazos (
  CD_PRAZO NUMBER(9) NOT NULL, 
  NM_PRAZO VARCHAR2(255) NOT NULL,
  NR_ANOSEMESTRE NUMBER(9) NOT NULL,
  CD_TIPO_PRAZO NUMBER(9) NOT NULL,
  DT_INICIO_ETAPA TIMESTAMP(2) DEFAULT NULL,
  DT_FIM_ETAPA TIMESTAMP(2) DEFAULT NULL,
  DT_INICIO_FREQUENCIA TIMESTAMP(2) DEFAULT NULL,
  DT_FIM_FREQUENCIA TIMESTAMP(2) DEFAULT NULL,
  DT_INICIO_NOTAS TIMESTAMP(2) DEFAULT NULL,
  DT_FIM_NOTAS TIMESTAMP(2) DEFAULT NULL,
  DT_LIBERACAO TIMESTAMP(2) DEFAULT NULL,
  PRIMARY KEY  (CD_PRAZO)
)//

 
# auto_increment
CALL CRIAR_AUTO_INCREMENT('dia_prazos', 'CD_PRAZO', 'SEQ_DIA_PRAZOS_CD_PRAZO', 'AUTOINC_DIA_PRAZOS_CD_PRAZO')//



DROP TABLE dia_prazos_turmas//
CREATE TABLE dia_prazos_turmas (
  NR_ANOSEMESTRE NUMBER(5) DEFAULT '0' NOT NULL,
  CD_CURSO VARCHAR2(15) DEFAULT '' NOT NULL,
  CD_TURMA VARCHAR2(15) DEFAULT '' NOT NULL,
  CD_DISCIPLINA NUMBER(9) NOT NULL,
  CD_TIPO_PRAZO NUMBER(9) NOT NULL,
  CD_PRAZO NUMBER(9) DEFAULT '0' NOT NULL,
  PRIMARY KEY  (NR_ANOSEMESTRE,CD_CURSO,CD_TURMA,CD_DISCIPLINA,CD_TIPO_PRAZO)
)//

DROP TABLE dia_tipo_prazo//
CREATE TABLE dia_tipo_prazo (
  CD_TIPO_PRAZO NUMBER(9) DEFAULT '0' NOT NULL,
  DS_TIPO_PRAZO VARCHAR2(255) NOT NULL,
  NR_ORDEM NUMBER(9) NOT NULL,
  PRIMARY KEY (CD_TIPO_PRAZO)
)//




CREATE TABLE diario_provas_alunos (
  cd_pessoa NUMBER(9) DEFAULT '0' NOT NULL,
  cd_turma VARCHAR2(15) DEFAULT '' NOT NULL,
  nr_anosem NUMBER(19) DEFAULT '0' NOT NULL,
  cd_disciplina NUMBER(19) DEFAULT '0' NOT NULL,
  cd_bimestre NUMBER(19) DEFAULT '0' NOT NULL,
  nr_prova NUMBER(9) DEFAULT '0' NOT NULL,
