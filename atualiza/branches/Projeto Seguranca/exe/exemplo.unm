         FROM
            PROFESSORES P
         WHERE
            P.CD_PESSOA = pessoa AND
            P.CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            codigoProfessor := NULL;
      END;

      IF codigoProfessor IS NOT NULL THEN
         RETURN 1;
      END IF;

      BEGIN
         SELECT
            SN_INCLUIR
         INTO
            snIncluir
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_PESSOA = pessoa AND
            CD_GRUPO = 4 AND
            CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            snIncluir := 0;
      END;

      IF snIncluir = 1 THEN
         RETURN 1;
      END IF;

   END IF;

   RETURN 0;

END//

CREATE OR REPLACE 
FUNCTION             "FCD_GRUPO_RESPACADEMICO" (pessoa IN NUMBER, coligada IN NUMBER)
RETURN SMALLINT
AS
   codigoResp NUMBER := NULL;
   snIncluir NUMBER := NULL;
BEGIN
 
   IF pessoa IS NUll THEN

      INSERT INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            6 CD_GRUPO,
            P.CD_RESP_ACAD CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO)
         WHERE
            M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  GP.CD_GRUPO = 6 AND
                  P.CD_RESP_ACAD = GP.CD_PESSOA AND
                  T.CD_COLIGADA = GP.CD_COLIGADA
            )
      )
      UNION
      (
         SELECT
            E.CD_GRUPO,
            E.CD_PESSOA,
            E.CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES E
         WHERE
            E.CD_GRUPO = 6 AND
            E.SN_INCLUIR = 1 AND
            E.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  E.CD_GRUPO = GP.CD_GRUPO AND
                  E.CD_PESSOA = GP.CD_PESSOA AND
                  E.CD_COLIGADA = GP.CD_COLIGADA
            )
      );

   ELSE

      BEGIN
         SELECT DISTINCT
            P.CD_RESP_ACAD
         INTO
            codigoResp
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO)
         WHERE
            M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada AND
            P.CD_RESP_ACAD = pessoa;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            codigoResp := NULL;
      END;
 
      IF codigoResp IS NOT NULL THEN
         RETURN 1;
      END IF;
 
      BEGIN
         SELECT
            SN_INCLUIR
         INTO
            snIncluir
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 6 AND
            CD_PESSOA = pessoa AND
            CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            snIncluir := 0;
      END;
 
      IF snIncluir = 1 THEN
         RETURN 1;
      END IF;

   END IF;

   RETURN 0;
END//

CREATE OR REPLACE 
FUNCTION             "FCD_GRUPO_RESPFINANCEIRO" (pessoa IN NUMBER, coligada IN NUMBER)
RETURN SMALLINT
AS
   codigoResp NUMBER := NULL;
   snIncluir NUMBER := NULL;
BEGIN

   IF pessoa IS NULL THEN

      INSERT INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT
            7 CD_GRUPO,
            P.CD_RESP_FINAN CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO)
         WHERE
            M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  GP.CD_GRUPO = 7 AND
                  P.CD_RESP_FINAN = GP.CD_PESSOA AND
                  T.CD_COLIGADA = GP.CD_COLIGADA
            )
      )
      UNION
      (
         SELECT
            E.CD_GRUPO,
            E.CD_PESSOA,
            E.CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES E
         WHERE
            E.CD_GRUPO = 7 AND
            E.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  E.SN_INCLUIR = 1 AND
                  E.CD_GRUPO = GP.CD_GRUPO AND
                  E.CD_PESSOA = GP.CD_PESSOA AND
                  E.CD_COLIGADA = GP.CD_COLIGADA
            )
      );

   ELSE

      BEGIN
         SELECT DISTINCT
            P.CD_RESP_FINAN
         INTO
            codigoResp
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO)
         WHERE
            M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada AND
            P.CD_RESP_ACAD = pessoa;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            codigoResp := NULL;
      END;
 
      IF codigoResp IS NOT NULL THEN
         RETURN 1;
      END IF;
 
      BEGIN
         SELECT
            SN_INCLUIR
         INTO
            snIncluir
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 7 AND
            CD_PESSOA = pessoa AND
            CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            snIncluir := 0;
      END;
 
      IF snIncluir = 1 THEN
         RETURN 1;
      END IF;

   END IF;

   RETURN 0;
END//

CREATE OR REPLACE 
PROCEDURE "SPA_ATUALIZA_GRUPO" (grupo IN NUMBER, coligada IN NUMBER)
AS
   result NUMBER;
BEGIN

   CASE grupo
      WHEN 2 THEN result := FCD_GRUPO_ESTUDANTES(NULL, coligada);
      WHEN 3 THEN result := FCD_GRUPO_PROFESSORES(NULL, coligada);
      WHEN 4 THEN result := FCD_GRUPO_COORDENADORES(NULL, coligada);
      WHEN 5 THEN result := FCD_GRUPO_FUNCIONARIOS(NULL, coligada);
      WHEN 6 THEN result := FCD_GRUPO_RESPACADEMICO(NULL, coligada);
      WHEN 7 THEN result := FCD_GRUPO_RESPFINANCEIRO(NULL, coligada);
      ELSE result := 0;
   END CASE;

END//]]></atualiza><atualiza codigo="{B8B9AAAB-0C60-4240-A1C1-416D9FC6A0C7}" protocolo="ansi"><![CDATA[DELIMITER //

SET GLOBAL log_bin_trust_function_creators=1//

ALTER TABLE nu_grupos ENGINE=InnoDB//
ALTER TABLE iol_relatorios ENGINE=InnoDb//

DROP TABLE IF EXISTS iol_relatorios_grupos//

CREATE TABLE IF NOT EXISTS iol_relatorios_grupos (
   cd_relatorio INT(7) UNSIGNED NOT NULL,
   cd_grupo INT(11) NOT NULL,
   sn_ativo SMALLINT(1) UNSIGNED NOT NULL DEFAULT 0,
   UNIQUE KEY ( cd_relatorio, cd_grupo ),
   FOREIGN KEY iol_relatorios_cd_relatorio ( cd_relatorio ) REFERENCES iol_relatorios ( cd_relatorio ),
   FOREIGN KEY iol_relatorios_cd_grupo ( cd_grupo ) REFERENCES nu_grupos ( cd_grupo )
) ENGINE=InnoDB//

# Campo ds_chave
ALTER TABLE iol_relatorios ADD COLUMN ds_chave VARCHAR(50)//
# Deixa TODOS os relatorios com chave unica
# E então agora podemos deixar o campo como NOT NULL, e criar a chave unica
ALTER TABLE iol_relatorios CHANGE ds_chave ds_chave VARCHAR(50) NOT NULL//

DROP FUNCTION IF EXISTS Func_Remove_Acentos//
CREATE FUNCTION Func_Remove_Acentos(Texto VARCHAR(150))
RETURNS VARCHAR(150)
NOT DETERMINISTIC
BEGIN
   DECLARE Acentos, SemAcentos, Resultado VARCHAR(150);
   DECLARE Cont INT;
   
   SET Acentos = 'ÀÂÊÔÎÛÃÕÁÉÍÓÚÇÜ';
   SET SemAcentos = 'AAEOIUAOAEIOUCU';
   SET Cont = CHAR_LENGTH(Texto);
   SET Resultado = UPPER(Texto);
   
   WHILE Cont > 0 DO
   SET Resultado = REPLACE(Resultado, SUBSTRING(Acentos, Cont, 1), SUBSTRING(SemAcentos, Cont, 1));
   SET Cont = Cont - 1;
   END WHILE;
   
   RETURN LOWER(Resultado);
END//

UPDATE iol_relatorios SET ds_chave = Func_Remove_Acentos(REPLACE(
      REPLACE(
         REPLACE(
            REPLACE(
               LOWER( nm_relatorio ),
               ' de ',
               '_'
            ), 
            ' com ', 
            '_'
         ), 
         ' para ', 
         '_'
      ), 
      ' ', 
      '_'
   ))
WHERE
   nm_relatorio NOT LIKE '%Quitação%'//

DROP FUNCTION IF EXISTS Func_Remove_Acentos//

ALTER TABLE iol_relatorios ADD UNIQUE KEY IOL_RELATORIOS_CHAVE ( ds_chave )//

UPDATE iol_relatorios SET ds_chave = 'declaracao_quitacao_anual' WHERE
nm_relatorio LIKE '%Quitação%' AND nm_relatorio NOT LIKE '%Responsáveis%'//

#
# Insere os relatórios do DiáriO para Professores e Coordenadores
#
INSERT IGNORE INTO iol_relatorios_grupos ( cd_relatorio, cd_grupo, sn_ativo )
SELECT
   DISTINCT ir.cd_relatorio, ng.cd_grupo, 1
FROM
   iol_relatorios ir,
   nu_grupos ng
WHERE
    ir.cd_modulo IN ( SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'DiarioClasses' ) AND
    ng.cd_grupo IN ( SELECT cd_grupo FROM nu_grupos WHERE ds_papel IN ( 'PROFESSOR', 'COORDENADOR' ) )//

#
# Insere o relatório de Quitação atual para o Estudante
#
INSERT IGNORE INTO iol_relatorios_grupos ( cd_relatorio, cd_grupo, sn_ativo )
SELECT
   DISTINCT ir.cd_relatorio, ng.cd_grupo, 1
FROM
   iol_relatorios ir,
   nu_grupos ng
WHERE
    ir.nm_relatorio LIKE '%Quitação%' AND
    ng.cd_grupo IN ( 2 )//

#
# Insere um novo relatório, este sera o relatório de quitação para Responsáveis
#
INSERT IGNORE INTO iol_relatorios ( cd_modulo, nm_relatorio, me_pagina, sn_disponivel, me_tpl, ds_chave )
SELECT
   cd_modulo, 'Declaração de Quitação Anual de Débitos para Responsáveis', 
   UNHEX(''), sn_disponivel, 
   UNHEX(''), 'declaracao_quitacao_anual_responsaveis'
FROM
   iol_relatorios ir
WHERE
    ir.nm_relatorio LIKE '%Quitação%'//

UPDATE iol_relatorios
SET ds_chave = 'declaracao_quitacao_anual'
WHERE nm_relatorio LIKE '%Quitação%' AND nm_relatorio NOT LIKE '%Quitação%Responsáveis%'//

#
# Insere o relatório de quitação de responsáveis, para os grupos de Responsáveis Unificado e Responsáveis Financeiro
#
INSERT IGNORE INTO iol_relatorios_grupos( cd_relatorio, cd_grupo, sn_ativo )
SELECT
   ir.cd_relatorio, ng.cd_grupo, 1
FROM
   iol_relatorios ir,
   nu_grupos ng
WHERE
    ir.nm_relatorio LIKE '%Quitação%Responsáveis%' AND
    ng.cd_grupo IN ( SELECT cd_grupo FROM nu_grupos WHERE ds_papel IN ( 'RESP_UNIFICADO', 'RESP_FINAN' ) )//

#
# Deixa o Administrador com acesso em todos os grupos
#
INSERT IGNORE INTO iol_relatorios_grupos( cd_relatorio, cd_grupo, sn_ativo )
SELECT
   cd_relatorio, 1, 1
FROM
   iol_relatorios//]]></atualiza><atualiza codigo="{2DC46961-FB58-4B51-B94A-B87979379940}" protocolo="ansi"><![CDATA[UPDATE `nu_modulos_acoes` SET `ds_nome_acao`='Principal > Contratos > Incluir/Alterar > Convênio' WHERE ds_chave='EstagioncAlteraValorConvenio';
