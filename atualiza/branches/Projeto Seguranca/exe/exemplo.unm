  ALTER TABLE `fichaindividual` ADD `ajuste1` DOUBLE NULL AFTER `nota1`//
  ALTER TABLE `fichaindividual` ADD `ajuste2` DOUBLE NULL AFTER `nota2`//
  ALTER TABLE `fichaindividual` ADD `ajuste3` DOUBLE NULL AFTER `nota3`//
  ALTER TABLE `fichaindividual` ADD `ajuste4` DOUBLE NULL AFTER `nota4`//
  ALTER TABLE `fichaindividual` ADD `ajuste5` DOUBLE NULL AFTER `nota5`//
  ALTER TABLE `fichaindividual` ADD `ajuste6` DOUBLE NULL AFTER `nota6`//
  ALTER TABLE `fichaindividual` ADD `ajuste7` DOUBLE NULL AFTER `nota7`//
  ALTER TABLE `fichaindividual` ADD `ajuste8` DOUBLE NULL AFTER `nota8`//
  ALTER TABLE `fichaindividual` ADD `ajuste9` DOUBLE NULL AFTER `nota9`//
  ALTER TABLE `fichaindividual` ADD `ajuste10` DOUBLE NULL AFTER `nota10`//
  
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste1 = dm.ajuste
  WHERe dm.bimestre = 1//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste2 = dm.ajuste
  WHERe dm.bimestre = 2//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste3 = dm.ajuste
  WHERe dm.bimestre = 3//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste4 = dm.ajuste
  WHERe dm.bimestre = 4//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste5 = dm.ajuste
  WHERe dm.bimestre = 5//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste6 = dm.ajuste
  WHERe dm.bimestre = 6//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste7 = dm.ajuste
  WHERe dm.bimestre = 7//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste8 = dm.ajuste
  WHERe dm.bimestre = 8//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste9 = dm.ajuste
  WHERe dm.bimestre = 9//
  
  UPDATE diario_matriculas as dm 
  INNER JOIN fichaindividual as fi ON (dm.codaluno = fi.codigoaluno AND dm.anosemestre = fi.anosemestre AND dm.turma = fi.turma AND dm.disciplina = fi.disciplina)
    SET fi.ajuste10 = dm.ajuste
  WHERe dm.bimestre = 10//
  
  
  
  
  
