ALTER TABLE pessoas ADD cd_usuario_pessoa INT(11) UNSIGNED NULL //
SET @CODIGO = (SELECT MAX(codigo)+1 FROM USUARIOS)//
UPDATE USUARIOS set CODIGO = (@CODIGO) 
WHERE 
USUARIOS.CODIGO = 1
AND NOME != 'ADMIN'//

UPDATE MODULOSUSUARIOS set CODIGOUSUARIO = (@CODIGO) 
WHERE 
MODULOSUSUARIOS.CODIGOUSUARIO = 1
AND (SELECT NOME FROM USUARIOS WHERE CODIGO = 1) != 'ADMIN'//

UPDATE 
	USUARIOS
SET
	CODIGO = 1
WHERE  
	NOME LIKE 'ADMIN'//


replace into MODULOSUSUARIOS (codigousuario,
codigomodulo,
incluir,
alterar,
deletar,
acessar,
especial) (select 1,mu.codigomodulo,'S','S','S','S','S' from MODULOSUSUARIOS mu
	left join usuarios u on (u.codigo = mu.codigousuario)
where
  codigo is null )//


SET GLOBAL log_bin_trust_function_creators=1//

CREATE PROCEDURE procInsereCdPessoa()
BEGIN
  DECLARE cd_pessoa_usuario, codigo_usuario INTEGER;
	DECLARE done INT DEFAULT 0;
  DECLARE cursorPrincipal CURSOR FOR SELECT 	US.CODIGO, PES.cd_pessoa 
    FROM	
  PESSOAS PES 
  inner join USUARIOS US on (us.nome = pes.ds_login)
  where 
  ds_login like 'ADMIN'
 ;
  
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;
  OPEN cursorPrincipal;
  read_loop: LOOP	
    FETCH cursorPrincipal INTO codigo_usuario,cd_pessoa_usuario ;
    UPDATE USUARIOS as u SET u.cd_pessoa = cd_pessoa_usuario where u.codigo = codigo_usuario ;
    IF done THEN
	LEAVE read_loop;
    END IF;
  END LOOP;
  CLOSE cursorPrincipal;
END//
DROP TABLE  IF EXISTS temp//
CREATE TABLE `temp` (
	`codigo`  int NULL AUTO_INCREMENT ,
	`valor`  int NULL ,
	PRIMARY KEY (`codigo`)
)//
SET @codigo = 0//
INSERT INTO temp (valor) (SELECT @codigo := @codigo +1   FROM pessoas )//


DROP TABLE  IF EXISTS  CODIGOSVALIDOS//
SET @codigoAtual =0 //
CREATE table CODIGOSVALIDOS
SELECT 
	@codigoAtual := 	@codigoAtual+1 as codigo,
	temp.valor as  indice
FROM
	temp 
	left join pessoas as p ON (temp.valor = p.cd_pessoa )
WHERE 
	p.nm_pessoa is null 
GROUP BY 
	temp.valor //


set @codigo = 0//

INSERT INTO PESSOAS (CD_PESSOA, NM_PESSOA, DS_LOGIN, DS_SENHA,SN_BLOQUEADO,cd_usuario_pessoa)
SELECT indice,nome,nome,senha,1,codigo FROM (
SELECT 
		@codigo := @codigo + 1,
		(SELECT indice FROM CODIGOSVALIDOS WHERE codigo = @codigo)as indice 	,
		concat(US.NOME,'-US') as nome,
		US.SENHA as senha,
		US.codigo as codigo
		FROM
			USUARIOS US
			LEFT JOIN PESSOAS PES ON (US.CD_PESSOA = PES.CD_PESSOA)
		WHERE
			PES.CD_PESSOA IS NULL) as tbl//

update 
	pessoas p 
	join usuarios u on(p.cd_pessoa = u.cd_pessoa)
set
	cd_usuario_pessoa =  u.codigo//


DROP TABLE CODIGOSVALIDOS//
DROP TABLE temp//]]></atualiza><atualiza codigo="{CCDC71D0-4DD1-44B7-B436-D4EB21BC70EF}" protocolo="oracle"><![CDATA[ALTER TABLE PESSOAS ADD ( CD_USUARIO_PESSOA NUMBER(19) NULL );

UPDATE USUARIOS set CODIGO = (SELECT MAX(codigo)+1 FROM USUARIOS) 
WHERE 
USUARIOS.CODIGO = 1
AND NOME != 'ADMIN';

UPDATE MODULOSUSUARIOS set CODIGOUSUARIO = (SELECT MAX(codigo) FROM USUARIOS) 
WHERE 
MODULOSUSUARIOS.CODIGOUSUARIO = 1
AND (SELECT NOME FROM USUARIOS WHERE CODIGO = 1) != 'ADMIN';



UPDATE 
	MODULOSUSUARIOS
SET
	CODIGOUSUARIO = 1
WHERE
	CODIGOUSUARIO = (SELECT codigo FROM USUARIOS WHERE nome='ADMIN');



UPDATE 
	USUARIOS 
set
	codigo = 1
WHERE 
	nome ='ADMIN';



CREATE TABLE "TEMP" (
"CODIGO" INTEGER NULL ,
"VALOR" INTEGER NULL 
)
NOCOMPRESS;

CREATE TABLE "CODIGOSVALIDOS" (
"CODIGO" INTEGER NULL ,
"INDICE" INTEGER NULL 
)
NOCOMPRESS;

DECLARE
	sql_temp VARCHAR(255);
	sql_validos VARCHAR(255);
	sql_buscavalidos VARCHAR(255);
	sql_estaDuplicado VARCHAR(255);
	CODIGOATUAL INTEGER;
	CODIGOINSERIDO INTEGER;
	CODIGODUPLICADO VARCHAR(255);
	CURSOR sqlPessoas IS 
		SELECT
			cd_pessoa
		FROM
			PESSOAS;
BEGIN
	CODIGOATUAL :=0 ;
	FOR linha IN sqlPessoas LOOP
		CODIGOATUAL :=CODIGOATUAL +1;
		sql_temp := 'INSERT INTO TEMP(CODIGO , VALOR ) VALUES (:1, :2)';
		EXECUTE IMMEDIATE	sql_temp USING CODIGOATUAL,CODIGOATUAL;
	END LOOP;	
	CODIGOATUAL := 0;
  FOR cursor1 IN (SELECT 	TEMP.VALOR AS VALOR	FROM	TEMP 	left join PESSOAS P ON (TEMP.VALOR = P.CD_PESSOA )
	WHERE 
		p.NM_PESSOA is null 
	GROUP BY
		TEMP.VALOR
	ORDER BY 
		TEMP.VALOR )
  LOOP
		CODIGOATUAL :=CODIGOATUAL +1;
		sql_validos := 'INSERT INTO CODIGOSVALIDOS(CODIGO , INDICE ) VALUES (:1, :2)';
		EXECUTE IMMEDIATE	sql_validos USING CODIGOATUAL,cursor1.VALOR;
  END LOOP;

	CODIGOATUAL := 0;
  FOR cursorSQLusuarios IN (SELECT 
		US.CODIGO as CODIGO,
                US.NOME as NOME,
		US.SENHA as SENHA
		FROM
			USUARIOS US
			LEFT JOIN PESSOAS PES ON (US.CD_PESSOA = PES.CD_PESSOA)
		WHERE
			PES.CD_PESSOA IS NULL
		GROUP BY
     	US.NOME ,
			US.SENHA 
	)
  LOOP
		CODIGOATUAL := CODIGOATUAL +1;
		sql_buscavalidos := 'SELECT INDICE FROM CODIGOSVALIDOS WHERE CODIGO = :1 GROUP BY INDICE';
		EXECUTE IMMEDIATE sql_buscavalidos INTO CODIGOINSERIDO USING CODIGOATUAL ;
		sql_estaDuplicado := 'SELECT IFNULL((SELECT DS_LOGIN FROM "PESSOAS" WHERE DS_LOGIN= :1 GROUP BY DS_LOGIN ) , 1) FROM DUAL';
		EXECUTE IMMEDIATE sql_estaDuplicado INTO CODIGODUPLICADO USING cursorSQLusuarios.NOME ;
		IF (CODIGODUPLICADO = '1' AND cursorSQLusuarios.NOME != 'ADMIN') THEN
			sql_validos := 'INSERT INTO "PESSOAS" (CD_PESSOA, NM_PESSOA, DS_LOGIN, DS_SENHA ,SN_BLOQUEADO,CD_USUARIO_PESSOA) VALUES(:1,:2,:3 ,:4,1,:5)';
			EXECUTE IMMEDIATE	sql_validos USING CODIGOINSERIDO , concat(cursorSQLusuarios.NOME  as nome,'-US'), cursorSQLusuarios.NOME , cursorSQLusuarios.SENHA,cursorSQLusuarios.CODIGO;
		END IF;
	END LOOP;
END;

UPDATE	
	pessoas p
SET
	p.cd_usuario_pessoa = (SELECT CODIGO FROM USUARIOS u WHERE u.nome = p.DS_LOGIN );
]]></atualiza><atualiza codigo="{7BE9ED04-0E27-4A15-8D89-0F8A16E1EB5F}" protocolo="mysql-5"><![CDATA[SET @codigo = (SELECT max(cd_modulo +1) from nu_modulos);

