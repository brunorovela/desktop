INSERT INTO `iol_relatorios` (`nm_relatorio`, `me_pagina`, `sn_disponivel`, `ds_link`, `me_tpl`, `ds_parametros`, `cd_modulo`) VALUES ('Diário com Fotos', UNHEX(''), 'S', null, UNHEX(''), null, (SELECT cd_modulo FROM nu_modulos WHERE ds_chave LIKE 'DiarioClasses' LIMIT 1));]]></atualiza><atualiza codigo="{FBD80169-4403-4584-8A63-84B09272FAB3}" protocolo="ansi"><![CDATA[CREATE TABLE FIN_COBRANCA_MUDADO
AS
SELECT 
	*
FROM
	FIN_COBRANCA;
	
TRUNCATE FIN_COBRANCA;

INSERT INTO FIN_COBRANCA (cd_cobranca, cd_pessoa, dt_registro, cd_situacao, sn_spc, dt_spc_inclusao, dt_spc_retirada, sn_juridico, dt_juridico_inclusao, dt_juridico_retirada, cd_responsavel, dt_retorno)
SELECT 
	cd_cobranca, fcu.cd_pessoa, dt_registro, cd_situacao, sn_spc, dt_spc_inclusao, dt_spc_retirada, sn_juridico, dt_juridico_inclusao, dt_juridico_retirada, p.cd_pessoa, dt_retorno
FROM
	FIN_COBRANCA_MUDADO as fcu
	INNER JOIN PESSOAS as p on (p.cd_usuario_pessoa = fcu.cd_responsavel);

CREATE TABLE FIN_CONTAS_PAGAR_AUTORIZA_MUDADO
AS
SELECT 
	*
FROM
	FIN_CONTAS_PAGAR_AUTORIZA;
	
TRUNCATE FIN_CONTAS_PAGAR_AUTORIZA;

INSERT INTO FIN_CONTAS_PAGAR_AUTORIZA (cd_autoriza, cd_titulo, cd_coligada, cd_autoriza_situ, cd_autoriza_usuario, dt_autoriza, me_autoriza, me_resposta)
SELECT 
	cd_autoriza, cd_titulo, cd_coligada, cd_autoriza_situ, p.cd_pessoa, dt_autoriza, me_autoriza, me_resposta
FROM
	FIN_CONTAS_PAGAR_AUTORIZA_MUDADO as fcu
	INNER JOIN PESSOAS as p on (p.cd_usuario_pessoa = fcu.cd_autoriza_usuario);

CREATE TABLE FIN_CONTAS_USUARIOS_MUDADO
AS
SELECT 
	*
FROM
	FIN_CONTAS_USUARIOS;
	
TRUNCATE FIN_CONTAS_USUARIOS;

INSERT INTO FIN_CONTAS_USUARIOS (cd_caixa, cd_coligada, cd_usuario, sn_padrao)
SELECT 
	fcu.cd_caixa,
	fcu.cd_coligada,
	p.cd_pessoa,
	fcu.sn_padrao
FROM
	FIN_CONTAS_USUARIOS_MUDADO as fcu
	INNER JOIN PESSOAS as p on (p.cd_usuario_pessoa = fcu.cd_usuario);

CREATE TABLE FIN_CONTROLE_CAIXA_MUDADO
AS
SELECT 
	*
FROM
	FIN_CONTROLE_CAIXA;
	
TRUNCATE FIN_CONTROLE_CAIXA;

INSERT INTO FIN_CONTROLE_CAIXA (cd_abertura_caixa, dt_abertura, dt_fechamento, cd_conta_banco, cd_coligada, vl_saldo_abertura, vl_saldo_fechamento, ds_situacao, cd_usuario)
SELECT 
	cd_abertura_caixa, dt_abertura, dt_fechamento, cd_conta_banco, cd_coligada, vl_saldo_abertura, vl_saldo_fechamento, ds_situacao, cd_pessoa
FROM
	FIN_CONTROLE_CAIXA_MUDADO 
	as fcu
	INNER JOIN PESSOAS as p on (p.cd_usuario_pessoa = fcu.cd_usuario);

CREATE TABLE FIN_COBRANCA_CONTATOS_MUDADO
AS
SELECT 
	*
FROM
	FIN_COBRANCA_CONTATOS;
	
TRUNCATE FIN_COBRANCA_CONTATOS;

