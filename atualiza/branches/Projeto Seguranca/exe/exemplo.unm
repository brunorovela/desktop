ALTER TABLE AVALIACOES_PROVAS_TIPOS ADD NR_QUANTIDADE_MAXIMA NUMBER(9) DEFAULT '0' NOT NULL;
ALTER TABLE AVALIACOES_PROVAS_TIPOS ADD CD_TIPO_AVALIACAO NUMBER(9) DEFAULT '1' NOT NULL;]]></atualiza><atualiza codigo="{AE1503C6-740C-4D82-9CC4-CE894B55D9B8}" protocolo="ansi"><![CDATA[delimiter //

SET SQL_LOG_BIN := 0//
SET GLOBAL log_bin_trust_function_creators := 1//

DROP PROCEDURE IF EXISTS `DIA_CALCULO_MEDIA_DISCIPLINA`//

CREATE PROCEDURE `DIA_CALCULO_MEDIA_DISCIPLINA`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA TINYINT, IN PCD_PESSOA INTEGER(11), IN PDS_FORMULA VARCHAR(255), IN CD_LOG_ACESSO INTEGER(11), IN CD_PESSOA_LOGADA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
BEGIN
-- esta funcao retorna o valor da me'dia calculada, conforme a formula passada
 -- se a formula nao for passada ela utilizará a formula do diario_turmas

 DECLARE VL_NOTA_MENOR, VL_NOTA_RE, VL_MEDIA_MAXIMA, VL_NOTA_PROFICIENCIA, VL_AJUSTE, VL_NOTA_FINAL, VL_NOTA_FIXA_ETAPA, VL_MEDIA_CALCULADA, VL_NOTA_AUX DOUBLE;

 DECLARE VNR_NOTA, VNR_NOTA_RE, VNR_NOTA_AUX INTEGER(11);
 DECLARE VNR_NOTA_MENOR, VSN_COMPOE INTEGER(11);
 DECLARE SN_PROFICIENCIA CHAR(1) DEFAULT 'N';
 DECLARE DS_FORMULA_ORIGINAL, DS_FORMULA_AUX MEDIUMTEXT DEFAULT NULL;
 
 -- DECLARA TODOS OS CAMPOS EXISTENTE NA TABELA AVALIACOES_PARAMETROS
 DECLARE PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PADS_FORMULA_RE, PADS_CONDICAO_RE MEDIUMTEXT;
 DECLARE PASN_CONVERTER_NOTAS_NULAS MEDIUMTEXT;
 DECLARE PASN_TRUNCAR VARCHAR(1);
 DECLARE PASN_AJUSTE_APOS_RE, PATP_DECIMAIS_FORCE TINYINT(1);
 DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE INTEGER(11);
 DECLARE CD_PROFESSOR_LOG INTEGER;
 DECLARE DS_CHAVE, DS_CHAVE_MEDIA, DS_CHAVE_MEDIA_DIGITADA, DS_CHAVE_SOMA VARCHAR(100);
 
 DECLARE registros INTEGER DEFAULT NULL;

 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA EH CUSTOMIZADA
 DECLARE selectNotas CURSOR FOR
         SELECT nro_nota, sn_compoe FROM diario_provas
         WHERE sn_especial = 0
           AND sn_proficiencia = 0
           AND anosemestre = PNR_ANOSEMESTRE
           AND bimestre = PNR_ETAPA
           AND turma = PCD_TURMA
           AND disciplina = PCD_DISCIPLINA
         ORDER BY nro_nota DESC;
         
 -- DECLARA O CURSOS PARA DESCOBRIR AS NOTAS SUBSTITUIVEIS - PEGAR MENOR NOTA
         
 DECLARE selectMenor CURSOR FOR
         SELECT DP.nro_nota
              , IFNULL(DPA.VL_NOTA, 0)
           FROM DIARIO_PROVAS AS DP
           LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
                 AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
          WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1
            AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
            AND DP.BIMESTRE = PNR_ETAPA
            AND DP.TURMA = PCD_TURMA
            AND DP.DISCIPLINA = PCD_DISCIPLINA
          ORDER BY DP.nro_nota;
          
 DECLARE selectChaves CURSOR FOR
         SELECT dpt.ds_chave
           FROM diario_provas as dp
          INNER JOIN diario_provas_tipos as dpt ON (dp.cd_prova_tipo = dpt.cd_prova_tipo)
          WHERE turma = PCD_TURMA
            AND anosemestre = PNR_ANOSEMESTRE
            AND disciplina = PCD_DISCIPLINA
            AND bimestre = PNR_ETAPA
          GROUP BY dpt.ds_chave;


 -- DECLARE que será chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
 DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM tmp_medias;

 -- Criar tabela temporaria para auxiliar nos calculos

 SET DS_FORMULA_ORIGINAL := PDS_FORMULA;
 SET DS_FORMULA_ORIGINAL := REPLACE(DS_FORMULA_ORIGINAL, ",", ".");
 SET DS_FORMULA_ORIGINAL := REPLACE(DS_FORMULA_ORIGINAL, ";", ",");


 -- Por padrão a procedure sempre vai tentar criar  a tabela, se ela já existir vai gerar o erro 42S01, chamando o declare continue handle acima.
CREATE  TEMPORARY TABLE IF NOT EXISTS TMP_MEDIAS ( MEDIA DOUBLE );

 -- CARREGA TODOS OS CAMPOS DA TABELA DE AVALIACOES_PARAMETROS NO DECLARES
 SELECT ap.cd_avaliacao
      , ap.nr_media_proficiencia
      , ap.sn_converter_notas_nulas
      , ap.sn_notas_truncar
      , ap.nr_casas_decimais
      , ap.sn_ajuste_apos_recuperacao
      , ap.ds_formula_recuperacao
      , ap.ds_criterio_recuperacao
      , ap.nr_casas_decimais_forcado
      , ap.tp_ajuste_forcado
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PASN_CONVERTER_NOTAS_NULAS, PASN_TRUNCAR, PAVL_DECIMAIS
       , PASN_AJUSTE_APOS_RE, PADS_FORMULA_RE, PADS_CONDICAO_RE, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE;
       
 -- Verifica se existe Parametro de Avaliacao
 IF ( PACD_AVALIACAO IS NULL ) THEN
    SET VL_MEDIA_CALCULADA := NULL;
 END IF;

 -- Verificar se existe Prova de Proficiencia
 SET VNR_NOTA := NULL;
 
 SELECT dp.nro_nota
   FROM diario_provas dp
  WHERE dp.anosemestre = PNR_ANOSEMESTRE
    AND dp.bimestre = PNR_ETAPA
    AND dp.turma = PCD_TURMA
    AND dp.disciplina = PCD_DISCIPLINA
    AND dp.sn_proficiencia = 1
   INTO VNR_NOTA;

 -- Se tiver nota de proficiencia, faz a verificacao das provas do aluno
 IF ( VNR_NOTA > 0 ) THEN
    SELECT dpa.vl_nota
      FROM diario_provas_alunos dpa
     WHERE dpa.nr_anosem = PNR_ANOSEMESTRE
       AND dpa.cd_bimestre = PNR_ETAPA
       AND dpa.cd_turma = PCD_TURMA
       AND dpa.cd_disciplina = PCD_DISCIPLINA
       AND dpa.cd_pessoa = PCD_PESSOA
       AND dpa.nr_prova = VNR_NOTA
      INTO VL_NOTA_PROFICIENCIA;

    -- Se passou na proficiencia
    IF ( VL_NOTA_PROFICIENCIA >= PANR_MEDIA_PROFICIENCIA ) THEN
       SET VL_MEDIA_CALCULADA := VL_NOTA_PROFICIENCIA;
    END IF;
 END IF;
 -- SE NAO FOR PROVA DE SUFICIENCIA... continuar


 -- SE FOR FORMULA ARITMETICA DAS NOTAS DIGITADAS
 IF ( PDS_FORMULA = 'ARITMETICA' ) THEN
 
    -- MONTAR A FORMULA PARA MEDIA ARITMETICA

    SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 1 THEN
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(*))

           ELSE
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(DPA.VL_NOTA))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;


 -- SE NAO VERIFICA SE EH FORMULA MEDIA_PESO
 ELSEIF PDS_FORMULA = 'MEDIA_PESO' THEN

  SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 0 THEN
                     CASE WHEN COUNT(*) != COUNT(DPA.VL_NOTA) THEN
                               NULL
                     ELSE
                               CONCAT('(',GROUP_CONCAT(CONCAT('NOTA', DP.nro_nota,'*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( DP.VL_PESO ) )
                     END
           ELSE
                     CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota,',0)*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( COALESCE( DP.VL_PESO, 1 ) ))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;

 ELSEIF PDS_FORMULA = 'ZERAR' OR PDS_FORMULA = ''THEN
    SET VL_MEDIA_CALCULADA := NULL;

 -- Formula montada
 END IF;
 
 -- CRIA UM BACKUP DA FORMULA

 SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;
 
 -- Verificar o uso das funcoes
 --     MEDIA(chave);  MEDIA_DIGITADA(chave)
 
 OPEN selectChaves;
 
 SELECT FOUND_ROWS() INTO registros;
 
 WHILE registros > 0 DO
    FETCH selectChaves INTO DS_CHAVE;
    
    SELECT dpt.ds_chave
     , CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', dp.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(*)) as media
     , CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', dp.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(DPA.VL_NOTA)) as media_digitada
     , CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', dp.nro_nota, ',0)') SEPARATOR '+')) as soma
      FROM diario_provas as dp
      INNER JOIN diario_provas_tipos as dpt ON (dp.cd_prova_tipo = dpt.cd_prova_tipo)
       LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
        AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
      WHERE turma = PCD_TURMA
        AND anosemestre = PNR_ANOSEMESTRE
        AND disciplina = PCD_DISCIPLINA
        AND bimestre = PNR_ETAPA
        AND dpt.ds_chave = DS_CHAVE
      GROUP BY dpt.ds_chave
      INTO DS_CHAVE
         , DS_CHAVE_MEDIA
         , DS_CHAVE_MEDIA_DIGITADA
         , DS_CHAVE_SOMA;
         
      SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('MEDIA(', UPPER(DS_CHAVE), ')'), DS_CHAVE_MEDIA );
      SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('MEDIA_DIGITADA(', UPPER(DS_CHAVE), ')'), DS_CHAVE_MEDIA_DIGITADA );
      SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('SOMA(', UPPER(DS_CHAVE), ')'), DS_CHAVE_SOMA );
      SET registros = registros - 1;
      
 
 END WHILE;
 
 -- INICIAR O CALCULO DA FORMULA MONTADA

 OPEN selectNotas;

 SELECT FOUND_ROWS() INTO registros;

 WHILE registros > 0 DO
    FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

    SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 1 THEN
              COALESCE( dpa.vl_nota, 0 )
           ELSE
              dpa.vl_nota
           END
      FROM diario_provas_alunos dpa
     WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
       AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
       AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
      INTO VL_NOTA_AUX;

    SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );
    SET VL_NOTA_AUX := NULL;
    SET registros = registros - 1;

 END WHILE;

 CLOSE selectNotas;
 
-- Atualizar o resultado do calculo em uma tabela temporaria

 IF DS_FORMULA_AUX IS NOT NULL THEN

-- Inserir o resultado da formula montada na TMP_MEDIA e posteriormente resgatar essa informacao junto com o AJUSTE

    TRUNCATE TMP_MEDIAS;

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (', DS_FORMULA_AUX , ')' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;
    
    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_MEDIA_CALCULADA;
      
    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 ELSE

--  Neste caso a nota do professor ja esta calculada, basta buscar o AJUSTE

    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 END IF;
 
 
-- buscar o ajuste

 TRUNCATE TMP_MEDIAS;

 SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS (MEDIA) SELECT ajuste', PNR_ETAPA, ' FROM fichaindividual WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '=0 AND aproveitamento="N" LIMIT 1;' );
 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;
 

 SELECT MEDIA
   FROM TMP_MEDIAS
   INTO VL_AJUSTE;
   
 
-- VL_NOTA_FIXA_ETAPA: mantem o valor da nota calculada do professor antes do ajuste
-- VL_AJUSTE: Possui o valor do ajuste DIGITADO para este aluno

-- Verificar se tera nota de recuperacao


 -- Verificar se existe Prova de Recuperacao e buscar a nota do aluno
 SET VNR_NOTA_RE := NULL;
 

 SELECT DP.nro_nota
      , DPA.VL_NOTA
   FROM DIARIO_PROVAS AS DP
   LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
         AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
  WHERE DP.SN_ESPECIAL = 1 
    AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
    AND DP.BIMESTRE = PNR_ETAPA
    AND DP.TURMA = PCD_TURMA
    AND DP.DISCIPLINA = PCD_DISCIPLINA
   INTO VNR_NOTA_RE, VL_NOTA_RE;
   

  IF (VNR_NOTA_RE IS NULL) OR (VL_NOTA_RE IS NULL) THEN
     -- NAOTEM nota de recuperacao
     SET VL_NOTA_FINAL := VL_NOTA_FIXA_ETAPA;
  ELSE
     -- TEM NOTA DE RECUPERACAO
     IF (PASN_AJUSTE_APOS_RE = 0) THEN
        SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE, 0);
        SET VL_MEDIA_CALCULADA := VL_MEDIA_CALCULADA + IFNULL(VL_AJUSTE, 0);
     END IF;
     
     IF (PADS_FORMULA_RE = 'SUBSTITUIR_MENOR') THEN
     
     -- DESCOBRIR QUAL A MENOR NOTA DAS SUBSTITUIVEIS

        OPEN selectMenor;

        SELECT FOUND_ROWS() INTO registros;
        
        SET VL_NOTA_MENOR := 999999;
        SET VNR_NOTA_MENOR := NULL;
        
        SET VNR_NOTA_AUX := NULL;
        SET VL_NOTA_AUX := NULL;

        WHILE registros > 0 DO
        
            FETCH selectMenor INTO VNR_NOTA_AUX, VL_NOTA_AUX;
            
            IF (VL_NOTA_AUX < VL_NOTA_MENOR) AND (VL_NOTA_AUX < VL_NOTA_RE) THEN
               SET VL_NOTA_MENOR := VL_NOTA_AUX;
               SET VNR_NOTA_MENOR := VNR_NOTA_AUX;
            END IF;
            
            SET registros = registros - 1;

        END WHILE;
        
        CLOSE selectMenor;
        
        -- A VARIAVEL VNR_NOTA_MENOR representa o numero da prova que tem a menor nota
        
        -- Efetuar a substituicao da menor nota na formula

        
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;
           
           IF ( VNR_NOTA = VNR_NOTA_MENOR) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;
                
           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;
        
        -- MONTAR A CONDICAO PARA RECUPERACAO - O MEDIA TEM QUE SER MAIOR
        
        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSEIF (PADS_FORMULA_RE = 'SUBSTITUIR_TODAS') THEN
    
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
        
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

           IF ( VSN_COMPOE = 1) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;

           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;

        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSE
       -- VERIFICAR AS OUTRAS FORMULAS DE RECUPERAÇÃO
       -- TROCAR AS PALAVRAS RESERVADAS RB / NOTAP / MEDIA_SUBSTITUIVEIS / MEDIA_NAO_SUBSTITUIVEIS
       
       SET DS_FORMULA_AUX := PADS_FORMULA_RE;
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, ",", ".");
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, ";", ",");

       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'RB', VL_NOTA_RE);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'RB', VL_NOTA_RE);
       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS SUBSTITUIVEIS NAO NULAS
          
          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;
            
            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
       
       END IF;
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS NAO SUBSTITUIVEIS NAO NULAS

          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 0 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;

            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);

       END IF;
       

    END IF;
     
-- Executar a formula de recuperacao

    TRUNCATE TMP_MEDIAS;

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (IF(', IFNULL(PADS_CONDICAO_RE, 'NULL'), ', ', IFNULL(DS_FORMULA_AUX, 'NULL') , ', ', IFNULL(VL_NOTA_FIXA_ETAPA, 'NULL'), ') )' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;

    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_NOTA_FINAL;
      
  END IF;

  IF ((PASN_AJUSTE_APOS_RE = 1) OR (VNR_NOTA_RE IS NULL) ) THEN

     SET VL_NOTA_FINAL := VL_NOTA_FINAL + IFNULL(VL_AJUSTE,0);
     SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE,0);
  END IF;
  
  -- Verificar se o aluno tem COMPLEMENTO DE MEDIA
  
  SET VL_MEDIA_CALCULADA := 0;
  
  SELECT IFNull(SUM(aa.NT_AJUSTE),0)
    FROM DIARIO_AJUSTES_ALUNOS aa
   INNER JOIN DIARIO_AJUSTES_TURMAS at ON (aa.cd_ajuste_turma = at.cd_ajuste_turma)
   WHERE aa.cd_pessoa = PCD_PESSOA
     AND at.cd_turma = PCD_TURMA
     AND at.nr_anosem = PNR_ANOSEMESTRE
     AND at.nr_etapa = PNR_ETAPA
     AND aa.nt_ajuste is not null				
    INTO VL_MEDIA_CALCULADA;
    
    
 SET VL_NOTA_FINAL := VL_NOTA_FINAL + COALESCE(VL_MEDIA_CALCULADA, 0);
				
 -- Gravar as informacoes na fichaindividual

 SET @sSql := CONCAT('UPDATE fichaindividual SET nota', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FIXA_ETAPA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', nota_d', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FINAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', exame', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_RE, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '=0 AND aproveitamento="N";' );
 
 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;
 
 
 IF CD_PESSOA_LOGADA IS NOT NULL THEN
		SELECT professor FROM turmasprofessores WHERE anosemestre = PNR_ANOSEMESTRE AND turma = PCD_TURMA AND disciplina = PCD_DISCIPLINA LIMIT 1 INTO CD_PROFESSOR_LOG;

		-- GRAVA LOG DE ACESSO AO DIARIO
		IF CD_LOG_ACESSO = NULL THEN
			 INSERT INTO diario_logs (cd_pessoa, cd_acao, cd_atividade, dt_log, descricao, cd_professor) VALUES (CD_PESSOA_LOGADA, 0, 0, now(), 'Diario de Classes', CD_PROFESSOR_LOG);
			 SELECT LAST_INSERT_ID() INTO CD_LOG_ACESSO;
		END IF;

		INSERT INTO diario_logs (cd_pessoa,         cd_acao, cd_atividade, dt_log, descricao,                                                                                                                                                                                                                                                                                  cd_log_pai,     cd_professor)
						 VALUES (CD_PESSOA_LOGADA,  1,       3,            NOW(),  CONCAT('Geracao de Media, Aluno: ',PCD_PESSOA,', Turma: ',PCD_TURMA,', Disciplina: ',PCD_DISCIPLINA,', Anosemestre: ',PNR_ANOSEMESTRE,', Media: ',DIA_FORMATAR_MEDIA(VL_NOTA_FIXA_ETAPA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE),', Formula: ',PDS_FORMULA), CD_LOG_ACESSO,  IFNULL(CD_PROFESSOR_LOG,0));
 END IF;

 CALL DIA_CALCULO_MEDIA_FINAL(PNR_ANOSEMESTRE, PCD_TURMA, PCD_TURMA, PCD_PESSOA, CD_LOG_ACESSO, CD_PESSOA_LOGADA); 
 
END//

DROP PROCEDURE IF EXISTS DIA_MEDIA_TURMA//
CREATE PROCEDURE `DIA_MEDIA_TURMA`(IN PCD_TURMA VARCHAR(60), IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA INTEGER(11), IN PDS_FORMULA VARCHAR(255), IN CD_LOG_ACESSO INTEGER(11), IN CD_PESSOA_LOGADA INTEGER(11))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE PACD_AVALIACAO INTEGER DEFAULT NULL;
 DECLARE registros INTEGER DEFAULT NULL;
 
 DECLARE VCD_ALUNO INTEGER DEFAULT NULL;
  
 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA Eh CUSTOMIZADA
 DECLARE selectAlunos CURSOR FOR
         SELECT codigoaluno FROM fichaindividual
          WHERE anosemestre = PNR_ANOSEMESTRE
            AND turma = PCD_TURMA
            AND disciplina = PCD_DISCIPLINA
            AND aproveitamento = "N"
         ORDER BY codigoaluno DESC;
		 
 IF PDS_FORMULA = 'NULL' THEN
      SELECT 
         formula_media 
      FROM 
         diario_turmas 
      WHERE 
         turma LIKE PCD_TURMA AND 
         anosemestre = PNR_ANOSEMESTRE AND 
         disciplina = PCD_DISCIPLINA AND 
         bimestre = PNR_ETAPA 
      INTO PDS_FORMULA;
 END IF;		 

 -- VERIFICA SE EXISTE O PARAMETRO DE AVALIAÇÃO
 SELECT ap.cd_avaliacao
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO;

 IF ( PACD_AVALIACAO IS NOT NULL ) THEN
-- SE EXISTE PARAMETRO DE AVALIACAO, GUARDAR A FORMULA NO DIARIO

    IF PDS_FORMULA = 'ZERAR' THEN
    
       UPDATE diario_turmas
          SET formula_media = NULL
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    ELSE
    
       UPDATE diario_turmas
          SET formula_media = PDS_FORMULA
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    END IF;

    OPEN selectAlunos;

    SELECT FOUND_ROWS() INTO registros;

    WHILE registros > 0 DO
        FETCH selectAlunos INTO VCD_ALUNO;
            
        CALL DIA_CALCULO_MEDIA_DISCIPLINA(PNR_ANOSEMESTRE, PCD_TURMA, PCD_DISCIPLINA, PNR_ETAPA, VCD_ALUNO, PDS_FORMULA, CD_LOG_ACESSO, CD_PESSOA_LOGADA);

        SET registros = registros - 1;

    END WHILE;

    CLOSE selectAlunos;
          
 END IF;

END//



DROP FUNCTION IF EXISTS DIA_ARREDONDA_FORCADO//

CREATE FUNCTION `DIA_ARREDONDA_FORCADO`(PVL_NOTA DOUBLE, PNR_PRECISAO SMALLINT, PTP_DIRECAO TINYINT(1))
    RETURNS double
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE dFracao, dDif DOUBLE;
   DECLARE dDiv1, dDiv2, dDiv3, dDiv4 DOUBLE;
   DECLARE AMult INTEGER(11);

   -- Direcao:   1 = Para cima,  2 = Para Baixo,  3 = Ambos
   IF PNR_PRECISAO = 0 THEN
      SET dFracao := PVL_NOTA - TRUNCATE(PVL_NOTA, 0);
   ELSE
      SET dFracao := PVL_NOTA - TRUNCATE(PVL_NOTA, (PNR_PRECISAO-1));
   END IF;
   

   -- Sem nenhuma casa decimal - deve arredondar de forma diferenciada
   IF PNR_PRECISAO = 0 THEN

      IF (PTP_DIRECAO = 2) OR (dFracao = 0) THEN
         SET dDif := - dFracao;
      ELSEIF (PTP_DIRECAO = 1) THEN
         SET dDif := (1 - dFracao);
      ELSE
         IF (dFracao < 0.5) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (1 - dFracao);
         END IF;
      END IF;


   ELSE


     SET AMult := TRUNCATE(POWER(10.0, PNR_PRECISAO),0);

      SET dDiv1 := 2.5 / AMult;
      SET dDiv2 := 5 / AMult;
      SET dDiv3 := 7.5 / AMult;
      SET dDiv4 := 10 / AMult;

      IF (dFracao < dDiv1) THEN -- menor que 2.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) OR (dFracao = 0) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (dDiv2 - dFracao);
         END IF;
      ELSEIF ((dFracao >= dDiv1) and (dFracao <= dDiv2)) THEN -- maior que 2.5 e menor que 5
         IF (PTP_DIRECAO = 1 OR PTP_DIRECAO = 3) OR (dFracao = dDiv2) THEN
            SET dDif := (dDiv2 - dFracao);
         ELSE
            SET dDif := -dFracao;
         END IF;
      ELSEIF ((dFracao > dDiv2) and (dFracao < dDiv3)) THEN -- maior que 5 e menor que 7.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) THEN
            SET dDif := - (dFracao - dDiv2);
         ELSE
            SET dDif := (dDiv4 - dFracao);
         END IF;
      ELSEIF (dFracao >= dDiv3) THEN -- maior que 7.5
         IF PTP_DIRECAO = 1 OR PTP_DIRECAO = 3 THEN
            SET dDif := + (dDiv4 - dFracao);
         ELSE
            SET dDif := dDiv2 - dFracao;
         END IF;
      END IF;

   END IF;

   RETURN ROUND(PVL_NOTA + dDif, PNR_PRECISAO);

END//




DROP FUNCTION IF EXISTS DIA_FORMATAR_MEDIA//

CREATE FUNCTION `DIA_FORMATAR_MEDIA`(PVL_MEDIA DOUBLE, PSN_TRUNCAR CHAR(1), PVL_DECIMAIS SMALLINT, PVL_DECIMAIS_FORCE SMALLINT, PTP_DECIMAIS_FORCE TINYINT(1))
    RETURNS varchar(10)
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE VL_MEDIA_MAXIMA DOUBLE;
   
   IF ISNULL(PVL_MEDIA) THEN
      RETURN 'NULL';
   END IF;

-- VERIFICAR SE A MEDIA EH SUPERIOR AO MAXIMO PERMITIDO
   SET VL_MEDIA_MAXIMA := GET_PARAMETROS('valor_maximo_medias');

   IF ( (VL_MEDIA_MAXIMA IS NOT NULL) AND (PVL_MEDIA > VL_MEDIA_MAXIMA) )  THEN
   
      SET PVL_MEDIA := VL_MEDIA_MAXIMA;
      
   END IF;
   
   IF PVL_DECIMAIS_FORCE IS NOT NULL THEN

      SET PVL_MEDIA := DIA_ARREDONDA_FORCADO(PVL_MEDIA, PVL_DECIMAIS_FORCE, PTP_DECIMAIS_FORCE);

   END IF;
   -- Implementar o arredondamento forcado
   
   IF PSN_TRUNCAR = 1 THEN
      RETURN TRUNCATE(PVL_MEDIA, PVL_DECIMAIS);
   ELSE
      RETURN ROUND(PVL_MEDIA + 0.0000000001, PVL_DECIMAIS);
   END IF;
   
   
END//



DROP FUNCTION IF EXISTS GET_PARAMETROS//

CREATE FUNCTION `GET_PARAMETROS`(PDS_PARAMETRO VARCHAR(255))
    RETURNS MEDIUMTEXT
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN

   DECLARE DS_VALOR_PAR MEDIUMTEXT DEFAULT NULL;
   
   SELECT ds_valor
     FROM parametros
    WHERE ds_variavel = PDS_PARAMETRO
     INTO DS_VALOR_PAR;
     
   RETURN DS_VALOR_PAR;

END//


DROP PROCEDURE IF EXISTS DIA_CALCULO_MEDIA_PERIODO//
CREATE PROCEDURE `DIA_CALCULO_MEDIA_PERIODO`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_TURMA_MATRICULA VARCHAR(60), IN PCD_PESSOA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
sProc:BEGIN
  -- DECLARAR AS VARIAVEIS
  DECLARE PANR_BIMESTRES, PANR_PERIODOS, NR_ETAPAS, NR_PERIODO, NR_ETAPA, NR_ETAPA_PRI, NR_ETAPA_ULT SMALLINT;
  DECLARE PADS_CONDICAO_SITUACAO, PADS_FORMULA_PERIODO TEXT;
  DECLARE VDS_CONDICAO_SITUACAO, VDS_FORMULA_PERIODO TEXT;
  DECLARE PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE SMALLINT;
  
  DECLARE VL_MEDIA DOUBLE;
  DECLARE VCD_DISCIPLINA INTEGER;  

  DECLARE registros INTEGER DEFAULT NULL;
  
  DECLARE selectMedias CURSOR FOR
         SELECT DISCIPLINA, MEDIA
          FROM TMP_MEDIAFIM;

  -- DECLARE que serÃ¡ chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
  DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM TMP_MEDIAFIM;

  -- CRIAR TABELA TEMPORARIA
  
  -- Por padrÃ£o a procedure sempre vai tentar criar  a tabela, se ela jÃ¡ existir vai gerar o erro 42S01, chamando o declare continue handle acima.
  CREATE TEMPORARY TABLE IF NOT EXISTS TMP_MEDIAFIM ( DISCIPLINA INTEGER(11), MEDIA DOUBLE );

  IF PCD_TURMA_MATRICULA IS NULL OR PCD_TURMA_MATRICULA = '' THEN
    SET PCD_TURMA_MATRICULA := PCD_TURMA;
  END IF;

  -- SELECIONAR OS PARAMETROS DE AVALIACAO

  SELECT NR_AVALIACOES
       , NR_PERIODOS
       , DS_CONDICAO_SITUACAO_PERIODO 
       , DS_FORMULA_PERIODO
       , nr_casas_decimais
       , sn_anual_truncar
       , nr_casas_forcado_media
       , tp_ajuste_forcado_media       
  FROM AVALIACOES_PARAMETROS
  INNER JOIN TURMAS ON (TURMAS.CD_AVALIACAO = AVALIACOES_PARAMETROS.CD_AVALIACAO)
  WHERE TURMAS.anosemestre = PNR_ANOSEMESTRE
    AND TURMAS.codigo = PCD_TURMA
   INTO PANR_BIMESTRES
      , PANR_PERIODOS
      , PADS_CONDICAO_SITUACAO
      , PADS_FORMULA_PERIODO
		, PAVL_DECIMAIS
		, PASN_TRUNCAR
		, PAVL_DECIMAIS_FORCE
		, PATP_DECIMAIS_FORCE;
		
  IF PANR_PERIODOS IS NULL OR PANR_PERIODOS <= 0 THEN
     LEAVE sProc;
  END IF;
  
  SET NR_ETAPAS = (PANR_BIMESTRES DIV PANR_PERIODOS);
  SET NR_PERIODO = 1;
  
-- IF(IFNULL(RECUPERACAO1,0) > ROUND(((NOTA1 + NOTA2) / 2)+0.0001,0), ROUND(((ROUND(((NOTA1 + NOTA2) / 2)+0.0001,0) + IFNULL(RECUPERACAO1,0)) / 2)+0.0001, 0), ROUND(((NOTA1 + NOTA2) / 2)+0.0001,0))  
  WHILE NR_PERIODO <= PANR_PERIODOS DO 
  
 
     SET VDS_CONDICAO_SITUACAO := CONCAT('(', lower(PADS_CONDICAO_SITUACAO), ')');
     SET VDS_FORMULA_PERIODO := CONCAT('(', lower(PADS_FORMULA_PERIODO), ')');
     
     -- TROCAR RECUPERACAO POR NOTAX, SENDO QUE X É SEQUENCIAL A PARTIR DO NR_BIMESTRES
     SET VDS_FORMULA_PERIODO := REPLACE(VDS_FORMULA_PERIODO, 'recuperacao', CONCAT('nota', PANR_BIMESTRES + NR_PERIODO));    
     SET VDS_CONDICAO_SITUACAO := REPLACE(VDS_CONDICAO_SITUACAO, 'recuperacao', CONCAT('nota', PANR_BIMESTRES + NR_PERIODO));    
     
     SET VDS_FORMULA_PERIODO := REPLACE(VDS_FORMULA_PERIODO, 'media_periodo', CONCAT('db_media_periodo', NR_PERIODO));    
     SET VDS_CONDICAO_SITUACAO := REPLACE(VDS_CONDICAO_SITUACAO, 'media_periodo', CONCAT('db_media_periodo', NR_PERIODO));    
     
     SET NR_ETAPA_PRI = 1+((NR_PERIODO-1)*(NR_ETAPAS));
     SET NR_ETAPA_ULT = NR_PERIODO*(NR_ETAPAS);
     
     SET NR_ETAPA = 1;
     
     WHILE NR_ETAPA_PRI <= NR_ETAPA_ULT DO 
    
	      SET VDS_FORMULA_PERIODO := REPLACE(VDS_FORMULA_PERIODO, CONCAT('nota', NR_ETAPA ), CONCAT('nota_d', NR_ETAPA_PRI ));       
	      SET VDS_CONDICAO_SITUACAO := REPLACE(VDS_CONDICAO_SITUACAO, CONCAT('nota', NR_ETAPA ), CONCAT('nota_d', NR_ETAPA_PRI ));       
	      
	      SET NR_ETAPA_PRI = NR_ETAPA_PRI + 1;
     
         SET NR_ETAPA = NR_ETAPA + 1; 
     
     END WHILE;
     
     
     -- Executar o calculo da recuperacao
     
     SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
     SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', VDS_FORMULA_PERIODO, ') FROM fichaindividual ');
     SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = CONVERT(_utf8 "', PCD_TURMA,'" USING latin1)');
     SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  
     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
  
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
        FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

        SET @sSql := CONCAT(' UPDATE fichaindividual SET db_media_periodo', NR_PERIODO, ' = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
        SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
        SET @sSql := CONCAT(@sSql, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

        PREPARE sqlUpdate FROM @sSql;
        EXECUTE sqlUpdate;
        DEALLOCATE PREPARE sqlUpdate;
     
        SET registros := registros - 1;

     END WHILE;

     CLOSE selectMedias;  
	  
     SET @sSql := CONCAT(' UPDATE fichaindividual SET cd_situacao_periodo', NR_PERIODO, ' = ', VDS_CONDICAO_SITUACAO );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
	     
     
	  SET NR_PERIODO = NR_PERIODO + 1;
  
  END WHILE;   

END sProc//

 
DROP PROCEDURE IF EXISTS `DIA_CALCULO_MEDIA_FINAL`//
CREATE PROCEDURE `DIA_CALCULO_MEDIA_FINAL`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_TURMA_MATRICULA VARCHAR(60), IN PCD_PESSOA INTEGER(11), IN CD_LOG_ACESSO INTEGER(11), IN CD_PESSOA_LOGADA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
sProc:BEGIN
  -- DECLARAR AS VARIAVEIS
  DECLARE PANR_BIMESTRES, PANR_PERIODOS SMALLINT;
  DECLARE PASN_NOTAS, PASN_CONCEITOS_PARCIAIS, PASN_CONCEITOS, PASN_EXAME, PASN_2AEPOCA, PASN_TRUNCAR, PASN_FREQ_GLOBAL, PADS_FREQ_TIPO VARCHAR(1);
  DECLARE PADS_FORMULA_ANUAL, PADS_FORMULA_FINAL, PADS_APROVA_DIRETA, PADS_REPROVA_DIRETA, PADS_FORMULA_EXAME, PADS_FORMULA_2EPOCA, PADS_APROVA_EXAME, PADS_APROVA_2AEPOCA TEXT;
  DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE, PACD_SITU_APROVA, PACD_SITU_AEXAME, PACD_SITU_A2EPOCA, PANR_MAX_EXAME, PANR_MAX_2AEPOCA, VL_AUX SMALLINT;

  DECLARE VL_MEDIA, VL_FREQUENCIA, VL_MEDIA_GLOBAL DOUBLE;
  DECLARE DS_MEDIA_GLOBAL VARCHAR(100);
  DECLARE VCD_DISCIPLINA, VL_QTD_MENOR10, VL_QTD_MENOR8 INTEGER;
  DECLARE CD_PROFESSOR_LOG INTEGER;
  
  DECLARE menor_npns, maior_npns, media_npns, menor_nps, maior_nps, media_nps, menor_np, maior_np, media_np	VARCHAR(200);
  
  DECLARE NR_OPC, NR_OPC_EXTRA, NR_NORMAL INTEGER;
  DECLARE VL_OPC, VL_OPC_EXTRA, VL_NORMAL DOUBLE;
  
  DECLARE teste INTEGER;

  DECLARE registros INTEGER DEFAULT NULL;
  
  DECLARE selectMedias CURSOR FOR
         SELECT DISCIPLINA, MEDIA
          FROM TMP_MEDIAFIM;

  -- DECLARE que sera chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
  DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM TMP_MEDIAFIM;

  -- CRIAR TABELA TEMPORARIA
  
  -- Por padrao a procedure sempre vai tentar criar  a tabela, se ela ja existir vai gerar o erro 42S01, chamando o declare continue handle acima.
  CREATE TEMPORARY TABLE IF NOT EXISTS TMP_MEDIAFIM ( DISCIPLINA INTEGER(11), MEDIA DOUBLE );

  IF PCD_TURMA_MATRICULA IS NULL OR PCD_TURMA_MATRICULA = '' THEN
    SET PCD_TURMA_MATRICULA := PCD_TURMA;
  END IF;

  -- SELECIONAR OS PARAMETROS DE AVALIACAO

  SELECT ap.nr_avaliacoes
       , ap.NR_PERIODOS
       , ap.ds_formula_media_anual
       , ap.ds_formula_media_final
       , ap.sn_notas
       , ap.sn_conceitos_parciais
       , ap.sn_exame
       , ap.sn_segunda_epoca
       , ap.sn_conceitos
       , nr_casas_decimais
       , ap.sn_anual_truncar
       , ap.nr_casas_forcado_media
       , ap.tp_ajuste_forcado_media
       , ap.ds_cond_aprov_direta
       , ap.ds_cond_repro_direta
       , ap.sn_frequencia_global
       , ap.ds_frequencia_tipo
       , COALESCE(cd_situacao_aprov_direta, 0)
       , COALESCE(cd_situacao_aprov_exame, 0)
       , COALESCE(cd_situacao_aprov_2epoca, 0)
       , ap.nr_max_disci_exame
       , ap.nr_max_disci_segunda
       , ap.ds_formula_media_exame
       , ap.ds_formula_media_segunda
       , ap.ds_cond_aprov_exame
       , ap.ds_cond_aprov_segunda
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PANR_BIMESTRES
      , PANR_PERIODOS
      , PADS_FORMULA_ANUAL
      , PADS_FORMULA_FINAL
      , PASN_NOTAS
      , PASN_CONCEITOS_PARCIAIS
      , PASN_EXAME
      , PASN_2AEPOCA
      , PASN_CONCEITOS
      , PAVL_DECIMAIS
      , PASN_TRUNCAR
      , PAVL_DECIMAIS_FORCE
      , PATP_DECIMAIS_FORCE
      , PADS_APROVA_DIRETA
      , PADS_REPROVA_DIRETA
      , PASN_FREQ_GLOBAL
      , PADS_FREQ_TIPO
      , PACD_SITU_APROVA
      , PACD_SITU_AEXAME
      , PACD_SITU_A2EPOCA
      , PANR_MAX_EXAME
      , PANR_MAX_2AEPOCA
      , PADS_FORMULA_EXAME
      , PADS_FORMULA_2EPOCA
      , PADS_APROVA_EXAME
      , PADS_APROVA_2AEPOCA;

  SET PADS_FORMULA_ANUAL := CONCAT('(', lower(PADS_FORMULA_ANUAL), ')');
  SET PADS_FORMULA_FINAL := CONCAT('(', lower(PADS_FORMULA_FINAL), ')');
  SET PADS_APROVA_DIRETA := CONCAT('(', lower(PADS_APROVA_DIRETA), ')');
  SET PADS_REPROVA_DIRETA := CONCAT('(', lower(PADS_REPROVA_DIRETA), ')');
  SET PADS_FORMULA_EXAME := CONCAT('(', lower(PADS_FORMULA_EXAME), ')');
  SET PADS_FORMULA_2EPOCA := CONCAT('(', lower(PADS_FORMULA_2EPOCA), ')');
  SET PADS_APROVA_EXAME := CONCAT('(', lower(PADS_APROVA_EXAME), ')');
  SET PADS_APROVA_2AEPOCA := CONCAT('(', lower(PADS_APROVA_2AEPOCA), ')');
   
  IF PANR_BIMESTRES IS NULL THEN
     LEAVE sProc;
  END IF;
  
  -- Calcular a Media Global
  
  SELECT AVG(COALESCE(mediafinal, 0) )
    FROM fichaindividual
    WHERE turmamatricula = PCD_TURMA_MATRICULA
      AND anosemestre = PNR_ANOSEMESTRE
      AND codigoaluno = PCD_PESSOA
      AND situacao not in (3,4,5,6,7,8,10)
     INTO VL_MEDIA_GLOBAL;
     
  SET DS_MEDIA_GLOBAL = DIA_FORMATAR_MEDIA(VL_MEDIA_GLOBAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE);
  
  -- Substituir a media global dentro de todas as variaveis se houver
  
  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'media_global', DS_MEDIA_GLOBAL);
  
  -- calcular media global da africa GLOBAL_AFRICA
  -- retirar as disciplinas extras, porem, se ela for a unica opcional, entao contar a extra
  
  SELECT SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 0, 1, 0)) as qtd_opc
       , SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 1, 1, 0)) as qtd_opc_extra
       , SUM(IF(dc.ds_chave <> 'OPCIONAL' AND gd.SN_EXTRA = 0, 1, 0)) as qtd_normal
       , SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 0, COALESCE(mediafinal, 0), 0)) as soma_opc
       , SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 1, COALESCE(mediafinal, 0), 0)) as soma_opc_extra
       , SUM(IF(dc.ds_chave <> 'OPCIONAL' AND gd.SN_EXTRA = 0, COALESCE(mediafinal, 0), 0)) as soma_normal
    FROM fichaindividual AS f
	 INNER JOIN turmas as t ON (t.codigo = f.turma and t.anosemestre = f.anosemestre)
	 INNER JOIN grades_disciplinas as gd ON (gd.CD_GRADE = t.cd_grade AND gd.CD_CURSO = t.curso AND gd.CD_DISCIPLINA = f.disciplina AND gd.NR_SERIE = t.serie)
	 INNER JOIN disciplinas_categorias as dc ON (dc.cd_categoria = gd.CD_DISCIPLINA_CATEGORIA)
    WHERE f.turmamatricula = PCD_TURMA_MATRICULA
      AND f.anosemestre = PNR_ANOSEMESTRE
      AND f.codigoaluno = PCD_PESSOA
      AND f.situacao not in (3,4,5,6,7,8,10)
    INTO NR_OPC, NR_OPC_EXTRA, NR_NORMAL, VL_OPC, VL_OPC_EXTRA, VL_NORMAL;
    
  IF (NR_OPC > 0) THEN
      SET VL_MEDIA_GLOBAL = (VL_OPC + VL_NORMAL) / (NR_OPC + NR_NORMAL);
  ELSE
      SET VL_MEDIA_GLOBAL = (VL_OPC_EXTRA + VL_NORMAL) / (NR_OPC_EXTRA + NR_NORMAL);
  END IF;
  
  SET DS_MEDIA_GLOBAL = DIA_FORMATAR_MEDIA(VL_MEDIA_GLOBAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE);
  
  -- Substituir a media global DA AFRICA dentro de todas as variaveis se houver

  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'global_africa', DS_MEDIA_GLOBAL);

  -- fim da media global da africa = esg
  
  -- Verificar se usa a fÃ³rmula de MEDIA_MENOR_10
  
   SELECT COALESCE(SUM(IF(mediafinal < 10, 1, 0)),0)
        , COALESCE(SUM(IF(mediafinal < 8, 1, 0)), 0)
    FROM fichaindividual
    WHERE turmamatricula = PCD_TURMA_MATRICULA
      AND anosemestre = PNR_ANOSEMESTRE
      AND codigoaluno = PCD_PESSOA
      AND situacao not in (3,4,5,6,7,8,10)
     INTO VL_QTD_MENOR10, VL_QTD_MENOR8;
     
  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'media_menor_10', VL_QTD_MENOR10);

  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'media_menor_8', VL_QTD_MENOR8);

  -- TEMPORARIO: ARQUIVAR A QUANTIDADE DE AULAS DESTA TURMA 


  CREATE TEMPORARY TABLE IF NOT EXISTS TMP_AULAS AS
  SELECT da.anosemestre, da.turma, da.disciplina, SUM(da.qtd_aulas) as SOMA, COUNT(da.nro_aula) AS QTD, tp.numeroaulas
   FROM diario_aulas as da
  INNER JOIN turmasprofessores tp ON (da.anosemestre = tp.anosemestre AND da.turma = tp.turma and da.disciplina = tp.disciplina)
  WHERE da.turma = PCD_TURMA AND da.anosemestre = PNR_ANOSEMESTRE
  group by da.anosemestre, da.turma, da.disciplina;

  UPDATE turmasprofessores tp
  INNER JOIN TMP_AULAS as tm ON (tp.anosemestre = tm.anosemestre AND tp.turma = tm.turma AND tp.disciplina = tm.disciplina)
    SET tp.numeroaulas = tm.SOMA;

  TRUNCATE TMP_AULAS;

  -- FIM TEMPORARIO



  -- Calcular frequencia do aluno nas disciplinas
  UPDATE fichaindividual
     SET totalfaltas = (IFNULL(Falta1,0)+IFNULL(Falta2,0)+IFNULL(Falta3,0)+IFNULL(Falta4,0)+IFNULL(Falta5,0)+IFNULL(Falta6,0)+IFNULL(Falta7,0)+IFNULL(Falta8,0)+IFNULL(Falta9,0)+IFNULL(Falta10,0))
       , frequencia = 0
   WHERE sn_bloq_freq_global = 0
     AND codigoaluno = PCD_PESSOA
     AND turma = PCD_TURMA
     AND anoSemestre = PNR_ANOSEMESTRE;
     
  IF PADS_FREQ_TIPO = 'C' THEN
     -- calculo da frequencia pela carga horaria
     UPDATE fichaindividual f
      INNER JOIN turmas t ON (f.turma = t.codigo AND f.anosemestre = t.anosemestre)
      INNER JOIN grades_disciplinas g ON (g.cd_grade = t.cd_grade AND g.cd_curso = f.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = t.serie)
        SET f.frequencia = ROUND(100 - (f.totalfaltas / (g.vl_valor) * 100 ),0)
      WHERE f.sn_bloq_freq_global = 0
        AND f.codigoaluno = PCD_PESSOA
        AND f.turma = PCD_TURMA
        AND f.anoSemestre = PNR_ANOSEMESTRE;
        
     -- calcular a frequencia global
     
     SELECT CAST(ROUND((100 - (SUM(IF(f.sn_bloq_freq_global = 0, f.totalfaltas, g.vl_valor - (f.frequencia * g.vl_valor / 100)))/SUM(g.vl_valor) * 100)),2) as CHAR) AS FREQUENCIA
       FROM fichaindividual f
      INNER JOIN turmas t ON (f.turma = t.codigo and f.anosemestre = t.anosemestre) 
      INNER JOIN grades_disciplinas g ON (g.cd_grade = t.cd_grade AND g.cd_curso = f.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = t.serie)
      WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
        AND f.codigoaluno = PCD_PESSOA
        AND f.turmamatricula = PCD_TURMA_MATRICULA
        AND f.anoSemestre = PNR_ANOSEMESTRE
     INTO VL_FREQUENCIA;
     
     UPDATE matriculas
        SET frequencia_global = VL_FREQUENCIA
      WHERE anosemestre = PNR_ANOSEMESTRE
        AND codigoaluno = PCD_PESSOA
        AND turma = PCD_TURMA_MATRICULA;
        
  ELSE
     -- calculo da frequencia pelas aulas dadas
     
     UPDATE fichaindividual f
      INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and f.disciplina = t.disciplina)
        SET f.frequencia = ROUND(100 - (f.totalfaltas / (t.numeroaulas) * 100 ),0)
      WHERE f.sn_bloq_freq_global = 0
        AND f.codigoaluno = PCD_PESSOA
        AND f.turma = PCD_TURMA
        AND f.anoSemestre = PNR_ANOSEMESTRE;
        
     -- calcular a frequencia global

     SELECT CAST(ROUND((100 - (SUM(IF(f.sn_bloq_freq_global = 0, f.totalfaltas, t.numeroaulas - (f.frequencia * t.numeroaulas / 100)))/SUM(t.numeroaulas) * 100)),2) as CHAR) AS FREQUENCIA
       FROM fichaindividual f
      INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and  f.curso = t.curso and f.disciplina = t.disciplina and t.cd_categoria = 1 )
      WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
        AND f.codigoaluno = PCD_PESSOA
        AND f.turmamatricula = PCD_TURMA_MATRICULA
        AND f.anoSemestre = PNR_ANOSEMESTRE
     INTO VL_FREQUENCIA;

     UPDATE matriculas
        SET frequencia_global = VL_FREQUENCIA
      WHERE anosemestre = PNR_ANOSEMESTRE
        AND codigoaluno = PCD_PESSOA
        AND turma = PCD_TURMA_MATRICULA;

  
  END IF;

  SET VL_FREQUENCIA = NULL;

  -- fim do calculo da frequencia 


  IF COALESCE(PADS_FORMULA_ANUAL, '') = '' AND (PASN_NOTAS = 'S') THEN
     LEAVE sProc;
  END IF;
  
  -- COLOCAR AS DISCIPLINAS NA SITUACAO CURSANDO INICIALMENTE
  
  UPDATE fichaindividual
     SET situacao = 1
   WHERE anosemestre = PNR_ANOSEMESTRE
     AND Aproveitamento <> 'S'
     AND turma = PCD_TURMA
     AND turmamatricula = PCD_TURMA_MATRICULA
     AND codigoaluno = PCD_PESSOA
     AND situacao not in (3, 4, 5, 6, 7, 8, 10) ;
     
  -- IMPLEMENTAR RECUPERACAO SEMESTRAL **************************

  IF (PANR_PERIODOS > 1) THEN  
     CALL DIA_CALCULO_MEDIA_PERIODO(PNR_ANOSEMESTRE, PCD_TURMA, PCD_TURMA_MATRICULA, PCD_PESSOA);
  END IF;
  
  -- IMPLEMENTAR CALCULO DE MEDIA PERIODICA
  
  IF PASN_NOTAS = 'S' OR PASN_CONCEITOS_PARCIAIS = 'S' THEN
     -- TEM NOTAS -
     
     -- CALCULAR A MEDIA ANUAL
     
     IF INSTR(PADS_FORMULA_ANUAL, 'mediainstitucional') <= 0 THEN
     
        SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
        SET @sSql := CONCAT(@sSql, ' SELECT f.disciplina, (', PADS_FORMULA_ANUAL, ') FROM fichaindividual f');
        SET @sSql := CONCAT(@sSql, ' INNER JOIN turmas as t ON (t.codigo = f.turma and t.anosemestre = f.anosemestre) ');
        SET @sSql := CONCAT(@sSql, ' INNER JOIN grades_disciplinas as gc ON (gc.CD_GRADE = t.cd_grade AND gc.CD_CURSO = t.curso AND gc.CD_DISCIPLINA = f.disciplina AND gc.NR_SERIE = t.serie) ');
        SET @sSql := CONCAT(@sSql, ' WHERE f.anosemestre = ', PNR_ANOSEMESTRE, ' AND f.Aproveitamento <> "S" AND f.turma = CONVERT(_utf8 "', PCD_TURMA,'" USING latin1)');
        SET @sSql := CONCAT(@sSql, ' AND f.codigoaluno = ', PCD_PESSOA );
		          
        PREPARE sqlUpdate FROM @sSql;
        EXECUTE sqlUpdate;
        DEALLOCATE PREPARE sqlUpdate;
        
     ELSE
        -- IMPLEMENTAR MEDIA COM PI
        SELECT 1 INTO teste;
     
     END IF;
     
     -- SELECIONAR A MEDIA ANUAL DO TEMPORARIO
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;
         
         SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = IF(ISNULL(media_ajustada), ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE), ', media_ajustada)' );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;

         SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;
     
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS - 1
     
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -1, mediafinal = -1, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND Aproveitamento <> "S" ');
     
     SET registros := 1;
     
     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-1');
        SET registros = registros + 1;
     END WHILE;
     

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS -2
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -2, mediafinal = -2, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND Aproveitamento <> "S" ');

     SET registros := 1;

     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-2');
        SET registros = registros + 1;
     END WHILE;

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     

     -- CALCULO DA MEDIA FINAL ANTES DO EXAME
     
     TRUNCATE TMP_MEDIAFIM;
     
     SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
     SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_FINAL, ') FROM fichaindividual ');
     SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = CONVERT(_utf8 "', PCD_TURMA,'" USING latin1) ');
     SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

         SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;
		 
		/**
		 * GRAVA LOG DE ACESSO / ALTERACAO DE MEDIA NO DIARIO DE CLASSE
		 */
		IF CD_PESSOA_LOGADA IS NOT NULL THEN
			 SELECT professor FROM turmasprofessores WHERE anosemestre = PNR_ANOSEMESTRE AND turma = PCD_TURMA AND disciplina = VCD_DISCIPLINA LIMIT 1 INTO CD_PROFESSOR_LOG;

			 -- GRAVA LOG DE ACESSO AO DIARIO
			 IF CD_LOG_ACESSO = NULL THEN
				   INSERT INTO diario_logs (cd_pessoa, cd_acao, cd_atividade, dt_log, descricao, cd_professor) VALUES (CD_PESSOA_LOGADA, 0, 0, now(), 'Diario de Classes', CD_PROFESSOR_LOG);
				   SELECT LAST_INSERT_ID() INTO CD_LOG_ACESSO;
			 END IF;

			INSERT INTO diario_logs (cd_pessoa,     cd_acao, cd_atividade, dt_log, descricao,                                                                                                                                                                                                                                                                                                 cd_log_pai,     cd_professor)
  						 VALUES (CD_PESSOA_LOGADA,  1,       3,            NOW(),  CONCAT('Geracao de Media Final, Aluno: ',PCD_PESSOA,', Turma: ',PCD_TURMA,', Disciplina: ',VCD_DISCIPLINA,', Anosemestre: ',PNR_ANOSEMESTRE,', Media final: ',DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE),', Formula final: ',PADS_FORMULA_FINAL), CD_LOG_ACESSO,  IFNULL(CD_PROFESSOR_LOG,0));
		END IF;

        SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;


  END IF; -- FIM SN_NOTAS
  
  -- CONVERTER NOTAS EM CONCEITO
  
  IF ((PASN_NOTAS = 'S') AND (PASN_CONCEITOS = 'S')) OR ((PASN_CONCEITOS_PARCIAIS = 'S') AND (PASN_NOTAS = 'N')) THEN
  
     UPDATE fichaindividual fi
      INNER JOIN turmas AS t ON (fi.turma = t.codigo AND fi.anosemestre = t.anosemestre)
       LEFT JOIN avaliacoes_conceitos AS ac ON (ac.cd_avaliacao = t.cd_avaliacao)
             AND ac.nr_inicial <= fi.mediaFinal
             AND ac.nr_final >= fi.mediaFinal
        SET ds_media = ac.ds_conceito
      WHERE fi.aproveitamento <> "S"
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10)
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.turma = PCD_TURMA;
  
  END IF;
  
  
  IF PASN_FREQ_GLOBAL = 'S' THEN
    IF PADS_FREQ_TIPO = 'C' THEN
       --  Pegar a Frequencia pela Carga Horaria
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN

          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(g.vl_valor) * 100)),2)
            FROM fichaindividual as f INNER JOIN turmas t ON (f.turma = t.codigo and f.anosemestre = t.anosemestre)
           INNER JOIN grades_disciplinas as g ON (g.cd_grade = t.cd_grade AND g.cd_curso = t.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = t.serie)
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;
            
           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           
       END IF;
    ELSE
       -- Pegar a Frequencia pelas Aulas Dadas
       
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN
       
          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(t.numeroaulas) * 100)),2)
            FROM fichaindividual f
           INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and  f.curso = t.curso and f.disciplina = t.disciplina and t.cd_categoria = 1 )
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;

           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           

       END IF;
    END IF;
  END IF;
  
  -- tratar as variaveis
  
SELECT CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmenor_npns, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmenor_npns
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmaior_npns, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmaior_npns
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmedia_npns, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmedia_npns
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmenor_nps, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmenor_nps
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmaior_nps, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmaior_nps
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmedia_nps, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmedia_nps
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmenor_np, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmenor_np
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmaior_np, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmaior_np
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmedia_np, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmedia_np
  FROM (
   SELECT dp.disciplina
        , COALESCE(MIN(IF(dp.sn_compoe=0, DPA.vl_nota, 0)),0) as xmenor_npns
        , COALESCE(MAX(IF(dp.sn_compoe=0, DPA.vl_nota, 0)),0) as xmaior_npns
        , COALESCE(AVG(IF(dp.sn_compoe=0, DPA.vl_nota, 0)),0) as xmedia_npns
        , COALESCE(MIN(IF(dp.sn_compoe=1, DPA.vl_nota, 0)),0) as xmenor_nps
        , COALESCE(MAX(IF(dp.sn_compoe=1, DPA.vl_nota, 0)),0) as xmaior_nps
        , COALESCE(AVG(IF(dp.sn_compoe=1, DPA.vl_nota, 0)),0) as xmedia_nps
        , COALESCE(MIN(DPA.vl_nota),0) as xmenor_np
        , COALESCE(MAX(DPA.vl_nota),0) as xmaior_np
        , COALESCE(AVG(DPA.vl_nota),0) as xmedia_np	
    FROM diario_provas as dp
   INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
     AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
   WHERE dp.turma = PCD_TURMA_MATRICULA AND anosemestre = PNR_ANOSEMESTRE
   GROUP BY dp.disciplina
  ) as a
  INTO menor_npns, maior_npns, media_npns, menor_nps, maior_nps, media_nps, menor_np, maior_np, media_np;

  # TRATAR AS CONDICOES QUANDO USA AS NOTAS PARCIAIS
  
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'menor_npns', menor_npns);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_npns', maior_npns);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_npns', maior_npns);
  
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'menor_nps', menor_nps);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_nps', maior_nps);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'media_nps', media_nps);
  
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'menor_np', menor_np);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_np', maior_np);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'media_np', media_np);

  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'menor_npns', menor_npns);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_npns', maior_npns);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_npns', maior_npns);

  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'menor_nps', menor_nps);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_nps', maior_nps);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'media_nps', media_nps);

  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'menor_np', menor_np );
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_np', maior_np);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'media_np', media_np);
  
  -- VERIFICAR REPROVACAO DIRETA
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = 9 ');
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_REPROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

  IF PASN_NOTAS = 'S' THEN

     SET @sSql := CONCAT(@sSql, ' AND ( mediafinal is not null ) AND (mediafinal >=0) ' );

  END IF;
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  
  -- VERIFICAR APROVACAO DIRETA
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_APROVA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 9, 10) ');

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  -- Se naoo possuem avaliacao por nota, termina por aqui
  IF PASN_NOTAS = 'N' THEN
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
     LEAVE sProc;
  END IF;
  
  -- TENTAR PASSAR O ESTUDANTE COM O PESO PARA ARREDONDAMENTO
  
  -- *** FALTA IMPLEMENTAR ****
  
  IF PASN_EXAME = 'N' THEN
  
     -- Se nao tem exame entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao not in (SELECT cd_situacao FROM situacao WHERE cd_situacao_pai IN(0, 1, 9))
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
        
     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM EXAME
  
  UPDATE fichaindividual fi
     SET fi.situacao = 2
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao <> 9
     AND fi.situacao NOT IN(SELECT cd_situacao FROM situacao WHERE cd_situacao_pai = 0) and fi.mediafinal is not null
     AND ( fi.mediafinal >=0)
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

  IF (PANR_MAX_EXAME > 0) AND (PANR_MAX_EXAME < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em exame - Verificar se o aluno ultrapassou
     
     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2
       INTO VL_AUX;
        
     IF VL_AUX > PANR_MAX_EXAME THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 2;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
           
        LEAVE sProc;
         
     END IF;

  END IF;
  
  -- CALCULAR MEDIA DE EXAME
  

  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'notaexame', 'IF(IFNULL(sn_faltou_exame,0) = 1, 0, notaexame)');
  
  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_EXAME, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = CONVERT(_utf8 "', PCD_TURMA,'" USING latin1) ');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) AND (notaexame is not null OR IFNULL(sn_faltou_exame,0) = 1) ');
  
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) and (notaexame is not null OR IFNULL(sn_faltou_exame,0) = 1) ');

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  -- TENTAR APROVAR O ALUNO PELO EXAME
  
  # IMPLEMENTAR USO DA TABELA DAS NOTAS PARCIAIS

  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'menor_npns', menor_npns);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_npns', maior_npns);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_npns', maior_npns);

  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'menor_nps', menor_nps);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_nps', maior_nps);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'media_nps', media_nps);

  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'menor_np', menor_np);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_np', maior_np);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'media_np', media_np);

  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_AEXAME);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_EXAME, ' AND situacao = 2 and (notaexame is not null OR IFNULL(sn_faltou_exame,0) = 1) ');
  

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- TENTAR PASSAR O CARA PELO ARREDONDAMENTO APOS O EXAME
  
  -- FALTA IMPLEMENTAR ***********************
  
  IF PASN_2AEPOCA = 'N' THEN

     -- Se nao tem segunda epoca entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2 and (fi.notaexame is not null OR IFNULL(fi.sn_faltou_exame,0) = 1 )
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);

     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM SEGUNDA EPOCA

  UPDATE fichaindividual fi
   INNER JOIN turmas t ON (t.curso = fi.curso AND t.codigo = fi.turma AND t.anosemestre = fi.anosemestre)
   INNER JOIN avaliacoes_parametros ap ON (ap.cd_avaliacao = t.cd_avaliacao AND ap.cd_coligada = t.cd_coligada)
     SET fi.situacao = 11
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 2
     AND (fi.mediafinal >=0)
     AND ( ( ap.sn_falta_exame_forca_2epoca = 1 AND (IFNULL(fi.sn_faltou_exame,0) = 1 OR fi.notaexame IS NOT NULL) )
         OR (fi.notaexame is not null) );

  IF (PANR_MAX_2AEPOCA > 0) AND (PANR_MAX_2AEPOCA < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em segunda epoca - Verificar se o aluno ultrapassou

     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 11
       INTO VL_AUX;

     IF VL_AUX > PANR_MAX_2AEPOCA THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 11;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

        LEAVE sProc;
        
     ELSE
         -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
         -- IMPLEMENTAR **********************
         -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
         SELECT 1 INTO teste;

     END IF;
     
  ELSE
     -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
     -- IMPLEMENTAR **********************
     -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
     SELECT 1 INTO teste;

  END IF;
  
  
  -- CALCULAR MEDIA DE SEGUNDA EPOCA

  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_2EPOCA, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = CONVERT(_utf8 "', PCD_TURMA,'" USING latin1)');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND situacao = 11 and segunda_epoca is not null ');
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao = 11 and segunda_epoca is not null  ');
     
     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;

     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  
  -- TENTAR APROVAR O ALUNO PELO SEGUNDA EPOCA
  
# IMPLEMENTAR USO DA TABELA DAS NOTAS PARCIAIS

  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'menor_npns', menor_npns);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_npns', maior_npns);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_npns', maior_npns);

  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'menor_nps', menor_nps);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_nps', maior_nps);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'media_nps', media_nps);

  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'menor_np', menor_np);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_np', maior_np);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'media_np', media_np);

  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_A2EPOCA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma=CONVERT(_utf8 "', PCD_TURMA, '" USING latin1) AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_2AEPOCA, ' AND situacao = 11 and segunda_epoca is not null ');
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- IMPLEMENTAR
  -- TENTAR PASSAR PELO PELO DO ARREDONDAMENTO APOS EXAME
  
  
  -- REPROVAR AS DISCIPLINAS QUE FICARAM EM SEGUNDA EPOCA
  
  
  UPDATE fichaindividual fi
     SET fi.situacao = 9
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 11 and segunda_epoca is not null
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

 -- IMPLEMENTAR - CALCULO MÃƒâ€°DIA DO CURSO
 
 -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
 
 CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
  

END sProc//




DROP PROCEDURE IF EXISTS DIA_SITUACAO_FINAL//

CREATE PROCEDURE `DIA_SITUACAO_FINAL`(IN PCD_PESSOA INTEGER(11), IN PCD_TURMA VARCHAR(15), IN PNR_ANOSEMESTRE INTEGER(11))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE CD_SITU_CONCLUIDA, CD_SITUACAO, NR_QTD INTEGER(11) DEFAULT NULL ;
    
 -- SELECIONAR DO PARAMETRO DE AVALIACAO A SITUACAO DE CONCLUSAO (CASO EXISTA)
 SELECT ap.cd_situacao_concluida
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO CD_SITU_CONCLUIDA;


   IF CD_SITU_CONCLUIDA IS NOT NULL THEN
      --  EXISTE A SITUACAO DE CONCLUSAO NESTE CASO... 
      --  DEVE SER VERIFICADO SE O ALUNO CONCLUIU TODAS AS DISCIPLINAS
      
      SELECT COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
         and s.cd_situacao_pai in (1,2,11)
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO NR_QTD;
        
      IF NR_QTD >= 1 THEN
         -- NESTE CASO, O ALUNO CONTINUARA COM A SITUACAO ATIVA (CURSANDO)
         -- POIS EXISTE AINDA ALGUMA SITUACAO PENDENTE.
         
         SET CD_SITUACAO = 1;
      ELSE
         -- SE NÃO TEM NENHUMA SITUACAO PENDENTE, ENTÃO COLOCAR COMO CONCLUIDA
         
         SET CD_SITUACAO = CD_SITU_CONCLUIDA;
      END IF;
   ELSE
      -- SELECIONAR AS DISCIPLINAS DO ALUNO NA TURMA COM A QUANTIDADE EM CADA SITUACAO

      SELECT s.cd_situacao_pai, COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao AND s.nr_ordem_final is not null)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO CD_SITUACAO, NR_QTD;

   END IF;
   
   IF CD_SITUACAO IS NOT NULL THEN
   
      UPDATE MATRICULAS
         SET situacao = CD_SITUACAO
       WHERE situacao <> 10
         AND codigoaluno = PCD_PESSOA
         AND turma = PCD_TURMA
         AND anosemestre = PNR_ANOSEMESTRE;
         
   END IF;

END//]]></atualiza><atualiza codigo="{2A8598AC-379F-432B-9253-4B47DF4E058E}" protocolo="mysql-5"><![CDATA[ALTER TABLE `diario_provas` CHANGE `cd_prova_tipo` `cd_prova_tipo` INT(11) DEFAULT '1' NULL;
UPDATE diario_provas SET cd_prova_tipo=1  WHERE cd_prova_tipo IS null;]]></atualiza><atualiza codigo="{2A8598AC-379F-432B-9253-4B47DF4E058E}" protocolo="oracle"><![CDATA[ALTER TABLE DIARIO_PROVAS MODIFY ( "CD_PROVA_TIPO" NUMBER(9) DEFAULT 1  );]]></atualiza><atualiza codigo="{61785A6B-F4BB-4250-B29F-99EE5A09C0F7}" protocolo="mysql-5"><![CDATA[ALTER TABLE `fin_cp_preparacao` CHANGE `cd_usuario_preparou` `cd_usuario_preparou` INT(11) NULL;
ALTER TABLE `fin_cp_preparacao` CHANGE `cd_usuario_aprovou` `cd_usuario_aprovou` INT(11) UNSIGNED NULL;
ALTER TABLE `fin_cp_preparacao` CHANGE `cd_usuario_baixou` `cd_usuario_baixou` INT(11) UNSIGNED NULL;]]></atualiza><atualiza codigo="{61785A6B-F4BB-4250-B29F-99EE5A09C0F7}" protocolo="oracle"><![CDATA[ALTER TABLE FIN_CP_PREPARACAO 
MODIFY ( CD_USUARIO_PREPAROU NUMBER(9) ) 
MODIFY ( CD_USUARIO_APROVOU NUMBER(19) ) 
MODIFY ( CD_USUARIO_BAIXOU NUMBER(19) ) ;
]]></atualiza><atualiza codigo="{79D587EC-4A51-4402-8B37-664D2544C16F}" protocolo="ansi"><![CDATA[delimiter //

SET SQL_LOG_BIN := 0//
SET GLOBAL log_bin_trust_function_creators := 1//

DROP PROCEDURE IF EXISTS `DIA_CALCULO_MEDIA_DISCIPLINA`//

CREATE PROCEDURE `DIA_CALCULO_MEDIA_DISCIPLINA`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA TINYINT, IN PCD_PESSOA INTEGER(11), IN PDS_FORMULA VARCHAR(255), IN CD_LOG_ACESSO INTEGER(11), IN CD_PESSOA_LOGADA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
BEGIN
-- esta funcao retorna o valor da me'dia calculada, conforme a formula passada
 -- se a formula nao for passada ela utilizará a formula do diario_turmas

 DECLARE VL_NOTA_MENOR, VL_NOTA_RE, VL_MEDIA_MAXIMA, VL_NOTA_PROFICIENCIA, VL_AJUSTE, VL_NOTA_FINAL, VL_NOTA_FIXA_ETAPA, VL_MEDIA_CALCULADA, VL_NOTA_AUX DOUBLE;

 DECLARE VNR_NOTA, VNR_NOTA_RE, VNR_NOTA_AUX INTEGER(11);
 DECLARE VNR_NOTA_MENOR, VSN_COMPOE INTEGER(11);
 DECLARE SN_PROFICIENCIA CHAR(1) DEFAULT 'N';
 DECLARE DS_FORMULA_ORIGINAL, DS_FORMULA_AUX MEDIUMTEXT DEFAULT NULL;
 
 -- DECLARA TODOS OS CAMPOS EXISTENTE NA TABELA AVALIACOES_PARAMETROS
 DECLARE PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PADS_FORMULA_RE, PADS_CONDICAO_RE MEDIUMTEXT;
 DECLARE PASN_CONVERTER_NOTAS_NULAS MEDIUMTEXT;
 DECLARE PASN_TRUNCAR VARCHAR(1);
 DECLARE PASN_AJUSTE_APOS_RE, PATP_DECIMAIS_FORCE TINYINT(1);
 DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE INTEGER(11);
 DECLARE CD_PROFESSOR_LOG INTEGER;
 DECLARE DS_CHAVE, DS_CHAVE_MEDIA, DS_CHAVE_MEDIA_DIGITADA, DS_CHAVE_SOMA VARCHAR(100);
 
 DECLARE registros INTEGER DEFAULT NULL;

 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA EH CUSTOMIZADA
 DECLARE selectNotas CURSOR FOR
         SELECT nro_nota, sn_compoe FROM diario_provas
         WHERE sn_especial = 0
           AND sn_proficiencia = 0
           AND anosemestre = PNR_ANOSEMESTRE
           AND bimestre = PNR_ETAPA
           AND turma = PCD_TURMA
           AND disciplina = PCD_DISCIPLINA
         ORDER BY nro_nota DESC;
         
 -- DECLARA O CURSOS PARA DESCOBRIR AS NOTAS SUBSTITUIVEIS - PEGAR MENOR NOTA
         
 DECLARE selectMenor CURSOR FOR
         SELECT DP.nro_nota
              , IFNULL(DPA.VL_NOTA, 0)
           FROM DIARIO_PROVAS AS DP
           LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
                 AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
          WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1
            AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
            AND DP.BIMESTRE = PNR_ETAPA
            AND DP.TURMA = PCD_TURMA
            AND DP.DISCIPLINA = PCD_DISCIPLINA
          ORDER BY DP.nro_nota;
          
 DECLARE selectChaves CURSOR FOR
         SELECT dpt.ds_chave
           FROM diario_provas as dp
          INNER JOIN diario_provas_tipos as dpt ON (dp.cd_prova_tipo = dpt.cd_prova_tipo)
          WHERE turma = PCD_TURMA
            AND anosemestre = PNR_ANOSEMESTRE
            AND disciplina = PCD_DISCIPLINA
            AND bimestre = PNR_ETAPA
          GROUP BY dpt.ds_chave;


 -- DECLARE que será chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
 DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM tmp_medias;

 -- Criar tabela temporaria para auxiliar nos calculos

 SET DS_FORMULA_ORIGINAL := PDS_FORMULA;
 SET DS_FORMULA_ORIGINAL := REPLACE(DS_FORMULA_ORIGINAL, ",", ".");
 SET DS_FORMULA_ORIGINAL := REPLACE(DS_FORMULA_ORIGINAL, ";", ",");


 -- Por padrão a procedure sempre vai tentar criar  a tabela, se ela já existir vai gerar o erro 42S01, chamando o declare continue handle acima.
CREATE  TEMPORARY TABLE IF NOT EXISTS TMP_MEDIAS ( MEDIA DOUBLE );

 -- CARREGA TODOS OS CAMPOS DA TABELA DE AVALIACOES_PARAMETROS NO DECLARES
 SELECT ap.cd_avaliacao
      , ap.nr_media_proficiencia
      , ap.sn_converter_notas_nulas
      , ap.sn_notas_truncar
      , ap.nr_casas_decimais
      , ap.sn_ajuste_apos_recuperacao
      , ap.ds_formula_recuperacao
      , ap.ds_criterio_recuperacao
      , ap.nr_casas_decimais_forcado
      , ap.tp_ajuste_forcado
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO, PANR_MEDIA_PROFICIENCIA, PASN_CONVERTER_NOTAS_NULAS, PASN_TRUNCAR, PAVL_DECIMAIS
       , PASN_AJUSTE_APOS_RE, PADS_FORMULA_RE, PADS_CONDICAO_RE, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE;
       
 -- Verifica se existe Parametro de Avaliacao
 IF ( PACD_AVALIACAO IS NULL ) THEN
    SET VL_MEDIA_CALCULADA := NULL;
 END IF;

 -- Verificar se existe Prova de Proficiencia
 SET VNR_NOTA := NULL;
 
 SELECT dp.nro_nota
   FROM diario_provas dp
  WHERE dp.anosemestre = PNR_ANOSEMESTRE
    AND dp.bimestre = PNR_ETAPA
    AND dp.turma = PCD_TURMA
    AND dp.disciplina = PCD_DISCIPLINA
    AND dp.sn_proficiencia = 1
   INTO VNR_NOTA;

 -- Se tiver nota de proficiencia, faz a verificacao das provas do aluno
 IF ( VNR_NOTA > 0 ) THEN
    SELECT dpa.vl_nota
      FROM diario_provas_alunos dpa
     WHERE dpa.nr_anosem = PNR_ANOSEMESTRE
       AND dpa.cd_bimestre = PNR_ETAPA
       AND dpa.cd_turma = PCD_TURMA
       AND dpa.cd_disciplina = PCD_DISCIPLINA
       AND dpa.cd_pessoa = PCD_PESSOA
       AND dpa.nr_prova = VNR_NOTA
      INTO VL_NOTA_PROFICIENCIA;

    -- Se passou na proficiencia
    IF ( VL_NOTA_PROFICIENCIA >= PANR_MEDIA_PROFICIENCIA ) THEN
       SET VL_MEDIA_CALCULADA := VL_NOTA_PROFICIENCIA;
    END IF;
 END IF;
 -- SE NAO FOR PROVA DE SUFICIENCIA... continuar


 -- SE FOR FORMULA ARITMETICA DAS NOTAS DIGITADAS
 IF ( PDS_FORMULA = 'ARITMETICA' ) THEN
 
    -- MONTAR A FORMULA PARA MEDIA ARITMETICA

    SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 1 THEN
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(*))

           ELSE
              CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(DPA.VL_NOTA))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;


 -- SE NAO VERIFICA SE EH FORMULA MEDIA_PESO
 ELSEIF PDS_FORMULA = 'MEDIA_PESO' THEN

  SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 0 THEN
                     CASE WHEN COUNT(*) != COUNT(DPA.VL_NOTA) THEN
                               NULL
                     ELSE
                               CONCAT('(',GROUP_CONCAT(CONCAT('NOTA', DP.nro_nota,'*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( DP.VL_PESO ) )
                     END
           ELSE
                     CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', DP.nro_nota,',0)*', COALESCE( DP.VL_PESO, 1)) SEPARATOR '+'),')/', SUM( COALESCE( DP.VL_PESO, 1 ) ))
           END
      FROM DIARIO_PROVAS AS DP
     LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
            AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
     WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0
       AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
       AND DP.BIMESTRE = PNR_ETAPA
       AND DP.TURMA = PCD_TURMA
       AND DP.DISCIPLINA = PCD_DISCIPLINA
      INTO DS_FORMULA_ORIGINAL;

 ELSEIF PDS_FORMULA = 'ZERAR' OR PDS_FORMULA = ''THEN
    SET VL_MEDIA_CALCULADA := NULL;

 -- Formula montada
 END IF;
 
 -- CRIA UM BACKUP DA FORMULA

 SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;
 
 -- Verificar o uso das funcoes
 --     MEDIA(chave);  MEDIA_DIGITADA(chave)
 
 OPEN selectChaves;
 
 SELECT FOUND_ROWS() INTO registros;
 
 WHILE registros > 0 DO
    FETCH selectChaves INTO DS_CHAVE;
    
    SELECT dpt.ds_chave
     , CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', dp.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(*)) as media
     , CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', dp.nro_nota, ',0)') SEPARATOR '+'),')/', COUNT(DPA.VL_NOTA)) as media_digitada
     , CONCAT('(',GROUP_CONCAT(CONCAT('COALESCE(NOTA', dp.nro_nota, ',0)') SEPARATOR '+')) as soma
      FROM diario_provas as dp
      INNER JOIN diario_provas_tipos as dpt ON (dp.cd_prova_tipo = dpt.cd_prova_tipo)
       LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
        AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
      WHERE turma = PCD_TURMA
        AND anosemestre = PNR_ANOSEMESTRE
        AND disciplina = PCD_DISCIPLINA
        AND bimestre = PNR_ETAPA
        AND dpt.ds_chave = DS_CHAVE
      GROUP BY dpt.ds_chave
      INTO DS_CHAVE
         , DS_CHAVE_MEDIA
         , DS_CHAVE_MEDIA_DIGITADA
         , DS_CHAVE_SOMA;
         
      SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('MEDIA(', UPPER(DS_CHAVE), ')'), DS_CHAVE_MEDIA );
      SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('MEDIA_DIGITADA(', UPPER(DS_CHAVE), ')'), DS_CHAVE_MEDIA_DIGITADA );
      SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('SOMA(', UPPER(DS_CHAVE), ')'), DS_CHAVE_SOMA );
      SET registros = registros - 1;
      
 
 END WHILE;
 
 -- INICIAR O CALCULO DA FORMULA MONTADA

 OPEN selectNotas;

 SELECT FOUND_ROWS() INTO registros;

 WHILE registros > 0 DO
    FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

    SELECT CASE WHEN PASN_CONVERTER_NOTAS_NULAS = 1 THEN
              COALESCE( dpa.vl_nota, 0 )
           ELSE
              dpa.vl_nota
           END
      FROM diario_provas_alunos dpa
     WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
       AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
       AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
      INTO VL_NOTA_AUX;

    SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );
    SET VL_NOTA_AUX := NULL;
    SET registros = registros - 1;

 END WHILE;

 CLOSE selectNotas;
 
-- Atualizar o resultado do calculo em uma tabela temporaria

 IF DS_FORMULA_AUX IS NOT NULL THEN

-- Inserir o resultado da formula montada na TMP_MEDIA e posteriormente resgatar essa informacao junto com o AJUSTE

    TRUNCATE TMP_MEDIAS;

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (', DS_FORMULA_AUX , ')' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;
    
    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_MEDIA_CALCULADA;
      
    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 ELSE

--  Neste caso a nota do professor ja esta calculada, basta buscar o AJUSTE

    SET VL_NOTA_FIXA_ETAPA := VL_MEDIA_CALCULADA;

 END IF;
 
 
-- buscar o ajuste

 TRUNCATE TMP_MEDIAS;

 SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS (MEDIA) SELECT ajuste', PNR_ETAPA, ' FROM fichaindividual WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '=0 AND aproveitamento="N" LIMIT 1;' );
 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;
 

 SELECT MEDIA
   FROM TMP_MEDIAS
   INTO VL_AJUSTE;
   
 
-- VL_NOTA_FIXA_ETAPA: mantem o valor da nota calculada do professor antes do ajuste
-- VL_AJUSTE: Possui o valor do ajuste DIGITADO para este aluno

-- Verificar se tera nota de recuperacao


 -- Verificar se existe Prova de Recuperacao e buscar a nota do aluno
 SET VNR_NOTA_RE := NULL;
 

 SELECT DP.nro_nota
      , DPA.VL_NOTA
   FROM DIARIO_PROVAS AS DP
   LEFT JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
         AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
  WHERE DP.SN_ESPECIAL = 1 
    AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
    AND DP.BIMESTRE = PNR_ETAPA
    AND DP.TURMA = PCD_TURMA
    AND DP.DISCIPLINA = PCD_DISCIPLINA
   INTO VNR_NOTA_RE, VL_NOTA_RE;
   

  IF (VNR_NOTA_RE IS NULL) OR (VL_NOTA_RE IS NULL) THEN
     -- NAOTEM nota de recuperacao
     SET VL_NOTA_FINAL := VL_NOTA_FIXA_ETAPA;
  ELSE
     -- TEM NOTA DE RECUPERACAO
     IF (PASN_AJUSTE_APOS_RE = 0) THEN
        SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE, 0);
        SET VL_MEDIA_CALCULADA := VL_MEDIA_CALCULADA + IFNULL(VL_AJUSTE, 0);
     END IF;
     
     IF (PADS_FORMULA_RE = 'SUBSTITUIR_MENOR') THEN
     
     -- DESCOBRIR QUAL A MENOR NOTA DAS SUBSTITUIVEIS

        OPEN selectMenor;

        SELECT FOUND_ROWS() INTO registros;
        
        SET VL_NOTA_MENOR := 999999;
        SET VNR_NOTA_MENOR := NULL;
        
        SET VNR_NOTA_AUX := NULL;
        SET VL_NOTA_AUX := NULL;

        WHILE registros > 0 DO
        
            FETCH selectMenor INTO VNR_NOTA_AUX, VL_NOTA_AUX;
            
            IF (VL_NOTA_AUX < VL_NOTA_MENOR) AND (VL_NOTA_AUX < VL_NOTA_RE) THEN
               SET VL_NOTA_MENOR := VL_NOTA_AUX;
               SET VNR_NOTA_MENOR := VNR_NOTA_AUX;
            END IF;
            
            SET registros = registros - 1;

        END WHILE;
        
        CLOSE selectMenor;
        
        -- A VARIAVEL VNR_NOTA_MENOR representa o numero da prova que tem a menor nota
        
        -- Efetuar a substituicao da menor nota na formula

        
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;
           
           IF ( VNR_NOTA = VNR_NOTA_MENOR) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;
                
           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;
        
        -- MONTAR A CONDICAO PARA RECUPERACAO - O MEDIA TEM QUE SER MAIOR
        
        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSEIF (PADS_FORMULA_RE = 'SUBSTITUIR_TODAS') THEN
    
        SET DS_FORMULA_AUX = DS_FORMULA_ORIGINAL;

        OPEN selectNotas;

        SELECT FOUND_ROWS() INTO registros;

        WHILE registros > 0 DO
        
           FETCH selectNotas INTO VNR_NOTA, VSN_COMPOE;

           IF ( VSN_COMPOE = 1) THEN
              SET VL_NOTA_AUX := VL_NOTA_RE;
           ELSE

              SELECT COALESCE( dpa.vl_nota, 0 )
                FROM diario_provas_alunos dpa
               WHERE dpa.NR_PROVA = VNR_NOTA AND dpa.NR_ANOSEM = PNR_ANOSEMESTRE
                 AND dpa.CD_BIMESTRE = PNR_ETAPA AND dpa.CD_TURMA = PCD_TURMA
                 AND dpa.CD_DISCIPLINA = PCD_DISCIPLINA AND dpa.CD_PESSOA = PCD_PESSOA
                INTO VL_NOTA_AUX;

           END IF;

           SET DS_FORMULA_AUX = REPLACE( UPPER( DS_FORMULA_AUX ), CONCAT('NOTA', VNR_NOTA), IFNULL(VL_NOTA_AUX, 'NULL') );

           SET VL_NOTA_AUX := NULL;

           SET registros = registros - 1;

        END WHILE;

        CLOSE selectNotas;

        SET PADS_CONDICAO_RE := CONCAT(DS_FORMULA_AUX, '>', VL_NOTA_FIXA_ETAPA);
        
    ELSE
       -- VERIFICAR AS OUTRAS FORMULAS DE RECUPERAÇÃO
       -- TROCAR AS PALAVRAS RESERVADAS RB / NOTAP / MEDIA_SUBSTITUIVEIS / MEDIA_NAO_SUBSTITUIVEIS
       
       SET DS_FORMULA_AUX := PADS_FORMULA_RE;
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, ",", ".");
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, ";", ",");

       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'RB', VL_NOTA_RE);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'RB', VL_NOTA_RE);
       
       SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'NOTAP', VL_NOTA_FIXA_ETAPA);
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS SUBSTITUIVEIS NAO NULAS
          
          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 1 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;
            
            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
       
       END IF;
       
       IF (INSTR(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) OR (INSTR(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS') > 0) THEN
          -- CALCULAR A MEDIA ARTMETICA DAS NOTAS NAO SUBSTITUIVEIS NAO NULAS

          SELECT ( SUM( COALESCE(DPA.VL_NOTA, 0 ) ) / COUNT(*) )
            FROM DIARIO_PROVAS AS DP
           INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
             AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA )
           WHERE DP.SN_ESPECIAL = 0 AND DP.SN_PROFICIENCIA = 0 AND DP.NRO_NOTA > 0 AND DP.SN_COMPOE = 0 AND DPA.VL_NOTA IS NOT NULL
             AND DPA.CD_PESSOA = PCD_PESSOA
             AND DP.ANOSEMESTRE = PNR_ANOSEMESTRE
             AND DP.BIMESTRE = PNR_ETAPA
             AND DP.TURMA = PCD_TURMA
             AND DP.DISCIPLINA = PCD_DISCIPLINA
            INTO VL_MEDIA_CALCULADA;

            SET DS_FORMULA_AUX := REPLACE(DS_FORMULA_AUX, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);
            SET PADS_CONDICAO_RE := REPLACE(PADS_CONDICAO_RE, 'MEDIA_NAO_SUBSTITUIVEIS', VL_MEDIA_CALCULADA);

       END IF;
       

    END IF;
     
-- Executar a formula de recuperacao

    TRUNCATE TMP_MEDIAS;

    SET @sSql := CONCAT('INSERT INTO TMP_MEDIAS VALUES (IF(', IFNULL(PADS_CONDICAO_RE, 'NULL'), ', ', IFNULL(DS_FORMULA_AUX, 'NULL') , ', ', IFNULL(VL_NOTA_FIXA_ETAPA, 'NULL'), ') )' );
    
    PREPARE sqlUpdate FROM @sSql;
    EXECUTE sqlUpdate;
    DEALLOCATE PREPARE sqlUpdate;

    SELECT MEDIA
      FROM TMP_MEDIAS
      INTO VL_NOTA_FINAL;
      
  END IF;

  IF ((PASN_AJUSTE_APOS_RE = 1) OR (VNR_NOTA_RE IS NULL) ) THEN

     SET VL_NOTA_FINAL := VL_NOTA_FINAL + IFNULL(VL_AJUSTE,0);
     SET VL_NOTA_FIXA_ETAPA := VL_NOTA_FIXA_ETAPA + IFNULL(VL_AJUSTE,0);
  END IF;
  
  -- Verificar se o aluno tem COMPLEMENTO DE MEDIA
  
  SET VL_MEDIA_CALCULADA := 0;
  
  SELECT IFNull(SUM(aa.NT_AJUSTE),0)
    FROM DIARIO_AJUSTES_ALUNOS aa
   INNER JOIN DIARIO_AJUSTES_TURMAS at ON (aa.cd_ajuste_turma = at.cd_ajuste_turma)
   WHERE aa.cd_pessoa = PCD_PESSOA
     AND at.cd_turma = PCD_TURMA
     AND at.nr_anosem = PNR_ANOSEMESTRE
     AND at.nr_etapa = PNR_ETAPA
     AND aa.nt_ajuste is not null				
    INTO VL_MEDIA_CALCULADA;
    
    
 SET VL_NOTA_FINAL := VL_NOTA_FINAL + COALESCE(VL_MEDIA_CALCULADA, 0);
				
 -- Gravar as informacoes na fichaindividual

 SET @sSql := CONCAT('UPDATE fichaindividual SET nota', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FIXA_ETAPA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', nota_d', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_FINAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ', exame', PNR_ETAPA, '=', DIA_FORMATAR_MEDIA(VL_NOTA_RE, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
 SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', PCD_DISCIPLINA, '" AND sn_bloqueado', PNR_ETAPA, '=0 AND aproveitamento="N";' );
 
 PREPARE sqlUpdate FROM @sSql;
 EXECUTE sqlUpdate;
 DEALLOCATE PREPARE sqlUpdate;
 
 
 IF CD_PESSOA_LOGADA IS NOT NULL THEN
		SELECT professor FROM turmasprofessores WHERE anosemestre = PNR_ANOSEMESTRE AND turma = PCD_TURMA AND disciplina = PCD_DISCIPLINA LIMIT 1 INTO CD_PROFESSOR_LOG;

		-- GRAVA LOG DE ACESSO AO DIARIO
		IF CD_LOG_ACESSO = NULL THEN
			 INSERT INTO diario_logs (cd_pessoa, cd_acao, cd_atividade, dt_log, descricao, cd_professor) VALUES (CD_PESSOA_LOGADA, 0, 0, now(), 'Diario de Classes', CD_PROFESSOR_LOG);
			 SELECT LAST_INSERT_ID() INTO CD_LOG_ACESSO;
		END IF;

		INSERT INTO diario_logs (cd_pessoa,         cd_acao, cd_atividade, dt_log, descricao,                                                                                                                                                                                                                                                                                  cd_log_pai,     cd_professor)
						 VALUES (CD_PESSOA_LOGADA,  1,       3,            NOW(),  CONCAT('Geracao de Media, Aluno: ',PCD_PESSOA,', Turma: ',PCD_TURMA,', Disciplina: ',PCD_DISCIPLINA,', Anosemestre: ',PNR_ANOSEMESTRE,', Media: ',DIA_FORMATAR_MEDIA(VL_NOTA_FIXA_ETAPA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE),', Formula: ',PDS_FORMULA), CD_LOG_ACESSO,  IFNULL(CD_PROFESSOR_LOG,0));
 END IF;

 CALL DIA_CALCULO_MEDIA_FINAL(PNR_ANOSEMESTRE, PCD_TURMA, PCD_TURMA, PCD_PESSOA, CD_LOG_ACESSO, CD_PESSOA_LOGADA); 
 
END//

DROP PROCEDURE IF EXISTS DIA_MEDIA_TURMA//
CREATE PROCEDURE `DIA_MEDIA_TURMA`(IN PCD_TURMA VARCHAR(60), IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_DISCIPLINA INTEGER(11), IN PNR_ETAPA INTEGER(11), IN PDS_FORMULA VARCHAR(255), IN CD_LOG_ACESSO INTEGER(11), IN CD_PESSOA_LOGADA INTEGER(11))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE PACD_AVALIACAO INTEGER DEFAULT NULL;
 DECLARE registros INTEGER DEFAULT NULL;
 
 DECLARE VCD_ALUNO INTEGER DEFAULT NULL;
  
 -- DECLARA O CURSOR UTILIZADO QUANDO A FORMULA Eh CUSTOMIZADA
 DECLARE selectAlunos CURSOR FOR
         SELECT codigoaluno FROM fichaindividual
          WHERE anosemestre = PNR_ANOSEMESTRE
            AND turma = PCD_TURMA
            AND disciplina = PCD_DISCIPLINA
            AND aproveitamento = "N"
         ORDER BY codigoaluno DESC;
		 
 IF PDS_FORMULA = 'NULL' THEN
      SELECT 
         formula_media 
      FROM 
         diario_turmas 
      WHERE 
         turma LIKE PCD_TURMA AND 
         anosemestre = PNR_ANOSEMESTRE AND 
         disciplina = PCD_DISCIPLINA AND 
         bimestre = PNR_ETAPA 
      INTO PDS_FORMULA;
 END IF;		 

 -- VERIFICA SE EXISTE O PARAMETRO DE AVALIAÇÃO
 SELECT ap.cd_avaliacao
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PACD_AVALIACAO;

 IF ( PACD_AVALIACAO IS NOT NULL ) THEN
-- SE EXISTE PARAMETRO DE AVALIACAO, GUARDAR A FORMULA NO DIARIO

    IF PDS_FORMULA = 'ZERAR' THEN
    
       UPDATE diario_turmas
          SET formula_media = NULL
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    ELSE
    
       UPDATE diario_turmas
          SET formula_media = PDS_FORMULA
        WHERE anosemestre = PNR_ANOSEMESTRE
          AND turma = PCD_TURMA
          AND disciplina = PCD_DISCIPLINA
          AND bimestre = PNR_ETAPA;
          
    END IF;

    OPEN selectAlunos;

    SELECT FOUND_ROWS() INTO registros;

    WHILE registros > 0 DO
        FETCH selectAlunos INTO VCD_ALUNO;
            
        CALL DIA_CALCULO_MEDIA_DISCIPLINA(PNR_ANOSEMESTRE, PCD_TURMA, PCD_DISCIPLINA, PNR_ETAPA, VCD_ALUNO, PDS_FORMULA, CD_LOG_ACESSO, CD_PESSOA_LOGADA);

        SET registros = registros - 1;

    END WHILE;

    CLOSE selectAlunos;
          
 END IF;

END//



DROP FUNCTION IF EXISTS DIA_ARREDONDA_FORCADO//

CREATE FUNCTION `DIA_ARREDONDA_FORCADO`(PVL_NOTA DOUBLE, PNR_PRECISAO SMALLINT, PTP_DIRECAO TINYINT(1))
    RETURNS double
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE dFracao, dDif DOUBLE;
   DECLARE dDiv1, dDiv2, dDiv3, dDiv4 DOUBLE;
   DECLARE AMult INTEGER(11);

   -- Direcao:   1 = Para cima,  2 = Para Baixo,  3 = Ambos
   IF PNR_PRECISAO = 0 THEN
      SET dFracao := PVL_NOTA - TRUNCATE(PVL_NOTA, 0);
   ELSE
      SET dFracao := PVL_NOTA - TRUNCATE(PVL_NOTA, (PNR_PRECISAO-1));
   END IF;
   

   -- Sem nenhuma casa decimal - deve arredondar de forma diferenciada
   IF PNR_PRECISAO = 0 THEN

      IF (PTP_DIRECAO = 2) OR (dFracao = 0) THEN
         SET dDif := - dFracao;
      ELSEIF (PTP_DIRECAO = 1) THEN
         SET dDif := (1 - dFracao);
      ELSE
         IF (dFracao < 0.5) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (1 - dFracao);
         END IF;
      END IF;


   ELSE


     SET AMult := TRUNCATE(POWER(10.0, PNR_PRECISAO),0);

      SET dDiv1 := 2.5 / AMult;
      SET dDiv2 := 5 / AMult;
      SET dDiv3 := 7.5 / AMult;
      SET dDiv4 := 10 / AMult;

      IF (dFracao < dDiv1) THEN -- menor que 2.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) OR (dFracao = 0) THEN
            SET dDif := -dFracao;
         ELSE
            SET dDif := (dDiv2 - dFracao);
         END IF;
      ELSEIF ((dFracao >= dDiv1) and (dFracao <= dDiv2)) THEN -- maior que 2.5 e menor que 5
         IF (PTP_DIRECAO = 1 OR PTP_DIRECAO = 3) OR (dFracao = dDiv2) THEN
            SET dDif := (dDiv2 - dFracao);
         ELSE
            SET dDif := -dFracao;
         END IF;
      ELSEIF ((dFracao > dDiv2) and (dFracao < dDiv3)) THEN -- maior que 5 e menor que 7.5
         IF (PTP_DIRECAO = 2 OR PTP_DIRECAO = 3) THEN
            SET dDif := - (dFracao - dDiv2);
         ELSE
            SET dDif := (dDiv4 - dFracao);
         END IF;
      ELSEIF (dFracao >= dDiv3) THEN -- maior que 7.5
         IF PTP_DIRECAO = 1 OR PTP_DIRECAO = 3 THEN
            SET dDif := + (dDiv4 - dFracao);
         ELSE
            SET dDif := dDiv2 - dFracao;
         END IF;
      END IF;

   END IF;

   RETURN ROUND(PVL_NOTA + dDif, PNR_PRECISAO);

END//




DROP FUNCTION IF EXISTS DIA_FORMATAR_MEDIA//

CREATE FUNCTION `DIA_FORMATAR_MEDIA`(PVL_MEDIA DOUBLE, PSN_TRUNCAR CHAR(1), PVL_DECIMAIS SMALLINT, PVL_DECIMAIS_FORCE SMALLINT, PTP_DECIMAIS_FORCE TINYINT(1))
    RETURNS varchar(10)
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE VL_MEDIA_MAXIMA DOUBLE;
   
   IF ISNULL(PVL_MEDIA) THEN
      RETURN 'NULL';
   END IF;

-- VERIFICAR SE A MEDIA EH SUPERIOR AO MAXIMO PERMITIDO
   SET VL_MEDIA_MAXIMA := GET_PARAMETROS('valor_maximo_medias');

   IF ( (VL_MEDIA_MAXIMA IS NOT NULL) AND (PVL_MEDIA > VL_MEDIA_MAXIMA) )  THEN
   
      SET PVL_MEDIA := VL_MEDIA_MAXIMA;
      
   END IF;
   
   IF PVL_DECIMAIS_FORCE IS NOT NULL THEN

      SET PVL_MEDIA := DIA_ARREDONDA_FORCADO(PVL_MEDIA, PVL_DECIMAIS_FORCE, PTP_DECIMAIS_FORCE);

   END IF;
   -- Implementar o arredondamento forcado
   
   IF PSN_TRUNCAR = 1 THEN
      RETURN TRUNCATE(PVL_MEDIA, PVL_DECIMAIS);
   ELSE
      RETURN ROUND(PVL_MEDIA + 0.0000000001, PVL_DECIMAIS);
   END IF;
   
   
END//



DROP FUNCTION IF EXISTS GET_PARAMETROS//

CREATE FUNCTION `GET_PARAMETROS`(PDS_PARAMETRO VARCHAR(255))
    RETURNS MEDIUMTEXT
    DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN

   DECLARE DS_VALOR_PAR MEDIUMTEXT DEFAULT NULL;
   
   SELECT ds_valor
     FROM parametros
    WHERE ds_variavel = PDS_PARAMETRO
     INTO DS_VALOR_PAR;
     
   RETURN DS_VALOR_PAR;

END//


DROP PROCEDURE IF EXISTS DIA_CALCULO_MEDIA_PERIODO//
CREATE PROCEDURE `DIA_CALCULO_MEDIA_PERIODO`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_TURMA_MATRICULA VARCHAR(60), IN PCD_PESSOA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
sProc:BEGIN
  -- DECLARAR AS VARIAVEIS
  DECLARE PANR_BIMESTRES, PANR_PERIODOS, NR_ETAPAS, NR_PERIODO, NR_ETAPA, NR_ETAPA_PRI, NR_ETAPA_ULT SMALLINT;
  DECLARE PADS_CONDICAO_SITUACAO, PADS_FORMULA_PERIODO TEXT;
  DECLARE VDS_CONDICAO_SITUACAO, VDS_FORMULA_PERIODO TEXT;
  DECLARE PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE SMALLINT;
  
  DECLARE VL_MEDIA DOUBLE;
  DECLARE VCD_DISCIPLINA INTEGER;  

  DECLARE registros INTEGER DEFAULT NULL;
  
  DECLARE selectMedias CURSOR FOR
         SELECT DISCIPLINA, MEDIA
          FROM TMP_MEDIAFIM;

  -- DECLARE que serÃ¡ chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
  DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM TMP_MEDIAFIM;

  -- CRIAR TABELA TEMPORARIA
  
  -- Por padrÃ£o a procedure sempre vai tentar criar  a tabela, se ela jÃ¡ existir vai gerar o erro 42S01, chamando o declare continue handle acima.
  CREATE TEMPORARY TABLE IF NOT EXISTS TMP_MEDIAFIM ( DISCIPLINA INTEGER(11), MEDIA DOUBLE );

  IF PCD_TURMA_MATRICULA IS NULL OR PCD_TURMA_MATRICULA = '' THEN
    SET PCD_TURMA_MATRICULA := PCD_TURMA;
  END IF;

  -- SELECIONAR OS PARAMETROS DE AVALIACAO

  SELECT NR_AVALIACOES
       , NR_PERIODOS
       , DS_CONDICAO_SITUACAO_PERIODO 
       , DS_FORMULA_PERIODO
       , nr_casas_decimais
       , sn_anual_truncar
       , nr_casas_forcado_media
       , tp_ajuste_forcado_media       
  FROM AVALIACOES_PARAMETROS
  INNER JOIN TURMAS ON (TURMAS.CD_AVALIACAO = AVALIACOES_PARAMETROS.CD_AVALIACAO)
  WHERE TURMAS.anosemestre = PNR_ANOSEMESTRE
    AND TURMAS.codigo = PCD_TURMA
   INTO PANR_BIMESTRES
      , PANR_PERIODOS
      , PADS_CONDICAO_SITUACAO
      , PADS_FORMULA_PERIODO
		, PAVL_DECIMAIS
		, PASN_TRUNCAR
		, PAVL_DECIMAIS_FORCE
		, PATP_DECIMAIS_FORCE;
		
  IF PANR_PERIODOS IS NULL OR PANR_PERIODOS <= 0 THEN
     LEAVE sProc;
  END IF;
  
  SET NR_ETAPAS = (PANR_BIMESTRES DIV PANR_PERIODOS);
  SET NR_PERIODO = 1;
  
-- IF(IFNULL(RECUPERACAO1,0) > ROUND(((NOTA1 + NOTA2) / 2)+0.0001,0), ROUND(((ROUND(((NOTA1 + NOTA2) / 2)+0.0001,0) + IFNULL(RECUPERACAO1,0)) / 2)+0.0001, 0), ROUND(((NOTA1 + NOTA2) / 2)+0.0001,0))  
  WHILE NR_PERIODO <= PANR_PERIODOS DO 
  
 
     SET VDS_CONDICAO_SITUACAO := CONCAT('(', lower(PADS_CONDICAO_SITUACAO), ')');
     SET VDS_FORMULA_PERIODO := CONCAT('(', lower(PADS_FORMULA_PERIODO), ')');
     
     -- TROCAR RECUPERACAO POR NOTAX, SENDO QUE X É SEQUENCIAL A PARTIR DO NR_BIMESTRES
     SET VDS_FORMULA_PERIODO := REPLACE(VDS_FORMULA_PERIODO, 'recuperacao', CONCAT('nota', PANR_BIMESTRES + NR_PERIODO));    
     SET VDS_CONDICAO_SITUACAO := REPLACE(VDS_CONDICAO_SITUACAO, 'recuperacao', CONCAT('nota', PANR_BIMESTRES + NR_PERIODO));    
     
     SET VDS_FORMULA_PERIODO := REPLACE(VDS_FORMULA_PERIODO, 'media_periodo', CONCAT('db_media_periodo', NR_PERIODO));    
     SET VDS_CONDICAO_SITUACAO := REPLACE(VDS_CONDICAO_SITUACAO, 'media_periodo', CONCAT('db_media_periodo', NR_PERIODO));    
     
     SET NR_ETAPA_PRI = 1+((NR_PERIODO-1)*(NR_ETAPAS));
     SET NR_ETAPA_ULT = NR_PERIODO*(NR_ETAPAS);
     
     SET NR_ETAPA = 1;
     
     WHILE NR_ETAPA_PRI <= NR_ETAPA_ULT DO 
    
	      SET VDS_FORMULA_PERIODO := REPLACE(VDS_FORMULA_PERIODO, CONCAT('nota', NR_ETAPA ), CONCAT('nota_d', NR_ETAPA_PRI ));       
	      SET VDS_CONDICAO_SITUACAO := REPLACE(VDS_CONDICAO_SITUACAO, CONCAT('nota', NR_ETAPA ), CONCAT('nota_d', NR_ETAPA_PRI ));       
	      
	      SET NR_ETAPA_PRI = NR_ETAPA_PRI + 1;
     
         SET NR_ETAPA = NR_ETAPA + 1; 
     
     END WHILE;
     
     
     -- Executar o calculo da recuperacao
     
     SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
     SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', VDS_FORMULA_PERIODO, ') FROM fichaindividual ');
     SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
     SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  
     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
  
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
        FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

        SET @sSql := CONCAT(' UPDATE fichaindividual SET db_media_periodo', NR_PERIODO, ' = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
        SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
        SET @sSql := CONCAT(@sSql, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

        PREPARE sqlUpdate FROM @sSql;
        EXECUTE sqlUpdate;
        DEALLOCATE PREPARE sqlUpdate;
     
        SET registros := registros - 1;

     END WHILE;

     CLOSE selectMedias;  
	  
     SET @sSql := CONCAT(' UPDATE fichaindividual SET cd_situacao_periodo', NR_PERIODO, ' = ', VDS_CONDICAO_SITUACAO );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
	     
     
	  SET NR_PERIODO = NR_PERIODO + 1;
  
  END WHILE;   

END sProc//

 
DROP PROCEDURE IF EXISTS `DIA_CALCULO_MEDIA_FINAL`//
CREATE PROCEDURE `DIA_CALCULO_MEDIA_FINAL`(IN PNR_ANOSEMESTRE INTEGER(11), IN PCD_TURMA VARCHAR(60), IN PCD_TURMA_MATRICULA VARCHAR(60), IN PCD_PESSOA INTEGER(11), IN CD_LOG_ACESSO INTEGER(11), IN CD_PESSOA_LOGADA INTEGER(11))
    DETERMINISTIC
    SQL SECURITY INVOKER
    COMMENT ''
sProc:BEGIN
  -- DECLARAR AS VARIAVEIS
  DECLARE PANR_BIMESTRES, PANR_PERIODOS SMALLINT;
  DECLARE PASN_NOTAS, PASN_CONCEITOS_PARCIAIS, PASN_CONCEITOS, PASN_EXAME, PASN_2AEPOCA, PASN_TRUNCAR, PASN_FREQ_GLOBAL, PADS_FREQ_TIPO VARCHAR(1);
  DECLARE PADS_FORMULA_ANUAL, PADS_FORMULA_FINAL, PADS_APROVA_DIRETA, PADS_REPROVA_DIRETA, PADS_FORMULA_EXAME, PADS_FORMULA_2EPOCA, PADS_APROVA_EXAME, PADS_APROVA_2AEPOCA TEXT;
  DECLARE PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE, PACD_SITU_APROVA, PACD_SITU_AEXAME, PACD_SITU_A2EPOCA, PANR_MAX_EXAME, PANR_MAX_2AEPOCA, VL_AUX SMALLINT;

  DECLARE VL_MEDIA, VL_FREQUENCIA, VL_MEDIA_GLOBAL DOUBLE;
  DECLARE DS_MEDIA_GLOBAL VARCHAR(100);
  DECLARE VCD_DISCIPLINA, VL_QTD_MENOR10, VL_QTD_MENOR8 INTEGER;
  DECLARE CD_PROFESSOR_LOG INTEGER;
  
  DECLARE menor_npns, maior_npns, media_npns, menor_nps, maior_nps, media_nps, menor_np, maior_np, media_np	VARCHAR(200);
  
  DECLARE NR_OPC, NR_OPC_EXTRA, NR_NORMAL INTEGER;
  DECLARE VL_OPC, VL_OPC_EXTRA, VL_NORMAL DOUBLE;
  
  DECLARE teste INTEGER;

  DECLARE registros INTEGER DEFAULT NULL;
  
  DECLARE selectMedias CURSOR FOR
         SELECT DISCIPLINA, MEDIA
          FROM TMP_MEDIAFIM;

  -- DECLARE que sera chamado quando der erro ao tentar criar o temporary table. Zerando a tabela
  DECLARE CONTINUE HANDLER FOR SQLSTATE '42S01' DELETE FROM TMP_MEDIAFIM;

  -- CRIAR TABELA TEMPORARIA
  
  -- Por padrao a procedure sempre vai tentar criar  a tabela, se ela ja existir vai gerar o erro 42S01, chamando o declare continue handle acima.
  CREATE TEMPORARY TABLE IF NOT EXISTS TMP_MEDIAFIM ( DISCIPLINA INTEGER(11), MEDIA DOUBLE );

  IF PCD_TURMA_MATRICULA IS NULL OR PCD_TURMA_MATRICULA = '' THEN
    SET PCD_TURMA_MATRICULA := PCD_TURMA;
  END IF;

  -- SELECIONAR OS PARAMETROS DE AVALIACAO

  SELECT ap.nr_avaliacoes
       , ap.NR_PERIODOS
       , ap.ds_formula_media_anual
       , ap.ds_formula_media_final
       , ap.sn_notas
       , ap.sn_conceitos_parciais
       , ap.sn_exame
       , ap.sn_segunda_epoca
       , ap.sn_conceitos
       , nr_casas_decimais
       , ap.sn_anual_truncar
       , ap.nr_casas_forcado_media
       , ap.tp_ajuste_forcado_media
       , ap.ds_cond_aprov_direta
       , ap.ds_cond_repro_direta
       , ap.sn_frequencia_global
       , ap.ds_frequencia_tipo
       , COALESCE(cd_situacao_aprov_direta, 0)
       , COALESCE(cd_situacao_aprov_exame, 0)
       , COALESCE(cd_situacao_aprov_2epoca, 0)
       , ap.nr_max_disci_exame
       , ap.nr_max_disci_segunda
       , ap.ds_formula_media_exame
       , ap.ds_formula_media_segunda
       , ap.ds_cond_aprov_exame
       , ap.ds_cond_aprov_segunda
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO PANR_BIMESTRES
      , PANR_PERIODOS
      , PADS_FORMULA_ANUAL
      , PADS_FORMULA_FINAL
      , PASN_NOTAS
      , PASN_CONCEITOS_PARCIAIS
      , PASN_EXAME
      , PASN_2AEPOCA
      , PASN_CONCEITOS
      , PAVL_DECIMAIS
      , PASN_TRUNCAR
      , PAVL_DECIMAIS_FORCE
      , PATP_DECIMAIS_FORCE
      , PADS_APROVA_DIRETA
      , PADS_REPROVA_DIRETA
      , PASN_FREQ_GLOBAL
      , PADS_FREQ_TIPO
      , PACD_SITU_APROVA
      , PACD_SITU_AEXAME
      , PACD_SITU_A2EPOCA
      , PANR_MAX_EXAME
      , PANR_MAX_2AEPOCA
      , PADS_FORMULA_EXAME
      , PADS_FORMULA_2EPOCA
      , PADS_APROVA_EXAME
      , PADS_APROVA_2AEPOCA;

  SET PADS_FORMULA_ANUAL := CONCAT('(', lower(PADS_FORMULA_ANUAL), ')');
  SET PADS_FORMULA_FINAL := CONCAT('(', lower(PADS_FORMULA_FINAL), ')');
  SET PADS_APROVA_DIRETA := CONCAT('(', lower(PADS_APROVA_DIRETA), ')');
  SET PADS_REPROVA_DIRETA := CONCAT('(', lower(PADS_REPROVA_DIRETA), ')');
  SET PADS_FORMULA_EXAME := CONCAT('(', lower(PADS_FORMULA_EXAME), ')');
  SET PADS_FORMULA_2EPOCA := CONCAT('(', lower(PADS_FORMULA_2EPOCA), ')');
  SET PADS_APROVA_EXAME := CONCAT('(', lower(PADS_APROVA_EXAME), ')');
  SET PADS_APROVA_2AEPOCA := CONCAT('(', lower(PADS_APROVA_2AEPOCA), ')');
   
  IF PANR_BIMESTRES IS NULL THEN
     LEAVE sProc;
  END IF;
  
  -- Calcular a Media Global
  
  SELECT AVG(COALESCE(mediafinal, 0) )
    FROM fichaindividual
    WHERE turmamatricula = PCD_TURMA_MATRICULA
      AND anosemestre = PNR_ANOSEMESTRE
      AND codigoaluno = PCD_PESSOA
      AND situacao not in (3,4,5,6,7,8,10)
     INTO VL_MEDIA_GLOBAL;
     
  SET DS_MEDIA_GLOBAL = DIA_FORMATAR_MEDIA(VL_MEDIA_GLOBAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE);
  
  -- Substituir a media global dentro de todas as variaveis se houver
  
  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'media_global', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'media_global', DS_MEDIA_GLOBAL);
  
  -- calcular media global da africa GLOBAL_AFRICA
  -- retirar as disciplinas extras, porem, se ela for a unica opcional, entao contar a extra
  
  SELECT SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 0, 1, 0)) as qtd_opc
       , SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 1, 1, 0)) as qtd_opc_extra
       , SUM(IF(dc.ds_chave <> 'OPCIONAL' AND gd.SN_EXTRA = 0, 1, 0)) as qtd_normal
       , SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 0, COALESCE(mediafinal, 0), 0)) as soma_opc
       , SUM(IF(dc.ds_chave = 'OPCIONAL' AND gd.SN_EXTRA = 1, COALESCE(mediafinal, 0), 0)) as soma_opc_extra
       , SUM(IF(dc.ds_chave <> 'OPCIONAL' AND gd.SN_EXTRA = 0, COALESCE(mediafinal, 0), 0)) as soma_normal
    FROM fichaindividual AS f
	 INNER JOIN turmas as t ON (t.codigo = f.turma and t.anosemestre = f.anosemestre)
	 INNER JOIN grades_disciplinas as gd ON (gd.CD_GRADE = t.cd_grade AND gd.CD_CURSO = t.curso AND gd.CD_DISCIPLINA = f.disciplina AND gd.NR_SERIE = t.serie)
	 INNER JOIN disciplinas_categorias as dc ON (dc.cd_categoria = gd.CD_DISCIPLINA_CATEGORIA)
    WHERE f.turmamatricula = PCD_TURMA_MATRICULA
      AND f.anosemestre = PNR_ANOSEMESTRE
      AND f.codigoaluno = PCD_PESSOA
      AND f.situacao not in (3,4,5,6,7,8,10)
    INTO NR_OPC, NR_OPC_EXTRA, NR_NORMAL, VL_OPC, VL_OPC_EXTRA, VL_NORMAL;
    
  IF (NR_OPC > 0) THEN
      SET VL_MEDIA_GLOBAL = (VL_OPC + VL_NORMAL) / (NR_OPC + NR_NORMAL);
  ELSE
      SET VL_MEDIA_GLOBAL = (VL_OPC_EXTRA + VL_NORMAL) / (NR_OPC_EXTRA + NR_NORMAL);
  END IF;
  
  SET DS_MEDIA_GLOBAL = DIA_FORMATAR_MEDIA(VL_MEDIA_GLOBAL, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE);
  
  -- Substituir a media global DA AFRICA dentro de todas as variaveis se houver

  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'global_africa', DS_MEDIA_GLOBAL);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'global_africa', DS_MEDIA_GLOBAL);

  -- fim da media global da africa = esg
  
  -- Verificar se usa a fÃ³rmula de MEDIA_MENOR_10
  
   SELECT COALESCE(SUM(IF(mediafinal < 10, 1, 0)),0)
        , COALESCE(SUM(IF(mediafinal < 8, 1, 0)), 0)
    FROM fichaindividual
    WHERE turmamatricula = PCD_TURMA_MATRICULA
      AND anosemestre = PNR_ANOSEMESTRE
      AND codigoaluno = PCD_PESSOA
      AND situacao not in (3,4,5,6,7,8,10)
     INTO VL_QTD_MENOR10, VL_QTD_MENOR8;
     
  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'media_menor_10', VL_QTD_MENOR10);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'media_menor_10', VL_QTD_MENOR10);

  SET PADS_FORMULA_ANUAL := REPLACE(PADS_FORMULA_ANUAL, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_FORMULA_FINAL := REPLACE(PADS_FORMULA_FINAL, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_FORMULA_2EPOCA := REPLACE(PADS_FORMULA_2EPOCA, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_APROVA_EXAME := REPLACE(PADS_APROVA_EXAME, 'media_menor_8', VL_QTD_MENOR8);
  SET PADS_APROVA_2AEPOCA := REPLACE(PADS_APROVA_2AEPOCA, 'media_menor_8', VL_QTD_MENOR8);

  -- TEMPORARIO: ARQUIVAR A QUANTIDADE DE AULAS DESTA TURMA 


  CREATE TEMPORARY TABLE IF NOT EXISTS TMP_AULAS AS
  SELECT da.anosemestre, da.turma, da.disciplina, SUM(da.qtd_aulas) as SOMA, COUNT(da.nro_aula) AS QTD, tp.numeroaulas
   FROM diario_aulas as da
  INNER JOIN turmasprofessores tp ON (da.anosemestre = tp.anosemestre AND da.turma = tp.turma and da.disciplina = tp.disciplina)
  WHERE da.turma = PCD_TURMA AND da.anosemestre = PNR_ANOSEMESTRE
  group by da.anosemestre, da.turma, da.disciplina;

  UPDATE turmasprofessores tp
  INNER JOIN TMP_AULAS as tm ON (tp.anosemestre = tm.anosemestre AND tp.turma = tm.turma AND tp.disciplina = tm.disciplina)
    SET tp.numeroaulas = tm.SOMA;

  TRUNCATE TMP_AULAS;

  -- FIM TEMPORARIO



  -- Calcular frequencia do aluno nas disciplinas
  UPDATE fichaindividual
     SET totalfaltas = (IFNULL(Falta1,0)+IFNULL(Falta2,0)+IFNULL(Falta3,0)+IFNULL(Falta4,0)+IFNULL(Falta5,0)+IFNULL(Falta6,0)+IFNULL(Falta7,0)+IFNULL(Falta8,0)+IFNULL(Falta9,0)+IFNULL(Falta10,0))
       , frequencia = 0
   WHERE sn_bloq_freq_global = 0
     AND codigoaluno = PCD_PESSOA
     AND turma = PCD_TURMA
     AND anoSemestre = PNR_ANOSEMESTRE;
     
  IF PADS_FREQ_TIPO = 'C' THEN
     -- calculo da frequencia pela carga horaria
     UPDATE fichaindividual f
      INNER JOIN turmas t ON (f.turma = t.codigo AND f.anosemestre = t.anosemestre)
      INNER JOIN grades_disciplinas g ON (g.cd_grade = t.cd_grade AND g.cd_curso = f.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = t.serie)
        SET f.frequencia = ROUND(100 - (f.totalfaltas / (g.vl_valor) * 100 ),0)
      WHERE f.sn_bloq_freq_global = 0
        AND f.codigoaluno = PCD_PESSOA
        AND f.turma = PCD_TURMA
        AND f.anoSemestre = PNR_ANOSEMESTRE;
        
     -- calcular a frequencia global
     
     SELECT CAST(ROUND((100 - (SUM(IF(f.sn_bloq_freq_global = 0, f.totalfaltas, g.vl_valor - (f.frequencia * g.vl_valor / 100)))/SUM(g.vl_valor) * 100)),2) as CHAR) AS FREQUENCIA
       FROM fichaindividual f
      INNER JOIN turmas t ON (f.turma = t.codigo and f.anosemestre = t.anosemestre) 
      INNER JOIN grades_disciplinas g ON (g.cd_grade = t.cd_grade AND g.cd_curso = f.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = t.serie)
      WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
        AND f.codigoaluno = PCD_PESSOA
        AND f.turmamatricula = PCD_TURMA_MATRICULA
        AND f.anoSemestre = PNR_ANOSEMESTRE
     INTO VL_FREQUENCIA;
     
     UPDATE matriculas
        SET frequencia_global = VL_FREQUENCIA
      WHERE anosemestre = PNR_ANOSEMESTRE
        AND codigoaluno = PCD_PESSOA
        AND turma = PCD_TURMA_MATRICULA;
        
  ELSE
     -- calculo da frequencia pelas aulas dadas
     
     UPDATE fichaindividual f
      INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and f.disciplina = t.disciplina)
        SET f.frequencia = ROUND(100 - (f.totalfaltas / (t.numeroaulas) * 100 ),0)
      WHERE f.sn_bloq_freq_global = 0
        AND f.codigoaluno = PCD_PESSOA
        AND f.turma = PCD_TURMA
        AND f.anoSemestre = PNR_ANOSEMESTRE;
        
     -- calcular a frequencia global

     SELECT CAST(ROUND((100 - (SUM(IF(f.sn_bloq_freq_global = 0, f.totalfaltas, t.numeroaulas - (f.frequencia * t.numeroaulas / 100)))/SUM(t.numeroaulas) * 100)),2) as CHAR) AS FREQUENCIA
       FROM fichaindividual f
      INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and  f.curso = t.curso and f.disciplina = t.disciplina and t.cd_categoria = 1 )
      WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
        AND f.codigoaluno = PCD_PESSOA
        AND f.turmamatricula = PCD_TURMA_MATRICULA
        AND f.anoSemestre = PNR_ANOSEMESTRE
     INTO VL_FREQUENCIA;

     UPDATE matriculas
        SET frequencia_global = VL_FREQUENCIA
      WHERE anosemestre = PNR_ANOSEMESTRE
        AND codigoaluno = PCD_PESSOA
        AND turma = PCD_TURMA_MATRICULA;

  
  END IF;

  SET VL_FREQUENCIA = NULL;

  -- fim do calculo da frequencia 


  IF COALESCE(PADS_FORMULA_ANUAL, '') = '' AND (PASN_NOTAS = 'S') THEN
     LEAVE sProc;
  END IF;
  
  -- COLOCAR AS DISCIPLINAS NA SITUACAO CURSANDO INICIALMENTE
  
  UPDATE fichaindividual
     SET situacao = 1
   WHERE anosemestre = PNR_ANOSEMESTRE
     AND Aproveitamento <> 'S'
     AND turma = PCD_TURMA
     AND turmamatricula = PCD_TURMA_MATRICULA
     AND codigoaluno = PCD_PESSOA
     AND situacao not in (3, 4, 5, 6, 7, 8, 10) ;
     
  -- IMPLEMENTAR RECUPERACAO SEMESTRAL **************************

  IF (PANR_PERIODOS > 1) THEN  
     CALL DIA_CALCULO_MEDIA_PERIODO(PNR_ANOSEMESTRE, PCD_TURMA, PCD_TURMA_MATRICULA, PCD_PESSOA);
  END IF;
  
  -- IMPLEMENTAR CALCULO DE MEDIA PERIODICA
  
  IF PASN_NOTAS = 'S' OR PASN_CONCEITOS_PARCIAIS = 'S' THEN
     -- TEM NOTAS -
     
     -- CALCULAR A MEDIA ANUAL
     
     IF INSTR(PADS_FORMULA_ANUAL, 'mediainstitucional') <= 0 THEN
     
        SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
        SET @sSql := CONCAT(@sSql, ' SELECT f.disciplina, (', PADS_FORMULA_ANUAL, ') FROM fichaindividual f');
        SET @sSql := CONCAT(@sSql, ' INNER JOIN turmas as t ON (t.codigo = f.turma and t.anosemestre = f.anosemestre) ');
        SET @sSql := CONCAT(@sSql, ' INNER JOIN grades_disciplinas as gc ON (gc.CD_GRADE = t.cd_grade AND gc.CD_CURSO = t.curso AND gc.CD_DISCIPLINA = f.disciplina AND gc.NR_SERIE = t.serie) ');
        SET @sSql := CONCAT(@sSql, ' WHERE f.anosemestre = ', PNR_ANOSEMESTRE, ' AND f.Aproveitamento <> "S" AND f.turma = "', PCD_TURMA,'"');
        SET @sSql := CONCAT(@sSql, ' AND f.codigoaluno = ', PCD_PESSOA );
		          
        PREPARE sqlUpdate FROM @sSql;
        EXECUTE sqlUpdate;
        DEALLOCATE PREPARE sqlUpdate;
        
     ELSE
        -- IMPLEMENTAR MEDIA COM PI
        SELECT 1 INTO teste;
     
     END IF;
     
     -- SELECIONAR A MEDIA ANUAL DO TEMPORARIO
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;
         
         SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = IF(ISNULL(media_ajustada), ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE), ', media_ajustada)' );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;

         SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;
     
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS - 1
     
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -1, mediafinal = -1, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ');
     
     SET registros := 1;
     
     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-1');
        SET registros = registros + 1;
     END WHILE;
     

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     -- ATUALIZAR AS DISCIPLINAS DISPENSADAS -2
     
     SET @sSql := CONCAT('UPDATE fichaindividual SET mediaanual = -2, mediafinal = -2, situacao = 0, frequencia = NULL ');
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ');

     SET registros := 1;

     WHILE (registros <= PANR_BIMESTRES) DO
        SET @sSql := CONCAT(@sSql, ' AND nota', registros, '=-2');
        SET registros = registros + 1;
     END WHILE;

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     

     -- CALCULO DA MEDIA FINAL ANTES DO EXAME
     
     TRUNCATE TMP_MEDIAFIM;
     
     SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
     SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_FINAL, ') FROM fichaindividual ');
     SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'" ');
     SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     OPEN selectMedias;

     SELECT FOUND_ROWS() INTO registros;

     WHILE registros > 0 DO
         FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

         SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
         SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S";' );

         PREPARE sqlUpdate FROM @sSql;
         EXECUTE sqlUpdate;
         DEALLOCATE PREPARE sqlUpdate;
		 
		/**
		 * GRAVA LOG DE ACESSO / ALTERACAO DE MEDIA NO DIARIO DE CLASSE
		 */
		IF CD_PESSOA_LOGADA IS NOT NULL THEN
			 SELECT professor FROM turmasprofessores WHERE anosemestre = PNR_ANOSEMESTRE AND turma = PCD_TURMA AND disciplina = VCD_DISCIPLINA LIMIT 1 INTO CD_PROFESSOR_LOG;

			 -- GRAVA LOG DE ACESSO AO DIARIO
			 IF CD_LOG_ACESSO = NULL THEN
				   INSERT INTO diario_logs (cd_pessoa, cd_acao, cd_atividade, dt_log, descricao, cd_professor) VALUES (CD_PESSOA_LOGADA, 0, 0, now(), 'Diario de Classes', CD_PROFESSOR_LOG);
				   SELECT LAST_INSERT_ID() INTO CD_LOG_ACESSO;
			 END IF;

			INSERT INTO diario_logs (cd_pessoa,     cd_acao, cd_atividade, dt_log, descricao,                                                                                                                                                                                                                                                                                                 cd_log_pai,     cd_professor)
  						 VALUES (CD_PESSOA_LOGADA,  1,       3,            NOW(),  CONCAT('Geracao de Media Final, Aluno: ',PCD_PESSOA,', Turma: ',PCD_TURMA,', Disciplina: ',VCD_DISCIPLINA,', Anosemestre: ',PNR_ANOSEMESTRE,', Media final: ',DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE),', Formula final: ',PADS_FORMULA_FINAL), CD_LOG_ACESSO,  IFNULL(CD_PROFESSOR_LOG,0));
		END IF;

        SET registros := registros - 1;
         
     END WHILE;

     CLOSE selectMedias;


  END IF; -- FIM SN_NOTAS
  
  -- CONVERTER NOTAS EM CONCEITO
  
  IF ((PASN_NOTAS = 'S') AND (PASN_CONCEITOS = 'S')) OR ((PASN_CONCEITOS_PARCIAIS = 'S') AND (PASN_NOTAS = 'N')) THEN
  
     UPDATE fichaindividual fi
      INNER JOIN turmas AS t ON (fi.turma = t.codigo AND fi.anosemestre = t.anosemestre)
       LEFT JOIN avaliacoes_conceitos AS ac ON (ac.cd_avaliacao = t.cd_avaliacao)
             AND ac.nr_inicial <= fi.mediaFinal
             AND ac.nr_final >= fi.mediaFinal
        SET ds_media = ac.ds_conceito
      WHERE fi.aproveitamento <> "S"
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10)
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.turma = PCD_TURMA;
  
  END IF;
  
  
  IF PASN_FREQ_GLOBAL = 'S' THEN
    IF PADS_FREQ_TIPO = 'C' THEN
       --  Pegar a Frequencia pela Carga Horaria
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN

          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(g.vl_valor) * 100)),2)
            FROM fichaindividual as f INNER JOIN turmas t ON (f.turma = t.codigo and f.anosemestre = t.anosemestre)
           INNER JOIN grades_disciplinas as g ON (g.cd_grade = t.cd_grade AND g.cd_curso = t.curso AND g.cd_disciplina = f.disciplina AND g.nr_serie = t.serie)
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;
            
           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           
       END IF;
    ELSE
       -- Pegar a Frequencia pelas Aulas Dadas
       
       IF (INSTR(PADS_APROVA_DIRETA, 'frequencia') > 0) OR (INSTR(PADS_REPROVA_DIRETA, 'frequencia') > 0) THEN
       
          SELECT ROUND((100 - (Sum(f.totalfaltas)/Sum(t.numeroaulas) * 100)),2)
            FROM fichaindividual f
           INNER JOIN turmasprofessores t ON (f.turma = t.turma and f.anosemestre = t.anosemestre and  f.curso = t.curso and f.disciplina = t.disciplina and t.cd_categoria = 1 )
           WHERE (f.mediafinal is null OR (f.mediafinal <> -1 and f.mediafinal <> -2))
             AND f.codigoaluno = PCD_PESSOA
             AND f.turma = PCD_TURMA
             AND f.anosemestre = PNR_ANOSEMESTRE
            INTO VL_FREQUENCIA;

           SET PADS_APROVA_DIRETA := REPLACE(PADS_APROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           SET PADS_REPROVA_DIRETA := REPLACE(PADS_REPROVA_DIRETA, 'frequencia', REPLACE(VL_FREQUENCIA, ',', '.'));
           

       END IF;
    END IF;
  END IF;
  
  -- tratar as variaveis
  
SELECT CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmenor_npns, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmenor_npns
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmaior_npns, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmaior_npns
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmedia_npns, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmedia_npns
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmenor_nps, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmenor_nps
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmaior_nps, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmaior_nps
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmedia_nps, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmedia_nps
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmenor_np, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmenor_np
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmaior_np, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmaior_np
       , CONCAT(GROUP_CONCAT(CONCAT('IF(disciplina=', disciplina, ', ', REPLACE(xmedia_np, ',', '.'))), ',0', LPAD('', count(disciplina), ')')) as xmedia_np
  FROM (
   SELECT dp.disciplina
        , COALESCE(MIN(IF(dp.sn_compoe=0, DPA.vl_nota, 0)),0) as xmenor_npns
        , COALESCE(MAX(IF(dp.sn_compoe=0, DPA.vl_nota, 0)),0) as xmaior_npns
        , COALESCE(AVG(IF(dp.sn_compoe=0, DPA.vl_nota, 0)),0) as xmedia_npns
        , COALESCE(MIN(IF(dp.sn_compoe=1, DPA.vl_nota, 0)),0) as xmenor_nps
        , COALESCE(MAX(IF(dp.sn_compoe=1, DPA.vl_nota, 0)),0) as xmaior_nps
        , COALESCE(AVG(IF(dp.sn_compoe=1, DPA.vl_nota, 0)),0) as xmedia_nps
        , COALESCE(MIN(DPA.vl_nota),0) as xmenor_np
        , COALESCE(MAX(DPA.vl_nota),0) as xmaior_np
        , COALESCE(AVG(DPA.vl_nota),0) as xmedia_np	
    FROM diario_provas as dp
   INNER JOIN DIARIO_PROVAS_ALUNOS DPA ON (DP.ANOSEMESTRE = DPA.NR_ANOSEM AND DP.BIMESTRE = DPA.CD_BIMESTRE
     AND DP.TURMA = DPA.CD_TURMA AND DP.DISCIPLINA = DPA.CD_DISCIPLINA AND DP.NRO_NOTA = DPA.NR_PROVA AND DPA.CD_PESSOA = PCD_PESSOA)
   WHERE dp.turma = PCD_TURMA_MATRICULA AND anosemestre = PNR_ANOSEMESTRE
   GROUP BY dp.disciplina
  ) as a
  INTO menor_npns, maior_npns, media_npns, menor_nps, maior_nps, media_nps, menor_np, maior_np, media_np;

  # TRATAR AS CONDICOES QUANDO USA AS NOTAS PARCIAIS
  
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'menor_npns', menor_npns);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_npns', maior_npns);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_npns', maior_npns);
  
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'menor_nps', menor_nps);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_nps', maior_nps);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'media_nps', media_nps);
  
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'menor_np', menor_np);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'maior_np', maior_np);
  SET PADS_REPROVA_DIRETA = REPLACE(PADS_REPROVA_DIRETA, 'media_np', media_np);

  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'menor_npns', menor_npns);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_npns', maior_npns);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_npns', maior_npns);

  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'menor_nps', menor_nps);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_nps', maior_nps);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'media_nps', media_nps);

  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'menor_np', menor_np );
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'maior_np', maior_np);
  SET PADS_APROVA_DIRETA = REPLACE(PADS_APROVA_DIRETA, 'media_np', media_np);
  
  -- VERIFICAR REPROVACAO DIRETA
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = 9 ');
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_REPROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 10) ');

  IF PASN_NOTAS = 'S' THEN

     SET @sSql := CONCAT(@sSql, ' AND ( mediafinal is not null ) AND (mediafinal >=0) ' );

  END IF;
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  
  -- VERIFICAR APROVACAO DIRETA
  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_APROVA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_DIRETA, ' AND situacao not in (3, 4, 5, 6, 7, 8, 9, 10) ');

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  -- Se naoo possuem avaliacao por nota, termina por aqui
  IF PASN_NOTAS = 'N' THEN
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
     LEAVE sProc;
  END IF;
  
  -- TENTAR PASSAR O ESTUDANTE COM O PESO PARA ARREDONDAMENTO
  
  -- *** FALTA IMPLEMENTAR ****
  
  IF PASN_EXAME = 'N' THEN
  
     -- Se nao tem exame entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao not in (SELECT cd_situacao FROM situacao WHERE cd_situacao_pai IN(0, 1, 9))
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
        
     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM EXAME
  
  UPDATE fichaindividual fi
     SET fi.situacao = 2
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao <> 9
     AND fi.situacao NOT IN(SELECT cd_situacao FROM situacao WHERE cd_situacao_pai = 0) and fi.mediafinal is not null
     AND ( fi.mediafinal >=0)
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

  IF (PANR_MAX_EXAME > 0) AND (PANR_MAX_EXAME < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em exame - Verificar se o aluno ultrapassou
     
     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2
       INTO VL_AUX;
        
     IF VL_AUX > PANR_MAX_EXAME THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 2;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
           
        LEAVE sProc;
         
     END IF;

  END IF;
  
  -- CALCULAR MEDIA DE EXAME
  

  SET PADS_FORMULA_EXAME := REPLACE(PADS_FORMULA_EXAME, 'notaexame', 'IF(IFNULL(sn_faltou_exame,0) = 1, 0, notaexame)');
  
  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_EXAME, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'" ');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) AND (notaexame is not null OR IFNULL(sn_faltou_exame,0) = 1) ');
  
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao in (2,9) and (notaexame is not null OR IFNULL(sn_faltou_exame,0) = 1) ');

     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;
     
     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  -- TENTAR APROVAR O ALUNO PELO EXAME
  
  # IMPLEMENTAR USO DA TABELA DAS NOTAS PARCIAIS

  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'menor_npns', menor_npns);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_npns', maior_npns);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_npns', maior_npns);

  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'menor_nps', menor_nps);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_nps', maior_nps);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'media_nps', media_nps);

  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'menor_np', menor_np);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'maior_np', maior_np);
  SET PADS_APROVA_EXAME = REPLACE(PADS_APROVA_EXAME, 'media_np', media_np);

  
  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_AEXAME);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_EXAME, ' AND situacao = 2 and (notaexame is not null OR IFNULL(sn_faltou_exame,0) = 1) ');
  

  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- TENTAR PASSAR O CARA PELO ARREDONDAMENTO APOS O EXAME
  
  -- FALTA IMPLEMENTAR ***********************
  
  IF PASN_2AEPOCA = 'N' THEN

     -- Se nao tem segunda epoca entao reprovar o cara

     UPDATE fichaindividual fi
        SET fi.situacao = 9
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 2 and (fi.notaexame is not null OR IFNULL(fi.sn_faltou_exame,0) = 1 )
        AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);

     -- CHAMAR A FUNCAO DE CALCULO DE MEDIA DO CURSO

     -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
     
     CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

     LEAVE sProc;

  END IF;
  
  -- COLOCAR AS DISCIPLINAS EM SEGUNDA EPOCA

  UPDATE fichaindividual fi
   INNER JOIN turmas t ON (t.curso = fi.curso AND t.codigo = fi.turma AND t.anosemestre = fi.anosemestre)
   INNER JOIN avaliacoes_parametros ap ON (ap.cd_avaliacao = t.cd_avaliacao AND ap.cd_coligada = t.cd_coligada)
     SET fi.situacao = 11
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 2
     AND (fi.mediafinal >=0)
     AND ( ( ap.sn_falta_exame_forca_2epoca = 1 AND (IFNULL(fi.sn_faltou_exame,0) = 1 OR fi.notaexame IS NOT NULL) )
         OR (fi.notaexame is not null) );

  IF (PANR_MAX_2AEPOCA > 0) AND (PANR_MAX_2AEPOCA < 99) THEN
     -- Existe limitacao de quantidade de disciplinas em segunda epoca - Verificar se o aluno ultrapassou

     SELECT count(*) QTD
       FROM fichaindividual fi
      WHERE fi.anosemestre = PNR_ANOSEMESTRE
        AND fi.Aproveitamento <> 'S'
        AND fi.turma = PCD_TURMA
        AND fi.codigoaluno = PCD_PESSOA
        AND fi.situacao = 11
       INTO VL_AUX;

     IF VL_AUX > PANR_MAX_2AEPOCA THEN
        -- ULTRAPASSOU a quantidade maxima - REPROVA O ALUNO

        UPDATE fichaindividual fi
           SET fi.situacao = 9
         WHERE fi.anosemestre = PNR_ANOSEMESTRE
           AND fi.Aproveitamento <> 'S'
           AND fi.turma = PCD_TURMA
           AND fi.codigoaluno = PCD_PESSOA
           AND fi.situacao = 11;
           
        CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);

        LEAVE sProc;
        
     ELSE
         -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
         -- IMPLEMENTAR **********************
         -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
         SELECT 1 INTO teste;

     END IF;
     
  ELSE
     -- GERAR A TAXA DO EXAME DE RECORRENCIA - AFRICA
     -- IMPLEMENTAR **********************
     -- GeraTaxaExameRecorrencia(lngCodigoAluno, intAnoSemestre, strTurma);
     SELECT 1 INTO teste;

  END IF;
  
  
  -- CALCULAR MEDIA DE SEGUNDA EPOCA

  SET @sSql := CONCAT(' INSERT INTO TMP_MEDIAFIM (DISCIPLINA, MEDIA)');
  SET @sSql := CONCAT(@sSql, ' SELECT disciplina, (', PADS_FORMULA_2EPOCA, ') FROM fichaindividual ');
  SET @sSql := CONCAT(@sSql, ' WHERE anosemestre = ', PNR_ANOSEMESTRE, ' AND Aproveitamento <> "S" AND turma = "', PCD_TURMA,'"');
  SET @sSql := CONCAT(@sSql, ' AND codigoaluno = ', PCD_PESSOA );
  SET @sSql := CONCAT(@sSql, ' AND situacao = 11 and segunda_epoca is not null ');
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;

  OPEN selectMedias;

  SELECT FOUND_ROWS() INTO registros;

  WHILE registros > 0 DO
     FETCH selectMedias INTO VCD_DISCIPLINA, VL_MEDIA;

     SET @sSql := CONCAT(' UPDATE fichaindividual SET mediafinal = ', DIA_FORMATAR_MEDIA(VL_MEDIA, PASN_TRUNCAR, PAVL_DECIMAIS, PAVL_DECIMAIS_FORCE, PATP_DECIMAIS_FORCE) );
     SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND disciplina="', VCD_DISCIPLINA, '" AND Aproveitamento <> "S" ' );
     SET @sSql := CONCAT(@sSql, ' AND situacao = 11 and segunda_epoca is not null  ');
     
     PREPARE sqlUpdate FROM @sSql;
     EXECUTE sqlUpdate;
     DEALLOCATE PREPARE sqlUpdate;

     SET registros := registros - 1;

  END WHILE;

  CLOSE selectMedias;
  
  
  -- TENTAR APROVAR O ALUNO PELO SEGUNDA EPOCA
  
# IMPLEMENTAR USO DA TABELA DAS NOTAS PARCIAIS

  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'menor_npns', menor_npns);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_npns', maior_npns);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_npns', maior_npns);

  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'menor_nps', menor_nps);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_nps', maior_nps);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'media_nps', media_nps);

  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'menor_np', menor_np);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'maior_np', maior_np);
  SET PADS_APROVA_2AEPOCA = REPLACE(PADS_APROVA_2AEPOCA, 'media_np', media_np);

  SET @sSql := CONCAT(' UPDATE fichaindividual SET situacao = ', PACD_SITU_A2EPOCA);
  SET @sSql := CONCAT(@sSql, ' WHERE codigoaluno="', PCD_PESSOA, '" AND anosemestre="', PNR_ANOSEMESTRE, '" AND turma="', PCD_TURMA, '" AND Aproveitamento <> "S" ' );
  SET @sSql := CONCAT(@sSql, ' AND ', PADS_APROVA_2AEPOCA, ' AND situacao = 11 and segunda_epoca is not null ');
  
  PREPARE sqlUpdate FROM @sSql;
  EXECUTE sqlUpdate;
  DEALLOCATE PREPARE sqlUpdate;
  
  -- IMPLEMENTAR
  -- TENTAR PASSAR PELO PELO DO ARREDONDAMENTO APOS EXAME
  
  
  -- REPROVAR AS DISCIPLINAS QUE FICARAM EM SEGUNDA EPOCA
  
  
  UPDATE fichaindividual fi
     SET fi.situacao = 9
   WHERE fi.anosemestre = PNR_ANOSEMESTRE
     AND fi.Aproveitamento <> 'S'
     AND fi.turma = PCD_TURMA
     AND fi.codigoaluno = PCD_PESSOA
     AND fi.situacao = 11 and segunda_epoca is not null
     AND fi.situacao not in (3, 4, 5, 6, 7, 8, 10);
     

 -- IMPLEMENTAR - CALCULO MÃƒâ€°DIA DO CURSO
 
 -- CalcularMediaCurso(lngCodigoAluno, strTurma, intAnoSemestre, tblAvaliacao);
 
 CALL DIA_SITUACAO_FINAL(PCD_PESSOA, PCD_TURMA, PNR_ANOSEMESTRE);
  

END sProc//




DROP PROCEDURE IF EXISTS DIA_SITUACAO_FINAL//

CREATE PROCEDURE `DIA_SITUACAO_FINAL`(IN PCD_PESSOA INTEGER(11), IN PCD_TURMA VARCHAR(15), IN PNR_ANOSEMESTRE INTEGER(11))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 DECLARE CD_SITU_CONCLUIDA, CD_SITUACAO, NR_QTD INTEGER(11) DEFAULT NULL ;
    
 -- SELECIONAR DO PARAMETRO DE AVALIACAO A SITUACAO DE CONCLUSAO (CASO EXISTA)
 SELECT ap.cd_situacao_concluida
   FROM avaliacoes_parametros ap
  INNER JOIN turmas t ON ( ap.cd_avaliacao = t.cd_avaliacao )
  WHERE t.anosemestre = PNR_ANOSEMESTRE
    AND t.codigo = PCD_TURMA
   INTO CD_SITU_CONCLUIDA;


   IF CD_SITU_CONCLUIDA IS NOT NULL THEN
      --  EXISTE A SITUACAO DE CONCLUSAO NESTE CASO... 
      --  DEVE SER VERIFICADO SE O ALUNO CONCLUIU TODAS AS DISCIPLINAS
      
      SELECT COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
         and s.cd_situacao_pai in (1,2,11)
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO NR_QTD;
        
      IF NR_QTD >= 1 THEN
         -- NESTE CASO, O ALUNO CONTINUARA COM A SITUACAO ATIVA (CURSANDO)
         -- POIS EXISTE AINDA ALGUMA SITUACAO PENDENTE.
         
         SET CD_SITUACAO = 1;
      ELSE
         -- SE NÃO TEM NENHUMA SITUACAO PENDENTE, ENTÃO COLOCAR COMO CONCLUIDA
         
         SET CD_SITUACAO = CD_SITU_CONCLUIDA;
      END IF;
   ELSE
      -- SELECIONAR AS DISCIPLINAS DO ALUNO NA TURMA COM A QUANTIDADE EM CADA SITUACAO

      SELECT s.cd_situacao_pai, COUNT(*)
        FROM FICHAINDIVIDUAL AS f
       INNER JOIN situacao AS s ON (f.situacao = s.cd_situacao AND s.nr_ordem_final is not null)
       WHERE f.codigoaluno = PCD_PESSOA
         AND f.turmamatricula = PCD_TURMA
         AND f.anosemestre = PNR_ANOSEMESTRE
       GROUP BY s.cd_situacao_pai
       ORDER BY s.nr_ordem_final LIMIT 1
        INTO CD_SITUACAO, NR_QTD;

   END IF;
   
   IF CD_SITUACAO IS NOT NULL THEN
   
      UPDATE MATRICULAS
         SET situacao = CD_SITUACAO
       WHERE situacao <> 10
         AND codigoaluno = PCD_PESSOA
         AND turma = PCD_TURMA
         AND anosemestre = PNR_ANOSEMESTRE;
         
   END IF;

END//]]></atualiza><atualiza codigo="{E5AB105A-37EF-4C7C-832C-B6A9D6469084}" protocolo="mysql-5"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{E5AB105A-37EF-4C7C-832C-B6A9D6469084}" protocolo="oracle"><![CDATA[ALTER TABLE FIN_COBRANCA
