	'Definir os campos que deverão ser apresentados na Planilha de Atendimentos da Ficha de Saúde', 2, 0
);]]></atualiza><atualiza codigo="{70C89460-CDE4-4062-8B5A-E64343C90AFA}" protocolo="oracle"><![CDATA[INSERT INTO parametros (
