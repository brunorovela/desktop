# Vinculo da permissão "Pessoas > Ficha de Saúde > Registro de Prontuário" ao grupo Administradores
INSERT INTO nu_grupos_permissoes(cd_permissao, cd_grupo, cd_acao, nr_permissao)
VALUES (NULL, 1, (SELECT cd_acao FROM nu_modulos_acoes WHERE ds_chave =
 'FichaSaude.Prontuario' and cd_modulo =(SELECT cd_modulo FROM nu_modulos WHERE
 ds_chave = 'Academico')), 31);

# Alteração da tabela para InnoDB
ALTER TABLE pessoas_campos_adicionais ENGINE=InnoDB;

# Criação da Tabela de Atendimentos
DROP TABLE IF EXISTS pessoas_atendimentos;
CREATE TABLE pessoas_atendimentos (
	cd_atendimento INT(11) AUTO_INCREMENT,
	cd_pessoa INT(11) NOT NULL,
	dt_atendimento DATETIME NOT NULL,
	sn_acompanhado SMALLINT(1) NOT NULL,
	nm_acompanhante VARCHAR(255) NULL,
	sn_medicado_casa SMALLINT(1) NOT NULL,
	ds_medicamento_casa VARCHAR(255) NULL,
	ds_pressao_arterial VARCHAR(20) NULL,
	ds_temperatura VARCHAR(10) NULL,
	vl_peso DOUBLE NULL,
	sn_comunicado_telefone SMALLINT(1) NOT NULL,
	sn_comunicado_agenda SMALLINT(1) NOT NULL,
	sn_comunicado_email SMALLINT(1) NOT NULL,
	sn_comunicado_ocorrencia SMALLINT(1) NOT NULL,
	ds_comunicado_outros VARCHAR(255) NULL,
	cd_retorno SMALLINT(1) NOT NULL,
	ds_retorno_quem VARCHAR(255) NULL,
	ds_procedimento_adotado VARCHAR(255) NULL,
	PRIMARY KEY ( cd_atendimento ),
	FOREIGN KEY (cd_pessoa) REFERENCES pessoas (cd_pessoa)
) ENGINE=InnoDB;

# Criação da Tabela de Necessidades Especiais completa
DROP TABLE IF EXISTS pessoas_deficiencias_completo;
CREATE TABLE pessoas_deficiencias_completo (
	cd_pessoa_deficiencia INT(11) NOT NULL AUTO_INCREMENT,
	cd_pessoa INT(11) NOT NULL,
	cd_campo SMALLINT(6) UNSIGNED NOT NULL,
	me_valor MEDIUMTEXT NULL,
	PRIMARY KEY (cd_pessoa_deficiencia),
	UNIQUE KEY pessoa_defc_comp_pessoa_campo ( cd_pessoa, cd_campo ),
	FOREIGN KEY (cd_pessoa) REFERENCES pessoas (cd_pessoa),
	FOREIGN KEY (cd_campo) REFERENCES pessoas_campos_adicionais (cd_campo)
) ENGINE=InnoDB;


# planilha_ficha_saude_atendimentos_campos, salva os campos que serão mostrados para o usuário
