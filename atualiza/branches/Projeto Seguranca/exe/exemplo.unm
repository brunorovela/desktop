se NULL end) AS `MEDIA`,(case when (`dpt`.`bimestre` = 1) then `fi`.`falta1` when (`dpt`.`bimestre` = 2) then `fi`.`falta2` when (`dpt`.`bimestre` = 3) then `fi`.`falta3` when (`dpt`.`bimestre` = 4) then `fi`.`falta4` when (`dpt`.`bimestre` = 5) then `fi`.`falta5` when (`dpt`.`bimestre` = 6) then `fi`.`falta6` when (`dpt`.`bimestre` = 7) then `fi`.`falta7` when (`dpt`.`bimestre` = 8) then `fi`.`falta8` when (`dpt`.`bimestre` = 9) then `fi`.`falta9` when (`dpt`.`bimestre` = 10) then `fi`.`falta10` else NULL end) AS `FALTAS`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,1) AS `FREQ1`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,2) AS `FREQ2`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,3) AS `FREQ3`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,4) AS `FREQ4`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,5) AS `FREQ5`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,6) AS `FREQ6`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,7) AS `FREQ7`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,8) AS `FREQ8`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,9) AS `FREQ9`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,10) AS `FREQ10`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosemestre`,`fi`.`turma`,`fi`.`disciplina`,`dpt`.`bimestre`,11) AS `FREQ11`,`unimestre_ibes`.`GET_FREQ`(`fi`.`codigoaluno`,`fi`.`anosem