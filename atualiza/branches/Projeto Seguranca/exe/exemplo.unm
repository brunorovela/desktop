SET GLOBAL log_bin_trust_function_creators=1//

DROP FUNCTION IF EXISTS `FCD_GET_ANOSEMESTRE_CORRENTE`//

CREATE FUNCTION `FCD_GET_ANOSEMESTRE_CORRENTE`(`CodigoColigada` SMALLINT) RETURNS int(11)
BEGIN
     DECLARE anoSemestreAtual INTEGER DEFAULT NULL;
     DECLARE anoSemestreBloq INTEGER DEFAULT NULL;
     DECLARE anoSemestreInc INTEGER DEFAULT NULL;
     DECLARE ano INTEGER DEFAULT NULL;
     DECLARE mes INTEGER DEFAULT NULL;

     IF CodigoColigada IS NULL THEN
        SET CodigoColigada := 0;
     END IF;

     SELECT
        CAST(DS_VALOR AS SIGNED)
     FROM
        PARAMETROS
     WHERE
        DS_VARIAVEL LIKE 'ano_semestre_incremento' AND
        CD_COLIGADA = CodigoColigada
     INTO
        anoSemestreInc;

     IF anoSemestreInc IS NULL THEN
        SELECT
           DS_VALOR
        FROM
           PARAMETROS
        WHERE
           DS_VARIAVEL LIKE 'ano_semestre_incremento' AND
           CD_COLIGADA = 0
        INTO
           anoSemestreInc;
     END IF;

     SET ano := YEAR(NOW());
     SET mes := MONTH(NOW());

     SELECT
        CAST(P.DS_VALOR AS SIGNED)
     FROM
        NU_MODULOS M
           JOIN NU_PARAMETROS P ON
              (M.CD_MODULO = P.CD_MODULO)
     WHERE
        P.DS_PARAMETRO LIKE 'online.anosemestre.atual' AND
        M.DS_CHAVE LIKE 'UniMestre' AND
        P.CD_COLIGADA = CodigoColigada
     INTO
        anoSemestreAtual;

     IF (anoSemestreAtual IS NULL) AND (CodigoColigada <> 0) THEN
        SELECT
           CAST(P.DS_VALOR AS SIGNED)
        FROM
           NU_MODULOS M
              JOIN NU_PARAMETROS P ON
                 (M.CD_MODULO = P.CD_MODULO)
        WHERE
           P.DS_PARAMETRO LIKE 'online.anosemestre.atual' AND
           M.DS_CHAVE LIKE 'UniMestre' AND
           P.CD_COLIGADA = 0
        INTO
           anoSemestreAtual;
     END IF;

     SELECT
        CAST(P.DS_VALOR AS SIGNED)
     FROM
        NU_MODULOS M
           JOIN NU_PARAMETROS P ON
              (M.CD_MODULO = P.CD_MODULO)
     WHERE
        P.DS_PARAMETRO LIKE 'online.anosemestre.bloqueio' AND
        M.DS_CHAVE LIKE 'UniMestre' AND
        P.CD_COLIGADA = CodigoColigada
     INTO
        anoSemestreBloq;

     IF (anoSemestreBloq IS NULL) AND (CodigoColigada <> 0) THEN
        SELECT
           CAST(P.DS_VALOR AS SIGNED)
        FROM
           NU_MODULOS M
              JOIN NU_PARAMETROS P ON
                 (M.CD_MODULO = P.CD_MODULO)
        WHERE
           P.DS_PARAMETRO LIKE 'online.anosemestre.bloqueio' AND
           M.DS_CHAVE LIKE 'UniMestre' AND
           P.CD_COLIGADA = 0
        INTO
           anoSemestreBloq;
     END IF;

     IF anoSemestreAtual IS NULL THEN
        IF (mes > 6) AND (anoSemestreInc = 1) THEN
           SET anoSemestreAtual := CAST(CONCAT(ano, '2') AS SIGNED);
        ELSE
           SET anoSemestreAtual := CAST(CONCAT(ano, '1') AS SIGNED);
        END IF;
     END IF;

     IF anoSemestreBloq IS NULL THEN
        SET anoSemestreBloq := anoSemestreAtual;
     END IF;

     IF anoSemestreBloq < anoSemestreAtual THEN
        RETURN anoSemestreBloq;
     ELSE
        RETURN anoSemestreAtual;
     END IF;

     RETURN NULL;
  END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_ESTUDANTES`//

CREATE FUNCTION `FCD_GRUPO_ESTUDANTES`(`pessoa` INTEGER,`coligada` INTEGER) RETURNS tinyint(1)
BEGIN
 
   DECLARE isEstudante BOOLEAN DEFAULT NULL;
   DECLARE codigoAluno INTEGER DEFAULT NULL;
   DECLARE anoSemestre INTEGER DEFAULT NULL;

   SET anoSemestre := FCD_GET_ANOSEMESTRE_CORRENTE(coligada);
 
   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            2 CD_GRUPO,
            M.CODIGOALUNO CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO) AND
                  (M.ANOSEMESTRE = T.ANOSEMESTRE)
         WHERE
            M.ANOSEMESTRE = anoSemestre AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada
      )
      UNION
      (
         SELECT DISTINCT
            CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 2 AND
            CD_COLIGADA = coligada
      );

   ELSE

      SELECT DISTINCT
         M.CODIGOALUNO
      FROM
         MATRICULAS M
            JOIN SITUACAO S ON
               (M.SITUACAO = S.CD_SITUACAO)
            JOIN TURMAS T ON
               (M.TURMA = T.CODIGO) AND
               (M.ANOSEMESTRE = T.ANOSEMESTRE)
      WHERE
         M.ANOSEMESTRE = anoSemestre AND
         S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
         M.CODIGOALUNO = pessoa AND
         T.CD_COLIGADA = coligada
      INTO
         codigoAluno;
 
      IF codigoAluno IS NOT NULL THEN
         RETURN TRUE;
      END IF;
 
      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 2 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isEstudante;
 
      IF isEstudante THEN
         RETURN TRUE;
      END IF;

   END IF;
 
   RETURN FALSE;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_PROFESSORES`//

CREATE FUNCTION `FCD_GRUPO_PROFESSORES`(`pessoa` INTEGER,`coligada` INTEGER) RETURNS tinyint(1)
BEGIN
 
   DECLARE isProfessor BOOLEAN DEFAULT FALSE;
   DECLARE codigoProfessor INTEGER DEFAULT NULL;
   DECLARE anoSemestre INTEGER DEFAULT NULL;

   SET anoSemestre := FCD_GET_ANOSEMESTRE_CORRENTE(coligada);

   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            3 CD_GRUPO,
            TP.PROFESSOR CD_PESSOA,
            T.CD_COLIGADA
         FROM
            TURMASPROFESSORES TP
               JOIN TURMAS T ON
                  (TP.TURMA = T.CODIGO)
         WHERE
            TP.ANOSEMESTRE = anoSemestre AND
            T.CD_COLIGADA = coligada
      )
      UNION
      (
         SELECT
            CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            SN_INCLUIR = 1 AND
            CD_GRUPO = 3 AND
            CD_COLIGADA = coligada
      );

   ELSE
 
      SELECT DISTINCT
         TP.PROFESSOR
      FROM
         TURMASPROFESSORES TP
            JOIN TURMAS T ON
               (TP.TURMA = T.CODIGO)
      WHERE
         TP.ANOSEMESTRE = anoSemestre AND
         TP.PROFESSOR = pessoa AND
         T.CD_COLIGADA = coligada
      INTO
         codigoProfessor;
 
      IF codigoProfessor IS NOT NULL THEN
         RETURN TRUE;
      END IF;
 
      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 3 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isProfessor;
 
      IF isProfessor THEN
         RETURN TRUE;
      END IF;

   END IF; 

   RETURN FALSE;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_COORDENADORES`//

CREATE FUNCTION `FCD_GRUPO_COORDENADORES`(`pessoa` INTEGER,`coligada` INTEGER) RETURNS tinyint(1)
BEGIN
 
   DECLARE isCoordenador BOOLEAN DEFAULT FALSE;
   DECLARE codigoCoordenador INTEGER DEFAULT NULL;

   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT
            4 CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            CURSOS_COORDENADORES
         WHERE
            CD_COLIGADA = coligada
      )
      UNION
      (
         SELECT
            CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            SN_INCLUIR = 1 AND
            CD_GRUPO = 4 AND
            CD_COLIGADA = coligada
      );
   ELSE

	    SELECT DISTINCT
			   CD_PESSOA
	    FROM
			   CURSOS_COORDENADORES
	    WHERE
			   CD_PESSOA = pessoa AND
			   CD_COLIGADA = coligada
	    INTO
			   codigoCoordenador;
 
	    IF codigoCoordenador IS NOT NULL THEN
			   RETURN TRUE;
	    END IF;
 
	    SELECT
			   SN_INCLUIR
	    FROM
         NU_GRUPOS_EXCECOES
	    WHERE
			   CD_GRUPO = 4 AND
			   CD_PESSOA = pessoa AND
			   CD_COLIGADA = coligada
	    INTO
			   isCoordenador;
 
	    IF isCoordenador THEN
			   RETURN TRUE;
	    END IF;

   END IF;
 
   RETURN FALSE;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_FUNCIONARIOS`//

CREATE FUNCTION `FCD_GRUPO_FUNCIONARIOS`(pessoa INTEGER(11), coligada INTEGER(11)) RETURNS tinyint(1)
BEGIN
   DECLARE isFuncionario BOOLEAN DEFAULT FALSE;
   DECLARE codigoPessoa INTEGER DEFAULT NULL;

   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            5 CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            PROFESSORES
         WHERE
            SN_FUNCIONARIO = 'S' AND
            CD_COLIGADA = coligada
      )
      UNION
      (
         SELECT DISTINCT
            CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 5 AND
            SN_INCLUIR = 1 AND
            CD_COLIGADA = coligada
      );

   ELSE
 
      SELECT DISTINCT
	       CD_PESSOA
      FROM
	       PROFESSORES
      WHERE
         SN_FUNCIONARIO = 'S' AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         codigoPessoa;

      IF codigoPessoa IS NOT NULL THEN
         RETURN TRUE;
      END IF;

      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 5 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isFuncionario;
 
      IF isFuncionario THEN
         RETURN TRUE;
      END IF;

   END IF;
 
   RETURN FALSE;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_RESPACADEMICO`//

CREATE FUNCTION `FCD_GRUPO_RESPACADEMICO`(`pessoa` INTEGER,`coligada` INTEGER) RETURNS tinyint(1)
BEGIN
 
   DECLARE isRespAcad BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
   DECLARE anoSemestre INTEGER DEFAULT NULL;

   SET anoSemestre := FCD_GET_ANOSEMESTRE_CORRENTE(coligada);

   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
          SELECT DISTINCT
            6 CD_GRUPO,
            P.CD_RESP_ACAD CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO) AND
                  (M.ANOSEMESTRE = T.ANOSEMESTRE)
         WHERE
            M.ANOSEMESTRE = anoSemestre AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada
      )
      UNION
      (
            SELECT
               CD_GRUPO,
               CD_PESSOA,
               CD_COLIGADA
            FROM
               NU_GRUPOS_EXCECOES
            WHERE
               CD_GRUPO = 6 AND
               SN_INCLUIR = 1 AND
               CD_COLIGADA = coligada
      );

   ELSE
 
      SELECT DISTINCT
         P.CD_RESP_ACAD
      FROM
         MATRICULAS M
            JOIN PESSOAS P ON
               (M.CODIGOALUNO = P.CD_PESSOA)
            JOIN SITUACAO S ON
               (M.SITUACAO = S.CD_SITUACAO)
            JOIN TURMAS T ON
               (M.TURMA = T.CODIGO) AND
               (M.ANOSEMESTRE = T.ANOSEMESTRE)
      WHERE
         M.ANOSEMESTRE = anoSemestre AND
         S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
         P.CD_RESP_ACAD = pessoa AND
         T.CD_COLIGADA = coligada
      INTO
         codigoResp;
 
      IF codigoResp IS NOT NULL THEN
         RETURN TRUE;
      END IF;
 
      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 6 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isRespAcad;
 
      IF isRespAcad THEN
         RETURN TRUE;
      END IF;

   END IF;

   RETURN FALSE;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_RESPFINANCEIRO`//

CREATE FUNCTION `FCD_GRUPO_RESPFINANCEIRO`(`pessoa` INTEGER,`coligada` INTEGER) RETURNS tinyint(1)
BEGIN
 
   DECLARE isRespFinan BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
   DECLARE anoSemestre INTEGER DEFAULT NULL;

   SET anoSemestre := FCD_GET_ANOSEMESTRE_CORRENTE(coligada);

   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            7 CD_GRUPO,
            P.CD_RESP_FINAN CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO) AND
                  (M.ANOSEMESTRE = T.ANOSEMESTRE)
         WHERE
            M.ANOSEMESTRE = anoSemestre AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada
      )
      UNION
      (
         SELECT
            CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 7 AND
            SN_INCLUIR = 1 AND
            CD_COLIGADA = coligada
      );

   ELSE
 
      SELECT DISTINCT
         P.CD_RESP_FINAN
      FROM
         MATRICULAS M
            JOIN PESSOAS P ON
               (M.CODIGOALUNO = P.CD_PESSOA)
            JOIN SITUACAO S ON
               (M.SITUACAO = S.CD_SITUACAO)
            JOIN TURMAS T ON
               (M.TURMA = T.CODIGO) AND
               (M.ANOSEMESTRE = T.ANOSEMESTRE)
      WHERE
         M.ANOSEMESTRE = anoSemestre AND
         S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
         T.CD_COLIGADA = coligada AND
         P.CD_RESP_FINAN = pessoa
      INTO
         codigoResp;
 
      IF codigoResp IS NOT NULL THEN
         RETURN TRUE;
      END IF;
 
      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 7 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isRespFinan;
 
      IF isRespFinan THEN
         RETURN TRUE;
      END IF;

   END IF;
 
   RETURN FALSE;
END//

DROP PROCEDURE IF EXISTS `SPA_ATUALIZA_GRUPO`//

CREATE PROCEDURE `SPA_ATUALIZA_GRUPO`(IN `grupo` int,IN `coligada` int)
BEGIN
   DECLARE result BOOLEAN DEFAULT NULL;

   CASE grupo
      WHEN 2 THEN SET result := FCD_GRUPO_ESTUDANTES(NULL, coligada);
      WHEN 3 THEN SET result := FCD_GRUPO_PROFESSORES(NULL, coligada);
      WHEN 4 THEN SET result := FCD_GRUPO_COORDENADORES(NULL, coligada);
      WHEN 5 THEN SET result := FCD_GRUPO_FUNCIONARIOS(NULL, coligada);
      WHEN 6 THEN SET result := FCD_GRUPO_RESPACADEMICO(NULL, coligada);
      WHEN 7 THEN SET result := FCD_GRUPO_RESPFINANCEIRO(NULL, coligada);
      ELSE SET result := FALSE;
   END CASE;

END//]]></atualiza><atualiza codigo="{F894CA81-AF2F-4BAE-BB20-9135053B064F}" protocolo="oracle"><![CDATA[DELIMITER //

CREATE OR REPLACE 
FUNCTION             "FCD_GET_ANOSEMESTRE_CORRENTE" (codigoColigadaIn IN NUMBER)
RETURN NUMBER
AS
   anoSemestreAtual NUMBER := NULL;
   anoSemestreBloq NUMBER := NULL;
   anoSemestreInc NUMBER := NULL;
   codigoColigada NUMBER := NULL;
   ano NUMBER := NULL;
   mes NUMBER := NULL;
BEGIN

   IF codigoColigadaIn IS NULL THEN
      codigoColigada := 0;
   ELSE
      codigoColigada := codigoColigadaIn;
   END IF;

   BEGIN
      SELECT
         TO_NUMBER(DS_VALOR)
      INTO
         anoSemestreInc
      FROM
         PARAMETROS
      WHERE
         DS_VARIAVEL LIKE 'ano_semestre_incremento' AND
         CD_COLIGADA = codigoColigada;
      EXCEPTION
      WHEN NO_DATA_FOUND THEN
         anoSemestreInc := NULL;
   END;

   IF (anoSemestreInc IS NULL) AND (codigoColigada <> 0) THEN
      BEGIN
         SELECT
            TO_NUMBER(DS_VALOR)
         INTO
            anoSemestreInc
         FROM
            PARAMETROS
         WHERE
            DS_VARIAVEL LIKE 'ano_semestre_incremento' AND
            CD_COLIGADA = 0;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            anoSemestreInc := 1;
      END;
   END IF;

   ano := YEAR(SYSDATE);
   mes := MONTH(SYSDATE);

   BEGIN
      SELECT
         TO_NUMBER(P.DS_VALOR)
      INTO
         anoSemestreAtual
      FROM
         NU_MODULOS M
            JOIN NU_PARAMETROS P ON
               (M.CD_MODULO = P.CD_MODULO)
      WHERE
         P.DS_PARAMETRO LIKE 'online.anosemestre.atual' AND
         M.DS_CHAVE LIKE 'UniMestre' AND
         P.CD_COLIGADA = codigoColigada;
      EXCEPTION
      WHEN NO_DATA_FOUND THEN
         anoSemestreAtual := NULL;
   END;

   IF (anoSemestreAtual IS NULL) AND (codigoColigada <> 0) THEN
      BEGIN
         SELECT
            SYS.UTL_RAW.CAST_TO_NUMBER(SYS.UTL_RAW.CAST_TO_RAW(SYS.UTL_RAW.CAST_TO_VARCHAR2(SYS.UTL_RAW.CAST_TO_RAW(P.DS_VALOR))))
         INTO
            anoSemestreAtual
         FROM
            NU_MODULOS M
               JOIN NU_PARAMETROS P ON
                  (M.CD_MODULO = P.CD_MODULO)
         WHERE
            P.DS_PARAMETRO LIKE 'online.anosemestre.atual' AND
            M.DS_CHAVE LIKE 'UniMestre' AND
            P.CD_COLIGADA = 0;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            anoSemestreAtual := NULL;
      END;
   END IF;

   BEGIN
      SELECT
         SYS.UTL_RAW.CAST_TO_NUMBER(SYS.UTL_RAW.CAST_TO_RAW(SYS.UTL_RAW.CAST_TO_VARCHAR2(SYS.UTL_RAW.CAST_TO_RAW(P.DS_VALOR))))
      INTO
         anoSemestreBloq
      FROM
         NU_MODULOS M
            JOIN NU_PARAMETROS P ON
               (M.CD_MODULO = P.CD_MODULO)
      WHERE
         P.DS_PARAMETRO LIKE 'online.anosemestre.bloqueio' AND
         M.DS_CHAVE LIKE 'UniMestre' AND
         P.CD_COLIGADA = codigoColigada;
      EXCEPTION
      WHEN NO_DATA_FOUND THEN
         anoSemestreBloq := NULL;
   END;

   IF (anoSemestreBloq IS NULL) AND (codigoColigada <> 0) THEN
      BEGIN
         SELECT
            SYS.UTL_RAW.CAST_TO_NUMBER(SYS.UTL_RAW.CAST_TO_RAW(SYS.UTL_RAW.CAST_TO_VARCHAR2(SYS.UTL_RAW.CAST_TO_RAW(P.DS_VALOR))))
         INTO
            anoSemestreBloq
         FROM
            NU_MODULOS M
               JOIN NU_PARAMETROS P ON
                  (M.CD_MODULO = P.CD_MODULO)
         WHERE
            P.DS_PARAMETRO LIKE 'online.anosemestre.bloqueio' AND
            M.DS_CHAVE LIKE 'UniMestre' AND
            P.CD_COLIGADA = 0;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            anoSemestreBloq := NULL;
      END;
   END IF;

   IF anoSemestreAtual IS NULL THEN
      IF (anoSemestreInc = 1) AND (mes > 6) THEN
         anoSemestreAtual := CAST(ano || '2' AS NUMBER);
      ELSE
         anoSemestreAtual := CAST(ano || '1' AS NUMBER);
      END IF;
   END IF;

   IF anoSemestreBloq IS NULL THEN
      anoSemestreBloq := anoSemestreAtual;
   END IF;

   IF (anoSemestreBloq < anoSemestreAtual) THEN
      RETURN anoSemestreBloq;
   ELSE
      RETURN anoSemestreAtual;
   END IF;

   RETURN NULL;
END//

CREATE OR REPLACE 
FUNCTION             "FCD_GRUPO_ESTUDANTES" (pessoa IN NUMBER, coligada IN NUMBER)
RETURN SMALLINT
AS
   snIncluir NUMBER := NULL;
   codigoAluno NUMBER := NULL;
BEGIN

   IF pessoa IS NULL THEN

      INSERT INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            2 CD_GRUPO,
            M.CODIGOALUNO CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO)
         WHERE
            M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  GP.CD_GRUPO = 2 AND
                  M.CODIGOALUNO = GP.CD_PESSOA AND
                  T.CD_COLIGADA = GP.CD_COLIGADA
            )
      )
      UNION
      (
         SELECT
            E.CD_GRUPO,
            E.CD_PESSOA,
            E.CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES E
         WHERE
            E.SN_INCLUIR = 1 AND
            E.CD_GRUPO = 2 AND
            E.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  E.CD_GRUPO = GP.CD_GRUPO AND
                  E.CD_PESSOA = GP.CD_PESSOA AND
                  E.CD_COLIGADA = GP.CD_COLIGADA
            )
      );

   ELSE

      BEGIN
         SELECT DISTINCT
            M.CODIGOALUNO
         INTO
            codigoAluno
         FROM
            MATRICULAS M
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO)
         WHERE
            M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            M.CODIGOALUNO = pessoa AND
            T.CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            codigoAluno := NULL;
      END;

      IF codigoAluno IS NOT NULL THEN
         RETURN 1;
      END IF;

      BEGIN
         SELECT
            SN_INCLUIR
         INTO
            snIncluir
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 2 AND
            CD_PESSOA = pessoa AND
            CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            snIncluir := 0;
      END;

      IF snIncluir = 1 THEN
         RETURN 1;
      END IF;

   END IF;

   RETURN 0;
END//

CREATE OR REPLACE 
FUNCTION             "FCD_GRUPO_PROFESSORES" (pessoa IN NUMBER, coligada IN NUMBER)
RETURN SMALLINT
AS
   snIncluir NUMBER := NULL;
   codigoProfessor NUMBER := NULL;
BEGIN

   IF pessoa IS NULL THEN

      INSERT INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT
            3 CD_GRUPO,
            TP.PROFESSOR CD_PESSOA,
            T.CD_COLIGADA
         FROM
            TURMASPROFESSORES TP
               JOIN TURMAS T ON
                  (TP.TURMA = T.CODIGO)
         WHERE
            TP.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            T.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  GP.CD_GRUPO = 3 AND
                  TP.PROFESSOR = GP.CD_PESSOA AND
                  T.CD_COLIGADA = GP.CD_COLIGADA
            )
      )
      UNION
      (
         SELECT
            E.CD_GRUPO,
            E.CD_PESSOA,
            E.CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES E
         WHERE
            E.SN_INCLUIR = 1 AND
            E.CD_GRUPO = 3 AND
            E.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  E.CD_GRUPO = GP.CD_GRUPO AND
                  E.CD_PESSOA = GP.CD_PESSOA AND
                  E.CD_COLIGADA = GP.CD_COLIGADA
            )
      );

   ELSE

      BEGIN
         SELECT DISTINCT
            TP.PROFESSOR
         INTO
            codigoProfessor
         FROM
            TURMASPROFESSORES TP
               JOIN TURMAS T ON
                  (TP.TURMA = T.CODIGO)
         WHERE
            TP.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
            TP.PROFESSOR = pessoa AND
            T.CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            codigoProfessor := NULL;
      END;

      IF codigoProfessor IS NOT NULL THEN
         RETURN 1;
      END IF;

      BEGIN
         SELECT
            SN_INCLUIR
         INTO
            snIncluir
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 3 AND
            CD_PESSOA = pessoa AND
            CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            snIncluir := 0;
      END;

      IF snIncluir = 1 THEN
         RETURN 1;
      END IF;

   END IF;

   RETURN 0;
END//

CREATE OR REPLACE 
FUNCTION             "FCD_GRUPO_COORDENADORES" (pessoa IN NUMBER, coligada IN NUMBER)
RETURN SMALLINT
AS
   codigoCoordenador NUMBER := NULL;
   snIncluir NUMBER := NULL;
BEGIN

   IF pessoa IS NULL THEN

      INSERT INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            4 CD_GRUPO,
            C.CD_PESSOA,
            C.CD_COLIGADA
         FROM
            CURSOS_COORDENADORES C
         WHERE
            C.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  GP.CD_GRUPO = 4 AND
                  C.CD_PESSOA = GP.CD_PESSOA AND
                  C.CD_COLIGADA = GP.CD_COLIGADA
            )
      )
      UNION
      (
         SELECT
            E.CD_GRUPO,
            E.CD_PESSOA,
            E.CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES E
         WHERE
            E.CD_GRUPO = 4 AND
            E.SN_INCLUIR = 1 AND
            E.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  E.CD_GRUPO = GP.CD_GRUPO AND
                  E.CD_PESSOA = GP.CD_PESSOA AND
                  E.CD_COLIGADA = GP.CD_COLIGADA
            )
      );

   ELSE

      BEGIN
         SELECT DISTINCT
            CD_PESSOA
         INTO
            codigoCoordenador
         FROM
            CURSOS_COORDENADORES
         WHERE
            CD_PESSOA = pessoa AND
            CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            codigoCoordenador := NULL;
      END;

      IF codigoCoordenador IS NOT NULL THEN
         RETURN 1;
      END IF;

      BEGIN
         SELECT
            SN_INCLUIR
         INTO
            snIncluir
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_PESSOA = pessoa AND
            CD_GRUPO = 4 AND
            CD_COLIGADA = coligada;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
            snIncluir := 0;
      END;

      IF snIncluir = 1 THEN
         RETURN 1;
      END IF;

   END IF;

   RETURN 0;
END//

CREATE OR REPLACE 
FUNCTION "FCD_GRUPO_FUNCIONARIOS" (pessoa IN NUMBER, coligada IN NUMBER)
RETURN SMALLINT
AS
   codigoProfessor NUMBER := NULL;
   snIncluir NUMBER := NULL;
BEGIN

   IF pessoa IS NULL THEN

      INSERT INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            5 CD_GRUPO,
            P.CD_PESSOA,
            P.CD_COLIGADA
         FROM
            PROFESSORES P
         WHERE
            P.CD_COLIGADA = coligada AND
            NOT EXISTS
            (
               SELECT
                  GP.CD_PESSOA
               FROM
                  NU_GRUPOS_PESSOAS GP
               WHERE
                  GP.CD_GRUPO = 5 AND
                  P.CD_PESSOA = GP.CD_PESSOA AND
                  P.CD_COLIGADA = GP.CD_COLIGADA
            )
