WHERE
   TIME(DT_RETORNO) > 0;]]></atualiza><atualiza codigo="{A8291C94-C44F-451A-8FD9-BD88CD9D0A02}" protocolo="oracle"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{00AD2EE1-8A56-4EAC-8007-6E8963734126}" protocolo="mysql-5"><![CDATA[ALTER TABLE `fin_orcamento` RENAME `fin_orcamentos_valores`;
