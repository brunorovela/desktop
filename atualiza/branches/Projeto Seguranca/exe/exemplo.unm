DROP TRIGGER dellperms//
CREATE TRIGGER dellperms_before_upd BEFORE UPDATE ON relatorios
FOR EACH ROW
BEGIN
		UPDATE NU_GRUPOS_PERMISSOES
		SET NR_PERMISSAO = 0
		WHERE CD_ACAO IN
	  (
		   SELECT
		      MA.CD_ACAO
		   FROM
		      NU_MODULOS M
		         JOIN NU_MODULOS_ACOES MA ON
		            (M.CD_MODULO = MA.CD_MODULO)
		            LEFT JOIN RELATORIOS R ON
		               (MA.DS_CHAVE = CONCAT('Rel.Grupo.', R.DS_GRUPO)) AND
		               (R.CD_MODULO = 1)
		   WHERE
		      M.DS_CHAVE = 'Impressao.Academico' AND
		      R.CD_RELATORIO IS NULL
		);

		UPDATE NU_GRUPOS_PERMISSOES
		SET NR_PERMISSAO = 0
		WHERE CD_ACAO IN
		(
		   SELECT
		      MA.CD_ACAO
		   FROM
		      NU_MODULOS M
		         JOIN NU_MODULOS_ACOES MA ON
		            (M.CD_MODULO = MA.CD_MODULO)
		            LEFT JOIN RELATORIOS R ON
		               (MA.DS_CHAVE = CONCAT('Rel.Grupo.', R.DS_GRUPO)) AND
		               (R.CD_MODULO = 2)
		   WHERE
		      M.DS_CHAVE = 'Impressao.CR' AND
		      R.CD_RELATORIO IS NULL
		);
		
		UPDATE NU_GRUPOS_PERMISSOES
		SET NR_PERMISSAO = 0
		WHERE CD_ACAO IN
		(
		   SELECT
		      MA.CD_ACAO
		   FROM
		      NU_MODULOS M
		         JOIN NU_MODULOS_ACOES MA ON
		            (M.CD_MODULO = MA.CD_MODULO)
		            LEFT JOIN RELATORIOS R ON
		               (MA.DS_CHAVE = CONCAT('Rel.Grupo.', R.DS_GRUPO)) AND
		               (R.CD_MODULO = 4)
		   WHERE
		      M.DS_CHAVE = 'Impressao.CP' AND
		      R.CD_RELATORIO IS NULL
		);
		SET @grupo = (SELECT count(ds_grupo) FROM relatorios WHERE  ds_grupo = OLD.ds_grupo GROUP BY ds_grupo);
    DELETE FROM nu_modulos_acoes  WHERE (DS_CHAVE = CONCAT('Rel.Grupo.',  OLD.ds_grupo)) AND ((SELECT @grupo) <= 1) ;
END//

CREATE TRIGGER dellperms_before_del BEFORE DELETE ON relatorios
FOR EACH ROW
BEGIN
		UPDATE NU_GRUPOS_PERMISSOES
		SET NR_PERMISSAO = 0
		WHERE CD_ACAO IN
	  (
		   SELECT
		      MA.CD_ACAO
		   FROM
		      NU_MODULOS M
		         JOIN NU_MODULOS_ACOES MA ON
		            (M.CD_MODULO = MA.CD_MODULO)
		            LEFT JOIN RELATORIOS R ON
		               (MA.DS_CHAVE = CONCAT('Rel.Grupo.', R.DS_GRUPO)) AND
		               (R.CD_MODULO = 1)
		   WHERE
		      M.DS_CHAVE = 'Impressao.Academico' AND
		      R.CD_RELATORIO IS NULL
		);

		UPDATE NU_GRUPOS_PERMISSOES
		SET NR_PERMISSAO = 0
		WHERE CD_ACAO IN
		(
		   SELECT
		      MA.CD_ACAO
		   FROM
		      NU_MODULOS M
		         JOIN NU_MODULOS_ACOES MA ON
		            (M.CD_MODULO = MA.CD_MODULO)
		            LEFT JOIN RELATORIOS R ON
		               (MA.DS_CHAVE = CONCAT('Rel.Grupo.', R.DS_GRUPO)) AND
		               (R.CD_MODULO = 2)
		   WHERE
		      M.DS_CHAVE = 'Impressao.CR' AND
		      R.CD_RELATORIO IS NULL
		);
		
		UPDATE NU_GRUPOS_PERMISSOES
		SET NR_PERMISSAO = 0
		WHERE CD_ACAO IN
		(
		   SELECT
		      MA.CD_ACAO
		   FROM
		      NU_MODULOS M
		         JOIN NU_MODULOS_ACOES MA ON
		            (M.CD_MODULO = MA.CD_MODULO)
		            LEFT JOIN RELATORIOS R ON
		               (MA.DS_CHAVE = CONCAT('Rel.Grupo.', R.DS_GRUPO)) AND
		               (R.CD_MODULO = 4)
		   WHERE
		      M.DS_CHAVE = 'Impressao.CP' AND
		      R.CD_RELATORIO IS NULL
		);
		SET @grupo = (SELECT count(ds_grupo) FROM relatorios WHERE  ds_grupo = OLD.ds_grupo GROUP BY ds_grupo);
    DELETE FROM nu_modulos_acoes  WHERE (DS_CHAVE = CONCAT('Rel.Grupo.',  OLD.ds_grupo)) AND ((SELECT @grupo) <= 1) ;
END//]]></atualiza><atualiza codigo="{8FC854FD-6593-4830-878C-22DD43E9F531}" protocolo="mysql-5"><![CDATA[UPDATE nu_cadastros_campos SET ds_chave  = 'nr_recomendado_alunos_exemplar' WHERE ds_chave = 'nr_recomendado_estudantes_por_exemplar';
