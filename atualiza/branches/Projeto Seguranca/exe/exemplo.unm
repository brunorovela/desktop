 * Cria os novos módulos para impressão de relatórios
 */

INSERT INTO NU_MODULOS
   (DS_NOME_MODULO, DS_DESCRICAO, DS_CHAVE, SN_FIXO, SN_ONLINE, SN_VISUAL)
VALUES
   ('Relatórios Acadêmicos', 'Impressão de Relatórios Acadêmicos', 'Impressao.Academico', 0, 0, 0);

INSERT INTO NU_MODULOS
   (DS_NOME_MODULO, DS_DESCRICAO, DS_CHAVE, SN_FIXO, SN_ONLINE, SN_VISUAL)
VALUES
   ('Relatórios Contas a Receber', 'Impressão de Relatórios Contas a Receber', 'Impressao.CR', 0, 0, 0);

INSERT INTO NU_MODULOS
   (DS_NOME_MODULO, DS_DESCRICAO, DS_CHAVE, SN_FIXO, SN_ONLINE, SN_VISUAL)
VALUES
   ('Relatórios Contas a Pagar', 'Impressão de Relatórios Contas a Pagar', 'Impressao.CP', 0, 0, 0);

INSERT INTO NU_MODULOS
   (DS_NOME_MODULO, DS_DESCRICAO, DS_CHAVE, SN_FIXO, SN_ONLINE, SN_VISUAL)
VALUES
   ('Relatórios Gerencias', 'Impressão de Relatórios Gerenciais', 'Impressao.Gerencial', 0, 0, 0);

/*
 * Cria as ações para acesso aos grupos de relatórios
 */

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
SELECT
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Impressao.Academico'),
   CONCAT('Acesso aos relatórios acadêmicos do grupo ', DS_GRUPO),
   DS_GRUPO
FROM
   RELATORIOS
WHERE
   CD_MODULO = 1
GROUP BY
   DS_GRUPO;

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
SELECT
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Impressao.CR'),
   CONCAT('Acesso aos relatórios contas a receber do grupo ', DS_GRUPO),
   DS_GRUPO
FROM
   RELATORIOS
WHERE
   CD_MODULO = 2
GROUP BY
   DS_GRUPO;

INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
SELECT
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Impressao.CP'),
   CONCAT('Acesso aos relatórios contas a pagar do grupo ', DS_GRUPO),
   DS_GRUPO
FROM
   RELATORIOS
WHERE
   CD_MODULO = 4
GROUP BY
   DS_GRUPO;

/*
 * Copiar as antigas permissões de acesso
 */

INSERT INTO NU_GRUPOS_PERMISSOES
   (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   G.CD_GRUPO,
   MA.CD_ACAO,
   1
FROM
   NU_GRUPOS G
      JOIN USUARIOS U ON
         (G.DS_NOME_GRUPO = U.NOME)
         JOIN MODULOSUSUARIOS MU ON
            (U.CODIGO = MU.CODIGOUSUARIO)
            JOIN MODULOS M ON
               (MU.CODIGOMODULO = M.CODIGO)
         JOIN NU_MODULOS_ACOES MA ON
            (M.MODULO = SUBSTRING_INDEX(MA.DS_CHAVE, '.', -1))
WHERE
   MU.ACESSAR = 'S' AND
   M.CATEGORIA = 'Impressão'
GROUP BY
   G.CD_GRUPO,
   MA.CD_ACAO;

/*
 * Ajustar o nome das chaves nas permissões
 */

UPDATE NU_MODULOS_ACOES MA
SET
   MA.DS_CHAVE = CONCAT('Rel.Grupo.', MA.DS_CHAVE)
WHERE EXISTS (
   SELECT
      *
   FROM
      NU_MODULOS M
   WHERE
      MA.CD_MODULO = M.CD_MODULO AND
      M.DS_CHAVE IN ('Impressao.Academico', 'Impressao.CR', 'Impressao.CP', 'Impressao.Gerencial')
);

/*
 * Cria permissão para acesso a tela de controle de permissões de acesso à relatórios
 */
INSERT INTO NU_MODULOS_ACOES
   (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES
   (
      (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ControleAcesso'),
      'Acesso à tela de controle de permissão de acesso aos relatórios',
      'Controle.Permissao.Relatorio'
   );

INSERT INTO NU_GRUPOS_PERMISSOES
   (CD_ACAO, CD_GRUPO, NR_PERMISSAO)
SELECT
   (
      SELECT
         MA.CD_ACAO
      FROM
         NU_MODULOS_ACOES MA
            JOIN NU_MODULOS M ON
               (MA.CD_MODULO = M.CD_MODULO)
      WHERE
         MA.DS_CHAVE = 'Controle.Permissao.Relatorio' AND
         M.DS_CHAVE = 'ControleAcesso'
   ),
   G.CD_GRUPO,
   17
FROM
   NU_GRUPOS G
      JOIN USUARIOS U ON
         (G.DS_NOME_GRUPO = U.NOME)
         JOIN MODULOSUSUARIOS MU ON
            (U.CODIGO = MU.CODIGOUSUARIO)
WHERE
   MU.ACESSAR = 'S' AND
   MU.CODIGOMODULO = 3001;]]></atualiza><atualiza codigo="{7E652F2B-061D-4198-9CB9-DAD0F138C51D}" protocolo="oracle"><![CDATA[DELIMITER //

CREATE OR REPLACE 
FUNCTION "SUBSTRING_INDEX" (entrada IN VARCHAR2, delimitador IN CHAR, contador IN NUMBER)
RETURN VARCHAR2
IS
   quantidade NUMBER := NULL;
   ocorrencia NUMBER := NULL;
   tamanho NUMBER := NULL;
   posicao NUMBER := NULL;
   saida VARCHAR2(32767) := NULL;
   temp VARCHAR2(32767) := NULL;
BEGIN
   quantidade := LENGTH(entrada) - LENGTH(REPLACE(entrada, delimitador, NULL));
   
   IF quantidade < contador OR contador = 0 THEN
      saida := entrada;
   ELSE
      
      IF contador < 0 THEN

         ocorrencia := quantidade + contador;
         saida := entrada;
         quantidade := 0;
         WHILE quantidade <= ocorrencia LOOP
            posicao := INSTR(saida, delimitador) + 1;
            tamanho := LENGTH(saida) - posicao + 1;
            saida := SUBSTR(saida, posicao, tamanho);
            quantidade := quantidade + 1;
         END LOOP;

      ELSE

         ocorrencia := contador;
         temp := entrada;
         quantidade := 0;
         WHILE quantidade < ocorrencia LOOP
            posicao := INSTR(temp, delimitador);
            IF (quantidade + 1) = ocorrencia THEN
               posicao := posicao - 1;
            END IF;
            saida := saida || SUBSTR(temp, 1, posicao);
            tamanho := LENGTH(temp) - posicao;
            temp := SUBSTR(temp, posicao + 1, tamanho);
            quantidade := quantidade + 1;
         END LOOP;

      END IF;

   END IF;

   RETURN saida;
END//

