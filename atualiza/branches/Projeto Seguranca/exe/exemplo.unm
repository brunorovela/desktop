INSERT INTO `parametros` (`ds_variavel`, `ds_valor`, `sn_restrito`, `ds_variavel_usuario`, `cd_categoria`, `cd_tipo`, `cd_coligada`) VALUES ('financeiro_autenticacao_campos_cp', 'UNIMESTRE[CD_PESSOA][NR_DOCUMENTO][NR_PARCELA][CD_TITULO][DT_PAGAMENTO][VL_PAGO][ENTER]', 'N', 'Define a string de caracteres que será utilizada para autenticação de um pagamento de compromisso.\r\n\r\nO padrão deste campo, caso não informado é: \r\n\r\nUNIMESTRE[CD_PESSOA][NR_DOCUMENTO][NR_PARCELA][CD_TITULO][DT_PAGAMENTO][VL_PAGO][ENTER]\r\n\r\nEntre colchetes poderá ser utilizado os nomes de campos da tabela fin_contas_pagar.\r\n\r\nA String [ENTER] indica apenas que na última autenticação será forçado um avanço de 1 linha na autenticação.\r\n\r\nOBS. Este parâmetro depende da utilização do parâmetro "financeiro_qtd_autenticacao_cp".', 16, 0, 0);
]]></atualiza><atualiza codigo="{174526D9-C60B-4C65-A485-D21F8642FE1B}" protocolo="ansi"><![CDATA[INSERT INTO nu_textos (ds_chave, ds_texto, cd_interno, me_texto, sn_ativo) 
