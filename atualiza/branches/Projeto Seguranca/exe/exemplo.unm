ALTER TABLE AVALIACOES_PROVAS_TIPOS ADD COLUMN NR_QUANTIDADE_MAXIMA INT(5) NOT NULL DEFAULT '0';
ALTER TABLE AVALIACOES_PROVAS_TIPOS ADD COLUMN CD_TIPO_AVALIACAO INT(5) NOT NULL DEFAULT '1';]]></atualiza><atualiza codigo="{E2090FB5-E3E7-4731-ADE7-BB866C8AF5C4}" protocolo="oracle"><![CDATA[INSERT INTO nu_modulos_acoes (cd_acao, cd_modulo, ds_nome_acao,
