CREATE TABLE NU_GRUPOS_EXCECOES (
   CD_GRUPO INTEGER NOT NULL,
   CD_PESSOA INTEGER NOT NULL,
   CD_COLIGADA SMALLINT DEFAULT NULL,
   SN_INCLUIR TINYINT(1) NOT NULL DEFAULT 0,
   CONSTRAINT UK_GRUPOS_EXCECOES UNIQUE KEY (CD_GRUPO, CD_PESSOA)
) Type=InnoDB//
 
ALTER TABLE NU_GRUPOS_EXCECOES ADD CONSTRAINT FK_GRUPOS_EXC_GRUPOS_CD_GRUPO FOREIGN KEY (CD_GRUPO) REFERENCES nu_grupos (cd_grupo)//
ALTER TABLE NU_GRUPOS_EXCECOES ADD CONSTRAINT FK_GRUPOS_EXC_PES_CD_PESSOA FOREIGN KEY (CD_PESSOA) REFERENCES pessoas (cd_pessoa)//
ALTER TABLE NU_GRUPOS_EXCECOES ADD CONSTRAINT FK_GRUPOS_EXC_COL_CD_COLIG FOREIGN KEY (CD_COLIGADA) REFERENCES COLIGADAS (CD_COLIGADA)//



SET GLOBAL log_bin_trust_function_creators = 1//
 
CREATE FUNCTION `FCD_GET_ANOSEMESTRE_CORRENTE`(`CodigoColigada` SMALLINT)
   RETURNS INT(11)
BEGIN
   DECLARE anoSemestreAtual INTEGER DEFAULT NULL;
   DECLARE anoSemestreBloq INTEGER DEFAULT NULL;
   DECLARE anoSemestreInc INTEGER DEFAULT NULL;
   DECLARE ano INTEGER DEFAULT NULL;
   DECLARE mes INTEGER DEFAULT NULL;
 
   IF CodigoColigada IS NULL THEN
      SET CodigoColigada := 0;
   END IF;
 
   SELECT
      CAST(DS_VALOR AS SIGNED)
   FROM
      PARAMETROS
   WHERE
      DS_VARIAVEL LIKE 'ano_semestre_incremento' AND
      CD_COLIGADA = CodigoColigada
   INTO
      anoSemestreInc;
 
   IF anoSemestreInc IS NULL THEN
      SELECT
         DS_VALOR
      FROM
         PARAMETROS
      WHERE
         DS_VARIAVEL LIKE 'ano_semestre_incremento' AND
         CD_COLIGADA = 0
      INTO
         anoSemestreInc;
   END IF;
 
   SET ano := YEAR(NOW());
   SET mes := MONTH(NOW());
 
   SELECT
      CAST(P.DS_VALOR AS SIGNED)
   FROM
      NU_MODULOS M
         JOIN NU_PARAMETROS P ON
            (M.CD_MODULO = P.CD_MODULO)
   WHERE
      P.DS_PARAMETRO LIKE 'online.anosemestre.atual' AND
      M.DS_CHAVE LIKE 'UniMestre' AND
      P.CD_COLIGADA = CodigoColigada
   INTO
      anoSemestreAtual;
 
   IF (anoSemestreAtual IS NULL) AND (CodigoColigada <> 0) THEN
      SELECT
         CAST(P.DS_VALOR AS SIGNED)
      FROM
         NU_MODULOS M
            JOIN NU_PARAMETROS P ON
               (M.CD_MODULO = P.CD_MODULO)
      WHERE
         P.DS_PARAMETRO LIKE 'online.anosemestre.atual' AND
         M.DS_CHAVE LIKE 'UniMestre' AND
         P.CD_COLIGADA = 0
      INTO
         anoSemestreAtual;
   END IF;
 
   SELECT
      CAST(P.DS_VALOR AS SIGNED)
   FROM
      NU_MODULOS M
         JOIN NU_PARAMETROS P ON
            (M.CD_MODULO = P.CD_MODULO)
   WHERE
      P.DS_PARAMETRO LIKE 'online.anosemestre.bloqueio' AND
      M.DS_CHAVE LIKE 'UniMestre' AND
      P.CD_COLIGADA = CodigoColigada
   INTO
      anoSemestreBloq;
 
   IF (anoSemestreBloq IS NULL) AND (CodigoColigada <> 0) THEN
      SELECT
         CAST(P.DS_VALOR AS SIGNED)
      FROM
         NU_MODULOS M
            JOIN NU_PARAMETROS P ON
               (M.CD_MODULO = P.CD_MODULO)
      WHERE
         P.DS_PARAMETRO LIKE 'online.anosemestre.bloqueio' AND
         M.DS_CHAVE LIKE 'UniMestre' AND
         P.CD_COLIGADA = 0
      INTO
         anoSemestreBloq;
   END IF;
 
   IF anoSemestreAtual IS NULL THEN
      IF (mes > 6) AND (anoSemestreInc = 1) THEN
         SET anoSemestreAtual := CAST(CONCAT(ano, '2') AS SIGNED);
      ELSE
         SET anoSemestreAtual := CAST(CONCAT(ano, '1') AS SIGNED);
      END IF;
   END IF;
 
   IF anoSemestreBloq IS NULL THEN
      SET anoSemestreBloq := anoSemestreAtual;
   END IF;
 
   IF anoSemestreBloq < anoSemestreAtual THEN
      RETURN anoSemestreBloq;
   ELSE
      RETURN anoSemestreAtual;
   END IF;
 
   RETURN NULL;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_ESTUDANTES//
 
CREATE FUNCTION `FCD_GRUPO_ESTUDANTES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isEstudante BOOLEAN DEFAULT NULL;
   DECLARE codigoAluno INTEGER DEFAULT NULL;
 
   SELECT
      M.CODIGOALUNO
   FROM
      MATRICULAS M
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      M.CODIGOALUNO = pessoa AND
      T.CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoAluno;
 
   IF codigoAluno IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 2 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isEstudante;
 
   IF isEstudante THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_PROFESSORES//
 
CREATE FUNCTION `FCD_GRUPO_PROFESSORES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isProfessor BOOLEAN DEFAULT FALSE;
   DECLARE codigoProfessor INTEGER DEFAULT NULL;
 
   SELECT
      TP.PROFESSOR
   FROM
      TURMASPROFESSORES TP
         JOIN TURMAS T ON
            (TP.TURMA = T.CODIGO)
   WHERE
      TP.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
      TP.PROFESSOR = pessoa AND
      T.CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoProfessor;
 
   IF codigoProfessor IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 3 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isProfessor;
 
   IF isProfessor THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_COORDENADORES//
 
CREATE FUNCTION `FCD_GRUPO_COORDENADORES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isCoordenador BOOLEAN DEFAULT FALSE;
   DECLARE codigoCoordenador INTEGER DEFAULT NULL;
 
   SELECT
      CD_PESSOA
   FROM
      CURSOS_COORDENADORES
   WHERE
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoCoordenador;
 
   IF codigoCoordenador IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 4 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isCoordenador;
 
   IF isCoordenador THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_FUNCIONARIOS//
 
CREATE FUNCTION `FCD_GRUPO_FUNCIONARIOS`(cdPessoa INTEGER(11), coligada INTEGER(11))
    RETURNS tinyint(1)
    NOT DETERMINISTIC
    CONTAINS SQL
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE isFuncionario BOOLEAN DEFAULT FALSE;
   DECLARE codigoPessoa INTEGER DEFAULT NULL;
 
   SELECT
	   cd_pessoa
   FROM
	   professores
   WHERE
      sn_funcionario = "S" AND
      cd_pessoa = cdPessoa AND
      cd_coligada = coligada
   GROUP BY
      cd_pessoa
   INTO
      codigoPessoa;
 
   SELECT
      sn_incluir
   FROM
      nu_grupos_excecoes
   WHERE
      cd_grupo = 5 AND
      cd_pessoa = cdPessoa AND
      cd_coligada = coligada
   INTO
      isFuncionario;
 
   IF codigoPessoa IS NULL AND isFuncionario <> 1 THEN
      RETURN FALSE;
   ELSE
      RETURN TRUE;
   END IF;
 
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_RESPACADEMICO//
 
CREATE FUNCTION `FCD_GRUPO_RESPACADEMICO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespAcad BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_ACAD
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      P.CD_RESP_ACAD = pessoa
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 6 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespAcad;
 
   IF isRespAcad THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_RESPFINANCEIRO//
 
CREATE FUNCTION `FCD_GRUPO_RESPFINANCEIRO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespFinan BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_FINAN
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      P.CD_RESP_FINAN = pessoa
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 7 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespFinan;
 
   IF isRespFinan THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
 
   RETURN 0;
END//



DROP PROCEDURE IF EXISTS SPA_ATUALIZA_GRUPOS_PESSOA//
 
CREATE PROCEDURE `SPA_ATUALIZA_GRUPOS_PESSOA`(IN `pessoa` INTEGER, IN `coligada` INTEGER)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   IF FCD_GRUPO_ESTUDANTES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (2, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 2 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_PROFESSORES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (3, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 3 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_COORDENADORES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (4, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 4 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_RESPACADEMICO(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (6, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 6 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_RESPFINANCEIRO(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (7, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 7 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
END//



DROP TRIGGER atualizar_grupo_pessoa//

CREATE TRIGGER atualizar_grupo_pessoa AFTER INSERT ON nu_acessos FOR EACH ROW
BEGIN
	DECLARE nr_coligadas INTEGER(11);
	DECLARE coligada INTEGER(11);
	DECLARE cursor_coligadas CURSOR FOR
		SELECT 
			cd_coligada
		FROM 
			coligadas;
 
	OPEN cursor_coligadas;
 
		SELECT FOUND_ROWS() INTO nr_coligadas;
 
		WHILE nr_coligadas > 0 DO
			FETCH cursor_coligadas INTO coligada;
 
			CALL SPA_ATUALIZA_GRUPOS_PESSOA (NEW.cd_pessoa, coligada);
 
			SET nr_coligadas := nr_coligadas - 1;
 
		END WHILE;
 
	CLOSE cursor_coligadas;
END//]]></atualiza><atualiza codigo="{47B54452-97FC-47AA-B656-A4F5A998C1CE}" protocolo="mysql-5"><![CDATA[ALTER TABLE fin_negocia MODIFY COLUMN cd_usuario  int(11) NULL DEFAULT NULL;]]></atualiza><atualiza codigo="{47B54452-97FC-47AA-B656-A4F5A998C1CE}" protocolo="oracle"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{37641D9E-533C-4C34-A8EB-68018B1AF95F}" protocolo="mysql-5"><![CDATA[ALTER TABLE GRADES
ADD COLUMN ( SN_ATIVO CHAR(1) NOT NULL DEFAULT 'S' );]]></atualiza><atualiza codigo="{37641D9E-533C-4C34-A8EB-68018B1AF95F}" protocolo="oracle"><![CDATA[ALTER TABLE GRADES
ADD ( SN_ATIVO CHAR(1) DEFAULT 'S' NOT NULL );]]></atualiza><atualiza codigo="{3F788245-E99F-46DD-8AEA-5C3C8FFB6D74}" protocolo="mysql-5"><![CDATA[DROP VIEW IF EXISTS gradecurricular;
CREATE VIEW gradecurricular AS
SELECT
	DISTINCT G.NR_ANO_INICIAL AS ANOSEMESTRE,
	G.CD_CURSO AS CURSO,
	GD.CD_DISCIPLINA AS DISCIPLINA,
	GD.NR_SERIE AS SERIE,
	T.TURNO AS TURNO,
	GD.NR_AULAS AS NUMEROAULAS,
	GD.VL_VALOR AS VALOR,
	CONCAT(
		G.NR_ANO_INICIAL, 
		G.CD_CURSO,
		LPAD(GD.NR_SERIE, 2, 0),
		T.TURNO,
		LPAD(GD.CD_DISCIPLINA, 5, 0)) AS CODIGO,
	GD.SN_COMPARTILHADA,
	GD.NR_CREDITOS_ACADEMICOS,
	GD.CD_GRADE,
	GD.CD_DISCIPLINA_CATEGORIA AS CD_DISC_CATEGORIA,
	GD.NR_CARGA_HORARIA_PRATICA AS NR_CH_PRATICA,
	GD.NR_CARGA_HORARIA_TEORICA AS NR_CH_TEORICA
FROM
	TURMAS T
	INNER JOIN GRADES G ON (G.CD_GRADE = T.CD_GRADE AND G.CD_CURSO = T.CURSO AND G.SN_ATIVO = 'S')
	INNER JOIN GRADES_DISCIPLINAS GD ON (GD.CD_GRADE = G.CD_GRADE AND GD.CD_CURSO = G.CD_CURSO);]]></atualiza><atualiza codigo="{3F788245-E99F-46DD-8AEA-5C3C8FFB6D74}" protocolo="oracle"><![CDATA[CREATE OR REPLACE VIEW "GRADECURRICULAR" AS
SELECT
	DISTINCT G.NR_ANO_INICIAL AS ANOSEMESTRE,
	G.CD_CURSO AS CURSO,
	GD.CD_DISCIPLINA AS DISCIPLINA,
	GD.NR_SERIE AS SERIE,
	T.TURNO AS TURNO,
	GD.NR_AULAS AS NUMEROAULAS,
	GD.VL_VALOR AS VALOR,
	CONCAT(
		G.NR_ANO_INICIAL, 
		G.CD_CURSO ||
		LPAD(GD.NR_SERIE, 2, 0) ||
		T.TURNO ||
		LPAD(GD.CD_DISCIPLINA, 5, 0)) AS CODIGO,
	GD.SN_COMPARTILHADA,
	GD.NR_CREDITOS_ACADEMICOS,
	GD.CD_GRADE,
	GD.CD_DISCIPLINA_CATEGORIA AS CD_DISC_CATEGORIA,
	GD.NR_CARGA_HORARIA_PRATICA AS NR_CH_PRATICA,
	GD.NR_CARGA_HORARIA_TEORICA AS NR_CH_TEORICA
FROM
	TURMAS T
	INNER JOIN GRADES G ON (G.CD_GRADE = T.CD_GRADE AND G.CD_CURSO = T.CURSO AND G.SN_ATIVO = 'S')
	INNER JOIN GRADES_DISCIPLINAS GD ON (GD.CD_GRADE = G.CD_GRADE AND GD.CD_CURSO = G.CD_CURSO);]]></atualiza><atualiza codigo="{D975AE71-1EFC-467B-87C5-E7BE6169F5FA}" protocolo="ansi"><![CDATA[DELIMITER //

DROP PROCEDURE IF EXISTS SPA_ATUALIZA_GRUPOS_PESSOA//
 
CREATE PROCEDURE `SPA_ATUALIZA_GRUPOS_PESSOA`(IN `pessoa` INTEGER, IN `coligada` INTEGER)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   IF FCD_GRUPO_ESTUDANTES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (2, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 2 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_PROFESSORES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (3, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 3 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_COORDENADORES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (4, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 4 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_RESPACADEMICO(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (6, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 6 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_RESPFINANCEIRO(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (7, pessoa, coligada);
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 7 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
END//]]></atualiza><atualiza codigo="{881B3F50-92EB-40D6-93D0-E81A01408DBE}" protocolo="ansi"><![CDATA[DELIMITER //
 
SET GLOBAL log_bin_trust_function_creators = 1//
 
DROP FUNCTION IF EXISTS FCD_GRUPO_RESPACADEMICO//
 
CREATE FUNCTION `FCD_GRUPO_RESPACADEMICO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespAcad BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_ACAD
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      T.CD_COLIGADA = coligada AND
      (P.CD_RESP_ACAD = pessoa OR ((P.CD_PAI = pessoa AND P.SN_PAI_RESP = 1) OR (P.CD_MAE = pessoa AND P.SN_MAE_RESP = 1))) AND
      P.CD_PESSOA != P.CD_RESP_ACAD
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 6 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespAcad;
 
   IF isRespAcad THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
END//


DROP FUNCTION IF EXISTS FCD_GRUPO_RESPFINANCEIRO//
 
CREATE FUNCTION `FCD_GRUPO_RESPFINANCEIRO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespFinan BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_FINAN
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      M.ANOSEMESTRE = FCD_GET_ANOSEMESTRE_CORRENTE(coligada) AND
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      P.CD_RESP_FINAN = pessoa AND
      P.CD_PESSOA != P.CD_RESP_FINAN      
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 7 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespFinan;
 
   IF isRespFinan THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
 
   RETURN 0;
END//]]></atualiza><atualiza codigo="{50263571-D0E6-48F8-9FA6-EAE111AB2519}" protocolo="mysql-5"><![CDATA[ALTER TABLE `cursos_mestre` ADD COLUMN `NR_RELEVANCIA`  smallint(6) NOT NULL DEFAULT 1 AFTER `SN_ATIVO`;]]></atualiza><atualiza codigo="{50263571-D0E6-48F8-9FA6-EAE111AB2519}" protocolo="oracle"><![CDATA[ALTER TABLE CURSOS_MESTRE ADD ( NR_RELEVANCIA NUMBER(5) DEFAULT 1  NOT NULL );]]></atualiza><atualiza codigo="{7D992519-2963-47B7-A5AD-1E4E0ED724D9}" protocolo="ansi"><![CDATA[UPDATE avl_avaliacoes SET anosemestre = CONCAT( YEAR(dt_inicio), IF(MONTH(dt_inicio) > 6, 2, 1) ) WHERE anosemestre = 0 OR anosemestre IS NULL;]]></atualiza><atualiza codigo="{D775EE2A-3B79-4554-AE1C-30332CFE66AF}" protocolo="mysql-5"><![CDATA[ALTER TABLE diario_terminal_acessos CHANGE COLUMN cd_pessoa cd_pessoa INT(11) NULL DEFAULT NULL;]]></atualiza><atualiza codigo="{D775EE2A-3B79-4554-AE1C-30332CFE66AF}" protocolo="oracle"><![CDATA[ALTER TABLE diario_terminal_acessos ADD cd_pessoa_bkp NUMBER(9);
