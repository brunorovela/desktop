ALTER TABLE fichaindividual ADD ajuste1 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste2 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste3 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste4 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste5 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste6 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste7 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste8 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste9 FLOAT(126) NULL//
ALTER TABLE fichaindividual ADD ajuste10 FLOAT(126) NULL//


MERGE INTO fichaindividual fi USING
   (SELECT 
			fi.anosemestre AS anosemestre,
			fi.turma AS turma,
			fi.codigograde AS codigograde,
			fi.codigoaluno AS codigoaluno,
			fi.disciplina AS disciplina,
			fi.serie AS serie,
			fi.situacao AS situacao,
			dm.ajuste AS ajuste
    FROM
			diario_matriculas dm,
			fichaindividual fi
    WHERE
			dm.codaluno = fi.codigoaluno AND 
			dm.anosemestre = fi.anosemestre AND 
			dm.turma = fi.turma AND 
			dm.disciplina = fi.disciplina AND
			dm.bimestre = 1) fi2 ON (
					fi2.anosemestre = fi.anosemestre AND 
					fi2.turma = fi.turma AND 
					fi2.codigograde = fi.codigograde AND 
					fi2.codigoaluno = fi.codigoaluno AND
					fi2.disciplina = fi.disciplina AND
					fi2.serie = fi.serie AND
					fi2.situacao = fi.situacao
			) 
    WHEN MATCHED THEN 
    	UPDATE SET fi.ajuste1 = fi2.ajuste//

MERGE INTO fichaindividual fi USING
   (SELECT 
			fi.anosemestre AS anosemestre,
			fi.turma AS turma,
			fi.codigograde AS codigograde,
			fi.codigoaluno AS codigoaluno,
			fi.disciplina AS disciplina,
			fi.serie AS serie,
			fi.situacao AS situacao,
			dm.ajuste AS ajuste
    FROM
			diario_matriculas dm,
			fichaindividual fi
    WHERE
			dm.codaluno = fi.codigoaluno AND 
			dm.anosemestre = fi.anosemestre AND 
			dm.turma = fi.turma AND 
			dm.disciplina = fi.disciplina AND
			dm.bimestre = 2) fi2 ON (
					fi2.anosemestre = fi.anosemestre AND 
					fi2.turma = fi.turma AND 
					fi2.codigograde = fi.codigograde AND 
					fi2.codigoaluno = fi.codigoaluno AND
					fi2.disciplina = fi.disciplina AND
					fi2.serie = fi.serie AND
					fi2.situacao = fi.situacao
			) 
    WHEN MATCHED THEN 
    	UPDATE SET fi.ajuste2 = fi2.ajuste//

MERGE INTO fichaindividual fi USING
   (SELECT 
			fi.anosemestre AS anosemestre,
			fi.turma AS turma,
			fi.codigograde AS codigograde,
			fi.codigoaluno AS codigoaluno,
			fi.disciplina AS disciplina,
			fi.serie AS serie,
			fi.situacao AS situacao,
			dm.ajuste AS ajuste
    FROM
			diario_matriculas dm,
			fichaindividual fi
    WHERE
			dm.codaluno = fi.codigoaluno AND 
			dm.anosemestre = fi.anosemestre AND 
			dm.turma = fi.turma AND 
			dm.disciplina = fi.disciplina AND
			dm.bimestre = 3) fi2 ON (
					fi2.anosemestre = fi.anosemestre AND 
					fi2.turma = fi.turma AND 
					fi2.codigograde = fi.codigograde AND 
					fi2.codigoaluno = fi.codigoaluno AND
					fi2.disciplina = fi.disciplina AND
					fi2.serie = fi.serie AND
					fi2.situacao = fi.situacao
			) 
    WHEN MATCHED THEN 
    	UPDATE SET fi.ajuste3 = fi2.ajuste//
		
