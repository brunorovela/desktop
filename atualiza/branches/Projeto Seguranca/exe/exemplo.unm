  INNER JOIN   disciplinas d ON (de.codigo = d.codigo);

UPDATE disciplinas set sn_ementa_padrao = 0;]]></atualiza><atualiza codigo="{8F901C67-F159-497C-A3E5-A0705BBD24CA}" protocolo="ansi"><![CDATA[INSERT INTO nu_modulos_acoes VALUES (null,(SELECT cd_modulo FROM nu_modulos where ds_chave = 'Academico'),'Secretaria > Monografias','1152');
UPDATE 
  nu_grupos_permissoes perm
  INNER JOIN nu_modulos_acoes nma ON (perm.cd_acao = nma.cd_acao)
SET
 perm.nr_permissao = 4
where 
