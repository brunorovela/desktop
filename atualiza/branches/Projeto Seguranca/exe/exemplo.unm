INSERT IGNORE INTO nu_grupos (cd_grupo, ds_nome_grupo, sn_fixo, ds_papel) 
VALUES (9, 'Administradores da Instituição', 1, 'ADMIN');

-- Insere as pessoas no grupo de administradores para o grupo de administradores da instituição
INSERT IGNORE INTO nu_grupos_pessoas (cd_grupo, cd_pessoa, cd_coligada)
SELECT 
	9 cd_grupo, cd_pessoa, cd_coligada 
FROM 
	nu_grupos_pessoas 
WHERE 
	cd_pessoa NOT IN (SELECT cd_pessoa FROM pessoas WHERE ds_login LIKE 'admin') and cd_grupo = 1;

-- Remove as pessoas que estão no grupo administradores com excessão da pessoa com login admin
DELETE ngp FROM nu_grupos_pessoas ngp
WHERE ngp.cd_pessoa NOT IN (SELECT p.cd_pessoa FROM pessoas p WHERE p.ds_login LIKE 'admin') and ngp.cd_grupo = 1;

-- Colocar Hierarquia para o grupo administradores em relação a todos os outros grupos
INSERT IGNORE INTO nu_grupos_hierarquia (cd_grupo, cd_grupo_liberado)
SELECT 
	1, cd_grupo
FROM
	nu_grupos
WHERE
	cd_grupo != 1;]]></atualiza><atualiza codigo="{C77EF4A6-898A-4155-B873-6148B2BDC316}" protocolo="mysql-5"><![CDATA[ALTER TABLE `nu_acessos`
ADD COLUMN `ds_session_id`  varchar(255) NULL DEFAULT NULL;]]></atualiza><atualiza codigo="{C77EF4A6-898A-4155-B873-6148B2BDC316}" protocolo="oracle"><![CDATA[ALTER TABLE "NU_ACESSOS"
ADD ( "DS_SESSION_ID" VARCHAR2(255) DEFAULT NULL  NULL  );]]></atualiza><atualiza codigo="{50DA4EF9-7E1D-4B12-8738-B7F36610C981}" protocolo="mysql-5"><![CDATA[ALTER TABLE recibos ENGINE=InnoDB;
ALTER TABLE recibos ADD COLUMN cd_pessoa INT(11) NOT NULL;
UPDATE recibos SET cd_pessoa = ( SELECT cd_pessoa FROM pessoas WHERE ds_login = 'admin' );
ALTER TABLE recibos ADD FOREIGN KEY RECIBOS_PESSOAS_EXECUCAO (cd_pessoa) REFERENCES pessoas (cd_pessoa) ON DELETE RESTRICT ON UPDATE RESTRICT;

ALTER TABLE comp_produtos ADD COLUMN TP_IMPRESSAO_CUPOM CHAR(1) NOT NULL DEFAULT 'I' COMMENT 'I = Individual / A = Agrupado';

INSERT INTO recibos ( cd_mensalidade, cd_aluno, nr_parcela, cd_turma, cd_pessoa, dt_recibo, dt_impressao )
SELECT 
	ce.cd_mensalidade, ce.cd_pessoa, m.parcela, m.turma, (SELECT cd_pessoa FROM pessoas WHERE ds_login = 'admin'), ce.DT_COMPRA, ce.DT_COMPRA
FROM 
	comp_estoque ce
	INNER JOIN mensalidades m ON ( m.cd_mensalidade = ce.cd_mensalidade )
WHERE 
	ce.cd_mensalidade IS NOT NULL 
GROUP BY 
	ce.cd_mensalidade;

#
# Inclusão de Permissão para Impressão
#
INSERT INTO `nu_modulos_acoes`(`cd_acao`, `cd_modulo`, `ds_nome_acao`,
 `ds_chave`)
VALUES (NULL, (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'UMFinanceiro'),
 'Recebimentos > Planilha de Recebimentos > Imprimir > Impressão de cupons de Produtos', 'PlanilhaRecebimentos.Imprimir.CuponsProdutos');

#Definir a permissão
INSERT INTO `nu_grupos_permissoes`(`cd_permissao`, `cd_grupo`, `cd_acao`,
 `nr_permissao`)
VALUES (NULL, 1, (SELECT cd_acao FROM nu_modulos_acoes WHERE ds_chave =
 'PlanilhaRecebimentos.Imprimir.CuponsProdutos' and cd_modulo =(SELECT cd_modulo FROM nu_modulos WHERE
 ds_chave = 'UMFinanceiro')), 1);

ALTER TABLE comp_estoque ADD COLUMN SN_PRIMEIRA_IMPRESSAO TINYINT(1) NOT NULL DEFAULT 0;
UPDATE comp_estoque SET SN_PRIMEIRA_IMPRESSAO = 1 WHERE CD_MENSALIDADE IS NOT NULL;
UPDATE
	comp_estoque ce 
	INNER JOIN comp_produtos cp ON (cp.CD_PRODUTO = ce.CD_PRODUTO)
SET
	ce.SN_PRIMEIRA_IMPRESSAO = 1
WHERE cp.SN_GERAR_TITULO = 0;]]></atualiza><atualiza codigo="{50DA4EF9-7E1D-4B12-8738-B7F36610C981}" protocolo="oracle"><![CDATA[ALTER TABLE RECIBOS ADD CD_PESSOA NUMBER(9);
UPDATE recibos SET cd_pessoa = ( SELECT cd_pessoa FROM pessoas WHERE ds_login = 'admin' );
ALTER TABLE RECIBOS MODIFY CD_PESSOA NUMBER(9) NOT NULL;

ALTER TABLE recibos ADD FOREIGN KEY (cd_pessoa) REFERENCES pessoas (cd_pessoa);
ALTER TABLE comp_produtos ADD TP_IMPRESSAO_CUPOM CHAR(1) DEFAULT 'I' NOT NULL;
COMMENT ON COLUMN COMP_PRODUTOS.TP_IMPRESSAO_CUPOM IS 'I = Individual / A = Agrupado';

CREATE OR REPLACE 
PROCEDURE  "AUXILIAR_INSERT_RECIBOS"
AS
	NRO_INCREMENTO INTEGER(11) := -1;

	CURSOR LISTA_RECIBOS_INSERT IS
				SELECT 
					ce.cd_mensalidade,
					FIRST_OCCURRENCE(ce.cd_pessoa) AS cd_pessoa, FIRST_OCCURRENCE(m.parcela) AS parcela, FIRST_OCCURRENCE(m.turma) AS turma,
					(SELECT cd_pessoa FROM pessoas WHERE ds_login = 'admin') AS cd_usuario,
					FIRST_OCCURRENCE(ce.DT_COMPRA) AS dt_compra
				FROM 
					comp_estoque ce
					INNER JOIN mensalidades m ON ( m.cd_mensalidade = ce.cd_mensalidade )
					LEFT JOIN recibos r ON ( r.cd_mensalidade = m.cd_mensalidade )
				WHERE 
					ce.cd_mensalidade IS NOT NULL AND
					r.cd_recibo IS NULL
				GROUP BY 
					ce.cd_mensalidade;

	RECIBO_INSERT LISTA_RECIBOS_INSERT%ROWTYPE;
BEGIN
	SELECT MAX(NR_RECIBO)+1 INTO NRO_INCREMENTO FROM RECIBOS;

	OPEN LISTA_RECIBOS_INSERT;
	
	LOOP
		FETCH LISTA_RECIBOS_INSERT INTO RECIBO_INSERT;
		EXIT WHEN LISTA_RECIBOS_INSERT%NOTFOUND;

		INSERT INTO recibos ( cd_mensalidade, cd_aluno, nr_parcela, cd_turma, cd_pessoa, dt_recibo, dt_impressao, nr_recibo )
		VALUES ( 
			RECIBO_INSERT.cd_mensalidade, RECIBO_INSERT.cd_pessoa, RECIBO_INSERT.parcela, RECIBO_INSERT.turma, 
			RECIBO_INSERT.cd_usuario, RECIBO_INSERT.dt_compra, RECIBO_INSERT.dt_compra, NRO_INCREMENTO );

		NRO_INCREMENTO := NRO_INCREMENTO + 1;
	END LOOP;

	CLOSE LISTA_RECIBOS_INSERT;	
END;
CALL AUXILIAR_INSERT_RECIBOS();
DROP PROCEDURE AUXILIAR_INSERT_RECIBOS;

INSERT INTO nu_modulos_acoes(cd_acao, cd_modulo, ds_nome_acao,
 ds_chave)
VALUES (NULL, (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'UMFinanceiro'),
 'Recebimentos > Planilha de Recebimentos > Imprimir > Impressão de cupons de Produtos', 'PlanilhaRecebimentos.Imprimir.CuponsProdutos');

INSERT INTO nu_grupos_permissoes(cd_permissao, cd_grupo, cd_acao,
 nr_permissao)
VALUES (NULL, 1, (SELECT cd_acao FROM nu_modulos_acoes WHERE ds_chave =
 'PlanilhaRecebimentos.Imprimir.CuponsProdutos' and cd_modulo =(SELECT cd_modulo FROM nu_modulos WHERE
 ds_chave = 'UMFinanceiro')), 1);

ALTER TABLE comp_estoque ADD SN_PRIMEIRA_IMPRESSAO NUMBER(5) DEFAULT 0 NOT NULL;

UPDATE 
	comp_estoque 
SET 
	SN_PRIMEIRA_IMPRESSAO = 1 
WHERE 
	CD_MENSALIDADE IS NOT NULL;

UPDATE 
	comp_estoque ce
SET 
	ce.SN_PRIMEIRA_IMPRESSAO = 1
WHERE 
	(SELECT SN_GERAR_TITULO FROM COMP_PRODUTOS cp WHERE cp.CD_PRODUTO = ce.CD_PRODUTO) = 0;]]></atualiza><atualiza codigo="{1FE1D10C-4DF6-4466-BB1E-D6592955B585}" protocolo="ansi"><![CDATA[# Não tendo certeza se o campo já existe, eu deixei o CHANGE COLUMN de 1 nome para outr,
