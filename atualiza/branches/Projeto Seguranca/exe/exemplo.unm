CALL CRIAR_AUTO_INCREMENT('PLE_CABECALHOS_TURMAS', 'CD_CABECALHO_TURMA', 'SEQ_PLE_CABECALHOS_TURMAS', 'AUTO_INC_PLE_CABECALHOS_TURMAS');//]]></atualiza><atualiza codigo="{E3E0ED29-1660-4DC2-8BAE-D15D2B26FB63}" protocolo="mysql-5"><![CDATA[DELIMITER //
SET GLOBAL log_bin_trust_function_creators=1//
CREATE PROCEDURE procInsereCdPessoa()
BEGIN
  DECLARE cd_pessoa_usuario, codigo_usuario INTEGER;
	DECLARE done INT DEFAULT 0;
  DECLARE cursorPrincipal CURSOR FOR SELECT 	US.CODIGO, PES.cd_pessoa 
    FROM	
  PESSOAS PES 
  inner join USUARIOS US on (us.nome = pes.ds_login)
  where 
  ds_login like 'ADMIN'
 ;
  
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;
  OPEN cursorPrincipal;
  read_loop: LOOP	
    FETCH cursorPrincipal INTO codigo_usuario,cd_pessoa_usuario ;
    UPDATE USUARIOS as u SET u.cd_pessoa = cd_pessoa_usuario where u.codigo = codigo_usuario ;
    IF done THEN
	LEAVE read_loop;
    END IF;
  END LOOP;
  CLOSE cursorPrincipal;
END//


call procInsereCdPessoa()//


DROP TABLE  IF EXISTS temp//
CREATE TABLE `temp` (
	`codigo`  int NULL AUTO_INCREMENT ,
	`valor`  int NULL ,
	PRIMARY KEY (`codigo`)
)//
SET @codigo = 0//
INSERT INTO temp (valor) (SELECT @codigo := @codigo +1   FROM pessoas )//


DROP TABLE  IF EXISTS  CODIGOSVALIDOS//
SET @codigoAtual =0 //
CREATE table CODIGOSVALIDOS
SELECT 
	@codigoAtual := 	@codigoAtual+1 as codigo,
	temp.valor as  indice
FROM
	temp 
	left join pessoas as p ON (temp.valor = p.cd_pessoa )
WHERE 
	p.nm_pessoa is null 
GROUP BY 
	temp.valor //


set @codigo = 0//

INSERT INTO PESSOAS (CD_PESSOA, NM_PESSOA, DS_LOGIN, DS_SENHA)
SELECT indice,nome,nome,senha FROM (
SELECT 
		@codigo := @codigo + 1,
		(SELECT indice FROM CODIGOSVALIDOS WHERE codigo = @codigo)as indice 	,
		US.NOME as nome,
		US.SENHA as senha
		FROM
			USUARIOS US
			LEFT JOIN PESSOAS PES ON (US.CD_PESSOA = PES.CD_PESSOA)
		WHERE
			PES.CD_PESSOA IS NULL) as tbl//

call procInsereCdPessoa()//
DROP TABLE CODIGOSVALIDOS//
DROP TABLE temp//

DELIMITER ;]]></atualiza><atualiza codigo="{E3E0ED29-1660-4DC2-8BAE-D15D2B26FB63}" protocolo="oracle"><![CDATA[DELIMITER //

CREATE TABLE "TEMP" (
"CODIGO" INTEGER NULL ,
"VALOR" INTEGER NULL 
)
NOCOMPRESS;//

CREATE TABLE "CODIGOSVALIDOS" (
"CODIGO" INTEGER NULL ,
"INDICE" INTEGER NULL 
)
NOCOMPRESS;//

DECLARE
	sql_temp VARCHAR(255);
	sql_validos VARCHAR(255);
	sql_buscavalidos VARCHAR(255);
	sql_estaDuplicado VARCHAR(255);
	CODIGOATUAL INTEGER;
	CODIGOINSERIDO INTEGER;
	CODIGODUPLICADO VARCHAR(255);
	CURSOR sqlPessoas IS 
		SELECT
			cd_pessoa
		FROM
			PESSOAS;
BEGIN
	CODIGOATUAL :=0 ;
	FOR linha IN sqlPessoas LOOP
		CODIGOATUAL :=CODIGOATUAL +1;
		sql_temp := 'INSERT INTO TEMP(CODIGO , VALOR ) VALUES (:1, :2)';
		EXECUTE IMMEDIATE	sql_temp USING CODIGOATUAL,CODIGOATUAL;
	END LOOP;	
	CODIGOATUAL := 0;
  FOR cursor1 IN (SELECT 	TEMP.VALOR AS VALOR	FROM	TEMP 	left join PESSOAS P ON (TEMP.VALOR = P.CD_PESSOA )
	WHERE 
		p.NM_PESSOA is null 
	GROUP BY
		TEMP.VALOR
	ORDER BY 
		TEMP.VALOR )
  LOOP
		CODIGOATUAL :=CODIGOATUAL +1;
		sql_validos := 'INSERT INTO CODIGOSVALIDOS(CODIGO , INDICE ) VALUES (:1, :2)';
		EXECUTE IMMEDIATE	sql_validos USING CODIGOATUAL,cursor1.VALOR;
  END LOOP;

	CODIGOATUAL := 0;
  FOR cursorSQLusuarios IN (SELECT 
		US.NOME as NOME,
		US.SENHA as SENHA
		FROM
			USUARIOS US
			LEFT JOIN PESSOAS PES ON (US.CD_PESSOA = PES.CD_PESSOA)
		WHERE
			PES.CD_PESSOA IS NULL
		GROUP BY
     	US.NOME ,
			US.SENHA 
	)
  LOOP
		CODIGOATUAL := CODIGOATUAL +1;
		sql_buscavalidos := 'SELECT INDICE FROM CODIGOSVALIDOS WHERE CODIGO = :1 GROUP BY INDICE';
		EXECUTE IMMEDIATE sql_buscavalidos INTO CODIGOINSERIDO USING CODIGOATUAL ;
		sql_estaDuplicado := 'SELECT IFNULL((SELECT DS_LOGIN FROM "PESSOAS" WHERE DS_LOGIN= :1 GROUP BY DS_LOGIN ) , 1) FROM DUAL';
		EXECUTE IMMEDIATE sql_estaDuplicado INTO CODIGODUPLICADO USING cursorSQLusuarios.NOME ;
		IF (CODIGODUPLICADO = '1' AND cursorSQLusuarios.NOME != 'ADMIN') THEN
			sql_validos := 'INSERT INTO "PESSOAS" (CD_PESSOA, NM_PESSOA, DS_LOGIN, DS_SENHA) VALUES(:1,:2,:3 ,:4)';
			EXECUTE IMMEDIATE	sql_validos USING CODIGOINSERIDO ,cursorSQLusuarios.NOME , cursorSQLusuarios.NOME , cursorSQLusuarios.SENHA;
		END IF;
	END LOOP;
END;//]]></atualiza><atualiza codigo="{AF6EDF0B-8B21-4F68-BBE8-FA62E7ABBE7C}" protocolo="mysql-5"><![CDATA[CREATE TABLE TURMAS_BKP_CONVERSAO AS SELECT * FROM TURMAS;
UPDATE
	TURMAS
SET
	CD_GRADE = CONCAT(ANOSEMESTRE, CD_GRADE);

CREATE TABLE MATRICULAS_CURSO_BKP_CONVERSAO AS SELECT * FROM MATRICULAS_CURSO;
UPDATE
	MATRICULAS_CURSO
SET
	CD_GRADE = CONCAT(NR_ANOSEM_GRADE, CD_GRADE);

ALTER TABLE gradecurricular RENAME gradecurricular_mudado;

DROP VIEW IF EXISTS gradecurricular;
CREATE VIEW gradecurricular AS
SELECT
	DISTINCT G.NR_ANO_INICIAL AS ANOSEMESTRE,
	G.CD_CURSO AS CURSO,
	GD.CD_DISCIPLINA AS DISCIPLINA,
	GD.NR_SERIE AS SERIE,
	T.TURNO AS TURNO,
	GD.NR_AULAS AS NUMEROAULAS,
	GD.VL_VALOR AS VALOR,
	CONCAT(
		G.NR_ANO_INICIAL, 
		G.CD_CURSO,
		LPAD(GD.NR_SERIE, 2, 0),
		T.TURNO,
		LPAD(GD.CD_DISCIPLINA, 5, 0)) AS CODIGO,
	GD.SN_COMPARTILHADA,
	GD.NR_CREDITOS_ACADEMICOS,
	GD.CD_GRADE,
	GD.CD_DISCIPLINA_CATEGORIA AS CD_DISC_CATEGORIA,
	GD.NR_CARGA_HORARIA_PRATICA AS NR_CH_PRATICA,
	GD.NR_CARGA_HORARIA_TEORICA AS NR_CH_TEORICA
FROM
	TURMAS T
	INNER JOIN GRADES G ON (G.CD_GRADE = T.CD_GRADE AND G.CD_CURSO = T.CURSO)
	INNER JOIN GRADES_DISCIPLINAS GD ON (GD.CD_GRADE = G.CD_GRADE AND GD.CD_CURSO = G.CD_CURSO);]]></atualiza><atualiza codigo="{AF6EDF0B-8B21-4F68-BBE8-FA62E7ABBE7C}" protocolo="oracle"><![CDATA[UPDATE
	TURMAS
SET
	CD_GRADE = CONCAT(ANOSEMESTRE, CD_GRADE);

UPDATE
	MATRICULAS_CURSO
SET
	CD_GRADE = CONCAT(NR_ANOSEM_GRADE, CD_GRADE);

ALTER TABLE GRADECURRICULAR RENAME TO "GRADECURRICULAR_MUDADO";

CREATE OR REPLACE VIEW "GRADECURRICULAR" AS
SELECT
	DISTINCT G.NR_ANO_INICIAL AS ANOSEMESTRE,
	G.CD_CURSO AS CURSO,
	GD.CD_DISCIPLINA AS DISCIPLINA,
	GD.NR_SERIE AS SERIE,
	T.TURNO AS TURNO,
	GD.NR_AULAS AS NUMEROAULAS,
	GD.VL_VALOR AS VALOR,
	CONCAT(
		G.NR_ANO_INICIAL, 
		G.CD_CURSO ||
		LPAD(GD.NR_SERIE, 2, 0) ||
		T.TURNO ||
		LPAD(GD.CD_DISCIPLINA, 5, 0)) AS CODIGO,
	GD.SN_COMPARTILHADA,
	GD.NR_CREDITOS_ACADEMICOS,
	GD.CD_GRADE,
	GD.CD_DISCIPLINA_CATEGORIA AS CD_DISC_CATEGORIA,
	GD.NR_CARGA_HORARIA_PRATICA AS NR_CH_PRATICA,
	GD.NR_CARGA_HORARIA_TEORICA AS NR_CH_TEORICA
FROM
	TURMAS T
	INNER JOIN GRADES G ON (G.CD_GRADE = T.CD_GRADE AND G.CD_CURSO = T.CURSO)
	INNER JOIN GRADES_DISCIPLINAS GD ON (GD.CD_GRADE = G.CD_GRADE AND GD.CD_CURSO = G.CD_CURSO);]]></atualiza><atualiza codigo="{24A22C2F-272C-4767-AB98-C049CF644AFA}" protocolo="mysql-5"><![CDATA[DROP TABLE IF EXISTS `nu_cores`;
