ALTER TABLE `fin_nfe_g2ka_sql` ADD COLUMN `cd_nfe_g2ka_sql_tipo`  int(11) NULL DEFAULT NULL AFTER `cd_nfe_g2ka_sql`;]]></atualiza><atualiza codigo="{01D721C2-3CCD-4F32-9345-A4518FF2671C}" protocolo="ansi"><![CDATA[DELIMITER //

INSERT IGNORE INTO `nu_parametros` (`ds_parametro`, `ds_valor`, `ds_observacao`, `cd_modulo`, `cd_coligada`) VALUES ('online.anosemestre.minimo', (select ds_valor from parametros where ds_variavel like "nr_anosemestre_online"), 'Define o ano/semestre mínimo para permitir aos alunos visualizarem informações no sistema online', 22, 0)//

SET GLOBAL log_bin_trust_function_creators=1//

DROP FUNCTION IF EXISTS `FCD_GET_ANOSEMESTRE_MINIMO`//

CREATE FUNCTION `FCD_GET_ANOSEMESTRE_MINIMO`(`CodigoColigada` SMALLINT)
    RETURNS int(11)
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
     DECLARE anoSemestreMinimo INTEGER DEFAULT NULL;
 
     SELECT
        CAST(P.DS_VALOR AS SIGNED)
     FROM
        NU_MODULOS M
           JOIN NU_PARAMETROS P ON
              (M.CD_MODULO = P.CD_MODULO)
     WHERE
        P.DS_PARAMETRO LIKE 'online.anosemestre.minimo' AND
        M.DS_CHAVE LIKE 'UniMestre' AND
        P.CD_COLIGADA = CodigoColigada
     INTO
        anoSemestreMinimo;
        
     IF (anoSemestreMinimo IS NULL) AND (CodigoColigada <> 0) THEN
        SELECT
           CAST(P.DS_VALOR AS SIGNED)
        FROM
           NU_MODULOS M
              JOIN NU_PARAMETROS P ON
                 (M.CD_MODULO = P.CD_MODULO)
        WHERE
           P.DS_PARAMETRO LIKE 'online.anosemestre.minimo' AND
           M.DS_CHAVE LIKE 'UniMestre' AND
           P.CD_COLIGADA = 0
        INTO
           anoSemestreMinimo;
     END IF;
     
     IF (anoSemestreMinimo IS NULL) THEN
        SET anoSemestreMinimo := 0;
     END IF;  
     
     RETURN anoSemestreMinimo;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_ESTUDANTES`//

CREATE FUNCTION `FCD_GRUPO_ESTUDANTES`(`pessoa` INTEGER,`coligada` INTEGER)
    RETURNS tinyint(1)
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 
   DECLARE isEstudante       BOOLEAN DEFAULT NULL;
   DECLARE codigoAluno       INTEGER DEFAULT NULL;
   DECLARE anoSemestre       INTEGER DEFAULT NULL;
   DECLARE anoSemestreMinimo INTEGER DEFAULT NULL;

   SET anoSemestre       := FCD_GET_ANOSEMESTRE_CORRENTE(coligada);
   SET anoSemestreMinimo := FCD_GET_ANOSEMESTRE_MINIMO(coligada);
 
   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            2 CD_GRUPO,
            M.CODIGOALUNO CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO) AND
                  (M.ANOSEMESTRE = T.ANOSEMESTRE)
         WHERE
            M.ANOSEMESTRE <= anoSemestre AND
            M.ANOSEMESTRE >= anoSemestreMinimo AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada
      )
      UNION
      (
         SELECT DISTINCT
            CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 2 AND
            CD_COLIGADA = coligada
      );

   ELSE

      SELECT DISTINCT
         M.CODIGOALUNO
      FROM
         MATRICULAS M
            JOIN SITUACAO S ON
               (M.SITUACAO = S.CD_SITUACAO)
            JOIN TURMAS T ON
               (M.TURMA = T.CODIGO) AND
               (M.ANOSEMESTRE = T.ANOSEMESTRE)
      WHERE
         M.ANOSEMESTRE <= anoSemestre AND
         M.ANOSEMESTRE >= anoSemestreMinimo AND
         S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
         M.CODIGOALUNO = pessoa AND
         T.CD_COLIGADA = coligada
      INTO
         codigoAluno;
 
      IF codigoAluno IS NOT NULL THEN
         RETURN TRUE;
      END IF;
 
      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 2 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isEstudante;
 
      IF isEstudante THEN
         RETURN TRUE;
      END IF;

   END IF;
 
   RETURN FALSE;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_RESPACADEMICO`//

CREATE FUNCTION `FCD_GRUPO_RESPACADEMICO`(`pessoa` INTEGER,`coligada` INTEGER)
    RETURNS tinyint(1)
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 
   DECLARE isRespAcad BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
   DECLARE anoSemestre INTEGER DEFAULT NULL;
   DECLARE anoSemestreMinimo INTEGER DEFAULT NULL;

   SET anoSemestre := FCD_GET_ANOSEMESTRE_CORRENTE(coligada);
   SET anoSemestreMinimo := FCD_GET_ANOSEMESTRE_MINIMO(coligada);

   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
          SELECT DISTINCT
            6 CD_GRUPO,
            P.CD_RESP_ACAD CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO) AND
                  (M.ANOSEMESTRE = T.ANOSEMESTRE)
         WHERE
            M.ANOSEMESTRE <= anoSemestre AND
            M.ANOSEMESTRE >= anoSemestreMinimo AND
            P.CD_PESSOA <> P.CD_RESP_ACAD AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada
      )
      UNION
      (
            SELECT
               CD_GRUPO,
               CD_PESSOA,
               CD_COLIGADA
            FROM
               NU_GRUPOS_EXCECOES
            WHERE
               CD_GRUPO = 6 AND
               SN_INCLUIR = 1 AND
               CD_COLIGADA = coligada
      );

   ELSE
 
      SELECT DISTINCT
         P.CD_RESP_ACAD
      FROM
         MATRICULAS M
            JOIN PESSOAS P ON
               (M.CODIGOALUNO = P.CD_PESSOA)
            JOIN SITUACAO S ON
               (M.SITUACAO = S.CD_SITUACAO)
            JOIN TURMAS T ON
               (M.TURMA = T.CODIGO) AND
               (M.ANOSEMESTRE = T.ANOSEMESTRE)
      WHERE
         M.ANOSEMESTRE <= anoSemestre AND
         M.ANOSEMESTRE >= anoSemestreMinimo AND
         S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
         (P.CD_RESP_ACAD = pessoa OR
           (cd_pai = pessoa AND sn_pai_resp = 1 ) OR (cd_mae = pessoa AND sn_mae_resp = 1)
         )
          AND
         P.CD_PESSOA <> P.CD_RESP_ACAD AND
         T.CD_COLIGADA = coligada
      INTO
         codigoResp;
 
      IF codigoResp IS NOT NULL THEN
         RETURN TRUE;
      END IF;
 
      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 6 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isRespAcad;
 
      IF isRespAcad THEN
         RETURN TRUE;
      END IF;

   END IF;

   RETURN FALSE;
END//

DROP FUNCTION IF EXISTS `FCD_GRUPO_RESPFINANCEIRO`//

CREATE FUNCTION `FCD_GRUPO_RESPFINANCEIRO`(`pessoa` INTEGER,`coligada` INTEGER)
    RETURNS tinyint(1)
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
 
   DECLARE isRespFinan BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
   DECLARE anoSemestre INTEGER DEFAULT NULL;
   DECLARE anoSemestreMinimo INTEGER DEFAULT NULL;

   SET anoSemestre := FCD_GET_ANOSEMESTRE_CORRENTE(coligada);
   SET anoSemestreMinimo := FCD_GET_ANOSEMESTRE_MINIMO(coligada);

   IF pessoa IS NULL THEN

      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      (
         SELECT DISTINCT
            7 CD_GRUPO,
            P.CD_RESP_FINAN CD_PESSOA,
            T.CD_COLIGADA
         FROM
            MATRICULAS M
               JOIN PESSOAS P ON
                  (M.CODIGOALUNO = P.CD_PESSOA)
               JOIN SITUACAO S ON
                  (M.SITUACAO = S.CD_SITUACAO)
               JOIN TURMAS T ON
                  (M.TURMA = T.CODIGO) AND
                  (M.ANOSEMESTRE = T.ANOSEMESTRE)
         WHERE
            M.ANOSEMESTRE <= anoSemestre AND
            M.ANOSEMESTRE >= anoSemestreMinimo AND
            P.CD_PESSOA <> P.CD_RESP_FINAN AND
            S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
            T.CD_COLIGADA = coligada
      )
      UNION
      (
         SELECT
            CD_GRUPO,
            CD_PESSOA,
            CD_COLIGADA
         FROM
            NU_GRUPOS_EXCECOES
         WHERE
            CD_GRUPO = 7 AND
            SN_INCLUIR = 1 AND
            CD_COLIGADA = coligada
      );

   ELSE
 
      SELECT DISTINCT
         P.CD_RESP_FINAN
      FROM
         MATRICULAS M
            JOIN PESSOAS P ON
               (M.CODIGOALUNO = P.CD_PESSOA)
            JOIN SITUACAO S ON
               (M.SITUACAO = S.CD_SITUACAO)
            JOIN TURMAS T ON
               (M.TURMA = T.CODIGO) AND
               (M.ANOSEMESTRE = T.ANOSEMESTRE)
      WHERE
         M.ANOSEMESTRE <= anoSemestre AND
         M.ANOSEMESTRE >= anoSemestreMinimo AND
         P.CD_PESSOA <> P.CD_RESP_FINAN AND
         S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
         T.CD_COLIGADA = coligada AND
         (P.CD_RESP_FINAN = pessoa OR
           (cd_pai = pessoa AND sn_pai_resp = 1 ) OR (cd_mae = pessoa AND sn_mae_resp = 1)
         )
      INTO
         codigoResp;
 
      IF codigoResp IS NOT NULL THEN
         RETURN TRUE;
      END IF;
 
      SELECT
         SN_INCLUIR
      FROM
         NU_GRUPOS_EXCECOES
      WHERE
         CD_GRUPO = 7 AND
         CD_PESSOA = pessoa AND
         CD_COLIGADA = coligada
      INTO
         isRespFinan;
 
      IF isRespFinan THEN
         RETURN TRUE;
      END IF;

   END IF;
 
   RETURN FALSE;
END//]]></atualiza><atualiza codigo="{502B22B5-E7DC-4B2C-85DD-977E7E9BCE7D}" protocolo="ansi"><![CDATA[UPDATE
	prod_alunosprocesso p
	INNER JOIN prod_alunospostagens pa on (p.cd_processo = pa.cd_processo and p.cd_aluno = pa.cd_aluno )
	INNER JOIN
	(
		SELECT
			max(cd_postagem) as cd_postagem
		FROM
    	prod_alunospostagens
	  GROUP BY
		  cd_aluno,cd_Processo
	) as pap ON ( pa.cd_postagem = pap.cd_postagem )
SET
	p.cd_situacao = (CASE WHEN pa.cd_origem = pa.cd_aluno THEN 1 ELSE 0 END)
WHERE
	p.cd_situacao <> 2;
	
	]]></atualiza><atualiza codigo="{3F6155C9-1157-4EB4-853D-A0E37F075231}" protocolo="ansi"><![CDATA[ALTER TABLE retorno ADD COLUMN cd_coligada smallint(6) NULL;

