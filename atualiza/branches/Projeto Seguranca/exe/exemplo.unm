 '12005' and cd_modulo =(SELECT cd_modulo FROM nu_modulos WHERE
 ds_chave = 'Exportacao')), 31);]]></atualiza><atualiza codigo="{27BABDC6-519C-4ADC-B042-1F05B18E74AE}" protocolo="mysql-5"><![CDATA[CREATE TABLE professores_unidades (
  cd_professor int(10) unsigned NOT NULL,
