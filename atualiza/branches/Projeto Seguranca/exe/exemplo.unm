INSERT INTO NU_GRUPOS_PERMISSOES
   (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   GP.CD_GRUPO,
   CASE
      WHEN DS_CHAVE = '5001' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Cadastros.TiposPessoas' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
      WHEN DS_CHAVE = '5002' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Cadastros.Atividades' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
      WHEN DS_CHAVE = '5011' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Cadastros.PlanosDescontos' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
      WHEN DS_CHAVE = '5021' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'PlanilhaInscricoes' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
      WHEN DS_CHAVE = '5022' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'PlanilhaInscricoes.GerarMensalidades' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
      WHEN DS_CHAVE = '5023' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'ResgatarPagamentos' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
      WHEN DS_CHAVE = '5024' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Financeiro.Cobranca' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
      WHEN DS_CHAVE = '5031' THEN (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE = 'Relatorios' AND CD_MODULO = (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'ExtraCurriculares'))
   END,
   GP.NR_PERMISSAO
FROM
   NU_GRUPOS_PERMISSOES GP
      JOIN NU_MODULOS_ACOES A ON
         (GP.CD_ACAO = A.CD_ACAO)
WHERE
   A.DS_CHAVE IN ('5001', '5002', '5011', '5021', '5022', '5023', '5024', '5031');

DELETE FROM NU_GRUPOS_PERMISSOES GP
WHERE EXISTS
   (
   SELECT
	    M.CD_MODULO
   FROM
      NU_MODULOS M
         JOIN NU_MODULOS_ACOES A ON
            (M.CD_MODULO = A.CD_MODULO)
   WHERE
      A.DS_CHAVE IN ('5001', '5002', '5011', '5021', '5022', '5023', '5024', '5031') AND
      M.DS_CHAVE = 'ExtraCurriculares' AND
      A.CD_ACAO = GP.CD_ACAO
   );

DELETE FROM NU_MODULOS_ACOES A
WHERE EXISTS
   (
   SELECT
      M.CD_MODULO
   FROM
      NU_MODULOS M
   WHERE
      M.CD_MODULO = A.CD_MODULO AND
      A.DS_CHAVE IN ('5001', '5002', '5011', '5021', '5022', '5023', '5024', '5031')
   );

ALTER TABLE EXTRA_MATRICULAS_ATIVIDADES ADD CD_MENSALIDADE NUMBER(9) NULL;

ALTER TABLE EXTRA_MATRICULAS_ATIVIDADES
   ADD CONSTRAINT FK_MATRCS_ATVADS_MENS_CD_MENSA FOREIGN KEY (CD_MENSALIDADE) REFERENCES MENSALIDADES (CD_MENSALIDADE);

UPDATE EXTRA_MATRICULAS_ATIVIDADES MA
SET
   MA.CD_MENSALIDADE = (
      SELECT
         M.CD_MENSALIDADE
      FROM
         EXTRA_MATRICULAS M
      WHERE
         M.NR_ANOSEMESTRE = MA.NR_ANOSEMESTRE AND
         M.NR_MES = MA.NR_MES AND
         M.CD_PESSOA = MA.CD_PESSOA
);

ALTER TABLE EXTRA_MATRICULAS DROP(CD_MENSALIDADE);

ALTER TABLE EXTRA_TIPOS_PESSOAS MODIFY (TP_PESSOA CHAR(1 CHAR));

ALTER TABLE EXTRA_MATRICULAS MODIFY (CD_TURMA_MATRICULA VARCHAR2(50 CHAR));]]></atualiza><atualiza codigo="{C6B29A10-0262-48D1-95A0-769BFE5EB014}" protocolo="mysql-5"><![CDATA[update parametros set ds_valor = md5('$audadesJav@') where ds_variavel = 'sis_senha_principal';
