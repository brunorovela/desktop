# -------------------------------------------------------------------------------------------
# PROCEDURE PARA INICIAR O DIARIO EM CURSO / TURMA / DISCIPLINA
# -------------------------------------------------------------------------------------------
CREATE OR REPLACE 
PROCEDURE DIA_INICIAR_DIARIO(CD_CURSO VARCHAR2, CD_TURMA VARCHAR2, CD_DISCIPLINA INTEGER, CD_PROFESSOR INTEGER, NR_ANOSEMESTRE INTEGER, NR_ETAPA INTEGER)
    DETERMINISTIC
IS
BEGIN
     INSERT INTO DIARIO_TURMAS (turma, anosemestre, disciplina, bimestre, professor, curso)
     VALUES
     (CD_TURMA,NR_ANOSEMESTRE,CD_DISCIPLINA, NR_ETAPA, CD_PROFESSOR, CD_CURSO);

     INSERT INTO DIARIO_MATRICULAS (codaluno, turma, anosemestre, disciplina, bimestre, situacao)
     SELECT
           fi.codigoaluno, tp.turma, tp.anosemestre, tp.disciplina, NR_ETAPA, fi.situacao
     FROM
         fichaindividual fi
         INNER JOIN turmasprofessores tp
               ON (fi.turma = tp.turma AND fi.anosemestre = tp.anosemestre AND fi.disciplina = tp.disciplina)
         INNER JOIN situacao s ON(fi.situacao = s.cd_situacao)
     WHERE
          s.cd_situacao_pai in (0, 1, 2, 9) AND
          tp.anosemestre = NR_ANOSEMESTRE  AND
          tp.curso = CD_CURSO AND
          tp.turma = CD_TURMA AND
          tp.disciplina = CD_DISCIPLINA AND
          tp.professor = CD_PROFESSOR;

     INSERT INTO DIARIOS_DESCRICOES (nr_anosemestre, cd_turma, nr_disciplina, cd_pessoa, nr_avaliacao)
     SELECT
           tp.anosemestre, tp.turma, tp.disciplina, fi.codigoaluno, NR_ETAPA
     FROM
         fichaindividual fi
         INNER JOIN turmasprofessores tp
               ON (fi.turma = tp.turma AND fi.anosemestre = tp.anosemestre AND fi.disciplina = tp.disciplina)
         INNER JOIN situacao s ON(fi.situacao = s.cd_situacao)
     WHERE
          s.cd_situacao_pai in (0, 1, 2, 9) AND
          tp.anosemestre =  NR_ANOSEMESTRE AND
          tp.curso = CD_CURSO AND
          tp.turma = CD_TURMA AND
          tp.disciplina = CD_DISCIPLINA AND
          tp.professor = CD_PROFESSOR;
END//]]></atualiza><atualiza codigo="{0DE6F774-2EA5-497A-A7D9-DDF143667A37}" protocolo="mysql-5"><![CDATA[ALTER TABLE cursos_turmas_campos_adicionais RENAME `cursos_turmas_extras`;
ALTER TABLE `cursos_turmas_extras`  ADD `nr_ordem_externa` TINYINT UNSIGNED NULL;
ALTER TABLE `cursos_turmas_extras` ADD `sn_apenas_cadastro` TINYINT UNSIGNED DEFAULT '0' NULL;]]></atualiza><atualiza codigo="{0DE6F774-2EA5-497A-A7D9-DDF143667A37}" protocolo="oracle"><![CDATA[ALTER TABLE "UNIMESTRE"."CURSOS_TURMAS_EXTRAS"
ADD ( "NR_ORDEM_EXTRA" NUMBER(5) NULL  ) 
ADD ( "SN_APENAS_CADASTRO" NUMBER(5) NULL  ); ]]></atualiza><atualiza codigo="{33CB2E98-4775-4B8F-9F48-6B4498C1A5D7}" protocolo="mysql-5"><![CDATA[ALTER TABLE `nu_grupos_pessoas`
