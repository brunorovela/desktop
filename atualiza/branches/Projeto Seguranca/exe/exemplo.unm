DROP FUNCTION IF EXISTS GET_COMPRAS_QTD_ESTOQUE//
DROP FUNCTION IF EXISTS GET_COMPRAS_QTD_ESTOQUE_LIMIT//
DROP FUNCTION IF EXISTS GET_COMP_QTD_PRODUTOS_PESSOA//

CREATE FUNCTION `GET_COMPRAS_QTD_ESTOQUE`(`PARAM_CD_PRODUTO` varchar(30))
 RETURNS int(11) SIGNED
BEGIN
	DECLARE retorno INT(11) DEFAULT 0;

	SELECT
		SUM(
			CASE WHEN TP_ENTRADA_SAIDA = 1 || TP_ENTRADA_SAIDA = 3 THEN
				COALESCE( NR_QUANTIDADE, 0 )
			ELSE
				0-COALESCE( NR_QUANTIDADE, 0 )
			END
		) AS registros
	INTO retorno
	FROM COMP_ESTOQUE
	WHERE CD_PRODUTO = PARAM_CD_PRODUTO;

	RETURN COALESCE(retorno, 0);
END//

CREATE FUNCTION `GET_COMPRAS_QTD_ESTOQUE_LIMIT`(`PARAM_CD_PRODUTO` varchar(30), `PARAM_DT_ENTRADA` DATETIME, `PARAM_DIAS_ANTERIORES` INT(2))
 RETURNS int(11) SIGNED
BEGIN
	DECLARE retorno INT(11) DEFAULT 0;

	SELECT
		SUM(
			CASE WHEN TP_ENTRADA_SAIDA = 1 || TP_ENTRADA_SAIDA = 3 THEN
				COALESCE( NR_QUANTIDADE, 0 )
			ELSE
				0-COALESCE( NR_QUANTIDADE, 0 )
			END
		) AS registros
	INTO retorno
	FROM COMP_ESTOQUE
	WHERE CD_PRODUTO = PARAM_CD_PRODUTO AND DT_ENTRADA <= DATE_FORMAT(DATE_ADD(PARAM_DT_ENTRADA,INTERVAL -PARAM_DIAS_ANTERIORES DAY),'%Y-%m-%d 23:59:59');

	RETURN COALESCE(retorno, 0);
END//

CREATE FUNCTION `GET_COMP_QTD_PRODUTOS_PESSOA`(`PARAM_CD_PESSOA` int(11), `PARAM_DT_ENTRADA` DATETIME, `PARAM_DT_SAIDA` DATETIME)
 RETURNS int(11) SIGNED
BEGIN
	DECLARE retorno INT(11) DEFAULT 0;

	SELECT
		SUM(NR_QUANTIDADE) AS registros
	INTO retorno
	FROM COMP_ESTOQUE
	WHERE CD_PESSOA = PARAM_CD_PESSOA AND TP_ENTRADA_SAIDA = 2 AND
				DT_ENTRADA >= DATE_FORMAT( PARAM_DT_ENTRADA, '%Y-%m-%d 00:00:00' ) AND
				DT_ENTRADA <= DATE_FORMAT( PARAM_DT_SAIDA, '%Y-%m-%d 23:59:59' );

	RETURN COALESCE(retorno, 0);
END//

DELIMITER ;]]></atualiza><atualiza codigo="{CE24EE3D-FBC4-49BE-BF1D-E2690432C30E}" protocolo="mysql-5"><![CDATA[select 1 ;]]></atualiza><atualiza codigo="{CE24EE3D-FBC4-49BE-BF1D-E2690432C30E}" protocolo="oracle"><![CDATA[ALTER TABLE DISP_HORARIOS 
