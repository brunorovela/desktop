SET SQL_LOG_BIN := 0//
SET GLOBAL log_bin_trust_function_creators := 1//

INSERT INTO nu_grupos (cd_grupo, ds_nome_grupo, sn_fixo, ds_papel) VALUES (999, 'Responsáveis', 1, 'RESP_UNIFICADO')//
UPDATE nu_grupos SET ds_papel = 'RESP_UNIFICADO' WHERE ds_papel = 'RESP'//
UPDATE nu_grupos SET cd_grupo = 999 WHERE ds_papel = 'RESP_UNIFICADO'//

INSERT INTO nu_grupos_hierarquia (cd_grupo, cd_grupo_liberado) VALUES (1, 999)//



DROP PROCEDURE IF EXISTS SPA_ATUALIZA_GRUPOS_PESSOA//
 
CREATE PROCEDURE `SPA_ATUALIZA_GRUPOS_PESSOA`(IN `pessoa` INTEGER, IN `coligada` INTEGER)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   IF FCD_GRUPO_ESTUDANTES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (2, pessoa, coligada );
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 2 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_PROFESSORES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (3, pessoa, coligada );
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 3 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
   IF FCD_GRUPO_COORDENADORES(pessoa, coligada) THEN
      INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
      VALUES (4, pessoa, coligada );
   ELSE
      DELETE FROM NU_GRUPOS_PESSOAS
      WHERE
         CD_GRUPO = 4 AND
         CD_PESSOA = pessoa AND
	 CD_COLIGADA = coligada;
   END IF;
 
	 IF FCD_GRUPO_RESPACADEMICO(pessoa, coligada) AND FCD_GRUPO_RESPFINANCEIRO(pessoa, coligada) THEN
			INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
			VALUES (999, pessoa, coligada);

			DELETE FROM NU_GRUPOS_PESSOAS
				 WHERE
					  CD_GRUPO = 6 AND
						CD_PESSOA = pessoa AND
			      CD_COLIGADA = coligada;

			DELETE FROM NU_GRUPOS_PESSOAS
				 WHERE
					  CD_GRUPO = 7 AND
						CD_PESSOA = pessoa AND
			      CD_COLIGADA = coligada;
	 ELSE
			DELETE FROM NU_GRUPOS_PESSOAS
			WHERE
				 CD_GRUPO = 999 AND
				 CD_PESSOA = pessoa AND
				 CD_COLIGADA = coligada;
	
			IF FCD_GRUPO_RESPACADEMICO(pessoa, coligada) THEN
				 INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
			 	 VALUES (6, pessoa, coligada);
			ELSE
				 DELETE FROM NU_GRUPOS_PESSOAS
				 WHERE
					  CD_GRUPO = 6 AND
						CD_PESSOA = pessoa AND
			      CD_COLIGADA = coligada;
			END IF;
		 
			IF FCD_GRUPO_RESPFINANCEIRO(pessoa, coligada) THEN
			 	 INSERT IGNORE INTO NU_GRUPOS_PESSOAS (CD_GRUPO, CD_PESSOA, CD_COLIGADA)
				 VALUES (7, pessoa, coligada);
			ELSE
				 DELETE FROM NU_GRUPOS_PESSOAS
				 WHERE
					  CD_GRUPO = 7 AND
						CD_PESSOA = pessoa AND
			      CD_COLIGADA = coligada;
			END IF;

	 END IF;

END//]]></atualiza><atualiza codigo="{B7ED9E11-6BB1-4728-8C6F-12275EDA5272}" protocolo="mysql-5"><![CDATA[INSERT INTO nu_modulos_acoes(
