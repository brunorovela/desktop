INSERT INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   GP.CD_GRUPO,
   CASE
      WHEN A.DS_CHAVE = '2019' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Financeiro' AND M.DS_CHAVE = 'UMFinanceiro')
      WHEN A.DS_CHAVE = '2024' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Fin.Restrita' AND M.DS_CHAVE = 'UMFinanceiro')
      WHEN A.DS_CHAVE = '1017' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Matricula' AND M.DS_CHAVE = 'Academico')
      WHEN A.DS_CHAVE = '1021' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Pedagogico' AND M.DS_CHAVE = 'Academico')
   END,
   GP.NR_PERMISSAO
FROM
   NU_GRUPOS_PERMISSOES GP
      JOIN NU_MODULOS_ACOES A ON
         (GP.CD_ACAO = A.CD_ACAO)
WHERE
   A.DS_CHAVE IN ('1017', '1021', '2019', '2024');

DELETE FROM NU_GRUPOS_PERMISSOES
WHERE
   CD_ACAO IN
      (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE IN ('1017', '1021', '2019', '2024'));

DELETE FROM NU_MODULOS_ACOES WHERE DS_CHAVE IN ('1017', '1021', '2019', '2024');

INSERT INTO UNI_OBSERVACOES (CD_PESSOA, CD_USUARIO, DT_OBSERVACAO, SG_TIPO, ME_OBSERVACAO)
SELECT
   CODIGOALUNO,
   (SELECT CD_PESSOA FROM PESSOAS WHERE DS_LOGIN LIKE 'admin'),
   NOW(),
   'F',
   OBSERVACOES
FROM
   OBSERVACOESFINANCEIRAS
WHERE
   OBSERVACOES IS NOT NULL;

INSERT INTO UNI_OBSERVACOES (CD_PESSOA, CD_USUARIO, DT_OBSERVACAO, SG_TIPO, ME_OBSERVACAO)
SELECT
   CODIGOALUNO,
   (SELECT CD_PESSOA FROM PESSOAS WHERE DS_LOGIN LIKE 'admin'),
   NOW(),
   'R',
   OBSERVACOES_ESPECIAIS
FROM
   OBSERVACOESFINANCEIRAS
WHERE
   OBSERVACOES_ESPECIAIS IS NOT NULL;

INSERT INTO UNI_OBSERVACOES (CD_PESSOA, CD_USUARIO, DT_OBSERVACAO, SG_TIPO, ME_OBSERVACAO)
SELECT
   CODIGOALUNO,
