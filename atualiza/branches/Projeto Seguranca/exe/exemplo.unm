(cd_contrato)) TYPE = MyISAM /*!40100 DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci */;

CREATE TABLE conv_contratos (`cd_contrato` INT UNSIGNED AUTO_INCREMENT, `cd_tipo` INT UNSIGNED, 

`cd_pessoa` INT UNSIGNED, `nr_dia_vencimento` INT UNSIGNED, `cd_coligada` INT UNSIGNED, `sn_ativo` 

INT UNSIGNED, `vl_contrato` DOUBLE UNSIGNED, PRIMARY KEY(`cd_contrato`)) TYPE = MyISAM /*!40100 

DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci */;

CREATE TABLE `conv_contratos_turmas` (`cd_contrato` INT, `cd_turma` VARCHAR (50), PRIMARY KEY

(`cd_contrato`,`cd_turma`)) TYPE = MyISAM /*!40100 DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci 

*/;

CREATE TABLE `conv_repasses` (`cd_repasse` INT UNSIGNED AUTO_INCREMENT, `cd_contrato` INT UNSIGNED, 

`cd_pessoa` INT UNSIGNED, `cd_turma` VARCHAR (50), `vl_remessa` DOUBLE UNSIGNED, `nr_total_parcelas` 

INT, `dt_inicio_repasse` DATETIME, PRIMARY KEY(`cd_repasse`)) TYPE = MyISAM /*!40100 DEFAULT CHARSET 

latin1 COLLATE latin1_swedish_ci */;

CREATE TABLE `conv_repasses_mensal` (`cd_turma` VARCHAR (50), `cd_contrato` INT UNSIGNED, 

`nr_mes_ano_ref` INT UNSIGNED, `nr_parcela_atual` INT UNSIGNED, `nr_total_parcelas` INT UNSIGNED, 

`vl_total_repasse` DOUBLE UNSIGNED, `nr_total_alunos` INT UNSIGNED, `vl_deducao` DOUBLE UNSIGNED, 

`vl_acrescimo` DOUBLE UNSIGNED, `ds_observacao` MEDIUMTEXT, `cd_pessoa_log` INT UNSIGNED, PRIMARY 

KEY(`cd_turma`,`cd_contrato`,`nr_mes_ano_ref`,`nr_parcela_atual`,`nr_total_parcelas`)) TYPE = MyISAM 

/*!40100 DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci */;


