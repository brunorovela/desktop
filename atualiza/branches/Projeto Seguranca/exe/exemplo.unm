CREATE OR REPLACE TRIGGER TAI_SALVA_HIST_TURMA AFTER INSERT ON GCOML_TURMAS REFERENCING OLD AS "OLD" NEW AS "NEW" FOR EACH ROW
BEGIN
   INSERT INTO GCOML_HISTORICO
      (CD_TURMA, NR_ANOSEMESTRE, NR_META, VL_DESCONTO, VL_COMISSAO, DT_INICIO)
   VALUES
      (:NEW.CD_TURMA, :NEW.NR_ANOSEMESTRE, :NEW.NR_META, :NEW.VL_DESCONTO, :NEW.VL_COMISSAO, SYSDATE);
END//

CREATE OR REPLACE TRIGGER TAU_SALVA_HIST_TURMA AFTER UPDATE ON GCOML_TURMAS REFERENCING OLD AS "OLD" NEW AS "NEW" FOR EACH ROW
BEGIN
   UPDATE GCOML_HISTORICO
   SET
      DT_FIM = SYSDATE
   WHERE
      CD_TURMA = :OLD.CD_TURMA AND
      NR_ANOSEMESTRE = :OLD.NR_ANOSEMESTRE AND
      DT_FIM IS NULL;

   INSERT INTO GCOML_HISTORICO
      (CD_TURMA, NR_ANOSEMESTRE, NR_META, VL_DESCONTO, VL_COMISSAO, DT_INICIO)
   VALUES
      (:NEW.CD_TURMA, :NEW.NR_ANOSEMESTRE, :NEW.NR_META, :NEW.VL_DESCONTO, :NEW.VL_COMISSAO, SYSDATE);
END//

CREATE OR REPLACE TRIGGER TBD_SALVA_HIST_TURMA BEFORE DELETE ON GCOML_TURMAS REFERENCING OLD AS "OLD" NEW AS "NEW" FOR EACH ROW
BEGIN
   UPDATE GCOML_HISTORICO
   SET
      DT_FIM = SYSDATE
   WHERE
      CD_TURMA = :OLD.CD_TURMA AND
      NR_ANOSEMESTRE = :OLD.NR_ANOSEMESTRE AND
      DT_FIM IS NULL;
END//

CREATE OR REPLACE TRIGGER TAI_SALVA_HIST_TURMA_CAMPANHA AFTER INSERT ON GCOML_TURMAS_CAMPANHAS REFERENCING OLD AS "OLD" NEW AS "NEW" FOR EACH ROW
BEGIN
   INSERT INTO GCOML_HISTORICO_CAMPANHAS
      (CD_CAMPANHA, CD_HISTORICO)
   SELECT
      :NEW.CD_CAMPANHA,
      CD_HISTORICO
   FROM
      GCOML_HISTORICO
   WHERE
      CD_TURMA = :NEW.CD_TURMA AND
      NR_ANOSEMESTRE = :NEW.NR_ANOSEMESTRE AND
      DT_FIM IS NULL;
END//

CREATE OR REPLACE TRIGGER TAD_SALVA_HIST_TURMA_CAMPANHA BEFORE DELETE ON GCOML_TURMAS_CAMPANHAS REFERENCING OLD AS "OLD" NEW AS "NEW" FOR EACH ROW
DECLARE
   antigo NUMBER(19);
   novo NUMBER(19);
BEGIN

   SELECT
      CD_HISTORICO
   INTO
      antigo
   FROM
      GCOML_HISTORICO
   WHERE
      CD_TURMA = :OLD.CD_TURMA AND
      NR_ANOSEMESTRE = :OLD.NR_ANOSEMESTRE AND
      DT_FIM IS NULL;

   UPDATE GCOML_HISTORICO
   SET
      DT_FIM = SYSDATE
   WHERE
      CD_HISTORICO = antigo;

   INSERT INTO GCOML_HISTORICO
      (CD_TURMA, NR_ANOSEMESTRE, NR_META, VL_DESCONTO, VL_COMISSAO, DT_INICIO)
   SELECT
      CD_TURMA,
      NR_ANOSEMESTRE,
      NR_META,
      VL_DESCONTO,
      VL_COMISSAO,
      SYSDATE
   FROM
      GCOML_HISTORICO
   WHERE
      CD_HISTORICO = antigo;

   novo := PACKAGE_LAST_INSERT_ID.GET_LAST_INSERT_ID();

   INSERT INTO GCOML_HISTORICO_CAMPANHAS
      (CD_CAMPANHA, CD_HISTORICO)
   SELECT
      CD_CAMPANHA,
      novo
   FROM
      GCOML_HISTORICO_CAMPANHAS
   WHERE
      CD_HISTORICO = antigo AND
      CD_CAMPANHA <> :OLD.CD_CAMPANHA;
END//

