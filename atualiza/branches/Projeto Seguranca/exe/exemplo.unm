  "CD_CONTRATO" NUMBER(19) NULL , 
  "CD_TIPO" NUMBER(19) NULL , 
	"CD_PESSOA" NUMBER(19) NULL , 
  "NR_DIA_VENCIMENTO" NUMBER(19) NULL , 
  "CD_COLIGADA" NUMBER(19) NULL, 
  "SN_ATIVO" NUMBER(19) NULL , 
  "VL_CONTRATO" FLOAT(126) NULL 
)
NOCOMPRESS;

ALTER TABLE "CONV_CONTRATOS" ADD PRIMARY KEY ("CD_CONTRATO");

CALL CRIAR_AUTO_INCREMENT('CONV_CONTRATOS', 'CD_CONTRATO', 'SEQ_CONV_CONTRATOS', 'AUTOINC_CONV_CONTRATOS');


CREATE TABLE CONV_CONTRATOS_TURMAS 
( 
  CD_CONTRATO NUMBER(9), 
  CD_TURMA VARCHAR2(50)
)NOCOMPRESS;

