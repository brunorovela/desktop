ALTER TABLE expo_layouts ADD COLUMN SN_USAR_CH_SIT TINYINT(1) UNSIGNED NOT NULL DEFAULT 1;]]></atualiza><atualiza codigo="{79343B9C-BF01-47C9-B21D-2236AB3FB5E5}" protocolo="ansi"><![CDATA[create table map_materialprofessor_corrige
