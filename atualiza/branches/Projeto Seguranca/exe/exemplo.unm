ALTER TABLE `fin_orcamentos_valores` CHANGE COLUMN `cd_orcamentos` `cd_orcamento`  int(11) UNSIGNED NOT NULL DEFAULT 0;

ALTER TABLE `fin_demonstrativo` DROP INDEX `Unicos` , ADD UNIQUE INDEX `Unicos` USING BTREE (`ds_grupo`, `nr_mes`, `nr_ano`, `cd_classificacao`);
ALTER TABLE `fin_demonstrativo` DROP COLUMN `cd_conta`;]]></atualiza><atualiza codigo="{00AD2EE1-8A56-4EAC-8007-6E8963734126}" protocolo="oracle"><![CDATA[ALTER TABLE "FIN_ORCAMENTO" RENAME TO "FIN_ORCAMENTOS_VALORES";
ALTER TABLE "FIN_ORCAMENTOS" RENAME TO "FIN_ORCAMENTO";

ALTER TABLE "FIN_ORCAMENTOS_VALORES" RENAME COLUMN "CD_ORCAMENTO" TO "CD_ORCAMENTOS_VALORES";
ALTER TABLE "FIN_ORCAMENTOS_VALORES" RENAME COLUMN "CD_ORCAMENTOS" TO "CD_ORCAMENTO";

DROP INDEX "UNIMESTRE"."Unicos";
CREATE UNIQUE INDEX "Unicos" ON "FIN_DEMONSTRATIVO" ("DS_GRUPO" ASC, "NR_MES" ASC, "NR_ANO" ASC, "CD_CLASSIFICACAO" ASC);

ALTER TABLE fin_demonstrativo DROP COLUMN cd_conta;]]></atualiza><atualiza codigo="{68DE2C12-DCFA-4972-98C1-8A83783682E2}" protocolo="mysql-5"><![CDATA[SELECT 1;]]></atualiza><atualiza codigo="{68DE2C12-DCFA-4972-98C1-8A83783682E2}" protocolo="oracle"><![CDATA[CREATE OR REPLACE 
PROCEDURE "PROC_COMPETENCIA"(COD_NEGOCIA IN NUMBER)
AS
	CONT_ATUAL INTEGER(11);
	CONT_NOVA INTEGER(11);
	POS_ATUAL INTEGER(11);
	POS_NOVA INTEGER(11);
  COD_ATUAL INTEGER(11);   
								
	M_ATUAL_CODIGO INTEGER(11);
	M_ATUAL_VALOR FLOAT;
    
	M_NOVA_CODIGO INTEGER(11);
	M_NOVA_VALOR FLOAT;   
  
	M_COMPENSADO_VALOR FLOAT;
	M_COMPENSAR FLOAT;
  
	M_ATUAL_DATA DATE;
  
	dsdtcompetencia VARCHAR2(500);
	dtcompetencia DATE;
 
  CONTA_DEBUG INTEGER(11) := 0;

	CURSOR CUR_ATUAIS IS
      SELECT
           COALESCE(C.CD_MENSALIDADE, M.CD_MENSALIDADE) AS CD_MENSALIDADE
          , COALESCE(C.VL_COMPETENCIA, ROUND(COALESCE(M.VALORBRUTO, 0),6) + ROUND(COALESCE(M.VALOREXTRA, 0),6) - ROUND(COALESCE(M.DESCONTOEXTRA, 0),6))
          , COALESCE(M2.DT_COMPETENCIA, M.DT_COMPETENCIA) AS DT_COMPETENCIA
      FROM
          FIN_NEGOCIA_PARC_ATUAL FNPA
          INNER JOIN MENSALIDADES M ON (FNPA.CD_MENSALIDADE = M.CD_MENSALIDADE)
          LEFT JOIN FIN_NEGOCIA_COMPETENCIA C ON (M.CD_MENSALIDADE = C.CD_MENSALIDADE_NOVA AND C.SN_RENEGOCIADA = 0 AND C.VL_COMPETENCIA > 0)
          LEFT JOIN MENSALIDADES M2 ON (C.CD_MENSALIDADE = M2.CD_MENSALIDADE)
      WHERE
          FNPA.CD_NEGOCIA = COD_NEGOCIA 
          AND M.VALORBRUTO > 0
      ORDER BY
          M.DT_COMPETENCIA, M.CD_MENSALIDADE;     
  
		CURSOR CUR_ATUAIS_ROWNUM IS
			SELECT
 				 MAX(ROWNUM) INTO CONT_ATUAL
       FROM
         FIN_NEGOCIA_PARC_ATUAL FNPA
          INNER JOIN MENSALIDADES M ON (FNPA.CD_MENSALIDADE = M.CD_MENSALIDADE)
          LEFT JOIN FIN_NEGOCIA_COMPETENCIA C ON (M.CD_MENSALIDADE = C.CD_MENSALIDADE_NOVA AND C.SN_RENEGOCIADA = 0 AND C.VL_COMPETENCIA > 0)
          LEFT JOIN MENSALIDADES M2 ON (C.CD_MENSALIDADE = M2.CD_MENSALIDADE)
      WHERE
          FNPA.CD_NEGOCIA = COD_NEGOCIA
          AND M.VALORBRUTO > 0
      ORDER BY
					M.DT_COMPETENCIA, M.CD_MENSALIDADE;     

	CURSOR CUR_NOVAS IS
			SELECT 
					 m.cd_mensalidade, ROUND(COALESCE(m.valorbruto, 0),6)
			FROM
					fin_negocia_parc_nova fnpn
					INNER JOIN mensalidades m ON (fnpn.cd_mensalidade = m.cd_mensalidade)
			WHERE
					fnpn.cd_negocia = COD_NEGOCIA   
					AND m.valorbruto > 0 
			ORDER BY
					m.dt_competencia, m.cd_mensalidade;

		
  	
BEGIN
	OPEN CUR_ATUAIS;
	POS_ATUAL := 0;  

  OPEN CUR_NOVAS;
  POS_NOVA := 0;  

	SELECT 
		MAX(ROWNUM) INTO CONT_NOVA
  FROM
		fin_negocia_parc_nova fnpn
    INNER JOIN mensalidades m ON (fnpn.cd_mensalidade = m.cd_mensalidade)
  WHERE
    fnpn.cd_negocia = COD_NEGOCIA   
    AND m.valorbruto > 0 
  ORDER BY
    m.dt_competencia, m.cd_mensalidade  ;

			SELECT
 				 MAX(ROWNUM) INTO CONT_ATUAL
       FROM
         FIN_NEGOCIA_PARC_ATUAL FNPA
          INNER JOIN MENSALIDADES M ON (FNPA.CD_MENSALIDADE = M.CD_MENSALIDADE)
          LEFT JOIN FIN_NEGOCIA_COMPETENCIA C ON (M.CD_MENSALIDADE = C.CD_MENSALIDADE_NOVA AND C.SN_RENEGOCIADA = 0 AND C.VL_COMPETENCIA > 0)
          LEFT JOIN MENSALIDADES M2 ON (C.CD_MENSALIDADE = M2.CD_MENSALIDADE)
      WHERE
          FNPA.CD_NEGOCIA = COD_NEGOCIA
          AND M.VALORBRUTO > 0
      ORDER BY
					M.DT_COMPETENCIA, M.CD_MENSALIDADE;     

 	 M_ATUAL_CODIGO := NULL;
   M_NOVA_CODIGO := NULL;
   M_ATUAL_VALOR := 0;
   M_NOVA_VALOR  := 0;     

   CONTA_DEBUG := 0;                      

	EXECUTE IMMEDIATE '
	UPDATE
		fin_negocia_competencia
	SET
		sn_renegociada = 1	
	WHERE 
		cd_negocia_competencia in
  (
		SELECT
			c.cd_negocia_competencia
	  FROM
			fin_negocia_parc_atual fnpa
			INNER JOIN mensalidades m ON (fnpa.cd_mensalidade = m.cd_mensalidade)
      INNER JOIN fin_negocia_competencia c ON (m.cd_mensalidade = c.cd_mensalidade_nova AND c.sn_renegociada = 0 )
      INNER JOIN mensalidades m2 ON (c.cd_mensalidade = m2.cd_mensalidade)
   WHERE
			m.valorbruto > 0 AND
			fnpa.cd_negocia = :1
	)
' USING COD_NEGOCIA ;

   SELECT ds_valor INTO dsdtcompetencia FROM parametros WHERE ds_variavel = 'financeiro_data_fatura_negocia' ;
   dtcompetencia := TO_DATE(dsdtcompetencia ,'YYYY-MM-DD');    

  WHILE ((CONT_NOVA > POS_NOVA OR CONT_ATUAL > POS_ATUAL) OR (ROUND(M_NOVA_VALOR,3) > 0 ))      
	LOOP
		POS_NOVA := POS_NOVA +1 ;
    CONTA_DEBUG := CONTA_DEBUG + 1;       
 	  IF CONTA_DEBUG > 100 THEN
			POS_NOVA := CONT_NOVA + 1;                                        
      POS_ATUAL := CONT_ATUAL + 1;  
   	END IF; 

 		IF ((NOT M_NOVA_VALOR > 0) AND (POS_NOVA < CONT_NOVA)) THEN
	    FETCH CUR_NOVAS INTO M_NOVA_CODIGO, M_NOVA_VALOR;
 			POS_NOVA := POS_NOVA + 1;      
 			COD_ATUAL := M_ATUAL_CODIGO;

      if M_ATUAL_DATA < dtcompetencia THEN 
 				 M_ATUAL_CODIGO := M_NOVA_CODIGO;
      END IF;           
      POS_ATUAL := POS_ATUAL + 1;                                            
    END IF;
 
	              
 M_COMPENSAR := 0;

 IF (ROUND(M_NOVA_VALOR,3) > 0 AND M_ATUAL_VALOR = 0) THEN
 	 INSERT INTO fin_negocia_competencia (cd_negocia_competencia, cd_mensalidade, cd_mensalidade_nova, vl_competencia, vl_baixado, sn_renegociada) 
   VALUES (NULL, M_NOVA_CODIGO, M_NOVA_CODIGO, M_NOVA_VALOR, 0, 0);       
   UPDATE mensalidades SET vl_faturamento = IFNULL(vl_faturamento, 0) + M_NOVA_VALOR WHERE cd_mensalidade = M_NOVA_CODIGO;
   M_NOVA_VALOR := 0;                                    
ELSIF M_ATUAL_VALOR > 0 THEN      
   
	IF M_ATUAL_VALOR > M_NOVA_VALOR THEN
		M_COMPENSAR  := M_NOVA_VALOR;
    M_NOVA_VALOR := 0;
    M_ATUAL_VALOR := M_ATUAL_VALOR - M_COMPENSAR;
  ELSIF M_NOVA_VALOR > M_ATUAL_VALOR THEN
 		M_COMPENSAR 	:= M_ATUAL_VALOR;
    M_ATUAL_VALOR := 0;
    M_NOVA_VALOR  := M_NOVA_VALOR - M_COMPENSAR;
  ELSE
    M_COMPENSAR   := M_NOVA_VALOR;
    M_ATUAL_VALOR := 0;
    M_NOVA_VALOR  := 0;
  END IF;              

   IF (ROUND(M_COMPENSAR,3) > 0) THEN   
  		INSERT INTO fin_negocia_competencia (cd_negocia_competencia, cd_mensalidade, cd_mensalidade_nova, vl_competencia, vl_baixado, sn_renegociada) 
      VALUES (NULL, M_ATUAL_CODIGO, M_NOVA_CODIGO, M_COMPENSAR, 0, 0);
   END IF;    
	END IF;   
 END LOOP;

  
 CLOSE CUR_ATUAIS;
 CLOSE CUR_NOVAS;   

END;]]></atualiza><atualiza codigo="{5CB3BA03-6181-4048-8735-A28260D44393}" protocolo="ansi"><![CDATA[UPDATE expo_campos ec
SET ds_campo = CONCAT( 'Descrição do campo ', nm_campo )
WHERE LENGTH( ec.ds_campo ) = 0;]]></atualiza><atualiza codigo="{4D3D0B8D-CD7A-48C8-AB39-84B7DC20D3BB}" protocolo="ansi"><![CDATA[INSERT INTO `nu_modulos_acoes` (`ds_nome_acao`, `ds_chave`, cd_modulo ) VALUES 
