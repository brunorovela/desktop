	ds_chave = 'ProvaOnlineGerenciarAssuntos'
WHERE 
	ds_chave LIKE 'GerenciamentoAssuntos' AND
	cd_modulo = (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'ProvaOnline');


UPDATE 
	nu_modulos_acoes 
SET 
	ds_nome_acao = 'Acesso ao Prova Online',
	ds_chave = 'ProvaOnline'
WHERE 
	ds_chave LIKE 'ProvaOnlineAdmin' AND
	cd_modulo = (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'ProvaOnline');]]></atualiza><atualiza codigo="{2AD78AB4-0C61-4234-BF40-92CBF5789E4F}" protocolo="ansi"><![CDATA[INSERT INTO nu_parametros (cd_parametro, cd_modulo, ds_parametro, ds_valor, ds_observacao, cd_coligada) VALUES  (NULL, (SELECT cd_modulo FROM nu_modulos WHERE ds_chave LIKE 'Concurso'), 'concursos.inserir_no_grupo', (SELECT cd_grupo FROM nu_grupos WHERE ds_nome_grupo LIKE 'Vestibulandos'), 'Qual o grupo que o usuário que está fazendo a inscrição deve ser inserido', 0);]]></atualiza><atualiza codigo="{50C31F93-DD04-4D95-B2F3-60E5E6FAFD85}" protocolo="ansi"><![CDATA[INSERT INTO 
