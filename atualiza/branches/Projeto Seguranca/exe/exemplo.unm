INSERT INTO map_logs(cd_pessoa,cd_material,dt_abertura) 
SELECT 
  DISTINCT p.cd_pessoa, mpt.cd_material , now()
FROM
    map_materialprofessor_turma mpt
    INNER JOIN fichaindividual f ON (f.turma = mpt.cd_turma AND mpt.nr_anosemestre = f.anosemestre AND mpt.cd_disciplina = f.disciplina)
    INNER JOIN pessoas p ON (p.cd_pessoa = f.codigoaluno);]]></atualiza><atualiza codigo="{F35939DC-D46A-458C-B540-F039303F6454}" protocolo="ansi"><![CDATA[# A conta pode ser alterada.
ALTER TABLE `departamentos`  ADD COLUMN `sn_alterar_boleto` TINYINT(1) NULL DEFAULT '1' AFTER `cd_boleto_padrao`;

# OBS: caso não tenha uma conta selecionada, deixar ENABLED = falso;

# A conta pode ser alterada.
ALTER TABLE `turmas`  ADD COLUMN `sn_alterar_boleto` TINYINT(1) UNSIGNED NULL DEFAULT '1' AFTER `cd_caixa`;

DROP TABLE bloquetos;

CREATE VIEW bloquetos AS 
SELECT me.codigoaluno as cd_aluno
     , me.parcela as nr_parcela
     , me.datavencimento as dt_vencimento
     , me.turma as cd_turma
     , pe.sn_bloqueto_empresa
     , em.nm_empresa
     , em.ds_cnpj
     , me.cd_mensalidade
  FROM mensalidades as me 
 INNER JOIN fin_boleto as bo ON (bo.cd_boleto = me.cd_boleto AND bo.cd_pessoa = me.codigoaluno)
 INNER JOIN pessoas as pe ON (pe.cd_pessoa = me.codigoaluno)
 LEFT JOIN empresas as em ON (em.cd_empresa = pe.cd_empresa );

]]></atualiza><atualiza codigo="{42A736D7-AB44-415C-A492-D293F4F321F7}" protocolo="mysql-5"><![CDATA[INSERT INTO `parametros` (`ds_variavel`, `ds_valor`, `ds_variavel_usuario`) VALUES ('financeiro_recibo_cheques_msg', 'Este comprovante só será válido #13mediante compensação do(s) cheque(s):', 'Mensagem que irá aparecer antes da impressão dos cheques nos recibos');]]></atualiza><atualiza codigo="{42A736D7-AB44-415C-A492-D293F4F321F7}" protocolo="oracle"><![CDATA[INSERT INTO `parametros` (`ds_variavel`, `ds_valor`, `ds_variavel_usuario`) VALUES ('financeiro_recibo_cheques_msg', 'Este comprovante só será válido #13mediante compensação do(s) cheque(s):', 'Mensagem que irá aparecer antes da impressão dos cheques nos recibos');]]></atualiza><atualiza codigo="{DCF3CA81-D0B3-4FBD-B3EC-D3CCAEB0A664}" protocolo="ansi"><![CDATA[DROP VIEW IF EXISTS usuarios;
CREATE VIEW USUARIOS AS
select
	p.cd_usuario_pessoa,
	p.cd_pessoa CODIGO,
	CASE 
  	WHEN (p.sn_bloqueado =1 || COALESCE(ngp.nr_permissao,0) = 0) THEN 'N' 
    ELSE 'S'
	END SN_ONLINE,
	CAST(UPPER(COALESCE(p.ds_login,p.cd_pessoa)) AS CHAR) NOME,
	p.ds_senha SENHA,
	CASE 
  	WHEN (p.sn_bloqueado =1 || COALESCE(ngp.nr_permissao,0) = 0) THEN 'N' 
    ELSE 'S'
	END ONLINE,
	p.cd_pessoa CD_PESSOA
FROM
	pessoas as p
	LEFT JOIN nu_grupos_pessoas as np ON (p.cd_pessoa = np.cd_pessoa)
	LEFT JOIN nu_modulos_acoes as nma ON ( nma.ds_chave = '1' AND nma.cd_modulo = (select cd_modulo from nu_modulos where ds_chave = 'Academico'))
	LEFT JOIN nu_grupos_permissoes as ngp ON (ngp.cd_acao = nma.cd_acao AND np.cd_grupo = ngp.cd_grupo) 
WHERE 
	p.cd_usuario_pessoa is not null
GROUP BY
	p.cd_pessoa;]]></atualiza><atualiza codigo="{22C28FD2-6B07-4692-8BAA-F221C68FF373}" protocolo="ansi"><![CDATA[INSERT INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
SELECT
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Exportacao'),
   MODULO,
   CODIGO
FROM
   MODULOS
WHERE CODIGO = 12005;

