	SELECT cd_acao
	FROM nu_modulos_acoes
	WHERE ds_chave = '1070' AND
				cd_modulo = (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'Academico'));

SET @cd_acao_antiga := (
	SELECT cd_acao
	FROM nu_modulos_acoes
	WHERE ds_chave = '1027' AND
				cd_modulo = (SELECT cd_modulo FROM nu_modulos WHERE ds_chave = 'Academico')
);

INSERT INTO nu_grupos_permissoes (cd_permissao, cd_grupo, cd_acao, nr_permissao)
SELECT
	null, ngp.cd_grupo, @cd_acao_nova, ngp.nr_permissao
FROM
	nu_grupos_permissoes ngp
	LEFT JOIN nu_grupos_permissoes ngpp ON (ngpp.cd_grupo = ngp.cd_grupo AND ngpp.cd_acao = @cd_acao_nova)
WHERE
	ngp.cd_acao = @cd_acao_antiga AND
	ngpp.cd_permissao IS NULL;]]></atualiza><atualiza codigo="{257991B3-E4B1-4E02-8FC5-3C339BA54134}" protocolo="ansi"><![CDATA[ALTER TABLE `diario_turmas`  CHANGE COLUMN `ds_ativ_extra` `ds_ativ_extra` LONGTEXT NULL;]]></atualiza><atualiza codigo="{2FBF4CC1-1013-4750-9443-4F77B34B9B9F}" protocolo="ansi"><![CDATA[ALTER TABLE `diarios_descricoes` ADD COLUMN `sn_liberado`  tinyint(1) NOT NULL DEFAULT 0;]]></atualiza><atualiza codigo="{F0F908D3-478B-456C-80A4-5C36CE0A0B4D}" protocolo="ansi"><![CDATA[ALTER TABLE `planosdesconto` CHANGE `descricaoplano` `descricaoplano` VARCHAR(255) NULL;]]></atualiza><atualiza codigo="{904574C8-EF2E-4898-B5AD-9E6521CB1806}" protocolo="ansi"><![CDATA[ALTER TABLE turmas CHANGE COLUMN cd_proxima_turma cd_proxima_turma VARCHAR(50) NULL default null;]]></atualiza><atualiza codigo="{C256E69C-11BF-447B-A723-5502B4DAEAB8}" protocolo="ansi"><![CDATA[ALTER TABLE planospagamento CHANGE COLUMN turma turma VARCHAR(50) NULL default NULL;]]></atualiza><atualiza codigo="{3DB1FBBD-5C14-42E7-907C-A16F07E04B6B}" protocolo="ansi"><![CDATA[INSERT INTO 
