		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 139) AS FREQ139
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 140) AS FREQ140
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 141) AS FREQ141
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 142) AS FREQ142
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 143) AS FREQ143
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 144) AS FREQ144
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 145) AS FREQ145
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 146) AS FREQ146
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 147) AS FREQ147
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 148) AS FREQ148
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 149) AS FREQ149
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 150) AS FREQ150
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 151) AS FREQ151
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 152) AS FREQ152
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 153) AS FREQ153
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 154) AS FREQ154
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 155) AS FREQ155
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 156) AS FREQ156
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 157) AS FREQ157
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 158) AS FREQ158
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 159) AS FREQ159
		, GET_FREQ(FI.CODIGOALUNO, FI.ANOSEMESTRE, FI.TURMA, FI.DISCIPLINA, DPT.BIMESTRE, 160) AS FREQ160
		, CASE WHEN dpt.bimestre = 1 THEN
			fi.ajuste1
		WHEN dpt.bimestre = 2 THEN
			fi.ajuste2
		WHEN dpt.bimestre = 3 THEN
			fi.ajuste3
		WHEN dpt.bimestre = 4 THEN
			fi.ajuste4
		WHEN dpt.bimestre = 5 THEN
			fi.ajuste5
		WHEN dpt.bimestre = 6 THEN
			fi.ajuste6
		WHEN dpt.bimestre = 7 THEN
			fi.ajuste7
		WHEN dpt.bimestre = 8 THEN
			fi.ajuste8
		WHEN dpt.bimestre = 9 THEN
			fi.ajuste9
		WHEN dpt.bimestre = 10 THEN
			fi.ajuste10
		END ajuste
		, FI.situacao AS situacao
		FROM 
		FICHAINDIVIDUAL AS FI 
		INNER JOIN DIARIO_TURMAS DPT ON (
		FI.ANOSEMESTRE = DPT.ANOSEMESTRE AND FI.CURSO = DPT.CURSO AND FI.TURMA = DPT.TURMA AND 
		FI.DISCIPLINA = DPT.DISCIPLINA);]]></atualiza><atualiza codigo="{4BBA7D5E-4181-4A4C-8894-CAB82029C932}" protocolo="ansi"><![CDATA[DELIMITER //

DROP  PROCEDURE IF EXISTS DIA_INICIAR_DIARIO//

CREATE PROCEDURE DIA_INICIAR_DIARIO(IN CD_CURSO VARCHAR(40), IN CD_TURMA VARCHAR(40), IN CD_DISCIPLINA INTEGER(11), IN CD_PROFESSOR INTEGER(11), IN NR_ANOSEMESTRE INTEGER(11), IN NR_ETAPA INTEGER(11))
    NOT DETERMINISTIC
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
       INSERT IGNORE INTO DIARIO_TURMAS (turma, anosemestre, disciplina, bimestre, professor, curso)
     VALUES
     (CD_TURMA,NR_ANOSEMESTRE,CD_DISCIPLINA, NR_ETAPA, CD_PROFESSOR, CD_CURSO);
     
     UPDATE
          diario_turmas
       SET
          professor = CD_PROFESSOR
       WHERE
          anosemestre = NR_ANOSEMESTRE  AND  turma = CD_TURMA  AND  disciplina = CD_DISCIPLINA  AND  bimestre = NR_ETAPA;

     INSERT IGNORE INTO DIARIOS_DESCRICOES (nr_anosemestre, cd_turma, nr_disciplina, cd_pessoa, nr_avaliacao)
     SELECT
           tp.anosemestre, tp.turma, tp.disciplina, fi.codigoaluno, NR_ETAPA
     FROM
         fichaindividual fi
         INNER JOIN turmasprofessores tp
               ON (fi.turma = tp.turma AND fi.anosemestre = tp.anosemestre AND fi.disciplina = tp.disciplina)
         INNER JOIN situacao s ON(fi.situacao = s.cd_situacao)
     WHERE
          s.cd_situacao_pai in (0, 1, 2, 9) AND
          tp.anosemestre =  NR_ANOSEMESTRE AND
          tp.curso = CD_CURSO AND
          tp.turma = CD_TURMA AND
          tp.disciplina = CD_DISCIPLINA AND
          tp.professor = CD_PROFESSOR;
END//]]></atualiza><atualiza codigo="{66544F22-271E-44EB-BB9F-974714C87DCE}" protocolo="ansi"><![CDATA[DELIMITER //

DROP FUNCTION IF EXISTS FCD_GRUPO_ESTUDANTES//
 
CREATE FUNCTION `FCD_GRUPO_ESTUDANTES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isEstudante BOOLEAN DEFAULT NULL;
   DECLARE codigoAluno INTEGER DEFAULT NULL;
 
   SELECT
      M.CODIGOALUNO
   FROM
      MATRICULAS M
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      M.CODIGOALUNO = pessoa AND
      T.CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoAluno;
 
   IF codigoAluno IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 2 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isEstudante;
 
   IF isEstudante THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_PROFESSORES//
 
CREATE FUNCTION `FCD_GRUPO_PROFESSORES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isProfessor BOOLEAN DEFAULT FALSE;
   DECLARE codigoProfessor INTEGER DEFAULT NULL;
 
   SELECT
      TP.PROFESSOR
   FROM
      TURMASPROFESSORES TP
         JOIN TURMAS T ON
            (TP.TURMA = T.CODIGO)
   WHERE
      TP.PROFESSOR = pessoa AND
      T.CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoProfessor;
 
   IF codigoProfessor IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 3 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isProfessor;
 
   IF isProfessor THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_COORDENADORES//
 
CREATE FUNCTION `FCD_GRUPO_COORDENADORES`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isCoordenador BOOLEAN DEFAULT FALSE;
   DECLARE codigoCoordenador INTEGER DEFAULT NULL;
 
   SELECT
      CD_PESSOA
   FROM
      CURSOS_COORDENADORES
   WHERE
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   LIMIT 1
   INTO
      codigoCoordenador;
 
   IF codigoCoordenador IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 4 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isCoordenador;
 
   IF isCoordenador THEN
      RETURN TRUE;
   END IF;
 
   RETURN FALSE;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_FUNCIONARIOS//
 
CREATE FUNCTION `FCD_GRUPO_FUNCIONARIOS`(cdPessoa INTEGER(11), coligada INTEGER(11))
    RETURNS tinyint(1)
    NOT DETERMINISTIC
    CONTAINS SQL
    SQL SECURITY DEFINER
    COMMENT ''
BEGIN
   DECLARE isFuncionario BOOLEAN DEFAULT FALSE;
   DECLARE codigoPessoa INTEGER DEFAULT NULL;
 
   SELECT
	   cd_pessoa
   FROM
	   professores
   WHERE
      sn_funcionario = "S" AND
      cd_pessoa = cdPessoa AND
      cd_coligada = coligada
   GROUP BY
      cd_pessoa
   INTO
      codigoPessoa;
 
   SELECT
      sn_incluir
   FROM
      nu_grupos_excecoes
   WHERE
      cd_grupo = 5 AND
      cd_pessoa = cdPessoa AND
      cd_coligada = coligada
   INTO
      isFuncionario;
 
   IF codigoPessoa IS NULL AND isFuncionario <> 1 THEN
      RETURN FALSE;
   ELSE
      RETURN TRUE;
   END IF;
 
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_RESPACADEMICO//
 
CREATE FUNCTION `FCD_GRUPO_RESPACADEMICO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespAcad BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_ACAD
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      P.CD_RESP_ACAD = pessoa
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 6 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespAcad;
 
   IF isRespAcad THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
END//



DROP FUNCTION IF EXISTS FCD_GRUPO_RESPFINANCEIRO//
 
CREATE FUNCTION `FCD_GRUPO_RESPFINANCEIRO`(`pessoa` INTEGER,`coligada` INTEGER)
   RETURNS TINYINT(1)
   NOT DETERMINISTIC
   CONTAINS SQL
   SQL SECURITY DEFINER
   COMMENT ''
BEGIN
 
   DECLARE isRespFinan BOOLEAN DEFAULT FALSE;
   DECLARE codigoResp INTEGER DEFAULT NULL;
 
   SELECT
      P.CD_RESP_FINAN
   FROM
      MATRICULAS M
         JOIN PESSOAS P ON
            (M.CODIGOALUNO = P.CD_PESSOA)
         JOIN SITUACAO S ON
            (M.SITUACAO = S.CD_SITUACAO)
         JOIN TURMAS T ON
            (M.TURMA = T.CODIGO)
   WHERE
      S.CD_SITUACAO_PAI IN (0, 1, 2, 9, 10, 11, 14) AND
      P.CD_RESP_FINAN = pessoa
   LIMIT 1
   INTO
      codigoResp;
 
   IF codigoResp IS NOT NULL THEN
      RETURN TRUE;
   END IF;
 
   SELECT
      SN_INCLUIR
   FROM
      NU_GRUPOS_EXCECOES
   WHERE
      CD_GRUPO = 7 AND
      CD_PESSOA = pessoa AND
      CD_COLIGADA = coligada
   INTO
      isRespFinan;
 
   IF isRespFinan THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
 
   RETURN 0;
END//]]></atualiza><atualiza codigo="{2C73DE94-6102-48E7-ABAD-55F1CB8DA664}" protocolo="mysql-5"><![CDATA[CREATE TABLE UNI_OBSERVACOES (
   CD_OBSERVACAO BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
   CD_PESSOA INTEGER NOT NULL,
   CD_USUARIO INTEGER NOT NULL,
   DT_OBSERVACAO DATETIME NOT NULL,
   SG_TIPO CHAR(1) NOT NULL,
   ME_OBSERVACAO LONGTEXT,
   CONSTRAINT PK_OBSERVACOES PRIMARY KEY (CD_OBSERVACAO)
) ENGINE=INNODB;

ALTER TABLE UNI_OBSERVACOES
   ADD CONSTRAINT FK_OBS_CD_PESSOA_PES_CD_PESSOA FOREIGN KEY (CD_PESSOA) REFERENCES PESSOAS (CD_PESSOA),
   ADD CONSTRAINT FK_OBS_CD_USUARIO_PES_CD_PESSO FOREIGN KEY (CD_USUARIO) REFERENCES PESSOAS (CD_PESSOA);

INSERT INTO PARAMETROS
   (DS_VARIAVEL, DS_VALOR, SN_RESTRITO, DS_VARIAVEL_USUARIO, CD_CATEGORIA, CD_TIPO, CD_COLIGADA)
VALUES
   ('AGRUPAR_OBSERVACOES', 'N', 'S', 'Quando habilitado exibe todas as observações da pessoa, não filtrando pelo tipo.', 15, 0, 0);

INSERT INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES (
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'UMFinanceiro'),
   'Observações Financeiras',
   'Obs.Financeiro'
);

INSERT INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES (
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'UMFinanceiro'),
   'Observações Financeiras Restritas',
   'Obs.Fin.Restrita'
);

INSERT INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES (
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Academico'),
   'Observações de Matrícula',
   'Obs.Matricula'
);

INSERT INTO NU_MODULOS_ACOES (CD_MODULO, DS_NOME_ACAO, DS_CHAVE)
VALUES (
   (SELECT CD_MODULO FROM NU_MODULOS WHERE DS_CHAVE = 'Academico'),
   'Observações Pedagógicas',
   'Obs.Pedagogico'
);

INSERT INTO NU_GRUPOS_PERMISSOES (CD_GRUPO, CD_ACAO, NR_PERMISSAO)
SELECT
   GP.CD_GRUPO,
   CASE
      WHEN A.DS_CHAVE = '2019' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Financeiro' AND M.DS_CHAVE = 'UMFinanceiro')
      WHEN A.DS_CHAVE = '2024' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Fin.Restrita' AND M.DS_CHAVE = 'UMFinanceiro')
      WHEN A.DS_CHAVE = '1017' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Matricula' AND M.DS_CHAVE = 'Academico')
      WHEN A.DS_CHAVE = '1021' THEN (SELECT A.CD_ACAO FROM NU_MODULOS_ACOES A JOIN NU_MODULOS M ON (A.CD_MODULO = M.CD_MODULO) WHERE A.DS_CHAVE = 'Obs.Pedagogico' AND M.DS_CHAVE = 'Academico')
   END,
   GP.NR_PERMISSAO
FROM
   NU_GRUPOS_PERMISSOES GP
      JOIN NU_MODULOS_ACOES A ON
         (GP.CD_ACAO = A.CD_ACAO)
WHERE
   A.DS_CHAVE IN ('1017', '1021', '2019', '2024');

DELETE FROM NU_GRUPOS_PERMISSOES
WHERE
   CD_ACAO IN
      (SELECT CD_ACAO FROM NU_MODULOS_ACOES WHERE DS_CHAVE IN ('1017', '1021', '2019', '2024'));

DELETE FROM NU_MODULOS_ACOES WHERE DS_CHAVE IN ('1017', '1021', '2019', '2024');

INSERT INTO UNI_OBSERVACOES (CD_PESSOA, CD_USUARIO, DT_OBSERVACAO, SG_TIPO, ME_OBSERVACAO)
SELECT
   CODIGOALUNO,
   (SELECT CD_PESSOA FROM PESSOAS WHERE DS_LOGIN LIKE 'admin'),
   NOW(),
   'F',
   OBSERVACOES
FROM
   OBSERVACOESFINANCEIRAS
   INNER JOIN pessoas ON (codigoaluno = cd_pessoa)
WHERE
   TRIM(OBSERVACOES) <> '';

INSERT INTO UNI_OBSERVACOES (CD_PESSOA, CD_USUARIO, DT_OBSERVACAO, SG_TIPO, ME_OBSERVACAO)
SELECT
   CODIGOALUNO,
   (SELECT CD_PESSOA FROM PESSOAS WHERE DS_LOGIN LIKE 'admin'),
   NOW(),
   'R',
   OBSERVACOES_ESPECIAIS
FROM
   OBSERVACOESFINANCEIRAS
   INNER JOIN pessoas ON (codigoaluno = cd_pessoa)
WHERE
   TRIM(OBSERVACOES_ESPECIAIS) <> '';

INSERT INTO UNI_OBSERVACOES (CD_PESSOA, CD_USUARIO, DT_OBSERVACAO, SG_TIPO, ME_OBSERVACAO)
SELECT
   CODIGOALUNO,
   (SELECT CD_PESSOA FROM PESSOAS WHERE DS_LOGIN LIKE 'admin'),
   NOW(),
   'M',
   OBSERVACOES
FROM
   OBSERVACOESSECRETARIA
   INNER JOIN pessoas ON (codigoaluno = cd_pessoa)
WHERE
   TRIM(OBSERVACOES) <> '';

INSERT INTO UNI_OBSERVACOES (CD_PESSOA, CD_USUARIO, DT_OBSERVACAO, SG_TIPO, ME_OBSERVACAO)
SELECT
   CODIGOALUNO,
   (SELECT CD_PESSOA FROM PESSOAS WHERE DS_LOGIN LIKE 'admin'),
   NOW(),
   'P',
   OBS_PEDAGOGICAS
FROM
   OBSERVACOESSECRETARIA
   INNER JOIN pessoas ON (codigoaluno = cd_pessoa)
WHERE
   TRIM(OBS_PEDAGOGICAS) <> '';]]></atualiza><atualiza codigo="{2C73DE94-6102-48E7-ABAD-55F1CB8DA664}" protocolo="oracle"><![CDATA[CREATE TABLE UNI_OBSERVACOES (
   CD_OBSERVACAO NUMBER(19) NOT NULL,
   CD_PESSOA NUMBER(9) NOT NULL,
   CD_USUARIO NUMBER(9) NOT NULL,
   DT_OBSERVACAO TIMESTAMP(2) NOT NULL,
   SG_TIPO CHAR(1) NOT NULL,
   ME_OBSERVACAO CLOB NOT NULL,
   CONSTRAINT PK_OBSERVACOES PRIMARY KEY (CD_OBSERVACAO)
) NOCOMPRESS;

ALTER TABLE UNI_OBSERVACOES ADD CONSTRAINT FK_OBS_CD_PESSOA_PES_CD_PESSOA FOREIGN KEY (CD_PESSOA) REFERENCES PESSOAS (CD_PESSOA);
ALTER TABLE UNI_OBSERVACOES ADD CONSTRAINT FK_OBS_CD_USUARIO_PES_CD_PESSO FOREIGN KEY (CD_USUARIO) REFERENCES PESSOAS (CD_PESSOA);

CALL CRIAR_AUTO_INCREMENT('UNI_OBSERVACOES', 'CD_OBSERVACAO', 'SEQ_UNI_OBSERVAC_CD_OBSERVACAO', 'AUTOINC_UNI_OBSE_CD_OBSERVACAO');

CREATE INDEX IDX_SEARCH_OBSERVACOES ON UNI_OBSERVACOES(ME_OBSERVACAO) INDEXTYPE IS CTXSYS.CONTEXT PARAMETERS ('DATASTORE CTXSYS.DEFAULT_DATASTORE');

