WHERE COALESCE( cd_coligada, 0 ) = 0;]]></atualiza><atualiza codigo="{E8F54506-A6A0-4C51-9DED-A7C0974D12D9}" protocolo="mysql-5"><![CDATA[SELECT 1 FROM DUAL;]]></atualiza><atualiza codigo="{E8F54506-A6A0-4C51-9DED-A7C0974D12D9}" protocolo="oracle"><![CDATA[ALTER TABLE FIN_PLANOS_TURMAS DROP CONSTRAINT FK_FIN_PLANOS_TURMAS_CD_PLANO;
ALTER TABLE FIN_PLANOS_TURMAS ADD CONSTRAINT FK_FIN_PLANOS_TURMAS_CD_PLANO FOREIGN KEY (CD_PLANO) REFERENCES FIN_PLANOS (CD_PLANO) ON DELETE CASCADE;

ALTER TABLE FIN_PLANOS_ITENS DROP CONSTRAINT FK_FIN_PLANOS_ITENS_CD_PLANO;
ALTER TABLE FIN_PLANOS_ITENS ADD CONSTRAINT FK_FIN_PLANOS_ITENS_CD_PLANO FOREIGN KEY (CD_PLANO) REFERENCES FIN_PLANOS (CD_PLANO) ON DELETE CASCADE;

ALTER TABLE FIN_PLANOS_DISTRATOS DROP CONSTRAINT FK_FIN_PLANO_DISTRATO_CD_PLANO;
ALTER TABLE FIN_PLANOS_DISTRATOS ADD CONSTRAINT FK_FIN_PLANO_DISTRATO_CD_PLANO FOREIGN KEY (CD_PLANO) REFERENCES FIN_PLANOS (CD_PLANO) ON DELETE CASCADE;

ALTER TABLE FIN_PLANOS_DISTRATOS_SIT_MATRI DROP CONSTRAINT FK_FIN_DISTRATO_ST_CD_DISTRATO;
ALTER TABLE FIN_PLANOS_DISTRATOS_SIT_MATRI ADD CONSTRAINT FK_FIN_DISTRATO_ST_CD_DISTRATO FOREIGN KEY (CD_DISTRATO) REFERENCES FIN_PLANOS_DISTRATOS (CD_DISTRATO) ON DELETE CASCADE;

ALTER TABLE FIN_PLANOS_DISTRATOS_TIPO_TITU DROP CONSTRAINT FK_FIN_DISTRATO_TT_CD_DISTRATO;
ALTER TABLE FIN_PLANOS_DISTRATOS_TIPO_TITU ADD CONSTRAINT FK_FIN_DISTRATO_TT_CD_DISTRATO FOREIGN KEY (CD_DISTRATO) REFERENCES FIN_PLANOS_DISTRATOS (CD_DISTRATO) ON DELETE CASCADE;]]></atualiza><atualiza codigo="{DA3D8752-BB8A-4BC0-8588-DC20E91D369C}" protocolo="ansi"><![CDATA[DROP VIEW itensplanospagamento;
CREATE VIEW itensplanospagamento AS
SELECT
	fpi.CD_PLANO AS codigoplano,
	fp.CD_COLIGADA AS cd_coligada,
	fpi.NR_MES AS mes,
	fpi.NR_PARCELA AS parcela,
	fpi.VL_BRUTO AS valorbruto,
	fpi.VL_DESCONTO AS valordesconto,
	fpi.VL_EXTRA AS valorextra,
	fpi.VL_DESCONTO_EXTRA AS descontoextra,
	fpi.VL_TOTAL AS valortotal,
	fpi.NR_DIA AS nr_dia,
	fpi.NR_ANO AS nr_ano,
	fpi.NR_CREDITOS_MINIMOS AS nr_creditos_minimos,
	CASE WHEN fpi.SN_CREDITO_PARCELA = 1 THEN
		'S'
	ELSE
		'N'
	END AS sn_credito_parcela,
	fpi.CD_TIPO_PARCELA AS cd_tipo_parcela,
	fpi.CD_PLANO_ITEM AS cd_item_plano
FROM
	fin_planos_itens fpi
	INNER JOIN fin_planos fp ON (fp.CD_PLANO = fpi.CD_PLANO);]]></atualiza><atualiza codigo="{D72B84F9-4A0E-4105-BCA2-07E025CF0287}" protocolo="mysql-5"><![CDATA[#
