	cd_alternativa  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_questao  int(10) UNSIGNED NOT NULL ,
	nr_alternativa  int(10) UNSIGNED NULL DEFAULT NULL ,
	ds_alternativa  blob NULL ,
	PRIMARY KEY (cd_alternativa)
);

CREATE TABLE pol_anexos (
	cd_anexo  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_questao  int(10) UNSIGNED NULL DEFAULT NULL ,
	mb_anexo  mediumblob NULL ,
	nm_original  varchar(100) NULL DEFAULT NULL ,
	ds_tamanho  varchar(30) NULL DEFAULT NULL ,
	dt_envio  datetime NULL DEFAULT NULL ,
	PRIMARY KEY (cd_anexo)
);

CREATE TABLE pol_assuntos (
	cd_assunto  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_responsavel  int(11) UNSIGNED NULL DEFAULT NULL ,
	cd_disciplina_pai  varchar(255) NULL DEFAULT NULL ,
	ds_assunto  varchar(255) NULL DEFAULT NULL ,
	cd_categoria_disciplina  int(11) NULL DEFAULT NULL ,
	PRIMARY KEY (cd_assunto)
);

CREATE TABLE pol_niveis (
	cd_nivel  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	ds_nivel  varchar(255) NULL DEFAULT NULL ,
	PRIMARY KEY (cd_nivel)
);

CREATE TABLE pol_provas (
	cd_prova  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_responsavel  int(11) UNSIGNED NOT NULL ,
	cd_disciplina_pai  varchar(255) NULL DEFAULT NULL ,
	cd_categoria  int(11) UNSIGNED NOT NULL ,
	ds_prova  varchar(255) NULL DEFAULT NULL ,
	vl_peso  float NULL DEFAULT 0 ,
	nr_qtd_questoes  int(10) UNSIGNED NULL DEFAULT 0 ,
	nr_qtd_resolucoes  int(10) UNSIGNED NULL DEFAULT 0 ,
	nr_etapa  int(10) UNSIGNED NULL DEFAULT 0 ,
	nr_anosemestre  smallint(6) UNSIGNED NULL DEFAULT NULL ,
	dt_inicio  datetime NULL DEFAULT '0000-00-00 00:00:00' ,
	dt_fim  datetime NULL DEFAULT '0000-00-00 00:00:00' ,
	sn_avaliacao  tinyint(3) UNSIGNED NULL DEFAULT 0 ,
	sn_exibe_gabarito  tinyint(3) UNSIGNED NULL DEFAULT 0 ,
	sn_questoes_aleatorio  tinyint(3) UNSIGNED NULL DEFAULT 0 ,
	sn_ativo  tinyint(3) UNSIGNED NULL DEFAULT 0 ,
	sn_questoes_disciplina  tinyint(3) UNSIGNED NULL DEFAULT 0 ,
	dt_cadastro  datetime NULL DEFAULT '0000-00-00 00:00:00' ,
	sn_regra_nr_questoes  tinyint(3) UNSIGNED NULL DEFAULT 1 COMMENT '0 - Por Credito | 1 - Por Disciplina' ,
	nr_tempo_resolucao  int(10) NULL DEFAULT 0 ,
	PRIMARY KEY (cd_prova)
);

CREATE TABLE pol_provas_assuntos (
	cd_prova_assunto  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_assunto  int(10) UNSIGNED NOT NULL ,
	cd_prova  int(10) UNSIGNED NOT NULL ,
	PRIMARY KEY (cd_prova_assunto)
);

CREATE TABLE pol_provas_niveis (
	cd_prova_nivel  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_prova  int(10) UNSIGNED NOT NULL ,
	cd_nivel  int(10) UNSIGNED NOT NULL ,
	qtd_questoes  int(10) UNSIGNED NULL DEFAULT NULL ,
	PRIMARY KEY (cd_prova_nivel)
);

CREATE TABLE pol_provas_pessoas (
	cd_prova_pessoa  int(10) UNSIGNED NOT NULL AUTO_INCREMENT ,
	cd_pessoa  int(11) UNSIGNED NULL DEFAULT NULL ,
	cd_prova  int(10) UNSIGNED NULL DEFAULT NULL ,
	nr_resolucao  int(10) UNSIGNED NULL DEFAULT 0 ,
	nr_exibicoes  int(10) UNSIGNED NULL DEFAULT 0 ,
	nr_qtd_alternativas  int(10) UNSIGNED NULL DEFAULT 0 ,
	nr_nota  float NULL DEFAULT 0 ,
	sn_finalizada  tinyint(3) UNSIGNED NULL DEFAULT 0 ,
	dt_resolucao  datetime NULL DEFAULT '0000-00-00 00:00:00' ,
