CALL CRIAR_AUTO_INCREMENT( 'FIN_ORCAMENTOS', 'CD_ORCAMENTO', 'SEQ_NFE_ORC_ORC', 'AUTOINC_SEQ_NFE_ORC_ORC' );]]></atualiza><atualiza codigo="{B84EC727-9F58-4354-879E-6E16E965CE0E}" protocolo="ansi"><![CDATA[insert into nu_grupos_permissoes ( cd_permissao, cd_grupo, cd_acao, nr_permissao ) values 
