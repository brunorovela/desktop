);]]></atualiza><atualiza codigo="{855403C6-DFD4-452D-907D-DCA03C637B62}" protocolo="mysql-5"><![CDATA[-- menu >  financeiro > compromisso > retorno de compromisso. [erro do tipo de campo integer]
-- ALTER TABLE retorno_cp  CHANGE COLUMN `cd_retorno` `cd_retorno` SMALLINT(6) UNSIGNED NOT NULL  AUTO_INCREMENT FIRST
-- Otimizado:
-- um INT(11) signed e um SMALLINT(6) unsigned para o delphi são armazenados ambos por um TFieldInteger, no entando, o
-- escolhido o INT(11) signed por ter maior capacidade de armazenamento.
ALTER TABLE retorno_cp CHANGE COLUMN `cd_retorno` `cd_retorno` INT(11) NOT NULL AUTO_INCREMENT FIRST;

-- menu >  financeiro > compromisso > retorno de compromisso >> aba itens do retorno [erro do tipo de campo integer]
-- ALTER TABLE retorno_cp_itens CHANGE COLUMN `cd_retorno` `cd_retorno` SMALLINT(6) UNSIGNED NOT NULL DEFAULT '0' FIRST
-- ALTER TABLE retorno_cp_itens CHANGE COLUMN `nr_linha` `nr_linha` SMALLINT(6) UNSIGNED NOT NULL DEFAULT '0' AFTER `cd_retorno`
-- ALTER TABLE retorno_cp_itens CHANGE COLUMN `cd_titulo` `cd_titulo` SMALLINT(6) UNSIGNED NULL DEFAULT NULL AFTER `me_linha`
-- Otimizado:
-- um INT(11) signed e um SMALLINT(6) unsigned para o delphi são armazenados ambos por um TFieldInteger, no entando, o
-- escolhido o INT(11) signed por ter maior capacidade de armazenamento.
ALTER TABLE retorno_cp_itens CHANGE COLUMN `cd_retorno` `cd_retorno` INT(11) NOT NULL DEFAULT '0' FIRST;
ALTER TABLE retorno_cp_itens CHANGE COLUMN `nr_linha` `nr_linha` INT(11) NOT NULL DEFAULT '0' AFTER `cd_retorno`;
ALTER TABLE retorno_cp_itens CHANGE COLUMN `cd_titulo` `cd_titulo` INT(11) NULL DEFAULT NULL AFTER `me_linha`;

-- permitir nulo nas colunas
ALTER TABLE historico_escolas_grau 
CHANGE COLUMN `ds_escola` `ds_escola` VARCHAR(150) NULL AFTER `ano`, 
CHANGE COLUMN `ds_escola_cidade` `ds_escola_cidade` VARCHAR(40) NULL AFTER `ds_escola`, 
CHANGE COLUMN `ds_escola_estado` `ds_escola_estado` CHAR(2) NULL AFTER `ds_escola_cidade`;

