UPDATE
  nu_grupos_permissoes perm
  INNER JOIN nu_modulos_acoes nma ON (perm.cd_acao = nma.cd_acao)
SET
  perm.nr_permissao = 2
WHERE
 nma.ds_chave='1104';

UPDATE
  nu_grupos_permissoes perm
  INNER JOIN nu_modulos_acoes nma ON (perm.cd_acao = nma.cd_acao)
SET
  perm.nr_permissao = 8
WHERE
 nma.ds_chave='1105';


INSERT INTO nu_grupos_permissoes(cd_permissao,cd_grupo,cd_acao,nr_permissao)  
SELECT
  null,
  perm.cd_grupo,
 (SELECT cd_acao FROM nu_modulos_acoes WHERE ds_chave = '1152'),
 sum(perm.nr_permissao)+1
FROM
  nu_grupos_permissoes perm
  INNER JOIN nu_modulos_acoes nma ON (perm.cd_acao = nma.cd_acao)
WHERE
  nma.ds_chave in ('1103','1104','1105')
GROUP BY 
 cd_grupo;

DELETE 
FROM
  nu_grupos_permissoes
where
  cd_acao in 
  (
    SELECT
      group_concat(cd_acao)  
    FROM
      nu_modulos_acoes
    WHERE
      ds_chave in ('1103','1104','1105')
  );

DELETE 
FROM
  nu_modulos_acoes
where
  ds_chave in ('1103','1104','1105');]]></atualiza><atualiza codigo="{906A14DC-F4A2-41A4-8288-1B13C7578784}" protocolo="ansi"><![CDATA[ALTER TABLE `con_inscricoes`
