 31 );
insert into nu_grupos_permissoes ( cd_permissao, cd_grupo, cd_acao, nr_permissao ) values 
( null,  (select cd_grupo from nu_grupos where ds_papel='C_ESTNC_TPESS_REPRE_IE' limit 1),  (select cd_acao from nu_modulos_acoes where ds_chave='EstagioncAdminInteresses'), 
