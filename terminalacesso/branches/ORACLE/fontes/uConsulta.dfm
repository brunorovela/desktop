  object qryRegistros: TZReadOnlyQuery
    Connection = DM.db
    SortType = stIgnored
    SQL.Strings = (
      'SELECT'
      '    d.CODIGO,'
      '    d.CD_PESSOA,'
      '    d.NR_ANOSEMESTRE,'
      '    d.DT_ENTRADA,'
      '    d.DT_SAIDA,'
      '    d.SN_ESPECIAL,'
      '    d.SN_FINALIZADO,'
      '    p2.NM_PESSOA  AS CD_RESPONSAVEL,'
      '    d.CD_CATRACA_ENTRADA,'
      '    d.CD_CATRACA_SAIDA,'
      #9#9'd.CD_RESPONSAVEL,'
      '    DATE(d.DT_ENTRADA) DT_REGISTRO,'
      '    DATE_FORMAT(d.DT_ENTRADA, '#39'%H:%i:%s'#39') HR_ENTRADA,'
      '    DATE_FORMAT(d.DT_SAIDA, '#39'%H:%i:%s'#39') HR_SAIDA,'
      '    CASE'
      '        WHEN d.DT_SAIDA IS NULL THEN '#39'ENTRADA'#39
      '        ELSE '#39'ENTRADA/SA'#205'DA'#39
      '    END DS_TIPO,'
      '    CASE'
      '        WHEN d.SN_ESPECIAL = 1 THEN '#39'ESPECIAL'#39
      '        ELSE '#39'ALUNO'#39
      '    END DS_ESPECIAL,'
      '    CASE'
      '        WHEN d.SN_FINALIZADO = 0 THEN '#39'ABERTO'#39
      '        WHEN d.SN_FINALIZADO = 1 THEN '#39'REGISTRADO'#39
      '        WHEN d.SN_FINALIZADO = 2 THEN '#39'FINALIZADO'#39
      '        ELSE '#39#39
      '    END DS_SITUACAO,'
      '    ce.NM_CATRACA NM_CATRACA_ENTRADA,'
      '    cs.NM_CATRACA NM_CATRACA_SAIDA,'
      '    p.NM_PESSOA'
      'FROM'
      '    diario_terminal_acessos d'
      '        JOIN pessoas p ON'
      '            (d.CD_PESSOA = p.CD_PESSOA)'
      #9#9#9#9'LEFT JOIN pessoas p2 ON'
      #9#9#9#9#9#9'(d.cd_responsavel = p2.cd_pessoa)'#9#9
      '        LEFT JOIN ta_catraca ce ON'
      '            (d.CD_CATRACA_ENTRADA = ce.CD_CATRACA)'
      '        LEFT JOIN ta_catraca cs ON'
      '            (d.CD_CATRACA_SAIDA = cs.CD_CATRACA)')
    Params = <>
    Left = 552
    Top = 88
    object qryRegistrosCODIGO: TIntegerField
      FieldName = 'CODIGO'
      Required = True
    end
    object qryRegistrosCD_PESSOA: TIntegerField
      FieldName = 'CD_PESSOA'
