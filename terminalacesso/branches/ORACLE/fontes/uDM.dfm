  object qyUsuariosNome: TUMZQuery
    Connection = db
    SQL.Strings = (
      'SELECT'
      #9'CAST( cd_pessoa AS SIGNED ) AS CODIGO,'
      #9'CASE WHEN sn_bloqueado = 1 THEN '#39'N'#39' ELSE '#39'S'#39' END AS SN_ONLINE,'
      #9'CASE WHEN sn_bloqueado = 1 THEN '#39'N'#39' ELSE '#39'S'#39' END AS ONLINE,'
      #9'ds_login AS NOME,'
      #9'ds_senha AS SENHA,'
      '  cd_pessoa AS CD_PESSOA'
      'FROM'
      #9'pessoas'
      'WHERE'
      #9'ds_login = :Nome')
    Params = <
      item
        DataType = ftString
        Name = 'Nome'
        ParamType = ptUnknown
      end>
    Left = 256
    Top = 16
    ParamData = <
      item
        DataType = ftString
        Name = 'Nome'
        ParamType = ptUnknown
      end>
