  object qRelatorios: TUMZQuery
    Connection = DM.db
    
    SQL.Strings = (
      'Select * from Relatorios '
      'Where sn_disponivel = '#39'S'#39' and'
      'cd_modulo = :modulo'
      'Order By ds_grupo, nm_relatorio')
    Left = 651
    Top = 84
    ParamData = <
      item
        DataType = ftInteger
        Name = 'modulo'
        ParamType = ptUnknown
      end>
