  object qryIdentificacao: TZQuery
    Connection = DM.db
    UpdateObject = updIdentificacao
    OnNewRecord = qryIdentificacaoNewRecord
    SQL.Strings = (
      'SELECT'
      '  I.CD_CATRACA_IDENTIFICACAO,'
      '  I.CD_CATRACA_IDENTIFICACAO_TIPO,'
      '  I.CD_PESSOA,'
      '  I.NR_IDENTIFICACAO,'
      '  I.SN_ATIVO,'
      '  I.SN_MASTER,'
      '  I.DT_VALIDADE,'
      '  T.NM_IDENTIFICACAO,'
      '  P.NM_PESSOA'
      'FROM'
      '  TA_CATRACA_IDENTIFICACAO I'
      '    JOIN TA_CATRACA_IDENTIFICACAO_TIPO T ON'
      
        '      (I.CD_CATRACA_IDENTIFICACAO_TIPO = T.CD_CATRACA_IDENTIFICA' +
        'CAO_TIPO)'
      '    JOIN PESSOAS P ON'
      '      (I.CD_PESSOA = P.CD_PESSOA)')
    Params = <>
    Left = 136
    Top = 416
    object qryIdentificacaoCD_CATRACA_IDENTIFICACAO: TLargeintField
