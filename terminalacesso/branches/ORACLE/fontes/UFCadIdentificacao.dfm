  object updIdentificacao: TZUpdateSQL
    DeleteSQL.Strings = (
      'DELETE'
      '        L'
      'FROM'
      '        TA_CATRACA_IDENTIFICACAO_LOG L'
      'WHERE'
      '        L.CD_CATRACA_IDENTIFICACAO = :CD_CATRACA_IDENTIFICACAO;'
      'DELETE'
      '        I'
      'FROM'
      '        TA_CATRACA_IDENTIFICACAO I'
      'WHERE'
      '        I.CD_CATRACA_IDENTIFICACAO = :CD_CATRACA_IDENTIFICACAO')
    InsertSQL.Strings = (
      'INSERT INTO TA_CATRACA_IDENTIFICACAO ('
      '        CD_CATRACA_IDENTIFICACAO_TIPO,'
      '        CD_PESSOA,'
      '        NR_IDENTIFICACAO,'
      '        SN_ATIVO,'
      '        SN_MASTER,'
      '        DT_VALIDADE'
      ') VALUES ('
      '        :CD_CATRACA_IDENTIFICACAO_TIPO,'
      '        :CD_PESSOA,'
      '        :NR_IDENTIFICACAO,'
      '        :SN_ATIVO,'
      '        :SN_MASTER,'
      '        :DT_VALIDADE'
      ');'
      ''
      'SELECT'
      '        LAST_INSERT_ID()'
      'INTO'
      '        @id'
      'FROM'
      '        DUAL;'
      ''
      'INSERT INTO TA_CATRACA_IDENTIFICACAO_LOG ('
      '        CD_CATRACA_IDENTIFICACAO,'
      '        CD_USUARIO,'
      '        TX_LOG'
      ') VALUES ('
      '        @id,'
      '        :CD_USUARIO,'
      '        CONCAT('
      #39'{'
      '\t"CD_CATRACA_IDENTIFICACAO": '#39', @id, '#39','
      
        '\t"CD_CATRACA_IDENTIFICACAO_TIPO": '#39', :NEW_CD_CATRACA_IDENTIFICA' +
        'CAO_TIPO, '#39','
      '\t"CD_PESSOA": '#39', :NEW_CD_PESSOA, '#39','
      '\t"NR_IDENTIFICACAO": "'#39', :NEW_NR_IDENTIFICACAO, '#39'",'
      '\t"SN_ATIVO": '#39', :NEW_SN_ATIVO, '#39','
      '\t"SN_MASTER": '#39', :NEW_SN_MASTER, '#39','
      '\t"DT_VALIDADE": "'#39', COALESCE(:NEW_DT_VALIDADE, '#39'null'#39'), '#39'"'
      '}'#39
      '        )'
      ');')
    ModifySQL.Strings = (
      'UPDATE'
      '        TA_CATRACA_IDENTIFICACAO'
      'SET'
      
        '        CD_CATRACA_IDENTIFICACAO_TIPO = :CD_CATRACA_IDENTIFICACA' +
        'O_TIPO,'
      '        CD_PESSOA = :CD_PESSOA,'
      '        NR_IDENTIFICACAO = :NR_IDENTIFICACAO,'
      '        SN_ATIVO = :SN_ATIVO,'
      '        SN_MASTER = :SN_MASTER,'
      '        DT_VALIDADE = :DT_VALIDADE'
      'WHERE'
      '        CD_CATRACA_IDENTIFICACAO = :CD_CATRACA_IDENTIFICACAO;'
      ''
      'INSERT INTO TA_CATRACA_IDENTIFICACAO_LOG ('
      '        CD_CATRACA_IDENTIFICACAO,'
      '        CD_USUARIO,'
      '        TX_LOG,'
      '        DS_OBSERVACOES'
      ') VALUES ('
      '        :CD_CATRACA_IDENTIFICACAO,'
      '        :CD_USUARIO,'
      '        CONCAT('
      #39'{'
      '\t"antigo": {'
      '\t\t"CD_CATRACA_IDENTIFICACAO": '#39', :CD_CATRACA_IDENTIFICACAO, '#39','
      
        '\t\t"CD_CATRACA_IDENTIFICACAO_TIPO": '#39', :OLD_CD_CATRACA_IDENTIFI' +
        'CACAO_TIPO, '#39','
      '\t\t"CD_PESSOA": '#39', :OLD_CD_PESSOA, '#39','
      '\t\t"NR_IDENTIFICACAO": "'#39', :OLD_NR_IDENTIFICACAO, '#39'",'
      '\t\t"SN_ATIVO": '#39', :OLD_SN_ATIVO, '#39','
      '\t\t"SN_MASTER": '#39', :OLD_SN_MASTER, '#39','
      '\t\t"DT_VALIDADE": "'#39', COALESCE(:OLD_DT_VALIDADE, '#39'null'#39'), '#39'"'
      '\t},'
      '\t"novo": {'
      '\t\t"CD_CATRACA_IDENTIFICACAO": '#39', :CD_CATRACA_IDENTIFICACAO, '#39','
      
        '\t\t"CD_CATRACA_IDENTIFICACAO_TIPO": '#39', :NEW_CD_CATRACA_IDENTIFI' +
        'CACAO_TIPO, '#39','
      '\t\t"CD_PESSOA": '#39', :NEW_CD_PESSOA, '#39','
      '\t\t"NR_IDENTIFICACAO": "'#39', :NEW_NR_IDENTIFICACAO, '#39'",'
      '\t\t"SN_ATIVO": '#39', :NEW_SN_ATIVO, '#39','
      '\t\t"SN_MASTER": '#39', :NEW_SN_MASTER, '#39','
      '\t\t"DT_VALIDADE": "'#39', COALESCE(:NEW_DT_VALIDADE, '#39'null'#39'), '#39'"'
      '\t}'
      '}'#39
      '        ),'
      '        :DS_OBSERVACOES'
      ');')
    RefreshSQL.Strings = (
      'SELECT'
      '  I.CD_CATRACA_IDENTIFICACAO,'
