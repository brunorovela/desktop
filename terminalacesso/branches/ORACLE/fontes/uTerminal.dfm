  object qryBuscaHorarioDaTurma: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'select'
      #9'count(*) as temHorario'
      'from turmas_horarios_config t'
      
        'INNER JOIN horarios H ON (H.codigo = t.cd_horario and h.sn_ativo' +
        ' = 1)'
      'where'
      #9'cd_turma = :turma'
      'and '
      #9'nr_dia_semana = WEEKDAY(CURDATE()) +2'
      'AND'
      '('
      
        #9'(TIMEDIFF(:hrEntrada ,h.hr_inicio) < :intevalo AND TIMEDIFF(:hr' +
        'Entrada,h.hr_inicio) > '#39'00:00'#39' )'
      #9' OR'
      
        #9'(TIMEDIFF(:hrEntrada ,h.hr_inicio) < :intevaloNegativo AND TIME' +
        'DIFF(:hrEntrada,h.hr_inicio) < '#39'00:00'#39' )'
      ')'
      
        'AND (h.hr_inicio - (SELECT h2.hr_fim FROM horarios h2 where cd_t' +
        'urma = t.cd_turma AND  h2.codigo = (t.cd_horario - 1))) >= 5500'
      '')
    Params = <
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'hrEntrada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'intevalo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'intevaloNegativo'
        ParamType = ptUnknown
      end>
    Left = 264
    Top = 464
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'turma'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'hrEntrada'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'intevalo'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'intevaloNegativo'
        ParamType = ptUnknown
      end>
  end
