  object qyGetEntrada: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   ta.codigo,'
      '   ta.dt_saida,'
      '   ta.dt_entrada,'
      '   ta.nr_anosemestre,'
      '   m.turma'
      'FROM'
      '   diario_terminal_acessos ta'
      '   INNER JOIN matriculas m ON ('
      '      ta.nr_anosemestre = m.anosemestre AND'
      '      ta.cd_pessoa = m.codigoaluno'
      '   )'
      '   INNER JOIN pessoas p ON ('
      'p.cd_pessoa = m.codigoaluno'
      ')'
      '   INNER JOIN situacao s ON (s.cd_situacao = m.situacao)'
      
        '   INNER JOIN turmas t ON (t.codigo = m.turma AND t.anosemestre ' +
        '= m.anosemestre)'
      'WHERE'
      '   DATE(ta.dt_entrada) = CURDATE() AND'
      ' (  ta.cd_pessoa = :cd_pessoa ) AND'
      '   ta.sn_finalizado = 0 AND'
      '   s.cd_situacao_pai IN :situacoes'
      'ORDER BY'
      '   CASE'
      
        #9#9'WHEN TIME(t.horainicio) <= CURTIME() AND CURTIME() <= TIME(t.h' +
        'orafim) THEN'
      #9#9#9'5'
      
        #9#9'WHEN TIME(t.horainicio) <= TIME(ta.dt_entrada) AND TIME(ta.dt_' +
        'entrada) <= TIME(t.horafim) THEN'
      #9#9#9'3'
      #9#9'ELSE'
      #9#9#9'0'
      #9'END DESC, t.horainicio ASC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'situacoes'
        ParamType = ptUnknown
      end>
    Left = 136
    Top = 464
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'situacoes'
        ParamType = ptUnknown
      end>
  end
  object qyGetTurmaMatricula: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '   m.turma,'
      '   m.anosemestre'
      'FROM'
      '   matriculas m'
      ''
      '      JOIN pessoas p ON'
      '         (p.cd_pessoa = m.codigoaluno)'
      ''
      '      JOIN situacao s ON'
      '         (s.cd_situacao = m.situacao)'
      '         '
      '      LEFT JOIN turmas t ON'
      '         (t.anosemestre = m.anosemestre) AND'
      '         (t.curso = m.curso) AND'
      '         (t.codigo = m.turma)'
      ''
      '         LEFT JOIN cursos_coligadas c ON'
      '            (c.cd_curso = t.curso) AND'
      '            (c.cd_coligada = t.cd_coligada)'
      'WHERE'
      '   (m.codigoaluno = :CODIGOALUNO)'
      'AND'
      '   s.cd_situacao_pai IN %s'
      'ORDER BY'
      '   CASE'
      
        #9#9'WHEN CURTIME() >= TIME(t.horainicio) AND CURTIME() <= TIME(t.h' +
        'orafim) THEN'
      #9#9#9'2'
      #9#9'WHEN CURTIME() <= TIME(t.horainicio) THEN'
      #9#9#9'1'
      #9#9'ELSE'
      #9#9#9'0'
      #9'END DESC, m.anosemestre DESC')
    Params = <
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end>
    Left = 168
    Top = 464
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'codigoaluno'
        ParamType = ptUnknown
      end>
  end
  object qryVerificaNrEntradas: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      #9'count(codigo) as acesso'
      'FROM'
      #9'diario_terminal_acessos'
      'WHERE'
      #9'nr_anosemestre = :anosemestre'
      'AND'
