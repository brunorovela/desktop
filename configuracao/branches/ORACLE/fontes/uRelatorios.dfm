  object UpdateSQL1: TUpdateSQL
    ModifySQL.Strings = (
      'update relatorios'
      'set'
      '  nm_relatorio = :nm_relatorio,'
      '  cd_modulo = :cd_modulo,'
      '  cd_cabecalho = :cd_cabecalho,'
      '  ds_grupo = :ds_grupo,'
      '  nm_arquivo = :nm_arquivo,'
      '  ds_parametros = :ds_parametros,'
      '  ds_formula = :ds_formula,'
      '  ds_especial = :ds_especial,'
      '  ds_ordem = :ds_ordem,'
      '  sn_disponivel = :sn_disponivel,'
      '  ds_formula_grupo = :ds_formula_grupo,'
      '  ds_sql = :ds_sql,'
      '  ds_sql_ordem = :ds_sql_ordem,'
      '  cd_relatorio = :cd_relatorio,'
      '  sn_impressao_numero = :sn_impressao_numero'
      'where'
      '  cd_relatorio = :OLD_cd_relatorio')
    InsertSQL.Strings = (
      'insert into relatorios'
      
        '  (nm_relatorio, cd_modulo, cd_cabecalho, ds_grupo, nm_arquivo, ' +
        'ds_parametros, '
      
        '   ds_formula, ds_especial, ds_ordem, sn_disponivel, ds_formula_' +
        'grupo, '
      '   ds_sql, ds_sql_ordem, cd_relatorio, sn_impressao_numero)'
      'values'
      
        '  (:nm_relatorio, :cd_modulo, :cd_cabecalho, :ds_grupo, :nm_arqu' +
        'ivo, :ds_parametros, '
      
        '   :ds_formula, :ds_especial, :ds_ordem, :sn_disponivel, :ds_for' +
        'mula_grupo, '
      '   :ds_sql, :ds_sql_ordem, :cd_relatorio, :sn_impressao_numero)')
    DeleteSQL.Strings = (
      'delete from relatorios'
      'where'
      '  cd_relatorio = :OLD_cd_relatorio')
