  object qyUsuarioBackup: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  *'
      'FROM'
      '  mysql.User U'
      'WHERE'
      '  User = :usuario AND'
      '  Host = :host'
      '  ')
    Params = <
      item
        DataType = ftString
        Name = 'usuario'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'host'
        ParamType = ptUnknown
      end>
    Left = 584
    Top = 112
    ParamData = <
      item
        DataType = ftString
        Name = 'usuario'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'host'
        ParamType = ptUnknown
      end>
  end
  object qySenha: TUMZQuery
    Connection = DM.db
    SQL.Strings = (
      'SELECT'
      '  password(ds_valor) AS ds_valor'
      'FROM'
      '  parametros'
      'WHERE'
      '  ds_variavel = '#39'backup_senha'#39';')
    Params = <>
    Left = 621
    Top = 111
  end
