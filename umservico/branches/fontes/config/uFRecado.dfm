  object qyDadosSMTP: TUMZQuery
    AfterOpen = qyDadosSMTPAfterOpen
    SQL.Strings = (
      'SELECT'
      #9'p.ds_parametro,'
      #9'p.ds_valor'
      'FROM'
      #9'nu_parametros p'
      #9#9'JOIN nu_modulos m USING (cd_modulo)'
      'WHERE'
      #9'm.ds_chave = '#39'UMNucleo'#39' AND'
      #9'p.ds_parametro LIKE '#39'smtp.%'#39)
    ParamCheck = False
    Params = <>
    Left = 384
    Top = 48
  end
  object qySalvaParamSMTP: TUMZQuery
    SQL.Strings = (
      'UPDATE'
      '   nu_parametros p'
      '      JOIN nu_modulos m ON'
      '         (p.cd_modulo = m.cd_modulo)'
      'SET'
      '   p.ds_valor = :ds_valor'
      'WHERE'
      '   p.ds_parametro = :ds_parametro AND'
      '   m.ds_chave = '#39'UMNucleo'#39)
    Params = <
      item
        DataType = ftUnknown
        Name = 'ds_valor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ds_parametro'
        ParamType = ptUnknown
      end>
    Left = 384
    Top = 80
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ds_valor'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ds_parametro'
        ParamType = ptUnknown
      end>
  end
end
