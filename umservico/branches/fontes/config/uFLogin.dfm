  object qyLogin: TUMZQuery
    SQL.Strings = (
      'SELECT'
      '   p.nr_permissao'
      'FROM'
      '   pessoas h'
      '      JOIN nu_grupos_pessoas g USING(cd_pessoa)'
      '         JOIN nu_grupos_permissoes p USING(cd_grupo)'
      '            JOIN nu_modulos_acoes a USING(cd_acao)'
      '               JOIN nu_modulos m USING(cd_modulo)'
      'WHERE'
      '   m.ds_chave = '#39'UMServico'#39' AND'
      '   a.ds_chave = '#39'Gerenciar'#39' AND'
      '   (g.cd_pessoa = :cd_pessoa OR h.ds_login = :cd_pessoa) AND'
      '   p.nr_permissao = 31 AND'
      '   h.ds_senha = MD5(:ds_senha)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'ds_senha'
        ParamType = ptUnknown
      end>
    Left = 368
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_pessoa'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
