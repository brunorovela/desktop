  object dsDestinos: TDataSource
    AutoEdit = False
    DataSet = qyDestinos
    OnDataChange = dsDestinosDataChange
    Left = 240
    Top = 104
  end
  object qyDestinos: TUMZQuery
    SQL.Strings = (
      'SELECT'
      '   rp.cd_pessoa,'
      '   p.nm_pessoa,'
      '   rp.tp_recado,'
      
        '   IF(rp.tp_recado = "1", "Recado Online", "E-Mail") tipo_recado' +
        ','
      '   rp.ds_email,'
      '   rp.sn_sucesso,'
      '   IFNULL(rp.me_erro, "") me_erro'
      'FROM'
      '   svc_recados_pessoas rp JOIN pessoas p USING(cd_pessoa)'
      'WHERE'
      '   cd_recado_envio = :cd_recado_envio')
    Params = <
      item
        DataType = ftUnknown
        Name = 'cd_recado_envio'
        ParamType = ptUnknown
      end>
    Left = 240
    Top = 72
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'cd_recado_envio'
        ParamType = ptUnknown
      end>
  end
