package UMSvcImportacaoTerminalCatraca;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD OFF}

requires
  vcl,
  rtl,
  dbrtl,
  ZComponent,
  ZDbc,
  ZPlain,
  ZCore,
  ZParseSql,
  UMZComponentDesign;

contains
  uSvcImportacaoTerminalCatraca in 'uSvcImportacaoTerminalCatraca.pas',
  uSvcImportacaoTerminalCatracaImpCatracas in 'uSvcImportacaoTerminalCatracaImpCatracas.pas',
  uSvcImportacaoTerminalCatracaImpRegistro in 'uSvcImportacaoTerminalCatracaImpRegistro.pas',
  mysql_api in 'mysql_api.pas';

end.
